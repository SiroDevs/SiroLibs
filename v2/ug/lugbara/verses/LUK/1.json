            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.38",
            "verseOrgIds": [
              "LUK.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mariamu enga o’du ’dayisi, mu angu uru oni driaria mbele, ca aku Yudania, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.39",
            "verseOrgIds": [
              "LUK.1.39"
            ]
          }
        },
