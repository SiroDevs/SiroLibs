          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.13"
              },
              "items": [
                {
                  "text": "Mat 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.50"
              },
              "items": [
                {
                  "text": "Mar 9:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awa’dini a’iri onyiru; te a’i nde ma si ka fu ’bo, yi nga eri ’ba aluzaru dika a’di afasi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funi dri ’bazu amvua ku, kani murutu dria ku; yi eri ’be amve. ’Ba bile be e’yo erizuri ma eri ra.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.35",
            "verseOrgIds": [
              "LUK.14.35"
            ]
          }
        }
      ]
