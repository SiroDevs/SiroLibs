              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.31+MAT.13.32+MAT.13.33"
              },
              "items": [
                {
                  "text": "Mat 13:31-33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.30+MRK.4.31+MRK.4.32"
              },
              "items": [
                {
                  "text": "Mar 4:30-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri di ’yo ani, Suru Munguni eri ovu kile a’dile ya? Ma nga eri o’bi a’di afale ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
