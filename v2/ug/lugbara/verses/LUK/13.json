                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.6"
              },
              "items": [
                {
                  "text": "31:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri kile haradali efi aguni e’dule ’bele nga ini ma aliarile; eri zo ra, nga ca patiru, aria ’bua ’diyi nga jorovu si eri ma arakalaa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.19",
            "verseOrgIds": [
              "LUK.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.19",
            "verseOrgIds": [
              "LUK.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo dika, Ma nga suru Munguni o’bi a’di afale ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ovu kile akufi okuni e’dule zile nganufura afazu na ma alia, de nga pini dria kurile.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.21",
            "verseOrgIds": [
              "LUK.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.21",
            "verseOrgIds": [
              "LUK.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri aci aku ambo ambo ’diyi pi ma eselia aku were ’diyi be, ’ba imbazu, erini muria drile Yerusa­lemua. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.22",
            "verseOrgIds": [
              "LUK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba azini ’yo eri tia, Opi, ’ba yi opapi ’diyi yi were ya? Eri nga ’yo yi tia, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.13"
              },
              "items": [
                {
                  "text": "Mat 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.12"
              },
              "items": [
                {
                  "text": "Fil 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.12"
              },
              "items": [
                {
                  "text": "1 Tim 6:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi o’bi asi driasi fizu jotile luruarurisi; te ma ’yo emi tia, ’ba kakau nga le fi ra, te ngani eco ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.24",
            "verseOrgIds": [
              "LUK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.11"
              },
              "items": [
                {
                  "text": "Mat 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jo e’i ka enga uru, ka jotile opi ’bo, emi ka nga ’ba pa oso amve, jotile kpozu, kini, Opi, mi zi ama dri fo; eri nga e’yo omvi, nga ’yo emi tia, Ma nini pari emini engazuri ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.25",
            "verseOrgIds": [
              "LUK.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.22"
              },
              "items": [
                {
                  "text": "Mat 7:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nga di ’ba ’yo, Ama nya ndra, ama mvu ndra mi milia, mi imba ndra ’ba gboko amani ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.26",
            "verseOrgIds": [
              "LUK.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.6.8"
              },
              "items": [
                {
                  "text": "Zab 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga ’yo, Ma ’yo emi tia, ma nini pari emini engazuri ku; emi da emi ma vurisi ra, emi ’ba azi onzi ’yepi ’diyi dria! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.27",
            "verseOrgIds": [
              "LUK.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.11+MAT.8.12"
              },
              "items": [
                {
                  "text": "Mat 8:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.13"
              },
              "items": [
                {
                  "text": "Mat 22:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.30"
              },
              "items": [
                {
                  "text": "25:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dale awu pi nga ovu indi, si nyaza be, emi ka nga Iburahimu pi ndre, Isaka pie, Yakobo pie, nabi pie dria suru Munguni ma alia, de o’be emi ngulupi amve ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.11"
              },
              "items": [
                {
                  "text": "Mal 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.12"
              },
              "items": [
                {
                  "text": "Isa 49:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.19"
              },
              "items": [
                {
                  "text": "59:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.107.3"
              },
              "items": [
                {
                  "text": "Zab 107:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.15"
              },
              "items": [
                {
                  "text": "Luk 14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga enga geri etuni efurialeruri piarisi, etuni ’derialeruri pie, andraleruri pie, uruleruri pie dria, yi nga ri va suru Munguni ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.30"
              },
              "items": [
                {
                  "text": "Mat 19:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.16"
              },
              "items": [
                {
                  "text": "20:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.31"
              },
              "items": [
                {
                  "text": "Mar 10:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ndre, ’ba ovupi vile ’diyi ma azi nga ovu ’ba drileru, azini ’ba ovupi drile ’diyi ma azi nga emvi ’ba vileru.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 13:30"
          },
          "items": [
