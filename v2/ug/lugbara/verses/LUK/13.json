              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.9"
              },
              "items": [
                {
                  "text": "Luk 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.10"
              },
              "items": [
                {
                  "text": "Mat 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.19"
              },
              "items": [
                {
                  "text": "21:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.13"
              },
              "items": [
                {
                  "text": "Mar 11:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga e’yo o’beza ’diri olu indi: Agu alu ovu elio pati be sale nga erini ma alia; eri emu efini ndru ruania, te eri isuni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo ’ba pati raza edepiri ma tia, Mi ndre, ma emu eli nani ’disi efi ndruzu elio ’diri ma ruaa, te ma isuni ku. Mi ga eri va; eri angu eza toko a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.7",
            "verseOrgIds": [
              "LUK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.9"
              },
              "items": [
                {
                  "text": "2 Pet 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Erini e’yo omvi­ria eri nga ’yo eri tia, Opi, mi ku nga eri eli ’disi indi, de nga ma ofuni etini wara ’bazu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.8",
            "verseOrgIds": [
              "LUK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ka efi ’ya vilerisi, onyiru; ka ku, mi nga eri ga va ndo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.9",
            "verseOrgIds": [
              "LUK.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.9",
            "verseOrgIds": [
              "LUK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ovu ’ba imbaria pari ’bani yi okuzu ’diyi ma azi alua o’du sabatonisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.10",
            "verseOrgIds": [
              "LUK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ndre, oku indi ovupi orindi eri ’bapi okpo kokoruri be eli mudri drini arori; eri otra i nguluru, econi erini i ejuzaru uru aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.11",
            "verseOrgIds": [
              "LUK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ka eri ndre ra, eri nga eri omve ra, nga ’yo tinia, Oku, ma tru mi azo mini ovuzu okpo kokorurisi ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.32"
              },
              "items": [
                {
                  "text": "Mar 7:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga dri ti ruania; oku nde nga i eju kilili coti, nga Mungu inzi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.13",
            "verseOrgIds": [
              "LUK.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.9+EXO.20.10"
              },
              "items": [
                {
                  "text": "Efu 20:9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Azi 5:13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’ba dri cepi pari ’bani yi okuzuriari nga ovu di adrasi Yesuni ’ba rua etile o’du sabatonisirisi, eri nga e’yo omvi ’yo ’ba ongulumuru ma tia, O’du azia ’bani ani azi ngazu yi alia ’diyi indi; ka’dini emi emu o’du ’diyisi emi rua atizu, te emi emu etu sabatonisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.14",
            "verseOrgIds": [
              "LUK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.5"
              },
              "items": [
                {
                  "text": "Luk 14:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Opi nga e’yo omvi eri tia, Emi ’ba lokiri be ’diyi! ’Ba dria alu alu emi eselia adrini ti erini kani akanya tru licoasi eri jizu yi mvuzu o’du sabatonisi ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.9"
              },
              "items": [
                {
                  "text": "Luk 19:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "’Yeta 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oku Iburahimu ma zaaru, Sa­tanini ombele, mi ndre, eli mudri drini aro ’diri, onyiru yi ma tru eri ombeza eri ma ruaa ’dirisi o’du sabatonisi ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.16",
            "verseOrgIds": [
              "LUK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erini e’yo ’diyi ’yoria, drinza nga ’ba te agata gapi eri be ’diyi bi dria; te ’ba ongulumuru dria ovu ayikosi e’yo inzizaru dria erini ’yele ’diyisi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.17",
            "verseOrgIds": [
              "LUK.13.17"
            ]
          }
        }
      ]
    },
