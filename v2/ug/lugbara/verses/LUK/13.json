              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etu nde ’darisi ’ba Farisaini azini nga emu, ’yozu eri tia, Mi efu ’diarisi, mi mu, Herodeni lele mi fulerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’yo yi tia, Emi mu ’yo obalako ’dari ma tia, Mi ndre, andru dru indi, ma orindi onzi ofu amve, ma ’ba rua ati indi, te o’du nasi ma nga azi mani de teke­teke i paria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ti, ma ma mu geri mania andru, drusi, drozi; te econi nabini drazaru pari azinia amve ku, pe kiri Yerusalemua a’dule. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.33",
            "verseOrgIds": [
              "LUK.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.37+MAT.23.38+MAT.23.39"
              },
              "items": [
                {
                  "text": "Mat 23:37-39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yerusalemu, Yerusalemu, nabi ofupiri, azini ’ba yini tini pele vunia ’diyi o’bepi onisiri la! Ma le ndra anzi mini okuzu ma vu ekile a’u andrini i ma anzi okule opile ini ma etiarile ’dini pale si ya, te emi leni ku! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.25"
              },
              "items": [
                {
                  "text": "Zab 69:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "118:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.12.7"
              },
              "items": [
                {
                  "text": "Yer 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.5"
              },
              "items": [
                {
                  "text": "22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ndre, jo mini fi di mi dri andruru. Te ma ’yo emi tia indi, Emi ngani ma ndre ku, de nga emi ’yoni ku, ’Ba emupi Opi ma rusiri ma ovu inzizaru!",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.35",
            "verseOrgIds": [
              "LUK.13.35"
            ]
          }
        }
      ]
