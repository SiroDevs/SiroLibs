                {
                  "text": "Gal 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba azini kal osu kini i ni e’yo ra, isu de eri nini nga ekile onyiru eri ma ni rarile ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.2",
