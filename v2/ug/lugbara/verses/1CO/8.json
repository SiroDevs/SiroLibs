              "items": [
                {
                  "text": "Gal 4:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba Munguni lepi avasiri, Mungu ni ’ba nderi ra.",
          "type": "text",
