                  "text": "2 Kor 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nini emi ovu hekalu Munguni, azini Orindi Munguni ovu emi alia ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.16",
            "verseOrgIds": [
              "1CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba azini ka hekalu Munguni dri ja ra, Munguni nga eri dri ja ra hekalu Mungunirini ovule alatararurisi, he kalu ’diri bani emi’i.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.17",
            "verseOrgIds": [
              "1CO.3.17"
            ]
          }
        }
      ]
