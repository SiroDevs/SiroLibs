                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka’dini Apoloni a’di’i ya? Pauloni a’di’i ya? Yi ’ba ’ba aza kopi emini e’yo a’izu geri yinisi ’diyi, te ekile Opini fele yi alu alu dririle. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.5",
            "verseOrgIds": [
              "1CO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
