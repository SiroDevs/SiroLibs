            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.4+ACT.18.5+ACT.18.6+ACT.18.7+ACT.18.8+ACT.18.9+ACT.18.10+ACT.18.11"
              },
              "items": [
                {
                  "text": "’Yeta 18:4-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.24+ACT.18.25+ACT.18.26+ACT.18.27+ACT.18.28"
              },
              "items": [
                {
                  "text": "24-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ri ori ra, Apolo oya yi drinia, te Mungu fe zozanini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.6",
            "verseOrgIds": [
              "1CO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini ’ba ori ripiri toko, ’ba yi oyapiri vini toko, te lu Mungu zozani fepiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.7",
            "verseOrgIds": [
              "1CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini ’ba ori ripiri pi ’ba yi oyapiri be yi tro tro, ’ba alu alu nga oya i vileri a’i azi ini vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.8",
            "verseOrgIds": [
              "1CO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.3+MAT.13.4+MAT.13.5+MAT.13.6+MAT.13.7+MAT.13.8+MAT.13.9"
              },
              "items": [
                {
                  "text": "Mat 13:3-9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.20"
              },
              "items": [
                {
                  "text": "Efe 2:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama ovu ’ba Munguni azi ngapi tualu ’diyi; emi ovu amvu Munguni, azini jo Munguni sileri’i.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.9",
            "verseOrgIds": [
              "1CO.3.9"
            ]
          }
        }
