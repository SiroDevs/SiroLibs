              "items": [
                {
                  "text": "Zab 94:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini dika kini, Opini asisile ’ba, onduaru ’diyini ni ra kini yi ovu toko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.20",
            "verseOrgIds": [
              "1CO.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi ’ba azini ma, enya i e’yo ’banisi ku. Te afa dria yii emini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.21",
            "verseOrgIds": [
              "1CO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kani Paulo’i, kani Apo­lo’i, kani Kefa’i, kani wudrikuruni, kani idrini, kani dratani, kani afa curu’do indi ’diyi, kani afa ngapi emupi nde ’diyi, yi dria emini; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.22",
            "verseOrgIds": [
              "1CO.3.22"
            ]
          }
        },
        {
