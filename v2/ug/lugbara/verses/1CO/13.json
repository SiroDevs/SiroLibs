            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.4"
              },
              "items": [
                {
                  "text": "Fil 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri ’yeni e’yo dri fupi ’ba milia kuri ku, ndruni e’yo i vileri ku, omvini e’yo aokosi ku, egani e’yo ’onzi ku; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.5",
            "verseOrgIds": [
              "1CO.13.5"
            ]
          }
        },
        {
