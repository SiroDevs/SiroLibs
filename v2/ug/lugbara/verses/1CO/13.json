                  "text": "Rum 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ovuni ayikosi e’yo onzisi ku, te ovu ayikosi e’yo adaru­’risi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.6",
            "verseOrgIds": [
              "1CO.13.6"
            ]
          }
        },
