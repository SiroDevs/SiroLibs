              "items": [
                {
                  "text": "Rum 15:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri candi a’i dria asi tezasi, leri e’yo dria a’i a’itasi, eri asi ’baza be e’yo dria tezu, eri ovu asi e’yere be e’yo dria ma alia andekokoro.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.7",
            "verseOrgIds": [
              "1CO.13.7"
            ]
          }
