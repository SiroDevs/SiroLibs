              "type": "text"
            }
          ]
        },
        {
          "text": "Leta avasiri eri asi teza be, eri ’asi ndriza be; leta avasiri ovuni ’ma’yalasi ku; leta avasiri ’yoni e’yo afusi ku, ipini i afusi ku indi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.4",
            "verseOrgIds": [
              "1CO.13.4"
            ]
          }
        },
