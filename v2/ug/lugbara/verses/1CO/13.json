              "items": [
                {
                  "text": "21:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.23"
              },
              "items": [
                {
                  "text": "Mar 11:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ka e’yo olu nabile, ka e’yo zizaru ’diyi va dria, nita dria be, ma ka ovu a’ita be dria ’dini mani ecozu ’ani oni amboru ’diyi onzezu yi pariasi ra ti, te ma ka ovu leta avasiri ’be ku ma ovu toko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.2",
            "verseOrgIds": [
              "1CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.2"
              },
              "items": [
                {
                  "text": "Mat 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ka afa ’mani fe dria nyaka awazu ’ba alioru ’diyi dri, ma ka ma rua fe evezu acisi,ti, te ma ka ovu leta avasiri be ku, orodrini ma dri yo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        }
      ]
