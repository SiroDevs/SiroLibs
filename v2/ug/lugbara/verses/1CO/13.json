              "type": "tag",
              "attrs": {
                "loc": "1TH.1.3"
              },
              "items": [
                {
                  "text": "1 Tes 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.16"
              },
              "items": [
                {
                  "text": "1 Yoh 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te di e’yo na ’diyi indi, yi adri ’dani: a’tani, e’yo tezani, leta avasiri; te agapi yi ma eselia ambori eri leta avasiri’i.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.13",
            "verseOrgIds": [
