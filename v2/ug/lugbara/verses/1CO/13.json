          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma ece emi dri geri onyiru tu agapi rari ’di. Ma ka e’yo ’yo andre ’banisi, kani malaikanisi ra ti, te ka ovu leta avasiri be ku, ma eca ovuzu mola wupi wurile, kani emve cole corile. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.1",
            "verseOrgIds": [
              "1CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 13:2"
          },
