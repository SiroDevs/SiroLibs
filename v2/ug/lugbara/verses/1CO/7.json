              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.7",
            "verseOrgIds": [
              "1CO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma e’yo ’yo ’ba ojoloru ’diyi pi ma tia awuzi be, eri ovu onyiru yi dri yi ka ovu ekile male ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.8",
            "verseOrgIds": [
              "1CO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.14"
              },
              "items": [
                {
                  "text": "1 Tim 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi ka ovu okpo be yi rua dri sizu ku, ma je yi je je. A’disiku oku bizu eri onyiru aga lini suzu ’ba ruaari ra.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.9",
            "verseOrgIds": [
              "1CO.7.9"
            ]
          }
        }
      ]
    },
