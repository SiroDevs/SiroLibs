              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Mungu ope ’ba azini kanisa alia ’dini, okorisi ’ba ti opele ’diyi, iririsi ’ba e’yo nabiru olupi ’diyi, narisi ’ba ’ba imbapi ’diyi, vutinia ’ba tali ’yepi ’diyi pi, vutinia ’ba afa feza ’ba rua atizuri be ’diyi pie, ’ba ’ba aza kopi ’diyi pie, ’ba ’ba dri cepi ’diyi pie, ’ba e’yo ’yopi ti ndu ndusi ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba dria yi ’ba ti opele ’diyiru ya? ’Ba dria yi ’ba e’yo olupi ’diyiru ya? ’Ba dria yi ’ba ’ba imbapi ’diyiru ya? ’Ba dria yi ’ba tali ’yepi ’diyiru ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.29",
            "verseOrgIds": [
              "1CO.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba,dria yi afa feza ’ba atizuri be ya? ’Ba dria yi e’yo ’yo ti ndu ndusi ya? ’Ba dria yi ti oja ra ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.30",
            "verseOrgIds": [
              "1CO.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 12:31"
          },
          "items": [
