                  "text": "Efe 5:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi ovu rua Kristoni, emi alu alu ovu rua nde ma eseleni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
            "verseOrgIds": [
              "1CO.12.27"
            ]
