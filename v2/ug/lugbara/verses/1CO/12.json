                "loc": "EPH.4.4"
              },
              "items": [
                {
                  "text": "Efe 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te afa feza ma suruti yi ndu ndu, te Orindi eri alu ’da’i; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.11"
              },
              "items": [
                {
                  "text": "Efe 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te azi ’ba aza kozu ’diyi ma suruti ndu ndu, te Opi eri alu ’da’i; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.5",
            "verseOrgIds": [
              "1CO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "te okpo azi ngazu ’diyi ma suruti yi ndu ndu indi, te Mungu afa dria ’yepi okposi e’yo dria ma aliari alu ’da’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.6",
            "verseOrgIds": [
              "1CO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.14.26"
              },
              "items": [
                {
                  "text": "1 Kor 14:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te fe e’daza Orindini i e’dazuri ’ba dria alu alu dri, ’ba aza kozu ani beni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.7",
            "verseOrgIds": [
              "1CO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba aluri dri fe e’yo ’yoza onduaniri Orindi ndesi, ’ba aziniri dri fe e’yo ’yoza nitaniri Orindi nde vusi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.8",
            "verseOrgIds": [
              "1CO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba aziniri dri a’itani Orindi nderi ma alia, ’ba aziniri dri feta ’ba ma rua atizu ’diyi Orindi nde aluri ma alia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.9",
            "verseOrgIds": [
              "1CO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.14.5"
              },
              "items": [
                {
                  "text": "1 Kor 14:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.4"
              },
              "items": [
                {
                  "text": "’Yeta 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba aziniri dri okpo tali ’yezu diyi, ’ba aziniri dri e’yo oluzu’i, ba aziniri dri e’yo orindi ’diyini amazuri’i ’ba aziniri dri e’yo ’yozu ti ndu ndusiri ojazuri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.10",
            "verseOrgIds": [
              "1CO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.3"
              },
              "items": [
                {
                  "text": "Rum 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.7"
              },
              "items": [
                {
                  "text": "Efe 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.7"
              },
              "items": [
                {
                  "text": "1 Kor 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ye e’yo diyi dria Orindi nde alu ’dari ma okposi, erini e’yo ndu ndu awaria ’ba dria alu alu dri ekile erini lelerile",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.11",
            "verseOrgIds": [
              "1CO.12.11"
            ]
          }
        }
      ]
    },
