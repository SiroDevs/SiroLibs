                  "text": "Ebra 10:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ega Mungu ece ama ’ba ti opele ’diyi ’ba vile asizuriru, ’ba dra lile yi ma dria ’diyile; a’disiku ’ba ama afa luzaru wudrikuru pi ma milia, malaika pie, ’ba pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.9",
            "verseOrgIds": [
              "1CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
