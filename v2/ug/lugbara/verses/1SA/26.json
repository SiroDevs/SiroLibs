              },
              "items": [
                {
                  "text": "2 Sam 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Daudi enga ra, eri emu pari Sauloni i ma hema asozuria; azini Daudi mire pari Saulo pini yi lazu Abineri Neri mvi ’ba asikari ma dri cepiri beri indi; isu Saulo ai pari agaduaria, te asikari ongulumuru ’di yi yi ori eri ma kalaasi dria ci, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.5",
            "verseOrgIds": [
              "1SA.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
