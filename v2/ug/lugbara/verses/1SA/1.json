              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.7.11"
              },
              "items": [
                {
                  "text": "Yob 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.10.1"
              },
              "items": [
                {
                  "text": "10:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.30.3"
              },
              "items": [
                {
                  "text": "Kal 30:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.17.8"
              },
              "items": [
                {
                  "text": "2 Sam 17:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Hana ma asi ovu matusi ambo tu, eri zi Yehova tia, eri wu okporu taisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.10",
