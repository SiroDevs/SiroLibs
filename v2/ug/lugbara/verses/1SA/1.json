                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu de ndra agu alu indi, eri ’ba Ramataimu-zofimu angu oniru Efiraimuari ma aliari, runi Elikana’i Yerohamu mvi, Yerohamu Elihu mvi, Elihu Tohu mvi, Tohu Zufu mvi, suru Efiraimuari. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.1",
            "verseOrgIds": [
              "1SA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri oku be iri; aluri ma ru Hana’i, aziri ma ru Penina’i. Penina ovu anzi beni, te Hanovu ami kokoru. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.2",
            "verseOrgIds": [
              "1SA.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 1:3"
          },
          "items": [
