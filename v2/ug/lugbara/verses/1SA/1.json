              "type": "text"
            }
          ]
        },
        {
          "text": "Te agu nde Elikanaruri ’ba eri vile joa ’diyi pie dria, yi tu mu edeta eli vusiri pi fezu Yehova dri, oyo soza erini be. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.21",
            "verseOrgIds": [
              "1SA.1.21"
            ]
          }
        },
