            }
          ]
        },
        {
          "text": "’Dini Hana enga yini nyaka nyaria azini mvuria Siloa ’boria. Isu de Eli atalau edeta edepiri ri i vile oguna dria, otile hekalu Yehovaniri ma pati ageia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.9",
            "verseOrgIds": [
              "1SA.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 1:10"
          },
          "items": [
            {
