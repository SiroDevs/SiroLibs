              "items": [
                {
                  "text": "3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Hana tuni ini ku, te eri ’yo agupi ini ma ria kini, Ma ngani tu mu ’dale ku, kpere mvani ba kuria; ma nga eri ji ndo, ’dini eri ma efu Yehova ma milia ovuzu ’dale ’dani ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.22",
            "verseOrgIds": [
              "1SA.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
