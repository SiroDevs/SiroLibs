              "attrs": {
                "loc": "DEU.12.5"
              },
              "items": [
                {
                  "text": "Azi 12:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te erini kuria mva endruzu ’boria, eri ’du eri ji indi, monio na ’diyi anyafura abaka aluri pie, patiefi ma su kerea aluri pie; eri ji di eri jo Yehovani Siloaria, de mva nde nga werearu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi li monio ra, yi ji mva nde Eli vu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.25",
            "verseOrgIds": [
              "1SA.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Hana ’yo ra, Opi mani la! Ekile orindi minini ovule indirile, opi mani, ma ovu oku ndra pa sopi mi ageia ’doa zipi Yehova ma tiari’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.7"
              },
              "items": [
                {
                  "text": "Mat 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma zi ndra mva ’diri ma e’yosi; azini Yehova fe ma dri afa mani e’yoni zile eri ma tiari. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
        },
        {
