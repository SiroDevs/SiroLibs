                  "text": "2 Sam 7:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te agupi erini Elikana ’yo tinia kini, Mi ’ye e’yo endrepi mi milia onyiruri, mi te kpere mini kuria mva endruzu ’boria; Yehova ma ’ye lu e’yo ini. ’Dini oku nderi te ra, eri endru mva cazu o’du erini kuzu mva endruzuri tia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.23",
            "verseOrgIds": [
              "1SA.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
