          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "te eri nga eca ’dini, ewu nde ka eca ra, Hana nga a isu ra, eri osi agupimvani, te eri ’da runi Samueli’i, kini, A’disiku mani eri zile Yehova tiarisi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.20",
            "verseOrgIds": [
              "1SA.1.20"
            ]
