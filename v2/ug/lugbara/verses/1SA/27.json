                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.18"
              },
              "items": [
                {
                  "text": "E’do 25:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi pi tu ’ba ini ’diyi be; yimu fi angu ’ba Gesuriniri pi ma alia, ’ba Girizini pie, ’ba Amalekini pie, omba ’bazu yi be; te engazu gbudrio suru ’diyi yi ovu kari’baru angu ndea, cazu Suria kpere Misiria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.8",
            "verseOrgIds": [
              "1SA.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ja angu nderi ma dri, eri kuni agupi kani oku idriru aluni ku, azini eri o’du kabilo pi, ti pie, akanya gaaru ’diyi pie, ngamia pie, bongo suza pie, eri emvi ra, eca Akisi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.9",
            "verseOrgIds": [
              "1SA.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.141.3"
              },
              "items": [
                {
                  "text": "Zab 141:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.29.25"
              },
              "items": [
                {
                  "text": "O’be 29:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.9"
              },
              "items": [
                {
                  "text": "1 Sur 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Akisi ka ’yo ra, Emi mu te andru ombaa ’ba a’diko be ya? Daudini adri omvi ra kini, Kala, uruleru Yudaniri ma dri aruzu, kani kala uruleru ’ba Yerameelia ’diyiniri ma dri aruzu, kani kala uruleru ’ba Kenia ’diyiniri ma dri aruzu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.10",
            "verseOrgIds": [
              "1SA.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Daudi kuni ’ba azini agupi kani oku idriru aluni ejizu Gatua ku, kini, Yi kazu ’yozu ama ma e’yosi ku kini, Daudi ’ye ’dini. Azini adriza erini o’du dria erini adrizu angu ’ba Filisitiaa ’diyiniria ovu ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.11",
            "verseOrgIds": [
              "1SA.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akisi a’i e’yo Daudini, kini, Eri fe ’ba ini Israelini ’diyi ma ngu i onzi tu; ’dini eri nga ovu ati’bo mani ’dani ’dani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.12",
            "verseOrgIds": [
              "1SA.27.12"
            ]
          }
        }
      ]
    }
