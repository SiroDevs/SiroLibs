              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te e’yo Samuelini nga eca ’ba dria Israelini ’diyi vu ra. ’Ba Filisitiaa ’diyini sanduku pazuri Te ’ba Israelini yi fu mu a’di ’dizu ’ba Filisitiaa ’diyi be; yi aso hema yini Ebenezeri ageia, te ’ba Filisitiaa ’diyi aso hema yini Afekia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Filisitiaa ’diyi yi oti yi a’di ’dizu ’ba Israelini be, te yini e’dozu ’bazu a’di ’dizu ’boria, ’ba Filisitiaa ’diyi aga ’ba Israelini ’diyi ra, yi ofu ’ba ekile alifu sule pari a’di ’dizuria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.2",
            "verseOrgIds": [
              "1SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba ka fi pari yini hema asozuria ’bo, ’ba ’wara Israelini ’diyi ’yo kini, Yehova ofu andru ama ’ba Filisitiaa ’diyi ma drilia ’doni a’disi ya? Ama ma mu amani sanduku aziza Yeho­vanirini ’duzu Siloa ejizu ’doa, ’dini erini ovuzu ama eseliaria, eri ma opa ama juru amani ma dria beni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.3",
            "verseOrgIds": [
              "1SA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
