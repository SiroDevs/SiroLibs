            }
          ]
        },
        {
          "text": "Yi ’du sanduku Munguni ra, yi ofu anzi Elini iri, Hofini pi Finehasi be.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
            "verseOrgIds": [
              "1SA.4.11"
