                  "text": "1 Sam 30:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Daudi ni e’yo Sauloni e’yo onzi otuzu i ruaari; eri nga ’yo Abiatari atalau edeta edepiri ma tia, Mi eji koti alinari ’doa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.9",
            "verseOrgIds": [
              "1SA.23.9"
            ]
          }
        },
        {
