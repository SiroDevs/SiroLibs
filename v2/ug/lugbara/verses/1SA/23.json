          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi piyi ’ba erini ’diyi pie yi ovu de angu rokoru Maoniaria e’bu Arabaa kala Yesimoni uruleruria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Saulo pi ’ba erini ’diyi be yi mu eri ndruzu. Te yi olu Daudi tia ra; e’yo ’disi eri esi va kataa oni oji alia, eri adri angu rokoru Maoniria. Saulo ka eri ’dini ’bo, eri dro Daudi ma vuti angu rokoru Maoniri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.25",
            "verseOrgIds": [
              "1SA.23.25"
            ]
          }
        },
        {
