        },
        {
          "text": "Te ojio nga emu Saulo vu kini, Mi ’ye mbele mbele, mi emu; a’disiku ’ba Filisitiaa ’diyi yi efi angua ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.27",
            "verseOrgIds": [
              "1SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
