              "items": [
                {
                  "text": "1 Sam 25:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi enga ra, yi mu Zifia Saulo ma drilia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        }
