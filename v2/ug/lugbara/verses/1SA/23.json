                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri eca ’dini, Abiatari Ahimeleki mvi ka apa Daudi vu Keilaa ra, eri esi koti alinari be eri ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        },
