              "items": [
                {
                  "text": "2 Sam 21:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi iri tro azi aziza Yehova ma milia ra; te Daudi adri di ini Horesia ’daa, te Yonatani mvi i vile joa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        }
      ]
