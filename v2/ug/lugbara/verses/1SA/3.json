                  "text": "1 Pet 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Samueli nga e’yo dria olu eri tia, eri ocini e’yo azini eri dri aluni ku. Te eri ’yo ra, Eri Yehova’i, eri ma ’ye e’yo dria ovupi onyiru eri ma miliarile.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
