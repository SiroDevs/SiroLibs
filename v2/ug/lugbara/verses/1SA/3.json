                  "text": "Lev 24:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "isu de inyuni tala Munguni nga ku, te Samueli la de i hekalu Yehovani alia, pari sanduku Mungu­nini adrizuria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nga Samuelini omve, te eri a’i kini, Ma ’do’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nzu Eli vu, kini, Ma ’do’i, a’disiku mi omve ma mi’i. Te eri ’yo ra, Ma omveni mi ku; mi mu la va dika. Te eri mu ra, lazu va. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova omve eri dika, Samueli! Te Samueli enga ra, mu Eli vu, kini, ’Ma ’do’i, a’disiku mi omve ma mi’i. Te eri omvi e’yo kini, Ma omveni mi ku, ma mvi; mi mu la va dika. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.24"
              },
              "items": [
                {
                  "text": "Yer 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.2"
              },
              "items": [
                {
                  "text": "’Yeta 19:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Samueli nini nga Yehovani ku, o’duko Yehovani efuni oku nga eri vu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yehova nga Samuelini lomve dika pale na. ’Dini eri enga ra, mu Eli vu, kini, Ma ’do’i, a’disiku mi omve ma mi’i. Te Eli nga di va ra kini, Yehova omve mva nderini. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi Eli ’yo Samueli ma tia kini, Mi mu la va; eri nga ovu ’dini eri ka nga omve ra, mi a’i ’dini, Mi ’yo e’yo, Yehova, ati’bo miniri e’yo eri ’di. ’Dini Samueli mu i lazu va i ma paria,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        }
      ]
    },
