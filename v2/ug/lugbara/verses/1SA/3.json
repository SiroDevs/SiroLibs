              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.26+HEB.10.27+HEB.10.28+HEB.10.29+HEB.10.30+HEB.10.31"
              },
              "items": [
                {
                  "text": "Ebra 10:26-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ma so oyo ori’ba Elini vu kini, azi onzi ori’ba Elinirini ngani ovu wuzaru edetasi, kani afa fezasi ’dani ’dani ku.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        }
      ]
