              "attrs": {
                "loc": "ROM.12.9"
              },
              "items": [
                {
                  "text": "Rum 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi ’yo Akisi ma tia, ’Yeke, mi di nga ni e’yo ati’bo minirini ecole ’yeleri. Azini Akisi ’yo Daudi ma tia, ’Yeke, ma di nga mi ’ba ’ba ma dri agei tepi ’dani ’daniriru.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
