                "loc": "1SA.15.28"
              },
              "items": [
                {
                  "text": "1 Sam 15:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ’ye mi dri ekile erini ndra ’yole ma tisirile; azini Yehova asi suru opi nyaza mi driasi, fe eri ’ba mi ageiari dri, adaru Daudi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
