                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba Filisitiaa ’diyi oku yi tualu, yi emu hema yini aso Sunemua; te Saulo oku ’ba Israelini ’diyi dria tualu, yi emu hema yini aso Giliboaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.4",
            "verseOrgIds": [
              "1SA.28.4"
            ]
          }
        },
