        {
          "text": "’Ba Filisitiaa ’diyi ka sanduku Munguniri ’du ’bo, yi ji eri engazu Ebenezeria cazu Asidodia, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
