            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Filisitiaa ’diyi ’du sanduku Munguniri ji eri jo Dagoni vileria, ’ba eri Dagoni ma ageia ogogo. ",
