                  "text": "1 Sam 14:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Samueli enga ra, eri tu uru engazu Giligalia muzu Gibea Benya­mininiria. Saulo la ’ba ovupi eri be ’diyi ma kalafe ra, yi ekile ’ba turu aziale. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Saulo pi i mvi Yonatani pie, ’ba ovupi yi be ’diyi pie, yi adri Gibea Benyamininiria; te ’ba Fili­sitiaa ’diyi yi aso hema Mikimasia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.23"
              },
              "items": [
                {
                  "text": "Yos 18:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba angu ezapi ’diyi efu pari ’ba Filisitiaa ’diyini rizuriasi ongulumu na; ongulumu aluri oja yi muzu geri Ofiraasi, kpere Sualia, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.17",
            "verseOrgIds": [
              "1SA.13.17"
            ]
          }
