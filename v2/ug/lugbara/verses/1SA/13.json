                "loc": "JDG.6.2"
              },
              "items": [
                {
                  "text": "Lip 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Israelini yini ndreria yi ovu pari ewaruria (a’disiku ’ba ’diyi ovu taisi tu), yi nga di yi ozi oni ojia, azini asea, azini kata alia, azini yi gule alia, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.6",
            "verseOrgIds": [
              "1SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ’ba Ebraniani azini ’diyi zo Yoridania ’aa’dasi angu Gadinia azini Gileadia. Te Saulo ovu nga Giligalia, ’ba dria bi vutini rua yaza be. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.8"
              },
              "items": [
                {
                  "text": "1 Sam 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri te ’daa o’du aziri, ekile ndra Samuelini pelerile; te Samueli ecani Giligalia ku, te ’ba ere yi eri ageiasi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.8",
            "verseOrgIds": [
              "1SA.13.8"
            ]
          }
        },
