        },
        {
          "text": "te ’ba Israelini dria alu alu si va ’ba Filisitiaa ’diyi vu, aya si be nyaku lipi yiniri pi ejizu okaa, e’bu pie, ogara pie, ngule pie; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.20",
            "verseOrgIds": [
              "1SA.13.20"
            ]
          }
        },
