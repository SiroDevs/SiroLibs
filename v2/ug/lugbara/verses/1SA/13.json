            }
          ]
        },
        {
          "text": "Te curu’do suru nyaza ’miniri ngani ovu ’dani ku; Yehova ndru ’ba i asini lele turi ’bo, azini Yehova pe eri ovuzu opiru ’ba ini drilia ’bo, a’disiku mi mbani azita Yehovani azile mi tiari ma ta ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 13:15"
          },
          "items": [
