        },
        {
          "text": "Te Saulo ’yo ra, Emi eji edeta vezaruri ma vu ’doa, azini edeta asi anzuni ’diyi indio Te eri nga edeta vezaru nderi ve. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.9",
            "verseOrgIds": [
              "1SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 13:10"
          },
          "items": [
            {
              "text": "10",
