                  "text": "E’do 34:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yonatani ofu asikari Filisitiaa ndra adripi Gebaa ’diyi; azini ’ba Filisitiaa ’diyi yi eri e’yo nderi ra. Te Saulo vu guka angu ndea dria, kini, ’Ba Ebraniani ma eri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.3",
            "verseOrgIds": [
              "1SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Israeli dria eri kini Saulo ofu asikari Filisitiaa ’diyi ’bo, azini ’ba Filisitiaa ’diyi ngu Israeli onzi ani. Te yi omve ’ba ongulumuru yi okuzu Saulo vu Giligalia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.12"
              },
              "items": [
                {
                  "text": "Yos 18:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba Filisitiaa ’diyi oku yi tualu a’di ’dizu Israeli be, gari ombani alifu kali na, ’ba nzupi lakanya dria ’diyi alifu azia, azini ’ba ongulumuru ekile cinya miri tiarile; yi etu ra, yi aso hema yini Mikimasia, engazu Betavenia etuni efurialeruria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.5",
            "verseOrgIds": [
              "1SA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
