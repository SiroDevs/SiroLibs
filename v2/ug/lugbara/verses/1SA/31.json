        },
        {
          "text": "Te yi ’ba afa sule ayaru erini ombani ’diyi Asitaroti vile joa; azini yi ombe eri ma avu abi Beti-saniari ma ruaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.10",
            "verseOrgIds": [
