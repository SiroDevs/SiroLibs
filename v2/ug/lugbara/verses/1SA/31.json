        },
        {
          "text": "Te ’ba filisitiaa ’diyi yi ’di a’di ’ba Israelini pie; te ’ba Israelini apa ’ba Filisitiaa ’diyi ma driliarisi ra, yi ofu yi, yi o’de va oni Giliboa ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.1",
            "verseOrgIds": [
              "1SA.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 31:2"
          },
          "items": [
