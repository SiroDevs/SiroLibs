                "loc": "1CH.8.33"
              },
              "items": [
                {
                  "text": "1 Sur 8:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba Filisitiaa ’diyi yi dro Saulo pi ma vuti okposi anzi erini be; te ’ba Filisitiaa ’diyi yi ofu Yonatani pi Abinadabu pie, Malikisua pie, yi anzi Sauloni ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.2",
            "verseOrgIds": [
              "1SA.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
