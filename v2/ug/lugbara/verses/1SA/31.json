              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba adripi Yabesi-gileadia ’diyi ka e’yo ’ba Filisitiaa ’diyini ’yele Saulo ma ruaa ’diyi eri ra, ",
          "type": "text",
          "attrs": {
