                "loc": "2SA.1.6"
              },
              "items": [
                {
                  "text": "2 Sam 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini a’di eca Saulo ma ruaa onzi, azini ’ba ’ye gbipi ’diyi ca eri vu ra; azini ’ba ’ye gbipi ’diyi gbi eri onzi tu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.3",
            "verseOrgIds": [
              "1SA.31.3"
            ]
          }
        },
        {
