                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te, mi ndre, ma ni ra, mi nga ovu opiru ada, azini opi nyaza Israeli ma driliari nga pa so minini. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.20",
            "verseOrgIds": [
              "1SA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi mi so oyo curu’do, kini mi ngani ori mani ma dri ja ma vutia ku beni, azini mi ngani ma ru nze ori’ba ma atini ma eseliasi ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.21",
            "verseOrgIds": [
              "1SA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Daudi nga oye nde so Saulo tia ra. Saulo mvi di akua; te Daudi pi ’ba erini ’diyi pie yi tu pari ekporuria.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.22",
            "verseOrgIds": [
              "1SA.24.22"
            ]
          }
