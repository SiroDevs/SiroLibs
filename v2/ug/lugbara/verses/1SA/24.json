                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi Israeliniri efu a’di ma vutia ya? Mi a’di ma vuti dro ya? Oce avuni! Kani ogalirini! ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.14",
            "verseOrgIds": [
              "1SA.24.14"
            ]
