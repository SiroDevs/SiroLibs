              "type": "tag",
              "attrs": {
                "loc": "JOB.5.8"
              },
              "items": [
                {
                  "text": "Yob 5:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ma iji e’yo ama eselia mi be, azini Yehova ma ofe ma arioti mi ruaani; te ma ngani dri ’ba mi ruaa ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.12",
            "verseOrgIds": [
              "1SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekile e’yo o’beza ’ba drio ’diyini ’yolerile, ’Ba onzi ’diyi ma lalia e’yo onzini efuni; te dri mani Ingani ovu mi ruaa ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.13",
            "verseOrgIds": [
              "1SA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
