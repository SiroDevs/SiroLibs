                  "text": "Mat 5:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini eri ’yo Daudi ma ria, Mi onyiru aga ma ra; mini e’yo onyiru fele ma dri de ma fe mi dri e’yo onziri’irisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.17",
            "verseOrgIds": [
              "1SA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini mi ece o’du ’dirisi e’yo mini ma ’yezu onyiruri ’bo, a’disiku Yehova ka ma fe mi dria ’bo, mi funi ma ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.18",
            "verseOrgIds": [
              "1SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te agu ka i ma ari’bo isu, eri eri ku muzo lidriru ya? E’yo ’disi Yehova ma fe mi dri oya onyiruri e’yo mini ’yele ma vu o’du andrurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.19",
            "verseOrgIds": [
              "1SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
