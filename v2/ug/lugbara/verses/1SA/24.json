                "loc": "JOB.31.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azi­ni eri ’yo ’ba ini ’diyi ma tia, Yehova leni te ma ma ’ye e’yo ’diri ambo mani Yehovani odu osule drinia ’bori vu ku, mani ma dri ejuzu ’dini eri ma ruaa, a’disiku eri ovu ’ba Yehovani odu osule drinia ’bori’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.6",
            "verseOrgIds": [
              "1SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.7.4"
              },
              "items": [
                {
                  "text": "Zab 7:4",
                  "type": "text"
                }
