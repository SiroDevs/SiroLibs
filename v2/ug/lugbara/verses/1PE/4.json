          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’dirisi ’ba yi osu tu emini nzule yi be tualu e’yo ’yele saaru onzikanyaru aga driari ’yezu kurisi, yi o’da ani emi onzi; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.4",
            "verseOrgIds": [
              "1PE.4.4"
            ]
          }
        },
        {
