              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "emi ma fe ewu acepi emini ovuria rua ma aliari ma joloko li ’bani ’yezu ku, te e’yo Munguni leleri ’yezu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
