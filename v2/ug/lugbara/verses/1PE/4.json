              "items": [
                {
                  "text": "1 Kor 13:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te aga dria, leta emini emi lezu emi eseliari ma ovu avaru ’dani, te leta eri azi onzi karakarau a’bu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.8",
            "verseOrgIds": [
