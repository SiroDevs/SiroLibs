                "loc": "1TH.2.12"
              },
              "items": [
                {
                  "text": "1 Tes 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ka ovu ecandizaru were ’bo, Mungu ’yeta anzutiri driani, emi omvepi fizu diza erini ’dani ’dani Kristo ma aliari vuri ma ngulupini nga emi ede fudri ci, fezu emini pa sozu kirikiri, emi ’bazu okporu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.10",
            "verseOrgIds": [
              "1PE.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okpo opiru ma ovu eri vu ’dani ’dani. Amena.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.11",
            "verseOrgIds": [
              "1PE.5.11"
            ]
