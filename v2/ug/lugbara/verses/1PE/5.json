                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ovu asisile e’yere be, emi ma ovu mile be. Ari’bo emini ’ba asu supiri eri ad kamile, awu be ’ba ndazu nyazu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.8",
            "verseOrgIds": [
