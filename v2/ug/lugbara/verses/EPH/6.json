                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a’disiku emi ni ra ’ba dria alu aluni nga e’yo onyiru erini ’yeleri ma andeso isu Opi vu, eri ka teo ovu ati’boni kani kari’bani ti. ",
          "type": "text",
          "attrs": {
