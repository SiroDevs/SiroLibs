              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "au ngazu asisile onyirusi ekile Opi dririle, te ’ba dririle ku, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.7",
            "verseOrgIds": [
              "EPH.6.7"
            ]
