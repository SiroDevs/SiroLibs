          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma ’yo ra, Emi ma aci Orindisi, emi ma ’ye li ruani’i aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.16",
            "verseOrgIds": [
              "GAL.5.16"
            ]
          }
        },
        {
