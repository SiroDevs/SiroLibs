            "sid": "GAL 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.9"
              },
              "items": [
                {
                  "text": "1 Kor 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Yeta ruani e’da yi ’di: e’yo awururi pi, onzikanyaruri pi, ava ruani pi, ",
