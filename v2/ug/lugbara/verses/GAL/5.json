          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.15+ROM.7.16+ROM.7.17+ROM.7.18+ROM.7.19+ROM.7.20+ROM.7.21+ROM.7.22+ROM.7.23"
              },
              "items": [
                {
                  "text": "Rum 7:15-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.5"
              },
              "items": [
                {
                  "text": "Yak 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.11"
              },
              "items": [
                {
                  "text": "1 Pet 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te rua eri li be omba ’bazu Orindi be, Orindi pi rua be; a’disiku afa ’diyi ovu ari’baro, dri aruzu yi eselia, emi econi ani e’yo ’yezaru emini lelerile ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.17",
            "verseOrgIds": [
              "GAL.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.14"
              },
              "items": [
                {
                  "text": "Rum 8:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Orindi ka emi dri ceni, emi ovuni di azita ma palaa ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.18",
            "verseOrgIds": [
              "GAL.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
