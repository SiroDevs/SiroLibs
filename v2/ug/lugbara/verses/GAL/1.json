              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilerisi, eli na ma vutia, ma nga tu uru Yerusalemua Kefani nizu, ma nga ovu eri be o’du mudri drini towi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.18",
