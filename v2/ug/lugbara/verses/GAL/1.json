              "items": [
                {
                  "text": "’Yeta 9:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vutinia ma mu angu Suria pi ma ageia Kilikia beria ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.21",
            "verseOrgIds": [
              "GAL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
