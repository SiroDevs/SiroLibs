                  "text": "24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri andini yo, te ’ba azini emi asi ezapi ’diyi indi, yi le e’yo baru Kristoniri ojazu ndu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.7",
            "verseOrgIds": [
