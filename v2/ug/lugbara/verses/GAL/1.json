          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma a’ini eri ’ba vu ku, ’ba ada imbani mani eri onizuni ku indi, te Yesu Kristo ece eri ma dri lecetasini. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.12",
