                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi eri adriza ndra mani inzita ’ba Yahudini ma aliari ma e’yo ’bo, kini ma adri ndra kanisa Munguni inza aga ra, ma eza eri ra; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
