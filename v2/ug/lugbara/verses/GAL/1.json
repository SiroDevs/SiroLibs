                {
                  "text": "Mat 13:55",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ndreni ’ba ti opele ’diyi ma azini aluni ku, pe kiri lu Yakobo Opi ma adri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.19",
            "verseOrgIds": [
              "GAL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Mi ndre, Mungu ma milia, ma lini inzo le’yo mani sile emi vu’diyisi ku!) ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.20",
            "verseOrgIds": [
              "GAL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 1:21"
          },
          "items": [
