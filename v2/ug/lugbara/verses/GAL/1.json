              },
              "items": [
                {
                  "text": "1 Kor 16:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ka tro ama’i, kani malaika ’buari ti, ka e’yo baru andini olu emi tia pe lu kiri amani olule emi tia ’bori’i, eri ma ovu trizaru. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.8",
            "verseOrgIds": [
              "GAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
