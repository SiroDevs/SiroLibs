              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi eri kiri bilesi a’dule kini, ’Ba ndra ama inzapiri, eri curu’do a’ita ndra erini ezaleri ma e’yo olu’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
            "verseOrgIds": [
