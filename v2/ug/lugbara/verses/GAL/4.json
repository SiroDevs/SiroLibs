              "items": [
                {
                  "text": "2 Kor 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma matu ’ba emi vu, adripi, emi ma ovu mani ovulerile, a’disiku mani ovule emilerisi. Emi ’yeni ndra ma vu onzi aluni ku; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.12",
            "verseOrgIds": [
              "GAL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.6"
              },
              "items": [
                {
                  "text": "’Yeta 16:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.3"
              },
              "items": [
                {
                  "text": "1 Kor 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te emi ni ra kini ma olu ndra e’yo bari emi tia okorisi ma ruani ovule okpo koko-i rurisi; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.13",
            "verseOrgIds": [
              "GAL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.11"
              },
              "items": [
                {
                  "text": "’Yeta 14:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ka tro ndra e’yo ma ruaari o’bi emi o’bi o’bi ti, emi ’bani ma edematararu ku, emi onzoni ma ku, te emi a’i ndra ma ekile malaika Mungunirile, ekile Kristo Yesule. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.14",
            "verseOrgIds": [
              "GAL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayiko ndraka emini emi omvezu drilebaruri curu’do ngoa ya? Te ma ’ba e’yo emini ma eti nzepiri kini, ka ndra ’ye ’di eco rani, emi ’ye ndra emi mileefi nze fezu ma dri. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.15",
            "verseOrgIds": [
              "GAL.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.10"
              },
              "items": [
                {
                  "text": "Amo 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma eca di ari’bo eminiru, mani e’yo adari olule emi tiarisi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.16",
            "verseOrgIds": [
              "GAL.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.7"
              },
              "items": [
                {
                  "text": "Gal 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nda emi avasi ra ’bo, te de e’yo onyirusi ku; te yi le emi ti li ku amve, emi ma nda yi avasi beni. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.17",
            "verseOrgIds": [
              "GAL.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba ka emi nda avasi e’yo onyirusi etuzu ’yeke, te ma ovu lu mani ovuria emi be indirisi ka a’dule ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.18",
            "verseOrgIds": [
              "GAL.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.15"
              },
              "items": [
                {
                  "text": "1 Kor 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi nyiri nyiri mani, mvaazo ’ye ma dika emisi de nga Kristo ’bani i emi alia kilili ku! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.19",
            "verseOrgIds": [
              "GAL.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ka te ovu curu’do emi be indi, o’duko mani ojazu, ’yeke tu, a’disiku ma nini ma ma ’ye emisi ngoni yari ku.",
