              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma ’yo ’dini, karimvani ovuzu nga mvarorisi eri coni i esele ati’bo be ndu ndu ku, ka tro ovu afa dria ma opiruni ti; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.1",
            "verseOrgIds": [
              "GAL.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "te eri ovu ’ba eri ma agei tepi ’diyi pi ma palaa ’ba afa ta mbapi ’diyi be, de nga ewu eri ma atini peleri ecani ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.2",
            "verseOrgIds": [
              "GAL.4.2"
            ]
          }
        },
        {
