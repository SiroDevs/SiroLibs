                "loc": "GAL.2.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ega ma ovuni ’ba ti opele ambo agapi tu tu ’diyi ma vutialeru aluni i ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.5",
            "verseOrgIds": [
              "2CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 11:6"
          },
          "items": [
            {
              "text": "6",
