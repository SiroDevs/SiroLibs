              "items": [
                {
                  "text": "’Yeta 9:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.15"
              },
              "items": [
                {
                  "text": "14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma ovu acita alia pale kakau, ma ovu mira dra sia ogogo yi ara ma alia, ma dra sia ’ba afa opapi ’diyi dri, ma dra sia ori’ba mani ’diyi dri, ma dra sia ’ba lururu ’diyi dri, ma dra sia aku amboru ma alia, ma dra sia asea, ma dra sia miri alia, ma dra sia adripi inzoru ’diyi dri; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
