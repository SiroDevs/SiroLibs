                "loc": "1CO.15.10"
              },
              "items": [
                {
                  "text": "1 Kor 15:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.6"
              },
              "items": [
                {
                  "text": "Gal 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
