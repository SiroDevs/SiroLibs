                "loc": "1CO.9.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ’ye ndra onzi mani ma ngulupi ’baria wereru, emini ani ovuzu amboru, mani e’yo baru Munguni olule emi tia tokorisi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.7",
            "verseOrgIds": [
              "2CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.10"
              },
              "items": [
                {
                  "text": "Fil 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma opa ndra kanisa azini ’diyi ma afa, oya a’izu, azi mani ’yele emi dririsi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.8",
            "verseOrgIds": [
              "2CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.15+PHP.4.16+PHP.4.17+PHP.4.18"
              },
              "items": [
                {
                  "text": "Fil 4:15-18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.13"
              },
              "items": [
                {
                  "text": "2 Kor 12:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mani ovuria emi eselia jazini ovuria afa kokoru ti, ma ovuni nzizaru ’ba aluni dri ku, te adripi engapi Makedoniaa ’diyi fe ndra afa ovupi ma be yo ’diyini. E’yo driasi ma mba ndra ma ta ma kazu ovuzu nzizaru emi dri ku, azini ma nga ma ta mba ’dini ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.9",
            "verseOrgIds": [
              "2CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.15"
              },
              "items": [
                {
                  "text": "1 Kor 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ekile e’yo adaru Kristonirini ovule ma aliarile, ’ba aluni ngani enyaza mani ma enyazu ’diri oga ma dri angu Aka­yaaria ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.10",
            "verseOrgIds": [
              "2CO.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disi ya? Mani emi lele kurisi ya? Mungu ni ra!",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.11",
            "verseOrgIds": [
              "2CO.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
