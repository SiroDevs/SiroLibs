                  "text": "1 Kor 9:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’dini okpo kokoruni ya? Ma vini okpo kokoru indi ku ya? Yi fe a’dini abazuni ya? Ma asi veni ani indi ku ya?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
