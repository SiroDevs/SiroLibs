                "loc": "EPH.5.26"
              },
              "items": [
                {
                  "text": "Efe 5:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini ma ovu ma’yalasi emisi ma’yala Mungu­nirisi, te ma azi emi fezu agupi alu dri, mani ani emi ejizu Kristo vu aliria alarurile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.2",
            "verseOrgIds": [
              "2CO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1+GEN.3.2+GEN.3.3+GEN.3.4+GEN.3.5"
              },
              "items": [
                {
                  "text": "E’do 3:1-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ovu urisi, ekile urini Evani idle Lokiri onzi erinisirile, asisile emini kazu yi ezazu e’yo adaru azini e’yo alaru ovupi Kristo ma aliari kuzu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.3",
            "verseOrgIds": [
              "2CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.8"
              },
              "items": [
                {
                  "text": "Gal 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disi­ku ’ba azini ka eca, ka Yesu ndu amani olule kuri olu’i, kani emi a’i orindi ndu ndra emini a’ile kuri, kani e’yo baru ndu ndra emini a’ile kuri, emi adri emi asi te onyiru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.4",
            "verseOrgIds": [
              "2CO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.11"
              },
              "items": [
                {
                  "text": "2 Kor 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
