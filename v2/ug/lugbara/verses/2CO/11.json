            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.3.4"
              },
              "items": [
                {
                  "text": "Efe 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ka dri fu e’yo oluzasi were u, te nitasini ma ’dini yo; ama ece e’yo ’diri e’yo driasi emi vu, ’ba dria ma eselia.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.6",
            "verseOrgIds": [
              "2CO.11.6"
            ]
          }
        }
