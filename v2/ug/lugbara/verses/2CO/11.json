            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ’yo dika, ’Ba aluni ma ega kini ma azaza ’dini ku; re emi ka ega ’dini ti, emi a’i di ma ’ba azazarule, ’dini ma nga ani ma enya were beni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.16",
            "verseOrgIds": [
              "2CO.11.16"
            ]
          }
        },
        {
