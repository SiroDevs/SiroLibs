              "items": [
                {
                  "text": "2 Kor 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azi okporu pisi rua suza be, ovuzu o’du koza kokoru pale kakau, abiri pisi yi avijo be, ovuzu nyaka kokoru pale kakau, egbe pisi ovuzu pililiruri be. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
