              "items": [
                {
                  "text": "’Yeta 20:18-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Candi amve ’diyi ma dria, candi i epapi ma asia o’du driari indi, eri asi otiza mani kanisa dria ’diyi ma e’yosiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
