              "type": "text"
            }
          ]
        },
        {
          "text": "Ma le te emi ma te nga asi e’yo mani azaniri erizu were. Emi te nga emi asi mani fo! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.1",
            "verseOrgIds": [
              "2CO.11.1"
            ]
          }
        },
