              "items": [
                {
                  "text": "’Yeta 16:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.19"
              },
              "items": [
                {
                  "text": "14:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pale na co ma kalisi; pale alu o’be ma onisi. Pale na oguru nyo i ma be; ini rra, etu zu, ma ovu yi aliru ma alia ’dani; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.25",
            "verseOrgIds": [
              "2CO.11.25"
            ]
          }
        },
