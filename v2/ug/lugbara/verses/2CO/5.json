              },
              "items": [
                {
                  "text": "1 Kor 15:53",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini adaru ama ovupi hema ’dori ma alia ’diyi, ama ota ota ovuzu asi nziza be; ovuni kini ama le hema ’diri tru ra ’dini ku, te ama le azini su drinia’i, ’dini idri ma ki afa ecopi drapi rari ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
        {
