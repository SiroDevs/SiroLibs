              "items": [
                {
                  "text": "1 Tim 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.7"
              },
              "items": [
                {
                  "text": "Rum 14:7",
                  "type": "text"
                }
              ]
