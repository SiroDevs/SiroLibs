                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini eri dra ’ba driasi, ’ba ovupi idriru ’diyi ma ovu ani idri be yi ngulupisi ku, te ’ba drapi e’yo yinisi azini engapi dikari ma e’yosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
