                "loc": "ROM.8.23"
              },
              "items": [
                {
                  "text": "Rum 8:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te hema ’dori ma alia ama ota ota, amani leria tu jo amani engapi ’buari suzu’i; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.2",
            "verseOrgIds": [
              "2CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
