                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi eji vini anya indi, azini ase a’wi akanya pi dri, akanya nzupi ongusi ’diyi be, yi eji eri pari peleria, ekile e’yoni ovule azizaru yi tiarile. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
