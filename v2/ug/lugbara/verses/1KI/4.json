          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti nguza oso be ’diyi mudri, ti ocele nyamukoa ’diyi kali iri, kabilo; turu alu, eba pie, o’borojo pie, yere pie, a’u a’buza ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.23",
            "verseOrgIds": [
              "1KI.4.23"
            ]
          }
