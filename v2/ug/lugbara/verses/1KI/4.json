            }
          ]
        },
        {
          "text": "Te Yuda Israeli be yi ovu karakarau ekile cinya miri tiarile; yi ovu nyaria, mvuria, ayiko ’baria indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.20",
