            }
          ]
        },
        {
          "text": "Anyafura deni i afazu aliasi ku, azini odu deni i otekua aliasi ku indi, ekile e’yo Yehovani ’yole Eliya ma tisirile.",
          "type": "text",
          "attrs": {
