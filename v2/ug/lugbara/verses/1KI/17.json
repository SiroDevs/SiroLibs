                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri mu ’ye ekile Eliyani ’yolerile; te eri’i, Eliya pie, ’ba eri vile joa ’diyi be, yi nya o’du kakau. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.15",
            "verseOrgIds": [
              "1KI.17.15"
            ]
          }
        },
