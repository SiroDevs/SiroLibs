            }
          ]
        },
        {
          "text": "Te Israeli; dria yi nga eri owu, nga eri sa; a’disi­ku ’ba Yeroboamuni ma eselia eri a’dule nga eca ’biliani, a’disiku Yehova Mungu Israeliniri ma milia e’yo were onyiru ovu eri ma alia indi suru Yeroboamuni ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.13",
            "verseOrgIds": [
              "1KI.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
