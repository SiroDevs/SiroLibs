                  "text": "1 Opi 21:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suru Yeroboamuni odrapi akua ’diyi, oceyi nga nyani; odrapi nyamua amve ’diyi aria ’bua ’diyi nga nyani; a’disiku Yehova ’yo e’yo ’dirini. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.11",
            "verseOrgIds": [
              "1KI.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi mi nga, mi mu mi vile joa. Te mi ka nga mi pa ’ba aku alia, mva nderi nga dra ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.12",
            "verseOrgIds": [
              "1KI.14.12"
            ]
          }
        },
