                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "e’yo ’disi, mi ne, ma nga candi fe jo Yeroboamuni ma dria, ma nga agupianzi dria onze Yeroboamu vusi ra, ombele ati’baru ’diyi ’ba kari’baru Israelia ’diyi be iri tro, ma nga suru Yeroboamuni ini teke teke ra, ekile ’bani daka wele driarile. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.10",
            "verseOrgIds": [
              "1KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 14:11"
          },
          "items": [
