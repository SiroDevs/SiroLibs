                  "text": "1 Kor 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ega e’yo Yehova Mungu minirini ’yele Miriamu vu geria emini efuria Misiriasiriari.",
          "type": "text",
          "attrs": {
