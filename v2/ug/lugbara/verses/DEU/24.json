          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "te mi ma ega ’dani e’yo mini ovuzu ndra ati’boru Misiria, Yehova Mungu minirini mi onzeze ’daarisiri; e’yo ’disi ma azi mi e’yo ’diri ’yezu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
