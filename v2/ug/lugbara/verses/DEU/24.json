              },
              "items": [
                {
                  "text": "Efu 21:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ka ’ba azini isu erini adripi erini Israeliruri oguria, ka ’ye eri vu ati’bole, kani ka fe eri je ra, oguou nderi ma dra kai; mi ma nze e’yo onzi mi eseliasi ’dini, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        },
        {
