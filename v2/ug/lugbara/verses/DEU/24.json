                {
                  "text": "7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ofu ka mi nya ra, mi mba mi ta, mi ’ba mi asi e’yo dria ’ba Levini kuhaniru ’diyini imbale mi tia ’diyi ’yezu; ekile mani azile yi tiarile, mi ma ’ba mi asi ’ye ’dinile. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
