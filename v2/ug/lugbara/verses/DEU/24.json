                "loc": "MRK.10.4"
              },
              "items": [
                {
                  "text": "Mar 10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba azini ka oku je, ka eri eji ’bo, eri nga ovu ’dini, oku nde ka asi ndriza isu eri ma milia ku, erini e’yo dri fupi kuri isule oku nderi ma aliarisi, eri ma si eri dri waraga esele cozuri, ma fe eri dri, ma fe geri eri dri aku erini kuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ka aku agu nderini ku ’bo, eri eco muzaru ovuzu agupi azinia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agupi vileri ka eri ngu onzi, ka waraga esele cozuri si eri dri, fe eri dri, geri fezu eri dri aku erini kuzu, kani agupi vile eri jepi okururi ka dra ra, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.1"
              },
              "items": [
                {
                  "text": "Yer 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ka’dini agupi erini oko geri fepi eri dri muzuri econi eri omvi i vu okuru dika ku, yini eri ezale ’bori ma vutia; a’disiku e’yo ’dinileri ovu e’yo Yehovani ngule onziri’i, mi ma fe angu Yehova Mungu minirini fele mi dri awurusoruri ma ovu e’yo onzi be ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.5.18"
              },
              "items": [
                {
                  "text": "O’be 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agupi azini ka oku eji o’diru, eri ma fu mu asikari ongulumuru ’diyi be ku, ’ba ma fe azi azini eri dri ku indi; eri ma ovu e’yo ’yaasi i vile lakua eli alu pi, ayiko fezu oku erini jeleri dri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
