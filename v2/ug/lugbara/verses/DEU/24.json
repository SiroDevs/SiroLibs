              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba aluni ma ’du oniandri kani onimva togboru ku; a’disiku ’diniri ’ba ma idri ’duzu togboru. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
