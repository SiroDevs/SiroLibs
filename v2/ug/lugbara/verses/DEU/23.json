                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ngu Edomuouni onzi ku, te eri mi adri’i; mi ma ngu vini Misiriouni onzi ku, mi ndra ani’boru eri ma angua. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.7",
            "verseOrgIds": [
              "DEU.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’bianzi otile yi dri a’bianzi na ’diyi ma vutia ’diyi eco fizaru ongulumu Yehovani ma eselia.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.8",
            "verseOrgIds": [
              "DEU.23.8"
            ]
