              "items": [
                {
                  "text": "Ezr 9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma nda asi anzuru yini kani drileba yini ku ewu mini ovuzu idrirurisi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.6",
            "verseOrgIds": [
              "DEU.23.6"
            ]
