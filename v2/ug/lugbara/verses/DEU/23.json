          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimva ma fi ongulumu Yeho­vani ma eselia ku; cazu kpere a’bianzi yini a’bianzi mudri ’diyi ma vutia ’diyi vu, ’ba erini aluni ma fi ongulumu Yehovani ma eselia ku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        }
      ]
