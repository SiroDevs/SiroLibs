                  "text": "O’be 26:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ti, Yehova Mungu miniri a’ini ndra Balamu ma o’duko ’ku; te Yehova Mungu miniri oja ndra trita nde ovuzu mi dri asi ndrizaru, Yehova Mungu minirini i mi lele avasirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
