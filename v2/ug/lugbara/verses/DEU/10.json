              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini emi ma le ani’bo ani; a’disiku emi ovu ndra ani’baru angu Misiriaria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
            "verseOrgIds": [
              "DEU.10.19"
            ]
          }
        },
