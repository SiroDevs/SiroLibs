                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Anzi Israelini aci ndra engazu Beeroti Bene-yaakaniasi cazu Mose-­raa. Aroni nga dra ’dale, sa eri ’daa indi; te mvi Eleazari nga azi kuhanini nga eri ma pariani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.6",
            "verseOrgIds": [
              "DEU.10.6"
            ]
          }
        },
        {
          "name": "verse",
