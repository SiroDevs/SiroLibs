            "number": "7",
            "style": "v",
            "sid": "DEU 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engazu ’daarisi yi aci cazu Gudigodaa, azini engazu Gudigodaa cazu Yotibata angu ovupi yi raza nyiri beria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.7",
            "verseOrgIds": [
              "DEU.10.7"
            ]
          }
        },
        {
