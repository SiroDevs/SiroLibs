        },
        {
          "text": "Ma awu oni dria o’du kali su etusi inisi, ekile ewu okorisirile, Yehova nga e’yo mani eri ewu ’dirisi indi; Yehova leni ani mi dri jazu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
