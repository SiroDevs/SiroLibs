                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga di ma oja sizu oni driasi va, ma nga oni ’diyi o’ba sanduku mani edeleri ma alia; yi ’daa nga ci ekile Yehovani azile ma tiarile. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.5",
