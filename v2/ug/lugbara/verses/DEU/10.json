        },
        {
          "text": "Eri awuziou pi ma e’yo li kililiru, imvoanzi be, eri ani’bo le avasi, eri dri nyaka pi fezu afa suza be. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.18",
            "verseOrgIds": [
