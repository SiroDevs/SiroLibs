            }
          ]
        },
        {
          "text": "Etu nde ’darisi Yehova ’yo ma tia kini, Mi opa oni iri ekile ndra oko ’dayile, mi etu ma vu oni dria, mi ede vini sanduku patisi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.1",
            "verseOrgIds": [
              "DEU.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma nga e’yo ndra sile oni ’bararu oko mini ofule ’dayi ma dria ’diyi si oni ’bararu nde ’diyi ma dria, te mi ma o’ba yi sanduku nderi ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.2",
            "verseOrgIds": [
              "DEU.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 10:3"
          },
          "items": [
