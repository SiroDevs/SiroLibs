            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.37.1"
              },
              "items": [
                {
                  "text": "37:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini ma ede sanduku asarau patisi, ma opa oni iri ’bararu ndra oko ’dayile, ma tu oni dria oni ’bararu iri ’diyi be ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.3",
            "verseOrgIds": [
              "DEU.10.3"
            ]
          }
        },
        {
