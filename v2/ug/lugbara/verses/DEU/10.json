                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga di azita mudri si oni nde ’diyi ma dria, ekile ndra sile okorile, azita nde Yehovani ndra ’yole emi tia oni dria aci aliasi o’du okuzanirisi ’diyi; Yehova nga di yi fe ma dri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.4",
            "verseOrgIds": [
              "DEU.10.4"
            ]
          }
        },
        {
