                "loc": "PRO.10.22"
              },
              "items": [
                {
                  "text": "O’be 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mi ma fe afa eri dri asi basi engazu anyapa o’biru mini ma eselia, engazu akuma mini anya cozuri ma dria, azini engazu pari mini zabibuefi ma su nzizuri ma alia indi; mi ma fe eri dri Yehova Mungu mini­rini asi ndriza fele mi dririle. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.14",
            "verseOrgIds": [
              "DEU.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma ega ’dani e’yo mini ovuzu ndra ati’boru angu Misiriari, azini e’yo Yehova Mungu minirini mi onzezuniri; e’yo ’disi ma di e’yo ’diri azi mi dri andru. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.15",
            "verseOrgIds": [
              "DEU.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
