                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, eri ka nga ’yo mi tia kini, Ma ngani fu mi vusi ku; erini mi lele ’ba mi vile joa ’diyi berisi, erini ovule mi be barisi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.16",
            "verseOrgIds": [
              "DEU.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
