                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eli aziriri vusi dria, erini asiria, mi ma adi e’yo ti ra. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.1",
            "verseOrgIds": [
              "DEU.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geri e’yo ti adizuri ’di: ’ba dria mari fepi ’diyi alu alu ma adi mari ini fele i agyi driri ma ti ra; eri ma a’i mari nde omvizu i dri i agyi pi vu i adripi be ku, a’disiku eku e’yo ti adiza Yehovaniri ma e’yo ’bo ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.20"
              },
              "items": [
                {
                  "text": "Azi 23:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi eco mari a’izaru omvizu mi dri ani’bo vurisi ra; te afa mini ngoni ngori ka ovu mi adri vu, mi dri ma adi eri ma ti ra. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.8"
              },
              "items": [
                {
                  "text": "Azi 28:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ka’dini ti, ’ba alioru ’diyi ngani ovu emi eselia ci ’dini ku (a’disiku Yehovani nga asi ndriza ’ba mi vu ada, anga Yehova Mungu minirini fele mi dri ovuzu miniruri ma alia), ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "te kiri mi ka Yehova Mungu miniri ma o’duko eri asi driasi ka, asi ’bazu azita mani azile mi dri o’du andrusi ’dori ’yezu dria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.22.7"
              },
              "items": [
                {
                  "text": "O’be 22:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova Mungu miniri nga asi ndriza ’ba mi vu, ekile erini azile mi tia ’borile, mi nga afa fe mariru suru kakau dri, te mi ngani mari nya ku; mi nga ovu opiru suru kakau ma drilia, te yi ngani ovu opiru mi drilia ku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
