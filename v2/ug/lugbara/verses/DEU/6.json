                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma bi adrou ma vuti ku, suru mi ageia ’diyi ma adrou i ma azi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
