              "items": [
                {
                  "text": "1 Kor 10:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma o’bi Yehova Mungu emini ekile emini eri o’bile ndra Masaarile ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
