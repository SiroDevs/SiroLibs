                "loc": "JOS.23.10"
              },
              "items": [
                {
                  "text": "Yos 23:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a’disiku ’ba mupi emi be, a’di ’dizu emini emi ari’ba be emi pazuri Yehova Mungu eminiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.4",
            "verseOrgIds": [
              "DEU.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.27"
              },
              "items": [
                {
                  "text": "Neh 12:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ambo ambo ma ’yo vini ’ba ria kini, ’Ba azini jo o’diru sipi ra, te eri fepi nga Mungu dri kuri a’di’i ya? Eri ma ko dri, ma mvi jo inia, eri kazu drazu a’dia, ’ba azinini eri fezu anini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.5",
            "verseOrgIds": [
              "DEU.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba zabibu pati isipi amvua ra, te efini nyapi nga kuri a’di’i ya? Eri ma ko dri mvi i ma joa, eri kazu drazu a’dia, ’ba azinini amvu nde ma efini nyazu anini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.6",
            "verseOrgIds": [
              "DEU.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.5"
              },
              "items": [
                {
                  "text": "Azi 24:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’bapi oku jepi ra, te eri ejipi nga kuri a’di’i ya? Eri ma ko dri mvi i ma joa, eri kazu drazu a’dia, ’ba azinini oku erini omvizu anini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.7",
            "verseOrgIds": [
              "DEU.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.3"
              },
              "items": [
                {
                  "text": "Lip 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ambo ambo ’diyi ma ’yo e’yo azini dika ’ba ria, ’yozu kini, ’Ba ovupi urisi asinini cazu corokolori a’di’i ya? Eri ma ko dri mvi i ma joa, adripi erini ’diyi ma asi kazu cazu corokolo erinirile ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.8",
            "verseOrgIds": [
              "DEU.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ovu ’dini, ’ba amboru ’diyi ka e’yo ’yo ’ba tia de ’bo, yi ma ope ’ba ambo ambo ’ba ongulumu ma drilia ’diyi, ’ba dri cezu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.9",
            "verseOrgIds": [
              "DEU.20.9"
            ]
          }
        }
      ]
    },
