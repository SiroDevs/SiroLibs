        },
        {
          "text": "Te suru ’diyi ma aku, Yehova Mungu minirini fele mi dri ovuzu awuruso miniru ’diyi ma alia, mi ma ku afa ava ’yapiri idriru aluni ku, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.16",
            "verseOrgIds": [
              "DEU.20.16"
            ]
          }
        },
