                  "text": "Zab 106:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mi asi kazu engazu afusi ku, mi dri kazu avizu Yehova Mungu mini, mi ofupi ejipi angu Misiriasi, jo ati’baniasirisi ku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
