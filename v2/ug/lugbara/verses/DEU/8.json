              },
              "items": [
                {
                  "text": "Neh 9:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bongo mi ruaari ecani dezaru eli kali su ’diyisi ku, mi pa pini ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
              "DEU.8.4"
            ]
          }
        },
        {
