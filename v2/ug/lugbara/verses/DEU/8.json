        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.5"
              },
              "items": [
                {
                  "text": "Azi 29:5",
                  "type": "text"
                }
              ]
