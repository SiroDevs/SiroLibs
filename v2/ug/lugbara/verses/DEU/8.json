              "items": [
                {
                  "text": "O’be 30:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.6"
              },
              "items": [
                {
                  "text": "Hos 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ovu mile be, mi ka nya ra, e ka tra ’bo, mi ka jo onyiru si ovuzu yi ma alia ’bo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
              "DEU.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti mini piyi ka ezu anyapa nyiri mini ’diyi be ’bo, dahabu mini pi ka vini i ere tu mele mini be ’bo, afa dria mini ovuzu yi be ’diyi ka ezu ’bo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.13",
            "verseOrgIds": [
              "DEU.8.13"
            ]
          }
        },
        {
