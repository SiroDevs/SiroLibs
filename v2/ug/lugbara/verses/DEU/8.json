            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.3"
              },
              "items": [
                {
                  "text": "1 Tim 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi nga nya ra, mi nga tra ani, mi nga Yehova Mungu miniri inzi angu onyiru erini fele mi dri ’bori ma e’yosi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        }
