                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ’bu, emi co bile, ma nga e’yo ’yo;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.1",
            "verseOrgIds": [
              "DEU.32.1"
            ]
          }
        }
