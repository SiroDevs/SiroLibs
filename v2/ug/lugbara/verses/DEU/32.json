              "items": [
                {
                  "text": "O’be 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.5"
              },
              "items": [
                {
                  "text": "Rum 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku e’yo ’diri ovuni emi dri e’yo tokoni ku, te eri idri eminiri’i, azini e’yo ’dirisi emi nga ewu emini ovuzu idriruri fe i esezu izu angu emini Yoridanini zozu eri duzu eminiruri ma alia.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        }
      ]
