              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma ’ye ekile e’yo liza yini ngale ecele mi dri pari Yehovani ngale peleriarile; te mi ma ’ba mi asi e’yo dria ’yezu ekile yini mi imbale­rile; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.10",
            "verseOrgIds": [
              "DEU.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
