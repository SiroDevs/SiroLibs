          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba azini ka ’yo mi tia, mi ka eri ra; ka’dini mi ma nda e’yo nderi asi driasi, te mi ne, e’yo ngule onzi ’dini ’diri ka i ’ye Israeli eselia adada, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.4",
            "verseOrgIds": [
              "DEU.17.4"
            ]
          }
        },
