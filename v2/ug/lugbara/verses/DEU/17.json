          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi ma ’ye ekile azita yini imbale mi dririle, azini ekile e’yo liza yini olule mi tiarile; mi ma oja mi dri ndia kani dri ejia e’yo liza yini ecele mi driri kuzu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.11",
            "verseOrgIds": [
              "DEU.17.11"
            ]
