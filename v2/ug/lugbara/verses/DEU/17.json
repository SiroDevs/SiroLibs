        },
        {
          "text": "eri ka mu azi ngazu adrou dri yi inzizu, ka etu inzi, kani mbani, kani ’bi’bio ongulumu ’bua ’diyi, mani e’yoni azile ma’i kuri, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.3",
            "verseOrgIds": [
              "DEU.17.3"
            ]
          }
