              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.16"
              },
              "items": [
                {
                  "text": "Azi 10:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.19"
              },
              "items": [
                {
                  "text": "Eze 11:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova Mungu miniri nga mi ma asi li agele lilerile, mi anzipi ma asi be, mi ma le ani Yehova Mungu miniri mi asi driasi, azini mi orindi driasi, mi ma ovu ani idriru. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehovani nga otrita ’diyi o’ba ari’ba mini piyi ma dria, ’ba mi ngupi onzi ndra mi inzapi ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi nga mvi Yehova Mungu miniri ma ti erizu ra, nga azita erini mani azile mi dri o’du andru ’dorisi ’diyi ’ye dria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
