                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te adriza ’bani ani Mungu inzizu asi ayikoru e’yo driasiri beri eri orodri amboruni; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.6",
            "verseOrgIds": [
              "1TI.6.6"
            ]
          }
