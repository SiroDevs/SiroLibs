                  "text": "Efe 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disi­ku asi ’bazu silingi lezuri ovu ola e’yo onzi driani; ’ba azini yi ma asini vele e’yo nderisirisi, yi avi geri a’itani ra, yi so yi ngulupi ma asi rua suza kakau isuzu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        }
