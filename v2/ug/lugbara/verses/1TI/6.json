                  "text": "28:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba lepi ovuzu afa e’iru ’diyi adri o’de obeta ma alia, azini emba ma alia, azini li kakau azazaru ’ba ezapi ’diyi ma alia, e’yo ’diyi fe ’bani abazu avizu dri jaza pi ma alia drata be. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.9",
            "verseOrgIds": [
              "1TI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
