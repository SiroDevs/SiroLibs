                  "text": "Tit 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "awata ’ba ovupi ezazaru asisile yini ma alia, e’yo adaru ’bepi ra ’diyini pie, ’ba ’diyi ega adriza ’bani ani Mungu inzizuri ovu geri orodri isuzuri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
            "verseOrgIds": [
              "1TI.6.5"
            ]
          }
        },
