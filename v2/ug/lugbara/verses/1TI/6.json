              "items": [
                {
                  "text": "Yob 1:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ama ejini ndra afa aluni nyakua ku, ama econi vini afa aluni ’duzaro amani furia ku; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.7",
