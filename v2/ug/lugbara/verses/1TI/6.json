            }
          ]
        },
        {
          "text": "Te mi’i, mi ’ba Munguni, mi ma apa e’yo ’diyisi; mi ma bi e’yo kililiruri pi ma vuti, adriza ’bani ani Mungu inzizuri pie, a’ita pie, leta avasiri pie, asi teza pie, asi e’yereruri pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.11",
            "verseOrgIds": [
              "1TI.6.11"
            ]
          }
        },
