              "items": [
                {
                  "text": "19:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma azi mi Mungu idri fepi afa dria driri ma milia, azini Yesu Kristo e’data onyiru ma e’yo eti nzepi Pontio Pilato ma driliari ma milia, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.13",
            "verseOrgIds": [
              "1TI.6.13"
            ]
          }
        },
