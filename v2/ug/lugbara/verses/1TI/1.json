            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ama ni azita ovu onyiru, ’ba ka ’ye erisi ekile azita ndeni lelerile, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.8",
            "verseOrgIds": [
              "1TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "emini e’yo runa ’dini kini azita ovuni azizaru ’ba kililiru ’diyi ma e’yosi ku, te ’ba azita kokoru ’diyi pi ma e’yosi, ’ba saaru ’diyi pie, ’ba Mungu gapi si ’diyi pie, ’ba e’yo ezapi ’diyi pie, ’ba alatara kokoru ’diyi pie, ’ba Mungu ma ru o’dapi ’diyi pie, ’ba yi atini ’dipi ’diyi pie, ’ba yi andrini ’dipi ’diyi pie, ’ba ’ba ’dipi ’diyi pie, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.9",
            "verseOrgIds": [
              "1TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.3"
              },
              "items": [
                {
                  "text": "1 Tim 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba ali o’bapi ’diyi pie, agupi ali o’bapi agupi agyisi ’diyi pie, ’ba ’ba obipi jipi ati’baru ’diyi pie, ’ba inzo lipi ’diyi pie, ’ba oyo sopi inzosi ’diyi pie, kani ’ba e’yo azini-ka ngoni ti ’--imbata adaruni ogale siri ’yepi ’diyi pie dria; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.10",
            "verseOrgIds": [
              "1TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.15"
              },
              "items": [
                {
                  "text": "1 Tim 6:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ekile e’yo baru diza be Mungu inzizarurini, ovupi fezaru ma dri tani mbazurile.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
            "verseOrgIds": [
              "1TI.1.11"
            ]
          }
        }
