              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo, ’ba Kristo Yesuni ti pele Mungu ama Papiri pi ma azita ma e’yosi Kristo Yesu asi teza amaniri beri,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
