                "loc": "GAL.1.13+GAL.1.14+GAL.1.15+GAL.1.16"
              },
              "items": [
                {
                  "text": "Gal 1:13-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma awa’difo fe ’ba okpo fepi ma driri dri, ’di Kristo Yesu Opi amaniri’i, erini ndra ma a’ile ovuni adam, erini ma ’bale azi ini ma aza kozurisi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.12",
            "verseOrgIds": [
              "1TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
