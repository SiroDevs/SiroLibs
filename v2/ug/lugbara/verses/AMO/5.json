          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaru, emi ’du ndra Sikuti opi eminiri pie, Kiuni wura toko emini ’diyi be, ’di Mungu emini ma ’bi’bio, emini edele emi drisi ’diyi; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.26",
            "verseOrgIds": [
              "AMO.5.26"
            ]
          }
        },
        {
