              "type": "text"
            }
          ]
        },
        {
          "text": "Emi eji ndra ma dri edeta afa feza be eli kali su angu roko driaria ra ya, emi ori’ba Israelini la? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.25",
            "verseOrgIds": [
              "AMO.5.25"
            ]
          }
