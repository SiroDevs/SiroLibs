                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mani ngale ru Baalini ’diyi onzele eri ma tiarisi, yi ngani Baalini omve ru yinisi dika ku. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.17",
