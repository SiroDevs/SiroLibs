              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini etu ’dasi, Yehova ’yo ra, mi nga ma ru ’da Isi’i, mi ngani ma omve Baali dika ku. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
