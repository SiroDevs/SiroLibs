          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "cite rik ote cwaya piny kede dwoŋo kun akato i waŋ dirica i apama cel, eka ate bwot gira oko i ciŋe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
