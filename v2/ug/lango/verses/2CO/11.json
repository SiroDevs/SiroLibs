                "loc": "ACT.9.23"
              },
              "items": [
                {
                  "text": "Tic 9.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.15"
              },
              "items": [
                {
                  "text": "14.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ario i wot apol ame can twero poto i koma, can oya i kuli i, can oya i baŋ oyak, can oya i baŋ jona, can oya i baŋ Orok, can a nen i boma, can a nen i tim, can a poto i nam kede can i baŋ omego a mom gin omego me ateni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acanne i tic atek; tyen apol pe anino iwor. Ario kec kede oryo pii; tyen apol abedo aboŋo cam ame romma, dok abedo i piny aŋic aboŋo ginaruka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Medde i kom gin ocele luŋ, tye gin a kella peko didik, en par ame atye kede pi lwak oye Kricito luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tye ŋattoro agoro ame an mom awinyo goro i koma? Tye ŋattoro ame omio opoto i bal ame an cunya mom waŋ iye?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
