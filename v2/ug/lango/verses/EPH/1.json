              },
              "items": [
                {
                  "text": "19.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waraga man oya i baŋ Paulo ame en akwena a Kricito Yecu pi mit Obaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
            "verseOrgIds": [
              "EPH.1.1"
            ]
          }
        }
