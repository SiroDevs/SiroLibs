          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien wan odul kome. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.30",
            "verseOrgIds": [
              "EPH.5.30"
            ]
          }
