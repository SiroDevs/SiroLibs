                  "text": "Age. 2.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Coc a yam ocoo kobo ni, “Pi kop man, dano bino weko pappere kede tottere, eka te bino notte gin i cege, gin aryo te doko kom acel.” ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.31",
            "verseOrgIds": [
              "EPH.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EPH 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en muŋ adit meicel. An i tuŋ baŋa agonyo i kom Kricito kede lwak jo oye en. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.32",
            "verseOrgIds": [
              "EPH.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EPH 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite wun, ŋat acel acel myero mar cege bala kome kene, dako daŋ nen ni eworo cware.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.33",
