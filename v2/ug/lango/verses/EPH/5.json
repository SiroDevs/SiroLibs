              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mom tye ŋattoro a dago kome kene, a mom pito dok gwoko aber acalo Kricito timo timo i kom lwak jo oye en, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.29",
            "verseOrgIds": [
              "EPH.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
