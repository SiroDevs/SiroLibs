              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.26"
              },
              "items": [
                {
                  "text": "1 Obak. 4.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaka Culeman rik onwoŋo doŋ tye kede aguragura ame romo tutumia aŋwen iyi awi mere, kun tye i gadigadi lweny karacel kede jo ame riŋo kedgi ame romo tutumia apar wie aryo. Mogo i akinagi rik bedo i boma ame ogwoko iye gadigadi kun en ocele bedo baŋ abaka i Jerucalem, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
            "verseOrgIds": [
              "2CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Age. 15.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.21"
              },
              "items": [
                {
                  "text": "1 Obak. 4.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "En rik oloo obakki luŋ cakere i Efurate tuno kede i lobo a jo Piriciti, kede i waŋ lobo me Miciri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare-naca abaka rik omio ryal odoko ginnoro a pire mom dit ame twero nwoŋere baŋ jo luŋ i Jerucalem calo gweŋ, kun daŋ bao cedar dwoŋ atata i Jerucalem calo olam ame tye i bar ame Cepela, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Lodo 17.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Culeman rik onwoŋo aguragura mere i lobo Miciri kede i loba ducu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
