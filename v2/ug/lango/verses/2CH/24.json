          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bed mony a jo Curia obino olweny anonok, cite Rwot omiogi oloo twon mony adwoŋ meicel, pien jo Icrael onwoŋo okwero Rwot Obaŋa a kwarigi. Mannono en kite ame Rwot oŋolo kede kop i kom Yowaci.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        }
      ]
    },
