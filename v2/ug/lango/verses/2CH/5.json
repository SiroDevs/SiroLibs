                "loc": "EXO.40.34+EXO.40.35"
              },
              "items": [
                {
                  "text": "Yaa 40.34-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Doŋ onwoŋo obedo tic okut apel kede ower, me neno ni dwongi oribere karacel i pako kede pwoyo Rwot, kede ka owero wer i dwoŋ aloŋo, kun okuto apel kede tum karacel kede jami ocele luŋ me wer ame otio kedgi i pako Rwot. Gin te wer ni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
