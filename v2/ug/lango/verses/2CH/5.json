              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olamdog ducu ame onwoŋo tye kuno onwoŋo doŋ otyeko lonyere oko, kun mom oparo pi dul ticgi. I kare ame olamdog oya i kabedo acil, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo Levi luŋ ame gin onwoŋo ower wer onwoŋo ocuŋ i ŋet keno lam tutuŋ kide. Acap, Kanan, Jedutun kede awobegi karacel kede omegogi gin luŋ oruko boŋŋi me camanini abeco mege, omako daŋ tum me agoa kede naŋa karacel i naŋa opuk. Olamdog mia acel kede pyeraryo ame okut apel ocuŋ kedgi karacel. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
