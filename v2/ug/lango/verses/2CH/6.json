            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ce arokkoro ame mom dano me Icrael owinyo piri, kede pi gigi mogo adonodono ame yin ibedo ti mo baŋ joni Icrael, eka te bino i ot man pi bino worri kun oya i lobo abor, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
