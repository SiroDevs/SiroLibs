            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaka Culeman te cako kwayo Obaŋa kun kobo ni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        }
      ]
    },
    {
