          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce i kare ame gin tye kuno i lobo ame oterogi iye acalo opii, gin te ŋut, kun oŋut ateteni i cunygi ducu, ote kwayi i kuno kun nyimgi oneno lobo man ame yin rik imio baŋ kwarigi, kede kabedo man ame yin giri en iyero kede ot man ame an agero piri-ni, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
