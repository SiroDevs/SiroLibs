          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "cite ka i kare ame gin tye kuno cunygi te kolo piny, ote ŋut, ote kwayi kun otuco balgi i nyimi, kun oye ni kitegi oballe oko pi gin areco ame gin obedo timo, tim ber iwiny kwacgi Ama Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
