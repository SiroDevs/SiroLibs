              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "tim ber iwiny kwacgi i kabedoni ame tye malo i polo, ite miyogi loyo okworgi oko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
