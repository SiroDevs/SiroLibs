            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakere i kare ame jo oweko Rwot, jo mogo rik te poro kop i muŋ i kom Amajia, kun omito neke oko i Jerucalem, en te lwi, riŋo oko i boma me Lakic, cite okworrere te cwayo dano lubo yore kuno, ame te wot neke oko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
