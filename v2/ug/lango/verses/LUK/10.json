            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.15"
              },
              "items": [
                {
                  "text": "10.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atittiwu ni, i nino-nono, can a Codoma bino bedo itikatika, kato me bomanono.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.12",
            "verseOrgIds": [
              "LUK.10.12"
            ]
          }
        }
