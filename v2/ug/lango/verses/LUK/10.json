              "items": [
                {
                  "text": "Lak. 13.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ŋat ame winyowu, nwoŋo owinya; ŋat ame kwerowu, nwoŋo okwera; ŋat ame kwera, nwoŋo okwero ŋat ame oora.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        }
