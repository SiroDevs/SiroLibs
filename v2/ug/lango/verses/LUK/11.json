              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.1+1KI.10.2+1KI.10.3+1KI.10.4+1KI.10.5+1KI.10.6+1KI.10.7+1KI.10.8+1KI.10.9+1KI.10.10"
              },
              "items": [
                {
                  "text": "1 Obak. 10.1-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.1+2CH.9.2+2CH.9.3+2CH.9.4+2CH.9.5+2CH.9.6+2CH.9.7+2CH.9.8+2CH.9.9+2CH.9.10+2CH.9.11+2CH.9.12"
              },
              "items": [
                {
                  "text": "2 Tek. 9.1-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abaka a dako me tutun anyarolum bino cuŋ karacel kede lwagi jo me kare man i kare me ŋolo kop, te miyo kop loyogi; pien en otuno iya i agikki me lobo pi winyo ryeko a Culeman, koŋ inen, gin adwoŋ akato Culeman tye kan. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.31",
            "verseOrgIds": [
              "LUK.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.3.5"
              },
              "items": [
                {
                  "text": "Yon. 3.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jo Nineve bino cuŋ karacel kede lwagi jo me kare man, i kare me ŋolo kop, te miyo kop loyogi; pien gin rik oŋut pi kop a Yona orabo, cite nen, gin adwoŋ akato Yona tye, kan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.32",
            "verseOrgIds": [
              "LUK.11.32"
            ]
          }
        }
      ]
