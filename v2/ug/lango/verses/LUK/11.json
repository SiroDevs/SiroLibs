            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.3.4"
              },
              "items": [
                {
                  "text": "Yon. 3.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien acalo Yona rik odoko anyut baŋ jo Nineve, kite-nono wot a dano bino doko anyut baŋ lwagi jo me kare man. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.30",
            "verseOrgIds": [
              "LUK.11.30"
            ]
          }
        },
        {
          "name": "verse",
