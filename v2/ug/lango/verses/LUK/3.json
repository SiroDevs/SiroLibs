              "LUK.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.34"
              },
              "items": [
                {
                  "text": "Mat. 12.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.33"
              },
              "items": [
                {
                  "text": "23.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lwak ecipan obino baŋe me ebatijagi; en okobbigi ni, “Wun itino ororo, ŋa ame okwenyorowu ni mano ber iriŋ wunu akemo Obaŋa ame bino tuno? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.7",
            "verseOrgIds": [
              "LUK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.33"
              },
              "items": [
                {
                  "text": "Lak. 8.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyak wunu doŋ nyig a myero me ŋut, kur dok icak tamo wunu ni, ‘Otye kede kwarowa en Iburaim’; pien akobbiwu ni, Obaŋa tye kede te ko me miyo gweŋe magi doko ikwae Iburaim. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.8",
            "verseOrgIds": [
              "LUK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.19"
              },
              "items": [
                {
                  "text": "Mat. 7.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aman doŋ otyeko keto lee oko me toŋo lwit yen; yat acel acel a mom nyako nyige abeco, otoŋo, obolo i mac.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwak openye ni, “Kara wan doŋotim ŋo?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.10",
            "verseOrgIds": [
              "LUK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ogamo ni, “Ŋat a tye kede kanyi aryo, pok i ŋat ame mere mom; ŋat ame tye kede cam, tim amannono daŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.11",
            "verseOrgIds": [
              "LUK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.7.29"
              },
              "items": [
                {
                  "text": "Luk. 7.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oraocoro gin daŋ obino me batakinogi; gin openye ni, “Apwony, kara wan kono otim ŋo?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.12",
            "verseOrgIds": [
              "LUK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okobbigi ni, “Kur ira wunu ame kato wel ame ocikowu.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.13",
            "verseOrgIds": [
              "LUK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cirikali daŋ openye ni, “Wan kono otim ŋo?” Okobbigi ni, “Kur iyak wunu ŋattoro tetek, onyo idote wunu gobagoba; myero imi ocarawu romwu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ame lwak tye ka kuro, gin openyere i cunygi pi Lakana, ka kono ce ŋit en Kricito. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakana okobbigi ducu ni, “An abatijawu kede pii, ento ŋattoro tye ame abino, en tek kata oko; an mom aromo gonyo del warrere. En bino batijawu kede Cuny Acil, dok kede mac. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odero mere tye i ciŋe, me yiko laro mere aber; bino nyono kallere i dero, ento cuŋe en bino waŋo oko kede mac a mom to.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orabo amut aber baŋ lwak, kun cuko cunygi kede kop ocele apol. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.18",
            "verseOrgIds": [
              "LUK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.3+MAT.14.4"
              },
              "items": [
                {
                  "text": "Mat. 14.3-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.17+MRK.6.18"
              },
              "items": [
                {
                  "text": "Mar. 6.17-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento Kerode ame aloc ame rik en Lakana ojuko pi Kerodia ci-ominnere, kede pi gin areco ducu ame Kerode otimo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "omedo kop man i kom kop ocele Iuŋ, otweo Lakana i buc.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ jo obatija ducu, ame Yecu daŋ obatija, ka en tye ka kwac, polo oyabere. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.2"
              },
              "items": [
                {
                  "text": "Age. 22.2",
                  "type": "text"
                }
              ]
            },
            {
