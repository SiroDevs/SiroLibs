              "attrs": {
                "loc": "LUK.9.35"
              },
              "items": [
                {
                  "text": "Luk. 9.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cuny Acil obino acalo amam i cal me kom, opoto i kome. Dwonnoro oya i polo ni, “Yin woda ame amaro, cunya yom i komi.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        }
      ]
    },
