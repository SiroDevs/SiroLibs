          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pappere kede tottere ote wuro kop ame okobo i kome. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.33",
            "verseOrgIds": [
              "LUK.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cimeon olamo winyo i komgi, kun kobo baŋ tottere Maliam ni,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.34",
            "verseOrgIds": [
              "LUK.2.34"
            ]
          }
        }
