                {
                  "text": "Caro. 3.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yecu odoŋo, omedde i ryeko, kun medde nwoŋo pwoc baŋ Obaŋa kede baŋ jo.",
          "type": "text",
