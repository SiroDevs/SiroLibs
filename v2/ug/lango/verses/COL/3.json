                  "text": "Ep. 6.5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wun opii, winy wunu odoŋewu me loba man i kop luŋ i cuny acel, mom i tic a yeŋo waŋ, me yomoro ka cuny dano keken, ento i cuny a lworo Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.22",
            "verseOrgIds": [
              "COL.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ticcoro ame itio wunu, ti wunu aber i cunywu luŋ acalo itiyi wunu Rwot, ento mom pi dano. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
            "verseOrgIds": [
              "COL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋe wunu ni ibino nywako wunu jami ame Rwot oyiko pi jo mere acalo ocarawu. Wun opii a Rwotwa Kricito. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
            "verseOrgIds": [
              "COL.3.24"
            ]
          }
        },
