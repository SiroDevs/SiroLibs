          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oram ame obedo rwot me Gejer te bino konyo jo Lakic, Yocwa te neke oko karacel i jo mere luŋ, naka moro mom obwot.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
