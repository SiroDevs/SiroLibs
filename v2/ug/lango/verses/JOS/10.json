          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yocwa karacel kede jo Icrael luŋ te ya oko Eglon, te wot i Kebron, ote wot lweny i komgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ogamo ote jwero jo luŋ i pala lweny, kede rwottere, boma mere luŋ, kede jo mere, moro mom odoŋ, kite ame otimo kede Eglon, ojwero luŋ, anaka jo ame bedo iye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
      ]
    },
