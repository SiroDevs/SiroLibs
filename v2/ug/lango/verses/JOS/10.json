            "number": "34",
            "style": "v",
            "sid": "JOS 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yocwa dok te kato karacel i jo Icrael luŋ, oya oko i Lakic ote wot Eglon. Gin oguro ote daŋ lweny i komgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin te mako Eglon i ninonono, ote neko jo iye luŋ i pala lweny. I nino-nono ojwero jo luŋ iye, kite ame rik otimo i kom Lakic.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
