          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yocwa te doŋ dwogo cen i Debir karacel i jo Icrael luŋ, te ero lweny kedgi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "te gamo oko karacel kede abaka mere, kede boma mere luŋ. Gin te neko jo iye luŋ i pala lweny, ote daŋ jwero jo luŋ ame bedo iye, moro mom obwot kite ame rik otimo i kom Kebron, Libna kede obakki mege, en a daŋ otimo i kom Debir kede rwottere.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
      ]
    },
    {
