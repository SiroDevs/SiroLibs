          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwir ame obolo me abiro opoto i kom atekere a Dan kun lubo kite ame doggolagi tye kede. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.40",
            "verseOrgIds": [
              "JOS.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waŋ lobo mere onwoŋo ogwaro Jora, Ectaol, Ir-cemec, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car-alabin, Aijalon, Itla, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.42",
            "verseOrgIds": [
              "JOS.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elon, Timna, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.43",
            "verseOrgIds": [
              "JOS.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elteke, Gibbeton, Baalat, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.44",
            "verseOrgIds": [
              "JOS.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeud, Bene-berak, Gat-rimmon, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.45",
            "verseOrgIds": [
              "JOS.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede Mejarkon kede Rakkon karacel kede lobo ame tye i nyim Yopa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.46",
            "verseOrgIds": [
              "JOS.19.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 19:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.27+JDG.18.28+JDG.18.29"
              },
              "items": [
                {
                  "text": "Oŋol. 18.27-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kare ame amao lobo a jo Dan oko, gin owoto anyim, ote wot lweny i kom Lecem, kare ame gin doŋ omako, gin oneko jo iye i pala lweny, gin te gamo bedo iye. Gin te cako nyiŋ lobo-nono ni Dan, bala nyiŋ kwarogi Dan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.47",
            "verseOrgIds": [
              "JOS.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en lobo ame atekere a Dan onwoŋo kun lubo kite ame doggolagi tye kede. Boma kede pacci ame tye i ŋetgi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        }
      ]
    },
