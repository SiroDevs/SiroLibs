          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.9",
            "verseOrgIds": [
              "JOS.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yocwa te ciko otel a lwak ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.10",
            "verseOrgIds": [
              "JOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bebea wunu i dye gony, icik wunu jo ni, ‘Yik wunu pekewu me dwoko lao iyo, pien odoŋ i nino adek keken ibino wunu ŋolo Jordan, me iwot i gam wunu lobo ame Rwot Obaŋawu omiowu me bedo megwu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.11",
            "verseOrgIds": [
              "JOS.1.11"
            ]
          }
        }
      ]
    },
