          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo me Tekoa te yiko apama cel ame olubo mea a Pedayagi, man obedo dulgi me aryo, apama cel ame otikere i twon ot okato malo iguŋ me kuro ot Obaŋa tuno naka i kom apama cel Opel.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
