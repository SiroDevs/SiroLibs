            "verseId": "NEH.9.37",
            "verseOrgIds": [
              "NEH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi gin ame obedo timere-nono, omio wan tin oketo cikere atek odoco, kun ocoo acoa, Olocwa, Olevi, kede olamdog en ame bino keto ciŋgi i cikere-nono.",
          "type": "text",
          "attrs": {
