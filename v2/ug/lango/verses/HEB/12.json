                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.11+DEU.4.12"
              },
              "items": [
                {
                  "text": "Lodo 4.11-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.22+DEU.5.23+DEU.5.24+DEU.5.25+DEU.5.26+DEU.5.27"
              },
              "items": [
                {
                  "text": "5.22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien wun giwu mom ibino wunu i gin ame otwero gudo kome, i mac a rik olyel i wi kidi me Cinai, kede colpiny ame ocido oko icuc, kede yamo ajuru, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede koko apel kede dwon ŋat a kop. Jo owinyo rik obako doggi ni kur dok omed kobbigi kopporo, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.19",
            "verseOrgIds": [
              "HEB.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.12+EXO.19.13"
              },
              "items": [
                {
                  "text": "Yaa 19.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pien gin mom otwero kanyo cik ame omio, ni mano, “Anaka leyi-gu, ka ogudo kidi, myero nap i gweŋ, neko oko,” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.19"
              },
              "items": [
                {
                  "text": "Lodo 9.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin onen kaci-naca obedo arac meicel, naka omio Muca owoto dwone ni, “Lworo omaka meicel, omyelo koma.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
            "verseOrgIds": [
              "HEB.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite wun ibino wunu i kidi me Cion, kede i boma Obaŋa akwo, Jerucalem me polo, kede baŋ lwak omalaika ecipan ame ocokere pi woro Obaŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
              "HEB.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede i cokere itino kao ame ocoo nyingi i polo, kede baŋ Obaŋa, ame en aŋolkop a jo luŋ, kede baŋ tipo jo a kitegi atira, ame doŋ omio doko jo ocwiny odoco, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.23",
            "verseOrgIds": [
              "HEB.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.10"
              },
              "items": [
                {
                  "text": "Age. 4.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kede baŋ Yecu, ayik cikere anyen, kede baŋ remo ame okiro, ame tito pi gin aber a kato en ame remo Abel otito pire.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.24",
            "verseOrgIds": [
              "HEB.12.24"
            ]
          }
        }
      ]
    },
