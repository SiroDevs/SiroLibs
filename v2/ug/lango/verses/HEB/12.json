                {
                  "text": "Yaa 20.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwokere wunu kur ikweru winyo ŋat a tye akop. Jo ame rik okwero winyo ŋat ame okwenyorogi i wi lobo rik mom obin obwot. Wan kono obino bwot wunu niŋo, ka okwero winyo wunu ŋat ame akwenyorowa i wi polo twal? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.6"
              },
              "items": [
                {
                  "text": "Agg. 2.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kare-naca, dwone rik obin oyeŋo lobo; ento aman en ociko ni, “Odoŋ icel, mom abino yeŋo ka lobo keken, cite anaka polo daŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kop man ni, “Odoŋ icel,” nyuto ni, obino kwanyo gin a yeŋere oko, mano ginaketa, eka gin a mom yeŋere te doŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
              "HEB.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi mano, myero wan opwo wunu Obaŋa, pien wan onwoŋo loc a mom twero yeŋere, daŋ myero owor wunu Obaŋa i yore a twero yomoro cunye, kun daŋ omie wunu kwogo kede lworo, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.28",
            "verseOrgIds": [
              "HEB.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
