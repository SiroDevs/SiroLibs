              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amannono daŋ, Kricito rik mom otero kwogo man me bedo alamdog adwoŋ pire kene, ento Obaŋa omie, kun kobo ni,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
