              "items": [
                {
                  "text": "Jer. 31.31-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento Obaŋa onwoŋo bal i komgi, pien okobo ni,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
