                "loc": "ISA.53.12"
              },
              "items": [
                {
                  "text": "Ica. 53.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "amanno daŋ Kricito omio icel me yeyo bal a jo apol, dok bino nen tyen me aryo, mom dok pi tic i kom bal, ento pi laro jo ame tye akure.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.28",
