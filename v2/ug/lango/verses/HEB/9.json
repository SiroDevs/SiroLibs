              "HEB.9.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.2+NUM.18.3+NUM.18.4+NUM.18.5+NUM.18.6"
              },
              "items": [
                {
                  "text": "Wel 18.2-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano en kite a rik oyiko kede. Olamdog yam donyo i kema me agege didik pi cobo ticgi me woro Obaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.2+LEV.16.3+LEV.16.4+LEV.16.5+LEV.16.6+LEV.16.7+LEV.16.8+LEV.16.9+LEV.16.10+LEV.16.11+LEV.16.12+LEV.16.13+LEV.16.14+LEV.16.15+LEV.16.16+LEV.16.17+LEV.16.18+LEV.16.19+LEV.16.20+LEV.16.21+LEV.16.22+LEV.16.23+LEV.16.24+LEV.16.25+LEV.16.26+LEV.16.27+LEV.16.28+LEV.16.29+LEV.16.30+LEV.16.31+LEV.16.32+LEV.16.33+LEV.16.34"
              },
              "items": [
                {
                  "text": "Olev. 16.2-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento kema me aryo alamdog adwoŋ kene en ame donyo iye, en daŋ donyo icel keken i mwaka acel acel, kun mom woto aboŋo remo, ame en mio pire en ikome kede pi roc a lwak. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit man Cuny Acil cimo kannaler ni, yo me tuno i kabedo acil mom ru oyabo ka kema me agege pwod ocuŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en cal me kare man. Te koppere ni, mot kede gin ame oŋolo me yalo Obaŋa mom twero miyo ŋat oworo Obaŋa doko dano a cunye ler doki odoco, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
            "verseOrgIds": [
              "HEB.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien gin otiko ka cem kede mat kede kite lwokere apapat. Magu luŋ obedo cik i oko me kom ame tye atic ituno naka i kare ame Obaŋa bino loko jami ducu bedo anyen.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento aman Kricito doŋ obino, ame en alamdog adwoŋ me jami abeco ame bibino. Kema a en tio iye dit kato maca, daŋ ber odoco kato maca, pien mom otio kede ciŋ, te koppere ni, mom gin me lobo man. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.11",
            "verseOrgIds": [
              "HEB.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "En odonyo i Kabedo Acil icel iloŋ ame oromo meicel, kun mom otero remo dyegi kede itino twoni, ento otero remo mere en ikome, te lakorowa doŋ atwal. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.12",
            "verseOrgIds": [
              "HEB.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.15+LEV.16.16"
              },
              "items": [
                {
                  "text": "Olev. 16.15-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.9"
              },
              "items": [
                {
                  "text": "Wel 19.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.17+NUM.19.18+NUM.19.19"
              },
              "items": [
                {
                  "text": "17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Remo dyegi kede twoni, kede buru roa ame owaŋo, ka okiro i kom jo ame obalo kwer, romo lonyogi, kun yiko komgi bedo acil. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remo a Kricito mom kato maca atek ateka? Pi Cuny Acil ame perakino atwal, omio en omiye kene baŋ Obaŋa kun roccoro mom i kome, me elony cunywa ame lille pi tiyo tic me to, me obed a yiwa ler, ote woro Obaŋa akwo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano en omio Kricito rik obedo ŋat oyiko cikere anyen, me wek jo ame olwoŋo nwoŋo lim ame perakino ame Obaŋa ociko miyo; pien pi to ame otimere, jo a rik okalo wi cik i te cikere me agege aman doŋ olakorogi oko. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien kan ame cikere me leyo lim tye iye, myero doŋ mok ni, ŋat ociko doŋ oto. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi cikere-nono twero tic ka i ŋe to keken; mom tye i twerroro ka ŋat ociko pwod kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi mannono anaka cikere me agege ca rik omoko kede remo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.18",
            "verseOrgIds": [
              "HEB.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 9:19"
          },
          "items": [
            {
              "text": "19",
