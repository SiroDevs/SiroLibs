            "sid": "1CO 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "An gira aŋwec atira a mom acacapa acacap; ka adoŋo, mom adoŋo bala ŋat a apo adoŋŋere aapa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.26",
            "verseOrgIds": [
              "1CO.9.26"
            ]
          }
        },
        {
