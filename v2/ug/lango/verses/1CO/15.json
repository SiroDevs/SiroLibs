                "loc": "PSA.16.8+PSA.16.9+PSA.16.10"
              },
              "items": [
                {
                  "text": "Jab. 16.8-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.40"
              },
              "items": [
                {
                  "text": "Mat. 12.40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.24+ACT.2.25+ACT.2.26+ACT.2.27+ACT.2.28+ACT.2.29+ACT.2.30+ACT.2.31+ACT.2.32"
              },
              "items": [
                {
                  "text": "Tic 2.24-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "dok daŋ ni oyike, ote cere i nino me adekkere, kun lubo coc a yam ocoo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.4",
            "verseOrgIds": [
              "1CO.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.16+MAT.28.17"
              },
              "items": [
                {
                  "text": "Mat. 28.16-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.14"
              },
              "items": [
                {
                  "text": "Mar. 16.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.34"
              },
              "items": [
                {
                  "text": "Luk. 24.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.19"
              },
              "items": [
                {
                  "text": "Lak. 20.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "dok ni rik onen baŋ Petero, eka te nen baŋ jo apar wie aryo ca. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.5",
            "verseOrgIds": [
              "1CO.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te dok nen baŋ omego a kato mia abic awaŋacel; i kom jo-nono pollere pwod tye kwo, kadi mogo doŋ onino. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.6",
            "verseOrgIds": [
              "1CO.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok te nen baŋ Yakobo, icennere baŋ okwena luŋ aluŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.7",
            "verseOrgIds": [
              "1CO.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.3+ACT.9.4+ACT.9.5+ACT.9.6"
              },
              "items": [
                {
                  "text": "Tic 9.3-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Me agikki mere ducu, te daŋ nen baŋ, kadi bed abedo bala atin abwoggi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.8",
            "verseOrgIds": [
              "1CO.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.3"
              },
              "items": [
                {
                  "text": "Tic 8.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien an atidi meicel i akina okwena luŋ, ame mom myero lwoŋa ni an akwena, pien rik awuno lwak jo oye Kricito. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.9",
            "verseOrgIds": [
              "1CO.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi winyo ame Obaŋa omia en omio atye acalo atye-ni; winyo mere a tye baŋa-ni rik mom obedo me nononono. Rik abin amedde meicel i tiyo tic atek akato jo-nono luŋ; cite pe an gira atio, ento winyo Obaŋa en otio karacel keda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.10",
            "verseOrgIds": [
              "1CO.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doŋ kadi an kadi gin jo-nono, kop a wan orabo en ennono, kop ame iye wunu daŋ ennono.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.11",
            "verseOrgIds": [
              "1CO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.11",
            "verseOrgIds": [
              "1CO.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doŋ ka kwena ame arabo tito ni ocero Kricito iyi akina a jo oto, piŋo jo mogo i akinawu okobo ni cer a jo oto mom tye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.12",
            "verseOrgIds": [
              "1CO.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka cer a jo oto mom tye, Kricito daŋ gire mom ocero. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.13",
            "verseOrgIds": [
              "1CO.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aco do, ka Kricito rik mom ocero, kwena ame orabo doŋ yore mom. Anaka iyee megwu daŋ yore mom. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.14",
            "verseOrgIds": [
              "1CO.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Medo kede enno, wan daŋ ocaden me goba i kom Obaŋa, pien wan okobo kop i kom Obaŋa ni en ocero Kricito, cite ka cero jo mom tye, rik daŋ mom ocere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.15",
            "verseOrgIds": [
              "1CO.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien ka cero jo oto mom tye, Kricito daŋ rik mom ocero. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.16",
            "verseOrgIds": [
              "1CO.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite ka Kricito rik mom ocero, kony me iyeewu daŋ mom, nwoŋo pwod itye wunu i balwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.17",
            "verseOrgIds": [
              "1CO.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man doŋ tere ni jo onino i Kricito doŋ orwenyo oko odoco. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.18",
            "verseOrgIds": [
              "1CO.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka genwa i kom Kricito konyo ka i kwo me kare-ni keken, wan doŋ otye arac akato jo luŋ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.19",
            "verseOrgIds": [
              "1CO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.19",
            "verseOrgIds": [
              "1CO.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite iyi ateni mere, Kricito doŋ ocere oko iyi akina a jo oto, en tye acalo wi mwaka a jo onino oko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.20",
            "verseOrgIds": [
              "1CO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien dano en ame okelo to, dok daŋ cer a jo oto dano en ame okelo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.21",
            "verseOrgIds": [
              "1CO.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien acalo jo luŋ to iyi Adam, en i kite acellono jo luŋ obino miyogi kwo iyi Kricito. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.22",
            "verseOrgIds": [
              "1CO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ŋat acel acel i kakare: me agege Kricito, me wi mwaka, eka icennere jo a Kricito i kare me dwogo mere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.23",
            "verseOrgIds": [
              "1CO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka agikki piny te bino tuno, ame Kricito bino miyo iye loc iciŋ Obaŋa Papo, ame doŋ otyeko turo kwone loc kede twer kede teko luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.24",
            "verseOrgIds": [
              "1CO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Jab. 110.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien en myero bed i loc, ituno ka Obaŋa bino keto okworrere luŋ piny i te tyene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.25",
            "verseOrgIds": [
              "1CO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwor ame obino turo me agikki en to. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.26",
            "verseOrgIds": [
              "1CO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.8.6"
              },
              "items": [
                {
                  "text": "Jab. 8.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien rik ocoo ni, “Obaŋa oketo jami luŋ i te twerrere.” Ka okobo ni “oketo jami luŋ,” nen kannaler ni mom okwano iye Obaŋa ikome, ame oketo jami luŋ aluŋa i te loc a Kricito. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.27",
            "verseOrgIds": [
              "1CO.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋotyeko keto jami luŋ i te loccere, en Wod ikome daŋ obino keto i te loc Obaŋa, me Obaŋa doŋ bed jami luŋ iyi jami luŋ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.28",
            "verseOrgIds": [
              "1CO.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.28",
            "verseOrgIds": [
              "1CO.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyo, ka jo oto mom bino cer, kara doŋ tye niŋo baŋ jo a batija pi jo oto? Ka ce cero jo oto mom tye kadi acelloro, kara piŋo dok gin batija pirgi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.29",
            "verseOrgIds": [
              "1CO.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŋo wan daŋ ocuŋ kan arac caa luŋ? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.30",
            "verseOrgIds": [
              "1CO.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "An gira ato nino luŋ, omegona; mannono akobbiwu atir, pi wakere ame atye kede i komwu i Rwotwa Yecu Kricito. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.31",
            "verseOrgIds": [
              "1CO.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.13"
              },
              "items": [
                {
                  "text": "Ica. 22.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka rik aromo kede leyi ager i Epeco, acalo jo kobe-ni, kara konnyene ame anwoŋo iye? Ka cero jo oto mom tye, doŋ ber “ocamu, omatu, pien diki wan obino to.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.32",
            "verseOrgIds": [
              "1CO.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur imi bwolwu: “Bedo i jo areco balo kite abeco.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.33",
            "verseOrgIds": [
              "1CO.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwog wunu cen i tam atira a mom me mero, ite giko wunu bal. Pien jo mogo mom tye i ŋeccono i kom Obaŋa. Akobo man me alee twodwu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.34",
            "verseOrgIds": [
              "1CO.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.34",
            "verseOrgIds": [
              "1CO.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite gwok onyo ŋattoro bino penyo ni, “Jo oto ocerogi niŋo? Kite kommene a dok gin bino nwoŋo?” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.35",
            "verseOrgIds": [
              "1CO.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yin imiŋ amiŋa! Ka icoo koti i poto, pe nwoŋo kwo, kono ka koŋ oto oko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.36",
            "verseOrgIds": [
              "1CO.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin a yin icoo en koti nono, onyo koti kal onyo koti me kite ocele, mom kom ginapita ame bino doŋo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.37",
            "verseOrgIds": [
              "1CO.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite Obaŋa mie kom acalo rik oyero, koti acel acel kede kit kome. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.38",
            "verseOrgIds": [
              "1CO.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riŋo kom gin akwo luŋ mom bedo rorom; mea dano pat, mea leyi pat, mea winyi pat, mea rece daŋ pat. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.39",
            "verseOrgIds": [
              "1CO.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok daŋ tye kom me polo kede kom me lobo; ento kwogo a maca me polo i yore, kede kwogo a kom me lobo daŋ i yore. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.40",
            "verseOrgIds": [
              "1CO.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CO 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cen tye kede kwogo mere, kwogo a dwe daŋ pat, kede acer-gu daŋ kwogogi papat; pien kadi i akina acer tye iye kwogo papat.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.41",
            "verseOrgIds": [
              "1CO.15.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CO 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.41",
            "verseOrgIds": [
              "1CO.15.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CO 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tye daŋ amannono i kom cer a jo oto. Koti ame ocoo en gin atop; ka doŋ ocero mom dok to. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.42",
            "verseOrgIds": [
              "1CO.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CO 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ocoo ame kwogo mere pe, ocero ame kwogo mere tye; ocoo ame goro, ocero ame tye kede teko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.43",
            "verseOrgIds": [
              "1CO.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CO 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ocoo i kom me lobo man, ocero i kom me cuny. Ka tye kom me lobo man, anaka kom me cuny daŋ tye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.44",
            "verseOrgIds": [
              "1CO.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CO 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.7"
              },
              "items": [
                {
                  "text": "Age. 2.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rik ocoo ni, “Dano me agege, Adam, odoko gin akwo”; cite Adam me agikki odoko cuny a mio kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.45",
            "verseOrgIds": [
              "1CO.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CO 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mom kom me cuny en a kwoŋo bino, cite kom me lobo man; eka me cuny te bino icennere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.46",
            "verseOrgIds": [
              "1CO.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CO 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano me agege rik otio kede apua me Iobo; dano me aryo mere oya i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.47",
            "verseOrgIds": [
              "1CO.15.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CO 15:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo me lobo cal i dano ame otio kede lobo; aco jo me polo daŋ ocal i dano oya i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.48",
            "verseOrgIds": [
              "1CO.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CO 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doŋ acalo wan oruko cal a dano ame otio kede lobo, amannono daŋ obino ruko wunu cal a dano ame oya i polo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.49",
            "verseOrgIds": [
              "1CO.15.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CO 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.49",
            "verseOrgIds": [
              "1CO.15.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CO 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en gin ame akobbiwu, omegona, ni, gin a tye i kom kede remo mom twero nwoŋo loc Obaŋa, gin a top daŋ mom twero nwoŋo gin a mom top.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.50",
            "verseOrgIds": [
              "1CO.15.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CO 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.50",
            "verseOrgIds": [
              "1CO.15.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CO 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.51",
            "verseOrgIds": [
              "1CO.15.51"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.15+1TH.4.16+1TH.4.17"
              },
              "items": [
                {
                  "text": "1 Tec. 4.15-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koŋ iwiny wunu muŋ man, ni, mom wan luŋ obino nino, cite wan ducu obino lokowa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.51",
            "verseOrgIds": [
              "1CO.15.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CO 15:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipao, bala waŋ atutuba, ka apel me agikki okok. Pien apel bino kok, eka ote bino cero jo oto kun mom dok obino to, wan daŋ obino lokowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.52",
            "verseOrgIds": [
              "1CO.15.52"
            ]
