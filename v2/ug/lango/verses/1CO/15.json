                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien kop a nwaŋ amiowu a pire dwoŋ me agege, en kop a rik omia, ame kobo ni, Kricito rik oto pi balwa, kun lubo coc a rik ocoo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.3",
            "verseOrgIds": [
              "1CO.15.3"
            ]
          }
        },
        {
