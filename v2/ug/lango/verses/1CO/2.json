              },
              "items": [
                {
                  "text": "Ica. 64.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cite acalo rik ocoo ni,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
