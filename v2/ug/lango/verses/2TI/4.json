          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diye atek, iru bino baŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.9",
            "verseOrgIds": [
              "2TI.4.9"
            ]
          }
        },
