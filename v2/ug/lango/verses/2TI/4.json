                  "text": "Tit. 1.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien Dema doŋ oweka oko pi maro jami me wi lobo-ni, owoto gire oko i Tecalonika, Kurecen owoto i Galatia kede Tito i Dalmatia. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.10",
            "verseOrgIds": [
              "2TI.4.10"
            ]
          }
        },
        {
