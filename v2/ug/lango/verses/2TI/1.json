          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waraga man oya i baŋ Paulo ame akwena a Kricito Yecu pi mit Obaŋa, ame lubo cikere mere me miyowa kwo a tye i Kricito Yecu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        }
      ]
    },
