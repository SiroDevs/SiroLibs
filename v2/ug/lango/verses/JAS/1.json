              },
              "items": [
                {
                  "text": "Gal. 1.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waraga man oya i baŋ Yakobo ame en amiro Obaŋa kede Rwotwa Yecu Kricito.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
          }
        }
