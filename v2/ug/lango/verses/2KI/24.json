            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.28.1+JER.28.2+JER.28.3+JER.28.4+JER.28.5+JER.28.6+JER.28.7+JER.28.8+JER.28.9+JER.28.10+JER.28.11+JER.28.12+JER.28.13+JER.28.14+JER.28.15+JER.28.16+JER.28.17"
              },
              "items": [
                {
                  "text": "28.1-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jedekia ocako loc ame mwaka me dittere oromo pyeraryo wie acel, en te bedo loc i Jerucalem pi mwakki apar wie acel. Nyiŋ tottere Kamutal, nyaka Jeremia me Libna. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.18",
            "verseOrgIds": [
              "2KI.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "En obedo timo gin ame nen arac i nyim Rwot, kun lubo ginnoro luŋ ame Yekoyakin obedo timo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.19",
            "verseOrgIds": [
              "2KI.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
