          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboam oto, te wot weo karacel i kwari mere. Wode Jekaria te leyo kakare.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.29",
            "verseOrgIds": [
