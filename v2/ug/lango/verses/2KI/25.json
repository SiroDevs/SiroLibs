                "loc": "EZK.24.2"
              },
              "items": [
                {
                  "text": "Ejek. 24.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abaka Jedekia rik te cako jem oko i kom abaka me Babulon. I mwaka me aboŋwen me loccere, i dwe me apar, i nino dwe apar, en ame Nebukadnejar abaka me Babulon obino iye ikom Jerucalem, kun bino karacel i monnyere luŋ, te bino guro Jerucalem oko; ote daŋ toro lobo guro oko irit. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boma te bedo ame oguro kittono naka i mwaka me apar wie acel me loc abaka Jedekia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nino dwe aboŋwen me dwe me aŋwen onwoŋo kec doŋ orido jo atek meicel ame cam mom doŋ romo nen pi jo ame tye i boma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.21"
              },
              "items": [
                {
                  "text": "Ejek. 33.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jo te muko apama cel me boma oko, eka abaka kede monnyere te lwi ciro oko dyewor, kun obeo i dogcel ame tye i akina cel aryo me boma, ame tye i ŋet poto abaka, kadi bed rik jo Kaldaya onwoŋo oguro boma oko. Gin te wot lubo yo ame dok tutuŋ Araba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite mony a jo Kaldaya rik te ryemo yo abaka, ote bino make i bar me Jeriko twal, monnyere te ket weke kene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mony me Kaldaya te make kele naka baŋ abaka me Babulon i Ribla, kan ame ote ŋolle iye kop. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.13"
              },
              "items": [
                {
                  "text": "Ejek. 12.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin te cako neko awobe mere i nyime kun en aneno kede waŋe, ote lokere i kome woto waŋe oko, ote tweye kede jegere tere i Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I dwe me abic me nino dwe abiro, ame obedo mwaka me apar wie aboŋwen me loc a Nebukadnejar, abaka me Babulon, i nino-nono Nabujaradan, adwoŋ ame loo jo ame gwoko abaka me Babulon, owoto i Jerucalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "En te waŋo ot a Rwot oko karacel kede ot abaka, kede udi luŋ ame onwoŋo tye i Jerucalem; en owaŋo udi adoŋo luŋ kede mac. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mony a jo Kaldaya luŋ ame rik onwoŋo tye baŋ adwoŋ a jo ame gwoko abaka, gin omuko apama cel me Jerucalem oko. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebujaradan, adwoŋ ame loo jo ame gwoko abaka te tero jo luŋ ame onwoŋo rik oweko i Jerucalem, medo kede jo ame rik okwero abaka me Babulon, karacel kede lwak ocele luŋ, gin luŋ oterogi oko acalo opii. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite en rik te weko jo mogo ame ocan doŋ kuno, me gin bed jo ame gwoko poto olok kede opur i kweri dyan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        }
      ]
    },
    {
