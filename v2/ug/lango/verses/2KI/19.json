              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cenakarib, abaka me Acuria te dok paco, wot bedo i Nineve. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
            "verseOrgIds": [
              "2KI.19.36"
            ]
