            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet. 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "En rik omiye kene pirwa me lakorowa oko i bal luŋ, kede me lonyowa obed jo mere ikome, ame tye kede mit me tiyo tic abeco.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
      ]
    },
    {
