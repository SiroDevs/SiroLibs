            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.24",
            "verseOrgIds": [
              "EZR.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka i kom jo ocele te bedo jo magi: I kom jo me doggola a Paroc tye Ramia, Ijjia, Malkija, Mijamin, Eliajar, Malkija, kede Benayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.25",
            "verseOrgIds": [
              "EZR.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jo me doggola a Elam te bedo Matania, Jekaria, Jekiel, Abdi, Jeremot, kede Erica. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.26",
            "verseOrgIds": [
              "EZR.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jo me doggola a Jattu tye Elioenai, Eliacib, Matania, Jeremot, Jabad, kede Ajija. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.27",
            "verseOrgIds": [
              "EZR.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jo me doggola a Bebai te bedo Jekokanan, Kanania, Jabbai, kede Atilai, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.28",
            "verseOrgIds": [
              "EZR.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jo me doggola a Bani te bedo: Mecullam, Malluk, Adaya, Jacub, Ceal, kede Jeremot. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.29",
            "verseOrgIds": [
              "EZR.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jo me doggola a Pakat-moab te bedo: Adna, Celal, Benayo, Maceya, Matania, Bejalel, Binnui, kede Manace, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.30",
            "verseOrgIds": [
              "EZR.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZR 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jo me doggola a Karim te bedo Eliejer, Icija, Malkija, Cemaya, Cimeon, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.31",
            "verseOrgIds": [
              "EZR.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benjamin, Malluk, kede Cemaria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.32",
            "verseOrgIds": [
              "EZR.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jo me doggola a Kacum te bedo Matenai, Mattata, Jabad, Eliepelet, Jeremai, Manace kede Cimei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.33",
            "verseOrgIds": [
              "EZR.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jo me doggola a Bani tye iye Madai, Amuram, Uel, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.34",
            "verseOrgIds": [
              "EZR.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benayo, Bedeya, Celuki, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.35",
            "verseOrgIds": [
              "EZR.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZR 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vania, Meremot, Eliacib, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.36",
            "verseOrgIds": [
              "EZR.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZR 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matania, Mattenai, kede Jacu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.37",
            "verseOrgIds": [
              "EZR.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZR 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jo me doggola a Binnui te tye iye Cimei, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.38",
            "verseOrgIds": [
              "EZR.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZR 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Celemia, Natan, Adaya, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.39",
            "verseOrgIds": [
              "EZR.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZR 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makenadebai, Cacai, Carai, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.40",
            "verseOrgIds": [
              "EZR.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZR 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajarel, Celemia, Cemaria, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.41",
            "verseOrgIds": [
              "EZR.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZR 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Callum, Amaria kede Yucepu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.42",
            "verseOrgIds": [
              "EZR.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZR 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jo me doggola Nebo te bedo Jeyel, Mattitia, Jabad, Jebina, Jaddai, Joel, kede Benaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.43",
            "verseOrgIds": [
              "EZR.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZR 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo magi luŋ onwoŋo rik onyomo anyira orok. Gin rik te ryemogi oko karacel kede itinogi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.44",
            "verseOrgIds": [
              "EZR.10.44"
            ]
          }
        }
