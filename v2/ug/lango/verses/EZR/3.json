              "items": [
                {
                  "text": "Jer. 33.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin te bedo wero wer me pako Rwot kun oleo alea, opake kede dok daŋ opwoc kede ni,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo luŋ te wo kun ŋat acel acel redo i dwon aloŋo, pako kede Rwot, pien acakki me te ottere doŋ oketo oko, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olamdoggogo oteggo kede jo Levi kede odoŋe atekere ame rik onwoŋo oneno ot Obaŋa me agege, gin luŋ okok atek i kare ame otye ka gero acakki te ot a Rwot anyennere-nono. Cite i caa-nono jo ocele gire onwoŋo tye awo kede yomcuny. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.12",
            "verseOrgIds": [
              "EZR.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man omio kare-nono mom onwoŋo tye ŋattoro ame twero poko dwon me koko kede dwoŋ me yomcuny, pien wo onwoŋo dwon okato kare ame winyere i kannabor meicel.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.13",
            "verseOrgIds": [
              "EZR.3.13"
            ]
          }
        }
      ]
    }
