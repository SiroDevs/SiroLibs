            "number": "29",
            "style": "v",
            "sid": "EZK 40:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icika atitino ame tye i ŋete kede icika alaccere, karacel kede apama mere me yie kuno, onwoŋo rom aroma i en ocele-ca, dirica onwoŋo tye iyi icika mere atitino kede i icika alaccere; dogcellono daŋ borrere onwoŋo tye futi pyeraboro, laccere daŋ futi pyeraŋwen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.29",
            "verseOrgIds": [
              "EZK.40.29"
            ]
          }
        },
        {
          "name": "verse",
