          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icika ocele daŋ onwoŋo tye i ŋete ame borgi futi pyeraŋwen, lacgi futi aboro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.30",
            "verseOrgIds": [
              "EZK.40.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 40:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icika alac ame onwoŋo tye iye onwoŋo otikere i dyekal alac ame onwoŋo tye oko, cal yen otit daŋ onwoŋo tye ame okwogo kede kor apama me yie. Rwom ame woto i dogcel onwoŋo tye aboro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.31",
            "verseOrgIds": [
              "EZK.40.31"
            ]
          }
        }
