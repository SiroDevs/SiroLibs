              "EZK.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 43:13"
          },
          "items": [
            {
              "text": "13",
