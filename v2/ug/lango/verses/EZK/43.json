              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi nino abiro ibino bedo miyo dyel acel acel i nino acel acel, acalo mot me kwanyo bal, kede dok twon, kede nyok romo, gin luŋ myero bed aboŋo roccoro i komgi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.25",
            "verseOrgIds": [
              "EZK.43.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 43:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin bino tiyo tic me kwanyo bal i kom keno me lam pi nino abiro, eka keno me lam doŋ te lony bedo acil, ote doŋ kwero pi ticcoro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
            "verseOrgIds": [
              "EZK.43.26"
            ]
          }
