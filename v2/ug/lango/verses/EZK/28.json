                }
              ]
            }
          ]
        },
        {
          "text": "Rwot rik dok te kop keda, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.20",
            "verseOrgIds": [
              "EZK.28.20"
            ]
          }
