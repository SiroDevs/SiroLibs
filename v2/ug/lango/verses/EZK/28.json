          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Medo i kom mannono, Rwot dok te kop keda, kun kobo ni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.11",
            "verseOrgIds": [
              "EZK.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wot a dano we, ya malo me ikum pi abaka me Turo, ite kobbe kop man ame Rwot Obaŋa okobo:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
