        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wot a dano we, lokere koŋ dok inen Cidon, me irab kop i kome, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.21",
            "verseOrgIds": [
              "EZK.28.21"
            ]
          }
        },
        {
