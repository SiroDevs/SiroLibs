              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot dok te kop keda, kun kobo ni, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.26",
            "verseOrgIds": [
              "EZK.12.26"
            ]
          }
        },
        {
          "name": "verse",
