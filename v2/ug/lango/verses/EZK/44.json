            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.5"
              },
              "items": [
                {
                  "text": "Olev. 21.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Alamdog mom bino lyelo yer wigi, dok mom obino weko yer wigi lot aboco. Gin obino ŋolo oko kare i kare me doŋ acegocego. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.9"
              },
              "items": [
                {
                  "text": "Olev. 10.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alamdoggoro mom bino mato koŋo olok i kare ame en awot i dyekal ame tye i yie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
        },
