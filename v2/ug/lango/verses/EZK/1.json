              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.9+EZK.10.10+EZK.10.11+EZK.10.12+EZK.10.13"
              },
              "items": [
                {
                  "text": "Ejek. 10.9-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare ame onwoŋo atye aneno leyi aŋwennono, ate daŋ neno okot ame tye piny i lobo i ŋet leyi aŋwennono, kun okot acel acel tye i ŋet leyi aŋwennono, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kite ame otio kede okottono, kede kite onwoŋo nen kede onwoŋo tye kit man: Gin aŋwennono luŋ onwoŋo tye cacal, kun acel acel i akinagi onwoŋo memenya calo gweŋ alilia, dok otiogi acalo okot ame tye iyi okot wadgi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin okot aŋwennono luŋ ka owot, owoto tuŋŋoro keken ame gin okemo kabedo aŋwen luŋ, kun owoto atira ame mom romo lokere tuŋŋoro ocele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
            "verseOrgIds": [
              "EZK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Nyut 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kom okot aŋwennono, onwoŋo tye iye kan ame otutuca calo waŋgi, kun oromo kom okot luŋ irit, dok daŋ tire mere onwoŋo tye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.18",
            "verseOrgIds": [
              "EZK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doŋ ka leyi aŋwen-ca tye awot, okot aŋwennono daŋ woto i ŋegi. Ka leyi aŋwen-ca oya oko i lobo, okot daŋ woto i ŋetgi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
              "EZK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin luŋ owoto kun ame cuny omito ni gin owot iye, kun okot daŋ ya woto kedgi, pien cuny ame telo leyi aŋwennono onwoŋo tye i kom okot aŋwennono. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka leyi aŋwen-ca owoto, okot daŋ woto, ka gin ocuŋ okot daŋ cuŋ, ka gin oya i lobo, okot daŋ tiŋere malo ya karacel kedgi, pien cuny ame telo leyi aŋwen-ca onwoŋo tye i kom okot.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.21",
            "verseOrgIds": [
              "EZK.1.21"
            ]
          }
        }
      ]
    },
    {
