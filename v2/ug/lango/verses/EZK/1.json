              "items": [
                {
                  "text": "Ejek. 8.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cakere i pyere dok kede malo, aneno ginnoro ame tye amimila calo mola, calo mac ame omano kome luŋ, aco cakere i pyere dok kede piny, ate neno ginnoro acalo mac, kun amemenya i kabedo luŋ i ŋete kuno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.27",
            "verseOrgIds": [
              "EZK.1.27"
            ]
          }
        },
