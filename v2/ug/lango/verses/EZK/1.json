                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I wi gin opette-malo-nono, i wi leyi aŋwen-ca, ginnoro onwoŋo tye iye calli i kom loc ame nen bululubululu calo capir, ginnoro onwoŋo tye ame obedo i wie, ame cal acala i dano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.26",
            "verseOrgIds": [
              "EZK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
