                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.2"
              },
              "items": [
                {
                  "text": "Nyut 4.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dok ate neno ginnoro ame opette malo i wi okerubi, i wie malo kunnu, ate neno ginnoro daŋ acalli kom loc, ame otio i kidi capir ame obedo bululu bululu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Nyut 8.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Obaŋa te kobbi dano ame orukoboŋo camanini ni, “Wot idony naka i akina okot ame tye ka wirre-ni, dony i piny i te okerubi, ite juko cukbilo poŋ ciŋi, kun ijuko i akina okerubi, eka ite keketo atata i dye boma.” En te wot i nyima kun onwoŋo atye aneno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare-nono onwoŋo okerubi tye ocuŋ tutuŋ anyarolum, i kare ame dano-nono doŋ odonyo i ot, pol te bino wumo dyekal me ottono oko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwogo a Rwot te ya i kom okerubi, te wot naka i doggola me ot a Rwot. Pol onwoŋo owumo yi ot a Rwot oko, kede dyekal, kun kwogo a Rwot tye ameny amenya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwom okerubi onwoŋo tye amor awinyere naka i dyekal ame onwoŋo tye oko, kun ŋur calo dwon Obaŋa Won Twer Ducu ame tye ka kop.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare ame Rwot ociko dano ame orukoboŋo camanini, ni, “Kwany mac i akina okot ame tye awirre i akina okerubi”, dano-nono owoto te wot donyo i akina okot te cuŋ i ŋet okot acel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akerubi acel te ryeyo ciŋe i akina okerubi wadgi, kun cwao ciŋe i mac ame onwoŋo tye i akina okerubi, te gwaro maccono, keto i ciŋ dano ame orukoboŋo me camanini-ni, dano-no te gamo wot kede oko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okerubi acel acel onwoŋo tye kede ginnoro i te bwome ame nen calo ciŋ dano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.15+EZK.1.16+EZK.1.17+EZK.1.18+EZK.1.19+EZK.1.20+EZK.1.21"
              },
              "items": [
                {
                  "text": "Ejek. 1.15-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dok ate neno okot aŋwen ame onwoŋo tye i ŋet okerubi, kun okot acel acel tye i ŋet okerubi acel acel. Okot acel acel onwoŋo memenya calo gweŋ alilia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.9",
            "verseOrgIds": [
              "EZK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin luŋ onwoŋo ocacal, dok okot acel acel nen calo gin ame tye iyi okot wadgi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.10",
            "verseOrgIds": [
              "EZK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin okot aŋwennono luŋ onwoŋo ka owot owoto tuŋŋoro keken ame nyimgi otiko i kabedo aŋwen luŋ, kun owoto atira ame nyimgi mom romo lokere tuŋ ocele, tuŋ ame okot ame otelo yo otiko, okot ocele mere doŋ luba aluba aboŋo lokere kadi acel i kare ame gin awottono. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.11",
            "verseOrgIds": [
              "EZK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Nyut 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kom okot aŋwennono luŋ, medo kede tiregi, onwoŋo tye kan ame otutuca calo waŋgi, kun oromo kom okot luŋ irit. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.12",
            "verseOrgIds": [
              "EZK.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okot aŋwennono, an awinyo ka olwonogi ni okot ame wirre calo yamo ajuru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.13",
            "verseOrgIds": [
              "EZK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.10"
              },
              "items": [
                {
                  "text": "Ejek. 1.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Nyut 4.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Okerubi acel acel onwoŋo tye kede nyime aŋwen, me agege onwoŋo nen calo nyim okerubi, me aryo mere te nen calo nyim dano, me adekkere te nen calo nyim eŋatu, eka me aŋwennere te nen calo nyim cur. Mannono en kite ame nyimgi onwoŋo nen kede.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okerubi te ya twarre oko malo i yamo, Magi gin leyi aŋwen ame yam aneno i ŋet kulo me Kebar. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.15",
            "verseOrgIds": [
              "EZK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka okerubi ocako wot, okot daŋ woto karacel kedgi, ka okerubi oyaro bwomgi malo me twarre oko i lobo, okot daŋ mom ya i ŋetgi kadi acel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.16",
            "verseOrgIds": [
              "EZK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce gin ocuŋ mot, okot daŋ cuŋ mot, ka ce gin otwarre malo, okot aŋwen-ni daŋ twarre me wot kedgi, pien cuny leyi aŋwen-ca onwoŋo tye i kom okot. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwogo a Rwot te ya oko i kom doggola me ot a Rwot te wot cuŋ malo i wi okerubi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "okerubi te yaro bwomgi, te twarre oko i lobo, an onwoŋo atye anenogi i kare ame gin tye awot, kun owoto karacel okot i ŋetgi. Gin te wot cuŋ i doggola ame tye tutuŋ kide me ot a Rwot; kwogo a Rwot Obaŋa me Icrael onwoŋo tye i wigi malo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi gin leyi aŋwen ame yam anenogi i ŋet kulo me Kebar, kun Rwot Obaŋa me Icrael tye i wigi malo. An rik ate niaŋ ni gin obedo okerubi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acel acel i akina leyi-nono onwoŋo tye kede nyime aŋwen bwome aŋwen, kun i te bwome acel acel tye iye ginnoro ame cal i ciŋ dano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.21",
            "verseOrgIds": [
              "EZK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aco kite ame cal i nyimgi nen kede, nyimgi onwoŋo rom aroma i nyim leyi ame aneno i ŋet kulo me Kebar, gin luŋ ŋat acel acel onwoŋo woto ame otiko nyime atira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.22",
            "verseOrgIds": [
              "EZK.10.22"
            ]
          }
        }
      ]
    }
  ],
