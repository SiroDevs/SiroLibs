          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede gwata acel pi atin nyok romo acel acel ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
