              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.28"
              },
              "items": [
                {
                  "text": "Lak. 1.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok owoto loka Jordan, i kabedo kan a Lakana koŋ obatija jo iye. En obedo kuno, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo apol obino baŋe. Gin te kobbe ni, “Lakana rik mom otio anyuttoro, ento gin ducu ame Lakana otito i kom dano man obedo me ateni.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.41",
            "verseOrgIds": [
              "JHN.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo apol oye en i kuno.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.42",
            "verseOrgIds": [
              "JHN.10.42"
            ]
          }
        }
