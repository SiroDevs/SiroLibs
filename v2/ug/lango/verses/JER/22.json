              "attrs": {
                "loc": "2KI.24.8+2KI.24.9+2KI.24.10+2KI.24.11+2KI.24.12+2KI.24.13+2KI.24.14+2KI.24.15"
              },
              "items": [
                {
                  "text": "2 Obak. 24.8-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.9+2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Tek. 36.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot okobo ni, “Kite ame atye kede kwo-ni, kadi bed Yekonia wot a Yekoyakim abaka me Juda, onwoŋo obedo atem me ŋut cin ame onwoŋo tye i ŋut ciŋa tuŋ cem, onwoŋo pwod aromo kwanyo oko i ŋut ciŋa ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ate miyo baŋ jo ame mito neke, i cin jo ame en lworo, naka kadi i cin Nebukadnejar abaka me Babulon kede ocirikale mere. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abino bayi i lobo ocele karacel kede totti ame onywali, kan ame mom rik onywali iye, ibino to daŋ kuno, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite mom dok obino dwogo cen kadi acel i lobo man ame omito ni kono odwogo iye-ni.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        }
      ]
