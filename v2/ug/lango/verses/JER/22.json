          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        2 Obak. 23.36–24.6",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Tek. 36.5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mannono omio Rwot okobo kop i kom Yekoyakim, wot a Yocia, abaka me Juda ni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
      ]
