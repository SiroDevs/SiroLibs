        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Doŋ yin myero iwot ikob kop magi luŋ baŋgi, cite gin gigi mom obino winyo koppi. Ibino lwoŋogi, cite gin mom obino gamo dogi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.27",
            "verseOrgIds": [
              "JER.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yin doŋ ibino kobbigi ni, ‘Man en rok ame rik okwero winyo kop a Rwot Obaŋagi, dok daŋ rik mom oye ni yik balgi; kop me ateni doŋ orwenyo oko i baŋgi: mom doŋ winyere kadi acel i doggi.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
