          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pien jo Juda doŋ otyeko timo gin arac i nyima, dokoketo timgi me kwer i ot ame olwoŋo kede nyiŋa, me balo oko, man kop ame Rwot okobo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
