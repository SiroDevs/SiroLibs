              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "cite gin gigi mom oye winyo koppa, akadi yabo yitgi me winyo koppa; ento ŋutgi en ame oluŋyo bedo anwaŋ. Gin te bedo timo gigi mogo areco ame kato kwarigi oko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
            "verseOrgIds": [
              "JER.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
