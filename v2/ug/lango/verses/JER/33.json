                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Rwot okobo ni, Akwar Daudi mom bino rwenyo i wi kom loc me ot a Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
