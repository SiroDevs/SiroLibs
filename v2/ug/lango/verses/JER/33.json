              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot okobbi Jeremia ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
