          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot okobbi Jeremia ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rwot okobo ni ka ce itwero turo cikerena ame ocikere kede wan kede dyeceŋ kede en ame ocikere i dyewor, ame twero miyo dyeceŋ kede dyewor mom twero bino i kare ame doŋ otyeko moko oko pirgi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
