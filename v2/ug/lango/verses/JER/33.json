                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "dwon me yomcuny bino winyere iye, karacel kede dwon atera kede me anyom, dwon jo ame tye ka wer kun okelo motgi me pwoc i ot a Rwot, ame ower ni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
