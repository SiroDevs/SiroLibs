                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nen ba, kare tye abino, ame abino cobo iye ginnoro luŋ ame rik aciko baŋ jo me ot Icrael kede me ot a Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare-nono, kede i nino-nono ikokome abino keto dok akwar Daudi ikokome i kom me loc. En bino ŋolo kop kakare kun tio gin a tye atira me miyo kuc bedo tye i lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka karenono oromo jo Juda kede Jerucalem bino larre te bedo mot i kuc. Nyiŋ ame obino lwone kede ene: ‘Rwot ame olarowa.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        }
      ]
    },
