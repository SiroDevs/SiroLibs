              "JER.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rwot me mony okobo ni, I kabedo man ame doŋ odoko wi obur ame jo kede leyi doŋ mom iye, karacel kede boma luŋ ame tye iye, okwat ame tye akwayo rommigi bino dok bedo iye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "I boma luŋ ame tye i lobo obedo kidikidi, i boma luŋ ame tye i Cepela, i boma luŋ ame tye i Negeb, i boma luŋ ame tye i lobo a jo Benjamin, i kabedo luŋ ame oguro Jerucalem, karacel kede i boma luŋ ame tye i Juda, rommi kede dyegi pwod dok bino bea iye i nyim dano ame tye akwanogi, man kop a Rwot okobo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
