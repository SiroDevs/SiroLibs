                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.17"
              },
              "items": [
                {
                  "text": "22.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.4"
              },
              "items": [
                {
                  "text": "26.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi rik onwoŋo mom okwano wel jo ame mwaka me ditogi mom ru oromo pyeraryo, pien Rwot rik onwoŋo ociko ni ebino miyo jo Icrael bedo apol meicel acalo acer ame tye i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.1+2SA.24.2+2SA.24.3+2SA.24.4+2SA.24.5+2SA.24.6+2SA.24.7+2SA.24.8+2SA.24.9+2SA.24.10+2SA.24.11+2SA.24.12+2SA.24.13+2SA.24.14+2SA.24.15"
              },
              "items": [
                {
                  "text": "2 Cam. 24.1-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.1+1CH.21.2+1CH.21.3+1CH.21.4+1CH.21.5+1CH.21.6+1CH.21.7+1CH.21.8+1CH.21.9+1CH.21.10+1CH.21.11+1CH.21.12+1CH.21.13+1CH.21.14"
              },
              "items": [
                {
                  "text": "1 Tek. 21.1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yoab wot a Jeruya en ame rik ogeo kwano jo Icrael, cite rik mom te tyeko ducu, Obaŋa rik oketo can i kom jo Icrael pi wel jo ame okwano naca, naka omio welgi mom obin ocoo i buk me Tekwaro ame tito kop i kom abaka Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi en nyiŋ jo ame rik onwoŋo loo jami abaka: Ajimavet wot Adiel en ame rik loo udi me kano lim abaka; Yonacan wot a Ujjia en ame rik loo udi me kano lim ame tye i akina pacci adoŋo kede en atino kede en ame tye i udi adono ame ocuŋ igun malo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejri wot a Kelub en ame rik loo jo ame tio tic me pur i poto; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.26",
            "verseOrgIds": [
              "1CH.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cimei ame rik obedo dano me Rama en ame rik obedo nat ame loo potti olok; Jabdi ame rik obedo dano me Cipim en ame rik loo kono olok ame okano i udi me kano korjo olok. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baal-kanan ame obedo dano me Geder en ame rik obedo nat ame loo yen Jeituni kede olam ame rik tye i bar me Cepela; eka Yowaci en ame te loyo ot ame okano iye moo jeituni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Citrayi ame obedo dano me Caron en ame rik obedo ŋat ame loo dok ame rik okwao i Caron; Capat wot Adlai en ame rik loo dok luŋ ame okwao i luŋ apapat.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
