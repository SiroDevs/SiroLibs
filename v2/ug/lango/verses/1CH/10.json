                  "text": "28.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Caulo oto pien okwero bedo nat ame genne en onwoŋo mom geno Rwot, dok en otemo wot baŋ okor tipo a jo oto me wot penyo tamgi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kun mom geno Rwot me tele, Mannono omio Rwot oneke oko te miyo loccere i cin Daudi wot a Yece.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
