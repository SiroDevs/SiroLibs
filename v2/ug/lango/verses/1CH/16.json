            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwak luŋ doŋ te ket dok paco, kun ŋat acel acel dok tune, Daudi daŋ te dok tuŋe me wot la mo winyo i kom jo me ode.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.43",
