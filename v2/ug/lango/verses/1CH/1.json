    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adam obedo papa a Ceji, Ceji obedo papa a Enoci, Enoci obedo papa a Kenan, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.1",
            "verseOrgIds": [
              "1CH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenan obedo papa a Maalalel, Maalalel obedo papa a Jared, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.2",
            "verseOrgIds": [
              "1CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jared obedo papa a Enoka, ame obedo papa a Metucela, Metucela ame obedo papa a Lameki, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.3",
            "verseOrgIds": [
              "1CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ame obedo papa a Nua, Nua onwoŋo tye awobe adek: Cem, Kam kede Yafeci.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.4",
            "verseOrgIds": [
              "1CH.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.4",
            "verseOrgIds": [
              "1CH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awobe a Yafeci obedo Gomer, Magog, Madai, Javan, Tubal, Mecek kede Tirac, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.5",
            "verseOrgIds": [
              "1CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awobe a Gomer obedo: Acikenaj Ripa kede Togarma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.6",
            "verseOrgIds": [
              "1CH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awobe a Javan obedo: Elica, Tarcic, Kittim, kede Dodanim.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.7",
            "verseOrgIds": [
              "1CH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.7",
            "verseOrgIds": [
              "1CH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awobe a Kam obedo Kuc, Miciri, Put, kede Kanaan, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.8",
            "verseOrgIds": [
              "1CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awobe a Kuc obedo: Seba, Kavila, Cabta, Raama, kede Cabteka. Awobe a Raam obedo: Ceba kede Dedan, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.9",
            "verseOrgIds": [
              "1CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuc rik te bedo i wode ame nyiŋe Nimolodi, ame en rik dano ame ogeo bedo twon lo moro atek me wi lobo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.10",
            "verseOrgIds": [
              "1CH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.10",
            "verseOrgIds": [
              "1CH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miciri te nywalo awobe magi Lud, Anam Lekab, Naptuk, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.11",
            "verseOrgIds": [
              "1CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patruc, Kacluk kede Kaptor (man gin jo ame jo Piriciti oya i komgi.).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.12",
            "verseOrgIds": [
              "1CH.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.12",
            "verseOrgIds": [
              "1CH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaan te nywalo awo be magl: Cidon obedo atinnere me kao, Ket te lube, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.13",
            "verseOrgIds": [
              "1CH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede Jebuc, Amor kede Girgac, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.14",
            "verseOrgIds": [
              "1CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kivi, Arki, Cin, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.15",
            "verseOrgIds": [
              "1CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arvad, Cemar, kede Kemat (itekere awobeni rikk daŋ olwoŋogi kede nyiŋgi-nono.)",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.16",
            "verseOrgIds": [
              "1CH.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.16",
            "verseOrgIds": [
              "1CH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awobe a Cem te bedo Elam, Acur, Arpakcad, Lud, Aram, Kul, Geter, kede Mecek (awobeni daŋ obedo kwaro a jo ame olwoŋo daŋ i nyiŋgi-nono) ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.17",
            "verseOrgIds": [
              "1CH.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arpakcad te nywalo Cela papa Eber, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.18",
            "verseOrgIds": [
              "1CH.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eber te nywalo awboe aryo: acel nyiŋe Peleg (pien i kare mere jo i wi lobo onwoŋo opokere), nyiŋ ominnere te bedo Yokotani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.19",
            "verseOrgIds": [
              "1CH.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwae a Yokotani te bedo jo Almodad, Celep, Kacarmavet, Yera, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.20",
            "verseOrgIds": [
              "1CH.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoram, Ujal, Dikla, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.21",
            "verseOrgIds": [
              "1CH.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obal, Abimael, Ceba, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.22",
            "verseOrgIds": [
              "1CH.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opir, Kavila, kede jo Yobab.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.23",
            "verseOrgIds": [
              "1CH.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.23",
            "verseOrgIds": [
              "1CH.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwae a Cem tuno kede i kom Abram onwoŋo tye kit man: Cem, Arpakcad, Cela, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.24",
            "verseOrgIds": [
              "1CH.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eber, Peleg, Reu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.25",
            "verseOrgIds": [
              "1CH.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cerug, Nakor, Tera, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.26",
            "verseOrgIds": [
              "1CH.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abram ame daŋ olwoŋo ni Iburaim.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.27",
            "verseOrgIds": [
              "1CH.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.27",
            "verseOrgIds": [
              "1CH.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburaim onwoŋo tye kede awobe aryo: Icaka kede Icmael. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.28",
            "verseOrgIds": [
              "1CH.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awobe Icmael rik te doko odoŋ me wi iekere apapat apar wie aryo: Nebayot ame obedo wode me kao, kede Kedar, Adbeel, Mibcam, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.29",
            "verseOrgIds": [
              "1CH.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Micima, Duma, Macca, Kadad, Tema, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.30",
            "verseOrgIds": [
              "1CH.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jetur, Napic, kede Kedema, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.31",
            "verseOrgIds": [
              "1CH.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburaim daŋ onwoŋo tye kede dako aŋeca ocele ame, te nywalle awobe abicel, aŋeca-nono nyiŋe onwoŋo Ketula: Jimran, Yokcan, Medan, Midian, Icibak, kede Cua, Yokocan te nywalo awo be aryo: Ceba kede Dedan, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.32",
            "verseOrgIds": [
              "1CH.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Midian onwoŋo tye awobe abic: Epa, Eber, Kanok, Abida, kede Eldaa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.33",
            "verseOrgIds": [
              "1CH.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.33",
            "verseOrgIds": [
              "1CH.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icaka wot Iburaim onwoŋo tye awobe aryo: Ecau kede Icrael. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.34",
            "verseOrgIds": [
              "1CH.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awobe Ecau ene: Elifaji, Rewel, Jeuc, Jalam kede Kora, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.35",
            "verseOrgIds": [
              "1CH.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifaji obedo kwaro a jo me itekere magi: Teman, Omar, Jepo, Gatam, Kenaj, Timna, kede Amalek. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.36",
            "verseOrgIds": [
              "1CH.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rewel en kwaro a jo me Itekere magl: Nakat, Jera, Camma, kede Mijja.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.37",
            "verseOrgIds": [
              "1CH.1.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.37",
            "verseOrgIds": [
              "1CH.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ceir rik onywalo awobe magi: Lotan, Cobal, Jibeon, Ana, Dicon, Ejer kede Dican, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.38",
            "verseOrgIds": [
              "1CH.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lotan onwoŋo tye awobe aryo: Kori kede Komam, Lotan onwoŋo tye kede aminnere a nyiŋ Timna, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.39",
            "verseOrgIds": [
              "1CH.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cobal onwoŋo onywalo awobe magi: Alvan, Manakat, Ebal, Cepo, kede Onam, Jibeon te nywalo awo be aryo: Aiya kede Ana, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.40",
            "verseOrgIds": [
              "1CH.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana obedo papa a Dicon, Dicon te nywalo awobe magi: Kamran, Eciban, Itran, kede Keran, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.41",
            "verseOrgIds": [
              "1CH.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ecer te bedo papa awobe magi: Bilan, Javan, Jakan, Awobe Dican te bedo Uji kede Aran.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.42",
            "verseOrgIds": [
              "1CH.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
