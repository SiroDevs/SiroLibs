              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom ikwae Ijar, rik oyero Kanania kede awobe mere me tiyo tic ocele iyi akina jo Icrael, kun gin obedo acalo rwode kede oŋolkop.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
