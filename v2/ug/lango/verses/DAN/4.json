            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyot koppono te ru cobere oko i kom abaka Nebukadnejar. Rik ote ryeme oko i akina dano, te cako camo lum calo twon, toyo aya i polo te dyako kome oko, te miyo yer wie lot aboco calo yer kom cur, kun lwete doŋ calo lwet winy.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        }
      ]
