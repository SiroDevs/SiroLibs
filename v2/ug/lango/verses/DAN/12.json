                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.14"
              },
              "items": [
                {
                  "text": "Nyut 7.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.7"
              },
              "items": [
                {
                  "text": "12.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“I kare-nono Maikol bino, bino, ame en aloc adwoŋ ame loo rokwu. Kare me can bino bedo tye; can ame yam mom ru onen, cakere i kare ame rok luŋ cakere acaka tuno kede naka i kare-naca; i kare-naca obino laro rokwu; jo luŋ ame obino nwoŋo nyiŋgi ocoye i buk. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.1",
            "verseOrgIds": [
              "DAN.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.19"
              },
              "items": [
                {
                  "text": "Ica. 26.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.46"
              },
              "items": [
                {
                  "text": "Mat. 25.46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.29"
              },
              "items": [
                {
                  "text": "Lak. 5.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pol a jo ame oto ote yiko komgi piny i lobo bino ya malo, kun jo ocele ya te bedo i kwo ame perakino nakanaka, jo ocele bino ya i twon lewic adwoŋ kede acae ame perakino atwal. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.2",
            "verseOrgIds": [
              "DAN.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo ame ryek bino ryeny aryenya calo polo ame opette, kede jo ame loko jo apol doko jo a kitegi atira, bino meny amenya nakanaka calo acer. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.3",
            "verseOrgIds": [
              "DAN.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.10"
              },
              "items": [
                {
                  "text": "Nyut 22.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Doŋ yin Danieri, wun buk ame ocoo iye kop man oko, mwon doge oko, tuno ka kare me agikki doŋ oromo. Jo apol bino riŋo kun wirre tuŋŋi i tuŋŋi, dok daŋ bino medde.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "An Danieri ate tiŋo waŋa neno jo aryo ame ocuŋ, kun acel ocuŋ i dog kulo tuŋŋi, acel ocuŋ i dog kulo tuŋ-ca. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.5",
            "verseOrgIds": [
              "DAN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "An ate kobbi dano ame onwoŋo oruko boŋo camanini, ame onwoŋo tye malo i wi pii i kulo, ni, “Man bino tero kare ame rom mene tuno ka gin me awura magi bino giko timere?” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
            "verseOrgIds": [
              "DAN.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.10.5"
              },
              "items": [
                {
                  "text": "Nyut 10.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.14"
              },
              "items": [
                {
                  "text": "12.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dano ame onwoŋo oruko boŋo camanini ame onwoŋo tye malo i wi pii i kulo-nono, te tiŋo ciŋe ryoryo luŋ malo i polo, an ate winyo en ka tye ka kwoŋ, kun kwoŋo i nyiŋ ŋat ame bedo kwo nakanaka, ni mannono ginnono bino perakino pi mwakki adek kede nucu; dok ka kare me turo teko a jo acil doŋ otum, jami magi luŋ doŋ te cobe re luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.7",
            "verseOrgIds": [
              "DAN.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awinyo gin ame en okobo cite mom aniaŋ iye, Mannono omio ate penyo ni, “Adwoŋŋa, agikki me jami magi luŋ bino bedo niŋo ba?” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.8",
            "verseOrgIds": [
              "DAN.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "En te gamo ni, “Yin medde kede woti Danieri, pien koppere pwod owumo oko, omwono oko tuno ka kare me agikki oromo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.9",
            "verseOrgIds": [
              "DAN.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.11"
              },
              "items": [
                {
                  "text": "Nyut 22.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jo apol meicel bino lonyere, obino doko atar, kun olony odoco. Cite jo areco bino medde timo gin arac, kun ŋattoro i akina jo areco mom tye ame niaŋ iye, cite jo aryek bino niaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.10",
            "verseOrgIds": [
              "DAN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.27"
              },
              "items": [
                {
                  "text": "Dan. 9.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.31"
              },
              "items": [
                {
                  "text": "11.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.15"
              },
              "items": [
                {
                  "text": "Mat. 24.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.14"
              },
              "items": [
                {
                  "text": "Mar. 13.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Don cakere i kare ame okwanyo iye mot awaŋa me nino i nino, eka ote keto iye ginnoro me kwer ame balo cuny jo, bino tero kare me nino tutumia acel kede mia aryo i pyeraboŋwen. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tye kede winyo ŋat ame kuro eka te tuno i nino tutumia acel, kede mia adek kede pyeradek wie abic. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aman yin giri medde kede wotti tuno ka nino me agikki oromo. Ibino nwoŋo weo, ibino cuŋ i kabedoni ame opokki kare me agikki.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.13",
            "verseOrgIds": [
              "DAN.12.13"
            ]
          }
        }
      ]
    }
  ],
