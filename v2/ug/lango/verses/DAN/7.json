                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.27"
              },
              "items": [
                {
                  "text": "Luk. 21.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Nyut 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.14"
              },
              "items": [
                {
                  "text": "14.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kare ame atye ka neno anyuttono, i dyeworrono, aneno anyuttogo acalo magi:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.13",
            "verseOrgIds": [
              "DAN.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.14",
            "verseOrgIds": [
              "DAN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aco an Danieri cunya onwoŋo oballe doŋ oko pi lek ame obino i wianono. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.15",
            "verseOrgIds": [
              "DAN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "An ate wot baŋ dano moro acel ame onwoŋo tye i akina jo ame tye kuno, me en niaŋa kop me ateni i kom lek man, En te titta, omia aŋeo kop me lek ame aleko luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.16",
            "verseOrgIds": [
              "DAN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leyi aŋwen adoŋo obedo obakki aŋwen ame bino loc i lobo, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.17",
            "verseOrgIds": [
              "DAN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.5"
              },
              "items": [
                {
                  "text": "Nyut 22.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento jo acil ame obedo jo a Ŋat Amalo Meicel en ame bino gamo loccono, loccono te bedo meggi waŋ i waŋ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Dok ate mito ni myero aŋe kop i kom lee aŋwen ame onwoŋo pat apata i leyi ocele-ca, ame onwoŋo iyiliyili meicel, kun tye i lake me nyonyo kede lwete luŋ me mola; ame omwodo rujo leyi, kun tuturo cogogi oko atitino, te nyono en odoŋŋere oko i tyene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.19",
            "verseOrgIds": [
              "DAN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok ate mito ŋeyo daŋ kop i kom tuŋ apar ame onwoŋo tye i wi lee-naca kede dok tuŋe ocele ame te dok donnyo iceni ame te miyo tuŋ adek me agege-ca mukere oko, tuŋe ame onwoŋo tye iye waŋŋogo kede doge ame te kobo koppogo adoŋodoŋo, dok ame onwoŋo nen calo dwoŋ kato owote mere oko ca. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.20",
            "verseOrgIds": [
              "DAN.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.7"
              },
              "items": [
                {
                  "text": "Nyut 13.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kare ame onwoŋo pwod atye aneno, tuŋe-nono te cako lweny i jo acil, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.21",
            "verseOrgIds": [
              "DAN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.4"
              },
              "items": [
                {
                  "text": "Nyut 20.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te daŋ loyogi oko, tuno waŋ ame ŋat operakino meicel-ca obino, en omio ote doŋ ŋolo kop a jo acil, ame gin obedo jo a ŋat Amalo Meicel, kare te romo, eka jo acil te doŋ gamo loc.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
            "verseOrgIds": [
              "DAN.7.22"
            ]
          }
        }
      ]
    },
