              "type": "text"
            }
          ]
        },
        {
          "text": "Dok ka Moab obedo ol nono me bedo wot i kabedo me woro jogi ame tye i wi kiddi malo, kun woto ka kwayo Obaŋa mere i kabedo mere acil, en mom bino twero kadi acel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.12",
            "verseOrgIds": [
              "ISA.16.12"
            ]
          }
        }
      ]
