              "items": [
                {
                  "text": "2 Tek. 36.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dok ikwai mogo, obino royo oko, ote terogi wot tic i paco abaka me Babulon.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        }
      ]
