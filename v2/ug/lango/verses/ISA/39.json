        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaka Kejekia te niaŋ ni kuc bino bedo tye i kare mere aboŋo alokaloka moro, omio en te kobbi Icaya ni, “Kop a Rwot ame ikobo-nono gire ber.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
