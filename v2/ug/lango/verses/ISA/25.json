              "items": [
                {
                  "text": "21.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot Obaŋa bino mwonyo to oko atwal, dok Rwot Obaŋa bino weyo pig waŋ jo ducu, te kwanyo lewic i wi jo mere oko i nyim jo luŋ i wi lobo; pien Rwot okobo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
