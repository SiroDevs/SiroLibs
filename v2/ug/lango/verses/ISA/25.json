                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien ciŋ Rwot bino we i wi kidi me Cion, aco Moab obino nyono piny i kabedo mere, kite ame dok nyono kede reŋ kal i bur opwoc. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Moab bino ryeyo badgi iye kite ame lo a kwan ryeo kede bade me kwan; ento Rwot bino miyo awaka mere gik oko karacel kede dito me ciŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apama celgi ame ogero ocuŋ iguŋ malo-nu obino miyo dok oko piny, ote coro reto piny i lobo, naka iyi apua.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.12",
            "verseOrgIds": [
              "ISA.25.12"
            ]
          }
        }
