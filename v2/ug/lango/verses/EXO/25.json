              "items": [
                {
                  "text": "Eb. 8.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nen aber ni itio luŋ kun ilubo kit ame anyutti kede i wi kidi ca.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.40",
            "verseOrgIds": [
              "EXO.25.40"
            ]
          }
        }
      ]
    }
