                  "text": "Lodo 24.10-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka ce awotti ojeŋo boŋo mere baŋi, myero idwokke oko ame ceŋ mom ru opoto; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        },
        {
