              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Itinoni me kao awobe ibino miyogi baŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
