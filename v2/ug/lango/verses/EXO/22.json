          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twonni kede romini daŋ ibino timo kittono. Gin bino bedo baŋ totogi pi nino kany wie aryo, cite i nino me aboro ibino miyogi baŋa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
