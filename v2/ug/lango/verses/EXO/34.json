                }
              ]
            }
          ]
        },
        {
          "text": "“Ibino tiyo tic meri pi nino abicel, ento i nino me abiro mere ibino weo iye; ibino wunu weo kadi i kare me pur onyo i kare me kac. ",
          "type": "text",
          "attrs": {
