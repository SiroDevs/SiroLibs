              "items": [
                {
                  "text": "27.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Kur iti obaŋa moro me nyonyo ame itwako piri keni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.17",
