              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot te kobbi Muca ni, “Tin doŋ ibino neno gin ame abino timo i kom Parao; ciŋ atek bino miyo en wekogi owoto oko, kun ryemogi aryema i lobo mere.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
