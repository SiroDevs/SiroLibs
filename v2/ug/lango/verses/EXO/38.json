          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mola ame omio onwoŋo oromo talanta pyerabiro kede cekel tutumia aryo kede mia aŋwen. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
