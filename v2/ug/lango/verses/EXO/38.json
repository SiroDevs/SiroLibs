          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mannono otio kede acib pagi me doggola kema me rwatte, kede keno lam me mola, kede keikei me mola, kede jami luŋ me tic i keno lam, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.30",
