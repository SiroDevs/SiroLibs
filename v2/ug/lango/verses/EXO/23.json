              "EXO.23.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.26"
              },
              "items": [
                {
                  "text": "Yaa 34.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.21"
              },
              "items": [
                {
                  "text": "Lodo 14.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.2"
              },
              "items": [
                {
                  "text": "26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Cam me wi mwaka ogeo cek abeco i potoni, myero ikel i ot a Rwot Obaŋani. Kur ited riŋo atin dyel kede cak a tottere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nen, abino cwalo amalaika i nyimi me gwoki iyo, dok me teli teri naka i kabedo ame rik ayiko piri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.20",
            "verseOrgIds": [
              "EXO.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myero iwore, iwinye, kur daŋ ipyem kede, pien mom bino timmi kica ka ijem. Twerra luŋ tye i ciŋe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.21",
            "verseOrgIds": [
              "EXO.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.21",
            "verseOrgIds": [
              "EXO.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cite ka ibino winye kede cunyi luŋ, kun itio gin ame en okobbi luŋ, abino bedo akwor okworri dok abino dago jo a dagi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.22",
            "verseOrgIds": [
              "EXO.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalaika bino telo nyimi kun teri baŋ jo Amor, jo Kitti, jo Periji, jo Kanaan, jo Kivi, kede jo Jebuc; eka ate jwerogi oko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.23",
            "verseOrgIds": [
              "EXO.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur iryebere wunu piny i nyim obaŋegi, kur iworgi wunu, kur iti wunu bala gin, ento ibino wunu turo wunugi oko kun imumuko wunu gweŋegi ame ocucuna me awora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.24",
            "verseOrgIds": [
              "EXO.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibino woro wunu Rwot Obaŋawu, cite en bino miyowu winyo, ite nwoŋo wunu cam abup kede pii. Abino miyo two moro bedo mom i akinawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.25",
            "verseOrgIds": [
              "EXO.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee moro mom bino bwogo dok dako moro daŋ mom bino bedo oraŋa i lobowu. Abino miyo kwo meri cobere aber kakare. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.26",
            "verseOrgIds": [
              "EXO.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abino miyo jo i nyimi luŋ bedo lwor, dok daŋ abino babano jo luŋ ame bino rwatte kedi. Abino miyo okworri luŋ riŋo oko i nyimi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.27",
            "verseOrgIds": [
              "EXO.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abino miyo pipino ager corre i nyimi te ryemo jo Kitti, jo Kanaan, jo Kivi oko i nyimi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.28",
            "verseOrgIds": [
              "EXO.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mom abino ryemogi luŋ i nyimi i mwaka acel keken, mio lobo doŋ oko nono, eka leyi me tim tte nya, medde, te yelowu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.29",
            "verseOrgIds": [
              "EXO.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abino ryemogi momot, tuno wan ame yin inya iromo lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.30",
            "verseOrgIds": [
              "EXO.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wan loboni bino ya i Nam Arema tuno naka i Nam a jo Piriciti, cakere i tim naka i kulo Efurate. Abino daŋ miyo wegi lobonono i ciŋwu, yin ibino ryemogi oko i nyimi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.31",
            "verseOrgIds": [
              "EXO.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myero kur icikere kedgi, kadi baŋ obaŋegi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.32",
            "verseOrgIds": [
              "EXO.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok gin myero kur bed i loboni, bino miyo yin itimo bal baŋa. Pien woro obaŋagi bino doko kumma me cikowu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.33",
            "verseOrgIds": [
              "EXO.23.33"
            ]
          }
        }
      ]
    }
  ],
