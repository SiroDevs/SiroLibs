            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ce icop i kom twon onyo kana akworri ame orwenyo, myero idwok baŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce ineno kana a lon adagi obuto piny ame yec obwoo kur iweke amannono, myero ikonye me ya malo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
    },
