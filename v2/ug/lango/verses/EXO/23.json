              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibino puro potoni pi mwakki abicel kun ikaa gin ocek iye, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "cite i mwaka me abiro mere, ibino weko potoni we kun mom opuro. Ginnoro luŋ ame bino cek i potoni i mwaka-nono bino bedo me ocan ame tye i akina joni, eka en adoŋŋere te bedo mea leyi me tim. Cik acellono en ame daŋ ibino lubo pi poto olokki kede poto jeituni meri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
