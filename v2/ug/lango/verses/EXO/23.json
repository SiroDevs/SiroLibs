                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Kur iwun arokkoro ame bedo i akinawu; yin iŋeo aber kite me bedo arok, pien yin daŋ rik kon ibedo arok i Miciri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
