          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te dok tiyo arii bao me dyere ame ya i agikki tuŋ cel tuno i agikki tuŋ ocele, kun ŋolle i kor arii bao ame ocuŋ atira, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.33",
            "verseOrgIds": [
              "EXO.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
