          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede arii bayi abic pi bayi me kema tuŋ ocele, kede dok arii bao abic me kema tuŋ neye, ame tye tuŋ to. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.32",
            "verseOrgIds": [
              "EXO.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
