          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok ote tiyo cuka boŋo me geŋo dog kema kun otio i cuka ame uci mere bululu bululu, amaramar kede arema, dok uci cukanono daŋ owio abeco, ote daŋ deyo aber meicel. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
        {
          "name": "verse",
