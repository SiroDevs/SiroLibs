              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok ote daŋ tiyo arii me bao abic pi bayi me kema tuŋ cel, kun otio kede okuto alwi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
            "verseOrgIds": [
              "EXO.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
