          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ote mwono kom bao kema tuŋ cel oko kede jabu, ote dok tiyo atem me jabu me rwako bao iye. Arii me bao daŋ omwono komgi oko i jabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
