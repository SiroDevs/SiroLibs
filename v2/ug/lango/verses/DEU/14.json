                }
              ]
            }
          ]
        },
        {
          "text": "“Wun ibedo wunu itino a Rwot Obaŋawu, myero kur iŋoŋolo wunu komwu, kur daŋ ilyel wunu yer me tur nyimwu pi kwero cola a jo oto, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
