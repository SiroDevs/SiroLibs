              },
              "items": [
                {
                  "text": "34.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mom ibino wunu camo ginnoro ame oto kene; itwero miyo wunu arokkoro ame bedo i bomawu me en cam; onyo itwero cato wunu baŋ welo moro; pien wun ibedo wunu jo acil baŋ Rwot Obaŋawu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kur ited wunu riŋo atin dyel kede cak a tottere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
