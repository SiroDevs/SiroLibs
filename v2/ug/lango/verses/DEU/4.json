                  "text": "1 Pet. 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ento Rwot rik oyerowu te kwanyowu oko i Miciri, ame rik cal i ot alyet ame oteto iye nyonyo, me ibed wunu jo mere ikome, kite ame itye wunu kede i kare man. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.20",
            "verseOrgIds": [
              "DEU.4.20"
            ]
          }
        },
        {
