              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.40",
            "verseOrgIds": [
              "DEU.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.41",
            "verseOrgIds": [
              "DEU.4.41"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.20.8+JOS.20.9"
              },
              "items": [
                {
                  "text": "Yoc. 20.8-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare-nono Muca te poko boma adek i yo tutuŋ kide, loka Jordan, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.41",
            "verseOrgIds": [
              "DEU.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "me wek ŋat oneko nek riŋ lar kuno; me wek ŋat a mom oneko awottere me akaka, kun onwoŋo amone moro gire mom i akinagi i kare okato, wek ka en oriŋo i boma moro i akinamagi, en bino laro kwo mere: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.42",
            "verseOrgIds": [
              "DEU.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin boma-nogo rik obedo Bejer ame tye i tim, i lobo opette, pi jo Reuben, Ramot i Gilead pi jo Gad, kede Golan i Bacan pi jo Manace.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.43",
            "verseOrgIds": [
              "DEU.4.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.43",
            "verseOrgIds": [
              "DEU.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en cik ame rik Muca oketo i nyim jo Icrael. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.44",
            "verseOrgIds": [
              "DEU.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi gin kop me caden, icwil, kede kop ame rik ociko ducu, ame Muca okobo baŋ jo Icrael i kare a doŋ gin oya oko i Miciri, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.45",
            "verseOrgIds": [
              "DEU.4.45"
            ]
          }
        },
        {
          "name": "verse",
