              "items": [
                {
                  "text": "Lodo 27.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ilobowu ame ibino leyo wunu, ame Rwot Obaŋawu amiyowu me bedo megwu, mom ibino wunu kobo waŋ kiŋa ame opoko lobo awotti, ame yam odoŋe otyeko poko oko.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
