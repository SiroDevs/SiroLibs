              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ce lo moro orwatte kede nyannoro a mom ru oŋeye kede ico, a mom ru daŋ ocako nyomo, eka en te mako buto kede, ote daŋ nwoŋogi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
