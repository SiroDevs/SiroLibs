          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 10:10"
          },
          "items": [
