              "items": [
                {
                  "text": "5.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ŋat ame bino tiyo cal jokkoro ame opao apaa onyo ame otwako atwaka, ame gin obedo gin me kwer baŋ Rwot, gin ame adiro otio kede ciŋe, te keto me awora, cen myero mak oko! Lwak luŋ bino gamo ni, ‘Amen.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
      ]
