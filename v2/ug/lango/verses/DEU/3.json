                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.48+DEU.32.49+DEU.32.50+DEU.32.51+DEU.32.52"
              },
              "items": [
                {
                  "text": "Lodo 32.48-52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“I kare-naca rik abin abako doga baŋ Rwot kun akobo ni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Rwot Obaŋawa, nen yin pwod icako nyuto ditti kede twer me ciŋi acaka baŋ amironi. Mom tye Obaŋa moro i polo onyo i lobo ame twero tiyo tic apek meicel acalo magi! ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tima kica iwek awot loka awot anen lobo ame tye loka Jordan, lobo obedo kidikidi aber wok ca, karacel kede Lebanon.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento rik akemo te mako Rwot i koma pirwu, mom te ye winyo koppa. Rwot te kobba ni ‘Mano doŋ romo; kur imed kobo koppono baŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
