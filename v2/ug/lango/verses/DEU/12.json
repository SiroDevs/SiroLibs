              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka Rwotbino tyeko rok i nyimwu ame iwot wunu leyo lobogi, ka doŋ iryemo wunugi oko, ite bedo wunu i lobogi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "myero igwokere wunu, kur imak wunu i kumma, ilub wunu kitegi. Ka doŋ otyekogi oko, kur ipeny wunu kopporo i kom obaŋegi ni, ‘Jo-ni kara woro obaŋegi niŋo, me an daŋ awor kite ame gin woro kede?’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.30",
            "verseOrgIds": [
              "DEU.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur iwor wunu Rwot Obaŋawuiiyore ame gin woro kede megi; pien ginnoro luŋ me kwer ame Rwot dag, gin otimo baŋ obaŋegi. Gin waŋo anaka itinogi awobe kede anyira i mac me yalo obaŋegi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
      ]
    },
