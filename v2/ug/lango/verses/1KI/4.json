            "sid": "1KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat acel acel i akinagi daŋ rik mio cayiri kede reŋ kal ame omito me acama aguragura kan ame omito iye, kede pi aguragura ocele ame otio kedgi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 4:28"
          },
          "items": [
