                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.25.1"
              },
              "items": [
                {
                  "text": "25.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.1.1"
              },
              "items": [
                {
                  "text": "Wer 1.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "En obedo ŋat acel ame ocako carokop ame romo tutumia adek kede wer ame kato tutumia acel oko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "En okobo kop i kom yen, kun cako i kom yat cedar ame tye i Lebanon tuno kede i kom ogudo ame tu doŋo i kor apama; okobo daŋ kop i kom leyi me tim, kede i kom winy, kede i kom gin ame lak alaka, naka i kom rec-gu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obakki me rok apapat me wi podo luŋ owinyo pi ryeko a Culeman, ote cwayo jo me wot winyo kop i kom ryeko mere.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
              "1KI.4.34"
            ]
          }
        }
