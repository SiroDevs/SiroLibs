              "1KI.4.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.26"
              },
              "items": [
                {
                  "text": "1 Obak. 10.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.14"
              },
              "items": [
                {
                  "text": "2 Tek. 1.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.25"
              },
              "items": [
                {
                  "text": "9.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Culeman rik onwoŋo tye aguragura tutumia pyeraŋwen iyi awi mere pi gadigadi mere, kede cirikale ame riŋo aguragura tutumia apar wie aryo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.26",
            "verseOrgIds": [
              "1KI.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabuna mere apar wie aryo ame rik onwoŋo loo lobo apapat me Icrael obedo miyo cam baŋe, kun ŋat acel acel miyo kit cam luŋ ame omito aboŋo rem, dok mio i dwe mere ame opoke. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.27",
            "verseOrgIds": [
              "1KI.4.27"
            ]
          }
        },
        {
          "name": "verse",
