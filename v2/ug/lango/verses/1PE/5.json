                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lwak oye Kricito a tye Babulon, ame Obaŋa oyerogi karacel kedwu, omotowu, karacel kede woda Marako. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motte wunu kenwu kenwu kede amot me mar. Kuc obed baŋwu ducu ame itye wunu i Kricito.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
          }
        }
