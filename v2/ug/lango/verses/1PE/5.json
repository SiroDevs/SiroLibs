                  "text": "40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acoyiwu waraga man anok kede ciŋ Silvano, ame aŋeo ni ominwa ame genne, pi cuko cunywu kun akobo acalo caden ni, man en winyo Obaŋa me ateni; Cuŋ wunu iye atek. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        },
