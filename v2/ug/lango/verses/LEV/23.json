          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Magi gin ecuban ame Rwot ociko, gin cokere acil ame ibino wunu rabo pirgi i kare ame Rwot ociko. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        },
