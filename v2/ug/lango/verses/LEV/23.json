            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Lodo 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibino wunu tiyo ticwu pi nino abicel, ento i nino me abiro mere en cabit me weo mot, en nino me cokere acil. Mom ibino wunu tiyo ticcoro; mano en cabit a Rwot kan ame ibino wunu bedo iye luŋ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        }
      ]
    },
