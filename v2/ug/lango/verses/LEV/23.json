              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot okobbi Muca ni, “Kob baŋ jo Icrael ni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.23",
            "verseOrgIds": [
              "LEV.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "I dwe me abiro, nino dwe acel, ibino kwero wunu iye nino me weo mot, nino me po ame ibino wunu rabo pire i koko opel, nino me cokere acil. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.24",
            "verseOrgIds": [
              "LEV.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mom ibino wunu gudo ticcoro atek, dok ibino miyo wunu iye mot ame owaŋo i mac baŋ Rwot.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.25",
            "verseOrgIds": [
              "LEV.23.25"
            ]
          }
        }
      ]
    },
    {
