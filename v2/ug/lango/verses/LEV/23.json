        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
