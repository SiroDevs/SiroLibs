          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ce del kom ico onyo dako ococola atatar, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
            "verseOrgIds": [
              "LEV.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "alamdog bino ŋiyo kom dano-nono. Ka en onwoŋo ni del kome ococola-nono mom tar wok, mano nwoŋo del kome gire odugo aduga; en mom ŋat a cik ogeŋo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
