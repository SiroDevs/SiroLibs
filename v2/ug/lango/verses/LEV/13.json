          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "alamdog myero mi lwok gin a two tye iye-nono, en dok te cego i ot pi nino ocele abiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
