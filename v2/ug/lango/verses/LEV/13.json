          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ce two dobo onen i boŋo moro ame oruko, kadi bed boŋo yer romo onyo boŋo camanini, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "i kom uci oryeye atira tira onyo i kom uci oryeye aria ria me boŋo camanini onyo me yer romo, onyo i kom lao, onyo i kom ginnoro ame otio i lao, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka two-nono nen calo tworo tworo onyo i remarema i kom rukkoro onyo i kom uci oryeye atira tira onyo aria ria, onyo i kom lao, onyo i kom ginnoro ame otio i lao, mano nwoŋo two dobo, myero nyut baŋ alamdog. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alamdog bino ŋiyo two-nono eka te cego gin a two tye iye-nono i ot pi nino abiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nino me abiro mere en bino dok ŋiyo two-nono. Ka onwoŋo two omedde nya i rukkono i kom uci atira onyo i kom uci ariye aria, onyo lao me tiyo ticcoro keken, two-nono nwoŋo obedo dobo ame ŋoŋolo jami, ginnono obedo gin a cik ogeŋo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alamdog bino waŋo rukkono oko, kadi bed two tye i kom uci atira mere onyo i kom uci oriye aria i boŋo yer romo onyo i boŋo camanini, onyo i kom ginnoro ame otio i lao; pien mano two dobo ame ŋoŋolo jami; obino waŋo i mac.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
