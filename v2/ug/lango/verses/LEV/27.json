            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ento gin ame dano ojalo baŋ Rwot i kom ginnoro ame tye baŋe, kadi dano onyo lee onyo poto ame oleo i baŋ kwari mere, mom ibino cato, dok daŋ mom obino lakoro; ginnoro luŋ ame ojalo baŋ Rwot nwoŋo en gin acil meicel baŋ Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋattoro ame ojalo baŋ Rwot me aneka, mom dok obino lakoro, obino neko gire aneka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
    },
