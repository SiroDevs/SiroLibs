          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "En bino wawaro dwollege luŋ kite ame owawaro kede dwol i mot aŋola me kweyo cuny; alamdog te waŋo i wi keno lam me bed gin a ŋwece kur a yomoro cuny RWOT; alamdog bino tiyo tic me kwanyo bal i kome, Rwot daŋ bino weko ballere.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
