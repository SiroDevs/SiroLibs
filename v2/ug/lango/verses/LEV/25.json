              "items": [
                {
                  "text": "Lodo 15.7-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ce ominni moro i laŋeti odoko acan ame mom romo konyere kene, yin ibino konye; en bino bedo baŋi acalo welo onyoarok ame bedo i akinawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
            "verseOrgIds": [
              "LEV.25.35"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
            "verseOrgIds": [
              "LEV.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mom ibino gamo magoba moro i baŋe, dok daŋ mom ibino medo wi baŋya mere, ento myero ilwor Obaŋani, me ominni bed kwo i laŋeti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.25"
              },
              "items": [
                {
                  "text": "Yaa 22.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19+DEU.23.20"
              },
              "items": [
                {
                  "text": "Lodo 23.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mom ibino miyo en koporo limmoro i baŋi pi mito nwoŋo magoba, kur daŋ imie cam kun imito ni en dwoggo kun nwoŋo koŋ omedo moro iye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "An a Rwot Obaŋawu ame rik akwanyowu i lobo me Miciri me wek amiwu lobo me Kanaan, an ate bedo Obaŋawu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
    },
    {
