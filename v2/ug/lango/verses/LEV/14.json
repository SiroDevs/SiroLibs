          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en cik a mako kit two dobo luŋ; two akukuc, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 14:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "two dobo me ruk onyo me ot, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55",
            "verseOrgIds": [
              "LEV.14.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 14:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "onyo me kan okwot, onyo odugo, onyo del kom ococola, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
            "verseOrgIds": [
              "LEV.14.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
