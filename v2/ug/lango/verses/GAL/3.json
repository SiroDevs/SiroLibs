                "loc": "GEN.15.6"
              },
              "items": [
                {
                  "text": "Age. 15.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.3"
              },
              "items": [
                {
                  "text": "Rom. 4.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amannono rik ocoo ni, Iburaim “Oye Obaŋa, eka ote kwane ni kite atir.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.6",
            "verseOrgIds": [
              "GAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.16"
              },
              "items": [
                {
                  "text": "Rom. 4.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Doŋ myero iŋe wunu nijo ame ojeŋere i kom iyee, jo-nono gin ikwae Iburaim.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.7",
            "verseOrgIds": [
              "GAL.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
