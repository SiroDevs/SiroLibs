          "type": "text",
          "attrs": {
            "verseId": "GAL.3.5",
            "verseOrgIds": [
              "GAL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 3:6"
