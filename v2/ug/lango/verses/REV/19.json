              "type": "text"
            }
          ]
        },
        {
          "text": "Icennere i ne man ate winyo woo adwoŋ acalo bala dwon lwak jo apipim i polo ame okobo ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
