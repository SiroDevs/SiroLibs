                "loc": "ZEC.2.1+ZEC.2.2"
              },
              "items": [
                {
                  "text": "Jek. 2.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eka ote miya ogada me pimo kede, acalo abiro, ote kobba ni, “Ya iwot ipim ot Obaŋa, kede keno me lam, kede jo a woro Obaŋa i ode. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.1",
            "verseOrgIds": [
              "REV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.24"
              },
              "items": [
                {
                  "text": "Luk. 21.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento pe ipim dyekal me ot Obaŋa a tye oko, wek mano bedi, pien doŋ otyeko miyo oko baŋ jo a mom ŋeo Obaŋa, gin bino nyono boma acil pi dwete pyeraŋwen wie aryo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.2",
            "verseOrgIds": [
              "REV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok abino miyo ocadenna aryo twer me rabo koppa acalo odwarpiny pi nino tutumia acel i mia aryo kede pyerabicel nono, kun gin orukere i boŋo cola.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        }
      ]
    },
    {
