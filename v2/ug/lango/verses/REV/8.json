              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalaika me adek te kuto apellere, eka twon acerroro te mukere i polo, a kun ameny bala mac rao, te poto wumo acel me adek me kulli, kede pii akoŋ luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
