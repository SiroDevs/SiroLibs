          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka omalaika abiro, ame tye i apel abiro ca, te yikere me kuto doŋ oko. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.9.23+EXO.9.24+EXO.9.25"
              },
              "items": [
                {
                  "text": "Yaa 9.23-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.22"
              },
              "items": [
                {
                  "text": "Ejek. 38.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amalaika me agege te kuto apellere, eka pee kede mac te corre piny i lobo, kun orubere i remo. Dul lobo a romo acel me adek rik te waŋ oko, kede dul yen daŋ ame romo acel me adek, kede lum adyaka luŋ te wan oko.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        }
      ]
    },
