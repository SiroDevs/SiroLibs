          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok aneno, eka ate winyo cur ame olikino malo i dye yamo kun kok i dwon aloŋo ni, “Can, can, can, ibino wunu neno can, wun jo a bedo i lobo, pi dwon apel adek a pwod odoŋ, ame omalaika bino kuto!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
