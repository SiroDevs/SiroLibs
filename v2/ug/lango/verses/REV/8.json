          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.15"
              },
              "items": [
                {
                  "text": "Jer. 9.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyiŋ acerrono, Adil toŋ. Dul acel me adek me pii te lokere doko adil toŋ, pii-nono te neko jo apol, pien onwoŋo odoko akec.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
