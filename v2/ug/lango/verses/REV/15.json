            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icennere ate neno ot Obaŋa, ame en kema me caden a tye i polo, oyabere oko, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "eka omalaika abiro te donnyo iyi kabedo acil kun okelo pwodo abiro. Gin orukere i boŋŋi camanini acil ityaŋ, kun daŋ otweo korgi kede del jabu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee acel i akina leyi akwo aŋwen te miyo baŋ omalaika abiro tabbi abiro me jabu ame akemo Obaŋa ame perakino waŋ i waŋ opoŋ i yigi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
