            "number": "1",
            "style": "v",
            "sid": "REV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ate neno gin ame nen bala nam me aryeny acil ame orubo iye mac, kede dok jo a rik oloo lee ca kede callere, kede namba me nyine; gin onwoŋo ocuŋ i ŋet nam me araŋ, kun omako tum Obaŋa i ciŋgi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.2",
            "verseOrgIds": [
              "REV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.1"
              },
              "items": [
                {
                  "text": "Yaa 15.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin onwoŋo otye a wero wer a Muca amiro Obaŋa, kede wer Atin romo, ame kobo ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
