              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.26+EZK.1.27+EZK.1.28"
              },
              "items": [
                {
                  "text": "Ejek. 1.26-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.1"
              },
              "items": [
                {
                  "text": "10.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cucuttono Cuny Acil oyuto tamma oko, ate neno kom me loc ame ocibo i polo, kun ŋattoro obedo iye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat ame obedo iye-naca lilia, bala jacipa kede kamelio, kun etaloka a calli emeradi omano kom loccere. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka kome me loc ocele pyeraryo wie aŋwen te guro kom loccaca, kun odoŋe pyeraryo wie aŋwen obedo i wigi, ame orukere i boŋŋi atar, kede tok jabu me kwogo tye i wigi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
