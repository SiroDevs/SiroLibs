              },
              "items": [
                {
                  "text": "Jek. 4.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Doŋ i kom me loccaca ya iye gin a memenya bala kot, dok dwon winyere iye, kede mwomwoca bala me kot. I nyim kom loc, mac rao abiro tye alyel iye, ame gin cuny Obaŋa abiro. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
