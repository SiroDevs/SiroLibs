            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.18"
              },
              "items": [
                {
                  "text": "Ejek. 1.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.12"
              },
              "items": [
                {
                  "text": "10.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.2+ISA.6.3"
              },
              "items": [
                {
                  "text": "Ica. 6.2-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Leyi aŋwen akwo-ni, acel acel i akinagi tye kede bwome abicel abicel, waŋgi omoo atata, omano komgi luŋ i oko kede i yie. Icen kede iwor gin mom oweko wer ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
      ]
