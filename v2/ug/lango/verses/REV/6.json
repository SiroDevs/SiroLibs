              "items": [
                {
                  "text": "Luk. 21.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aneno ka oyabo kan omwono me abicellere, eka oyeŋo te yeŋere atek meicel, ceŋ te cido acol icuc bala boŋo cola, dwe luŋ daŋ te lokere doko bala remo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.4"
              },
              "items": [
                {
                  "text": "Ica. 34.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acer me polo te rutte piny bala olam ame oony oko i yattere ka yamo atek oyeŋo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.20"
              },
              "items": [
                {
                  "text": "Nyut 16.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Polo daŋ te rwenyo oko bala papara ame odolo, anaka kiddi kede icula nam luŋ ote kobo oko i kakargi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.19"
              },
              "items": [
                {
                  "text": "Ica. 2.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eka oloc me lobo, kede jo a pirgi dito, kede odoŋe me mony, olonyo kede wegi twer, kede jo luŋ aluŋa, opii kede jo a loye kengi, ote pono i gorogoro, kede i akina lela i wi kiddi, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
          }
        },
