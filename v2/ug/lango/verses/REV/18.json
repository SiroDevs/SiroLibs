        {
          "text": "Obakki me lobo ame rik otimo kede tim me coco, kede ame olubo kite mere me caro caro obino koke kun okuko i kome ka gin oneno tye awan kun yito mere aduny. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
