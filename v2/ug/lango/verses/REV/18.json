                  "text": "Ejek. 27.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te wo ka gin oneno tye awan kun yito mere aduny, kun okobo ni, “Boma me ne a rik cal i boma man adwoŋ-ŋi?”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.18",
