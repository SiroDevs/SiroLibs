              "items": [
                {
                  "text": "Nyut 4.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kop man oya i baŋ Lakana kun cwalli lwak jo oye Kricito i kabedo abiro apapat a tye i Acia.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        }
