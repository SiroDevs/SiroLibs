                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "tyene te cal i mola ame olio i keno, eka ote rudo acil, kun dwone mor winyere bala acucur pii. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
