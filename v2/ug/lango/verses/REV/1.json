              "items": [
                {
                  "text": "10.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yer wie tar bala yer romo, onyo ba pee, eka waŋe te cal i leb mac, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
