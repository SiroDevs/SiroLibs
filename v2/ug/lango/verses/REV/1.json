                "loc": "ISA.55.4"
              },
              "items": [
                {
                  "text": "Ica. 55.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.27"
              },
              "items": [
                {
                  "text": "Jab. 89.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kede a ya daŋ i baŋ Yecu Kricito, acaden a genne, atin kao i akina jo oto, kede aloc obakki me wi lobo luŋ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
