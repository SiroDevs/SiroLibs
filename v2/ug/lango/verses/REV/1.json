            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Nyut 5.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eka te lokowa doko lwak ame en aloo, kun obedo olamdog ame tiyi Obaŋa mere ame en Pappere daŋ. Kwogo kede twer obed baŋe nakanaka. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        }
