              "items": [
                {
                  "text": "Dan. 7.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.5"
              },
              "items": [
                {
                  "text": "10.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eka i dyere me gi-cibo tara abiro-ni, aneno ŋattoro ame cal i wot a dano. Orukere kede jor abor, kede del me Jabu ame omano kore. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
