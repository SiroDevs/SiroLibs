                "loc": "ISA.29.11"
              },
              "items": [
                {
                  "text": "Ica. 29.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rik dok ate neno buk adola i ciŋ tuŋ cem a ŋat ame obedo i kom Ocoo yie kede yo ŋee daŋ, dok omwono odoco i kabedo abiro twal. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok ate neno amalaika moro atek meicel kun alemo i dwon aloŋo ni, “Ŋa kara a myero me yabo buk, kede me turo gin omwono kede?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.2",
            "verseOrgIds": [
              "REV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋattoro gire mom te nen i wi polo, kadi i wi lobo, kadi piny i te lobo ame romo yabo buk, onyo ame romo ŋiyo yie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.3",
            "verseOrgIds": [
              "REV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rik ate kok meicel pien ŋattoro mom onwoŋere ame myero me yabo buk, onyo me ŋiyo yie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.4",
            "verseOrgIds": [
              "REV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.9"
              },
              "items": [
                {
                  "text": "Age. 49.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.1"
              },
              "items": [
                {
                  "text": "Ica. 11.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ŋattoro i akina odoŋe te kobba ni, “Kur ikoki. Nen ba, Eŋato me i atekere a Juda, Lwit-yat a Daudi, doŋ oloo gire oko, omio en tye i twer me yabo buk, naka elo gin abiro luŋ ame omwono kede.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        }
      ]
    },
    {
