          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leyi akwo aŋwen te gamo ni, “Amen!” eka odoŋe te onyere gigi piny me woro Obaŋa kede Atin romo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.14",
            "verseOrgIds": [
