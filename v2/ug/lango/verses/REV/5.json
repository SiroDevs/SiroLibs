                "loc": "ZEC.4.10"
              },
              "items": [
                {
                  "text": "Jek. 4.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eka dok ate neno Atin romo ame ocuŋ bala oneko oko, kun tye i dyere, i akina leyi aŋwen akwo, kun odoŋe ca ogure dyere. Onwoŋo tye kede tuŋe abiro, kede waŋe daŋ abiro, ame gin cuny Obaŋa abiro, ame en cwalo oko i wi podo luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "En te wot kwanyo buk ame onwoŋo tye i ciŋ tuŋ cem a ŋat obedo i kom loc. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.141.2"
              },
              "items": [
                {
                  "text": "Jab. 141.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kare ame en doŋ okwanyo buk ca, leyi akwo aŋwen, kede odoŋe pyeraryo wie aŋwen, te ony piny i nyim Atin romo, kun ŋat acel acel i akinagi omako tum karacel kede tabbi me jabu ame opoŋ iye odok akur ame aduny, en kwae a jo Obaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.8",
            "verseOrgIds": [
              "REV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.33.3"
              },
              "items": [
                {
                  "text": "Jab. 33.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.98.1"
              },
              "items": [
                {
                  "text": "98.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.10"
              },
              "items": [
                {
                  "text": "Ica. 42.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin owero wer anyen ame kobo ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
