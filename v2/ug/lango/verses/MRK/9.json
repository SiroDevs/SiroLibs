        },
        {
          "text": "Kuno kudi megi mom to, mac daŋ mom gik.] ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.46",
            "verseOrgIds": [
              "MRK.9.46"
            ]
          }
        },
        {
