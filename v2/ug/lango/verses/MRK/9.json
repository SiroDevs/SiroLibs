            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.29"
              },
              "items": [
                {
                  "text": "Mat. 5.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ce ka waŋi en a mii ipoto, kole oko; twara idony i loc Obaŋa ame itye kede waŋi acel keken, kato a kono oboli kede waŋi ryoryo i Geena. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.47",
            "verseOrgIds": [
              "MRK.9.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MRK 9:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
