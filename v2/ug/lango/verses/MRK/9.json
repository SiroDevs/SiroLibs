          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Dano ame bino miyo ŋattoro acel i akina jo-ni atino-ni ame oye an opoto i bal, twara ame otweo kidi rego adwoŋ i ŋute, ote core kede nam. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.42",
            "verseOrgIds": [
