          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pien kado ame bino lonyo dano acel acel en mac. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.49",
            "verseOrgIds": [
              "MRK.9.49"
            ]
          }
        },
