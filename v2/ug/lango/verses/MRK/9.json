              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.32",
            "verseOrgIds": [
              "MRK.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwaŋ otuno i Kapernaum. A doŋ otye i ot, Yecu te penyogi ni, “Kara koppene a woki ipyem wunu iye i waŋa yo?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.33",
            "verseOrgIds": [
              "MRK.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.24"
              },
              "items": [
                {
                  "text": "Luk. 22.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin ote liŋ aliŋa, pien nwaŋ obedo pyem kengi kengi i waŋa yo ni, ŋa i akinagi ame dit loogi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.34",
            "verseOrgIds": [
              "MRK.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
