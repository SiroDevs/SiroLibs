              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.39"
              },
              "items": [
                {
                  "text": "Mat. 10.39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.33"
              },
              "items": [
                {
                  "text": "Luk. 17.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.25"
              },
              "items": [
                {
                  "text": "Lak. 12.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien dano ame mito laro kwo mere, bino rwenyo kwo mere arwenya, ento dano ame rwenyo kwo mere pira kede pi amut aber, bino laro. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.35",
            "verseOrgIds": [
              "MRK.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kara konyo dano kede ŋo ka ocamo lobo luŋ kun kwo mere omao oko? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.36",
            "verseOrgIds": [
              "MRK.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano twero miyo ŋo pi dwoggo kwo mere? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.37",
            "verseOrgIds": [
              "MRK.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano ame lewic bino make pira kede pi koppa, i kare man me cot kede me bal, Wot a dano daŋ lewic bino make i kome i kare a en bino dwogo kede kwogo a Pappere kede me omalaika acil.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.38",
            "verseOrgIds": [
              "MRK.8.38"
            ]
          }
        }
