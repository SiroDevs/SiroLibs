              ]
            }
          ]
        },
        {
          "text": "“Ento i kare-nono, ame can adwoŋ otum oko, bino bedo acalo rik ocoo ni,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
            "verseOrgIds": [
              "MRK.13.24"
            ]
          }
        }
