          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koŋ icik yiti iwiny kop me ryeko meicel, mi tammi bed i kop ame aŋeo ame apwonyi kede, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.17",
            "verseOrgIds": [
              "PRO.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien ibino bedo kede yomcuny ka ce imako a wi mom wil i ye, kun i kare luŋ mom orwenyo i dogi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.18",
            "verseOrgIds": [
              "PRO.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man bino miyo iketo genni i kom Rwot; man en gin omio akobo oko baŋi tin. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.19",
            "verseOrgIds": [
              "PRO.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyeko coyo kop apapat piri, gin pyeradek. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.20",
            "verseOrgIds": [
              "PRO.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koppono tye me miyi ŋeyo gin aber dok a tye ateni, man bino miyo idwoko kop kakare ka ce jo oori.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.21",
            "verseOrgIds": [
              "PRO.22.21"
            ]
          }
        }
      ]
    }
