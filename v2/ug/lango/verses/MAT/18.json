            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.19"
              },
              "items": [
                {
                  "text": "Mat. 16.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.23"
              },
              "items": [
                {
                  "text": "Lak. 20.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ateni akobbiwu ni, ginnoro ducu ame itweo wunu i wi lobo obino tweyo anaka i wi polo, ginnoro ducu ame igonyo wunu i wi lobo obino gonyo daŋ i wi polo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
            "verseOrgIds": [
              "MAT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok daŋ akobbiwu ni, ka jo aryo i akinawu bino ribere i wi lobo i kom ginnoro ame gin okwayo, Pappa a tye i polo bino timmigi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien ka jo aryo onyo adek ocokere karacel i nyiŋa, an daŋ atye kannono i akinagi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.20",
            "verseOrgIds": [
              "MAT.18.20"
            ]
          }
        }
      ]
    },
