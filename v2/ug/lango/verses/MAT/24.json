          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.8",
            "verseOrgIds": [
              "MAT.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.9",
            "verseOrgIds": [
              "MAT.24.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.22"
              },
              "items": [
                {
                  "text": "Mat. 10.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“I kare-nu obino keto erupe i komwu me ite neno wunu can, obino nekowu, jo luŋ bino dagowu pi nyiŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.9",
            "verseOrgIds": [
              "MAT.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok i kare-nono jo apol bino poto, obino keto erupe i komgi kengi kengi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.10",
            "verseOrgIds": [
              "MAT.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odwarpiny ame ogoba bino pello apol, obino rwenyo jo apol. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.11",
            "verseOrgIds": [
              "MAT.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi tim areco ame bino medde bino miyo mar a jo apol kwe oko. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.12",
            "verseOrgIds": [
              "MAT.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.22"
              },
              "items": [
                {
                  "text": "Mat. 10.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento ŋat ame kanyakino ituno i agikki, en bino larre. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.13",
            "verseOrgIds": [
              "MAT.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok amut man aber me loc Obaŋa obino rabo i wi podo luŋ, me te bedo caden baŋ rok ducu; icennere agikki bino tuno.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.14",
            "verseOrgIds": [
              "MAT.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.14",
            "verseOrgIds": [
              "MAT.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.15",
            "verseOrgIds": [
              "MAT.24.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.27"
              },
              "items": [
                {
                  "text": "Dan. 9.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.31"
              },
              "items": [
                {
                  "text": "11.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.11"
              },
              "items": [
                {
                  "text": "12.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Doŋ ka ibino neno wunu ginnoro me kwer ame balo cuny jo, a rik adwarpiny Daniel orabo pire, kun ocuŋ i kabedo acil (dano ame kwano myero niaŋ iye), ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.15",
            "verseOrgIds": [
              "MAT.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "i karenono jo a tye i Judaya myero riŋ oko i wi kiddi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.16",
            "verseOrgIds": [
              "MAT.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.31"
              },
              "items": [
                {
                  "text": "Luk. 17.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dano ame tye i wi ot kur dok yitto piny ni ebino kwanyo jami i ode; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.17",
            "verseOrgIds": [
              "MAT.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kede dano ame tye i poto kur dok cen ni edok omo rukkere. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.18",
            "verseOrgIds": [
              "MAT.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon ayac bino neno can i kare-nono, kede mon ame doto itino! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.19",
            "verseOrgIds": [
              "MAT.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa wunu Obaŋa wek ŋwecwuni kur timere i cwir, onyo i cabit. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.20",
            "verseOrgIds": [
              "MAT.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "Dan. 12.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.14"
              },
              "items": [
                {
                  "text": "Nyut 7.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien i kare-nono bino: bedo can adwoŋ, kite a yam pe ru onen, ya i geyi keto lobo tuno naka tin, daŋ pe dok bino nen. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.21",
            "verseOrgIds": [
              "MAT.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kono Rwot mom ojwiko kare-nu, kono dano moro mom obwot; doŋ pi jo ame oyero, en omio obino jwiko kare-nu oko. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.22",
            "verseOrgIds": [
              "MAT.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare-naca ka dano moro bino kobbiwu ni, ‘Neno, Kricito tye kane’, onyo ni, ‘Tye kaca’, kur iye wunu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.23",
            "verseOrgIds": [
              "MAT.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien jo ame kobo ni gin obedo Kricito bino pello, anaka odwarpiny ame ogoba, bino nyuto anyuttogo kede taŋo, wek ka twerre gin orweny anaka jo ame oyero. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.24",
            "verseOrgIds": [
              "MAT.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen ba, doŋ atyeko tittiwu con. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.25",
            "verseOrgIds": [
              "MAT.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.23+LUK.17.24"
              },
              "items": [
                {
                  "text": "Luk. 17.23-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Doŋ ka gin bino kobbiwu ni, ‘En tye i tim’, kur iwot wunu kuno, onyo ni, ‘Tye i tyelo’, kur iye wunu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.26",
            "verseOrgIds": [
              "MAT.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien acalo lutkot ya i tuŋ kide caro naka tuŋ to, dwogo a Wot a dano daŋ bino bedo amannono. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.27",
            "verseOrgIds": [
              "MAT.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.37"
              },
              "items": [
                {
                  "text": "Luk. 17.37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kan a kom oto tye iye, acut daŋ bino cokere kuno.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.28",
            "verseOrgIds": [
              "MAT.24.28"
            ]
          }
        }
      ]
