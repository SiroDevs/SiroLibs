              "type": "text"
            }
          ]
        },
        {
          "text": "En te mumulo waŋgi kun kobo ni, “Myero timere baŋwu i kite acalo iyeewu tye.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.29",
