            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyuto baŋwu aminwa Foibe, ame en atic a lwak jo oye Kricito tye i Kenkeria, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "lole wunu i Rwot acalo myero i jo Obaŋa, daŋ ikonye wunu i ginnoro ducu a en bino mito baŋwu; pien yam en okonyo jo apol, kede an ikoma daŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.2",
            "verseOrgIds": [
              "ROM.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
