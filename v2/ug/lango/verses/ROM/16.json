            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temoteo ame tio karacel keda i Rwot omotowu, kede Lukio, kede Jacon, kede Cocipater a gin watina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        }
      ]
    },
