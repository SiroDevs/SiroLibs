              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Rwot oneno ni Lea mom omaro, oyabo ot nyodo mere kun Lakeri pwod oraŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
