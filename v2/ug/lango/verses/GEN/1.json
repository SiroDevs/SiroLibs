              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agege Obaŋa oketo polo kede lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.1",
            "verseOrgIds": [
              "GEN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lobo onwoŋo orubere atata kun ginnoro mom iye, colpiny onwoŋo owumo pii atut oko; Cuny Obaŋa olyero i wi pii.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        }
      ]
    },
    {
