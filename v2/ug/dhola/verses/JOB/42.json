            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumacen munyo Rwoth otieko luwo wac me ri Yobu, Rwoth owaco ri Elifaz ma wok i Teman ni, “Keme paran liel kwoŋin gi merin perin ario. Wikiluwo kwoŋan m'otire paka ŋeca paran Yobu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo riameno ter win thwondhe abirio gi wot rombo abirio, wikidhi bongi ŋeca paran Yobu, to wimiyo mic awaŋa. Ŋeca paran Yobu lakwayo riwin, kwoŋbedo alayeyo kwayo pere ŋey akir'atiy gi win cungo kwoŋ miŋo mewin. Wikiluwo kwoŋan m'otire paka ŋeca paran Yobu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Elifaz, Bilidad kodi Zofar jokadho to jotimo paka Rwoth owaco rijo, aka Rwoth odwoko kwayo pa Yobu rijo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Idwoko ri Yobu lim pere mirundi ario",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
