            }
          ]
        },
        {
          "text": "Yobu odwoko Rwoth ama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cowe ma kisi gimoro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
