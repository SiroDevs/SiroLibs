            "sid": "1CH 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "timo mugat, moko m'ioro i mic, mugat ma buthow, moko m'oruw gi mo, kipima mic ma Ot pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.29",
            "verseOrgIds": [
              "1CH.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolapako kodi miyo Rwoth dwoŋ kisi odikin kodi othieno; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
