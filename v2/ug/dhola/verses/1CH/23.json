          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiy jo tic ma kuro Wema pa Rwoth kodi Ot pa Were, kodi konyo wade pajo, jocway ri Were i wi migam ma jowok kwoŋ Aron, i lamo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
