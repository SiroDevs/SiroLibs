      },
      "items": [
        {
          "text": "Tic pa Jolevi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ocoko jotel je ma Isiraili, jocway ri Were i wi migam kodi Jolevi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.2",
            "verseOrgIds": [
              "1CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolevi ma joromo oro piero adek kadho malo okwan jo aka oyido joromo cwo 38,000. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.3",
            "verseOrgIds": [
              "1CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere oketho 24,000 timo tic ma Ot pa Were, 6,000 kano gim'otimere kodi thumo banjin, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.4",
            "verseOrgIds": [
              "1CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "4,000 jokur ma waŋkac kodi 4,000 wero pak ri Rwoth, gi gigipiny ma wer ma kere oketho ri atoŋa me.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.5",
            "verseOrgIds": [
              "1CH.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.5",
            "verseOrgIds": [
              "1CH.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi opoko Jolevi i kitipin adek, cungo kwoŋ nonin pajo: Gerisom, Kohath kodi Merari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.6",
            "verseOrgIds": [
              "1CH.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.6",
            "verseOrgIds": [
              "1CH.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Gerisom obedo: Ladan kodi Simey. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.7",
            "verseOrgIds": [
              "1CH.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Ladan obedo: Yehiel, Zetham kodi Yowel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.8",
            "verseOrgIds": [
              "1CH.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "m'oyido jobedo jotel ma nonin m'owok kwoŋ Ladan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.9",
            "verseOrgIds": [
              "1CH.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simey oyido nitie gi wote aŋwen: Yahath, Zina, Yeus kodi Beria cungo kwoŋ nywolirok pajo. Yeus kodi Beria jok'obedo gi nyikway jo kweth, ameno k'okwan jo paka nonin.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.10+1CH.23.11",
            "verseOrgIds": [
              "1CH.23.10",
              "1CH.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.10+1CH.23.11",
            "verseOrgIds": [
              "1CH.23.10",
              "1CH.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Kohath obedo: Amiram, Izihar, Hebron kodi Uziel, j'aŋwen. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.12",
            "verseOrgIds": [
              "1CH.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.1"
              },
              "items": [
                {
                  "text": "Wok 28:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyikway Amiram obedo: Aron kodi Musa. Aron kodi nyikwaye okethi jo gicen kuro gigipiny maleŋ, waŋo buban i lamo Rwoth, tiyo rigo, kodi miyo ji silwany i nyingi Rwoth cil gi cil. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "To paka ri wot Musa, jacwo pa Were, okwan jo kwoŋ Jolevi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.14",
            "verseOrgIds": [
              "1CH.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Musa obedo: Gerisom kodi Elieza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.15",
            "verseOrgIds": [
              "1CH.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wod Gerisom obedo: Sebuwel m'oyido obedo jatel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.16",
            "verseOrgIds": [
              "1CH.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wod Elieza obedo: Rehabia, aka Rehabia obedo gi nyikwaye kweth.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        }
      ]
    },
