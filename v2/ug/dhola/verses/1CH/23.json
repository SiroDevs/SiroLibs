          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cungo i wiwaci pa Daudi macowe, Jolevi je ondiki nyingi jo tic ka jotundo oro piero ario, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.27",
