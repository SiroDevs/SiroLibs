              "items": [
                {
                  "text": "Kwan 3:5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aka omiy jo tic me konyo jocway ri Were i wi migam ma jowok kwoŋ Aron gi lamo ma Ot pa Were, yweyo diedipo mere kodi kisikin mere, kodi kuro gigipiny je maleŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
