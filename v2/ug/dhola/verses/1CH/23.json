                }
              ]
            }
          ]
        },
        {
          "text": "Ameno Jolevi jok'otiŋ Kakan ma Cikirok kodi gigipiny m'ioro i lamo kendo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.26",
            "verseOrgIds": [
              "1CH.23.26"
            ]
          }
        },
        {
