          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodi kisi k'imiyo Rwoth cowirok awaŋa i ndelo ma sabato, dwe manyen, kodi kalima m'oyer, cungo kwoŋ welo pajo ma ripo noknok ruwaŋ Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        },
