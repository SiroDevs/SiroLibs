          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me oyido jotel ma nonin pa kwarere pajo aka jo kodi nyikway jo oyido jobedo i Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
