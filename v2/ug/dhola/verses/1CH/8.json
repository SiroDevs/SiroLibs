            }
          ]
        },
        {
          "text": "Yaresia, Elia kodi Zikiri jobedo wot Yeroham.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.27",
            "verseOrgIds": [
              "1CH.8.27"
            ]
          }
        }
      ]
