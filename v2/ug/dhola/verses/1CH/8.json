              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benyamin oyido nitie gi wote abic. Bela okayo, Asibel mar'ario, Ahara mar'adek, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.1",
            "verseOrgIds": [
              "1CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noha mar'aŋwen kodi Rafa mar'abic.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.2",
            "verseOrgIds": [
              "1CH.8.2"
            ]
          }
        }
