          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saharayim olimo wote i piny Mowab rumacen ma riemo mon pere ario; Husim kodi Bara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.8",
            "verseOrgIds": [
              "1CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saharayim onywomo Hodes m'onywolo rigo wote abirio; Yobab, Zibia, Mesa, Malikam, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.9",
            "verseOrgIds": [
              "1CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeus, Sakia kodi Miriam. Nyikwaye je jobedo jotel ma pecin pajo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.10",
            "verseOrgIds": [
              "1CH.8.10"
            ]
          }
        }
      ]
    },
