          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisuwa, Naman, Ahowa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.4",
            "verseOrgIds": [
              "1CH.8.4"
