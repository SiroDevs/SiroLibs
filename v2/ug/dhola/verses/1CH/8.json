            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esek, omin Azel oyido nitie gi wote adek: Ulam, Yes kodi Elifelet.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
