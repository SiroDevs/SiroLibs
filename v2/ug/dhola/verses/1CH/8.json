          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moza obedo ba Bineya, Bineya obedo ba Rafa, Rafa obedo ba Eliazar, aka Eliazar obedo ba Azel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
