          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azel oyido nitie gi wote aucel: Azirikam, Bokeru, Isimayil, Seria, Obadia kodi Hanan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
