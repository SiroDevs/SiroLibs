          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Nafital obedo: Jahiziel, Guni, Jezer kodi Salum. (Jobedo nyikway Biliha malaya pa Yakobo m'onywolo Dan kodi Nafital.)",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
