      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyikway Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
