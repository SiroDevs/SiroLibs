            "sid": "1CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Tola obedo: Uzi, Refaya, Yeriel, Yahimay, Ibisam kodi Semuel. Jo oyido jobedo jotel ma pecin ma nono pa Tola aka jolweny matek i luse pajo. I hongo pa Kere Daudi nyikway jo oyido romo 22,600.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
