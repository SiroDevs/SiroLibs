            "sid": "1CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wod Uzi obedo Izirahia. Nyikway Izirahia obedo: Mikaili, Obadia, Yowel kodi Isia, aka oyido jobedo jotel ma pecin pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyido jonitie gi mon kweth kodi nyikway jo kweth aka jonyalo bedo gi cwo 36,000 ma jolweny.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.4",
            "verseOrgIds": [
              "1CH.7.4"
            ]
          }
        }
      ]
    },
    {
