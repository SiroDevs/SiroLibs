            "sid": "1CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wod Yediael obedo Bilihan. Nyikway Bilihan obedo: Yeus, Benyamin, Ehud, Kenana, Zethan, Tarsis kodi Ahisahar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyido jobedo jotel ma pecin ma nono aka jolweny matek. Kwoŋ nyikway jo oyido nitie cwo 17,200 ma jonyalo lweny. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.11",
            "verseOrgIds": [
              "1CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sufim kodi Hupim jobedo wot Ir, aka Husim obedo wod pa Aher.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        }
      ]
