          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Bela obedo: Ezibon, Uzi, Uziel Yerimoth, kodi Ir, jabic. Oyido jobedo jotel ma pecin pajo i nono aka jolweny matek. Kwoŋ nyikway jo oyido nitie cwo 22,034 ma jonyalo lweny.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        }
