              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yazia oyido nitie gi wote adek, Soham, Zakur kodi Ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
            "verseOrgIds": [
