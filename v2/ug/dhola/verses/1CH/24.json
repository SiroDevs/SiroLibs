          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cwo me ondiki nyingi jo cungo kwoŋ tic pajo ma donjo i Ot pa Were timo gima Aron kwari jo ocako paka Rwoth Were pa Isiraili omiyo go or.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
