            "number": "1",
            "style": "v",
            "sid": "1CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me jotel ma pecin pa Joisiraili, jotel ma nono kodi jodhum pajo ma jotimo tic ma ker. Kisi dwe ma oro kitipa m'opokere ma cwo 24,000 oyido jotiyo aka jamituka ma dwe no am'oyido telo jo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        }
      ]
    },
    {
