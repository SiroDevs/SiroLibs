          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "I dwe mar'apar, Maharay ma wok Netofa janono pa Zera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.13",
            "verseOrgIds": [
              "1CH.27.13"
            ]
          }
        }
