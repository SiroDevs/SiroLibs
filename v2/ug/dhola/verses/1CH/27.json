          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "I dwe mar'apar g'acel, Benaya ma wok Pirathon iy'adec ma nono pa Efrayim.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.14",
            "verseOrgIds": [
              "1CH.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
