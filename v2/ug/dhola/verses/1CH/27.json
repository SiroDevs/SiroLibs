          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahithofel oyido obedo jamic rieko pa kere, aka Husay Jarakit oyido obedo mere pa kere kodi jamic rieko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
