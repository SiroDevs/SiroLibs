          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I dwe mar'abuŋwen, Abieza ma wok Anathoth iy'adec pa Benyamin.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.12",
            "verseOrgIds": [
              "1CH.27.12"
            ]
          }
        }
