              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I dwe mar'aucel, Ira wod pa Ikes ma wok Tekowa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.9",
