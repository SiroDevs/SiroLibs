            }
          ]
        },
        {
          "text": "Yonathan, ner Daudi, oyido obedo jamic rieko manitie gi niaŋ aka jandiko. Yehiel wod pa Hakmon oyido fonjo wot kere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
