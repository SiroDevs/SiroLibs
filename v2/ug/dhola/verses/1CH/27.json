          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I dwe mar'abirio, Helez, janono pa Efrayim ma wok i Pelon.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.10",
