          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Simeo obedo: Nemuel, Yamin, Yarib, Zera kodi Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.24",
            "verseOrgIds": [
              "1CH.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo obedo ba Salum, nyakware obedo Mibisam, aka nyakwar wode obedo Misima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.25",
            "verseOrgIds": [
              "1CH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Misima obedo: Hamuel, Zakur kodi Simey. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.26",
            "verseOrgIds": [
              "1CH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simey oyido nitie gi wote apar g'aucel kodi nyir aucel, to wade pere oyido jonitie gi nyithindho manok, aka nono pa Simeo k'olak paka nono pa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.27",
            "verseOrgIds": [
              "1CH.4.27"
            ]
          }
        }
      ]
    },
