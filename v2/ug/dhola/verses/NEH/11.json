        },
        {
          "text": "Uzi wod Bani aka nyakwar Hasabia, am'oyido obedo jatel pa Jolevi i Yerusalem. Kwarere pere man jobedo: Matania, kodi Mika. Go oyido obedo janono pa Asaf, m'oyido jobedo jower aka jotic ma Ot pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.22",
            "verseOrgIds": [
              "NEH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere ma Pasia am'oyido miyo jo or ma weso ma wer i Ot pa Were kisi ndelo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        }
      ]
    },
