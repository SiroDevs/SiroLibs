          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pethahia, wod Mesezabel, aka janono pa Zera aka Jayuda, am'oyido pido ri Joisiraili i Pasia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
