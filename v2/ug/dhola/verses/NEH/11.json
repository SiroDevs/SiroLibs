            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonono pa Benyamin oyido jobedo i Geba, Mikmas, Ay, Bethel kodi calin macegin kenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
