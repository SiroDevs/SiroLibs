            }
          ]
        },
        {
          "text": "Ji ma Yuda megi oyido jobedo i tindin macegin gi ndelin pajo: Kiriath Arba, Dibon, Jekabzel, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.25",
