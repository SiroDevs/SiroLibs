            "sid": "NEH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoyada wod Paseya gi Mesulam wod Besodeya jogeto kendo Waŋkac ma Yesana. Joketho miango mere, thigin, petin gi nywenye ma cego.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.6",
            "verseOrgIds": [
              "NEH.3.6"
            ]
          }
