        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salum wod Kolhoze, jadhum mar'adec ma Mizipa, ogeto kendo Waŋkac ma Kidiwa; oumo royo mere, oketho thigin i kabedo, petin gi nywenye. Go ogeto kor ot macegin gi ndelo pa kere i kidiwa ma Sela, tundo kiri i madala ma kadho piny wok i tindi madwoŋ pa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        }
      ]
    },
    {
