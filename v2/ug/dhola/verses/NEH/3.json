          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cwo ma jowok Tekowa jogeto adec ma luwo, to jodongo ma tindi jokwero timo tic acingi ma rwodhe pajo jomiyo jo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
