          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melatia ma wok Gibeon, Yadon ma wok Meronoth, gi cwo ma jowok i Gibeon gi Mizipa jogeto adec ma luwo, tundo kiri peco pa gavana ma yupodho ceŋ ma Yufrete.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        }
