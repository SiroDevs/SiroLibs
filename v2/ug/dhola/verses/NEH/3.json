          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uziel wod Harhaya, jacwogi gigipiny gi nywenye, ogeto adec ma luwo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
