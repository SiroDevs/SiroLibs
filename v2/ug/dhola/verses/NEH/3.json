          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanania jayiki mo maŋwe kur ogeto adec ma luwo meno, aka otundo kiri i Kor ot ma woko mere.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
