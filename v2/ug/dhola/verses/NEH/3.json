            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanun gi ji ma jobedo i tindi madwoŋ Zanowa jogeto kendo Waŋkac ma Milelo. Joketho thigin mere i kabedo, petin gi nywenye ma cego waŋkac, aka joyiko kore mere mita 440 tundo kiri i Waŋkac ma Woyo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
