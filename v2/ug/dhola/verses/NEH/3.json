          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wot Hasena jogeto Waŋkac ma Rec. Joketho miango mere gi thigin i kabedo, aka joketho peta gi nywenye ma cego.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        }
      ]
    },
    {
