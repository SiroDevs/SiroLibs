            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zakur wod Imiri ogeto adec ma luwo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
