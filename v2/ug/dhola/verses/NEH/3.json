        {
          "text": "Refaya wod Hur, m'oyido dhumo adec Yerusalem, ogeto adec ma luwo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
