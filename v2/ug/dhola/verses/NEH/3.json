            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Eliasib jadwoŋ pa jocway ri Were i wi migam jocako tic gi jocway ri Were i wi migam wadi aka jogeto kendo Waŋkac ma Rombo. Joloko maleŋ tundo kiri i Acurcur ma Miya tundo kiri i Acurcur ma Hananel. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka cwo ma jowok Yeriko jogeto adec ma luwo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
      ]
    },
    {
