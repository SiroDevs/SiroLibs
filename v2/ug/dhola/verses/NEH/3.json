          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zadok wod Bana ogeto adec ma luwo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        }
      ]
    },
    {
