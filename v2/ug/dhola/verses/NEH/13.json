            "sid": "NEH 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acel kwoŋ wot Yoyada, wod Eliasib, jadwoŋ pa jocway ri Were i wi migam, onywomo nyar Sanbalat, ma wok i tindi Bethhoron, ameno amiyo Yoyada eye woko i Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        }
