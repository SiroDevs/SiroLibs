                "loc": "DEU.7.1+DEU.7.2+DEU.7.3+DEU.7.4+DEU.7.5"
              },
              "items": [
                {
                  "text": "Cik 7:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I hongo no bende aniaŋ ni cwo kweth ma Joyuda oyido jonywomo mon jopath wok i Asdod, Amon, kodi Mowab. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adec ma nyithindho pajo oyido joluwo dhodhok Asdod kosa dhodhok man aka oyido jokuya luwo dhodhok mawan won. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.24",
            "verseOrgIds": [
              "NEH.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apusa cwo no, alwoŋo lam kwoŋ jo, agoyo jo, aka ajwaco woko ye tik jo. Kenyo amiyo jo kwoŋirok i nyingi Were ni jo kosa nyithindho pajo, jokilanywomo kosa nywomirok gi jopath. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.25",
            "verseOrgIds": [
              "NEH.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.24+2SA.12.25"
              },
              "items": [
                {
                  "text": "2 Sam 12:24-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.1+1KI.11.2+1KI.11.3+1KI.11.4+1KI.11.5+1KI.11.6+1KI.11.7+1KI.11.8"
              },
              "items": [
                {
                  "text": "1 Kerin 11:1-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awaco rijo ni, “Mon jopath ama jomiyo Kere Solomon timo reco. Go oyido obedo jacwo madwoŋ loyo kerin ma piny man je. Were omaro go aka oketho go kere pa Joisiraili, to, kucel go otimo reco me. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.26",
            "verseOrgIds": [
              "NEH.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo waluw gima witimo, aka watim gir'akor kwoŋ Were mawan gi nywomo mon jopath?”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
            "verseOrgIds": [
              "NEH.13.27"
            ]
          }
        }
      ]
    },
