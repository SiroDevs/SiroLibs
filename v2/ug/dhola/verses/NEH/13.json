              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno alonyo woko ji kwoŋ gigipiny pa jopath je. Aketho cik ri jocway ri Were i wi migam kodi Jolevi ŋey kisi dhano wonyali ŋeyo tic pere. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atimo can ri yen ma waŋo mic i sawa ma ripo, kodi ri ji kelo mic pajo ma ŋano, kodi olemo macek marapena.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
