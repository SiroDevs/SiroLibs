            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.1",
            "verseOrgIds": [
              "NEH.13.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.4+DEU.23.5+DEU.23.6"
              },
              "items": [
                {
                  "text": "Cik 23:4-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndelo no munyo isoma kitawo pa Musa ma kisi dhano je winjo, onwaŋ adec ma waco ni Joamon kosa Jomowab jokiripi riwirok gi ji pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.1",
            "verseOrgIds": [
              "NEH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.1+NUM.22.2+NUM.22.3+NUM.22.4+NUM.22.5+NUM.22.6"
              },
              "items": [
                {
                  "text": "Kwan 22:1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Me obedo kwoŋbedo Joamon gi Jomowab jok'omiyo Joisiraili cemo kosa pi munyo jowok i Misir. Kwanyowoko, joculo Balam pesa lamo Joisiraili, to Were mawan owiro lam no i silwany. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.2",
            "verseOrgIds": [
              "NEH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Joisiraili jowinjo osoma cik me, jopokere woko kwoŋ jopath je.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wirok ma Nehemia otimo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo mafodi gime, Eliasib, jacway ri Were i wi migam, m'oyido obedo jatel ma kisikin ma kan i Ot pa Were, oyido tiyere gi Tobia hongo malac. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.4",
            "verseOrgIds": [
              "NEH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go oyeyo Tobia oro kisika malac m'oyido iripo kan'iye mic ma ŋano kodi buban, gigipiny m'ioro i Ot pa Were, mic pa jocway ri Were i wi migam, acel wiy apar ma ŋano, vini, kodi mo m'imiyo Jolevi, jower kodi jokur ma Ot pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.5",
            "verseOrgIds": [
              "NEH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo gime timere, oyido angoye i Yerusalem, kwoŋbedo i oro ma piero adek g'ario ma dhum pa Kere Aritakises ma Pasia, go oyido obedo kere ma Babilon aka oyido agik bonge. Rumacen ma hongo moro, go oyeyan ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.6",
            "verseOrgIds": [
              "NEH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "gik i Yerusalem. Kenyo aniaŋ kwoŋ komo ma Eliasib oyido otimo gi yeyo Tobia oro kisika i Ot pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.7",
            "verseOrgIds": [
              "NEH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amako nge swa, aka abolo woko gigipiny pa Tobia ma ot je. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.8",
            "verseOrgIds": [
              "NEH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo awodho or ni wotim kwer ma lonyo kisika, aka wodwok'iye gigipiny ma Ot pa Were, mic ma ŋano, kodi buban.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.10",
            "verseOrgIds": [
              "NEH.13.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.19"
              },
              "items": [
                {
                  "text": "Cik 12:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniaŋ kendo ni ji oyido jokimiy jower ma Ot pa Were kodi Jolevi adec ma mic m'iripo miyo jo, aka nyo oyido joeye woko i Yerusalem jodok fur ndelin pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.10",
            "verseOrgIds": [
              "NEH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno apusa jodhum aka apenjo jo ni, “Raŋo wijwango Ot pa Were?” Kenyo acoko Jolevi kodi jower t'adwoko jo tic i Ot pa Were kendo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.11",
            "verseOrgIds": [
              "NEH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.10"
              },
              "items": [
                {
                  "text": "Mal 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ji ma Yuda jocako kelo acel wiy apar ma ŋano, vini, kodi mo i kisikin ma kan. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.12",
            "verseOrgIds": [
              "NEH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aketho cwo me kuro kisikin ma kan: Selemia, jacway ri Were i wi migam, Zadok jafonji cik, Pedaya, Jalevi, Hanan, wod Zakur aka nyakwar Matania oyido obedo jakony pajo. An oyido aŋeyo ni cwo me jogenere i poko wadi jo gigipiny.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.13",
            "verseOrgIds": [
              "NEH.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.13",
            "verseOrgIds": [
              "NEH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poyan, Awi Were paran, ro gigipiny je m'atieko timo ri Ot perin kodi lam'iye.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 13:15"
          },
          "items": [
            {
              "text": "15",
