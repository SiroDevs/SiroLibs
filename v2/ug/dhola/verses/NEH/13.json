            "sid": "NEH 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poyi jo, Awi Were paran, kwoŋbedo jokoco tic ma cwayo rin, cikirok ma cango itimo gi jocway ri Were i wi migam kodi Jolevi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        }
