          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poyan, Awi Were paran, ri gime bende, aka ikuran ro dwoŋ ma mar perin makiwire.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
            "verseOrgIds": [
              "NEH.13.22"
            ]
