          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poyan, Awi Were paran, ro bero m'atieko timo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
