          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kere ketho misolo ri ji je ma ker pere kodi ji je m'oyido jonitie i lowo pere kodi ma jonitie i kigoda ma nam. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gigipiny je ma kere otimo gi meni kodi dwoŋ pere, kodi gima go otimo je, tiŋo Modekay i dwoŋ ma malo to kosa nitie ma k'ondiki i kitawo pa kerin je ma jodhumo Pasia gi Mediya! ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekay Jayuda am'oyido luwo kere Aritakises i dwoŋ. Go am'oyido obedo jacwo manitie gi dwoŋ ma malo swa kwoŋ Joyuda. Joyuda joworo go swa rupiri go oyido tiyo ri bero pa ji pere aka doko go oyido luwo ri bero pa Joyuda je.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
