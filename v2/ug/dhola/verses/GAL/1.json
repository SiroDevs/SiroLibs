            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.13+ACT.26.14+ACT.26.15+ACT.26.16+ACT.26.17+ACT.26.18"
              },
              "items": [
                {
                  "text": "26:13-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To Were won, gi nema pere am'oyeran denge mafodi k'onywolan, to lwoŋan tic rigo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka munyo oridho nyuthan Wode, ŋey afonji Jopath Wac Manyen Maber kwoŋ go, akikidho bongi nyatoro rango rieko, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
              "GAL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "odoko akikidho Yerusalem neno joma jotelo bedo ran jomoor. T'akidho i piny pa Jowarabu mayot, aka nyaka adwoko Damasiko. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.17",
            "verseOrgIds": [
              "GAL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.26+ACT.9.27+ACT.9.28+ACT.9.29+ACT.9.30"
              },
              "items": [
                {
                  "text": "Tim 9:26-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munyo oro okadho adek, aka nyaka akidho Yerusalem wendo ri Petero, to acowo bonge ndelo apar g'abic. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.18",
            "verseOrgIds": [
              "GAL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akineno jomoor man kwanyo woko Yakobo, omin Rwoth.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.19",
            "verseOrgIds": [
              "GAL.1.19"
            ]
          }
        }
      ]
    },
