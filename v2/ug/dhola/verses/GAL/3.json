                }
              ]
            }
          ]
        },
        {
          "text": "Ka wibedo apa Kristo, kole meno wibedo nyikway Abraham, aka wibedo musikin ma jobino lunjo lim ma Were ociko.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.29",
