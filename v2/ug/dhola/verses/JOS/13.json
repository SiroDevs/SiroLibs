            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa omiyo alunja ri adec nono pa Manase; omiy adec nyikway Manase, cungo kwoŋ pecin pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
          "name": "verse",
