          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo to kere Horam ma Gezer ay malo konyo Lakis; to Yosuwa rwadho go piny gi ji pere cuka go k'oweyo dhano m'odoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
        }
