            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.12",
            "verseOrgIds": [
              "JOS.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
