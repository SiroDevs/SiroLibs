                {
                  "text": "1 Kigana 18:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munyo Solomon ocowo tic je ma Ot pa Were, oketho gigipiny je ma bamere Daudi oyido otieko miyo Rwoth i kisika ma kan, feza, zahabu kodi gigipiny man.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
