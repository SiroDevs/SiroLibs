                  "text": "Cik 16:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go omiyo cowirok paka cik pa Musa waco ri kisi ndelo: Sabato, Kalima ma Dwe Manyen kodi Kalima adek ma oro. Kalima ma Mugat ma buthow, Kalima ma Keco kodi Kalima ma Kayindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luwo kwoŋ cik ma Daudi bamere oketho, ocano tic ma kisi ndelo ri jocway ri Were i wi migam kodi Jolevi m'oyido jokonyo jo i wer kodi timo tic pajo. Solomon bende oketho jokur ma Ot pa Were i kitipin pajo i kisi waŋkac, luwo kwoŋ cik ma Daudi jacwo pa Were omiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jocway ri Were i wi migam kodi Jolevi joluwo i kare cik je ma Daudi omiyo kwoŋ jo kodi udi ma kan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
