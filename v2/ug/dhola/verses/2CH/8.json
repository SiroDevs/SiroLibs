        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon okelo dhako pere, nyar farawo wok i tindi pa Daudi bedo i ot m'oyido ogeto rigo, kole go owaco ni, “Dhako paran kiripi bedo i ot pa Kere Daudi ma Isiraili, kwoŋbedo kabedo je ma Sanduku ma Kakan ma Cikirok otieko bed'iye leŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Solomon omiyo cowirok awaŋa ri Rwoth i wi migam m'oyido ogeto yuwaŋ Ot pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
