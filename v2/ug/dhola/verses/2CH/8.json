          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno tic pa Solomon je oyido orumo wok i ndelo m'ocak'iye misingi ma Ot pa Rwoth cuka Ot pa Rwoth ocow geto maber.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
