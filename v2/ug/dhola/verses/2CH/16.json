{
  "id": "2CH.16",
  "number": "16",
  "bookId": "2CH",
  "reference": "2 Kigana Kwoŋ Kerin 16",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
