  "bookId": "2CH",
  "reference": "2 Kigana Kwoŋ Kerin 35",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "2CH 35"
      },
