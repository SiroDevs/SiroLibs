                "loc": "LEV.9.23+LEV.9.24"
              },
              "items": [
                {
                  "text": "Jolevi 9:23-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Solomon otieko kwayo, mac owok i polo to waŋo woko mic kodi cowirok awaŋa, aka dwoŋ pa Rwoth oumo Ot pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jocway ri Were i wi migam jok'onyalo kiri donjo i Ot pa Rwoth Were rupiri dwoŋ pa Rwoth oyido oumo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
