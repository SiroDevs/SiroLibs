            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Ahab penjo Mikaya ni, “Awaci rin didi nike k'iluwo kodan i nyingi Rwoth wac ran adieri?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.15",
            "verseOrgIds": [
              "2CH.18.15"
            ]
          }
        }
      ]
    },
