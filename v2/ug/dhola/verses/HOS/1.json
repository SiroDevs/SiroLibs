              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth owaco ri Hoseya ni, “Cwoki rigo nyinge ni Yezirel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:4",
              "type": "text"
            },
            {
              "text": "Yezirel",
              "type": "text"
            },
            {
              "text": "Dwoŋ mere ni Were cwoyo",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kole i hongo manok alamiyo gir'acula ri ot pa Yehu ro remo pa Yezirel, aka alaketho i gike ker ma dhum ma ot pa Isiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndelo no alaturo asere ma Isiraili i milelo ma Yezirel.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
              "HOS.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
