              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Rwoth oluwo gi Hoseya marapena, Rwoth owaco ri Hoseya ni, “Kadhi, inywom dhako m'obedo malaya aka i nywol nyithindho ma jobedo malaya paka go, kole piny timo malaya madwoŋ swa gi jwango Rwoth.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoseya okadho to nywomo Goma nyar Diblayim. Goma ogamo iye to nywolo ri Hoseya wode.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        }
      ]
    },
