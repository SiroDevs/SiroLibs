            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kucel welo pa Joisiraili lacale paka kwoyo ma nam, ma kipimere kosa kwanere; aka i kabedo m'owac'iye rijo ni, “Wikibedo ji paran.” Ilalwoŋo jo ni, “Nyithindho pa Were makwo.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji ma Yuda kodi Joisiraili jolacokere kanyacel, to joyero rijo wegi jatel acel; to jotero lowo, kole ndelo pa Yezirel labedo madwoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
    }
