            }
          ]
        },
        {
          "text": "Balam owaco ri Balak ni, “Geti ran ka, migame abirio, aka iyiki thwondhe abirio kodi wot rombo abirio.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
              "NUM.23.1"
            ]
          }
        }
      ]
    },
    {
