          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Balak otero Balam wi got Pewor ma ŋiyo thim. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.28",
            "verseOrgIds": [
              "NUM.23.28"
            ]
          }
