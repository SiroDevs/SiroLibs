            }
          ]
        },
        {
          "text": "Balak owaco ri Balam ni, “Mondo biye, weyi aterin i kabedo man, poyi lakisangala Were t'ikwoŋo ran jo gi kenyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
