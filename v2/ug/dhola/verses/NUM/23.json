            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth oromo gi Balam, to ketho wac i dhoke to waco rigo ni, “Gik bongi Balak, aka me a gim'iwaci.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.16",
            "verseOrgIds": [
              "NUM.23.16"
            ]
          }
        },
