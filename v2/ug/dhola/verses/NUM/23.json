          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balak owaco ri Balam ni, “Aŋo m'itimo ran? Akelin ka lamo jokwor paran, t'onyo itieko miyo jo silwany adieri.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
              "NUM.23.11"
            ]
          }
        }
