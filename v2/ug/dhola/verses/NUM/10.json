          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Musa waco rigo ni, “Mondo ikir'iwey wan, kole iŋeyo kama wanyalo keth'iye kambi i thim aka ibino bedo riwan paka waŋ wan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.31",
            "verseOrgIds": [
              "NUM.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kucel, k'ikadho gi wan, bero je ma Rwoth otim riwan, gimoro acel no walatimo rin.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.32",
            "verseOrgIds": [
              "NUM.10.32"
            ]
          }
        }
      ]
