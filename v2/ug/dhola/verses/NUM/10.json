{
  "id": "NUM.10",
  "number": "10",
  "bookId": "NUM",
  "reference": "Kwan 10",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
