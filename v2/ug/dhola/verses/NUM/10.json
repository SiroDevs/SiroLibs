              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Hobab dwoko go ni, “Akilakadho, to aladok i piny paran won gi bongi wade paran.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.30",
