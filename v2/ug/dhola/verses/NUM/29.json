          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodi moko kilo acel ri kisi wot rombo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
            "verseOrgIds": [
              "NUM.29.15"
            ]
          }
