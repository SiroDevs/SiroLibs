        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth oluwo gi Musa, ka waco ni: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waci ri Aron kodi wote, aka iwaci ni: Me apaka wiripo miyo Joisiraili silwany: Wibino waco rijo ni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
            "verseOrgIds": [
              "NUM.6.23"
            ]
          }
        }
      ]
