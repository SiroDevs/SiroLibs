            "sid": "NUM 33:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "wiripo riemo woko ji je ma jobedo i lowo no ruwaŋ win, reyo woko cal pajo je ma telin kodi ma nyweny kodi kalamo pajo je manyakafir. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.52",
            "verseOrgIds": [
              "NUM.33.52"
            ]
          }
        },
