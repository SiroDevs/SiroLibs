        },
        {
          "text": "Rwoth oluwo gi Musa i kam'obipere ma Mowab i thengi Yordan i Yeriko ka waco ni: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.50",
            "verseOrgIds": [
