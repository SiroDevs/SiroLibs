              "items": [
                {
                  "text": "Kwan 26:54-56",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wiripo poko lowo gigoyo kwir cungo kwoŋ nonin mewin. Nonin madongo jolalimo lim madwoŋ, aka nonin mathindho jolalimo lim mathin. Lim labedo apa nono ma kwir opodhi kwoŋe, cungo kwoŋ nonin pa kwarere mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.54",
            "verseOrgIds": [
              "NUM.33.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 33:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka wikiriemo woko ji ma jobedo i lowo no ruwaŋ win, jono ma winowey jo jolalokere riwin cowirok i waŋ win kodi kudhin i ŋeti win. Jolabedo riwin teko i lowo ma wikidho bed'iye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.55",
            "verseOrgIds": [
              "NUM.33.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 33:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo alatimo riwin paka aparo timo rijo.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.56",
            "verseOrgIds": [
              "NUM.33.56"
            ]
          }
        }
