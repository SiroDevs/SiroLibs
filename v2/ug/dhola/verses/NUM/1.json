          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joisiraili jotimo ameno; paka Rwoth oyido otieko wodho or ri Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.54",
