          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Simeo, bol ma nywolirok pajo, i nonin pajo, gi udi pa kwarere pajo, kwoŋ jo m'okwan, cungo kwoŋ kwan ma nyingi jo, kisi dhano, kisi jacwo wok i oro piero ario kadho malo, kisi dhano manyalo kidho i lweny. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jono m'ondiki jo i nono pa Simeo onwaŋo nitie ji 59,300.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        }
