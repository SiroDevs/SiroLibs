          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'owodhi tabenakulo, Jolevi jobino kwanyo to joketho piny, aka k'ikidho jengo tabenakulo, Jolevi jolaŋawo malo. Japath moro je m'ocore cegin gine iripo neko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.51",
            "verseOrgIds": [
              "NUM.1.51"
            ]
          }
        },
