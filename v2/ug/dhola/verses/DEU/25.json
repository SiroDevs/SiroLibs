              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dhaw obedo i dier j'ario, aka jobino bongi jothum banja theko jo, jolanwaŋo ŋat'otire kodi ŋat'okom. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.1",
            "verseOrgIds": [
              "DEU.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'inen ŋata jabanja iripo cwado, jathum banja lamiyo go nindo piny, aka wocwadi go ruwaŋe, gi goco marom gi komo pere. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.24"
              },
              "items": [
                {
                  "text": "2 Kor 11:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inyalo cwado go kiboko piero aŋwen, to ka okalo kenyo, nyalo miyo go bedo m'ongoye gi wor i dier ji.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        }
      ]
    },
