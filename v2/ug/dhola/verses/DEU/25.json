          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka cwo ario jogore, aka cipa ŋat'acel odonj'iye botho cwore kwoŋ goco pa nyawote gi ywayo mandi go, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "iripo toŋo woko cingi dhako no m'ongoye wor.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        }
      ]
    },
