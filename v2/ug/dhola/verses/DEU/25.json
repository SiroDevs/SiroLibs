            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15:2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Poyi win gima Joamalek jotimo riwin i woth mewin wok Misir. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomonjo win i royo, munyo wiol aka wiloc, to joneko jono m'oyido jodoŋ cen; jok'olworo Were. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno ka Rwoth Were mewin otieko miyo win ywomirok kwoŋ jokwor mewin je i thenge je, i lowo ma Rwoth Were mewin miyo win paka gir'alunja, wiripo reyo woko Joamalek wok i pendi polo, wicwil okir womaki win.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.19",
            "verseOrgIds": [
              "DEU.25.19"
            ]
          }
        }
      ]
