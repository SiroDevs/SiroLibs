          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiripi miyo Rwoth Were mewin cowirok ma merikwa, kosa rombo, m'oŋol, kole meno obedo amien ri Rwoth Were mewin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        }
      ]
    },
    {
