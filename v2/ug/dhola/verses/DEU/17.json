                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.15"
              },
              "items": [
                {
                  "text": "2 Kigana 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.27"
              },
              "items": [
                {
                  "text": "9:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kere no kiripi nywomo mon kweth, ka k'obedo ameno cunye nyalo cile woko kwoŋ Rwoth, kosa coko feza kodi zahabu kweth. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka ka otiek ketho go i kom ma dhum paka kere, go ripo bedo gi kitawo ma cik me m'okopila wok i kitawo ma cik ma jocway ri Were i wi migam, nyikway Jolevi jonigine. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go ripo doŋ gine to bedo ka soma i ndelo ma kwo pere je, ŋey wofonjere lworo Rwoth Were pere, kuro gi kinen wac je m'ondiki i cik me kodi fonji me je, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋey go wokiri womiyere dwoŋ loyo joman kosa wowire woko kwoŋ or, racuc kosa racam; ŋey go kodi nyikwaye jowodhum ker pere i Isiraili hongo malac.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.20",
            "verseOrgIds": [
              "DEU.17.20"
            ]
          }
        }
      ]
    }
