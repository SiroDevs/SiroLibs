            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abedo wi got odieceŋ piero aŋwen kodi wor piero aŋwen paka marapena. Rwoth owinjan kendo aka k'onyalo reyo woko win. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth owaco ran ni, “Ay malo, kadhi itel ji, ŋey jowokadhi jowolunji lowo m'akwoŋere ri kwarere pajo ni alamiyo jo.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.11",
            "verseOrgIds": [
              "DEU.10.11"
            ]
          }
        }
      ]
    },
    {
