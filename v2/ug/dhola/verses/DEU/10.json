                  "text": "22:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwarere mewin jokadho piny i Misir, ji piero abirio, aka pama Rwoth Were mewin otieko loko win mathoth paka micalin ma i polo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.22",
