          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8"
              },
              "items": [
                {
                  "text": "Kwan 3:5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I hongo no Rwoth oketho gicen nono pa Jolevi tiŋo sanduku pa Rwoth, cungo ruwaŋ Rwoth tiyo rigo, kodi miyo silwany i nyingi go, kiri konon. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno nono pa Jolevi ongoye gi kibaba kosa alunja, Rwoth obedo alunja pajo, paka Rwoth Were mewin ociko go.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        }
      ]
