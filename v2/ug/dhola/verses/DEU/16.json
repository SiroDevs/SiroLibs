              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.26+NUM.28.27+NUM.28.28+NUM.28.29+NUM.28.30+NUM.28.31"
              },
              "items": [
                {
                  "text": "Kwan 28:26-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wiripo kwano sabiti abirio, ka wicako kwano wok i hongo ma wicako nyaro ŋano. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiripo kuro Kalima ma Keco ri Rwoth Were mewin, ka wimiyo go mic ma dhano won miyo cungo kwoŋ silwany ma wilimo wok bongi Rwoth Were mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiripo kisangala ruwaŋ Rwoth Were mewin, win, nyithindho mewin, ŋecin mewin, Jolevi ma jobedo i tindin mewin, jopath, nyithindho kic kodi citho ma jobedo i dier win, i kabedo ma Rwoth Were mewin oyer paka kabedo ri nyinge. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poyi win nike oyido wibedo ŋecin i Misir, kur win cik me gi kinen.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
