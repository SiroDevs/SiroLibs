                  "text": "34:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wikiripi camo gima won otho; winyalo miyo jokicar ma jobedo i tindin mewin jowocami, kosa winyalo kitana ri japath. Kole wibedo ji maleŋ ri Rwoth Were mewin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiri witedo nyathi diel i cak pa min.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
