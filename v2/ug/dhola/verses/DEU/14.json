                }
              ]
            }
          ]
        },
        {
          "text": "Wibedo nyithindho pa Rwoth Were mewin. Wikiripi gwerok kosa ŋwekirok ka dhano otho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
