              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa obino aka oluwo wac je ma wer me i ithi ji, kanyacel gi Yosuwa wod pa Nun.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fonji pa Musa macowe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
