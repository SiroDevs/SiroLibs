                }
              ]
            }
          ]
        },
        {
          "text": "Ka Rwoth Were mewin otieko kelo win i lowo m'ociko kwarere mewin, Abraham, Isaka, kodi Yakobo miyo win, tindin madongo malac ma wikigeto, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.10",
            "verseOrgIds": [
              "DEU.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "udi m'opoŋ gi nger gigipiny kweth ma wikipoŋo, kacoko pi ma wikikunyo, ndelin vini kodi oliv ma wikipidho, ka witieko camo ma romo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "gwokere win wicwil okir omaki win gi Rwoth, m'owodho win wok i lowo ma Misir, wok i ot ma twec. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.12",
            "verseOrgIds": [
              "DEU.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.10"
              },
              "items": [
                {
                  "text": "Mat 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.8"
              },
              "items": [
                {
                  "text": "Luk 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wiripo lworo Rwoth Were mewin, go ama wiripo tiyo rigo, aka wiripo kwoŋere i nyingi go kende. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.13",
            "verseOrgIds": [
              "DEU.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiri wiluw werin man, werin pa nonin ma jothoko win, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwoŋbedo Rwoth Were mewin, manitie gi win, obedo Were ma janyeko. Nge pa Rwoth Were mewin nyalo liel kwoŋ win aka nyalo reyo woko win wok i piny.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        }
      ]
    },
