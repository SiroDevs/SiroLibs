            "number": "1",
            "style": "v",
            "sid": "DEU 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me or, fonji kodi cik ma Rwoth Were mewin omiyan or fonjo win kuro i lowo ma wicegin donjo gi bed'iye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.1",
            "verseOrgIds": [
              "DEU.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋey win kodi nyithindho mewin kodi nyikway win winyal lworo Rwoth Were, kuro cik kodi or m'afonjo win, i kwo mewin je ŋey ndelo ma kwo mewin wobedi mabor. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.2",
            "verseOrgIds": [
              "DEU.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winji Awi Isiraili, aka kur win gi kinen, ŋey winwaŋ bero, aka ŋey wimedi nyay swa i lowo ma mol gi cak kodi mo kic, paka Rwoth, Were pa kwarere mewin ociko win.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.3",
            "verseOrgIds": [
              "DEU.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
