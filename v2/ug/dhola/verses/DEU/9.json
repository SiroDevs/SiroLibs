        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariere piny ruwaŋ Rwoth ma odieceŋ piero aŋwen kodi wor piero aŋwen kwoŋbedo Rwoth oyido otieko miyere reyo woko win, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "akwayo Rwoth k'awaco ni, “Rwoth Were, ikir'irey woko ji ma jobedo lim perin won, ji m'ibotho gi meni perin, ji m'iwodho wok i Misir gi cingin ma meni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poyi ŋecin perin Abraham, Isaka, kodi Yakobo, ikir'ipar kwoŋ wictek pa ji me, kidakana pajo kodi reco pajo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.27",
            "verseOrgIds": [
              "DEU.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kosa piny m'iwodho wan wok'iye lawaco ni, ‘Kwoŋbedo Rwoth k'onyalo kelo jo i lowo m'ociko jo, aka kwoŋbedo odak jo, owodho jo to weyo jo tho i thim.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.28",
            "verseOrgIds": [
              "DEU.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobedo ji perin, alunja perin won, m'iwodho gi meni perin madwoŋ kodi cingin m'oyare.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.29",
            "verseOrgIds": [
              "DEU.9.29"
            ]
          }
        }
      ]
