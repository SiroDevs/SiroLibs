                "loc": "NUM.11.34"
              },
              "items": [
                {
                  "text": "Kwan 11:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I Tabera bende kodi i Masa, kodi i Kibroth Hatava, wikwinyo keme pa Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
