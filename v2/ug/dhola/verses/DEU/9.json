                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.16"
              },
              "items": [
                {
                  "text": "Ebu 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka munyo Rwoth ooro win wok i Kades Barineya, k'awaco ni, “Kadhi win malo wimaki lowo m'atieko miyo win.” Wigwenyere kwoŋ or pa Rwoth Were mewin, wikigeno go, kosa winjo dwonde. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Witieko bedo jogwenyirok kwoŋ Rwoth wok i ndelo m'aŋey'iye win.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
