            "verseId": "DEU.4.41",
            "verseOrgIds": [
              "DEU.4.41"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.20.8+JOS.20.9"
              },
              "items": [
                {
                  "text": "Yos 20:8-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Musa oketho gicen yuwok ceŋ ma Yordan tindin madongo adek ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.41",
            "verseOrgIds": [
              "DEU.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋey ŋat'oneko nyawote ma k'ogendera nyalo ring'iye both neki, k'oyido jok'obedo jokwor. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.42",
            "verseOrgIds": [
              "DEU.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bezer i thim i lowo m'obipere ri nono pa Ruben, Ramoth i Giliad ri nono pa Gad, kodi Golan i Basan ri nono pa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.43",
            "verseOrgIds": [
              "DEU.4.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yikirok ma miyo cik pa Were",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.43",
            "verseOrgIds": [
              "DEU.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me cik ma Musa oketho ruwaŋ Joisiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.44",
            "verseOrgIds": [
              "DEU.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me cik, or kodi fonji ma Musa owaco ri Joisiraili munyo jowok i Misir, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.45",
            "verseOrgIds": [
              "DEU.4.45"
            ]
          }
        },
        {
          "name": "verse",
