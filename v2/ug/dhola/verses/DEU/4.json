              "type": "text"
            }
          ]
        },
        {
          "text": "Wok i Arower, manitie i gike ma milelo ma malawa Arinon, tundo kiri i Got Sirion (meno Hamon) ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.48",
