              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomako lowo pere kodi lowo pa Kere Og ma Basan, kerin ario pa Joamor m'oyido jobedo yuwok ceŋ ma Yordan: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.47",
