            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.16+EXO.19.17+EXO.19.18"
              },
              "items": [
                {
                  "text": "Wok 19:16-18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.18+HEB.12.19"
              },
              "items": [
                {
                  "text": "Ebu 12:18-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wicore cegin aka wicungo i tiendi got aka got oliel mac tundo kiri i polo, i dier pondeponde macol. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.11",
            "verseOrgIds": [
              "DEU.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth oluwo gi win wok i mac. Wiwinjo derino ma wac pere to wikineno cal pere, nyaka obedo dwondi go. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.12",
            "verseOrgIds": [
              "DEU.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.18"
              },
              "items": [
                {
                  "text": "Wok 31:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.28"
              },
              "items": [
                {
                  "text": "34:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.10"
              },
              "items": [
                {
                  "text": "Cik 9:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go owaco riwin cikirok pere, m'omiyo win or kuro, meno Or Apar, aka ondiko i telin mapando ario. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.13",
            "verseOrgIds": [
              "DEU.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.1"
              },
              "items": [
                {
                  "text": "Wok 21:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka Rwoth omiyan or i hongo no fonjo win or kodi cik, ŋey winyal kuro i lowo ma wicegin donj'iye lunjo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.14",
            "verseOrgIds": [
              "DEU.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gwoko ji kwoŋ lamo cal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
