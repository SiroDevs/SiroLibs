              "type": "text"
            }
          ]
        },
        {
          "text": "Balwa m'owok bongi Paulo, Silvano kodi Timothe.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        }
