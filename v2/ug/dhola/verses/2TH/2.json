                "loc": "1TH.4.15+1TH.4.16+1TH.4.17"
              },
              "items": [
                {
                  "text": "1 Thes 4:15-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima mako kwoŋ dwoko pa Rwodhiwan Yesu Kristo kodi coko wan kanyacel bonge, wakwayo win jom'oyeyo, ni ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.1",
            "verseOrgIds": [
              "2TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wikiri wikwaki bedo gi kiganagana i paro mewin, kosa limo bwok ro wac pa joma ŋoyo ni Ndelo pa Rwoth otieko tundo. Ato moro nyalo bino pa jatuci wac, kosa jafonji, kosa ma waco ni wandiko gino i balwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.2",
            "verseOrgIds": [
              "2TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiri wiyeyi nyatoro womiŋi win i royo moro je, rupiri Ndelo no k'otundi cuka gwenyirok obedi, to Jal ma kilwor cik nenere. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.3",
            "verseOrgIds": [
              "2TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "Dan 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Eze 28:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go bino piemo gi gimoro je ma ji jolamo kosa jotero paka were, to won tiŋere malo to jengere i Ot pa Were munyo ŋoyo ni go a Were!",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikipoy ni atuco riwin gime je munyo fodi oyido anitie gi win? ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.5",
            "verseOrgIds": [
              "2TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka wiŋeyo gima fodi geŋo bino pa jalo, ŋey wonenere ka hongo pere m'otire otundo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.6",
            "verseOrgIds": [
              "2TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole meni manyaliŋliŋ ma miyo ji kwero lworo cik otieko cako tic; to ŋata geŋo gino bino timo ameno cuka okwany woko go i royo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.7",
            "verseOrgIds": [
              "2TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.4"
              },
              "items": [
                {
                  "text": "Isa 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo nyaka Jal ma kilwor cik bino nenere, ma Rwoth Yesu bino neko woko gi luya ma dhoke, to reyo go woko gi menyirok madwoŋ pere munyo dwoko. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.8",
            "verseOrgIds": [
              "2TH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.24"
              },
              "items": [
                {
                  "text": "Mat 24:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jal ma kilwor cik no labino gi meni pa Sitan to timo ranyuth kodi gidhier ma twodo, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.9",
            "verseOrgIds": [
              "2TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodi reco madit ma wondo joma jobino rere woko, rupiri jokwero maro adieri ma d'omiyo jo both. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.10",
            "verseOrgIds": [
              "2TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ro wac me Were ladhiro rijo twodo madwoŋ ŋey jowoyey gima k'otire, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.11",
            "verseOrgIds": [
              "2TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka wothum banja loyo ji ma jok'oyeyo adieri ma josangala kodi gimarac ayin.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.12",
            "verseOrgIds": [
              "2TH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oyer win ri both",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.12",
            "verseOrgIds": [
              "2TH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waripo foyo Were riwin hongo je, wutmera ma Rwoth omaro, rupiri Were oyero win wok i cakirok ni wilimi both gi meni pa Cuny Maleŋ ma lonyo win, ro yeyo adieri mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.13",
            "verseOrgIds": [
              "2TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were olwoŋo win i yeyo me munyo oro Wac Manyen Maber ma wafoyo win, ni wilimi adec m'opok riwin kwoŋ dwoŋ pa Rwodhiwan Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.14",
            "verseOrgIds": [
              "2TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo, wutmera, cungi win matek aka cwire win kwoŋ adieri ma wafoyo win adhok kodi i balwa mawan.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weyi Rwodhiwan Yesu Kristo won gipi, kodi Were Bawan, m'omaro wan aka i nema pere omiyo wan miseni makirum kodi geno maber, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.16",
            "verseOrgIds": [
              "2TH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "wopoŋ cuny win miseni to miyo win meni ma timo gi waco gimoro je maber.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.17",
            "verseOrgIds": [
              "2TH.2.17"
            ]
          }
        }
      ]
    }
  ],
