              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth oluwo gi Musa ka waco ama: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.22",
            "verseOrgIds": [
              "LEV.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luw gi Joisiraili iwaci rijo ni, jokiripi camo bor dhiaŋ, rombo, kosa diel. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.23",
            "verseOrgIds": [
              "LEV.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bor ogwaŋ ma won otho, kosa m'ogwaŋ madudi oneko, inyalo oro ma giman je, to wikiripi camo adieri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.24",
            "verseOrgIds": [
              "LEV.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat'ocam bor mar'ogwaŋ m'omiyo paka mic m'iwaŋo gi mac ri Rwoth, lapokere kwoŋ ji pere. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.25",
            "verseOrgIds": [
              "LEV.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
