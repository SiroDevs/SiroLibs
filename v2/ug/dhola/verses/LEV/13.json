          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "jacway ri Were i wi migam bino oro jo lwoko gima two niye, to ketho gicen ma ndelo abirio man. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jacway ri Were i wi migam bino kikaŋasa gino k'otiek lwoko. K'adec ma two niye no fodi k'owiro cal, kada two fodi k'onyay, obedo gimakoc; iripo waŋo i mac, kad'obedi ni kama di dhowo nitie yucen kosa yuwiye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        }
      ]
    },
