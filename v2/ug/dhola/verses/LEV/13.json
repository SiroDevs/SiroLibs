          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka jacway ri Were i wi migam okaŋasa, to two fodi k'onyay i nanga, kam'odole, kosa i gimoro je ma pien, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
