            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.12"
              },
              "items": [
                {
                  "text": "Gal 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wikuri cik paran kodi or paran; ka witimo ameno, wilakwo: An abedo Rwoth.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.5",
            "verseOrgIds": [
              "LEV.18.5"
            ]
          }
        }
      ]
