            }
          ]
        },
        {
          "text": "Ikir'inindi g'ogwaŋ moro je t'iloko kwo perin makoc gine, aka dhako moro bende wokiri womiy kwo pere ri ogwaŋ nindo gine; obedo nywowirok.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
        }
      ]
