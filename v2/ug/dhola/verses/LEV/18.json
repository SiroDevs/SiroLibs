        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.18"
              },
              "items": [
                {
                  "text": "Jolevi 20:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikir'icore cegin gi dhako yawo kinyoro pere i koco pere ka ruko dwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.19",
            "verseOrgIds": [
              "LEV.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.10"
              },
              "items": [
                {
                  "text": "Jolevi 20:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikir'inindi gi cipa wat perin, t'iloko kwo perin makoc gi go. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.20",
            "verseOrgIds": [
              "LEV.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.1+LEV.20.2+LEV.20.3+LEV.20.4+LEV.20.5"
              },
              "items": [
                {
                  "text": "Jolevi 20:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikir'imiy nyathi perin kad'acel paka cowirok ri were Molek, aka wikiri wikoci nyingi Were mewin: An abedo Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.13"
              },
              "items": [
                {
                  "text": "Jolevi 20:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikir'inindi gi jacwo nyawotin paka gi dhako; obedo mienirok. ",
          "type": "text",
