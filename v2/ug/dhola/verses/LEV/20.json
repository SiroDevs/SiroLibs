                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.22"
              },
              "items": [
                {
                  "text": "Cik 27:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka jacwo moro onywomo nyamin, nyar bamere kosa nyar min, to yawo kinyoro pa nyamin, aka nyamin bende oyawo kinyoro pere, meno obedo giwickwot, woriem jo woko ruwaŋ ji pajo; go otieko ŋeyo kinyoro pa nyamin, go ripo tiŋo reco pere. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.17",
            "verseOrgIds": [
              "LEV.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.19"
              },
              "items": [
                {
                  "text": "Jolevi 18:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka jacwo moro onindo gi dhako ma ruko dwe, to yawo kinyoro pere, go otieko thango cwer remo pere aka dheno bende otieko thango cwer remo pere; joje wopok jo woko kwoŋ ji pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.12+LEV.18.13+LEV.18.14"
              },
              "items": [
                {
                  "text": "Jolevi 18:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikir'inindi gi nyamin yokin kosa wayin, rupiri meno rom gi thango wat perin won; iripo miyin gir'acula. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.19",
            "verseOrgIds": [
              "LEV.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka jacwo moro onindo gi cipa ner mere, meno go otieko neno kinyoro pa ner mere; iripo miyo jo gir'acula; jolatho ma jok'onywol. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.20",
            "verseOrgIds": [
              "LEV.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.16"
              },
              "items": [
                {
                  "text": "Jolevi 18:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka jacwo moro onywomo cip'omin, meno bedo gikoco, go otieko neno kinyoro p'omin; jok'onywol.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.21",
            "verseOrgIds": [
              "LEV.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.21",
            "verseOrgIds": [
              "LEV.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur win cik kodi or paran je, aka witim jo, ŋey lowo m'ater'iye win bed'iye wokiri woŋoki win woko. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.22",
            "verseOrgIds": [
              "LEV.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiri wiluw kula pa nono m'ariemo woko ruwaŋ win; kole jotimo gigipiny me je, t'adak jo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.23",
            "verseOrgIds": [
              "LEV.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka awaco riwin ni: Wilalunjo lowo pajo, alamiyo win wobedi mewin, lowo ma mol gi cak kodi mo kic. An abedo Rwoth Were mewin; atieko ketho win gicen kwoŋ nonin man. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.24",
            "verseOrgIds": [
              "LEV.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo riameno wiripo poko i dier ogwaŋ m'olony kodi makoc, kodi i dier winyo makoc kodi m'olony; wikiri wikel mienirok kwoŋ win g'ogwaŋ kosa winyo kosa cwec moro ma lak piny, m'atieko ketho gicen riwin paka koc. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.25",
            "verseOrgIds": [
              "LEV.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiripo bedo maleŋ ran; rupiri an Rwoth aleŋ, aka atieko ketho win gicen kwoŋ ji man bedo aparan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        }
      ]
    },
