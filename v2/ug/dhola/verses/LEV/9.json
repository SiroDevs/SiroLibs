              "LEV.9.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.22+NUM.6.23+NUM.6.24+NUM.6.25+NUM.6.26"
              },
              "items": [
                {
                  "text": "Kwan 6:22-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aron otiŋo cinge malo yubongi ji aka omiyo jo silwany. Aka go oloro piny munyo otieko timo cowirok ma mic ma cwako reco, mic awaŋa, kodi mic ma siem. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa kodi Aron jodonjo i Wema ma romo, aka jowok to jomiyo ji silwany aka dwoŋ pa Rwoth oneno ri ji je. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mac owok ruwaŋ Rwoth aka oumo migam ma mic awaŋa kodi bor; aka ji je joneno, jokoko, to jopodho piny gi nyim jo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.24",
            "verseOrgIds": [
              "LEV.9.24"
            ]
          }
        }
      ]
    }
