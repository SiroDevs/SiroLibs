            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.39.17+EZK.39.18+EZK.39.19+EZK.39.20"
              },
              "items": [
                {
                  "text": "Eze 39:17-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo aneno malaika moro ocungo wi waŋceŋ. Okoko gi dwonde ma malo ri winyin je m'onwaŋo jolakalaka wi hongo ni, “Biye win, aka cokere win kanyacel ri kalima pa Were madwoŋ! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
