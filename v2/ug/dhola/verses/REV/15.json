                  "text": "Isa 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ot pa Were oyido opoŋ yiro m'owok i dwoŋ kodi i meni pere, aka moro ongoye m'oyido nyalo donjo i Ot pa Were cuka i gik thoyamo abirio ma jomalaika abirio no di jokelo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.8",
