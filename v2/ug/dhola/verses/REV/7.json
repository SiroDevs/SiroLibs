                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.23"
              },
              "items": [
                {
                  "text": "Eze 34:23",
                  "type": "text"
                }
              ]
            },
            {
