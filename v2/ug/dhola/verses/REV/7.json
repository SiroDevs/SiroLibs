                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.10"
              },
              "items": [
                {
                  "text": "Isa 49:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.8"
              },
              "items": [
                {
                  "text": "25:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ato Nyathi rombo manitie i dier kom ma dhum, bino bedo jakwath pajo, bino leko jo to tero jo ruwaŋ pi ma kwo, aka Were bino yweyo woko pigi waŋ jo kicutho.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.17",
            "verseOrgIds": [
              "REV.7.17"
            ]
          }
        }
      ]
    }
