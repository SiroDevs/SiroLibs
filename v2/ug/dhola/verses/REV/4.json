              },
              "items": [
                {
                  "text": "Zek 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kom ma dhum no oyido wok pilin, kodi derino kodi mwoc pa lithkoth. Aka onwaŋo nitie talin abirio maliel ruwaŋ kom no, m'obedo cuny m'omakere abirio mapa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.22"
              },
              "items": [
                {
                  "text": "Eze 1:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.5+EZK.1.6+EZK.1.7+EZK.1.8+EZK.1.9+EZK.1.10"
              },
              "items": [
                {
                  "text": "1:5-10",
