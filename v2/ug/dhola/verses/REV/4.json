            "number": "1",
            "style": "v",
            "sid": "REV 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo me alimo menyirok man, aka aneno dhiot m'oyaw i polo. Aka dwondi jo m'oluwo gi derino paka gwara, m'onwaŋo atieko winjo con ka luwo kodan, owaco ni, “Biye ka, anyuthin gima bino timere rumacen.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.26+EZK.1.27+EZK.1.28"
              },
              "items": [
                {
                  "text": "Eze 1:26-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.1"
              },
              "items": [
                {
                  "text": "10:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Piyo piyo Cuny Maleŋ opoŋ kwoŋan, to kom pa Were ma dhum i polo bino ruwaŋan, kareno nitie ŋat'obed'iye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat'obedo no oyido liel pa tele manyarangi manyaboke pendi gi tele manyarangi m'obokere, aka thoko kom ma dhum oyido lifudo manyarangi manyaboke pendi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I thac m'othoko kom no onwaŋo nitie kombere piero ario g'aŋwen man, ma jodongo piero ario g'aŋwen i ruk matar jobed'iye, aka joruko sangaria ma zahabu i wiy jo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
