                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waŋkac ma tindi kilacego odieceŋ, odoko kada colo ma wor k'obedi kenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
