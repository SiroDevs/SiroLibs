          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waŋkac apar g'ario no obedo ma tele ma welo, kisi thigo gi tele m'opokere. Royo ma tindi obedo ma zahabu, maler pa ndewiro.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.21",
            "verseOrgIds": [
              "REV.21.21"
            ]
          }
        }
      ]
