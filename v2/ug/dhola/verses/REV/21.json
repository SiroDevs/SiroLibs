                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ji ma piny jobino woth i lero pere, aka kerin ma piny jobino kelo ŋaŋo pajo i iye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.24",
