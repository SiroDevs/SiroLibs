                  "text": "Isa 60:19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tindi no kiyeny ceŋ kosa dwe wokel'iye lero, rupiri dwoŋ pa Were am'obedo lero mere, aka Nyathi rombo a tala mere. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
            "verseOrgIds": [
              "REV.21.23"
            ]
