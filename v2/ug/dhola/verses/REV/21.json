              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akineno Ot pa Were i tindi, rupiri Ot mere obedo Rwoth Were Majameni je, kodi Nyathi rombo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.22",
            "verseOrgIds": [
              "REV.21.22"
            ]
          }
