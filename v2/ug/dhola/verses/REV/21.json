                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.22"
              },
              "items": [
                {
                  "text": "66:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.13"
              },
              "items": [
                {
                  "text": "2 Pet 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo aneno polo manyen kodi piny manyen. Ato polo kodi piny marapena oyido joleny woko, aka nam orere woko. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.1"
              },
              "items": [
                {
                  "text": "Isa 52:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.12"
              },
              "items": [
                {
                  "text": "Meny 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.10"
              },
              "items": [
                {
                  "text": "Isa 61:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo aneno Tindi Maleŋ, Yerusalem manyen, munyo loro piny wok i polo bongi Were, m'oyik maŋon paka mweha m'orukere maŋon ka yikere romo gi rwoth pere. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.27"
              },
              "items": [
                {
                  "text": "Eze 37:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.11"
              },
              "items": [
                {
                  "text": "Jolevi 26:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awinjo dwondi nyatoro ma luwo malo munyo waco wi kom ma dhum ni, “Pama peco pa Were nitie gi ji! Go bino bedo gi jo, aka jobino bedo ji pere. Were won bino bedo gi jo, aka bino bedo Were pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.3",
            "verseOrgIds": [
              "REV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.8"
              },
              "items": [
                {
                  "text": "Isa 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.10"
              },
              "items": [
                {
                  "text": "Isa 35:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.19"
              },
              "items": [
                {
                  "text": "65:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go bino yweyo pigi waŋ jo. Tho odoko k'obedi, kosa rembo, kosa ywak kosa litho, rupiri gigipiny macon jotieko leny woko.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo ŋat'oyido obedo wi kom ma dhum owaco ni, “Onyo pama aloko gigipiny je manyen!” Go owaco ran kendo ni, “Ndiki gime, rupiri wac me obedo mar'adieri aka genere.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.5",
            "verseOrgIds": [
              "REV.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Isa 55:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka owaco ran ni, “Otieko timere! An a Alifa kodi Omega, cakirok kodi gike. Ŋata riyo neko abino miyo pi amadha ma nono ma wok i waŋ pi ma kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.6",
            "verseOrgIds": [
              "REV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.14"
              },
              "items": [
                {
                  "text": "2 Sam 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.27+PSA.89.28"
              },
              "items": [
                {
                  "text": "Zab 89:27-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ŋat'oloy lweny bino limo gime je. Abino bedo Were pere, aka go bino bedo wodan. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.7",
            "verseOrgIds": [
              "REV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "To joma lwor, joma jok'oyeyo, joreco, jonek, jocot, jothieth gi yido, joma lamo cal makicar, kodi jotwodo je, kabedo pajo bino bedo wakawaka mac ma waŋ gi telin ma wodho mac kibiriti, m'obedo tho mar'ario.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yerusalem manyen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acel kwoŋ jomalaika abirio m'onwaŋo jonitie kodi atewe abirio ma thoyamo opoŋ'iye obino bongan to waco ni, “Biye anyuthin Mweha, cipa Nyathi rombo.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.9",
            "verseOrgIds": [
              "REV.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.2"
              },
              "items": [
                {
                  "text": "Eze 40:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo malaika no otiŋan i cuny to teran wi got mabor tektek. Go onyuthan Yerusalem, Tindi Maleŋ, munyo loro piny wok i polo bongi Were, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.10",
            "verseOrgIds": [
              "REV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "maliel gi dwoŋ pa Were. Tindi no omeny pa ge ma welo, pa tele manyaboke pendi, maler pa ndewiro. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.11",
            "verseOrgIds": [
              "REV.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.30+EZK.48.31+EZK.48.32+EZK.48.33+EZK.48.34+EZK.48.35"
              },
              "items": [
                {
                  "text": "Eze 48:30-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go obedo gi cel m'othoko ma kore pek aka oŋawere malo, kodi waŋkac apar g'ario, kodi jomalaika apar g'ario ma jokuro kisi waŋkac. Kwoŋ kisi waŋkac ondiki nyingi nonin apar g'ario ma Isiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.12",
            "verseOrgIds": [
              "REV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka obedo gi waŋkac adek i kisi thenge. Adek yuwok ceŋ, adek yupiny, adek yumalo, adek yupodho ceŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.13",
            "verseOrgIds": [
              "REV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cel ma tindi no oger wi telin apar g'ario, m'ondik'iye nyingi jomoor pa Nyathi rombo apar g'ario.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.14",
            "verseOrgIds": [
              "REV.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.14",
            "verseOrgIds": [
              "REV.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.3"
              },
              "items": [
                {
                  "text": "Eze 40:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika m'oluwo kodan oyido nitie gi luth rapor ma zahabu, ma kipima tindi, kodi waŋkac mere, kodi cel m'ogeti thoko go. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tindi no oyido nyathenge aŋwen marom; boro mere rom kodi laco mere. Malaika opima tindi no kodi luth rapor pere no. Boro mere onwaŋo romo mayiro gana acel gi miya aŋwen; aka laco mere, kodi ŋawirok mere, kodi boro mere je oyido jorom aroma. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika no opima kor cel, aka ŋawirok mere oyido romo tiendi jo miya acel gi piero aŋwen g'aŋwen, cungo kwoŋ rapor ma noknok m'oyido go oro (fut 200). ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.17",
            "verseOrgIds": [
              "REV.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.11+ISA.54.12"
              },
              "items": [
                {
                  "text": "Isa 54:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kor cel no otim gi tele manyaboke pendi, aka tindi won gipi otim gi zahabu, maler pa ndewiro. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.18",
            "verseOrgIds": [
              "REV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tele ma tiendi cel ma tindi otim makicin kodi telin ma welo m'opokere opokere. Tele marapena ma tiendi cel obedo ma tele manyaboke pendi m'obokere obokere; mar'ario tele manyabululu; mar'adek tele matar m'oruwo rangi akwaro; mar'aŋwen tele manyarangi nam. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.19",
            "verseOrgIds": [
              "REV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mar'abic tele m'obokere, mar'aucel manyatongweno, mar'abirio tele manyarangi zahabu, mar'aboro tele manyarangi nam. Mar'abuŋwen tele manyatongweno, mar'apar tele manyarangi apo, mar'apar g'acel tele m'obokere nyamicungwa, aka mar'apar g'ario tele manyarangi orandi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.20",
            "verseOrgIds": [
              "REV.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
