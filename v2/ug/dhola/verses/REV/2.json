            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1+NUM.25.2+NUM.25.3"
              },
              "items": [
                {
                  "text": "Kwan 25:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To me a gigipiny manok m'anwaŋo kwoŋin ma k'otire: Winitie gi jomoro i dier win kenyo ma joluwo fonji pa Balam, m'ofonjo Balak nger ma ywayo cuny ji ma Isiraili jowotimi gimarac munyo jocamo riŋo m'ocow gine cal pa werin makicar, gi timo cot. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meno apaka wibende winitie gi joma joluwo fonji pa Nikola i dier win. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo ŋuti win kwoŋ reco mewin! Kak'ameno alabino bongi win mayot t'alwenyo gi jono kodi abor ma wok i dhokan.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
            "verseOrgIds": [
              "REV.2.16"
            ]
          }
        }
      ]
