                  "text": "65:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Am'omiyo, ŋata nitie gi ithe, wowinji gima Cuny waco ri kitipin pa jom'oyeyo!",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.17",
            "verseOrgIds": [
              "REV.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋata loyo karatem abino miyo go cemo m'opan m'ilwoŋo ni mana. Abino bende miyo go tele matar, m'ondik'iye nyingi jo Manyen, ma ŋat'omiy gino kende ama won ŋeyo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.17",
            "verseOrgIds": [
              "REV.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mikwenda ri Thiatira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.17",
            "verseOrgIds": [
              "REV.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ri malaika ma kitipa pa jom'oyeyo ma Thiatira ndiki ama: Me mikwenda ma wok bongi Wod Were, ma waŋe liel pa mac, ma tiende pilin pa nyweny ywel m'orudi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋeyo tim perin, mar kodi yeyo perin, tic perin gi ciro candirok perin, odoko aŋeyo ni pama onyo imedo tic loyo kam'icak'iye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.19",
            "verseOrgIds": [
              "REV.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.31"
              },
              "items": [
                {
                  "text": "1 Kerin 16:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.22"
              },
              "items": [
                {
                  "text": "2 Kerin 9:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To gim'anwaŋo kwoŋin marac a me: Ijolo dhako ma nyinge Yezebel, ma won lwoŋere ni jatuci wac pa Were aka fonjo odoko bano jotic paran i timo tim ma wickwot gi camo riŋo m'ocow gine cal pa werin makicar. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.20",
            "verseOrgIds": [
              "REV.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atieko miyo go hongo ma weyo woko reco pere, to go kimiti weyo tim pere ma wickwot. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.21",
            "verseOrgIds": [
              "REV.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri ineni! Abino pielo go wi kitanda ma candirok, aka abino miyo jom'oyido jotimo gine cot bedo i candirok malith, kwanyo woko ka joŋuto gigipiny mareco ma jotimo gi go. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
            "verseOrgIds": [
              "REV.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "REV 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.7.9"
              },
              "items": [
                {
                  "text": "Zab 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.10"
              },
              "items": [
                {
                  "text": "Yer 17:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.62.12"
              },
              "items": [
                {
                  "text": "Zab 62:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abino kisika nyithindho pere bende, aka kitipin pa jom'oyeyo je jobino ŋeyo nike a jameny cuny ji gi ŋeyo paro pa ji. Abino culo kisi dhano kwoŋ win cungo kwoŋ gima go otimo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "REV 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "REV 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "To jom'odoŋ kwoŋ win i Thiatira, ma jokiluwi fonji pere no aka fodi jok'ofonjere rieko pa Sitan ma jolwoŋo ni, “Nyaliŋliŋ mathuth.” Onyo awaco riwin ni ak'okethi peko man kwoŋ win. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "To maki win matek gima winigine cuka anobin. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
              "REV.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "REV 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.8+PSA.2.9"
              },
              "items": [
                {
                  "text": "Zab 2:8-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ri ŋata loyo karatem, ma medere gi timo gim'amito kiri i gike, abino miyo go meni ma dhumo piny; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.26",
            "verseOrgIds": [
              "REV.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "REV 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "go bino dhumo jo gi luth ma nyweny to ŋinyo jo woko pa degi ma lowo, paka awon atieko nwaŋo meni ma dhum bongi Baba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.27",
            "verseOrgIds": [
              "REV.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "REV 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka abino miyo go sulwe m'odikin. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.28",
            "verseOrgIds": [
              "REV.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "REV 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋata nigi ithe, wowinji gima Cuny waco ri kitipin pa jom'oyeyo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.29",
            "verseOrgIds": [
              "REV.2.29"
            ]
          }
        }
      ]
