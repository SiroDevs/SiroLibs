                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Am'omiyo, ŋata nigi ithe, wowinji gima Cuny waco ri kitipin pa jom'oyeyo! Ri joma joloyo karatem abino miyo jo meni ma camo yath ma kwo manitie i Ndelo pa Were.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        }
