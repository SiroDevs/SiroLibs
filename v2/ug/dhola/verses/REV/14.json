                {
                  "text": "Eze 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Meny 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo aŋiyo, t'aneno Nyathi rombo ruwaŋan, munyo ocungo wi got Zayon. Bonge, oyido nitie ji gana miya acel piero aŋwen g'aŋwen (144,000) ma nyinge kodi nyingi Bamere ondiki ruwaŋ jo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.1",
            "verseOrgIds": [
              "REV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka awinjo derino ma cale pi ma mol piyo piyo, kendo pa lithkoth ma mor. Derino no ocale pa wer ma jotongol jogoyo i tongol pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.2",
            "verseOrgIds": [
              "REV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyido jowero wer manyen, ruwaŋ kom pa Were ma dhum no kodi cwec aŋwen no kodi jodongo no, aka jowero wer manyen ma ŋatiman je k'onyalo fonjirok kwanyo woko ji gana miya acel piero aŋwen g'aŋwen (144,000) m'onyew jo gi remo pa Yesu wok i piny. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.3",
            "verseOrgIds": [
              "REV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meno ji ma jokure maber ma jok'otimo cot gi mon. Joluwo Nyathi rombo kama go kidh'iye je; ogony jo wok kwoŋ ji je m'odoŋ aka jobedo pa kodhi m'onyak marapena m'omiy Were kodi Nyathi rombo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.4",
            "verseOrgIds": [
              "REV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.13"
              },
              "items": [
                {
                  "text": "Zef 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Twodo k'onwaŋere i dhok jo; jongoye gi reco ma di kwan rijo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jomalaika adek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo aneno malaika man munyo ringo i koyo, gi mikwenda ma cil gi cil ma Wac Manyen Maber ma wotiti ri ji ma jonitie i piny, ri piny je, nonin, dhodhok kodi ji je! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.6",
            "verseOrgIds": [
              "REV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go owaco gi dwonde ma malo ni, “Lwor win Were, aka paki win dwoŋ pere! Kole ndir otundo rigo ma thumo banja ri ji. Am'omiyo, lami win Were m'ocweyo polo, piny, nam, kodi waŋ pi!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.7",
            "verseOrgIds": [
              "REV.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
