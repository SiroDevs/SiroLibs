        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.7",
            "verseOrgIds": [
              "REV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
