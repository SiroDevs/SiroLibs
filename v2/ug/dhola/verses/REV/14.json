        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.12",
            "verseOrgIds": [
              "REV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo awinjo dwondi nyatoro m'owok i polo munyo waco ni, “Ndiki gime: Josilwany a joma wok pama kadho yumalo jolatho i tic pa Rwoth.” “Ey,” Cuny waco, “Jobino ywomirok kwoŋ tic pajo matek, rupiri tim pajo luwo jo.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.13",
            "verseOrgIds": [
              "REV.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keco gima nitie i Piny",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
