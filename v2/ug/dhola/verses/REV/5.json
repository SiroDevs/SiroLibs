                "loc": "GEN.49.9"
              },
              "items": [
                {
                  "text": "Cak 49:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.1"
              },
              "items": [
                {
                  "text": "Isa 11:1",
                  "type": "text"
