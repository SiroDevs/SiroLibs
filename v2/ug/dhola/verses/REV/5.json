              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka awinjo cwec je ma polo, ma piny, kodi ma pendi lowo, kodi cwec je ma nam, gi cwec je ma polo gi piny munyo jowero ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        }
