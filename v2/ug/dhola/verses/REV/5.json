                "loc": "ISA.11.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo acel kwoŋ jodongo no owaco ran ni, “Ikir'iywak. Panen! Simbwor ma nono pa Yuda, nyakwar Daudi otieko loyo lweny aka go nyalo halo woko gimwono abirio m'othore no je to yawo kitawo no.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        }
      ]
    },
