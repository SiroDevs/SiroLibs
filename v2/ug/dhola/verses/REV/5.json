              "type": "text"
            }
          ]
        },
        {
          "text": "Odoko aneno, aka awinjo dwondi jomalaika gana gi gana! Jocungo jothoko kom ma dhum, kodi cwec aŋwen no, kodi jodongo no, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.11",
            "verseOrgIds": [
              "REV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "to jowero gi dwondi jo ma malo ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        }
      ]
    },
