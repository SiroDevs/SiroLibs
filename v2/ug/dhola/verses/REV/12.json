                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.9"
              },
              "items": [
                {
                  "text": "Yud 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo lweny oere i polo! Mikaili kodi jomalaika pere jolwenyo gi bulir, ma bende olwenyo kodi jomalaika pere. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "To oloy bulir, t'iriemo go woko kodi jomalaika pere i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1"
              },
              "items": [
                {
                  "text": "Cak 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.18"
              },
              "items": [
                {
                  "text": "Luk 10:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bulir m'ombo no owit woko! Go a thwol macon ca, m'ilwoŋo ni Jwogi, kosa Sitan, m'owondo piny gipi. Owit go piny wi lowo gi jomalaika pere je.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        }
      ]
    },
