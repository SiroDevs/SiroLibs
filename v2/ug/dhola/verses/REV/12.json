                "loc": "DAN.7.7"
              },
              "items": [
                {
                  "text": "Dan 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ranyuth man onenere i polo ma bulir m'ombo m'obokere gi wic abirio kodi tunge apar, kodi sangaria i wiye abirio je. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.3",
            "verseOrgIds": [
              "REV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.10"
              },
              "items": [
                {
                  "text": "Dan 8:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go owaro woko gi yiwe acel wiy adek ma micalin ma i hongo to rwadho jo piny i lowo. Go ocungo ruwaŋ dhako m'oyido cegin nywol no, ni womwonyi nyathi pere tekin podho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.4",
            "verseOrgIds": [
              "REV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.7"
              },
              "items": [
                {
                  "text": "Isa 66:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.9"
              },
              "items": [
                {
                  "text": "Zab 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo dhako no onywolo wode, ma bino dhumo nonin je gi luth ma nyweny. To, oyudhi nyathi no t'itero bongi Were kama di kom pere ma dhum. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.5",
            "verseOrgIds": [
              "REV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo dhako no oringo i thim; Were oyido oyiko rigo kabedo kenyo, kam'ibino kur'iye go cowo hongo ma ndelo gana acel miya ario gi piero aucel.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.6",
            "verseOrgIds": [
              "REV.12.6"
            ]
          }
        }
      ]
    },
