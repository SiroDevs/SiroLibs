              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo jomalaika abirio kodi gwarin pajo abirio joyikere cako kudho.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
