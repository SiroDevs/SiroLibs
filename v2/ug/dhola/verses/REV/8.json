              "items": [
                {
                  "text": "16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo malaika no okwanyo giketho cuk no, opoŋ'iye mac wok i migam to wok to bolo i piny. Gino omwoc pa lithkoth gi derino, gi pilin pa koth, kodi yengirok pa piny.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
