                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika man m'onwaŋo nitie kodi giketho cuk mac ma waŋo buban, m'otimi gi zahabu, obino to cungo cegin gi migam. Omiy go buban madit ma womedi gi kwayo pa ji maleŋ pa Were aka wocwayi wi migam ma zahabu ma dho kom ma dhum. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiro m'owok i buban ma waŋ, kanyacel gi kwayo pa ji maleŋ pa Were, oidho malo bongi Were wok i cingi malaika no. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
