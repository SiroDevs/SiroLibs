              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo malaika mar'ario okudho gwara pere, to gimoro ma cale got madwoŋ, maliel mac, bolere i nam. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acel wiy adek ma nam olokere remo, acel wiy adek ma gigipiny makwo je ma pi jotho woko, to acel wiy adek ma mel je nyekere woko.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
