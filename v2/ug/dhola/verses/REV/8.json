            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo malaika mar'adek okudho gwara pere, to micala m'ombo, maliel pa mac odingili gore piny wok i polo, aka opodho wi acel wiy adek ma wakawaka, kodi i waŋ pi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
