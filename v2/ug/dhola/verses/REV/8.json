              },
              "items": [
                {
                  "text": "Yer 9:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyingi micala no obedo Keco. Acel wiy adek ma pi olokere makec, to ji mathoth jotho ro madho pi makec no.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
