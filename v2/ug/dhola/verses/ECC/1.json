            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atieko luwo g'adundo paran ni, “E atieko nwaŋo rieko madwoŋ, maloyo apa kisi dhano je m'open bedo ran i Yerusalem gipi aka cunyan otieko neno rieko gi ŋeyo mathoth. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka amiyo cunyan ŋeyo rieko gi ŋeyo neko gi miŋo. Aniaŋ ni me bende obedo riemo koyo.”",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
          }
        }
      ]
