{
  "id": "PHP.4",
  "number": "4",
  "bookId": "PHP",
  "reference": "Jofilipi 4",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PHP 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fonji ma medo miseni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo, wutmera, amaro win swa, aka akeŋ win tektek. Ka wicungo ma wicwiny i Rwoth, merin paran, meno a kisangala paran.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.1",
            "verseOrgIds": [
              "PHP.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.1",
            "verseOrgIds": [
              "PHP.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yudia kodi Sintike, mondo, akwayo win, tem win yerok paka nyimere i Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.2",
            "verseOrgIds": [
              "PHP.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka in bende, jatic nyawotan ma genere, amito ikony mon me; kole jotieko tic matek kodan i nyayo Wac Manyen Maber, kanyacel gi Kelementi kodi jotic jowotan je, ma nyingi jo nitie i kitawo ma kwo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.3",
            "verseOrgIds": [
              "PHP.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.3",
            "verseOrgIds": [
              "PHP.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sangala win i Rwoth noknok; adoko awaco ni sangala win! ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.4",
            "verseOrgIds": [
              "PHP.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuthi win mwolo ri ji je. Rwoth bino mayot. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.5",
            "verseOrgIds": [
              "PHP.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiri wirembi ri gimoro je, to i kisi gimoro waci win ri Were gima wiyenyo, munyo wikwayo aka wiywakere rigo gi foyo i cuny win. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.6",
            "verseOrgIds": [
              "PHP.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka siem pa Were ma kalo kama dhano oŋey'iye je, bino kuro paro mewin gi cuny win maber, i Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
              "PHP.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
              "PHP.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Macowe, wutmera, poŋ win i paro mewin gigipiny mabeyo m'ipako me: Gigipiny mar'adieri, ma didwoŋ, m'otire, m'olony, maber amara, kodi maŋon. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.8",
            "verseOrgIds": [
              "PHP.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kethi win i tim gima wifonjere kosa winwaŋo bongan, ma wok i wac paran kodi i tim paran. Aka Were ma poko siem bino bedo gi win.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.9",
            "verseOrgIds": [
              "PHP.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Foyo mic",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.9",
            "verseOrgIds": [
              "PHP.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anitie gi kisangala madwoŋ m'oasere i Rwoth, ni wilimo hongo ma nyutho paka wiparo kwoŋan. Adieri oyido wiparo kwoŋan, to oyido fodi wikilimo hongo ma nyutho ayino. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.10",
            "verseOrgIds": [
              "PHP.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka akiwaci ama ni rupiri nitie gim'ayenyo; kole atieko fonjere ŋiyo kodi gima an gine. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.11",
            "verseOrgIds": [
              "PHP.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋeyo dwoŋ bedo m'acando gimoro, kodi dwoŋ bedo gi gigipiny m'ayenyo ma romo. Atieko fonjere nyaliŋliŋ ma diyo cunyan kamoro je, hongo moro je, kad'ayeŋ kosa an gi kec, kad'amore gi gigipiny kosa anitie gi manok. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.12",
            "verseOrgIds": [
              "PHP.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyalo timo gimoro je i Kristo ma miyan meni.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.13",
            "verseOrgIds": [
              "PHP.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.13",
            "verseOrgIds": [
              "PHP.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "To obedo maber swa munyo wikonyan i teko paran. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.14",
            "verseOrgIds": [
              "PHP.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka win Jofilipi wiwegi wiŋeyo maber ni munyo aweyo Makedonia, i ndir m'acako fonj'iye win Wac Manyen Maber, win kende oyido a kitipa pa jom'oyeyo ma joriwere kodan i poko kodi jolo gimoro. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.15",
            "verseOrgIds": [
              "PHP.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.1"
              },
              "items": [
                {
                  "text": "Tim 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.16",
            "verseOrgIds": [
              "PHP.4.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.9"
              },
              "items": [
                {
                  "text": "2 Kor 11:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kiri munyo oyido anitie Thesalonika, widhiro ran kony ma kalo dicel. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.16",
            "verseOrgIds": [
              "PHP.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'obedo nike arango limo mic; to amito ni womedi win magowa i migowe kani mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.17",
            "verseOrgIds": [
              "PHP.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.18"
              },
              "items": [
                {
                  "text": "Wok 29:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atieko limo cul je, kiri gi kalo; an gi gimoro je ma yenyo, paka Epafrodito otieko kelo ran mic mewin je. Gik piny me cale mic maŋwe kur, cowirok ma jolere aka sangala Were. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.18",
            "verseOrgIds": [
              "PHP.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka Were paran bino miyo win gimoro je ma wiyenyo, wok kwoŋ ŋaŋo pere gi dwoŋ pere i Kristo Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.19",
            "verseOrgIds": [
              "PHP.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwoŋ wobedi ri Were Baba cil gi cil. Ameno.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.20",
            "verseOrgIds": [
              "PHP.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moth macowe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.20",
            "verseOrgIds": [
              "PHP.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mothi ran ji pa Were je ma jonitie i Kristo Yesu. Wutmera gi nyimera ma jonitie ka kodan jom'otho win. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.21",
            "verseOrgIds": [
              "PHP.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji pa Were je ma ka, tektek jopeco pa kere Kayisar, jom'otho win.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.22",
            "verseOrgIds": [
              "PHP.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.22",
            "verseOrgIds": [
              "PHP.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weyi nema pa Rwodhiwan Yesu Kristo wobedi kodi wijoje.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.23",
            "verseOrgIds": [
              "PHP.4.23"
            ]
          }
        }
      ]
    }
  ],
