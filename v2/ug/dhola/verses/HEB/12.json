              },
              "items": [
                {
                  "text": "Wok 19:12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "rupiri jok'onyalo ciro gim'owaci ni, “Ka kad'ogwaŋ ogeyo got no, ripo wogoy gi tele cuka wotho.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
          }
        },
