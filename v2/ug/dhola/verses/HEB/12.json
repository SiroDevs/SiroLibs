              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo, gwokere win aka wikiri wikwer winjo ŋata luwo. K'inen joma jokwero winjo ŋat'oluwo munyo fonjo jo kwoŋ gwokirok i piny ka jok'oboth, onyo waŋati wanobothi nedi ka wawiro ŋey wan ri ŋata luwo m'owok i polo ma mito ni wagwokere! ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 12:26"
          },
          "items": [
