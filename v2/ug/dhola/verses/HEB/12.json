                "loc": "GEN.4.10"
              },
              "items": [
                {
                  "text": "Cak 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wibino bongi Yesu, m'ocano cikirok manyen, kodi gi bongi remo ma nyutho wac maber loyo remo pa Abel.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.24",
            "verseOrgIds": [
              "HEB.12.24"
            ]
          }
        }
