              "items": [
                {
                  "text": "Cik 9:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gima joneno kenyo onwaŋo miyo jo lworo m'omiyo Musa owaco ni, “Kole akirin aka lworo omakan!”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
            "verseOrgIds": [
              "HEB.12.21"
            ]
          }
        }
      ]
