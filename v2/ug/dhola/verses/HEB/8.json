              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.1",
            "verseOrgIds": [
              "HEB.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Zab 110:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me a gimadwoŋ kwoŋ gima wawaco: Wanitie gi jadwoŋ pa jocway ri Were i wi migam, ma kiti dwoŋ pere omiyo go bedo yuracuc ma kom ma dhum pa Were Madwoŋ Ma urere i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.1",
            "verseOrgIds": [
              "HEB.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka go tiyo paka jadwoŋ pa jocway ri Were i wi migam i Kabedo Maleŋ M'oasere, m'obedo wema mar'adieri ma Rwoth ama ogero, makiweno dhano.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisi jadwoŋ pa jocway ri Were i wi migam je okethi ni wocwayi mic kodi le paka cowirok ri Were: Am'omiyo jadwoŋ pa jocway ri Were i wi migam me bende oyido ripo bedo kodi gi mic m'amiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.3",
            "verseOrgIds": [
              "HEB.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bedi go nitie i piny ka, dikibedi jacway ri Were i wi migam, rupiri nitie joman ma jocwayo mic i Cik pa Joyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.4",
            "verseOrgIds": [
              "HEB.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.40"
              },
              "items": [
                {
                  "text": "Wok 25:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jono jocwayo i kalamo pa Joyuda m'obedo nyaka cal kodi tipo pa gima nitie i polo. Meno am'omiyo ocik Musa munyo go oyido cegin gero wema pa Were ni, “Neni nike itimo gimoro je i cal m'onyuthin wi got.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "To, paka nitie, omiy Kristo tic ma bedo jadwoŋ pa jocway ri Were i wi migam madwoŋ swa loyo apajo, paka cikirok ma go otimo i dier ji kodi Were bende ber loyo macon, kwoŋbedo ocungo kwoŋ cikirok ma gigipiny mabeyo loyo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bedi raco moro oyido ongoye i cikirok marapena, di mar'ario k'oyenyere. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
              "HEB.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.31+JER.31.32+JER.31.33+JER.31.34"
              },
              "items": [
                {
                  "text": "Yer 31:31-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To Were onwaŋo raco kwoŋe am'omiyo owaco ama:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.12",
            "verseOrgIds": [
              "HEB.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo oluwo kwoŋ cikirok manyen me, Were oloko marapena ca gima orumo tic; aka gimoro je m'orumo tic aka otieko ti, bino rere woko.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.13",
            "verseOrgIds": [
              "HEB.8.13"
            ]
          }
        }
      ]
    }
