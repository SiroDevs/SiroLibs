                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kole ŋata kiwinji Cik pa Musa ineko m'ongoye wor ka otiek thumo banja loyo go, cungo kwoŋ jokony ario kosa adek ma joridho ni go otimo reco. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.28",
            "verseOrgIds": [
              "HEB.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.8"
              },
              "items": [
                {
                  "text": "Wok 24:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Onyo wiparo ni ŋata cayo Wod Were, to tero paka gima sisiri remo ma cikirok pa Were m'oloko go maleŋ, aka miyo Cuny ma kelo nema nge, di ripi gi gir'acula marac loyo didi? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.29",
            "verseOrgIds": [
              "HEB.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.35"
              },
              "items": [
                {
                  "text": "Cik 32:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.36"
              },
              "items": [
                {
                  "text": "Cik 32:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kole waŋeyo ŋat'owaco ni, “Abedo jaculi kwor, abino culo kwor.” Ma bende owaco ni, “Rwoth bino thumo banja ri ji pere.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedo gilworo madwoŋ swa ka nyatoro opodho i cingi Were makwo!",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
