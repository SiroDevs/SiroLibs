          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno go olokere madwoŋ loyo jomalaika, paka nyinge ma Were omiyo go loyo apajo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
