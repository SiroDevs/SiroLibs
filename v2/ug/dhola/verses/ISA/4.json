          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labedo tipo ma bwok kwoŋ lietho m'odieceŋ, kapondo gi kabwok kwoŋ asur gi koth.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
