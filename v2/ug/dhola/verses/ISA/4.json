              "items": [
                {
                  "text": "24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyaka Rwoth lacweyo i kabedo ma Got Zayon niye gi cokirok mere pondeponde odieceŋ gi yiro kodi mac maliel wor. Dwoŋ pa Were laumo to kwonga tindi madwoŋ gibe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
