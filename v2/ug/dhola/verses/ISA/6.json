              "items": [
                {
                  "text": "2 Kigana 26:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I oro ma Kere Uziya otho i iye, aneno Rwoth obedo i kom pere ma dhum, malo aka otiŋere malo, aka kanzu pere opoŋo Ot pa Were gipi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thoko go oyido nitie cwec ma jobwombi gin m'ilwoŋo ni Serafim; kisi acel oyido nigi bwombe aucel. Kisi cwec oyido umo waŋe gi bwombe ario, umo kwoŋe gi bwombe ario, aka ay gi bwombe ario. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Meny 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acel oyido lwoŋo nyawote to waco ni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
