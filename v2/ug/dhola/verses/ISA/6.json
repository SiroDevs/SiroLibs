              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Derino ma dwondi jo omiyo kindi miango ma dhiot yengirok, aka yiro opoŋ i Ot pa Were.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo awaco ni, “Kidamba ran! Kole arwenyo, kole abedo jacwo ma dhoke koc, aka abedo i dier ji ma dhok gin koc, kucel waŋan otieko neno Kere, Rwoth pa lwak jolweny!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
