        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo acel kwoŋ cwec ma jabwombe oay to pie kwoŋan, oyido otiŋo cuk mac i cinge m'okwanyo wok i migam gi lew tala ario.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogeyo dhokan gi cuk mac aka owaco ni, “Neni ee, paka gime ogeyo dhokin, okwanyo woko banja perin, aka reco perin ocwaki.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
