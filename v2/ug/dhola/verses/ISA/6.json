          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adwoko ni, “An e! Oran!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        }
