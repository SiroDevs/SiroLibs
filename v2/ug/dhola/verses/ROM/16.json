                  "text": "Tim 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timothe, jatic nyawotan, bende dhiro riwin moth; kanyacel gi Lukio, Yason kodi Sosipata, Joyuda jowotan.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        }
      ]
