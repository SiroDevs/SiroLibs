            "number": "5",
            "style": "v",
            "sid": "ROM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.5",
            "verseOrgIds": [
              "ROM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
