              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.17"
              },
              "items": [
                {
                  "text": "Mar 12:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.25"
              },
              "items": [
                {
                  "text": "Luk 20:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Meno bende am'omiyo wiripo goyo misolo, rupiri rwodhe jotiyo ri Were ka jotimo tic pajo no. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.6",
            "verseOrgIds": [
              "ROM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo, cul win gima wiripo culo dhano; cul misolo perin bongi ŋat'iripo culo, kodi lim perin bende ameno; aka wor win ŋata ripo awora, odoko miy dhano je dwoŋ, ma ripo amiya dwoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gir'atima i dier win wegi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiri wibedi gi banja pa dhano moro je. Nyaka banja ma wiripo bedo gine meno a marok i dier win. Nyatoro je m'omaro nyawote meno otieko winjo Cik. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.8",
            "verseOrgIds": [
              "ROM.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
