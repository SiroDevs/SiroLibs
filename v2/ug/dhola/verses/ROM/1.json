              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paka ji jomiŋ ameno, Were ojala jo jowotimi gigipiny mareco ma cuny jo yenyo, aka jotimo gigipiny ma kelo wickwot i del pajo, ŋatiman gi nyawote. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.24",
            "verseOrgIds": [
              "ROM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jowilo adieri kwoŋ Were gi twodo; jolamo aka jotiyo ri gima Were ocweyo kapa lamo Jacwec won, m'iripo pako cil gi cil. Ameno.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.25",
            "verseOrgIds": [
              "ROM.1.25"
            ]
          }
        }
      ]
