          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paka ji jokwero ketho i paro pajo rieko mar'adieri ma mako kwoŋ Were, go onyo ojala jo ri paro m'otop, ma miyo jo timo gim'oyido jokiripi timo.",
          "type": "text",
