              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jopoŋ gi kidakana ma nger je: Raco, woro, kodi camo tiendi ji gi piny. Jopoŋ gi nyeko, neki, gorok, twodo, gi paro marac. Jonyeko nyingi wadi gin, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka joluwo kicar kwoŋ ji; jodak Were, joyetere, jobedo jopakirok, jokwoto; joparo yo m'omore ma timo reco; aka jokiwinji jonywol pajo; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "jodakana, jokikur cikirok pajo, jokinyuthi wor odoko jokidew kwoŋ nyatoro. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
