          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jorem swa ro wac pere ni odoko jok'oneni go kendo. Rumacen to jokwaŋo go i ye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.38",
