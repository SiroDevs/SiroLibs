        },
        {
          "text": "Aka munyo jotieko timo gimoro je ma Ndiko Maleŋ luwo kwoŋe, jogamo go kwoŋ musalaba to joketho go i kaliel. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.29",
            "verseOrgIds": [
