                "loc": "PSA.2.7"
              },
              "items": [
                {
                  "text": "Zab 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka onyo bende wakelo riwin Wac Manyen Maber no. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.32",
            "verseOrgIds": [
              "ACT.13.32"
            ]
          }
        },
        {
          "name": "verse",
