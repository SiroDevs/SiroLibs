          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Were ocerino go kwoŋ jom'otho, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.30",
            "verseOrgIds": [
              "ACT.13.30"
