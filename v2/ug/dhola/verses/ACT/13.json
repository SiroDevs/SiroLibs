          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima Were ociko kwarere mawan nike d'otimo, pama go otieko timo riwan ma wabedo nyikway jo, munyo ocerino Yesu paka ondiki i Zabuli mar'ario ni,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        }
      ]
