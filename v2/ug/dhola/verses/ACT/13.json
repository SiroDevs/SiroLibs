                "loc": "ACT.1.3"
              },
              "items": [
                {
                  "text": "Tim 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aka i ndelo madit onyuthere ri joma yado jowotho gine woki i Galili tundo Yerusalem. Jono am'onyo pama jobedo jokony i wac pere i waŋ ji ma Isiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
              "ACT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
