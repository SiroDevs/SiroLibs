          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole ji ma Yerusalem kodi jotel pajo jok'oŋeyo nike go a Jaboth, aka jok'oniaŋ kada wac pa jotuci wac Were m'isoma i kisi Sabato. Kad'ameno wac pa jotuci wac Were otundo i kare munyo jothumo ri Yesu banja ma tho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.27",
            "verseOrgIds": [
              "ACT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
