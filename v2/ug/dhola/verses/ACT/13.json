                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.11"
              },
              "items": [
                {
                  "text": "10:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jomoor joteŋo lowo ma par tiendi gin munyo jokwoŋo jo to jokadho yu Ikoniam. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.51",
            "verseOrgIds": [
              "ACT.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "ACT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jofonjirok ma Antiok jopoŋ gi kisangala i cuny jo kanyacel gi Cuny Maleŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.52",
            "verseOrgIds": [
              "ACT.13.52"
            ]
          }
        }
