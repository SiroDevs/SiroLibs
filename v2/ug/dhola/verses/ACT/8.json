                "loc": "ACT.22.4"
              },
              "items": [
                {
                  "text": "Tim 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.9+ACT.26.10+ACT.26.11"
              },
              "items": [
                {
                  "text": "26:9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To Saulo otemo reyo woko kitipa pa jom'oyeyo munyo wotho i kisi dhiot pa jom'oyeyo ka coko jo, cwo gi mon, aka bolo jo i twec.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fonjo Wac Manyen Maber i Samaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jom'oyeyo ma okedhi jo jokidho iye je munyo jofonjo Wac pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.4",
            "verseOrgIds": [
              "ACT.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo okidho i tindi ma Samaria to fonjo ji kwoŋ Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.5",
            "verseOrgIds": [
              "ACT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwak ji jociko ithi jo gi cuny jo acel munyo jowinjo fonji pa Filipo gi gir'aura ma go otimo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.6",
            "verseOrgIds": [
              "ACT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuny m'ocido jowok kwoŋ ji madit gi derino madwoŋ; ji mathoth ma jotwo nyaŋinya, kodi jom'oŋol bende jobedo maber. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.7",
            "verseOrgIds": [
              "ACT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka kisangala madwoŋ obedo Samaria gipi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I tindi no oyido nitie nyatoro m'ilwoŋo ni Simon, ma yado miyo Josamaria dhier gi thieth pere. Go oyido waco nike go ŋatadwoŋ swa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.9",
            "verseOrgIds": [
              "ACT.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka dhano je i tindi, i kitipa ji ma nger je ociko ithe maber winjo go. Jowaco ni, “Jame a meni pa Were m'ilwoŋo ni, ‘Ma Siragama’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.10",
            "verseOrgIds": [
              "ACT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go oyido otieko miyo ji dhier gi thieth pere hongo malac swa m'omiyo bin jociko ithi gin winjo go. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.11",
            "verseOrgIds": [
              "ACT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "To munyo joyeyo fonji pa Filipo kwoŋ Wac Manyen Maber ma Ker pa Were kodi nyingi Yesu Kristo, aka obatisa jo, cwo gi mon. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.12",
            "verseOrgIds": [
              "ACT.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simon je bende oyeyo, aka munyo otiek kibatisa go, obedo cegin gi Filipo to dhier swa munyo oneno ranyuth madongo kodi gir'aura m'onwaŋo itimo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.13",
            "verseOrgIds": [
              "ACT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.13",
            "verseOrgIds": [
              "ACT.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo jomoor ma Yerusalem jowinjo nike ji ma Samaria jotieko jolo wac pa Were, jodhiro Petero gi Yohana rijo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.14",
            "verseOrgIds": [
              "ACT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo jotundo, jokwayo ri jom'oyeyo nike jowolimi Cuny Maleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.15",
            "verseOrgIds": [
              "ACT.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Cuny Maleŋ onwaŋo fodi k'oloro ri kada ŋat'acel kwoŋ jo; onwaŋo nyaka otiek kibatisa jo i nyingi Rwoth Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.16",
            "verseOrgIds": [
              "ACT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo Petero gi Yohana joketho cingi gin kwoŋ jo, to jolimo Cuny Maleŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.17",
            "verseOrgIds": [
              "ACT.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.17",
            "verseOrgIds": [
              "ACT.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Simon oneno nike Cuny Maleŋ loro ri ji ka jomoor joketho cingi gin kwoŋ jo, ocwayo pesa ri Petero kodi Yohana ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.18",
            "verseOrgIds": [
              "ACT.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka waco ni, “Miyan win bende meni me, aka wangi ka aketho cingan kwoŋ moro go bino limo Cuny Maleŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.19",
            "verseOrgIds": [
              "ACT.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Petero odwoko ni, “Kadhi itho koro gi pesa perin, rupiri oyido iparo ni inyalo nyewo mic pa Were gi pesa! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.20",
            "verseOrgIds": [
              "ACT.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingoye gi kabedo i tic mawan me, rupiri cunyin k'otire ruwaŋ Were. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.21",
            "verseOrgIds": [
              "ACT.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo ŋuti kwoŋ tim perin marac me, aka ikway Rwoth nike wocwakin kwoŋ paro marac me, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.22",
            "verseOrgIds": [
              "ACT.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "rupiri aneno ni duro opoŋ i cunyin, aka gimarac otweyin.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.23",
            "verseOrgIds": [
              "ACT.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simon owaco ri Petero kodi Yohana ni, “Mondo kway win ran Rwoth, ŋey wongoye kada gimoro acel ma wiluwo kwoŋe me ma wotiman.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.24",
            "verseOrgIds": [
              "ACT.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo jotieko niaŋo ji mikwenda pa Rwoth, Petero gi Yohana jogik Yerusalem. Jofonjo Wac Manyen Maber malomalo iy'adec m'omore i Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.25",
            "verseOrgIds": [
              "ACT.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Filipo kodi jasirikale ma Ethopiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.25",
            "verseOrgIds": [
              "ACT.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika pa Rwoth oluwo gi Filipo ni, “Yikere ilakidho i royo ma yu Tiendan piny ma wok i Yerusalem aka laro yu Gaza.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.26",
            "verseOrgIds": [
              "ACT.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me obedo royo ma thim. Gikenyo Filipo oyikere to kadho. I hongo no jatic ma Ethopiya onwaŋo dok yu peco. Ŋati me oyido obedo jasirikale madwoŋ ma kuro dero ŋaŋo pa nyamicala ma Ethopiya m'ilwoŋo ni Kandase. Go oyido owok Yerusalem lamo Were, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.27",
            "verseOrgIds": [
              "ACT.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka onwaŋo dok gi cawila pere munyo soma kitawo pa jatuci wac Isaya malomalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.28",
            "verseOrgIds": [
              "ACT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuny Maleŋ owaco ri Filipo ni, “Kidhi irom kodi cawila no.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.29",
            "verseOrgIds": [
              "ACT.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo oringo bonge to winjo munyo go soma kitawo pa Isaya; gikenyo openjo go ni, “Iŋeyo dwoŋ gim'isoma no?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.30",
            "verseOrgIds": [
              "ACT.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana Jasirikale, “Anyalo nedi ŋeyo dwoŋ mere ma nyatoro k'otito ran?” Go olwoŋo Filipo ni woidhi cawila wobed'iye gine. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.31",
            "verseOrgIds": [
              "ACT.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adec ma randik m'oyido go soma a me:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.33",
            "verseOrgIds": [
              "ACT.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jasirikale owaco ri Filipo ni, “Waci ran, jatuci wac me luwo kwoŋ ŋa me? Kwoŋ go won, kosa ŋatiman?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.34",
            "verseOrgIds": [
              "ACT.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo Filipo ocako tito rigo kwoŋ adec ma randik me; otito rigo Wac Manyen Maber mapa Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.35",
            "verseOrgIds": [
              "ACT.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo fodi jowotho i royo, jotundo kama dipi, to jasirikale waco ni, “Kole pi moro ee. Aŋo ma geŋan limo batisimo?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.36",
            "verseOrgIds": [
              "ACT.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Filipo owaco rigo ni, “Inyalo kibatisa in k'iyeyo gi cunyin je.” Ana go ni, “Ayeyo ni Yesu Kristo obedo Wod Were”]. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.37",
            "verseOrgIds": [
              "ACT.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jasirikale ooro jatic pere juko cawila; gikenyo jario no, Filipo kodi jasirikale jokidho i pi, to batisa go. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.38",
            "verseOrgIds": [
              "ACT.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo jowok i pi, Cuny Maleŋ pa Rwoth okwanyo Filipo. Josirikale odoko k'oneno go, to medere gi woth pere, munyo kisangala opoŋ i cunye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.39",
            "verseOrgIds": [
              "ACT.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo opoyo munyo go nitie i Azoto; to wotho i tindi parom munyo fonjo Wac Manyen Maber, cuka otundo Kasareya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.40",
            "verseOrgIds": [
              "ACT.8.40"
            ]
          }
        }
      ]
    }
  ],
