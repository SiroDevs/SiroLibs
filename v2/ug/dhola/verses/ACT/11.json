          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jofonjirok joridho ni kisi dhano kwoŋ jo ripo dhiro kony ri wadi jo ma Yuda paka go nyalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.29",
            "verseOrgIds": [
