        },
        {
          "text": " Am'omiyo acel kwoŋ cwo ma jowotho gi wan i hongo no je munyo Rwoth Yesu oyido fodi nigi wan noknok, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.21",
            "verseOrgIds": [
              "ACT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
