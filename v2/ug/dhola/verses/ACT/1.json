                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " (Pesa ma Yuda olimo i tim pere marac no onyewo gine ndelo, kama go ogor'iye piny to tho; aka okedhere to gir iye dhure piny. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji je ma jobedo Yerusalem jowinjo gino, aka i dhodhok pajo wegi jolwoŋo ndelo no ni Akeldama, dwoŋ mere ni, “Ndelo ma Remo.”)",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.19",
            "verseOrgIds": [
              "ACT.1.19"
            ]
          }
        }
      ]
    },
    {
