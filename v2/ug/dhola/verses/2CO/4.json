              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.12",
            "verseOrgIds": [
              "2CO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.13",
            "verseOrgIds": [
              "2CO.4.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.116.10"
              },
              "items": [
                {
                  "text": "Zab 116:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiko waco ni, “Ayeyo, am'omiyo aluwo.” Gi cuny ma yeyo acel no, wabende onyo wayeyo am'omiyo waluwo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.13",
            "verseOrgIds": [
              "2CO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "rupiri waŋeyo ni Were, m'ocerino Rwoth Yesu i kwo, bende bino cerino wan gi Yesu to kelo wan kanyacel gi win ruwaŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.14",
            "verseOrgIds": [
              "2CO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gino je bedo ma bero mewin, ŋey nema pa Were ma tundo ri ji m'omore jowomedi foyo Were gi miyo go dwoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bedo gi kwo ma cuny i yeyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meno am'omiyo wakilacere; kada meni ma delkwoŋ wan mojere mathin mathin, to kwo ma cuny wan lokere manyen kisi ndelo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.16",
            "verseOrgIds": [
              "2CO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka teko mathin ma hongo macek me bino kelo riwan dwoŋ m'oasere ma cil gi cil, maloyo teko no bor. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.17",
            "verseOrgIds": [
              "2CO.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo waketho paro mawan, ki kwoŋ gigipiny ma nenere, to kwoŋ gigipiny ma kinenere rupiri gima nenere cowo nyaka hongo macek; to gima kinenere yindira cil gi cil.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.18",
            "verseOrgIds": [
              "2CO.4.18"
            ]
          }
        }
      ]
    }
  ],
