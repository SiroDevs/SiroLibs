              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "T'owodhan munyo icwayan piny iy'adita, gi hoŋ moro i kor ot, ameno t'abudho go.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
