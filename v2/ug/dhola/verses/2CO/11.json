              },
              "items": [
                {
                  "text": "Tim 14:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Joroma jogoyan gi ludhe didek, aka ogoyan gi telin dicel; ye otieko bare ran i pi didek, aka dicel acowo sawa piero ario g'aŋwen i dier wakawaka munyo lekaleka kodan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.25",
            "verseOrgIds": [
              "2CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
