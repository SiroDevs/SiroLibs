                "loc": "ACT.9.23"
              },
              "items": [
                {
                  "text": "Tim 9:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.5"
              },
              "items": [
                {
                  "text": "Tim 14:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I woth paran m'omore aboth ri mikula ma jwombe, kodi jomac; aboth kwoŋ ji ma piny paran won, kodi ri Jopath; aboth i tindi, kodi i thim; aboth kwoŋ nam madongo, kodi kwoŋ jom'oyeyo ma twodo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atieko tic gi olo; ndir mathoth akibil nindo; abedo gi kec kodi riyo; ndir mathoth akicem, odoko koyo goyan kinyoro. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka, m'akituco gigipiny man, ndir je abedo i rembo ri kitipa pa jom'oyeyo je. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dhano nyap, abende abedo manyap gine; ka moro opodho i gimarac, kole awinjo gi rem.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        }
      ]
