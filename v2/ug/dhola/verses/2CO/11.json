                  "text": "Tim 9:23-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munyo fodi oyido anitie Damasiko, gavana ma ndir pa Kere Areto oketho jokur i waŋkac ma tindi makan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
        {
