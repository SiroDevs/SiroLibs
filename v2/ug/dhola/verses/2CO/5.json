{
  "id": "2CO.5",
  "number": "5",
  "bookId": "2CO",
  "reference": "2 Jokorintho 5",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
