{
  "id": "2CO.10",
  "number": "10",
  "bookId": "2CO",
  "reference": "2 Jokorintho 10",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
