        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi kelo Kakan ma Cikirok i Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
