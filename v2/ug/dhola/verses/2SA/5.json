          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi lokere kere ma Isiraili gi Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo nonin je ma Isiraili jobino bongi Daudi i Hebron aka jowaco rigo ni, “Neni, wabedo ji acel aka remo acel. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.1",
            "verseOrgIds": [
              "2SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cango munyo Saulo oyido fodi kere mawan, oyido itelo Joisiraili i lweny aka Rwoth ocikin nike ibino telo ji pere to ibedo jadhum pajo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.2",
            "verseOrgIds": [
              "2SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno jotel ma Isiraili je jobino bongi Daudi i Hebron; aka kere Daudi otimo gi jo cikirok ruwaŋ Rwoth aka jowiro Daudi gi mo bedo kere ma Isiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.3",
            "verseOrgIds": [
              "2SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.11"
              },
              "items": [
                {
                  "text": "1 Kerin 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.3.4"
              },
              "items": [
                {
                  "text": "1 Kigana 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.27"
              },
              "items": [
                {
                  "text": "29:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi oyido jaoro piero adek munyo go ocako dhum; aka odhumo ma oro piero aŋwen. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
              "2SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gi Hebron, Daudi odhumo ma oro abirio g'adec, aka i Yerusalem go odhumo Isiraili gi Yuda ma oro piero adek g'adek.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yerusalem bedo tindi madwoŋ ma ker m'oriwere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hongo otundo ma Daudi kodi cwo pere jokidho monjo Joyebus m'oyido jobedo i Yerusalem m'oyido joparo nike Daudi kinyal mako tindi madwoŋ me. Jowaco ri Daudi ni, “Ikinyal donjo ka. Joma waŋ gin otho kodi jor'aŋolo jonyalo cerin.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.6",
            "verseOrgIds": [
              "2SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "(To makad'ameno, Daudi omako tindi madwoŋ pajo; aka ocaki lwoŋo nike tindi pa Daudi).",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.7",
            "verseOrgIds": [
              "2SA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.7",
            "verseOrgIds": [
              "2SA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndelo no Daudi openjo cwo pere ni, “Nitie ka ŋat'odak Joyebus paka an? Ere weyi go woidhi fereji ma pi womonji jor'aŋolo ma waŋ gin otho no.” Meno am'omiyo iwaco ni, “Jor'aŋolo gi ji ma waŋ gin otho jokinyal donjo i Ot pa Rwoth.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.8",
            "verseOrgIds": [
              "2SA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.8",
            "verseOrgIds": [
              "2SA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumacen munyo Daudi otieko mako Yerusalem, obed'iye, aka olwoŋo ni tindi madwoŋ pa Daudi. Daudi ogeto tindi madwoŋ me thoko, cako kama lowo oyido opoŋ'iye tundo yuthenge ma yuwok ceŋ matendere. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.9",
            "verseOrgIds": [
              "2SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi omedo lokirok matek, kole Rwoth oyido nitie gi go.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.10",
            "verseOrgIds": [
              "2SA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.10",
            "verseOrgIds": [
              "2SA.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiram kere ma Tire ooro jomikwenda bongi Daudi gi kasike ma yath vini gi jobol ot, gi jogeto ot gi tele geto ri Daudi peco pa kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.11",
            "verseOrgIds": [
              "2SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka Daudi oniaŋ nike Rwoth oyido oyero go bedo kere ma Isiraili aka oyido tiŋo malo ker pere ro Joisiraili.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.12",
            "verseOrgIds": [
              "2SA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.12",
            "verseOrgIds": [
              "2SA.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Daudi tuk wok Hebron kadho Yerusalem, okadho gi mon man kodi malayin; aka jonywolo rigo nyithindho man. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.13",
            "verseOrgIds": [
              "2SA.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onywol ri Daudi nyithindho me gi Yerusalem; Samuwa, Sobab, Nathan, Solomon, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.14",
            "verseOrgIds": [
              "2SA.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibihar, Elisuwa, Nefeg, Yafia, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.15",
            "verseOrgIds": [
              "2SA.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisama, Eliada, gi Elifelet.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.16",
            "verseOrgIds": [
              "2SA.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi kengila Jofilistia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.16",
            "verseOrgIds": [
              "2SA.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Jofilistia jowinjo nike owir Daudi paka kere ma Isiraili, jolweny pajo jokidho dwaro go; to Daudi owinjo aka oloro to kadho kam'otimba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.17",
            "verseOrgIds": [
              "2SA.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jofilistia jotundo i milelo Refayim to jocokere kenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.18",
            "verseOrgIds": [
              "2SA.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi openjo Rwoth ni, “Amonji Jofilistia? Inomiyan jo i cingan?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth odwoko ni, “Ey monji jo aka alamiyo jo i cingin.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Daudi obino Bal Perizim aka kenyo okengila Jofilistia. Daudi owaco ni, “Rwoth otieko baro i dier jokwor paran pa mikula pi.” Aka olwoŋi kenyo ni Bal Perazim.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:20",
              "type": "text"
            },
            {
              "text": "Bal Perizim",
              "type": "text"
            },
            {
              "text": "Nyutho ni Rwoth ma baro i diere",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Jofilistia joringo, joweyo cal pajo cen, aka Daudi gi cwo pere jotiŋo to jokadho gine.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.21",
            "verseOrgIds": [
              "2SA.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.21",
            "verseOrgIds": [
              "2SA.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jofilistia kendo jogik i milelo Refayim aka jocokere kenyo. ",
          "type": "text",
