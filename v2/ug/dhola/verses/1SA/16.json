          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Daudi otundo bongi Saulo, ocako tiyo rigo. Saulo omaro Daudi tektek, to yero go bedo ŋeca pere. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.21",
            "verseOrgIds": [
              "1SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
