          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwiri odwoko Saulo ni, “Ak'odoki kodin rupiri ikwero winjo or pa Rwoth, aka go okwerin paka kere pa Joisiraili.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        }
