        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwiri odok Rama to Saulo dok peco pere i Gibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.34",
            "verseOrgIds": [
              "1SA.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwiri doko k'oneno kere Saulo tundo tho, to owinjo gi rem swa ri Saulo. Rwoth orem ni oyido oloko Saulo bedo kere pa Joisiraili.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.35",
            "verseOrgIds": [
              "1SA.15.35"
            ]
          }
        }
