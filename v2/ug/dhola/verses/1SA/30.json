              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ri ji ma Arower, ji ma Sifimoth, ji ma Esitemowa, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
