          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odhiro ri ji ma Bethel, ji ma Rama yupiny ma piny Yuda, gi ji ma tindi Yatir. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
