            "sid": "1SA 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo owaco ri Daudi ni, “Were womiyin silwany, wodan! Aka ibedi gi loyo i kisi gim'inotimi je.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
