          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi okadho i yo pere to Saulo dok peco.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
