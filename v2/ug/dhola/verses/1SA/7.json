        "style": "s1"
      },
      "items": [
        {
          "text": "Samwiri dhumo i Isiraili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
