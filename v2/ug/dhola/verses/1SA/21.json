        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi ringo woko kwoŋ Saulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
