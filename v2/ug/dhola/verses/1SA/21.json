            "sid": "1SA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi okidho Nob bongi Ahimelek jacway ri Were i wi migam. Ahimelek okidho bonge munyo kirin to penjo go ni, “Raŋo ibino ka kendin?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.1",
            "verseOrgIds": [
              "1SA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
