          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.3",
            "verseOrgIds": [
              "TIT.1.3"
            ]
          }
        },
