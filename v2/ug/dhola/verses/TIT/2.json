              "items": [
                {
                  "text": "1 Pet 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu Kristo, m'omiyere riwan to botho wan kwoŋ reco je, to loko wan ji m'olony ma jobedo apere won aka jocowere i timo gima beyo.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
      ]
    },
