          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Yethiro osewila Musa, to Yethiro dok peco.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.27",
            "verseOrgIds": [
              "EXO.18.27"
            ]
