          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwany aŋakin ma wod rombo aka imiyan paka mic ma welo. Adec me bino bedo aperin.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.26",
            "verseOrgIds": [
              "EXO.29.26"
            ]
          }
        }
      ]
    },
