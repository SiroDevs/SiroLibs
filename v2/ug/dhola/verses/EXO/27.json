{
  "id": "EXO.27",
  "number": "27",
  "bookId": "EXO",
  "reference": "Wok 27",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
