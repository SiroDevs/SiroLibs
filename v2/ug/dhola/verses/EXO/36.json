          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotimo nanga ma liero gi nanga mafoth, m'okwoy manyabululu, manyarangi ariŋo, kodi yer rombo m'obokere aka jokwoyo gi cwec ma jobwombi gin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
