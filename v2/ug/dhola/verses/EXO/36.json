          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ri dhiot ma Wema jotimo nanga ma liero gi nanga mafoth m'okwoy gi yer rombo manyabululu, manyarangi ariŋo kodi m'obokere aka jokwoyo maŋon gi piso. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
        {
