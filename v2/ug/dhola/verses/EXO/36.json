          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotimo gute aŋwen wok kwoŋ mbawo kasia ma mako nanga ma liero, joumo gi zahabu, aka jotweyo gi siragetere ma zahabu. Kenyo jotimo pende aŋwen ma feza mako gute. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.36",
            "verseOrgIds": [
              "EXO.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
