          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joumo miangin gi zahabu aka jotweyo gi petin ma zahabu mako yen ariwa, ma bende oyido oum gi zahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
