          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waripo woth ma ndelo adek kidho i thim to wamiyo Rwoth Were mawan cowirok paka go omiyo wan or.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
