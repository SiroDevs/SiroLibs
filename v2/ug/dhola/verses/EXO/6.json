              "type": "text"
            }
          ]
        },
        {
          "text": "To Rwoth waco ri Musa ni, “Onyo ikidho neno gim'abino timo ri Farawo. Abino romo go weyo ji paran jowokadhi. Adieri abino romo go riemo jo wok i lowo me.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
