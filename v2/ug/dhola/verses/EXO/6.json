          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliazar, wod pa Aron, onywomo acel kwoŋ nyir pa Putiel m'onywolo rigo Finehas. Jo am'oyido wic pecin kodi nonin pa Jolevi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
