            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruben, wod pa Yakobo marapena oyido nitie gi wote aŋwen; Hanok, Palu, Heziron, kodi Karim, jobedo kwarere mewin nonin ma jolwoŋere gi nyingi jo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.14",
            "verseOrgIds": [
              "EXO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simeo oyido nitie gi wote aucel; Jemwel, Yamin, Ohad, Ohar, kodi Saulo, wot dhako Jakanan; jobedo kwarere mewin nonin ma jolwoŋere gi nyingi jo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.15",
            "verseOrgIds": [
              "EXO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.17+NUM.3.18+NUM.3.19+NUM.3.20"
