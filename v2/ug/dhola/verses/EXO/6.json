                  "text": "Wok 3:13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Were owaco ri Musa ni, “An abedo Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.2",
            "verseOrgIds": [
              "EXO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amenyere ri Abraham, Isaka, kodi Yakobo paka Were Majameni je, to akinyuthere rijo gi nyingan maleŋ, Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abende atimo gi jo cikirok miyo jo lowo ma Kanan, lowo ma jobed'iye paka jopath. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.4",
            "verseOrgIds": [
              "EXO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo atieko winjo ywak pa Joisiraili ma Jomisir jomako i twec aka apoyo cikirok paran. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.5",
            "verseOrgIds": [
              "EXO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno wac ri Joisiraili ni, ‘An abedo Rwoth, abino botho win t'agonyo win wok i twec pa Jomisir. Abino tiŋo cingan ma dimeni kelo gir'acula madongo kwoŋ jo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.6",
            "verseOrgIds": [
              "EXO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abino loko win ji paran, aka abino bedo Were mewin. Wibino ŋeyo ni An Abedo Rwoth Were mewin k'anogony win wok i twec i Misir. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.7",
            "verseOrgIds": [
              "EXO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abino kelo win i lowo m'akwoŋere miyo Abraham, Isaka, kodi Yakobo, aka abino miyo win paka lim mewin. An abedo Rwoth.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.8",
            "verseOrgIds": [
              "EXO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa owaco gime ri Joisiraili, to jok'owinjo go kwoŋbedo cuny gin oyido otur gi twec mager.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.9",
            "verseOrgIds": [
              "EXO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
