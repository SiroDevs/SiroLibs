            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.1+1CH.6.2+1CH.6.3+1CH.6.4"
              },
              "items": [
                {
                  "text": "1 Kigana 6:1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Levi oyido nitie gi wote adek; Gerisom, Kohath, kodi Merari; jobedo kwarere mewin nonin ma jolwoŋere gi nyingi jo. Levi okwo ma oro 137. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.16",
            "verseOrgIds": [
              "EXO.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gerisom oyido nitie gi wote ario; Libini, kodi Simey aka jolimo nyikway jo kweth. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.17",
            "verseOrgIds": [
              "EXO.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kohath oyido nitie gi wote aŋwen; Amram, Izar, Hebron, kodi Uziel. Kohath okwo ma oro 133. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.18",
            "verseOrgIds": [
              "EXO.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Merari oyido nitie gi wote ario; Mali kodi Musi. Me nonin pa Jolevi gi nyikway jo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.19",
            "verseOrgIds": [
              "EXO.6.19"
            ]
          }
        }
      ]
    },
