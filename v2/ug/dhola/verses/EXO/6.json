          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aron onywomo Eliseba, nyar Aminadab nyamin Nason, aka onywolo rigo Nadab, Abihu, Eliazar, kodi Ithamar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
          }
        },
        {
          "name": "verse",
