          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobedo cwo ma jowaco ri Farawo gonyo Joisiraili wok i Misir.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
            "verseOrgIds": [
