          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo jotundo Mara, jok'onyalo madho pi ma kenyo kwoŋbedo oyido kec, aka am'omiyo ocwoki ni Mara.",
          "type": "text",
          "attrs": {
