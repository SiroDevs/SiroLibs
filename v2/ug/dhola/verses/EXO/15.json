              "type": "text"
            }
          ]
        },
        {
          "text": "Ji jogeŋisa ri Musa aka jopenjo ni, “Aŋo ma wakidho madho?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.24",
            "verseOrgIds": [
              "EXO.15.24"
