          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa oywaki ri Rwoth, aka Rwoth onyutho go yath m'obolo i pi to pi lokere mamit.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
