                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To k'oyido k'ogendera neko go, abino yero riwin kabedo ma go bino ringo iye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka nyatoro won omonjo nyawote to neko akor, woneki go makada nende bedi nike oringo i wi migam paran both.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
