            }
          ]
        },
        {
          "text": "“Ka ji jogore, to ŋat'acel goyo nyawote gi tele kosa nyweny aka ŋato k'otho t'imiyo go kitanda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
