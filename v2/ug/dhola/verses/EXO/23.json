          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wikiri wimiyan mugat m'otimi gi thow ka wimiyan cowirok ma le, kosa wiwey bor ma le wobedi kiri yawere odikin.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
