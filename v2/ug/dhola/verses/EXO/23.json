              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Winji win kisi gim'atieko waco riwin. Wikiri wikway werin man, wikiri wituci kada nyingi gin.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
