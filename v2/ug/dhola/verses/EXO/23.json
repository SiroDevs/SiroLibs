            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "to i oro mar'abirio, wiwey woywomere, aka wikiri wikec gimoro je ma odongi iye, ŋey jocandi jowocami gim'odongi kenyo, aka ogwaŋe madudi jowocami gim'odoŋ'iye. Wilatimo gimoro acel i ndelo vini mewin gi yen vini mewin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
