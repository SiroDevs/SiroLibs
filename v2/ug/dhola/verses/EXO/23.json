              "type": "text"
            }
          ]
        },
        {
          "text": "Ma oro aucel wicwoy kodhi i ndelin mewin to wikeco nyak mere, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
