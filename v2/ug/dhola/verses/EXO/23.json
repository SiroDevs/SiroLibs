              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tim win kalima ma kayindi ka oro rumo, ka wicoko ranyak mewin wok i ndelin mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisi oro ka witimo kalima adek me, cwo mewin je joripo bino lamo Rwoth Were mewin.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        }
      ]
    },
    {
