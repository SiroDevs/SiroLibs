        },
        {
          "text": " “Ikir'inyay wac pokopoko, kosa imakere gi ŋatarac bedo jakony ma twodo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikir'iluw lwak ji i timo reco, kosa ka jomiyo jakony wiro tiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.15"
              },
              "items": [
                {
                  "text": "Jolevi 19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikir'itim nyakucel ri jacandi i kapido.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
