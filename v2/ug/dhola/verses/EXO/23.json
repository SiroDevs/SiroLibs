        },
        {
          "text": " “K'inwaŋo dhiaŋ kosa punda pa jakwor perin m'orwenyo, iripo dwoko rigo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'inen punda pere opodho gi gim'otiŋo, kony go wotiŋ malo punda; ikir'ikali go.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
