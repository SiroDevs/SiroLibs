        },
        {
          "text": "“Ka wikopa pesa ri ji paran ma jocandi, wikiri wicalo jokikopa t'imiyo go culo gi magowa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
