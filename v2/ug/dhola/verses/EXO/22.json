            "number": "16",
            "style": "v",
            "sid": "EXO 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka jacwo oweco gi nyako mambula aka oyido fodi ongoye gi ombego to nindo gine, go ripo culo nywom to nywomo go. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka ba nyako okwero go nywomo nyako, go ripo culo ba nyako nywom ma ripo gi nyako mambula.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
