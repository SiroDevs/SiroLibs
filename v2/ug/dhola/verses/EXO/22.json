          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka nyatoro osinga rin nanga to ciko nike laculin, iripo dwoko rigo nanga mafodi waŋceŋ k'opodho ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
