          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka keme paran bino liel t'aneko win i lweny. Mon mewin jobino doŋ citho aka nyithindho mewin kic.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.24"
            ]
          }
        }
