              "type": "text"
            }
          ]
        },
        {
          "text": "“Wikiri witer japath marac, kosa widiy go, kole win bende oyido wibedo jopath i piny Misir. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
