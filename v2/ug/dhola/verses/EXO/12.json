                {
                  "text": "Gal 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Joisiraili jobedo i Misir ma oro 430. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.40",
            "verseOrgIds": [
              "EXO.12.40"
            ]
          }
        },
        {
          "name": "verse",
