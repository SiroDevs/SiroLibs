        "style": "s1"
      },
      "items": [
        {
          "text": "Joisiraili joeye Misir",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
