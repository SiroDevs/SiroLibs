            "number": "41",
            "style": "v",
            "sid": "EXO 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndelo macowe ma oro 430 mere, nonin pa ji pa Rwoth je joeye i Misir. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedo wor ma Rwoth okuro jo munyo wodho jo wok i Misir; wor acel me Joisiraili jomiyo ri Rwoth i luse pajo je aka joripo poyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cik ma mako kwoŋ kalima ma Kadho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
