          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo jokidho to jotimo ameno, paka Rwoth oyido omiyo Musa gi Aron cik.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        }
