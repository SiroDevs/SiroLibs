              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth owaco ri Musa gi Aron ni, “Me cik ma mako kwoŋ kalima ma kadho; wongoye japath ma wocam cemo mere, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ŋeca ma winyewo nyalo camo nyaka ka withumo go kende. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.44",
            "verseOrgIds": [
              "EXO.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wongoye jawoth, kosa jatic m'opangisa ma wocam cemo mere. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.45",
            "verseOrgIds": [
              "EXO.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.12"
              },
              "items": [
                {
                  "text": "Kwan 9:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.36"
              },
              "items": [
                {
                  "text": "Yoh 19:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cemo je iripo camo i ot m'oted'iye, kiripi wodho woko. Aka wikiri wimwodi cokin mere. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.46",
            "verseOrgIds": [
              "EXO.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EXO 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joisiraili je joripo timo kalima me, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.47",
            "verseOrgIds": [
              "EXO.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EXO 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "to wongoye jacwo ma k'othumere ma wocam. Ka japath moro bedo i dier win aka mito timo kalima ma miyo Rwoth dwoŋ, kutho wiripo thumo cwo je ma ot pere. Nyaka go bino kwanirok paka acel kwoŋ anywola ma Isiraili to bende riwere i kalima me. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EXO 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cik acel bende ri anywola ma Isiraili kodi jopath ma jobedi i dier win.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
              "EXO.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "EXO 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joisiraili jowinjo aka jotimo paka Rwoth omiyo Musa gi Aron cik. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "EXO 12:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka i ndelo no won Rwoth owodho nonin ma Isiraili wok i Misir.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.51",
            "verseOrgIds": [
              "EXO.12.51"
            ]
          }
        }
