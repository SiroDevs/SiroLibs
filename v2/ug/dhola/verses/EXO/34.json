              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth owaco ri Musa ni, “Ndiki wac me piny, rupiri obedo i wiwaci me m'atimo cikirok kodin kodi Isiraili.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa obedo kenyo gi Rwoth ma ndelo piero aŋwen wor g'odieceŋ, ma kicem kosa madhi gimoro. Ondiko i telin wac ma cikirok; Or Apar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
      ]
    },
