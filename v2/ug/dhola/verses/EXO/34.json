                "loc": "DEU.7.9+DEU.7.10"
              },
              "items": [
                {
                  "text": "7:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kenyo Rwoth oluwo ruwaŋ Musa aka olwoŋo, “An Rwoth, Abedo Were m'opoŋ gi wor kodi kisa, ma kimaki nge piyo aka nyutho mar makiwire kodi adieri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.6",
            "verseOrgIds": [
              "EXO.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuro cikirok paran ri luse ganin t'acwako raco gi reco, t'akibino weyo m'akimiyo gir'acula nyithindho gi nyikwaye tundo i luse mar'adek gi mar'aŋwen ro reco pa jonywol pajo.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.7",
            "verseOrgIds": [
              "EXO.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
