                "loc": "LEV.23.3"
              },
              "items": [
                {
                  "text": "Jolevi 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Cik 5:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Winitie gi ndelo aucel ma timo tic mewin, to ndelo mar'abirio obedo ndelo ma cikirok ma ywomirok ri Rwoth. Ŋata timo tic moro je i ndelo no wonek. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joisiraili joripo kuro ndelo me paka cikirok. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedo ranyuth makicutho i dier Joisiraili kodan, rupiri An Rwoth, acweyo polo gi piny i ndelo aucel, aka i ndelo mar'abirio atieko tic t'aywomere.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Rwoth otieko luwo gi Musa wi got Sinai, omiyo go telin mapando ario ma Were won ondik'iye or.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
        }
      ]
