          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ji jomedere cungo gi bor, aka Musa kende ama ocore cegin gi pondeponde m'opoto bongi Were.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
            "verseOrgIds": [
              "EXO.20.21"
            ]
          }
        }
      ]
    },
