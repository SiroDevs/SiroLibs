        {
          "text": "Wikiri wikule piny rijo, kosa wilam jo, kwoŋbedo An, Rwoth Were mewin, ajanyeko. Akelo gir'acula kwoŋ jono ma jodakan kodi kwoŋ nyikway jo, kiri i luse pajo mar'adek gi mar'aŋwen. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
