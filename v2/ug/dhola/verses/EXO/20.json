          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jowaco ri Musa ni, “Luw gi wan aka wawinji, to k'iweyo Were luwo gi wan wabino tho.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
              "EXO.20.19"
            ]
          }
        }
