            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "T'anyutho mar paran makiwire ri luse ganin pa ji ma jomaran aka joluwo or paran.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
