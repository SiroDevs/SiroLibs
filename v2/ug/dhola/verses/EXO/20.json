                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munyo ji jowinjo mwoc pa koth gi dwondi gwara to joneno lithkoth gi yiro ma wok i got, jokirin gi lworo to jocungo gi bor. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.18",
            "verseOrgIds": [
              "EXO.20.18"
            ]
          }
        },
        {
