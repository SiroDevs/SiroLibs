          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa odwoko ni, “Wikiri wilwor; kole Were obino temo win kodi miyo win winjo go, ŋey wikiri witim reco.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.20",
            "verseOrgIds": [
              "EXO.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
