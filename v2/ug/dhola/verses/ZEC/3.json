                  "text": "Meny 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwoth onyuthan Yesuwa jadwoŋ pa jocway ri Were i wi migam munyo ocungo ruwaŋ malaika pa Rwoth, aka Sitan oyido ocungo yuracuc pa Yesuwa kisegeya go. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
