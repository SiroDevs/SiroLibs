            "verseId": "MAT.6.4",
            "verseOrgIds": [
              "MAT.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 6:5"
          },
          "items": [
            {
              "text": "5",
