          "type": "text",
          "attrs": {
            "verseId": "MAT.3.6",
            "verseOrgIds": [
              "MAT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
