            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.19"
              },
              "items": [
                {
                  "text": "Mat 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.23"
              },
              "items": [
                {
                  "text": "Yoh 20:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Adieri awaco riwin, gima winotwey i piny ka ibino tweyo i polo, aka gima winogony i piny ka ibino gonyo i polo.”",
          "type": "text",
          "attrs": {
