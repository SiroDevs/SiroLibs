              "MAT.18.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.3"
              },
              "items": [
                {
                  "text": "Luk 17:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“K'omin in otimo rin marac, kidhi bonge inyuthi go reco pere. T'itimi ameno nyaliŋliŋ, nyaka i dier wijario. Ka go owinjin, meno itieko dwoko omin in bongin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "Cik 19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To ka go okwer winjin, kwany ŋat'acel kosa ji man ario ikidhi gi jo, aka ŋey wac moro je woridho munyo j'ario kosa adek jothielo paka ondiki. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka k'owinjo jo bende, ere tuci gimoro je ri kitipa pa jom'oyeyo. Aka ka go okwer winjo kiri kitipa pa jom'oyeyo bende, onyo ter go paka jakicar kosa jacoki misolo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.17",
            "verseOrgIds": [
              "MAT.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwero gi yeyo",
          "type": "text"
        }
      ]
    },
    {
