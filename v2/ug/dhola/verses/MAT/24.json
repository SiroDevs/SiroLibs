              "items": [
                {
                  "text": "Luk 17:23-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Am'omiyo, ka jowaci riwin ni, “Panen, go nitie i thim.” Wikiri wikidhi yukorago; ka jowaco ni, “Panen go dica i kisika ma ot.” Wikiri wiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.26",
            "verseOrgIds": [
              "MAT.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole paka lithkoth wok yuwok ceŋ aka menyo piny kiri yupodho ceŋ, apaka bino pa Wod Dhano bende labedo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.27",
            "verseOrgIds": [
              "MAT.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.37"
              },
              "items": [
                {
                  "text": "Luk 17:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kama gimoro otho iye, ama acut jocoker'iye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.28",
            "verseOrgIds": [
              "MAT.24.28"
            ]
          }
        }
