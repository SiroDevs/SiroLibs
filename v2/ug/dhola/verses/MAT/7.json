              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo dhano je ma winjo wac paran me aka tiyo gine bino cale gi dhano mariek m'ogeto ot pere i wi tele. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.24",
            "verseOrgIds": [
              "MAT.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koth ocwe, mikula omol, aka asur okudho to ot no k'opodho, kwoŋbedo oger i wi tele. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.25",
            "verseOrgIds": [
              "MAT.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ŋata winjo wac paran me aka kitiy gine, cale dhano mamiŋ m'ogero ot pere i kwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.26",
            "verseOrgIds": [
              "MAT.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koth ocwe, mikula omol, asur okudho ot no matek, to podho. Podho no oasere marom kune!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.27",
            "verseOrgIds": [
              "MAT.7.27"
            ]
          }
        }
      ]
