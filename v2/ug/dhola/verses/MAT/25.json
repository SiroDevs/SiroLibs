                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka bol win woko jatic m'ongoye kony no i mudho ma gicen, kama ji jobino ywak'iye gi litho madit.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
