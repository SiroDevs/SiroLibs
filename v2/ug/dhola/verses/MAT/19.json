                {
                  "text": "Wok 20:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.16"
              },
              "items": [
                {
                  "text": "Cik 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
