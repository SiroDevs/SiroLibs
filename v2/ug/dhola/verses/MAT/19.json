            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.30"
              },
              "items": [
                {
                  "text": "Luk 13:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka ji mathoth ma pama jobedo marapena jobino bedo macowe, aka ma jobedo macowe ama jobino bedo marapena.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.30",
            "verseOrgIds": [
              "MAT.19.30"
