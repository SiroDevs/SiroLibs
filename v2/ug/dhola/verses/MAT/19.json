                "loc": "EXO.20.16"
              },
              "items": [
                {
                  "text": "Wok 20:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.20"
              },
              "items": [
                {
                  "text": "Cik 5:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go openjo ni, “Or mene?” Yesu odwoko ni, “ikir'ineki, Ikir'itim cot, Ikir'ikwal, ikir'icway misegey ma twodo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
