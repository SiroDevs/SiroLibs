                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu odongo i delkwoŋe aka rieko pere omedere, munyo Were gi ji jofoyo go.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.52",
