          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyathi no odongo gi meni, gi rieko, kendo silwany pa Were obedo gine.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
