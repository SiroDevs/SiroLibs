              "type": "text"
            }
          ]
        },
        {
          "text": "Tekin jotieko timo gimoro je ma Cik pa Rwoth waco, jodok Galili i tindi pajo ma Nazareth. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
