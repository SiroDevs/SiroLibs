              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Cak 18:20—19:25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odoko bino bedo paka i ndir pa Loti bende. Dhano je oyido cemo, medho, nyewere kendo tana, furo cemo aka geto. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ndelo ma Loti owok'iye Sodom, mac maliel ocwe piny wok i polo to neko woko ji je ma kenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
            "verseOrgIds": [
              "LUK.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meno apaka bende labedo i ndelo ma Wod Dhano bino nyuther'iye.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.30",
            "verseOrgIds": [
              "LUK.17.30"
            ]
          }
        }
