          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Cwo ario jobino bedo i ndelo: Ŋat'acel ibino kwanyo, t'iweyo nyawote kenyo].” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.36",
            "verseOrgIds": [
              "LUK.17.36"
            ]
          }
        },
