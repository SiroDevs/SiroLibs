        },
        {
          "text": "Ŋata temo botho kwo pere bino rwenyo woko; ŋata rwenyo woko kwo pere ama bino botho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
            "verseOrgIds": [
              "LUK.17.33"
            ]
          }
