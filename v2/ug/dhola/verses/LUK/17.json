              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wor no, awaco riwin, j'ario jobino nindo i kanindo acel; ŋat'acel ibino kwanyo t'iweyo ŋatiman kenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
              "LUK.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon ario jobino rego kanyacel; acel ibino kwanyo t'iweyo nyawote kenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
            "verseOrgIds": [
              "LUK.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
