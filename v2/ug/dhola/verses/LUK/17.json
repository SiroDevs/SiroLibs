                  "text": "Cak 6:5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Paka cango obedo i ndir pa Nowa apaka bende bino bedo i ndir pa Wod Dhano. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
            "verseOrgIds": [
              "LUK.17.26"
            ]
          }
        },
        {
