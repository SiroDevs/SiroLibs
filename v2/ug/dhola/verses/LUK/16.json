                "loc": "MAT.11.12+MAT.11.13"
              },
              "items": [
                {
                  "text": "Mat 11:12-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Cik pa Musa kodi ndiko pa jotuci wac Were obedo gi meni tundo i ndir pa Yohana Jakibatisa; wok i ndir no Wac Manyen Maber ma Ker pa Were ocaki tito, aka dhano je rire donj'iye gi maker. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.18"
              },
              "items": [
                {
                  "text": "Mat 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To yot ri polo gi piny rerok, makiweno nyeko woko kada nyaka adec m'ondhilo kwoŋ Cik.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        }
      ]
    },
