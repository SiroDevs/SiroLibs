            "style": "v",
            "sid": "EZK 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka neni, jacwo m'oyido oruko nanga mafoth, m'oyido nitie gi vino i piere odwoko wac ka waco ni, “Atieko timo paka iwodho ran or.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.11",
            "verseOrgIds": [
              "EZK.9.11"
            ]
          }
        }
      ]
