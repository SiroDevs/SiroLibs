            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jokiripi kocirok gi kidho cegin gi delkwoŋ ŋat'otho, kwanyowoko yok jo kosa bajo kosa wod jo kosa nyar jo, kodi omin jo kosa nyamin jo ma fodi jok'onywomere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.25",
            "verseOrgIds": [
              "EZK.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumacen ma bedo m'olony kendo, iripo kwano rigo ndelo abirio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndelo ma go donjo iye i Kabedo Maleŋ, i diedipo ma iye, tiyo, go ripo miyo mic ma cwako reco, Rwoth Were waco.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        }
      ]
    },
