        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.5"
              },
              "items": [
                {
                  "text": "Jolevi 21:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jocway ri Were i wi migam jokiripi lielo ye wi jo kosa weyo ye wi jo dongo mabor. Joripo nyaka dwoko cen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.9"
              },
              "items": [
                {
                  "text": "Jolevi 10:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jocway ri Were i wi migam jokiripi madho vini ka jodonjo i diedipo ma iye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.7"
              },
              "items": [
                {
                  "text": "Jolevi 21:7",
