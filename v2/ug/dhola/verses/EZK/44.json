                "loc": "LEV.22.8"
              },
              "items": [
                {
                  "text": "Jolevi 22:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jocway ri Were i wi migam jokiripi camo gimoro je, winyo kosa ogwaŋ, ma won otho kosa m'ogwaŋ madudi oneko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
