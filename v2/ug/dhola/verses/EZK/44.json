            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me labedo alunja pajo, aŋat'abedo alunjo pajo. Wikiripi miyo jo lim i Isiraili, abedo lim pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
