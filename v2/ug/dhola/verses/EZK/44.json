            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joripo fonjo ji paran pokirok i dier gimaleŋ kodi gima kileŋ, gimakoc kodi gim'olony. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.23",
            "verseOrgIds": [
              "EZK.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kiŋunyaŋunya nitie, joripo bedo jothum banja, aka joripo thumo banja luwo kwoŋ thumo banja paran. Joripo kuro cik paran kodi or paran kwoŋ kalimin m'ayero, aka joripo kuro sabato paran maleŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.24",
            "verseOrgIds": [
              "EZK.44.24"
            ]
          }
        }
      ]
