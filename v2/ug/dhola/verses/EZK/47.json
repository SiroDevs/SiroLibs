      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pi ma mol wok i Ot pa Were",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
