                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.2"
              },
              "items": [
                {
                  "text": "Meny 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aŋiyo, aka neni, pi m'omakere matek m'oyido nitie i wi kerubim, onenere i wi jo gima cale tele ma pilin, paka gima cale kom ma dhum. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Meny 8:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go owaco ri jacwo m'oyido oruko nanga mafoth ni, “Kadhi i lipangala ma pendi kerubim, aka ipoŋ masi cingin gi cuk mac t'iywoyo kwoŋ tindi madwoŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go okadho m'aneno ama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo kerubim oyido ocungo yuracuc ma ot, aka munyo jacwo no odonjo, pondeponde oumo diedipo ma iye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo dwoŋ pa Rwoth oay wok kwoŋ kerubim kadho i thengi ot, pondeponde opoŋo ot, aka diedipo opoŋ gi lero madwoŋ pa Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Derino ma bwombi kerubim owinjere i diedipo ma woko, paka dwondi Were Majameni je ka luwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo go omiyo jacwo m'oruko nanga mafoth or, kwanyo mac wok i pendi lipangala, wok i dier kerubim, jacwo no odonjo to cungo i thengi lipangala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo kerubim acel otelo cinge wok i dier kerubim i mac m'oyido nitie i dier jo, ojowo mac to ketho i masi cingi jacwo m'oyido oruko nanga mafoth, aka ojolo to wok woko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I pendi kerubim oneno gima cale cingi dhano i pendi bwombi jo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.15+EZK.1.16+EZK.1.17+EZK.1.18+EZK.1.19+EZK.1.20+EZK.1.21"
              },
              "items": [
                {
                  "text": "Eze 1:15-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aŋiyo, aka neni, oyido nitie lipangala aŋwen i thengi kerubim, acel i thengi kisi kerubim; lipangala me oyido cale tele ma pilin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.9",
            "verseOrgIds": [
              "EZK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lipangala aŋwen je oyido jonitie gi cal acel, paŋini lipangala m'olwow i wi lipangala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.10",
            "verseOrgIds": [
              "EZK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka jodhire, jodhire i thenge aŋwen mogo je ma jokiwire; thenge ma wic acel oŋiyo ama joje jodhir'iye ma jokiwire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.11",
            "verseOrgIds": [
              "EZK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Meny 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Delkwoŋ jo je, ligongolo pajo, cingi jo, bwombi jo, kodi lipangala, oyido opoŋ waŋ jo thoko, i lipangala aŋwen je. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.12",
            "verseOrgIds": [
              "EZK.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paka ri lipangala, olwoŋi jo munyo awinjo gi ithan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.13",
            "verseOrgIds": [
              "EZK.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.13",
            "verseOrgIds": [
              "EZK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.10"
              },
              "items": [
                {
                  "text": "Eze 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Meny 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisi acel oyido nitie gi nyime, nyim marapena oyido obedo nyim kerubim, nyim mar'ario oyido obedo nyim dhano, nyim mar'adek oyido obedo nyim simbwor, aka nyim mar'aŋwen oyido obedo nyim ango. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerubim joay malo; me obedo cwec m'oyido atieko neno i thengi malawa Kebar. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.15",
            "verseOrgIds": [
              "EZK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kerubim jodhire, lipangala bende jodhire i thengi jo, ka kerubim joyaro bwombi jo to joay wok i piny, lipangala jokidhire i thengi jo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.16",
            "verseOrgIds": [
              "EZK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kerubim jocungo liŋ, lipangala bende jocungo liŋ, ka kerubim joay jo bende joay; kole cuny pa cwec makwo oyido nitie i jo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo dwoŋ pa Rwoth oay wok i thengi ot, to cungo i wi kerubim. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerubim joyaro bwombi jo to joay malo wok i piny ruwaŋan munyo jowok gi lipangala i thengi jo. Jocungo yuwaŋ waŋkac ma Ot pa Rwoth yuwok ceŋ, aka dwoŋ pa Were pa Isiraili oyido nitie i wi jo malo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me obedo cwec m'aneno i tiendi Were pa Isiraili i thengi malawa Kebar; aka aŋeyo nike oyido jobedo kerubim.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisi acel oyido nitie gi nyime aŋwen, kodi bwombe aŋwen, aka i pendi bwombi jo oyido nitie gima cale cingi dhano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.21",
            "verseOrgIds": [
              "EZK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyim jo oyido obedo nyim jo acel m'oyido atieko neno i thengi malawa Kebar, cal pajo kodi jo wegi; joje jodhire tirtir.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.22",
            "verseOrgIds": [
              "EZK.10.22"
            ]
          }
        }
      ]
    }
  ],
