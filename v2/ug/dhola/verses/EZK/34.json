              "EZK.34.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.17"
              },
              "items": [
                {
                  "text": "Meny 7:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alajengo kwoŋ jo jakwath acel, ŋeca paran Daudi go lakwayo jo, go lakwayo jo to bedo jakwath pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.23",
            "verseOrgIds": [
              "EZK.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.24"
              },
              "items": [
                {
                  "text": "Eze 37:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka an, Rwoth, alabedo Were pajo. Ŋeca paran Daudi labedo wod kere i dier jo; An, Rwoth atieko luwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.24",
            "verseOrgIds": [
              "EZK.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.24",
            "verseOrgIds": [
              "EZK.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alatimo gi jo cikirok ma siem t'awaro woko ogwaŋe mager wok i piny, ŋey jowonyal bedo i thim to jonindo i lule m'ongoye teko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.25",
            "verseOrgIds": [
              "EZK.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaloko jo kodi adec m'othoko tendere paran silwany; aka aladhiro rijo koth i hongo mere ma ripo; labedo rijo koth ma silwany. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.26",
            "verseOrgIds": [
              "EZK.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yen ma ndelin jolanyak olemo pajo, aka gigipiny labedo i piny. Jolabedo ma bu teko i lowo pajo; aka jolaŋeyo ni An Abedo Rwoth, k'aturo woko nyweny ma bieto pajo, t'abotho jo i cingi jono ma joloko jo ŋecin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.27",
            "verseOrgIds": [
              "EZK.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jok'olokere gikinyaga ri nonin kendo, kosa ogwaŋe ma piny k'ocami jo; jolabedo ma bu teko, aka ŋati mogo k'oloki jo malwor. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.28",
            "verseOrgIds": [
              "EZK.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alamiyo jo kafur maber ŋey kec wokiri woneki jo i piny, aka jokiri jocandere kendo yet pa nonin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.29",
            "verseOrgIds": [
              "EZK.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolaŋeyo ni An, Rwoth Were pajo, anitie gi jo, aka ni jo, ot pa Isiraili, jobedo ji paran, apaka Rwoth Were waco. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
              "EZK.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wibedo rombo paran, rombo ma lum paran, aka abedo Were mewin apaka Rwoth Were waco.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
            "verseOrgIds": [
              "EZK.34.31"
            ]
          }
        }
      ]
    }
  ],
