              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ot pa Isiraili kilanwaŋo kendo kudho ma cwowo jo malith i dier jono m'oyido jocayo jo, aka jolaŋeyo ni An abedo Rwoth Were.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
