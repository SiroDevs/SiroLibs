        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth Were waco ama: K'atieko coko ot pa Isiraili wok i dier nonin kama jokedher'iye, t'anyutho leŋo paran i jo ruwaŋ nonin, kenyo jolabedo i lowo pajo wegi m'amiyo ŋeca paran Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolabed'iye i siem, jolageto udi to jopidho ndelin vini. Jolabedo i siem i iye, k'athumo banja kwoŋ jono ma jocayo jo thoko jo. Kenyo jolaŋeyo ni An abedo Rwoth, Were pajo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.26",
            "verseOrgIds": [
              "EZK.28.26"
            ]
          }
        }
