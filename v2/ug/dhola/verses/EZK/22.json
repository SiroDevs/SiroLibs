              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.19"
              },
              "items": [
                {
                  "text": "Cik 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.24"
