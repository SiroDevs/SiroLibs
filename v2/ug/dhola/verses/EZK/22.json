                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.36"
              },
              "items": [
                {
                  "text": "Jolevi 25:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.37"
              },
              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.20"
              },
              "items": [
                {
                  "text": "Cik 23:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Megi kwoŋ ji mewin inyewo jo neki. Megi joketho magowa kwoŋ pesa ma jokopa Joisiraili wadi jo aka joŋaŋ gi diyo jo. Wiwin owil kodan, Rwoth Were waco.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.12",
            "verseOrgIds": [
              "EZK.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.12",
            "verseOrgIds": [
              "EZK.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neni ee, alamino adol kwoŋ kwo mewin kodi neki manitie i dier win. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.13",
            "verseOrgIds": [
              "EZK.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuny win onyali ciro, aka cingi win odoŋ matek i ndelo m'alatiy'iye gi win? An Rwoth, atieko luwo, aka alatimo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.14",
            "verseOrgIds": [
              "EZK.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakedho win i dier nonin, t'abolo win i dier piny, aka alakwanyo woko kicutho koco mewin i dier win. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.15",
            "verseOrgIds": [
              "EZK.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilacayo win ka nonin man joneno, kenyo nyaka wilaŋeyo ni An Abedo Rwoth.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.16",
            "verseOrgIds": [
              "EZK.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.16",
            "verseOrgIds": [
              "EZK.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wac pa Rwoth obino ran ka waco ama: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.17",
            "verseOrgIds": [
              "EZK.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awi wod dhano, ot pa Isiraili olokere ran nyal. Jocale nyweny, waya, cuma, kikebe kodi nyal m'oyuy kwoŋ feza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.18",
            "verseOrgIds": [
              "EZK.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno, Rwoth Were waco ama: Kwoŋbedo wijoje witieko lokere nyal, alacoko wijoje kanyacel i Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.19",
            "verseOrgIds": [
              "EZK.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nger acel m'icok'iye waya, cuma, nyweny kodi kikebe i dier mac m'ocwiny, ŋey jowonyele, ameno apaka alacoko win i nge paran, i keme paran, aka alaketho win piny t'anyelo win. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.20",
            "verseOrgIds": [
              "EZK.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alacoko win, aka alakudho kwoŋ win mac gi keme paran, aka wilanyele i iye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.21",
            "verseOrgIds": [
              "EZK.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paka feza nyele i dier mac, apaka wilanyele bende, aka kenyo nyaka wilaŋeyo nike An Rwoth, atieko konjo keme paran kwoŋ win.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.22",
            "verseOrgIds": [
              "EZK.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Reco pa jodhum ma Isiraili",
          "type": "text"
        }
      ]
    },
