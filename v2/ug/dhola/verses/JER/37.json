        "style": "s1"
      },
      "items": [
        {
          "text": "Kwac pa Zedekia ri Yeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
