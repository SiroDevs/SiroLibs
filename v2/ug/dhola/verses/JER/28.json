        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremia kodi jatuci wac Were Hanania",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
