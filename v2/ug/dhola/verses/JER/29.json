                "loc": "2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Kigana 36:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Yer 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.2"
              },
              "items": [
                {
                  "text": "Dan 9:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kole Rwoth pa lwak jolweny waco ama: “Ka oro piero ario pa Babilon orumo, nyaka t'aciko ithan riwin, alaketho i gike cikirok paran riwin t'adwoko win i kabedo me. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adieri aŋeyo can m'anitie gine riwin, Rwoth waco, can ma bero mewin makiweno raco, ma miyo win hongo ma yuwaŋe gi geno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo nyaka ka wilwoŋan to wibino to wikwayan, alawinjo win. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
              "JER.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.29"
              },
              "items": [
                {
                  "text": "Cik 4:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka wirangan, wilanwaŋan, ka widwaran gi cuny win je, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "wilanwaŋan, Rwoth waco. Aladwoko silwany mewin t'acoko win wok i nonin je kodi kabedo je m'akedh'iye win, Rwoth waco. Aladwoko win i kabedo m'akwany'iye win t'atero win wiloka.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoŋbedo witieko waco ni, “Rwoth otieko miyo wan jotuci wac Were i Babilon.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth waco ama kwoŋ kere ma bedo i kom ma dhum pa Daudi, kodi kwoŋ ji je ma jobedo i tindi madwoŋ me, wade mewin ma jok'okadho gi win i wiloka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth pa lwak jolweny waco ama, akidho gonyo kwoŋ jo abor, kec kodi two nundu, aka alaloko jo paka nyandere m'otop marac swa ma kinyal camo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alariemo jo g'abor, gi kec kodi two nundu, aka alaloko jo gibwok ri kerin je ma piny. Jolabedo paka kwoŋ, gibwok, gidhier, kodi ginyero i dier nonin je kam'atieko kedh'iye jo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gime latimere rijo kwoŋbedo jok'oworo mikwenda paran, munyo amena dhiro rijo ŋecin paran jotuci wac Were. Jokwero winjo, Rwoth waco. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "To onyo pama, win ma winitie i wiloka je m'ariemo wok Yerusalem kidho Babilon, winji win wac pa Rwoth.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth pa lwak jolweny, Were pa Isiraili waco ama, ma mako Ahab wod pa Kolaya kodi Zedekia wod pa Maseya, ma joluwo gitwodo i nyingan. Akidho ketho jo i cingi Kere Nebukadineza ma Babilon, aka go laneko jo ka wineno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ji m'oter jo paka jotwec wok Yerusalem kidho Babilon jomito kelo kwoŋ nyatoro, jobino waco ni, “Weyi Rwoth wotim riwin paka Zedekia kodi Ahab, ma kere ma Babilon obulo jo i mac.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoŋbedo jotimo gimiŋo i Isiraili to jotimo cot gi mon pa wadi gin, aka jotieko luwo wac ma twodo i nyingan m'akioro jo; aŋat'aŋeyo aka abedo jakony, Rwoth waco.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Balwa pa Semaya",
          "type": "text"
        }
      ]
    },
    {
