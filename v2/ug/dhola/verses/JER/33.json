              "items": [
                {
                  "text": "1 Kigana 17:11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kole Rwoth waco ama: Daudi kilangoye gi ŋata lalunjo kom pere ma dhum i ot pa Isiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
