            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "meno nyaka cikirok paran m'atimo gi ŋeca paran Daudi nyalo tur, ŋey go wongoye gi wode manyalo lunjo kom pere ma dhum, kodi cikirok m'atimo gi Jolevi ŋecin paran. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paka kinyal kwano micalin manitie i polo aka kinyal kipima kwoyo ma nam, ameno apaka alamedo nyikway ŋeca paran Daudi, kodi Jolevi ŋecin paran.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
