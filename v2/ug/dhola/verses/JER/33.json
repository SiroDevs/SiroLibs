          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poyi fodi ikikaŋasa maber kite ma ji me jowaco ni, “Pecin ario ma Rwoth oyido oyero go otieko kwero woko.” Kite m'iter'iye ji paran gi cay ma kiter jo paka nono? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
