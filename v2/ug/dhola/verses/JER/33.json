              "type": "text"
            }
          ]
        },
        {
          "text": "Wac pa Rwoth obino ri Yeremia: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me apaka Rwoth waco: Ka moro kwoŋ win oyido nyalo turo cikirok paran gi odieceŋ kodi cikirok paran gi wor, ŋey jokiri jowobin i hongo pajo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
