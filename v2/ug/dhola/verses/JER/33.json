          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth waco ama: Kabedi oyido akitimo cikirok paran gi odieceŋ kodi wor kodi cik ma dhumo piny kodi polo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
