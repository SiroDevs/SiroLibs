              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wac pa Rwoth obino ri Yeremia: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
