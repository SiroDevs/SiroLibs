              },
              "items": [
                {
                  "text": "Kwan 3:5-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jocway ri Were i wi migam ma jobedo Jolevi jokilangoye ruwaŋan gi jacwo ma miyo mic awaŋa, mic ma cemo, kodi timo cowirok ma hongo je.",
          "type": "text",
          "attrs": {
