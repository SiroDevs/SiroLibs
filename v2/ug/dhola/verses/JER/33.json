          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "dinyo akwero nyikway Yakobo kodi ŋeca paran Daudi m'akiyeyo moro kwoŋ nyikwaye paka jadhum kwoŋ nyikway Abraham, Isaka kodi Yakobo. Kole aladwoko lim pajo, aka alamako wor gi jo.",
          "type": "text",
