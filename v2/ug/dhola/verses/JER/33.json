              "items": [
                {
                  "text": "Yer 23:5-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndelo bino adieri, Rwoth waco, m'abino ketho i kare cikirok m'atimo ri ot pa Isiraili kodi ot pa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndir no kodi i hongo no, alayero kere m'otire ma nyakwar Daudi. Kere no latimo gir'adieri kodi gim'otire i piny. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndir no, ilabotho Yuda aka siem labedo i Yerusalem. Me a nyinge m'ilalwoŋo gine, “Rwoth, obedo tiro mawan.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        }
      ]
    },
