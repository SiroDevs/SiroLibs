            }
          ]
        },
        {
          "text": "dwondi jo ma kisangala kodi forok. Lawinjere dwondi jamweha kodi mweha kodi dwondi ji ma jowero, ka jokelo foyo i Ot pa Rwoth ka jowaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
