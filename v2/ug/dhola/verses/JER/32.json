                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.19.1+JER.19.2+JER.19.3+JER.19.4+JER.19.5+JER.19.6"
              },
              "items": [
                {
                  "text": "19:1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Joketho amien pajo i ot m'ilwoŋo gi nyingan, aka jokoco woko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
