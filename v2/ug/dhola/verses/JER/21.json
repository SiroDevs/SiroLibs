          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ri ot pa kere ma Yuda wac ni: Winji win wac pa Rwoth, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
