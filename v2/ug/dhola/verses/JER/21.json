              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Kigana 36:17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mondo penji Rwoth riwan, rupiri kere Nebukadineza ma Babilon cano lweny gi wan; kono miti Rwoth otim gir'aura riwan, paka noknok timo, to miyo go gonyere kwoŋ wan.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
