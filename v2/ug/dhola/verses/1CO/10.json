              "items": [
                {
                  "text": "Jolevi 7:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pari win kwoŋ Joisiraili; joma camo gim'ocowere gine i wi migam meno jokinitie kanyacel i tic ma migam? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.18",
            "verseOrgIds": [
              "1CO.10.18"
            ]
          }
        },
        {
