          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bedi win waŋ win, cungi win matek i yeyo, bedi win miseni, bedi win gi meni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.13",
            "verseOrgIds": [
              "1CO.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gimoro je ma witimo, tim win gi mar.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.14",
            "verseOrgIds": [
              "1CO.16.14"
            ]
          }
        }
