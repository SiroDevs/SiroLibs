                "loc": "ACT.19.8+ACT.19.9+ACT.19.10"
              },
              "items": [
                {
                  "text": "Tim 19:8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "T'abino bedo Efeso ka tundo ndelo ma Pentekost. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.8",
            "verseOrgIds": [
              "1CO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka royo onyo oyawere ran malac ma tic, kada joma piemo kodan jomore.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
              "1CO.16.9"
            ]
          }
        }
      ]
    },
