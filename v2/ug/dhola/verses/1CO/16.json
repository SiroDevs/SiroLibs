              "items": [
                {
                  "text": "1 Kor 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka wutmera, wiŋeyo kwoŋ Sitefano gi peco pere paka jobedo jom'otelo wirok i yeyo i Gris, aka jomiyere tic ri ji maleŋ pa Were. Akwayo win wutmera, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.15",
            "verseOrgIds": [
              "1CO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeyo tel pa ji ma cale ameno, kodi apa joman je ma jotiyo matek gi jo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        }
      ]
    },
