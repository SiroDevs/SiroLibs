              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.6",
            "verseOrgIds": [
              "1CO.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.9"
              },
              "items": [
                {
                  "text": "Gal 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoto mewin no kiripi! Wikuya ni, “Thow kada mathin nyalo miyo moko m'odwany gipi yenyo?” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.6",
            "verseOrgIds": [
              "1CO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.5"
              },
              "items": [
                {
                  "text": "Wok 12:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wiripo kwanyo woko thow macon mareco aka nyaka wibino bedo ma wilony. Aka ŋey wibino cale kodi moko m'odwany ma buthow, paka aŋeyo nike wibedo ameno adieri. Kole Kristo, nyathi rombo mawan ma kalima ma Kadho, otiek miyo riwan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.7",
            "verseOrgIds": [
              "1CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.7"
              },
              "items": [
                {
                  "text": "Wok 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.3"
              },
              "items": [
                {
                  "text": "Cik 16:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Am'omiyo onyo weyi watim kalima mawan, to ki gi mugat m'oketh'iye thow macon, mar'athuye kodi reco, to kodi mugat ma buthow, ma ditiro kodi adieri.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.8",
            "verseOrgIds": [
              "1CO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.8",
            "verseOrgIds": [
              "1CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I balwa m'andiko riwin awaco ni wikiri wimakere kodi jom'odakana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.9",
            "verseOrgIds": [
              "1CO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiluw kwoŋ joma bu Were ma jodakana kosa joworo, kosa jokwo, kosa jolami cal makicar ma piny me. Kole bedi ameno d'onyo wiweyo piny ka kicutho! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.10",
            "verseOrgIds": [
              "1CO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gim'akidho rigo obedo nike wikiri wimakere gi dhano ma lwoŋere ni oyeyo to odakana, wor, kosa lamo cal makicar, kosa janyeki nyingi wadi, kosa jamero kosa jakwo. Wikiri wibedi kada piny cemo gi dhano ma pameno.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.11",
            "verseOrgIds": [
              "1CO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
