                "loc": "DEU.23.1"
              },
              "items": [
                {
                  "text": "Cik 23:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole wawinjo ni cot nitie i dier win m'oasere gima kimitere kada i dier joma bu Were; owaci ran nike nitie nyatoro ma bedo gi ci bamere! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.1",
            "verseOrgIds": [
              "1CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meno a gima miyo win kwoto? Kole d'onyo wiwinjo gi rem ayin to wiriemo woko ŋata timo gino wok i kweth mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.2",
            "verseOrgIds": [
              "1CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kada nende anitie bor gi win i del, to anitie gi win i cuny; aka atieko kiri thumo banja loyo ŋat'otimo gimarac no paŋini anitie gi win kenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.3",
            "verseOrgIds": [
              "1CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka wiromo kanyacel, aka abende an gi win i cunyan, gi meni pa Rwodhiwan Yesu manitie gi wan, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.4",
            "verseOrgIds": [
              "1CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wiripo cwayo ŋati me ri Sitan wonyeki delkwoŋe, g'awanya mere ŋey cunye wolimi both i ndelo pa Rwoth Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.5",
            "verseOrgIds": [
              "1CO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
