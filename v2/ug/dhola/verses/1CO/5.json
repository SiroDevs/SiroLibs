              "items": [
                {
                  "text": "Cik 13:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.7"
              },
              "items": [
                {
                  "text": "17:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aŋo ma d'omiyan athum banja ri joma woko? Kole joma ni dier jom'oyeyo ama winyalo thumo rijo banja! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.12",
            "verseOrgIds": [
              "1CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were won bino thumo banja ri joma ni woko paka ndiko waco ni, “Kwany win woko ŋatarac i dier win.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.13",
            "verseOrgIds": [
              "1CO.5.13"
            ]
          }
        }
      ]
    }
  ],
