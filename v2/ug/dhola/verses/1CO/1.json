          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balwa m'owok bongi Paulo, ma i mito pa Were olwoŋi bedo jamoor pa Kristo Yesu, kodi omin wan Sositheno.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        }
      ]
    },
    {
