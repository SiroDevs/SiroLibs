                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.11"
              },
              "items": [
                {
                  "text": "Mar 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.18"
              },
              "items": [
                {
                  "text": "Luk 16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anitie gi or ri jom'onywomere, aka k'obedo aparan to apa Rwoth: Dhako m'onywomere kiripi weyo cwore; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.10",
            "verseOrgIds": [
              "1CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka ka go otimo ameno, go ripo bedo kende kosa gik bongi cwore; odoko jacwo kiripi riemo cege.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.11",
            "verseOrgIds": [
              "1CO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.11",
            "verseOrgIds": [
              "1CO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ri joman awaco (an won, ki Rwoth) ni: Ka jacwo ma jakristo nitie gi cege m'ongoye gi yeyo to dheno yeyo bedo gine, jalo kiripi riemo go. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.12",
            "verseOrgIds": [
              "1CO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odoko ka dhako ma jakristo nitie kodi cwore m'ongoye gi yeyo, to jalo yeyo bedo gine, go kiripi pokirok gi jalo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.13",
            "verseOrgIds": [
              "1CO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole Were jolo jacwo m'ongoye gi yeyo ro riwirok gi cege, aka dhako m'ongoye gi yeyo bende Were jolo ro riwirok gi cwore ma jakristo. Bedi k'obedo ameno, di nyithindho pajo jobedo paka nyithindho manyakafir; to paka nitie, Were jolo jo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.14",
            "verseOrgIds": [
              "1CO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka ŋata buyeyo mito pokirok kodi nyawote ma jakristo, weyi go wotim ameno. I wac ma cale ameno, jakristo m'obedo jacwo kosa dhako, nitie gi siem ma yero; kole Were olwoŋin bedo i siem. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.15",
            "verseOrgIds": [
              "1CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iŋeyo nedi, in dhako ma jakristo, nike ik'obothi cworin? Kosa iŋeyo nedi in jacwo ma jakristo, nike ik'obothi cegin?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.16",
            "verseOrgIds": [
              "1CO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwo perin wobedi paka Were olwoŋin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.16",
            "verseOrgIds": [
              "1CO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhano je ripo doŋ i kwo ma Rwoth olwoŋ'iye go. Me a cik ma afonjo i kitipa pa jokristo je. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.17",
            "verseOrgIds": [
              "1CO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitie ŋat'onwaŋo otieko thumirok i hongo ma Kristo olwoŋ'iye go? Kiripi ŋato wotem kwanyo woko waŋpoyo ma thumirok. Kosa nitie ŋat'onwaŋo fodi k'othumere i hongo ma Were olwoŋ'iye go? Kiripi ŋato woyenyi thumirok. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.18",
            "verseOrgIds": [
              "1CO.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole thumirok kosa bedo ma dhano k'othumere meno ama k'obedo gimadwoŋ. Gimadwoŋ meno a winjo or pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.19",
            "verseOrgIds": [
              "1CO.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhano je ripo doŋ paka oyido nitie munyo ojolo lwoŋo pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.20",
            "verseOrgIds": [
              "1CO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyido ibedo ŋeca munyo Were olwoŋin? Ikir'idew; to k'inyalo nwaŋo siem perin, tim ameno. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.21",
            "verseOrgIds": [
              "1CO.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole dhano ma Rwoth olwoŋo munyo ŋeca lokere dhano pa Were man siem; aka romaroma gi ŋat'onwaŋo nitie i siem munyo olwoŋi go, ma lokere ŋeca pa Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.22",
            "verseOrgIds": [
              "1CO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were onyewo win i welo ma malo, am'omiyo wikiri wilokere ŋecin pa ji. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.23",
            "verseOrgIds": [
              "1CO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wutmera, dhano je ripo doŋ i Were paka go oyido nitie i hongo m'olwoŋ'iye go.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.24",
            "verseOrgIds": [
              "1CO.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Penji kwoŋ joma k'onywomere kodi mon tho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.24",
            "verseOrgIds": [
              "1CO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo ma mako kwoŋ joma k'onywomere, akinwaŋo or bongi Rwoth, to akelo paro paran paka ŋata ro wor pa Rwoth ripo agena.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.25",
            "verseOrgIds": [
              "1CO.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.25",
            "verseOrgIds": [
              "1CO.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cungo kwoŋ teko ma pama nitie, aparo ni ber ri dhano je doŋadoŋa paka go nitie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.26",
            "verseOrgIds": [
              "1CO.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywomo kosa inywomere? Ere ikir'item pokirok gi nyawotin. Ikinywomo kosa ikinywomere? Ere ikir'irangi dhako kosa jacwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.27",
            "verseOrgIds": [
              "1CO.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka inywomo, ikitimo gimarac, odoko ka nyako onywomere, bende k'otimo gimarac. To joma nywomo kosa nywomere jobino bedo gi teko madit i kwo me, aka oyido ayenyo konyo jo kwoŋ gino.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.28",
            "verseOrgIds": [
              "1CO.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.28",
            "verseOrgIds": [
              "1CO.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jowotan, me a dwoŋ gim'awaco: Hongo m'odoŋ nok, aka wok konon kadho malo jom'onywomo jowobedi paŋini joma k'onywomo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.29",
            "verseOrgIds": [
              "1CO.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "joma ywak, paŋini joma kiywak; joma sangala, paŋini jom'ongoye gi kisangala; joma nyewere, paŋini gigipiny ma jonyewo k'apa jo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.30",
            "verseOrgIds": [
              "1CO.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "joma oro gigipiny ma piny, paŋini gigipiny no k'omayo jo hongo moro je. Kole piny me, paka pama nitie, kilakiyindira doko.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.31",
            "verseOrgIds": [
              "1CO.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.31",
            "verseOrgIds": [
              "1CO.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amito wingoye kodi rembo. Jacwo ma k'onywomo ketho cunye i tic pa Rwoth, rupiri go rango yo ma kisangala Rwoth; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.32",
            "verseOrgIds": [
              "1CO.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "to jacwo m'onywomo ketho cunye i gigipiny ma piny, rupiri go mito kisangala cege, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.33",
            "verseOrgIds": [
              "1CO.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka cunye tero go korin gi korin. Dhako ma k'onywomere kosa nyako ketho cunye i tic pa Rwoth, rupiri go yenyo miyirok ri Rwoth i cunye kodi i del bende; to dhako m'onywomere ketho cunye i gigipiny ma piny, rupiri go rango yo ma kisangala cwore.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.34",
            "verseOrgIds": [
              "1CO.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.34",
            "verseOrgIds": [
              "1CO.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awaco gime rupiri amito konyo win. Akitem ketho win i dinyo. Kucel amito witim gim'otire m'oripo, kareno wimiyere i tic pa Rwoth m'ongoye ruwo paro.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'inen jayac m'otieko penjirok gi nyako onyo neno ni go timo gima kiripi ri nyawote no, aka nyako no oro pere kadho, aka go paro ni joripo nywomirok, ere jowotimi ameno paka go mito; ongoye kenyo gimarac. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.36",
            "verseOrgIds": [
              "1CO.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka jacwo won otieko ridho i cunye ni lanywomo, m'ongoye ŋata romo go, to won thumo paro pere, timo maber. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.37",
            "verseOrgIds": [
              "1CO.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo, jacwo ma nywomo nyako pere no timo maber, to ŋata weyo ma k'onywomo, timo maber loyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cik tweyo dhako m'onywomere kwoŋ cwore tekin cwore fodi kwo; to ka cwore otho, go nitie gi siem ma nywomirok gi jacwo man ma go omiti; to wobedi i Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "To go d'obedo gi kisangala loyo, ka go odoŋ paka go nitie. Meno paro paran, aka aparo ni abende anitie gi Cuny Maleŋ pa Were.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
      ]
    }
