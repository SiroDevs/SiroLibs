          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kethi win cuny win kwoŋ mic maloyo dwoŋ ayin.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
            "verseOrgIds": [
              "1CO.12.31"
            ]
          }
        }
