          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda oniaŋ kwoŋ jo aka owaco ni, “Go otire loyan, paka akimiyo go wodan Sela.” Aka Yuda doko k'onindo gine.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
