            "caller": "#"
          },
          "items": [
            {
              "text": "38:29",
              "type": "text"
            },
            {
              "text": "Perez",
              "type": "text"
            },
            {
              "text": "Me dhohiburu ma nyutho tur woko",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
