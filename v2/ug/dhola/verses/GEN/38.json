            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "To munyo odwoko cinge, neni omin go owok; aka jacol mon owaco ni, “Ameno apaka oturo yo pere woko!” Riameno ocwoki go ni Perez.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
