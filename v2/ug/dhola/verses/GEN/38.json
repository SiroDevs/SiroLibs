          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo dwe ma romo adek okadho, owaci ri Yuda ni, “Ciwodin Tamar otimere pa malaya, aka onyo ogamo iye.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        }
      ]
    },
    {
