            },
            {
              "text": "Berseba",
              "type": "text"
            },
            {
              "text": "Me wac i dhohiburu ma nyutho ni waŋ pi abirio, kosa waŋ pi ma kwoŋirok",
              "type": "text"
            }
          ]
        },
        {
          "text": " rupiri kenyo ama jotim'iye cikirok.",
          "type": "text",
