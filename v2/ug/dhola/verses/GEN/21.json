              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo jotieko timo cikirok, Abimelek gi Fikol jamituka jolweny pere jodok i piny Filistia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.32",
