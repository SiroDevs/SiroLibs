              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abraham opidho yath m'ilwoŋo ni tamarisk i Berseba, aka olamo Rwoth Were ma cil gi cil kenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.33",
