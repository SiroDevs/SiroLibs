            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.22",
            "verseOrgIds": [
              "GEN.21.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.26"
              },
              "items": [
                {
                  "text": "Cak 26:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo no Abimelek gi Fikol jamituka jolweny pere jowaco ri Abraham ni, “Were nikodin i gim'itimo je ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.22",
            "verseOrgIds": [
              "GEN.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno kwoŋere ka ruwaŋ Were nike ikibino wondan, nyithindho paran, kosa nyikwayan. To paka atiyo kodin gi genirok, apaka bende ibino tiyo kodan gi piny m'ibed'iye.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.23",
            "verseOrgIds": [
              "GEN.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.23",
            "verseOrgIds": [
              "GEN.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abraham odwoko ni, “Akwoŋere.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.24",
            "verseOrgIds": [
              "GEN.21.24"
            ]
          }
        }
      ]
    },
    {
