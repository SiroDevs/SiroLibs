              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abraham odwoko ni, “Jol rombo abirio ma mon me wok i cingan, k'iyeyo ni aŋat'akunyo waŋ pi me.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.30",
