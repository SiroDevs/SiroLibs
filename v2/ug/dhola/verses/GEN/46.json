              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ooro Yuda yuwiye kwayo Yozefu wobin worom gi jo i Gosen. Aka munyo jobino, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
