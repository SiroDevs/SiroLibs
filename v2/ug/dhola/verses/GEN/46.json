          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abino waco rigo ni wibedo jokwath aka wikuro ogwaŋe aka ni wikelo mwendi gi dhok kodi gigipiny je m'obedo mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
          }
