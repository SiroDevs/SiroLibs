          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo owaco ri Yozefu ni, “Nyo weyi atho, paka atieko nenin aka aŋeyo ni fodi ikwo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
