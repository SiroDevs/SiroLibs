            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.20"
              },
              "items": [
                {
                  "text": "1 Pet 3:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwoth oneno ni kidakana pa ji oyido dwoŋ i piny, aka kiri paro ma cuny jo je omedere bedo marac. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.5",
            "verseOrgIds": [
              "GEN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka Rwoth owinjo gi rem ni oyido ocweyo ji to ketho jo i piny, aka oramo cunye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Rwoth owaco ni, “Abino reyo woko ji m'acweyo wok i piny, kodi ogwaŋe gi winyin, rupiri arem ni acweyo jo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Rwoth oyido winjo maber gi Nowa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        }
      ]
    },
    {
