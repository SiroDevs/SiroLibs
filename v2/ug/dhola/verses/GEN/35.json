              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wot Biliha, ŋeca pa Laker; Dan gi Nafital. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
