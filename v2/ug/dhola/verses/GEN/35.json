          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wot Leya; Ruben (kayo pa Yakobo), Simeo, Levi, Yuda, Isakar, kodi Zebulun. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
