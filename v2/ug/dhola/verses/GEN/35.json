              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Yakobo bedo i piny no, Ruben okidho to nindo gi Biliha, malaya pa bamere, aka Yakobo owinjo kwoŋe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
