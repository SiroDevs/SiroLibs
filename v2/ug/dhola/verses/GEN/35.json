              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wot Laker; Yozefu kodi Benyamin. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
