        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno dhako oneno nger ma yath no oyido ber'iye, kodi nger mar'olemo mere oyido ber acama; aka oparo nger ma ber'iye lokirok mariek. Kenyo go okwanyo olemo to camo, aka omiyo cwore bende ni wocam.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.6",
            "verseOrgIds": [
              "GEN.3.6"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.6",
            "verseOrgIds": [
              "GEN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tekin jotieko camo ama, waŋ gin oyawere aka joniaŋ ni oyido jonitie kinyoro; aka jokwoyo boke makuyu kanyacel to joumere gine.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.7",
            "verseOrgIds": [
              "GEN.3.7"
            ]
          }
        }
