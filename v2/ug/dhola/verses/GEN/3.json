            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were openjo go ni, “Ŋa m'owaco rin nike initie kinyoro? Icamo yath m'amiyin cik ni ikir'icam?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.11",
