          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "To thwol waco ri dhako ni, “Wi k'otho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.4",
            "verseOrgIds": [
              "GEN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole Were oŋeyo ni ka winocam waŋ win bino yawere, aka wibino cale Were, ma wiŋeyo bero gi raco.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.5",
            "verseOrgIds": [
              "GEN.3.5"
            ]
          }
        }
      ]
    },
    {
