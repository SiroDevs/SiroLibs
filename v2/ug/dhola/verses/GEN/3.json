              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adam ocwoko nyingi dhako pere ni Eva rupiri go obedo yok ji je. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
