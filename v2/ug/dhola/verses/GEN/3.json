            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka Rwoth Were okwoyo ri Adam gi cege nangin wok kwoŋ pien ogwaŋ to ruko jo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
