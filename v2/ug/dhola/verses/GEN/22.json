            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.17+HEB.11.18+HEB.11.19"
              },
              "items": [
                {
                  "text": "Ebu 11:17-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumacen ma gigipiny me, Were otemo Abraham, aka olwoŋo go ni, “Abraham!” Abraham odwoko ni, “An e!”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
