              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I cakirok Were ocweyo polo gi piny. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.1",
            "verseOrgIds": [
              "GEN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piny oyido ongoye gi cal aka oyido nitie nono. Mudho oyido oumo wakawaka madongo, aka Cuny pa Were oyido waya wi pi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.6"
              },
              "items": [
                {
                  "text": "2 Kor 4:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kenyo Were owodho or ni, “Weyi kenyo wobedi lero.” Aka lero omenyere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.3",
            "verseOrgIds": [
              "GEN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka Were oneno ni lero ber, ameno opoko lero kwoŋ mudho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.4",
            "verseOrgIds": [
              "GEN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were olwoŋo lero ni odieceŋ, aka mudho ni wor. Piny oyutho to piny yawere; meno obedo ndelo marapena.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
