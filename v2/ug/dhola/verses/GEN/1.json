        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were owaco ni, “Weyi pi wonywol cwec ma nigi kwo, aka weyi koyo wopoŋ gi winyin.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.20",
            "verseOrgIds": [
              "GEN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Were ocweyo rec madongo i nam kodi kisi cwec makwo ma bedo i pi, kodi kisi nger winyo. Aka Were oneno nike oyido ber. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.21",
            "verseOrgIds": [
              "GEN.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were omiyo jo silwany aka owaco ri kisi cwec ma bedo i pi nike wonywol wopoŋ i nam; to waco ri winyin nike jowomedere i welo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.22",
            "verseOrgIds": [
              "GEN.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piny oyutho to piny yawere, meno obedo ndelo mar'abic.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.23",
            "verseOrgIds": [
              "GEN.1.23"
            ]
          }
        }
      ]
    },
