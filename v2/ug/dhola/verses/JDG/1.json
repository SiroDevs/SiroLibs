              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aser k'oriemo woko ji m'oyido jobedo i Ako, Sidon, Alab, Akizib, Helba, Afik, kodi Rehob. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
