          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "To jo Asera jobedo i dier Jokanan, ji m'oyido jobedo i lowo no, kole jok'oriemo woko jo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
