          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kew pa Joamor wok kama Akirabim idho malo, wok i Sela kadho malo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
