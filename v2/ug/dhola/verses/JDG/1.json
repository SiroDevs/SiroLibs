              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efrayim bende k'oriemo woko Jokanan m'oyido jobedo i Gezer, to Jokanan jomedere bedo i dier jo i Gezer.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
