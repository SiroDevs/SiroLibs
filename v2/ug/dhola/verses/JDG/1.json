              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zebulun k'oriemo woko ji m'oyido jobedo i Kitron, kosa ji m'oyido jobedo i Nahalal, to Jokanan jobedo i dier jo, aka jotimo tic arom.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
