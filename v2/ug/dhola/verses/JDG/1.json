          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joamor jomedere bedo wi got Heres, i Ayijalon, kodi i Salibim. Kucel nyikway Yozefu joloyo jo gi meni aka jomiyo jo tic arom. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
