              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wutmin go kodi jopeco pere je joloro piny to jokwanyo delkwoŋe to jokelo malo, aka joyiko go i dier Zora kodi Esitayol i kaliel pa bamere Manowa. Samson obedo jathum banja i Isiraili ma oro piero ario.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
