                  "text": "Mar 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "An Yuda, jatic pa Yesu Kristo, kendo omin Yakobo, andiko balwa me ri joma Were olwoŋo ma jonitie i mar pa Were Bawan kodi kur pa Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JUD 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wor, siem, kodi mar wobedi riwin mathoth.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JUD 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JUD 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jowotan m'amaro, onwaŋo atemo paka anyalo ndiko riwin kwoŋ both ma wan kodi win wanigine, munyo aneno ni yenyere ndiko riwin pama ma miyo win miseni ma lweny ri yeyo ma Were otieko miyo ji pere dicel kicutho. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.3",
            "verseOrgIds": [
              "JUD.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JUD 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole jomoro m'otiek thumo rijo banja wok con, jotieko lwi to jodonjo nyaliŋliŋ i dier win ma wikineno. Jokuya Were aka jokomo fonji kwoŋ ŋono pa Were ma umo reco pajo aka jokwero Yesu Kristo, madwoŋ loyo kendo obedo Rwodhiwan. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.4",
            "verseOrgIds": [
              "JUD.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JUD 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.51"
              },
              "items": [
                {
                  "text": "Wok 12:51",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.29+NUM.14.30"
              },
              "items": [
                {
                  "text": "Kwan 14:29-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kada witieko ŋeyo gime, je fodi amito poyo win paka Rwoth obotho Joisiraili i piny Misir, to rumacen reyo woko ji ma jokwero yeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JUD 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poyi win ni jomalaika ma jokalo kew ma meni pajo, to joweyo kabedo pajo, Were okano jo piny i mudho, to tweyo jo gi lijegere ma cil gi cil ri ndelo madwoŋ m'ibino thum'iye rijo banja. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.6",
            "verseOrgIds": [
              "JUD.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JUD 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.1+GEN.19.2+GEN.19.3+GEN.19.4+GEN.19.5+GEN.19.6+GEN.19.7+GEN.19.8+GEN.19.9+GEN.19.10+GEN.19.11+GEN.19.12+GEN.19.13+GEN.19.14+GEN.19.15+GEN.19.16+GEN.19.17+GEN.19.18+GEN.19.19+GEN.19.20+GEN.19.21+GEN.19.22+GEN.19.23+GEN.19.24"
              },
              "items": [
                {
                  "text": "Cak 19:1-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ameno bende apaka Sodom gi Gomora, kodi tindin m'othoko jo ma cango jotimo paka jomalaika jotimo, aka jotimo cot kodi kidakana, jobedo ranen ri ji paka joma candere i mac cil gi cil. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
            "verseOrgIds": [
              "JUD.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JUD 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno bende, jome lek pajo wondo jo aka miyo jotimo gimarac i delkwoŋ gin won. Jocayo meni pa Were, odoko jocayo jomalaika ma jonitie gi dwoŋ i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.8",
            "verseOrgIds": [
              "JUD.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JUD 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.13"
              },
              "items": [
                {
                  "text": "Dan 10:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
