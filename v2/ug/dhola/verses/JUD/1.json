                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.34.6"
              },
              "items": [
                {
                  "text": "Cik 34:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.2"
              },
              "items": [
                {
                  "text": "Zek 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kole kada malaika madwoŋ, Mikaili, k'otemo yeto jwogi gi wac mareco munyo jopiemo ni ŋa ma d'otero delkwoŋ Musa, to owaco ni, “Rwoth woay kwoŋin.” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JUD 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "To jome joyeto gima jokuya dwoŋ mere, aka gima joŋeyo timo pa le m'ongoye gi paro, a gigipiny ma bino reyo jo woko. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JUD 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.3+GEN.4.4+GEN.4.5+GEN.4.6+GEN.4.7+GEN.4.8"
              },
              "items": [
                {
                  "text": "Cak 4:3-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.1+NUM.22.2+NUM.22.3+NUM.22.4+NUM.22.5+NUM.22.6+NUM.22.7+NUM.22.8+NUM.22.9+NUM.22.10+NUM.22.11+NUM.22.12+NUM.22.13+NUM.22.14+NUM.22.15+NUM.22.16+NUM.22.17+NUM.22.18+NUM.22.19+NUM.22.20+NUM.22.21+NUM.22.22+NUM.22.23+NUM.22.24+NUM.22.25+NUM.22.26+NUM.22.27+NUM.22.28+NUM.22.29+NUM.22.30+NUM.22.31+NUM.22.32+NUM.22.33+NUM.22.34+NUM.22.35"
              },
              "items": [
                {
                  "text": "Kwan 22:1-35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.1+NUM.16.2+NUM.16.3+NUM.16.4+NUM.16.5+NUM.16.6+NUM.16.7+NUM.16.8+NUM.16.9+NUM.16.10+NUM.16.11+NUM.16.12+NUM.16.13+NUM.16.14+NUM.16.15+NUM.16.16+NUM.16.17+NUM.16.18+NUM.16.19+NUM.16.20+NUM.16.21+NUM.16.22+NUM.16.23+NUM.16.24+NUM.16.25+NUM.16.26+NUM.16.27+NUM.16.28+NUM.16.29+NUM.16.30+NUM.16.31+NUM.16.32+NUM.16.33+NUM.16.34+NUM.16.35"
              },
              "items": [
                {
                  "text": "Kwan 16:1-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kidamba wobedi rijo! Joluwo royo ma Kayin cango oluwo. Jomunyere i fonji m'okom ro woro, paka cango Balam otimo. Jobino kisika woko ro piem paka cango Kora gin jotimo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.11",
            "verseOrgIds": [
              "JUD.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JUD 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jocale cilo ma duwo kalima mewin, jokapakapa gi medho aka jocemo kodi win m'ongoye wickwot. Jobedo jokwath ma joparo kwoŋ iy gin wegi. Jocale pondeponde ma koyo lera gine to kikel koth. Jocale yen ma kinyak olemo kada i cwir, yen m'otiek fudho woko gi tiendi gin aka jotho woko kicutho. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.12",
            "verseOrgIds": [
              "JUD.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JUD 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jocale kitula pa pi i nam, aka tim pajo ma wickwot yenyo malo pa bwoyo. Jocale micalin m'ocot, ma Were otieko yiko rijo kabedo ma cil gi cil i mudho. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.13",
            "verseOrgIds": [
              "JUD.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JUD 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.5.18"
              },
              "items": [
                {
                  "text": "Cak 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.5.21+GEN.5.22+GEN.5.23+GEN.5.24"
              },
              "items": [
                {
                  "text": "21-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Enoka, nyakwar Adam ma nyatirtir i luse mar'abirio, cango oluwo kwoŋ jo con ni, “Neni! Rwoth bino gi jopere maleŋ gana gi gana, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.14",
            "verseOrgIds": [
              "JUD.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JUD 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma thumo banja ri ji je, gi nyutho joreco je ma jokilwor Were, tim pajo mareco ma kwero lworo Were, kodi wac mareco ma joma kilwor Were joluwo kwoŋ Were! ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.15",
            "verseOrgIds": [
              "JUD.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JUD 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji me noknok jogesa aka jopusa jowot jo. Jotiyo g'awanya pajo mareco, wegi joyumere aka jodwoŋo wadi gin, ŋey jowotimi gima wegi joyenyo.”",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.16",
            "verseOrgIds": [
              "JUD.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miyo fonji gi rieko ma ciro gima bino",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JUD 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.16",
            "verseOrgIds": [
              "JUD.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JUD 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To poyi win, merin paran m'amaro, gima jomoor pa Rwodhiwan Yesu Kristo jowaco riwin ndir m'okadho ni bino timere. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.17",
            "verseOrgIds": [
              "JUD.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JUD 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.3"
              },
              "items": [
                {
                  "text": "2 Pet 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jowaco riwin ni, “I ndelo ma rumacen, ji jobino wok ariwa ma jobino nyero win, ji ma jotiyo g'awanya pajo mareco.” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.18",
            "verseOrgIds": [
              "JUD.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JUD 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me a ji ma jokelo tiakirok, ma paro pajo mareco dhumo jo, ma jongoye gi Cuny Maleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.19",
            "verseOrgIds": [
              "JUD.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JUD 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "To win, merin paran m'amaro, medere win gi dongo i yeyo mewin m'oasa leŋo, aka kway win i meni pa Cuny Maleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.20",
            "verseOrgIds": [
              "JUD.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JUD 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bedi win i mar pa Were kareno wikuro wor pa Rwodhiwan Yesu Kristo, ma bino kelo riwin kwo makirum. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.21",
            "verseOrgIds": [
              "JUD.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JUD 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma fodi joganagana, nyuthi win jo wor. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.22",
            "verseOrgIds": [
              "JUD.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JUD 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bothi win joman munyo wifudho jo woko abwap kwoŋ mac. Nyuthi win joman bende wor kareno wikure gi lworo; aka wiripo dak kiri ruk pa joma awanya pajo ma kidakana oduwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.23",
            "verseOrgIds": [
              "JUD.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JUD 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ri ŋata nyalo thielin m'ikipodho, to kethin ma bu raco i kisangala ma didwoŋ pere, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.24",
            "verseOrgIds": [
              "JUD.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JUD 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ri Were ma Jaboth mawan acel kende: Wor, dwoŋ, meni, kodi dhum wobedi rigo, i ndir m'okadho, ma pama, kodi ma cil gi cil, i Yesu Kristo. Ameno.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.25",
            "verseOrgIds": [
              "JUD.1.25"
            ]
          }
        }
      ]
