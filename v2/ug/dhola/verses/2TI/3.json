        "style": "s1"
      },
      "items": [
        {
          "text": "Ndelo ma Rumacen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ŋey gime: Teko bino bedo madit i ndelo ma rumacen. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.1",
            "verseOrgIds": [
              "2TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato ji jobino bedo jogwondo, joma wor i pesa, jokwoto, joyumirok, joyet, joma kiwinji jonywol pajo, joma kifoy gimoro, joma kileŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.2",
            "verseOrgIds": [
              "2TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobino bedo joma jongoye gi wor, joma jongoye gi cwaki, jowaci nyingi wadi gin, joma wany kendo mager, jobino dak gimaber. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.3",
            "verseOrgIds": [
              "2TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobino bedo jokwedirok, joma kidew gimoro, joma kwot gi pakirok, jobino maro kisangala ma piny loyo Were. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.4",
            "verseOrgIds": [
              "2TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobino moko kwoŋ gima wiyewiye i yeyo Were, to jokwero meni mere. Gwokere kwoŋ joma pameno. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.5",
            "verseOrgIds": [
              "2TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomegi kwoŋ jo jodonjo i udi to jodiyo mon ma miŋmiŋ, ma jopoŋ gi reco aka awanya ma nger je ywayo jo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.6",
            "verseOrgIds": [
              "2TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon ma ndir je jotemo fonjirok to jokinyal ŋeyo adieri, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.7",
            "verseOrgIds": [
              "2TI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.11"
              },
              "items": [
                {
                  "text": "Wok 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "paka Janes kodi Jambure gin jopiemo gi Musa, ameno jono bende jopiemo kodi adieri. Jobedo ji ma paro pajo kitiy, aka yeyo odhiero jo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.8",
            "verseOrgIds": [
              "2TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "To jok'okadhi bor, rupiri dhano je bino neno miŋo pajo, paka joneno apa cwo ario no.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fonji macowe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "T'itieko kikaŋasa fonji paran, kula paran, kodi atoŋa paran ma kwo. Itieko kikaŋasa yeyo paran, diyo cuny paran, mar paran, ciro paran, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.10",
            "verseOrgIds": [
              "2TI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.14+ACT.13.15+ACT.13.16+ACT.13.17+ACT.13.18+ACT.13.19+ACT.13.20+ACT.13.21+ACT.13.22+ACT.13.23+ACT.13.24+ACT.13.25+ACT.13.26+ACT.13.27+ACT.13.28+ACT.13.29+ACT.13.30+ACT.13.31+ACT.13.32+ACT.13.33+ACT.13.34+ACT.13.35+ACT.13.36+ACT.13.37+ACT.13.38+ACT.13.39+ACT.13.40+ACT.13.41+ACT.13.42+ACT.13.43+ACT.13.44+ACT.13.45+ACT.13.46+ACT.13.47+ACT.13.48+ACT.13.49+ACT.13.50+ACT.13.51+ACT.13.52"
              },
              "items": [
                {
                  "text": "Tim 13:14-52",
