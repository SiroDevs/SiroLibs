              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balwa m'owok bongi Paulo, jamoor pa Kristo Yesu i mito pa Were, m'oor tito kwo m'ocik ma wanigine i Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        }
      ]
    },
