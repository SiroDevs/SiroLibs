          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kacako munyo alwenyo gi thielo wac paran i kiosa, ongoye ŋat'ocungo kabutan, ji je joweyan. Akwayo ni Were wokiri wokwan kwoŋ jo reco no! ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.16",
            "verseOrgIds": [
              "2TI.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Rwoth obedo kodan aka omiyan meni, am'omiyo anyalo tuco mikwenda je ri Jopath jowowinji. Aka obothan i laki Simbwor. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.17",
            "verseOrgIds": [
              "2TI.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth bino konyan i raco je, to bothan ri Ker ma polo. Dwoŋ wobedi rigo cil gi cil. Ameno.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.18",
            "verseOrgIds": [
              "2TI.4.18"
            ]
          }
        }
      ]
