                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alekizanda jathieth otimo ran marac swa, Rwoth bino miyo go kemba ro gima go otimo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
