                  "text": "Tim 20:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "K'ibino, keli ran kot paran m'aweyo Tirowa gi Karupo; keli kitawin bende, tektek mere kitawo m'otimi akwoya.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.13",
