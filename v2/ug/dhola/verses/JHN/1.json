{
  "id": "JHN.1",
  "number": "1",
  "bookId": "JHN",
  "reference": "Yohana 1",
  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
