        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.18",
            "verseOrgIds": [
              "JAS.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JAS 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wutmera, ka nyatoro kwoŋ win oweyo adieri, to ŋatiman dwoko go kendo, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.19",
            "verseOrgIds": [
              "JAS.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.12"
              },
              "items": [
                {
                  "text": "Agec 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.8"
              },
              "items": [
                {
                  "text": "1 Pet 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "poyi win gime: Ŋatimoro je m'odwok ŋatarac wok i royo pere m'okom, bino botho cuny ŋatarac no kwoŋ tho, to miyo icwako rigo reco madit.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.20",
