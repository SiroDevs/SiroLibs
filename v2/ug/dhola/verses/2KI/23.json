        "style": "s1"
      },
      "items": [
        {
          "text": "Kere Yosia kwanyo woko lamo manyakafir",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Kere Yosia olwoŋo jotel je ma Yuda gi Yerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka okidho gi jo i Ot pa Were kanyacel kodi jocway ri Were i wi migam, jotuci wac Were kodi ji je, jocandi kodi joŋaŋo. Kere osoma kitawo ma cikirok m'onwaŋere i Ot pa Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere ocungo cegin gi siro acel aka otimo cikirok gi Rwoth winjo go, kuro cik kodi Or pere gi cunye je kodi adundo pere je kodi ketho i tim gima cikirok mito paka ondiki i kitawo. Aka ji je bende jociko kuro cikirok.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
