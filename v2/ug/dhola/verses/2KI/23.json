            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji ma Bethel jodwoko ni, “Meno kaliel pa jatuci wac Were m'owok i Yuda to waco gigipiny m'itimo ri migam me.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
