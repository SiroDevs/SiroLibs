        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elia odwoko ni, “Meno kwac matek miyo, to ibino limo k'inenan paka ikwanyan woko bongin. K'ikinenan, ikibino limo.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
            "verseOrgIds": [
              "2KI.2.10"
            ]
          }
        }
      ]
