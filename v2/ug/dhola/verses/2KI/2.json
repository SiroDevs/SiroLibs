          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa oeye Yeriko kadho Bethel, aka i yo yac mogo jobino wok i tindi to jojwiyo go ka jokoko ni, “Ngoye ka, japata!”",
          "type": "text",
          "attrs": {
