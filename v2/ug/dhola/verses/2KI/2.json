        },
        {
          "text": "Kitipa pa jotuci wac Were jobino bongi Elisa aka jopenjo ni, “Iŋeyo paka konon me Rwoth kidho tero jadwoŋ perin woko?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
