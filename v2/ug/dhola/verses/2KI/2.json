          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Elisa odwoko ni, “Akwoŋere i nyingi Rwoth makwo kodi rin nike akibino weyin.” Ameno jokadho i Bethel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
