          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka Elisa okidho i waŋ pi to konjo cumbi i pi to waco ni, “Me a gima Rwoth waco ni, ‘Aloko pi me macil aka kilakelo tho kosa podho ici kendo.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
