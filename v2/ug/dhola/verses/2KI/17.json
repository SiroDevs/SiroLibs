                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kiri konon me fodi joluwo kwer pajo macon. Jokilam Rwoth aka jokiluwi cik kodi Or pere m'omiyo nyikway Yakobo, m'ocwoko nyinge ni Isiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
