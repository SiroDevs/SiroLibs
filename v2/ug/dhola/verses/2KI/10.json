        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.27",
            "verseOrgIds": [
              "2KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
