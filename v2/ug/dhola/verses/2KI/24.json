                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza otero Yehoyakin paka jatwec i Babilon, kanyacel gi min, mon pere, jodhum pere kodi jotel ma Yuda je. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza otero cwo ma jonitie gi cwe je i Babilon, joje 7,000 kodi jondijo 1,000 kiri gi jokidonya cumin. Me je oyido cwo ma jobad gin aka jocwiny ma lweny.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        }
      ]
