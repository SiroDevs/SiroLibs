              "2KI.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakin obedo kere ma Yuda munyo jaoro apar g'aboro, aka odhumo i Yerusalem ma dwe adek. Yokimere oyido obedo Nehusita nyar Elinathan ma Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.8",
            "verseOrgIds": [
              "2KI.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakin oluwo kite pa bamere, to timo reco ruwaŋ Rwoth.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
