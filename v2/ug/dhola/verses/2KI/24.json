            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo ma dhum pere ama Nebukadineza otelo jolweny ma Babilon kwoŋ Yerusalem to jothoko. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo ma thoko tindi Yerusalem, Nebukadineza won gipi obino i Yerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.24+JER.22.25+JER.22.26+JER.22.27+JER.22.28+JER.22.29+JER.22.30"
              },
              "items": [
                {
                  "text": "Yer 22:24-30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.1+JER.24.2+JER.24.3+JER.24.4+JER.24.5+JER.24.6+JER.24.7+JER.24.8+JER.24.9+JER.24.10"
              },
              "items": [
                {
                  "text": "24:1-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.1+JER.29.2"
              },
              "items": [
                {
                  "text": "29:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aka kere Yehoyakin, min, wote, jodhum pere, kodi jodhum ma cel pa kere jotiŋo cingi gin ri Jobabilon. I oro mar'aboro ma dhum pa Nebukadineza otero Yehoyakin paka jatwec. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza otiŋo lim je ma Ot pa Rwoth kodi ma cel pa kere, oturo gigipiny ma zahabu ma kere Solomon oyido otimo aora i Ot pa Rwoth, paka Rwoth oyido otieko waco. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza otero ji ma Yerusalem paka jotwec, jodhum ma Yerusalem, cwo ma jotel je, kanyacel 10,000. Okadho gi cwo ma jondijo je, kiri gi jokidonya cumin, to weyo nyaka jocandi loyo i Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        }
      ]
    },
