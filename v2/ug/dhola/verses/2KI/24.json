                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan 1:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I hongo ma dhum pa Yehoyakim, kere Nebukadineza ma Babilon omonjo Yuda, aka ma oro adek Yehoyakim obedo pere; to rumacen gwenyere kwoŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth ooro jolweny ma Babilon, Siria, Mowab, kodi Amon monjo Yehoyakim joworey woko Yuda paka Rwoth oyido owaco luwo kwoŋ ŋecin pere jotuci wac Were. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adieri gime opodho kwoŋ Yuda luwo i cik pa Rwoth, ŋey wokwany woko ji ma Yuda ruwaŋe, ro reco ma kere Manase oyido otimo, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodi tektek mere kwoŋbedo oneko ji ma bubanja. Rwoth k'onyalo cwako Manase ro gino.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gigipiny man je ma Yehoyakim otimo ondiki i kitawo ma kigana mako kwoŋ kerin ma Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakim otho, aka wode Yehoyakin olunjo go paka kere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere ma Misir kodi jolweny pere jok'owok Misir kendo kwoŋbedo kere ma Babilon oyido otieko mako adec je m'oyido obedo apa kere ma Misir, wok i malawa Yufrete tundo i kew gi Misir.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kere Yehoyakin ma Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
