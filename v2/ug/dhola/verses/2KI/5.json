            "number": "25",
            "style": "v",
            "sid": "2KI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Elisa owaco rigo ni, “Oyido angoye kenyo i cuny munyo jalo oloro wok i cawila pere romo kodin? Me k'obedo hongo ma jolo pesa kodi nangin, ndelo nanzi kodi ndelo vini, rombo kodi dhok, kosa ŋecin! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.26",
            "verseOrgIds": [
              "2KI.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno dhowo pa Naman bino yimere kwoŋin kodi nyikwayin cil gi cil.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.27",
            "verseOrgIds": [
              "2KI.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Gehazi oeye ruwaŋ Elisa gi dhowo matar pa pe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.27",
            "verseOrgIds": [
              "2KI.5.27"
            ]
          }
        }
