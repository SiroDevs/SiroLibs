            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I oro ma piero adek g'aboro ma dhum pa Uziya kere ma Yuda, Zekaria wod pa Yerobowam mar'ario obedo kere ma Isiraili aka odhumo i Samaria ma dwe aucel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paka kerin ma jotelo dhumo rigo, otimo reco kwoŋ Rwoth to luwo kite pa kere Yerobowam wod pa Nebat m'omiyo Joisiraili timo reco. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salum wod pa Yabes ocamo sereko ri kere Zekaria to neko go i Ibilim aka olunjo go paka kere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        }
