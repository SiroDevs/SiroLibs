              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedo i hongo ma dhum pere ama Rwoth ocako dhiro kere Rezin ma Siria kodi kere Peka wod pa Remalia monjo Yuda. ",
          "type": "text",
          "attrs": {
