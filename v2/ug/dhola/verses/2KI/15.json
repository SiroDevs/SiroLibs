          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otimo reco kwoŋ Rwoth, ka luwo kite pa kere Yerobowam wod pa Nebat m'omiyo Isiraili timo reco. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
