            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elia odwoko ni, “K'inen abedo jacwo pa Were, weyi mac wobin wok i polo wonekin kodi cwo perin.” Kenyo mac obino wok i polo to reyo jo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
