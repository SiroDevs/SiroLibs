            "sid": "2KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo kere ooro jatel pa jolweny kodi jolweny piero abic bongi Elia. Jonwaŋo go obedo i wi tendere aka jatel pa jolweny owaco rigo ni, “Jacwo pa Were, kere miyin cik loro piny.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
