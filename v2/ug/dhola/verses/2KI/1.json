                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jodwoko ni, “Oruko law ma pien ogwaŋ to tweyo piere gi del ma pien diel.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
