            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere ooro jatel pa jolweny man kendo, kodi jolweny piero abic. Jatel pa jolweny oidho malo to waco ri Elia ni, “Jacwo pa Were, kere miyin cik loro piny piyo!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        }
