          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elia odwoko jo ni, “K'inen abedo jacwo pa Were, weyi mac wobin wok i polo aka wonekin kodi cwo perin!” Kenyo mac pa Were obino wok i polo to neko jatel pa jolweny kodi cwo pere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
