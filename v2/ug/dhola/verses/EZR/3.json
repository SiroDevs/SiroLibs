            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo jogeto jocako misingi ma Ot pa Rwoth, jocway ri Were i wi migam joruko law pajo aka jomako kabedo pajo gi gwara i cingi jo, Jolevi ma nono pa Asaf jocungo kenyo gi nyweny m'irudo. Jopako Rwoth cungo kwoŋ cik ma Kere Daudi oyido omiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
