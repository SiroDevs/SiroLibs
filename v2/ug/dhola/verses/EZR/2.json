            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodwoko gi Zerubabel, Yesuwa, Nehemia, Seraya, Relaya, Modekay, Bilsan, Mispar, Bigvay, Rehum, kodi Bana.",
