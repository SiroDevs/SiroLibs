              },
              "items": [
                {
                  "text": "14:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aneno i menyirok wor, neni, ŋata cale Wod Dhano obino gi pondeponde wok i polo bongi Ŋatacene t'ikelo go ruwaŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.13",
            "verseOrgIds": [
              "DAN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.15"
              },
              "items": [
                {
                  "text": "Meny 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ri go omiy dhum, dwoŋ, kodi ker, ŋey ji je, nonin je, kodi dhodhok je jowotiy rigo. Dhum pere obedo dhum ma cil gi cil, ma kilarumo, aka ker pere kilarere.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.14",
            "verseOrgIds": [
              "DAN.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dwoŋ ma menyirok ma Daniel oneno",
          "type": "text"
        }
      ]
    },
