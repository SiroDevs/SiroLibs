        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.36",
            "verseOrgIds": [
              "DAN.11.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
