          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno, Awi kere, me rieko m'amiyin, aka yere gine. Pusere reco perin, gi timo gim'otire, weyi komo perin aka inyuthi jocandi wor, ŋey bero perin woyindira.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
