              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo oro abirio no orumo, An Nebukadineza, atiŋo waŋan i polo, aka paro paran odwoko bongan.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
