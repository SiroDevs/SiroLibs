                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka nibaija kuba abairu be, babone kumanya obutegyeki bwangye, n'obw'abagabe b'ezo nsi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.8",
            "verseOrgIds": [
              "2CH.12.8"
            ]
