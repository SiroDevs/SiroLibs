              "2CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima omugabe Rehoboamu yaaheesha ezindi z'emiringa omu mwanya gwazo, yaazibiitsya abakuru b'abarinzi, abaabaire barinda orwigi rw'enju y'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.10",
            "verseOrgIds": [
              "2CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutoosha omugabe ku yaabaire aza omu nju ya MUKAMA, abo barinzi baija, bazihagatira, bwanyima bazigarura omuri egyo nju y'abarinzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.11",
            "verseOrgIds": [
              "2CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.19.3"
              },
              "items": [
                {
                  "text": "2 Bus 19:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaayecureize, ekiniga kya MUKAMA kyamurugaho, ngu arekye kumucwekyerereza kimwe; kandi omuri Yuda ebintu bikaba biriho gye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.12",
            "verseOrgIds": [
              "2CH.12.12"
            ]
          }
        }
      ]
    },
    {
