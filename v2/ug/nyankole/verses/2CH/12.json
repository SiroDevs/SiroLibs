        },
        {
          "text": " Obugabe bwa Rehoboamu ku bwaherize kuhama n'okuba obw'amaani, we n'Abaisraeli boona baareka kukuratira ebiragiro bya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.1",
            "verseOrgIds": [
              "2CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
