              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe yaabiyagiza omu ruhita rwa Yorudani omu itaka ry'eibumba ahagati ya Sukoosi na Zereda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.17",
            "verseOrgIds": [
              "2CH.4.17"
            ]
          }
        },
        {
