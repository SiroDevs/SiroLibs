                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaakora eitambiro ry'emiringa, oburangwa bwaryo mikono makumi abiri, obuhango bwaryo mikono makumi abiri, n'obwemi bwaryo mikono ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.1",
            "verseOrgIds": [
              "2CH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26"
              },
              "items": [
                {
                  "text": "1 Bag 7:23-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yaaheesha ekitanka ky'amaizi ekyezigoire; okukicwekanisa mikono ikumi, obwemi bwakyo mikono etaano, kandi okwehinguririza omugoma gwakyo mikono makumi ashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.2",
            "verseOrgIds": [
              "2CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ahansi y'obugyenyero bwakyo haakiikizeamu ebishushani by'ebisisi biri omu mishorongo ebiri, biheesherainwe nakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.3",
            "verseOrgIds": [
              "2CH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kitanka kikaba kiteekirwe aha bishushani by'enimi ikumi na ibiri, bishatu nibireeba aha bukiizi-bwa-bumosho, bishatu aha burengyerwa-izooba, bishatu aha bwa-buryo, na bishatu aha burugwa-izooba; ekyo kitanka kiteekirwe ahaiguru yaabyo, biteeraine ebibunu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.4",
            "verseOrgIds": [
              "2CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubiri gwakyo gukaba guri ekita kimwe; eminwa yaakyo ekaba ekozirwe nk'ey'ekikopo, nari nk'ekirabyo ky'emyangangye; nikigiibwamu encuro enkumi ishatu z'ebinyungu bihango. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.5",
            "verseOrgIds": [
              "2CH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.38"
              },
              "items": [
                {
                  "text": "1 Bag 7:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.39"
              },
              "items": [
                {
                  "text": "39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaakora ebinaabiro ikumi by'okunaabiramu; bitaano yaabita aha rubaju rw'obukiizi-bwa-buro, n'ebitaano aha rw'obwa bumosho. Ebyo nibyo baabaire bamunyungurizamu ebintu ebi baabaire bakoresa ahabw'ebitambo by'okwotsya, kandi ekitanka nikyo abanyamurwa baabaire banaabiramu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.6",
            "verseOrgIds": [
              "2CH.4.6"
            ]
          }
        }
      ]
    },
