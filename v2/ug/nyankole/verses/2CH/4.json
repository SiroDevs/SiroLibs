          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemaani yaakora ebintu bingi munonga ebi, oburemeezi bw'emiringa yaabyo bwabaire butarikubaasa kumanywa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.18",
            "verseOrgIds": [
              "2CH.4.18"
            ]
          }
        }
