            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaakora ebitebe n'ebinaabiro aharibyo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.14",
            "verseOrgIds": [
              "2CH.4.14"
            ]
          }
