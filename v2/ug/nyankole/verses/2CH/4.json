              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ekitanka kimwe n'ebishushani by'enimi ikumi na bibiri ebyabaire biri ahansi yaakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.15",
            "verseOrgIds": [
              "2CH.4.15"
            ]
          }
        },
