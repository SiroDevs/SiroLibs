              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebishushani by'ebirabyo, amatabaaza n'empana z'ezaabu, byona byaba eby'ezaabu eshemeziibwe munonga; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.21",
