          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebikondo by'amatabaaza n'amatabaaza gaabyo g'ezaabu eshemeziibwe g'okwakira omu maisho g'Omwanya ogurikwera ogw'omunda, nk'oku kyaragiirwe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.20",
            "verseOrgIds": [
              "2CH.4.20"
            ]
          }
