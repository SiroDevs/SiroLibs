              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Sulemaani yaakora ebintu byona eby'okuta omu nju ya MUKAMA; eitambiro ry'ezaabu, emeeza z'emigaati y'okumurikwa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
