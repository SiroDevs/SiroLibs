          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "enyomyo ibiri, n'enyaba, n'emitwe ebiri aha mitwe y'ezo nyomyo, n'obutimba bubiri bw'okushweka enyabya ibiri ez'aha mitwe y'ezo nyomyo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
