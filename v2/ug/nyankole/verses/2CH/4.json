                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ebishushani by'ebijuma by'amakomamahanga eby'okuhunda aha butimba bwombi obwabaire buri aha mitwe y'enyomyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.13",
            "verseOrgIds": [
              "2CH.4.13"
            ]
          }
        },
