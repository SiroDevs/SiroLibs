              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaakora ebikondo by'ezaabu ikumi, nk'oku kyaragiirwe, yaabita omuri hekalu, bitaano aha rubaju rw'obukiizi-bwa-buryo, n'ebitaano aha rwabumosho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.7",
            "verseOrgIds": [
              "2CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.48"
              },
              "items": [
                {
                  "text": "1 Bag 7:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaakora emeeza ikumi, yaazita omuri hekalu, itaano aha rubaju rwa buryo, na itaano aha rwa bumosho; yaakora n'enyabya z'ezaabu igana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.8",
            "verseOrgIds": [
              "2CH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
