          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.17",
            "verseOrgIds": [
              "2CH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
