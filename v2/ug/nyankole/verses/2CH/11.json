            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.6"
              },
              "items": [
                {
                  "text": "1 Sam 16:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.13"
              },
              "items": [
                {
                  "text": "17:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rehoboamu akashwera Mahalaasi muhara wa Yerimoosi mwene Daudi na Abihaili muhara wa Eliabu mwene Yese; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.18",
            "verseOrgIds": [
              "2CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaamuzaarira abaana b'aboojo, Yeushi, Shemaria na Zahaamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.19",
            "verseOrgIds": [
              "2CH.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima y'ogwo yaashwera Maaka, muhara wa Abusalomu, yaamuzaarira Abiya, Atai, ziiza na Shelomiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.20",
            "verseOrgIds": [
              "2CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kandi Rehoboamu akashwera abakazi ikumi na munaana n'ebinyanshunju makumi mukaaga; yaazaara abaana b'aboojo makumi abiri na munaana, n'ab'abaishiki makumi mukaaga); kwonka akaba akunda Maaka muhara wa Abusalomu okukira abakazi be boona n'ebinyanshunju bye; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.21",
            "verseOrgIds": [
              "2CH.11.21"
            ]
          }
        },
