            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaashohora kubugana Asa, yaamugira ati: Iwe n'Abayuda n'Ababenyamiini, mumpurire. Ruhanga ari hamwe naimwe, mwaba muri hamwe nawe. Ku murikumusherura, nimumuzoora; kwonak ku murikumutsigaho, nawe naabatsigaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.2",
            "verseOrgIds": [
              "2CH.15.2"
            ]
          }
        },
        {
