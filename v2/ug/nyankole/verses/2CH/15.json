              "items": [
                {
                  "text": "Neh 10:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baaragaana endagaano kusherura MUKAMA Ruhanga wa baishenkurubo n'omutima gwabo gwona n'amagara gaabo goona; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.12",
            "verseOrgIds": [
              "2CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.6+DEU.13.7+DEU.13.8+DEU.13.9"
              },
              "items": [
                {
                  "text": "Bir 13:6-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ngu, omuntu weena oraayangye kusherura MUKAMA, Ruhanga wa israeli, yaaba muto, yaaba mukuru, yaaba mushaija, yaaba mukazi, aitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
              "2CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baarahira omu maisho ga MUKAMA n'eiraka rihango, nibateera akaari, n'amakondere n'enzamba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
              "2CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.7"
              },
              "items": [
                {
                  "text": "2 Bus 14:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abayuda boona baashemerererwa egyo ndahiro; ahakuba bakarahira n'omutima gwabo gwona, kandi baamusherura n'okwetenga kwabo kwona, baamuzoora; MUKAMA yaabaha obuhuumure embaju zoona.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        }
      ]
