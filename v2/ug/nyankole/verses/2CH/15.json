                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Asa ku yaahuriire ebyo bigambo by'obunabi bwa Azaria mwene Odedi, yaagu, yaiha ebishushani ebirikunugwa omu nsi yoona eya Yuda n'eya Benyamiini n'omu ndembo ezi yaakubwire omu nsi y'ebibungo eya Efuraimu, kandi yaahunduuza eitambiro rya MUKAMA eryabaire riri omu maisho g'ekisasi eky'omu maisho ga hekalu ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.16"
              },
              "items": [
                {
                  "text": "2 Bus 11:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yaateeranira hamwe Abayuda n'Ababenyamiini boona, n'abaarugire omuri Efuraimu, Manaase na Simeoni, abaabaire baabashuhuukiiremu; ahakuba abantu baingi, ku baareebire MUKAMA Ruhanga we ari hamwe nawe, baacwa omuri Israeli, baija, baamwehongyera. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kwezi kwa kashatu kw'omu mwaka gwa ikumi n'etaano ogw'omu busingye bwa Asa, nibwo baateeranira Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.10",
            "verseOrgIds": [
              "2CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.13+2CH.14.14+2CH.14.15"
              },
              "items": [
                {
                  "text": "2 Bus 14:13-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahari eryo izooba baatambira MUKAMA ente magana mushanju n'entaama obukumi mushanju, nibaziiha omu minyago ei baabaire bareetsire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.11",
            "verseOrgIds": [
              "2CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 15:12"
