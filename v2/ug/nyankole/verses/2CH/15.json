            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimumanya ku Abaisraeli baamazire omwanya muhango bataine Ruhanga nyamuhanga, n'obu yaakuba omunyamurwa orikubeegyesa, kandi bataine biragiro; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
