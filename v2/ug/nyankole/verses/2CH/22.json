            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.11.1+2KI.11.2+2KI.11.3"
              },
              "items": [
                {
                  "text": "2 Bag 11:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atalia nyina wa Ahazia, ku yaareebire omutabani yaafa, yaimuka yaacwekyereza ab'oruganda rw'omugabe wa Yuda boona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Yehoshabeasi muhara w'omugabe yaatwara Yoasi mwene Ahazia, yaamwiba omuri batabani b'omugabe, abaabaire bari haihi kwitwa, we n'omurezi we yaabata omu kishengye ky'okuraaramu. Atyo Yehoshabeasi, muhara w'omugabe Yehoraamu, kandi muka Yehoyaada omunyamurwa, ahabw'okuba munyaanya wa Ahazia, yaamushereka Atalia, tiyaamwita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.11",
            "verseOrgIds": [
              "2CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamara nabo emyaka mukaaga, asherekirwe omu nju ya Ruhanga; obwo Atalia naategyeka ensi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.12",
            "verseOrgIds": [
              "2CH.22.12"
            ]
          }
        }
      ]
    }
