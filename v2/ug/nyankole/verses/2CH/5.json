                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi emigamba ekaba eri miraingwa munonga; n'ahabw'ekyo emitwe yaayo ekaba ereebekyera omu mwanya ogurkwera omu maisho g'Omwanya ogurikwera ogw'omunda; kwonka ekaba etarikubaasa kureeberwa heeru; kandi na hati ekiriyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
