          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Amoni ogwo tiyaayecureeza mu maisho ga MUKAMA, nk'oku Manaase ishe yaagizire, kureka yaaguma naayeyongyera kushiisha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
          }
        },
        {
          "name": "verse",
