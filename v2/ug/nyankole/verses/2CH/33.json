          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka abantu b'omuri egyo nsi baita abaamugiriire enaama boona; baayemeka Yosia omutabani omu mwanya gwe.",
          "type": "text",
          "attrs": {
