                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi abantu baitu b'okwo beegye kuguma nibakora ebirungi, babone kuhwera abashemereire kuhwerwa buzima, barekye kuba abatarikwana byana.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
