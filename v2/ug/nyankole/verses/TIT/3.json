            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku ndikutumaho Arutema nari Tukiko, oteereho nk'oku orikubaasa, kunshanga Nikopooli; ahakuba okwo niyo mmaririire kumarira ebiro by'embeho. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
