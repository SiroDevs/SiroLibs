                "loc": "1TI.6.4"
              },
              "items": [
                {
                  "text": "1 Tim 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " noomanya ku omuntu nk'ogwo ahabire, kandi ku ari enkozi y'ebibi, orikwesingisa orubanja.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.11",
            "verseOrgIds": [
              "TIT.3.11"
            ]
