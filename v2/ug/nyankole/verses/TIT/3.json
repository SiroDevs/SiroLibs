              "items": [
                {
                  "text": "Byak 18:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oteereho n'okushendekyereza Zeena, omwegyesa w'Ebiragiro, na Apolo; oreebe ngu tibaine ki babuzire. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        },
