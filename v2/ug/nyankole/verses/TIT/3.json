              },
              "items": [
                {
                  "text": "1 Pet 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obaijutsye kworobera abategyeki n'abaine obushoboorozi, n'okubahurira, n'okweteekateekyera omurimo gwona omurungi, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.1",
            "verseOrgIds": [
              "TIT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "okutagira ou bagambaho kubi, okutatongana kureka okutwaza gye, nibooreka obucureezi bwingi aha bantu boona. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.2",
            "verseOrgIds": [
              "TIT.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.2"
              },
              "items": [
                {
                  "text": "Efe 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba naitwe ira tukaba turi abashema, entahurira, abahabisiibwe, abahuuku b'okwetenga okubi n'okweshemeza okw'emiringo mingi, nitumarira omwanya gwaitu omu itima n'eihari, nitwangwa, kandi nitwangana. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.3",
            "verseOrgIds": [
              "TIT.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka embabazi za Ruhanga Omujuni waitu n'okukunda oku yaakunzire abantu ku byareebekire, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.4",
            "verseOrgIds": [
              "TIT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.8"
              },
              "items": [
                {
                  "text": "Efe 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.5"
              },
              "items": [
                {
                  "text": "Yoh 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaatujuna, ti habw'eby'okuhikiirira ebi twakozire, kureka ahabw'okusaasira kwe, akatujunisa okwogibwa okw'okuzaarwa obwa kabiri n'okuhindurwa abasya omu Mwoyo Orikwera, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.5",
            "verseOrgIds": [
              "TIT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ou yaatushukireho atarikubariirira, naamurabya omuri Yesu Kristo Omujuni waitu, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.6",
            "verseOrgIds": [
              "TIT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.24"
              },
              "items": [
                {
                  "text": "Rom 3:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ngu tubone kwihwaho orubanja ahabw'embabazi ze, tuhindukye abahunguze abaine amatsiko g'amagara agatahwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.7",
            "verseOrgIds": [
              "TIT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo eki n'eky'okwesigwa; kandi niinyenda ngu ebyo obihamye otarikubanganisa, abaikiriize Ruhanga babone kuguma nibata omutima aha kukora ebirungi. Ebigambo ebi ni birungi, kandi nibigasira abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.8",
            "verseOrgIds": [
              "TIT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka oyetantare ebibuuzo by'obushema n'eby'okutondoora obukomooko bwa baishenkurubo n'entongane n'okuhakana aha Biragiro; ahakuba ebyo tibiine mugasho kandi n'ebya busha. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.9",
            "verseOrgIds": [
              "TIT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.15"
              },
              "items": [
                {
                  "text": "Mat 18:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Orikureeta okwecwamu ebicweka omu kanisa, ku orimuteisa rimwe nari kabiri, yaayanga, omurekye; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.10",
            "verseOrgIds": [
              "TIT.3.10"
            ]
          }
        },
