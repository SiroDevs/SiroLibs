            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obwo ndyamaraho Abaisraeli omu nsi ei naabahaire; kandi n'enju ei naashorooreire eiziina ryangye ndyaginaga ngiihe omu maisho gangye; kandi Israeli eryaba eky'okucweraho enfumu n'ekigaaniizo omu mahanga goona. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.7",
            "verseOrgIds": [
              "1KI.9.7"
            ]
          }
        },
