            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sulemaani ku yaaherize kwombeka enju ya MUKAMA, n'ey'obugabe, n'ebindi byona ebi yaabaire naayenda kwombeka,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.1",
            "verseOrgIds": [
              "1KI.9.1"
            ]
