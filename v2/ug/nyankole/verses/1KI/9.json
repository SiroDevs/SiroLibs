                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaamugira ati: Mpuriire okushaba kwawe n'okweshengyereza kwawe, ebi oreetsire omu maisho gangye; nshoroire egyo nju i oyombekire, naatamu eiziina ryangye ngu rigumemu ebiro byona; kandi amaisho gangye n'omutima gwangye biraygigumaho obutwire bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.3",
            "verseOrgIds": [
              "1KI.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.4"
              },
              "items": [
                {
                  "text": "1 Bag 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.38"
              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naiwe ku origyendera omu maisho gangye nka sho Daudi, n'omutima gw'amazima kandi ogugororokire, nookora ebi naakuragiire byona, kandi nooyorobera ebiragiro byangye n'emigyenzo ei naabaragiire, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.4",
            "verseOrgIds": [
              "1KI.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.12"
              },
              "items": [
                {
                  "text": "1 Bag 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naanye ndyahamya ekitebe kyawe ky'obugabe, otegyeke Israeli ebiro byona, nk'oku naaraganiise sho Daudi, nimmugira nti: Toribura muntu w'okuza aha kitebe ky'obugabe bwa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.5",
            "verseOrgIds": [
              "1KI.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.14"
              },
              "items": [
                {
                  "text": "2 Sam 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka iwe nari abaana baawe ku muriteishuka, mwandugaho, mwayanga kworobera ebiragiro byangye n'ebyatairweho ebi naataire omu maisho gaanyu, mwagyenda mwaheereza baaruhanga abandi, kandi mwabaramya, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.6",
            "verseOrgIds": [
              "1KI.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 9:7"
          },
          "items": [
