                "loc": "1KI.3.5"
              },
              "items": [
                {
                  "text": "1 Bag 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaamweyoreka omurundi gwa kabiri, nk'oku yaamweyorekyeire Gibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.2",
            "verseOrgIds": [
              "1KI.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
