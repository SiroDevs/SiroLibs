              "items": [
                {
                  "text": "Mat 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo yaimuka, yaarya, yaanywa, yaagyendera aha mwiguto gw'ebyo by'okurya ebiro makumi ana nyomushana na nyekiro, yaahika ahari Horebu orushozi rwa Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.8",
            "verseOrgIds": [
              "1KI.19.8"
            ]
          }
        }
