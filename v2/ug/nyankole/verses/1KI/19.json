          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima y'omutsitsa haija omuriro, kwonka MUKAMA akaba atagurimu; bwanyima y'omuriro haija akaraka kakye kandi koorobi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.12",
            "verseOrgIds": [
              "1KI.19.12"
            ]
          }
        },
        {
          "name": "verse",
