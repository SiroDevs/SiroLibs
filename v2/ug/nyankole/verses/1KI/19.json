            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaamugira ati: Shohora, oyemerere ahari oru rushozi omu maisho ga MUKAMA. MUKAMA yaarabaho, omuyaga mwingi gw'amaani gwashatura enshozi, gwayatagura enkiri omu maisho ga MUKAMA; kwonka MUKAMA akaba atagurimu. Bwanyima y'omuyaga haija omutsitsa, kwonka MUKAMA akaba atagurimu; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
