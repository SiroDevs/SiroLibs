          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Brui mutware akaba areeta sayiri n'obunyaatsi bw'embaraasi n'obw'ezirikwiruka munonga, nk'oku yaabaire aragiirwa; abireeta omu mwanya ogu byabaire biba nibyetengwamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.4.28"
            ]
