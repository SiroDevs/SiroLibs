                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Sulemaani akaba aine emyanya ei embaraasi ze ezirikukurura ebigaari zirikuraaramu obukumi buna, kandi akaba aine abashaija abarikugyendera aha mbaraasi kakumi n'enkumi ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.26",
            "verseOrgIds": [
              "1KI.4.26"
            ]
          }
        },
