                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.31"
              },
              "items": [
                {
                  "text": "Kur 23:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.4"
              },
              "items": [
                {
                  "text": "Yos 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.26"
              },
              "items": [
                {
                  "text": "2 Bus 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Sulemaani yaategyeka ensi z'abagabe zoona okuruga aha mugyera Furaati, okuhika aha nsi y'Abafilistia, n'aha mwatano gwa Misri; baaguma nibamutoijera, kandi nibamukorera ebiro byona ebi yaamazire aha ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.21",
            "verseOrgIds": [
              "1KI.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutoijo gw'eby'okurya bya Sulemaani omu izooba rimwe gukaba guba encuro z'esaano y'obunono makumi ashatu, n'ez'endiijo saano makumi mukaaga, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.22",
            "verseOrgIds": [
