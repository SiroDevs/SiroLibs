          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo batware bakaba batoijera Sulemaani eby'okurya ahabwe n'ahabwa boona abaabaire bariira aha meeza ye, buri mutware okwezi kwe, hatarikugira kintu kyona ekyaburaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.27",
            "verseOrgIds": [
              "1KI.4.27"
            ]
          }
        },
