                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nabi ogwo ku yaaherize kumuziika, yaagira abatabani ati: Ku ndifa, munziikye omu kituuro ekyaziikwamu omushaija wa Ruhanga, amagufa gangye gahereere age; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.31",
            "verseOrgIds": [
              "1KI.13.31"
            ]
          }
        },
