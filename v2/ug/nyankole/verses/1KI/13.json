              "1KI.13.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.33"
              },
              "items": [
                {
                  "text": "1 Bag 12:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi reeba, haija omushaija wa Ruhanga naaruga omuri Yuda areetsirwe ekigambo kya Ruhanga omuri Beseeli. Obwo Yeroboamu akaba ayemereire aha rubaju rw'eitambiro kwotera obubaane. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.1",
            "verseOrgIds": [
              "1KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.15"
              },
              "items": [
                {
                  "text": "2 Bag 23:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo mushaija yaakyeena eitambiro n'ekigambo kya MUKAMA naagira ati: Iwe itambiro 'we, itambiro, oku nikwo MUKAMA arikugamba naagira ati: Reeba, omwana w'omwojo orikwetwa Yosia aryazaarirwa enju ya Daudi; bwanyima aryakutambiraho abanyamurwa b'emyanya mikuru y'okuramizamu, abakwotereraho obubaane, kandi akwokyezeho n'amagufa g'abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.2",
            "verseOrgIds": [
              "1KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahari eryo izooba yaayoreka akamanyiso, naagira ati: Aka niko kamanyiso aku MUKAMA yaagamba, naagira ati: Reeba, eri itambiro niriija kushatuka, n'eiju ryaho ryatikye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.3",
            "verseOrgIds": [
              "1KI.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe Yeroboamu ku yahuriire ebigambo by'gwo muntu wa Ruhanga, ebi yaakyeena eitambiro ry'omuri Beseeli, yaamworekyeza omukono ari aha itambiro naagira ati: Mumukwate. Omukono ogu yaabaire amworekyeize gwayomerayo, tiyaabaasa kugugarura. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.4",
            "verseOrgIds": [
              "1KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitambiro ryashatuka, n'eiju ryayatika, nk'akamanyiso aku omushaija wa Ruhanga yaayorekire ahabw'ekigambo kya MUKAMA oku kaabaire kari. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.5",
            "verseOrgIds": [
              "1KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.8.8"
              },
              "items": [
                {
                  "text": "Kur 8:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.9.28"
              },
              "items": [
                {
                  "text": "9:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.17"
              },
              "items": [
                {
                  "text": "10:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.7"
              },
              "items": [
                {
                  "text": "Kub 21:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.24"
              },
              "items": [
                {
                  "text": "Byak 8:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe yaagambira ogwo muntu wa Ruhanga ati: Yeshengyereze MUKAMA Ruhanga waawe hati, onshabire, omukono gwangye gukire. Atyo omushaija wa Ruhanga yaayeshengyereza MUKAMA, omukono gw'omugabe gwakira, gwaba nk'oku gushangirwe guri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.6",
            "verseOrgIds": [
              "1KI.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.15"
              },
              "items": [
                {
                  "text": "2 Bag 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe yaagira ogwo mushaija wa Ruhanga ati: Ija tugyendane omuka, oruhuukyeho, kandi niinyija kukuha ebihembo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.7",
            "verseOrgIds": [
              "1KI.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.18"
              },
              "items": [
                {
                  "text": "Kub 22:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.24.13"
              },
              "items": [
                {
                  "text": "24:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo mushaija wa Ruhanga yaamugarukamu ati: N'obu waakumpa ekicweka ky'enju yaawe, tindikwija kutaahamu naiwe. Kandi tindikwija kurya eby'okurya n'obu kwakuba okunywa amaizi omu mwanya ogu; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.8",
            "verseOrgIds": [
              "1KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba nikwo ekigambo kya MUKAMA kindagiire, nikigira kiti: Otariryayo eky'okurya, otarinywayo amaizi, n'obu kwakuba okugaruka omuhanda ogu oreetsirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.9",
            "verseOrgIds": [
              "1KI.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo yaatoora ogundi muhanda, tiyaagaruka muhanda ogumureetsire naaza Beseeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.10",
            "verseOrgIds": [
              "1KI.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.10",
            "verseOrgIds": [
              "1KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bunaku obwo hakaba hariho nabi omugurusi atwire Beseeli. Abatabani baija, baamugambira byona ebi ogwo mushaija wa Ruhanga yaakora Beseeli eryo izooba; kandi n'ebigambo ebi yaagambira omugabe, baabigambira ishebo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.11",
            "verseOrgIds": [
              "1KI.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishebo yaababuuza ati: yaatoora muhanda ki? Abatabani baamworeka omuhanda ogu ogwo mushaija wa Ruhanga orugire omuri Yuda yaatoora. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.12",
            "verseOrgIds": [
              "1KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagira abatabani ati: Nimuntandiikire endogoya. Batyo baamutandiikira endogoya, yaagitemba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.13",
            "verseOrgIds": [
              "1KI.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakurata ogwo mushaija wa Ruhanga, yaamushanga ashutami ahansi y'omwela, yaamubuuza ati: Niiwe mushaija wa Ruhanga orugire omuri Yuda? Yaamugarukamu ati: Niinye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.14",
            "verseOrgIds": [
              "1KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaamugira ati: Ija tugyendane omuka, orye ak'okurya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.15",
            "verseOrgIds": [
              "1KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onu yaamugarukamu ati: Tindikwikirizibwa kugarukayo naiwe, nari okutaaha omuka naiwe, n'obu kwakuba okurya eby'okurya nari okunywa amaizi naiwe omuri ogu mwanya; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.16",
            "verseOrgIds": [
              "1KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba nikwo ekigambo kya MUKAMA kindagiire nikigira kiti: Otariryayo eby'okurya, otarinywayo amaizi, n'obu kwakuba okugaruka omuhanda ogu oreetsirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.17",
            "verseOrgIds": [
              "1KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onu yaamugira ati: Naanye ndi nabi nkaiwe, kandi maraika otumirwe ekigambo kya MUKAMA yangira ati: Irooko omugarure omu ka yaawe, arye ak'okurya, kandi anywe otwizi. Kwonka akaba naamubeiha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.18",
            "verseOrgIds": [
              "1KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo yaagaruka nawe omuka, baarya eby'okurya omu ka ye, kandi baanywa n'amaizi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baabaire bakiri aha meeza, ekigambo kya MUKAMA kyaija ahari nabi ogwo owaamugarura; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.20",
            "verseOrgIds": [
              "1KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaagambira ogwo mushaija wa Ruhanga orugire omuri Yuda n'eiraka rihango, ati: Oku nikwo MUKAMA arikugamba naagira ati: Ahabw'okugomera ekigambo kya MUKAMA, kandi n'okutoorobera kiragiro eki MUKAMA Ruhanga waawe akuragiire, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.21",
            "verseOrgIds": [
              "1KI.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "okagaruka, okarya eby'okurya, okanywa amaizi omu mwanya ogu akuzibiire naagira ati: Otariryamu eby'okurya n'obu kwakuba okunywamu amaizi, n'ahabw'ekyo omutumbi gwawe tigurihika ha kituuro kya baashwenkuru. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.22",
            "verseOrgIds": [
              "1KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabi ogwo omugurusi, ku yaaherize kurya eby'okurya n'okunywa, yaatandiikira nabi ogwo ou yaagarura endogoya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.23",
            "verseOrgIds": [
              "1KI.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.20.36"
              },
              "items": [
                {
                  "text": "1 Bag 20:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaabaire naakigyenda, entare yaamubugana omu muhanda, yaamwita; omutumbi gwe gwagangarama omu muhanda, endogoya yaagwemerera aha rubaju, n'entaro nayo yaayemereraho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.24",
            "verseOrgIds": [
              "1KI.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi reeba, abantu abaarabireho baareeba omutumbi gugangarami omu muhanda, entare egwemereire aha rubaju; baija, baakigamba omu rurembo omu ogwo mugurusi nabi yaabaire atwire.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabi ogwo owaamugaruriire omu muhanda ku yaakihuriire, yaagira ati: N'omushaija wa Ruhanga, owaagomera ekigambo kya MUKAMA; nikyo MUKAMA yaamuriisiza entare, ekamutaagataagura, ekamwita, nk'ekigambo eki MUKAMA amugambiire oku kiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagira abatabani ati: Muntandiikire endogoya. Nabo baagitandiika. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.27",
            "verseOrgIds": [
              "1KI.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagyenda, yaashanga omutumbi gugangarami omu muhanda, endogoya n'entare bigwemereire aha rubaju, entare etaguriire n'obu kwakuba okutaagataagura endogoya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.28",
            "verseOrgIds": [
              "1KI.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabi ogwo yaihaho omutumbi gw'omushaija wa Ruhanga, yaaguta aha ndogoya, yaagugarura omu rurembo kumucurira n'okumuziika. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.29",
            "verseOrgIds": [
              "1KI.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwo mutumbi yaaguziika omu kituuro kye, baamucurira, buri omwe naagira ati: Ai bambe, mwene tata! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.30",
            "verseOrgIds": [
              "1KI.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 13:31"
          },
          "items": [
