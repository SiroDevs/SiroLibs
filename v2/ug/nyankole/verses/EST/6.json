                "loc": "EST.2.23"
              },
              "items": [
                {
                  "text": "Est 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.6.18"
              },
              "items": [
                {
                  "text": "Dan 6:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekyo kiro omugabe yaabura oturo; yaaragiira ku bamureetera ekitabo ekirikwijutsya ebyabaireho, baakimushomera. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.1",
            "verseOrgIds": [
              "EST.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.21"
              },
              "items": [
                {
                  "text": "Est 2:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baashanga kihandiikirwemu, ku Morodekai niwe yaaregire abashaija babiri b'omu bakonwa b'omugabe, abaabaire barinda omuryango gw'enju ye, Bigisaana na Tereshi, abaabaire nibenda kwita omugabe Ahasuero. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.2",
            "verseOrgIds": [
              "EST.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe yaabuuza ati: Beitu Morodekai ogwo hariho ekitiinisa nari obukuru, ebi arahairwe, nibamuzimuurira ekyo eki yaakozire? Abagaragwa b'omugabe abaabaire nibamuheereza, baagarukamu bati: Taine ki arakoreirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.3",
            "verseOrgIds": [
              "EST.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.5.14"
              },
              "items": [
                {
                  "text": "Est 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe yaababuuza ati: N'oha ori omu kibuga? Kandi Hamani akaba yaahika ati omu kibuga eky'aheeru ky'ekikaari ky'omugabe, naaza kumugambira eby'okuhanika Morodekai ahari ekyo kiti, eki yaabaire amuteekateekyeire. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.4",
            "verseOrgIds": [
              "EST.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo abagaragwa b'omugabe baamugira bati: Hamani niwe ayemereire omu kibuga, Nyakusinga. Omugabe yaagira ati: Mumurekye aije. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.5",
            "verseOrgIds": [
              "EST.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Hamani yaija; omugabe yaamugira ati: Tukorere ki omushaija ou omugabe arikusiima kuha ekitiinisa? Hamani yaagira omu mutima gwe ati: Ni muntu ki ogwo, ou omugabe arikusiima kuha ekitiinisa kukira nyowe? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.6",
            "verseOrgIds": [
              "EST.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani nikwo kugarukamu omugabe ati: Omushaija ou omugabe arikusiima kuha ekitiinisa, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.7",
            "verseOrgIds": [
              "EST.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.33"
              },
              "items": [
                {
                  "text": "1 Bag 1:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka bareete bushuuti y'omugabe, ei omugabe ajwara, bareete n'embaraasi ei omugabe atemba, eine ekirunga ky'obugabe aha mutwe; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.8",
            "verseOrgIds": [
              "EST.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.30"
              },
              "items": [
                {
                  "text": "2 Sam 15:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ebyo bijwaro n'egyo mbaraasi babikwatse omwe aha banyiginya b'omugabe abarikweshumba abandi, aije ajwekye ogwo mushaija ou omugabe arikusiima kuha ekitiinisa, amutembye embaraasi, amurabye omu kibuga kihango ky'orurembo amwebebembeire, naaranga ati: Oku nikwo omushaija weena araatwazibwe ou omugabe araasiime kuha ekitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.9",
            "verseOrgIds": [
              "EST.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho omugabe yaagira Hamani ati: Rahuka oreete ebijwaro n'embaraasi, nk'oku waagamba, otwaze otyo Morodekai Omuyudaaya, oshutama aha irembo ry'omugabe. Otagira eki waatsiga ahari ebyo byona ebi waagamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.10",
            "verseOrgIds": [
              "EST.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Hamani yaihayo bushuuti n'embaraasi, yaajweka Morodekai, yaamurabya omu kibuga kihango ky'orurembo, naaranga ati: Oku nikwo omushaija weena aritwazibwa ou omugabe arisiima kuha ekitiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.11",
            "verseOrgIds": [
              "EST.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.11",
            "verseOrgIds": [
              "EST.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Morodekai yaagaruka aha irembo ry'omugabe; kwonka Hamani yaayehuuta, yaataaha owe ayetwekyereire aha mutwe naarira. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaateekyerereza omukazi we Zereshi na banywani be boona ebyamubaho. Abahi be b'obwengye n'omukazi we Zereshi baamugira bati: Morodekai ogwo, ou waatandiak kufoobeera omu maisho ge, ku araabe ari ow'omu ihanga ry'Abayudaaya, torimubaasa, kureka noija kugwa omu maisho ge. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.5.8"
              },
              "items": [
                {
                  "text": "Est 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baabaire nibakigamba nawe, abakonwa b'omugabe baija, baatwara Hamani aha bugyenyi obu Esteeri yaabaire ateekire nibeehuuta.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.14",
            "verseOrgIds": [
              "EST.6.14"
            ]
          }
        }
      ]
    }
  ],
