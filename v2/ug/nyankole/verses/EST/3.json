              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Hamani yaagambira omugabe Ahasuero ati: Hariho eihanga eyataataine rikajanjaara omu mashaza g'omu bugabe bwawe goona; ebiragiro byaryo tibiri nk'eby'agandi mahanga, kandi tibarikworobera biragiro by'omugabe; n'ahabw'ekyo tikiine ki kirikugasira omugabe kurigumisiririza. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.8",
            "verseOrgIds": [
              "EST.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakusinga omugabe, ku oraabe nookisiima, hateebweho ekiragiro kihandiikwe, bacwekyerezibwe; nyowe niinyija kuha etalanta z'efeeza kakumi, zaakiirwe abarikureeberera omurimo gw'omugabe, bazite omu mabiikiro ge. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.7.6"
              },
              "items": [
                {
                  "text": "Est 7:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.8.1"
              },
              "items": [
                {
                  "text": "8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.8.2"
