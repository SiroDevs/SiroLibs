            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima omu mwaka gwa ikumi n'ebiri ogw'omu busingye bw'omugabe Ahasuero, omu kwezi kw'okubanza okurikwetwa Nisani, baaragurisa Puuri, nikwo kuteera enteenyu, baaguma nibakikorera omu maisho ga Hamani buri izooba, ngu babone kumanya ekiro n'okwezi nibakuratanisa ebiro n'ameezi byona okuhitsya obu enteenyu yaakwatsire ekiro kya ikumi na bishatu ky'okwezi kwa ikumi n'abiri okurikwetwa Adari. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
