                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ngu ebihandiikirwe omuri egyo baruha bishemereire kubugibwa omuri buri ishaza nk'ekiragiro, nibagambira amahanga goona kweteekatekyera eryo izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamatarisi baagyenda nibeehuta ahabw'ekiragiro ky'omugabe, kandi ekyo kiragiro kyabugibwa omu rurembo rukuru Shushani. Omugabe na Hamani baashutama kwenywera, kwonka ab'omuri orwo rurembo Shushani baashoberwa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.15",
            "verseOrgIds": [
              "EST.3.15"
            ]
          }
        }
