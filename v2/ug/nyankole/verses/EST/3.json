              "attrs": {
                "loc": "2CH.30.6"
              },
              "items": [
                {
                  "text": "2 Bus 30:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ezo baruha zaatwarwa baamatarisi omu mashaza g'omugabe goona, nizigamba kucwekyereza, okwita n'okumaraho Abayudaaya boona, abato n'abakuru, abaana n'abakazi, aha izooba rimwe, aha kiro kya ikumi na bishatu kw'okwezi kwa ikumi n'abiri okurikwetwa Adari, kandi n'okunyaga ebintu byabo; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.13",
            "verseOrgIds": [
              "EST.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 3:14"
          },
          "items": [
