            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.42"
              },
              "items": [
                {
                  "text": "Kut 41:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo omugabe yaajuura empeta ya'kamanyiso ke, yaagiha Hamani mwene Hamedasa Omuagagi, omuzigu w'Abayudaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.10",
            "verseOrgIds": [
              "EST.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe yaagira Hamani ati: Efeeza zaawe yegumire nazo, kandi eryo ihanga naarikuha, origire nk'oku orikwenda.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        }
      ]
    },
