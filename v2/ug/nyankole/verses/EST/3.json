              "items": [
                {
                  "text": "1 Bag 21:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima aha kiro kya ikumi na bishatu ky'okwezi kw'okubanza abahandiiki b'omugabe baayetwa, baahandiika ebi Hamani yaaragiira byona, baabitwekyera abategyeki b'omugabe, n'abategyeki abaabaire nibatwara amashaza g'omu bugabe bwe bwona, n'abanyiginya b'amahanga goona, omuri buri ishaza omu mihandiikire yaaryo, n'omuri buri ihanga omu rurimi rwaryo. Baabihandiika omu iziina ry'omugabe Ahasuero, baataho akamanyiso k'empeta ye. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.12",
            "verseOrgIds": [
              "EST.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
