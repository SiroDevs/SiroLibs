            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo ka twezirikye kutaaha omu buruhuukiro obwo, hatagira omuntu weena owaagwisibwa okutahurira okw'omuringo nk'ogwo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.29"
              },
              "items": [
                {
                  "text": "Yer 23:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.17"
              },
              "items": [
                {
                  "text": "Efe 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.48"
              },
              "items": [
                {
                  "text": "Yoh 12:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba ekigambo kya Ruhanga kiine amagara n'amaani, kiine obwogi bwingi okukira rurara yoona ey'amoogi abiri, nikicumita kihika ahu kitaanisiza amagara n'omwoyo, ngingo n'omushokooro, kandi kirahuka kucaaka ebi omuntu arikuteekateeka n'ebi amaririire omu mutima gwe kukora. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.12",
            "verseOrgIds": [
              "HEB.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omu maisho ge tihariho kihangirwe ekisherekirwe; kureka ebintu byona bishuurwirwe nibireebwa butunu omu maisho g'Ogwo oshoboorora ebyaitu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        }
      ]
    },
