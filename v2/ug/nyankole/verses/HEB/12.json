            "verseOrgIds": [
              "HEB.12.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.34"
              },
              "items": [
                {
                  "text": "Luk 2:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muteekateekye ahari Ogwo, owaagumisiririize okwangwa kutyo oku abasiisi baamwangire, murekye kuruha n'okugwa enshazi omu mirima yaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.3",
            "verseOrgIds": [
              "HEB.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe timukahikire ha kujwisibwa eshagama nimurwana n'ekibi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.4",
            "verseOrgIds": [
              "HEB.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.11"
              },
              "items": [
                {
                  "text": "Enf 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwebirwe ekigambo ekirikubeehanangiriza nk'abaana kiti?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.5",
            "verseOrgIds": [
              "HEB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.11",
            "verseOrgIds": [
              "HEB.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo mwimutsye emikono yaanyu enoganogokire, munanuure amaju gaanyu agazingazingirwe, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.26"
              },
              "items": [
                {
                  "text": "Enf 4:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mucwere ebigyere byanyu emihanda eshororokire, abarikucumbagira barekye kugiremerwamu, kureka bakire. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.14"
              },
              "items": [
                {
                  "text": "Zab 34:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.22"
              },
              "items": [
                {
                  "text": "2 Tim 2:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwezirikye okugira obusingye n'abantu boona, kandi n'okwezibwa; ahakuba ahatari kwezibwa tihariho orireeba Mukama. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.14",
            "verseOrgIds": [
              "HEB.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.18"
              },
              "items": [
                {
                  "text": "Bir 29:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwerinde hatagira omuntu owaagwa akaruga omu mbabazi za Ruhanga, haza omuzi ogurikushaarira ogwabameramu, gukabatuntuza emitima, n'abaingi bakasiisikara; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.15",
            "verseOrgIds": [
              "HEB.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.33"
              },
              "items": [
                {
                  "text": "Kut 25:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi hatabaho omushambani weena, nari otarikweta ha bya Ruhanga nka Esau owaagurize obuhunguzi bwe bw'omujigaijo akaihuro k'eby'okurya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
            "verseOrgIds": [
              "HEB.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.30+GEN.27.31+GEN.27.32+GEN.27.33+GEN.27.34+GEN.27.35+GEN.27.36+GEN.27.37+GEN.27.38+GEN.27.39+GEN.27.40"
              },
              "items": [
                {
                  "text": "Kut 27:30-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba nimumanya ngu, bwanyima ku yaayenzire kuragwa omugisha ogwo, akangirwa, tiyaabona buryo bw'okweteisa, n'obu araabe yaagushabire naarira.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.17",
            "verseOrgIds": [
              "HEB.12.17"
            ]
          }
        }
      ]
    },
    {
