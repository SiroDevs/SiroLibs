          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo eki ngu, Hatsigaire rimwe, nikimanyisa okwihwaho okw'ebiritengyetsibwa, nibyo byahangirwe, ngu ebyo ebitarikutengyetsibwa bibone kugumaho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
              "HEB.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo nk'oku twine obukama obutarikubaasa kutengyetsibwa, ka tusiime Ruhanga, tumuheereze nk'oku akunda, nitumuha ekitiinisa nitutiina; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.28",
            "verseOrgIds": [
              "HEB.12.28"
            ]
