                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obwo eiraka rye rikatengyetsa ensi; kwonka hati araganiise ati: Niinyija kugaruka kutengyetsa ensi rimwe, kandi ti nsi yonka kureka n'eiguru. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
