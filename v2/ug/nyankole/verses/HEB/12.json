            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.24"
              },
              "items": [
                {
                  "text": "1 Kor 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo nk'oku twine omutwe muhango gwa baakareebi abatwehinguririize, tujuure ebirikuturemeera byona n'ekibi ekitwezingiriire, twirukye okwiruka okw'empaka oku tuteereirweho n'okugumisiriza, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.1",
            "verseOrgIds": [
              "HEB.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.5"
              },
              "items": [
                {
                  "text": "Zab 34:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " amaisho tugahangire Yesu wenka, owaatandikire okwikiriza kwaitu kandi omuhikiiriza waakwo; owaayemeire omusharaba ahabw'okushemererwa okwatairweho omu maisho ge, akagaya enshoni zaagwo, kandi hati ashutami aha rubaju rwa buryo rw'ekitebe ky'obukama bwa Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.2",
            "verseOrgIds": [
              "HEB.12.2"
            ]
          }
        }
      ]
    },
    {
