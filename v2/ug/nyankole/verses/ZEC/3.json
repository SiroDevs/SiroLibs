                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.5"
              },
              "items": [
                {
                  "text": "Yer 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.11"
              },
              "items": [
                {
                  "text": "Ezk 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.12"
              },
              "items": [
                {
                  "text": "Zek 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu, iwe Yoshua omunyamurwa omukuru, hurira, iwe na bagyenzi baawe abashutama omu maisho gaawe, ahabw'okuba abo bantu n'akamanyiso. Reeba, ndyareeta omuheereza wangye Itaagi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.22"
              },
              "items": [
                {
                  "text": "Zab 118:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.16"
              },
              "items": [
                {
                  "text": "Isa 28:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.10"
              },
              "items": [
                {
                  "text": "Zek 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.6"
              },
              "items": [
                {
                  "text": "Kush 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, aha ibaare eri ntaire omu maisho ga Yoshua, eibaare rimwe eriine embaju mushaju, ndyasharuraho eihandiiko byaryo; nikwo MUKAMA ow'amahe arikugira; kandi orubanja rw'egi nsi ndyarwihaho omu izooba rimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.25"
              },
              "items": [
                {
                  "text": "1 Bag 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eryo izooba buri muntu omuriimwe aryayeta mutaahi we kushutama ahansi y'omuzaabibu gwe n'ahansi y'omutiini gwe; nikwo MUKAMA ow'amahe arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        }
