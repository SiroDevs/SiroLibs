        },
        {
          "text": " Omu kwezi kwa munaana omu mwaka gwa kabiri ogw'omu busingye bwa Dario, ekigambo kya MUKAMA kikaija ahari nabi Zekaria mwene Berekia mwijukuru wa Ido, nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
            "verseOrgIds": [
              "ZEC.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akagwerwa kubi munonga baashwenkuriimwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.31.6"
              },
              "items": [
                {
                  "text": "Isa 31:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.22"
              },
              "items": [
                {
                  "text": "Yer 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.19"
              },
              "items": [
                {
                  "text": "Mik 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.7"
              },
              "items": [
                {
                  "text": "Mal 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'ahabw'ekyo obagire oti: Oku nikwo MUKAMA ow'amahe arikugamba naagira ati: Mungarukire, naanye niinyija kubagarukira; nikwo MUKAMA ow'amahe arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.15"
              },
              "items": [
                {
                  "text": "2 Bus 36:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
