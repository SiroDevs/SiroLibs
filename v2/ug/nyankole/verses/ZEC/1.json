            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.31"
              },
              "items": [
                {
                  "text": "Ezk 36:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.6"
              },
              "items": [
                {
                  "text": "Dan 9:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Beitu ebigambo byangye n'ebiragiro byangye, ebi naaragiire abairu bangye baanabi, tibirahikire ahari baashwenkuriimwe? N'ahabw'ekyo bakeeteisa nibagira bati: Nk'oku MUKAMA ow'amahe yaamaririire kutugira, nk'emitwarize yaitu n'ebi twakozire, oku biri, nikwo atugizire.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
