            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo MUKAMA arikugirira ati: Ngarukiire Yerusaalemu, ngiiniire embabazi; enju yangye eryagyombekwamu, kandi omugoye gw'okugyeresa guryagyeresibwa omuri Yerusaalemu; nikwo MUKAMA ow'amahe arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
