          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhandiiki yaamugarukamu ati: Haza kwo, Mwegyesa, waagamba gye okugira oti, n'Omwe, kandi oti, Tihariho ondiijo kureka We wenka; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.32",
            "verseOrgIds": [
              "MRK.12.32"
            ]
          }
        },
