                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi okumukunda n'omutima gwona, n'obwengye bwona, n'amaani goona, n'okukunda mutaahi waawe nk'oku oyekunda, ebi nibikira ebitambo byona ebyokyeize kimwe n'empongano. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.33",
            "verseOrgIds": [
              "MRK.12.33"
            ]
          }
        },
        {
