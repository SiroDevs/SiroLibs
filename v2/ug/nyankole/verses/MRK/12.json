            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaashutama aharikureebana n'eibiikiro ry'ebiconco, yaareeba abantu baingi oku barikuritamu empiiha; baingi abaabaire bari abatungi baatamu nyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.41",
            "verseOrgIds": [
              "MRK.12.41"
            ]
          }
        },
        {
