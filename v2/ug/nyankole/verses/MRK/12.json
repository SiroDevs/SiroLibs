          ]
        },
        {
          "text": "kandi abanyaga enju z'abafaakazi, bakarandagatana omu kushaba, haza nibaryarya. Abo baryacwerwa orubanja rorurikukira obuhango.",
          "type": "text",
          "attrs": {
