              },
              "items": [
                {
                  "text": "Lev 19:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekya kabiri n'ekirikugira kiti: okunde mutaahi waawe nk'oku oyekunda. Tihariho kiragiro ekirikukira ebi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.31",
            "verseOrgIds": [
              "MRK.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
