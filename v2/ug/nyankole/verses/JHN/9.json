  "copyright": "PUBLIC DOMAIN",
  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JHN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaabaire naahingura, yaareeba omushaija owaazairwe ari empumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.1",
            "verseOrgIds": [
              "JHN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeegi be baamubuuza bati: Rabi, owaasiisire n'oha, n'omushaija ogu, nari n'abaamuzaire, nikyo yaazaariirwe ari empumi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.2",
            "verseOrgIds": [
              "JHN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.4"
              },
              "items": [
                {
                  "text": "Yoh 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu yaagarukamu ati: Tarahumisiibwe kushiisha kwe nari okw'abazaire be, kureka kikabaho ngu emirimo ya Ruhanga eyorekyerwe ahariwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.3",
            "verseOrgIds": [
              "JHN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tushemereire kukora emiromo y'Ogwo owantumire, bukiri nyomushana; ekiro nikiija, eki omuntu ataribaasa kukoreramu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.4",
            "verseOrgIds": [
              "JHN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.35"
              },
              "items": [
                {
                  "text": "Yoh 12:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obu nkiri omu nsi, ndi Omushana gw'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.5",
            "verseOrgIds": [
              "JHN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.23"
              },
              "items": [
                {
                  "text": "Mak 8:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaaherize kugamba atyo, yaacwera amacwante aha itaka, yaagaritobesa, yaarimusiiga omu maisho, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.6",
            "verseOrgIds": [
              "JHN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaamuragiira ati: Gyenda onaabe omu kiyanja kya Siloamu, (amakuru gaakyo ngu Otumirwe.) Yaagyenda, yaanaaba, yaagaruka naahweza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.7",
            "verseOrgIds": [
              "JHN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bataahi be n'abaabaire bamureeba ira naasheega, baagira bati: Ogu t'omushaija owaabaire atuura naasheega? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.8",
            "verseOrgIds": [
              "JHN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamwe baagira ntu, Niwe; abandi ngu, Ngaaha, kwonka nibashushana. We yaagira ati: Niinye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.9",
            "verseOrgIds": [
              "JHN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamubuuza bati: Beitu shi, amaisho gaawe gaahumuuka gata? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.10",
            "verseOrgIds": [
              "JHN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagarukamu ati: Omushaija orikwetwa Yesu yaatoba eitaka, yaarinsiiga omu maisho, yangira ati: Gyenda aha kiyanja Siloamu, onaabe; naanye naagyenda, naanaaba, naahweza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.11",
            "verseOrgIds": [
              "JHN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamubuuza bati: Mbwenu we arahi? Yaagira ati: Tindikumanya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.12",
            "verseOrgIds": [
              "JHN.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.12",
            "verseOrgIds": [
              "JHN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owaabaire ari empumi baamutwara, baamuhitsya Abafarisaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.13",
            "verseOrgIds": [
              "JHN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi eizooba eri Yesu yaatobeireho eitaka, akahumuura amaisho ge, rikaba riri erya Sabato. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.14",
            "verseOrgIds": [
              "JHN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisaayo nabo baamubuuza oku yaahumuuka. Yaabaigira ati: Yansiiga eitaka omu maisho, naanaaba, naahweza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.15",
            "verseOrgIds": [
              "JHN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.31"
              },
              "items": [
                {
                  "text": "Yoh 9:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abamwe aha Bafarisaayo baagira bati: Ti wa Ruhanga, ahakuba tarinda Sabato. Kwonka abandi baagira bati: Omuntu omusiisi naabaasa ata kukora obumanyiso bukuru nk'obu? Okuruga aho tibaikirizana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.16",
            "verseOrgIds": [
              "JHN.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagaruka baabuuza owaabaire ari empumi bati: Weeza iwe, nk'oku yaakuhumuura, noomugambaho ki? Yaagira ati: Ni nabi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.17",
            "verseOrgIds": [
              "JHN.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.17",
            "verseOrgIds": [
              "JHN.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayudaaya baayanga kwikiriza ku yaabaire ari empumi, akahumuuka, okuhitsya obu baayetsire abazaire be, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.18",
            "verseOrgIds": [
              "JHN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakababuuza nibagira bati: ogu ni mutabani waanyu, ou mugira ngu akazaarwa ari empumi? Mbwenu yaahumuuka ata? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.19",
            "verseOrgIds": [
              "JHN.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazaire be baagarukamu bati: Nitumanya ngu ogu n'omwana waitu, kandi akazaarwa ahumire; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.20",
            "verseOrgIds": [
              "JHN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka oku yaahumuuka hati, titurikukumanya, kandi n'owaamuhumuura, titurikumumanya. Naimwe mumwebuurize; ni mukuru, ayegambire. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.21",
            "verseOrgIds": [
              "JHN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazaire be eki baagambiire ebyo n'ahabw'okutiina Abayudaaya; ahabw'okuba Abayudaaya bakaba baragaine ngu omuntu weena origamba Yesu ku ari Kristo, abingwe omuri sinagogi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.22",
            "verseOrgIds": [
              "JHN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazaire be nikyo baagiriire bati, Ni mukuru; mumwebuurize. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.23",
            "verseOrgIds": [
              "JHN.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija ogwo owaabaire ari empumi, baamweta obwa kabiri, baamugira bati: Himbisa Ruhanga; itwe nitumanya ngu omushaija ogwo n'omusiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.24",
            "verseOrgIds": [
              "JHN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagarukamu ati: Ku araabe ari omusiisi, tindikumanya; eki ndikumanya ni kimwe; mbaire ndi empumi, mbwenu nimpweza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.25",
            "verseOrgIds": [
              "JHN.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamubuuza bati: Yaakugira ata? Amaisho gaawe yaagahumuuza ki? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.26",
            "verseOrgIds": [
              "JHN.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabagarukamu ati: Naaheza kubagambira, kwonka mwayanga kuhurira. Ahabw'enki nimwenda ngu nkigarukyemu? Naimwe nimwenda kuhinduka abeegi be? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.27",
            "verseOrgIds": [
              "JHN.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamujuma nibagira bati: Niiwe mwegi we, itwe turi aba Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.28",
            "verseOrgIds": [
              "JHN.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitumanya ngu Ruhanga akagamba na Musa; kwonka omushaija ogwo titurikumanya i yaarugire. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.29",
            "verseOrgIds": [
              "JHN.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija yaagarukamu naabagira ati: Ka n'eihano, imwe okutamanya i yaarugire, haza ahumwire amaisho gangye! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.30",
            "verseOrgIds": [
              "JHN.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.15"
              },
              "items": [
                {
                  "text": "Isa 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nitumanya ngu Ruhanga tahurira basiisi, kwonka omuntu weena ku amuramya, yaakora ebi akunda, ogwo Ruhanga amuhurira. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.31",
            "verseOrgIds": [
              "JHN.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga aha kuhangwa kw'ensi tikikahurirwaga ngu hariho orahumwire amaisho g'omuntu owaazairwe ari empumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.32",
            "verseOrgIds": [
              "JHN.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija ogwo ku akubaire atari wa Ruhanga, taine ki yaakubaasize kukora. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.33",
            "verseOrgIds": [
              "JHN.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamugarukamu bati: Iwe okazaarirwa omu bibi bisha; mbwenu naiwe nooyenda kutwegyesa? Baamubinga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.34",
            "verseOrgIds": [
              "JHN.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaahurira ku baamubinga; yaamusherura; ku yaamuboine, yaamubuuza ati: Noikiriza Omwana wa Ruhanga? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.35",
            "verseOrgIds": [
              "JHN.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamugarukamu ati: N'oha, Mukama wangye, nkamwikiriza? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.36",
            "verseOrgIds": [
              "JHN.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.26"
              },
              "items": [
                {
                  "text": "Yoh 4:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu yaamugira ati: Waamureeba, niwe ogu orikugamba naiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.37",
            "verseOrgIds": [
              "JHN.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamugira ati: Mukama wangye, niinyikiriza. Yaamuramya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.38",
            "verseOrgIds": [
              "JHN.9.38"
            ]
          }
        }
      ]
    },
