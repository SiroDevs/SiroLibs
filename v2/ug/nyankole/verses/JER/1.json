              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA nikwo kungira ati: Akabi karyagwa aha batuuzi b'omu nsi egi boona nikaruga aha bukiizi-bwa-bumosho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
