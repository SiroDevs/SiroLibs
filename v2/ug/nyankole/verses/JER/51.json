        {
          "text": " Ku oriheza kushoma ekitabo eki, okikomeho eibaare, okinagye omu mugyera Furaati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.63",
            "verseOrgIds": [
              "JER.51.63"
            ]
          }
