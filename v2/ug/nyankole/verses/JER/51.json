              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ogire oti: Oku nikwo Babulooni erimirwa, etagarukye kutuuhuuka bundi ahabw'akabi aku ndigireetaho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
