            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA arikugamba ahari bataahi bangye boona ababi, abarikukora aha buhunguzi obu naahaire abantu bangye Israeli kuba obwabo, naagira ati: Reeba, ndyabarandura omu nsi yaabo, n'enju ya Yuda nayo ngibaranduremu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
