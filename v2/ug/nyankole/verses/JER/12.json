              "attrs": {
                "loc": "1PE.2.5"
              },
              "items": [
                {
                  "text": "1 Pet 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi obunaku ku burihika, baayezirika kutooreza emicwe y'abantu bangye okurahira eiziina ryangye bati: Nindahira MUKAMA ohuriire, nk'oku baayegyeise abantu bangye kurahira Baali, obwo baryahamibwa omu bantu bangye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
        {
