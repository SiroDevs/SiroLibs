              },
              "items": [
                {
                  "text": "Isa 60:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka eihanga ryona ku riryanga kuhurira, ndyarirandurira kimwe, ndicwekyereze; nikwo MUKAMA arikugira.",
          "type": "text",
