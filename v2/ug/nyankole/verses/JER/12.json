                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ku ndiheza kubarandura, ndyagaruka mbagirire esaasi, mbagarure, buri muntu agarukye omu buhunguzi bwe n'omu butaka bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.15",
            "verseOrgIds": [
              "JER.12.15"
            ]
