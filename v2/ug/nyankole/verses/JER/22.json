              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku muraayangye kuta omutima ahari ebyo bigambo, niinyerahira ti: Egi nju eryahinduka omushaka; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.5",
            "verseOrgIds": [
              "JER.22.5"
            ]
          }
        },
