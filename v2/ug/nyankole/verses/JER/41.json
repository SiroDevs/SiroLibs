        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.22"
              },
              "items": [
                {
                  "text": "1 Bag 15:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekyo kiina eki Ishimaeli yaanagiremu emitumbi y'abu yaitsire boona kikaba kiri ekiina kihango ekyatimbisiibwe omugabe Asa ahabw'okutiina Baasha omugabe wa Israeli. Ishimaeli mwene Nesania yaakiijuza emitumbi y'abaitsirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.23"
              },
              "items": [
                {
                  "text": "Yer 38:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Ishimaeli yaatwara abantu abaabaire bari Mizipa na bahara b'omugabe n'abantu boona abaabaire batsigaire Mizipa, abu Nebuzaradaani omukuru w'abarinzi yaabaire akwatsize Gedalia mwene Ahikaamu. Ishimaeli mwene Nesania yaabatwara bari enkwatwa, yaimuka kwambuka kuhungira omu Baamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
