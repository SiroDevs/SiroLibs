              "items": [
                {
                  "text": "Zab 41:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu kwezi kwa mushanju Ishimaeli mwene Nesania, mwijukuru wa Elishaama, omunyiginya kandi omutegyeki mukuru omu bategyeki b'omugabe, yaija n'abantu ikumi Mizipa owa Gedalia mwene Ahikaamu. Ku baabaire nibariira hamwe eby'okurya omuri Mizipa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.28"
              },
              "items": [
                {
                  "text": "2 Sam 13:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.29"
              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ishimaeli mwene Nesania n'abo bashaija ikumi abu yaabaire aine, baimuka, baateera Gedalia mwene Ahikaamu, mwijukuru wa Shafani, rurara, baamugwisaho; kandi ogwo ou baitsire niwe omugabe wa Babulooni yaabaire ataireho kuba omutegyeki omuri egyo nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ishimaeli yaagaruka yaita Abayudaaya boona abu Gedalia yaabaire aine Mizipa, hamwe n'abaserukare b'Abakaludaaya abaabaire bariho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
