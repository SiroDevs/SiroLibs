                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baagyenda, baaguma Gerutikimuhaamu haihi na Betelehemu; obwo nibenda kuza Misri ahabw'Abakaludaaya; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
