                "loc": "ISA.15.2"
              },
              "items": [
                {
                  "text": "Isa 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " haija abantu makumi munaana nibaruga Shekemu, Shiilo na Samaria bamweire ebireju, bajwaire ebijwaro bitaagukire, beesharashazire emibiri, bareetsire empongano z'esaano n'obubaane, kubihongyera omuri hekalu ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimaeli mwene Nesania yaaruga Mizipa kuza kubabugana, yaagyenda naarira. Ku yaabaire naakibabugana, yaabagira ati: Mwije tuze owa Gedalia mwene Ahikaamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baahikire omu rurembo, Ishimaeli mwene Nesania n'abashaija abu yaabaire aine baita abo bantu, baabanaga omu kiina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.11"
              },
              "items": [
                {
                  "text": "Bar 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka hakaba hariho abantu ikumii omuribo abaagizire Ishimaeli bati: Otatwita, ahabw'okuba twine engano, sayiri, amajuta n'obwoki, bisherekire omu ishwa. Atyo yaabareka, tiyaabaita na bagyenzi baabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        }
      ]
    },
