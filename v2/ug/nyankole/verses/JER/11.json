              },
              "items": [
                {
                  "text": "Yer 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka tibaanyorobera n'obu kwakuba okutega amatu, kureka buri muntu yaakuratira obugangaazi bw'omutima gwe omubi. Nikyo naabareeteireho ebigambo byona eby'egi ndagaano, ebi naabaragiire kukora, kwonka batabikore.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        }
      ]
