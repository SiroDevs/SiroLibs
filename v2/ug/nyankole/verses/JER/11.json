              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nikyo MUKAMA ow'amahe arikugirira ati: Reeba, ndyabafubira; abatsigazi baitwe rurara, abaana baabo b'aboojo n'ab'abaishiki baitwe enjara, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
              "JER.11.22"
            ]
          }
        },
        {
