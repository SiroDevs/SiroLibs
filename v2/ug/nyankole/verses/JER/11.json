              "items": [
                {
                  "text": "Gal 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA Ruhanga wa Israeli arikugamba naagira ati: Omuntu otarikuta mutima ha bigambo by'endagaano egi, akyeenwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
