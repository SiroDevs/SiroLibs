              "items": [
                {
                  "text": "2 Bus 36:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba, obu naiha baashwenkuriimwe omu nsi ya Misri, nkabeehanangiriza munonga, naaguma nimbateisa obutoosha n'okuhitsya hati, nti: Muhurire eiraka ryangye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.7",
            "verseOrgIds": [
              "JER.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
