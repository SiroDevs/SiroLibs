                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.18"
              },
              "items": [
                {
                  "text": "Ezk 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo MUKAMA arikugirira ati: Reeba, naaza kubareetaho akabi, aku batarikubaasa kukira; n'obu barintakira, tindibahurira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.11",
            "verseOrgIds": [
              "JER.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.28"
              },
              "items": [
                {
                  "text": "Yer 2:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obwo ab'omu ndembo za Yuda n'abatwire omuri Yerusaalemu baryaza kutakira baaruhanga abu booterera obubaane; kwonka tibaribaasa kubajuna mu biro by'obusaasi bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.12",
            "verseOrgIds": [
              "JER.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.10"
              },
              "items": [
                {
                  "text": "Hos 9:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba iwe Yuda, nk'oku endembo zaawe zirikwingana, na baaruhanga baawe nikwo bari; kandi nk'oku enguuto za Yerusaalemu zirikwingana, nikwo n'amatambiro gaanyu gari, agu mwayombekyeire ekirikwitsa enshoni, nigo g'okwotereraho Baali obubaane.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.13",
            "verseOrgIds": [
              "JER.11.13"
            ]
          }
        }
      ]
