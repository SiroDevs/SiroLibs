              "items": [
                {
                  "text": "Enf 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.15"
              },
              "items": [
                {
                  "text": "Isa 1:15",
