            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagaruka yangira ati: Omu bashaija ba Yuda n'omu batuuzi ba Yerusaalemu hareebekiremu obugomi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.9",
            "verseOrgIds": [
              "JER.11.9"
            ]
