                {
                  "text": "2 Bag 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naiwe oryabagarukamu oti: Kireetsirwe baashwenkuriimwe abaanyimwire, bakakuratira baaruhanga abandi, bakabaheereza, bakabaramya, bakantsigaho, batoorobere biragiro byangye; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
        {
          "name": "verse",
