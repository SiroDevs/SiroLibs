                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi naimwe mukirize baashwenkuriimwe abo kukora kubi, ahabw'okuba buri muntu weena omuriimwe naakuratira ebibi by'omu mutima gwe gw'obugangaazi naayanga kumpurira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.12",
            "verseOrgIds": [
              "JER.16.12"
            ]
          }
        },
