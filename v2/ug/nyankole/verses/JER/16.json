                "loc": "EZK.24.16+EZK.24.17+EZK.24.18+EZK.24.19+EZK.24.20+EZK.24.21+EZK.24.22+EZK.24.23"
              },
              "items": [
                {
                  "text": "Ezk 24:16-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba oku nikwo MUKAMA arikugamba naagira ati: Otaritaaha omu nju omu barikucurira, otariza kubatongyeza, n'obu kwakuba okubaririra; ahabw'okuba obusingye bwangye n'embabazi n'esaasi mbiihire ahari abo bantu; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.20"
              },
              "items": [
                {
                  "text": "Yob 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.28"
              },
              "items": [
                {
                  "text": "Lev 19:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abakuru n'abato baryafeera omuri egi nsi hatariho mutaano; tibariziikwa, kandi tihariho oribacurira n'obu kwakuba okweshara nari okumwa enkomborora ahabwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.6",
            "verseOrgIds": [
              "JER.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.14"
              },
              "items": [
                {
                  "text": "Bir 26:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.4"
              },
              "items": [
                {
                  "text": "Hos 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tihariho baribegyera ori omu rufu omugaati kumuyaagira ahabw'okufeerwa; kandi tibariha ofeereirwe ishe nari nyina ekikopo ky'amaizi kumugwisa gye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.7",
            "verseOrgIds": [
              "JER.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi otaritaaha omu nju omu barikuriira obugyenyi kushutamanabo kurya n'okunywa; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.8",
            "verseOrgIds": [
              "JER.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.34"
              },
              "items": [
                {
                  "text": "Yer 7:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba oku nikwo MUKAMA ow'amahe Ruhanga wa Israeli arikugamba naagira ati: Reeba, ndyahunamya amaraka gw'okwesiima n'okushemererwa, erya kishwera n'erya kishwerwa omu mwanya ogu, mukiriho nimureeba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        }
      ]
