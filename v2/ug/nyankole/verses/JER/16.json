            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.33"
              },
              "items": [
                {
                  "text": "25:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baryafa baitwe endwara ezirikwita. Tihariho oribacurira nari oribaziika; emitumbi yaabo eryaba nka'amasha aha itaka. Baryahwerekyerezibwa rurara n'ejara; kandi emitumbi yaabo eryaba egabo y'amahungu g'omu mwanya n'enyamaishwa z'omu ihamba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        }
      ]
    },
    {
