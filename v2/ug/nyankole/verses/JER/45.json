                "loc": "LAM.5.5"
              },
              "items": [
                {
                  "text": "5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okagira oti: Ai bambe! ehsi ndeebire, ahabw'okuba MUKAMA ayongyeire enaku aha busaasi bwangye; okutsinda kwankabya, tiinyine buhuumure. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 45:4"
          },
          "items": [
