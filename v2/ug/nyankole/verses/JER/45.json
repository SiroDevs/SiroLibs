            "number": "2",
            "style": "v",
            "sid": "JER 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nikwo MUKAMA, Ruhanga wa Israeli, arikukugira, iwe Baruki, ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
