              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.5"
              },
              "items": [
                {
                  "text": "Isa 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu omugire oti: Oku nikwo MUKAMA arikugamba naagira ati: Reeba, eki naayombekire, ninkisheenya; kandi eki naabyaire, ninkikuura; kandi niinyija kukikora omu nsi yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.4",
            "verseOrgIds": [
              "JER.45.4"
            ]
          }
        },
