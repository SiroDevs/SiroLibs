                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naagira ati: Hariho owaakubaasa kweshereka aheekiikire, ntamureebe? Tiinyijwire eiguru n'ensi? nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.24",
            "verseOrgIds": [
              "JER.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
