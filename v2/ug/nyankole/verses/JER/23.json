          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.10.2"
              },
              "items": [
                {
                  "text": "Zek 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mpuriire ebi baanabi baagambire nibahanuura ebishuba omu iziina ryangye, nibagira bati: Ndootsire! Ndootsire! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.25",
            "verseOrgIds": [
              "JER.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu ebyo biryahitsya hi okuguma omu mitima ya baanabi abarikuhanuura ebishuba n'eby'obugobya bw'omu mitima yaabo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.26",
            "verseOrgIds": [
              "JER.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 23:27"
          },
          "items": [
            {
