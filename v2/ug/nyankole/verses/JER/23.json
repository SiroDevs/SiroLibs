            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.1+EZK.14.2+EZK.14.3+EZK.14.4+EZK.14.5+EZK.14.6+EZK.14.7+EZK.14.8+EZK.14.9+EZK.14.10+EZK.14.11"
              },
              "items": [
                {
                  "text": "Ezk 14:1-11",
