              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.7"
              },
              "items": [
                {
                  "text": "Bar 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.8.33"
              },
              "items": [
                {
                  "text": "8:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " abarikuteekateeka kwebesa abantu bangye eiziina ryangye, ahabw'ebirooto byabo ebi barikurootororerana, nk'oku baishenkurubo baayebirwe eiziina ryangye ahabwa Baali? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.27",
            "verseOrgIds": [
              "JER.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.6"
              },
              "items": [
                {
                  "text": "Kub 12:6",
