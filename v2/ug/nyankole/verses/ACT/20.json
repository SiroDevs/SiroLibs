              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba tindatiinire kubagambira naama yoona eya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.27",
            "verseOrgIds": [
              "ACT.20.27"
