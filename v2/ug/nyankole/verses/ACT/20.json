              "items": [
                {
                  "text": "1 Sam 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tindeetengire feeza y'omuntu weena, n'obu eraabe ezaabu, n'obu kyakuba eky'okujwara. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.33",
            "verseOrgIds": [
              "ACT.20.33"
            ]
          }
        },
        {
