                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimmanya ngu, ku ndiheza kubarugaho, emishega eshuugire eryabataahirira, terisaasira busyo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.29",
            "verseOrgIds": [
              "ACT.20.29"
            ]
          }
        },
