                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imwe mwena nimumanya ngu emikono yangye egi nimwo naabaire nyiha eby'okuntunga n'abu naabaire nyine. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.34",
            "verseOrgIds": [
              "ACT.20.34"
            ]
          }
