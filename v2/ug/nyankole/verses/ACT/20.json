                  "text": "1 Pet 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imwe mwerinde, kandi murinde n'obusyo bwona obu Omwoyo Orikwera yaabakwatsize kuba abareeberezi baabwo, okuriisa ekanisa ya Ruhanga ei yaayeguriire n'eshagama ye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.28",
            "verseOrgIds": [
              "ACT.20.28"
            ]
          }
        },
        {
