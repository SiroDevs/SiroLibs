                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi n'omuriimwe haryarugamu abantu, abarikugamba eby'obuhabe, niboosya abeegi ngu babakurate. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.30",
            "verseOrgIds": [
              "ACT.20.30"
            ]
          }
