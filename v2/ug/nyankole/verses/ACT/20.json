            "number": "31",
            "style": "v",
            "sid": "ACT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo mugume nimureeba, kandi mwijukye ku ntararekire kuhana muntu weena n'amarira, okumara emyaka eshatu nyomushana na nyekiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.31",
            "verseOrgIds": [
              "ACT.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi na hati mbwenu, B'eishe-emwe, nimbatsigira Ruhanga n'ekigambo ky'embabazi ze, ekirikubaasa kubombeka n'okubaha obuhunguzi hamwe na boona abeeziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.32",
            "verseOrgIds": [
              "ACT.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 20:33"
          },
          "items": [
