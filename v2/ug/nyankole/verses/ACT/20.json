            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaaherize kugamba atyo, yaatsimba amaju, yaashaba hamwe nabo boona. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
