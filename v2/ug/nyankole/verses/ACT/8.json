              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.12"
              },
              "items": [
                {
                  "text": "1 Bag 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baarugire omu maizi, Omwoyo wa Mukama yaatwara Filipo, omukonwa tiyaagaruka kumureeba; kureka yaagumizamu, yaagyenda ashemereirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.39",
            "verseOrgIds": [
              "ACT.8.39"
            ]
          }
