              "items": [
                {
                  "text": "1 Tes 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebiro ku byahingwireho, Paulo yaagira Barunaba ati: Ka tugarukyeyo hati, tutaayaayire ab'eishe-emwe ab'omu ndembo zoona, ei twagambire ekigambo kya Mukama, tureebe oku bari. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.36",
            "verseOrgIds": [
              "ACT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barunaba akaba naakunda ngu bagyende na Yohaana orikwetwa Mako; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.37",
            "verseOrgIds": [
              "ACT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.13"
              },
              "items": [
                {
                  "text": "Byak 13:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.10"
              },
              "items": [
                {
                  "text": "Kol 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka Paulo tiyaasiima kugyenda n'omuntu owaataaniire nabo Pamfulia, obu yaayanga kugyendanabo aha murimo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.38",
            "verseOrgIds": [
              "ACT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haabaho empaka nyingi, ahabw'ekyo baataana; Barunaba yaatwara Mako, baaza omu meeri, baayambuka Kupuro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo we yaatoorana Siila; ab'eishe-emwe ku baaherize kumutsigira embabazi za Mukama, yaagyenda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
            "verseOrgIds": [
              "ACT.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaraba omuri Siria na Kilikia, naagumya amakanisa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.41",
            "verseOrgIds": [
              "ACT.15.41"
            ]
          }
        }
