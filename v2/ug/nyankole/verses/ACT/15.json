            "sid": "ACT 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.1",
            "verseOrgIds": [
              "ACT.15.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.2"
              },
              "items": [
                {
                  "text": "Gal 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima haija abashaija bamwe abaarugire Buyudaaya, baayegyesa ab'eishe-emwe bati: Ku muraabe mutashazirwe nk'omugyenzo gwa Musa oku guri, timurikubaasa kujunwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.1",
            "verseOrgIds": [
              "ACT.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.1"
              },
              "items": [
                {
                  "text": "Gal 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Paulo na Barunaba baahakanisa abantu abo munonga, baahika n'aha kutongana; ab'eishe-emwe nikwo kwohereza Paulo na Barunaba n'abandi bamwe aharibo kwinamuka Yerusaalemu aha ntumwa n'abakuru, ngu babamare empaka ahari ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.2",
            "verseOrgIds": [
              "ACT.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo abo, ku baaherize kushendekyerezibwa ab'ekanisa, baaraba omuri Foiniike na Samaria, nibagambira ab'eishe-emwe eby'okuhinduka kw'Abanyamahanga, byareetera boona okushemererwa kwingi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.3",
            "verseOrgIds": [
              "ACT.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baahikire Yerusaalemu, baayakiirwa ab'ekanisa n'entumwa n'abakuru, baabateekyerereza byona ebi Ruhanga yaakozire hamwe nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.4",
            "verseOrgIds": [
              "ACT.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka haayemerera bamwe ab'omu kigombe ky'Abafarisaayo abaikiriize, baagira bati: Ekirikwetengwa n'okubashara, kandi n'okubaragiira okuhitsya Ebiragiro bya Musa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.5",
            "verseOrgIds": [
              "ACT.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.5",
            "verseOrgIds": [
              "ACT.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entumwa n'abakuru baateerana hamwe kuteekateeka aha kigambo ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.6",
            "verseOrgIds": [
              "ACT.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.44"
              },
              "items": [
                {
                  "text": "Byak 10:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baaherize omwanya muhango nibahanuura, Petero yaayemerera, yaabagira ati: B'eishe-emwe, nimumanya ngu omu biro byahweire Ruhanga akantoorana omuriimwe kuba niinye naagambira Abanyamahanga ekigambo ky'engiri, ngu bakihurire, baikirize. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.7",
            "verseOrgIds": [
              "ACT.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ruhanga orikumanya emitima yaabahamya, naabaha Omwoyo Orikwera nk'oku yaamutuhaire; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.8",
            "verseOrgIds": [
              "ACT.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiyaatutaansia nabo, yaashemeze emitima yaabo ahabw'okwikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.9",
            "verseOrgIds": [
              "ACT.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.1"
              },
              "items": [
                {
                  "text": "Gal 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu nimugyereza ki Ruhanga okwekoreza abeegi emitwaro ei baatatenkuriitwe batarabaasize kwekorera, n'obu baakuba itwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.10",
            "verseOrgIds": [
              "ACT.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.4+EPH.2.5+EPH.2.6+EPH.2.7+EPH.2.8+EPH.2.9+EPH.2.10"
              },
              "items": [
                {
                  "text": "Efe 2:4-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka itwe nitwikiriza ngu turyajunwa ahabw'embabazi za Mukama waitu Yesu, nk'abo oku barikunwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.11",
            "verseOrgIds": [
              "ACT.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.11",
            "verseOrgIds": [
              "ACT.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boona baamucureera, baahurira Barunaba na Paulo nibabateekyerereza obumanyiso n'eby'okutangaaza ebi Ruhanga yaabakoreise omu Banyamahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.12",
            "verseOrgIds": [
              "ACT.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.18"
              },
              "items": [
                {
                  "text": "Byak 21:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baaherize kugamba, Yakobo yaagira ati: B'eishe-emwe, mumpurire! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.13",
            "verseOrgIds": [
              "ACT.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simooni yaaheza kubateekyerereza oku Ruhanga yaatandikire kutaayaayira Abanyamahanga okutoorana abantu omuribo kuba eihanga eririkwetererwa eiziina rye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.14",
            "verseOrgIds": [
              "ACT.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ebigambo bya baanabi nibiikirizana nabyo, nk'oku kyahandiikirwe ngu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.15",
            "verseOrgIds": [
              "ACT.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.21",
            "verseOrgIds": [
              "ACT.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima entumwa n'abakuru hamwe n'ekanisa yoona baasiima kutoorana omuribo abashaija ab'okutuma na Paulo na Barunaba omuri Antiokia. Baatuma Yuda orikwetwa Barusaba na Siila, abantu bakuru omu b'eishe-emwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.22",
            "verseOrgIds": [
              "ACT.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "baahandiika ebaruha, baagibaha, ehandiikirwe eti: Itwe entumwa n'ab'eishe-emwe abakuru nitubahandiikira imwe ab'eishe-emwe ab'omu Banyamahanga abari Antiokia na Siria na Kilikia, nitubaramutysa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukahurirangu bamwe abaarugire omuriitwe bakabagambira ebigambo by'okubeemereza emitima n'okubabanganisisa, haza tutarabaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.24",
            "verseOrgIds": [
              "ACT.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo ku twateeraine, twasiimira hamwe kutoorana abashaija n'okubabatumaho hamwe na Barunaba na Paulo, abu turikukunda, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.25",
            "verseOrgIds": [
              "ACT.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "abashaija abaayogire amagara gaabo ahabw'eiziina rya Mukama waitu Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.26",
            "verseOrgIds": [
              "ACT.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu abu twatuma ni Yuda na Siila, nibo baraabashobororere ebigambo ebyo n'akanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.27",
            "verseOrgIds": [
              "ACT.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.4"
              },
              "items": [
                {
                  "text": "Mat 23:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumanye ngu Omwoyo Orikwera naitwe twasiima kutabakorera gundi mutwaro oguremeire kureka okwikiriza ebi ebibashemereire, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.28",
            "verseOrgIds": [
              "ACT.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "okureka kurya ebihongyeirwe ebishushani, n'eshagama, n'ebinigirwe, n'obushambani; ku muraayerinde ebyo, muryaguma muri gye. Mugumeho.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baaherize kuragwa, baashuuma, baaza Antiokia. Ku baahikireyo, baateerana ab'omutwe boona, baabaha ebaruha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.30",
            "verseOrgIds": [
              "ACT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baagishomire, baashemererwa ahabw'okuhuumurizibwa okwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.31",
            "verseOrgIds": [
              "ACT.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yuda na Siila, ahabw'okuba nabo bakaba bari baanabi, baayehanangiriza ab'eishe-emwe n'ebigambo bingi, baabagumya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.32",
            "verseOrgIds": [
              "ACT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baamazireyo ebiro ebitari bikye, baaragwa n'obusingye ab'eishe-emwe kugaruka ahari abo abaabatumire. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.33",
            "verseOrgIds": [
              "ACT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Siila we yaasiima kutsigarayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.34",
            "verseOrgIds": [
              "ACT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Paulo na Barunaba nabo baajuma Antiokia, nibeegyesa, nibabuurira ekigambo kya Ruhanga hamwe n'abandi baingi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
          }
        }
      ]
