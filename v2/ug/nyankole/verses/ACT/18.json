  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "ACT 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima y'ebyo yaaruga Aseene yaaza Korinso. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.1",
            "verseOrgIds": [
              "ACT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.3"
              },
              "items": [
                {
                  "text": "Rom 16:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaashangayo Omuyudaaya orikwetwa Akula, enzarwa ya Pontio, nibwo yaabaire arugire Italia n'omukazi we Priskila, ahabw'okuba Kulaudio akaba aragiire Abayudaaya boona kuruga Rooma. Paulo yaaza owaabo kubareeba; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.2",
            "verseOrgIds": [
              "ACT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.34"
              },
              "items": [
                {
                  "text": "Byak 20:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.12"
              },
              "items": [
                {
                  "text": "1 Kor 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi, ahabw'okushangwa ari ow'omwoga gumwe n'ogwabo, yaaguma nabo, nibakora hamwe; ahakuba omwoga gwabo gukaba guri okubaziira amahema. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.3",
            "verseOrgIds": [
              "ACT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buri Sabato yaaguma naahakanisa Abayudaaya n'Abagriika omuri sinagogi, naabaikiririsa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.4",
            "verseOrgIds": [
              "ACT.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siila na Timoseo ku baarugire Makedonisa, Paulo yaagyemwa ekigambo kya Ruhanga, naahamiza Abayudaaya ku Yesu ari Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.5",
            "verseOrgIds": [
              "ACT.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.46"
              },
              "items": [
                {
                  "text": "Byak 13:46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baamuhakaniise munonga, baarogota, yaakunkumura ebijwaro bye, yaabagira ati: Eshagama yaanyu ebe niimwe yaatukururira; nyowe ndi mwere; okuruga hati niinyija kuza omu Banyamahanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.6",
            "verseOrgIds": [
              "ACT.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.6",
            "verseOrgIds": [
              "ACT.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaarugayo, yaataaha omu nju y'omuntu orikwetwa Tito Yusto, owaabaire aramya Ruhanga, enju ye ekaba eri haihi na sinagogi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.7",
            "verseOrgIds": [
              "ACT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.14"
              },
              "items": [
                {
                  "text": "1 Kor 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Krispo omukuru wa sinagogi yaikiriza Mukama n'eka ye yoona; n'aba Korisno baingi, ku baahuriire, baikiriza, baabatizibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.8",
            "verseOrgIds": [
              "ACT.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama waitu yaagambira Paulo nyekiro omu kworekwa ati: Otatiina, ogume ogambe, orekye kuhunama; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.9",
            "verseOrgIds": [
              "ACT.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.10"
              },
              "items": [
                {
                  "text": "Isa 41:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.4.11"
              },
              "items": [
                {
                  "text": "Yon 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba ndi hamwe naiwe, kandi tihariho muntu oraakutaahirire kukukora kubi; ahakuba nyine abantu baingi omu rurembo oru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.10",
            "verseOrgIds": [
              "ACT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaamarayo omwaka n'ameezi mukaaga, naabeegyesamu ekigambo kya Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.11",
            "verseOrgIds": [
              "ACT.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.11",
            "verseOrgIds": [
              "ACT.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galio ku yaabaire ari omutegyeki wa Akaya, Abayudaaya baimukirira Paulo n'omutima gumwe, baamutwara omu maisho g'ekitebe ky'eiramuriro; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.12",
            "verseOrgIds": [
              "ACT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibagira bati: Omushaija ogu naikiririsa abantu kuramya Ruhanga omu buryo oburikuhakanisa Ebiragiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.13",
            "verseOrgIds": [
              "ACT.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.25.18+ACT.25.19+ACT.25.20"
              },
              "items": [
                {
                  "text": "Byak 25:18-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Paulo ku yaabaire naayenda kwashamya akanwa ke kwetonganira, Galio yaagambira Abayudaaya ati: Imwe Bayudaaya 'mwe, kuri ruri orubanja rw'ekibi nari shi ekihagaro, nkaagizire oburyo bw'okubagumisiririza, mbahurira; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.14",
            "verseOrgIds": [
              "ACT.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.18.31"
              },
              "items": [
                {
                  "text": "Yoh 18:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka obu ziri empaka z'ebigambo n'amazima n'ebiragiro byanyu mwenka, mubyemarire; tindikwenda kucwa orubanja rw'ebigambo nk'ebyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.15",
            "verseOrgIds": [
              "ACT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaababinga omu maisho g'ekitebe ky'eiramuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.16",
            "verseOrgIds": [
              "ACT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.1"
              },
              "items": [
                {
                  "text": "1 Kor 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Boona baakwata Soseene, omukuru wa sinagogi, baamuteerera omu maisho g'ekyo kitebe. Kwonak ebyo byona Galio tiyaabyetaho.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.17",
            "verseOrgIds": [
              "ACT.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.17",
            "verseOrgIds": [
              "ACT.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.18",
            "verseOrgIds": [
              "ACT.18.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.18"
              },
              "items": [
                {
                  "text": "Kub 6:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'ebyo Paulo yaamarayo ebindi biro bingi; ku byahweire, yaaraga ab'eishe-emwe, yaaza omu meeri na Priskila na Akula, baayambuka Siria; ku yaahikire Kenkereya, yaamweisa eishokye, ahakuba nikwo yaabaire arahiire. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.18",
            "verseOrgIds": [
              "ACT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baahikire Efeso, yaabatsigayo; yaataaha omuri sinagogi wenka, yaahakansia Abayudaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.19",
            "verseOrgIds": [
              "ACT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baamushabire kuguma nabo ebiro ebindi, tiyaabaikiriza; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.20",
            "verseOrgIds": [
              "ACT.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.15"
              },
              "items": [
                {
                  "text": "Yak 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka yaabaraga naagira ati: Ruhanga ku arikunda, ndyagaruka. Atyo yaaza omu meeri, yaaruga Efeso. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.21",
            "verseOrgIds": [
              "ACT.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaayambukire Kaisarea, yainamuka, yaaramutsya ekanisa; bwanyima yaaza Antiokia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.22",
            "verseOrgIds": [
              "ACT.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaamazireyo ebiro, yaarugayo, yaaraba omu mashaza ga Galatia na Furugia, naareeba emyanya yaamwo nk'oku yaabaire ekurataine, naagumya abeegi boona.",
          "type": "text",
