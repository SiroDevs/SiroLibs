    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eby'embu z'abakumiirizi b'amarembo; ab'omu ba Koora, Meshelemia mwene Koore, ow'omuri beene Asafu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.1",
            "verseOrgIds": [
              "1CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.21"
              },
              "items": [
                {
                  "text": "1 Bus 9:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Meshelemia ogwo akaba aine abaana b'aboojo; ow'omujigaijo zekaria, owa kabiri Yedyaeli, owa kashatu Zebadia, owa kana Yatinyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.2",
            "verseOrgIds": [
              "1CH.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa kataano Elamu, owa mukaaga Yehohanani, owa mushanju Elyeho-enai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.3",
            "verseOrgIds": [
              "1CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.18"
              },
              "items": [
                {
                  "text": "1 Bus 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.38"
              },
              "items": [
                {
                  "text": "16:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obededomu nawe akaba aine abatabani: ow'omujigaijo Shemaaya, owa kabiri Yehozabadi, owa kashatu Yoa, owa kana Skari, owa kataano Netaneeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.6.11"
              },
              "items": [
                {
                  "text": "1 Sam 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " owa mukaaga Amieli, owa mushanju Isakaari, owa munaana Peulesa; ahakuba Ruhanga akamuha omugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.5",
            "verseOrgIds": [
              "1CH.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omutabani Shemaaya akazaara abaana b'aboojo, abaabaire bari abategyeki omu maju ga baishenkurubo; ahabw'okuba bakaba bari abashaija b'amaani amamanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.6",
            "verseOrgIds": [
              "1CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beene Shemaaya: otuni, Refaeli, Ebedi, Elizabaadi na beene ishe abaabaire bari amamanzi, Elihu na Semakia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.7",
            "verseOrgIds": [
              "1CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boona bakaba bari beene Obededomu hamwe na batabani baabo na beene ishebo, abashaija b'amaani abaabaire nibabaasa ogwo murimo; aba Obededomu boona bakaba bari makumi mukaaga na babiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.8",
            "verseOrgIds": [
              "1CH.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Meshelemia akaba aine abatabani na beene ishe, aqbashaija amamanzi ikumi na munaana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.9",
            "verseOrgIds": [
              "1CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.38"
              },
              "items": [
                {
                  "text": "1 Bus 16:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na Hoosa ow'omuri beene Merari akaba aine abatabani: omukuru ari Shimuri, (ahakuba n'obu araabe yaabaire atari w'omujigaijo, ishe akamuhindura mukuru), ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.10",
            "verseOrgIds": [
              "1CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa kabiri Hilukia, owa kashatu Tebalia, n'owa kana Zekaria; batabani ba Hoosa na beene ishe boona bakaba bari ikumi na bashatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakumiirizi b'amarembo omuri ezo mbu, nk'abakuru baabo oku baabaire bari, bakaba baine emirimo ei bakwatsiibwe, nka beene waabo abaabaire nibaheereza omu nju ya MUKAMA oku baabaire bagiine; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.12",
            "verseOrgIds": [
              "1CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.25.8"
              },
              "items": [
                {
                  "text": "1 Bus 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi baateerera amaju ga baishenkurubo enteenyu, amakye n'amahango, kumanya ab'okurinda amarembo gaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.13",
            "verseOrgIds": [
              "1CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enteenyu yaakwata Shelemia kurinda eirembo ry'oburugwa-izooba. Bwanyima baateerera omutabani Zekaria enteenyu, omuhanuuzi w'obwengye; yaakwatwa ey'okurinda ery'aha bukiizi-bwa-bumosho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.14",
            "verseOrgIds": [
              "1CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obededomu yaakwata ey'okurinda ery'aha bukiizi-bwa-buryo; kandi abatabani baakwatsibwa eibiikiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.15",
            "verseOrgIds": [
              "1CH.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.5"
              },
              "items": [
                {
                  "text": "1 Bag 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Shupimu na Hoosa baakwatwa ey'okurinda eirembo ry'oburengyerwa-izooba, n'eirembo rya Shalekesi aha muhanda ogurikwinamuka, ahu abakumiirizi barikureebanira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.16",
            "verseOrgIds": [
              "1CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha burugwa-izooba haazaho mukaaga buri izooba, aha bukiizi-bwa-bumosho bana buri izooba; aha bukiizi-bwa-buryo bana, kandi n'aha ibiikiro babiri-babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.17",
            "verseOrgIds": [
              "1CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahari Paribaari oburengyerwa-izooba bana ahari ogwo muhanda, na babiri ahari Paribaari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.18",
            "verseOrgIds": [
              "1CH.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezo nizo mbu z'abakumiirizi b'amarembo b'omuri beene Koore, na beene Merari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.19",
            "verseOrgIds": [
              "1CH.26.19"
            ]
          }
        }
      ]
    },
