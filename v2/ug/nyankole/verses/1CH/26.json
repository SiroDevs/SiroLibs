              "items": [
                {
                  "text": "Neh 10:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ab'omu Baleevi, Ahiya niwe yaabaire akwatsiibwe amabiikiro g'enju ya Ruhanga n'amabiikiro g'ebintu ebyeziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.20",
            "verseOrgIds": [
              "1CH.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beene Ladani, beene Gereshon ab'omu ba Ladani, abakuru b'amaju ga baishenkurubo ba Ladani owa Gereshoni: Yahieli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.21",
            "verseOrgIds": [
              "1CH.26.21"
            ]
          }
        }
      ]
    },
