              "attrs": {
                "loc": "1CH.29.8"
              },
              "items": [
                {
                  "text": "29:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Beene Yehieli, Zetami na Yoeli omurumuna nibo baabaire bakwatsiibwe amabiikiro g'enju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.22",
            "verseOrgIds": [
              "1CH.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.12"
              },
              "items": [
                {
                  "text": "1 Bus 23:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu ba Amuraamu, Abaizuhaari, Abaheburooni n'Abauzieli- ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.23",
            "verseOrgIds": [
              "1CH.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.16"
              },
              "items": [
                {
                  "text": "1 Bus 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " na Shebueli mwene Gereshoni, mwijukuru wa Musa, niwe yaabaire akwatsiibwe amabiikiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.24",
            "verseOrgIds": [
              "1CH.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.17"
              },
              "items": [
                {
                  "text": "1 Bus 23:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.24.21"
              },
              "items": [
                {
                  "text": "24:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Beene ishe Eliezeeri akakomookwaho Rehabia omutabani, mwene Rehebia Yeshaaya, mwene Yeshaaya Yoramu, mwene Yoramu Zikuri, mwene Zikuri Shelomoosi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.25",
            "verseOrgIds": [
              "1CH.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.11"
              },
              "items": [
                {
                  "text": "2 Sam 8:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Shelemoosi ogwo na beene ishe nibo baabaire bakwatsiibwe amabiikiro goona ag'ebintu ebyeziibwe, ebi Daudi omugabe n'abakuru b'amaju ga baishenkurubo n'abakuru b'engabo rukumi-rukumi n'aba igana-igana n'abakuru b'amahe, baayerize. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.26",
            "verseOrgIds": [
              "1CH.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bintu ebi baanyagire omu ngamba bakashorooramu ebintu by'okuhunduuza enju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.27",
            "verseOrgIds": [
              "1CH.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ebi Samueli omuhanuuzi na Saulo mwene Kiishi, na Abuneeri mwene Neeri, na Yoabu mwene Zeruiya baayerize byona, ebi omuntu weena yaabaire ahongyeire MUKAMA byona bikaba birindwa Shelomoosi na beene ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.28",
            "verseOrgIds": [
              "1CH.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.4"
              },
              "items": [
                {
                  "text": "1 Bus 23:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.11.16"
              },
              "items": [
                {
                  "text": "Neh 11:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri beene Izuhaari, Kanania n'abatabani nibo baabaire bakwatsiibwe omurimo gw'aheeru ahabw'Abaisraeli, bari abatware n'abaramuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.27.17"
              },
              "items": [
                {
                  "text": "1 Bus 27:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri beene Heburooni, Hashabia ana beene ishe, abashaija amamanzi rukumi na magana mushanju, nibo baabaire nibareeberera Israeli oburengyerwa-izooba bwa Yorudani ahabw'omurimo gwa MUKAMA gwona, n'ahabw'omurimo gw'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.24.23"
              },
              "items": [
                {
                  "text": "1 Bus 24:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu ba Heburooni abo Yeriya niwe yaabaire ari omukuru waabo, nk'okukuratana kw'oruzaaro rw'abakuru b'amaju ga baishenkurubo oku kwabaire kuri. (Omu mwaka gwa makumi ana ogw'omu busingye bwa Daudi bakasherura, baashanga omuri abo ba Heburooni abashaija b'amaani amamanzi, bari Yazeri omuri Gileadi.) ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.31",
            "verseOrgIds": [
              "1CH.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.8"
              },
              "items": [
                {
                  "text": "1 Bus 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.19.11"
              },
              "items": [
                {
                  "text": "2 Bus 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe Daudi yaataho Yeriya ogwo na beene ishe, abashaija amamanzi enkumi ibiri na magana mushanju, abakuru b'amaju ga baishenkurubo, kuba ab'okureeberera Abareubeeni, Abagaadi n'ekicweka ky'oruganda rwa Manaase, ahabw'ebintu bya Ruhanga byona, kandi n'eby'omugabe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.32",
            "verseOrgIds": [
              "1CH.26.32"
            ]
          }
        }
