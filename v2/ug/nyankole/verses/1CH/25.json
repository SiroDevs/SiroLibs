          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya makumi abiri, Eliasa n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.27",
            "verseOrgIds": [
              "1CH.25.27"
            ]
          }
        },
