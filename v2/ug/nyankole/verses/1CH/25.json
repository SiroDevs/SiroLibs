          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ikumi na mwenda, Maloosi n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.26",
            "verseOrgIds": [
              "1CH.25.26"
            ]
          }
        },
