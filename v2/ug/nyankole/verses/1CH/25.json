          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya makumi abiri n'emwe, Hosiri n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.28",
            "verseOrgIds": [
              "1CH.25.28"
            ]
          }
        },
