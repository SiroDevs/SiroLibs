          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ey makumi abiri na ibiri, Gidaliti n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.29",
            "verseOrgIds": [
              "1CH.25.29"
            ]
          }
        },
