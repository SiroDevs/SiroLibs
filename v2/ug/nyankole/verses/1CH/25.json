                "loc": "1CH.16.41"
              },
              "items": [
                {
                  "text": "16:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi n'abakuru b'omurimo gw'obuheereza omuri hekalu baashoroora bamwe omuri beene Asafu n'aba Hemani n'aba Yedusuuni ahabw'omurimo, ngu babe ab'okuragura n'enanga n'endingiri n'ebitaasa. Amaziina g'abaabaire nibakora ogwo murimo omu mbu zaabo nigo aga: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuri beene Asafu, Zakuri, Yosefu, Netania, na Ashareela, beene Asafu, abaabaire nibeebemberwa Asafu, naaragura nk'ekiragiro ky'omugabe oku kyabaire kiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba Yedusuuni, beene Yedusuuni: Gedalia, Zeeri, Yeshaaya, Shiemei, Hashabia na Matisia, boona mukaaga nibeebemberwa ishebo Yedusuuni, owaabaire naaragura n'endingiri, naasiima MUKAMA kandi naamuhimbisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba Hemani, beene Hemani: Bukia, Matania, Uzieli, Shebueli, na Yerimoosi, Hanania, Hanani, Eliata, Gidaliti, na Romamutiezeeri, Yoshibekasha, Maloosi, Hosiri na Mahaziosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.11"
              },
              "items": [
                {
                  "text": "2 Sam 24:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo boona bakaba bari beene Hemani omuhanuuzi w'omugabe, owaabaire naaanuura ebigambo bya Ruhanga eby'okumuha ekitiinisa; kandi Ruhanga yaaha Hemani abaana b'aboojo ikumi na bana, n'ab'abaishiki bashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.16"
              },
              "items": [
                {
                  "text": "1 Bus 15:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.27"
              },
              "items": [
                {
                  "text": "Neh 12:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo boona bakaba beebemberwa ishebo, nibeeshongorera omu nju ya MUKAMA n'ebitaasa n'enanga n'endingiri, nibakora omurimo gw'obuheereza omu nju ya Ruhanga. Kandi Asafu na Yedusuuni na Hemani bakaba baragiirwa omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubaro gwabo hamwe na beene waabo abaabaire beegyesiibwe okweshongorera MUKAMA, boona abaabaire nibakumanya gye, bakaba bari magana abiri na makumi munaana na munaana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.13"
              },
              "items": [
                {
                  "text": "1 Bus 26:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima baateerera emirimo yaabo enteenyu, abakuru n'abato, abeegyesa n'abeegi boona hamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enteenyu y'okubanza yaakwata Yosefu ahabwa Asafu; eya kabiri, Gedalia na beene ishe n'abatabani, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya kashatu, Zakuri n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.10",
            "verseOrgIds": [
              "1CH.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya kana, Izuri, n'abatabani ba beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.11",
            "verseOrgIds": [
              "1CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya kataano, Netania n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.12",
            "verseOrgIds": [
              "1CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya mukaaga, Bukia n'abatabani ba beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.13",
            "verseOrgIds": [
              "1CH.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya mushanju, Yeshareela, n'abatabani na beene ishe, boona ikumi na babiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.14",
            "verseOrgIds": [
              "1CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya munaana, Yeshaaya n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.15",
            "verseOrgIds": [
              "1CH.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya mwenda, Matania n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.16",
            "verseOrgIds": [
              "1CH.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ikumi Shimei n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.17",
            "verseOrgIds": [
              "1CH.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ikumi n'emwe, Azareeli n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.18",
            "verseOrgIds": [
              "1CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ikumi na ibiri, Hashabia, n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.19",
            "verseOrgIds": [
              "1CH.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ikumi na ishatu, Shubaeli n'abatabani ba beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.20",
            "verseOrgIds": [
              "1CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ikumi na ina, Matisia, n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.21",
            "verseOrgIds": [
              "1CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
