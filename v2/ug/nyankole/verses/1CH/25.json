          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ikumi na itaano Yeremoosi, n'abatabani na beene ishe, boona ikumi na babiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.22",
            "verseOrgIds": [
              "1CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ikumi na mukaaga, Hanania, n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.23",
            "verseOrgIds": [
              "1CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ikumi na mushanju Yeshebekasha, n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.24",
            "verseOrgIds": [
              "1CH.25.24"
            ]
          }
        },
