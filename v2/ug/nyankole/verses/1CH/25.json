          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ikumi na munaana, Hanani n'abatabani na beene ishe, boona ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.25",
            "verseOrgIds": [
              "1CH.25.25"
            ]
          }
        },
