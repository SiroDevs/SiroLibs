          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ahabwa Ruhanga kuhwera Abaleevi ababaire baheekire eshanduukye y'endagaano ya MUKAMA, baatamba enimi mushanju n'empaya z'entaama mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo Daudi akaba ajwaire ekanzu ya kitaani, kandi n'Abaleevi abaabaire baheekire eshanduukye, n'abeeshongozi, na Kenania omwebembezi waabo, nabo bakaba bajwaire batyo; kwonka Daudi we ajwariireho n'efodi ya kitaani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo Abaisraeli boona bainamwire eshanduukye y'endagaano ya MUKAMA nibateera akaari n'enzamba n'amakondere n'ebitaasa, nibateera munonga endingiri n'enanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        }
