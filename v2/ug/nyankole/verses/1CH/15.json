              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Daudi yaateeranira Abaisraeli boona Yerusaalemu, ngu baze kwinamura eshanduukye ya MUKAMA, bagite omu mwanya gwayo ogu agibonereize. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        },
