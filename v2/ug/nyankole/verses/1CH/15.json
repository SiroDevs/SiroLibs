          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Kenania, omwebembezi w'Abaleevi omu by'okweshongora, niwe yaabaire ari omwebembezi, ahabw'okuba akaba naabimanya munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
