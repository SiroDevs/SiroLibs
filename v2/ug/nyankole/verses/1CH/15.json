          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.16+1CH.6.17+1CH.6.18+1CH.6.19+1CH.6.20+1CH.6.21+1CH.6.22+1CH.6.23+1CH.6.24+1CH.6.25+1CH.6.26+1CH.6.27+1CH.6.28+1CH.6.29+1CH.6.30"
