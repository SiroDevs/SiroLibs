            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:20",
              "type": "text"
            },
            {
              "text": "Alamoosi amakuru oburaka bukye.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alamoosi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
