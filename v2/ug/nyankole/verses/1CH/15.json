          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi hamwe n'abo baatoorana omuri beene waabo abarikukurataho, Zekaria, Yazieli, Shemiramoosi, Yehieli, Uuni, Eliabu, Benaaya, Maaseya, Matisiya, Elefelebu, Mikuneya n'abarinzi b'eirembo Obededomu na Yeyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
