          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekaria, Azieli, Shemiramoosi, Yehieli, Uuni, Eliabu, Maaseya na Benaaya bakaba baari ab'okuteera enanga omu iraka rya ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
