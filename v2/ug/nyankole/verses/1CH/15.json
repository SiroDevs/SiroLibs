          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuri beene Uzieli, omukuru Abinadabu na beene ishe igana na ikumi na babiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
