              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Daudi n'abakuru ba Israeli, n'abakuru b'engabo rukumi-rukumi, baaza kwinamura eshanduukye y'endagaano ya MUKAMA, kugiiha owa Obededomu n'okushemererwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
