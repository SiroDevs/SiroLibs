          },
          "items": [
            {
              "text": "15:21",
              "type": "text"
            },
            {
              "text": "Sheminiisi amakuru amaraka mahango.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheminiisi. ",
          "type": "text",
          "attrs": {
