          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeshongozi aba, Hemani, Asafu na Esaani, bakaba bari ab'okuteera ebitaasa by'emiringa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
