          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matisiya, Elefelebu, Mikuneya, Obededomu, Yeyeli na Azazia bakaba bari ab'okuteera enanga omu iraka rya ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
