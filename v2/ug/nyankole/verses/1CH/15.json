                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaagira ati: Tihariho n'omwe oshemereire kuheeka eshanduukye ya Ruhanga kureka Abaleevi, ahabw'okuba nibo MUKAMA yaatooraine kuguma nibaheeka eshanduukye ya MUKAMA, n'okumuheereza ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.2",
            "verseOrgIds": [
              "1CH.15.2"
            ]
          }
        },
