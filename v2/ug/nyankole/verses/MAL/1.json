                {
                  "text": "65:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga oburugwa-izooba okuhika oburengyerwa-izooba eiziina ryangye ni rikuru omu mahanga, kandi omuri buri mwanya gwona eiziina ryangye niryotererwa obubaane, kandi nirihongyerwa empongano ezishemeire; ahabw'okuba eiziina ryangye ni rikuru omu mahanga; nikwo MUKAMA ow'amahe arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.11",
            "verseOrgIds": [
              "MAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka imwe nimurihemura, obu murikuba nimugira muti: Emeeza ya MUKAMA esiisikaire, n'eby'okurya ebigiriho n'eby'okugaywa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.12",
            "verseOrgIds": [
              "MAL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 1:13"
          },
          "items": [
