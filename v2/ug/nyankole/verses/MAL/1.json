              "items": [
                {
                  "text": "Luk 6:46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imwe banyamurwa 'mwe abarikugaya eiziina ryangye, omwana aha ishe ekitiinisa, n'omuheereza akiha mukama we. Mbwenu ku ndaabe ndi shoimwe, ekitiinisa kyangye kirahi? Nari shi ku ndaabe ndi mukama waanyu, okutiinwa kwangye kurahi? nikwo MUKAMA arikugira. Kandi imwe nimugira muti: Beitu eiziina ryawe niturigaya tuta? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimurigayira omu kuhongyera empongano z'eby'okurya bisiisikaire aha itambiro ryangye. Kandi nimugira muti: Nitubishiisha tuta? Ahabw'okuba nimugira muti: Emeeza ya MUKAMA n'ey'okugaywa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.22.22"
              },
              "items": [
                {
                  "text": "Lev 22:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obu muba nimutamba ebitambo by'enyamaishwa ezihumire, mugira ngu ekyo ti kibi? Obu muba nimuhonga ezi remaire, nari ezirwaire, ekyo kyo ti kibi? Irooko obihongyere omutegyeki waawe. Noogira ngu naija kukusiima? Naija kukureeba gye? nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Bir 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu, mweshengyereze Ruhanga abaikirize, abone kutugirira embabazi. Ku muraabe nimumuhongyera ebirikushusha bityo, naabaasa ata kubaikiriza? nikwo MUKAMA ow'amahe arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.9",
            "verseOrgIds": [
              "MAL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 1:10"
          },
          "items": [
