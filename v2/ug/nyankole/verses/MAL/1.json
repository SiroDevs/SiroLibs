        },
        {
          "text": "Eki n'ekigambo kya MUKAMA ekyahanuuriirwe Israeli nikiraba omuri Malaki.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
