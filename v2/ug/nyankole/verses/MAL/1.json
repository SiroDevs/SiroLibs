              },
              "items": [
                {
                  "text": "Amo 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nkaabaasibwa ki omwe omuriimwe akinga enyigi, mureka kuguma nimuhembera busha omuriro aha itambiro ryangye! Tindikubashemerererwa na kakye, kandi tindikwija kwikiriza mpongano yoona ei murampongyere; nikwo MUKAMA ow'amahe arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.10",
            "verseOrgIds": [
              "MAL.1.10"
            ]
          }
        },
        {
