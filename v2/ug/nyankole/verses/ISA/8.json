                  "text": "Isa 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi garyahimintika, gahikye Yuda, gashandaare, gaijure, gahikye omu bitsya, kandi n'amapapa gaago agashashaanwire garyabuga ensi yaawe yoona, Emanueli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
