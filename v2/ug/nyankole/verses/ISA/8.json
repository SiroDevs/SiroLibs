          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kureka baryaraba omu nsi, baine obusaasi bwingi n'enjara; kandi ku barigira enjara, bayragira ekiniga kingi, bakyeene omugabe waabo na Ruhanga waabo, baimutsye amaisho, bagahangye eiguru, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.21",
            "verseOrgIds": [
              "ISA.8.21"
            ]
