              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiragiro n'ebirikuhamya mube nibyo mwayehanuuzaho! Ku baraabe batarikugamba nk'oku ekigambo eki kiri, buzimazima omushekye tiguribajugutira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.20",
            "verseOrgIds": [
              "ISA.8.20"
            ]
          }
        },
        {
