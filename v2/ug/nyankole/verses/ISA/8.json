              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aba bantu obu baayanga amaizi ga Shiloa agarikugyenda mpora, bakatiina Rezini na mwene Ramalia, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
