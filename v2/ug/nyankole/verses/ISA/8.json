                {
                  "text": "Isa 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mukama naija kubarwanisa n'amaizi maingi g'amaani ag'omugyera Furaati, niwe mugabe wa Asiria n'ekitiinisa kye kyona; amaizi ago garyaijura, gashwekye emikura yoona, garengyere n'aha nkungu zaagwo zoona; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 8:8"
          },
          "items": [
