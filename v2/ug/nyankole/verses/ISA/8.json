            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka MUKAMA ow'amahe mube niwe mwaha ekitiinisa ahabw'okwera kwe, mube niwe mwatiina, akabaitsa obwoba. ",
          "type": "text",
          "attrs": {
