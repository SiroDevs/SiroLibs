            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eki ab'eihanga eri barikweta obugomi, murekye kukyeta obugomi, kandi mutaritiina eki barikutiina, n'obu kwakuba okwitwa obwoba; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        },
        {
