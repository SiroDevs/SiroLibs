          ]
        },
        {
          "text": "MUKAMA antaireho omukono gwe gw'amaani, yanteisa okutagyendera omu mitwarize y'eihanga eri nagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.11",
