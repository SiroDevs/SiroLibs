              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhanda ogwamureetsire nigwo gurimugarurayo, kandi taritaaha muri oru rurembo, nikwo MUKAMA arikugamba. ",
          "type": "text",
          "attrs": {
