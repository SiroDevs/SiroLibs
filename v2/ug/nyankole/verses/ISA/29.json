          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku bakiha otarikumanya kushoma, baamugira bati, Kishome, abagarukamu ati: Tindikumanya kushoma.",
          "type": "text",
          "attrs": {
