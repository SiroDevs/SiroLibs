        },
        {
          "text": "Okworekwa kwona kubahindukiire nk'ebigambo by'omu kitabo ekikwatanisiibwe akamanyiso. Abantu ku bakiha omuntu orikumanya kushoma, baamugira bati, Kishome, abagarukamu ati: Tindikubaasa kukishoma, ahabw'okuba kikwatanisiibwe akamanyiso. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
