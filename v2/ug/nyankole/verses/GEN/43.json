              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.45.22"
              },
              "items": [
                {
                  "text": "Kut 45:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yosefu yaababegyera ebitongye aha by'okurya ebyabaire biri omu maisho ge, kwonka ekitongye kya Benyamiini kyakira ekya buri omwe aharibo emirundi etaano. Bwanyima baanywa, baashemererwa hamwe nawe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.34",
            "verseOrgIds": [
              "GEN.43.34"
            ]
          }
