              "GEN.42.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.17+ROM.12.18+ROM.12.19+ROM.12.20+ROM.12.21"
              },
              "items": [
                {
                  "text": "Rom 12:17-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga aho Yosefu yaaragiira kwijuza enshaho zaabo eby'okurya, n'okugarura efeeza ya buri muntu omu nshaho ye, n'okubaha entanda y'okuriira omu muhanda; okwo nikwo baabakoreire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.25",
            "verseOrgIds": [
              "GEN.42.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 42:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu baata eby'okurya byabo aha ndogoya zaabo, baagyenda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.26",
            "verseOrgIds": [
              "GEN.42.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 42:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baahikire omu icumbi, omwe aharibo yaakomorora enshaho ye okuriisa endogoya, yaashanga efeeza ye eri omu minwa yaayo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.27",
            "verseOrgIds": [
              "GEN.42.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 42:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaagambira bagyenzi be ati: Efeeza yangye baagingarurira; reeba ngigi omu nshaho yangye; baahuruutuka emitima, bahindukirana nibatetema, nibagira bati: Eki n'enki eki Ruhanga yaatukorera? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.28",
            "verseOrgIds": [
              "GEN.42.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 42:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baahikire ahari Yakobo ishebo omu nsi ya Kanaani, baamugambira byona ebyababaireho, nibagira bati: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.29",
            "verseOrgIds": [
              "GEN.42.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 42:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija orikutegyeka egyo nsi akatukabukira, yaatweta abaizire kutata ensi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.30",
            "verseOrgIds": [
              "GEN.42.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 42:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "naitwe twamugira tuti: Turi ab'amazima, tituri ntatsi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.31",
            "verseOrgIds": [
              "GEN.42.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 42:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "turi eishe-emwe ikumi na babiri, abaana b'omushaija omwe; omwe takibaho, kandi na murumuna waitu omuto atsigaire n'omugurusi waitu omu nsi ya Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.32",
            "verseOrgIds": [
              "GEN.42.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 42:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija ogwo orikutegyeka ensi yaatugira ati: Eki nikyo kirimmanyisa ku muri ab'amazima. Muntsigire omwe ahariimwe, mutware eby'okurya ahabw'enjara y'omu maka gaanyu, mugyende; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.33",
            "verseOrgIds": [
              "GEN.42.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 42:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "mundeetere murumuna waanyu omuto; niho ndimanyira ku mutari ntatsi, kureka ku muri ab'amazima; reero naanye ndyabagarurira mugyenzi waanyu, mubone kushuubura omu nsi egi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.34",
            "verseOrgIds": [
              "GEN.42.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 42:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baabaire nibaiha eby'okurya omu nshaho zaabo, buri muntu yaashanga ekifunyika ky'efeeza kiri omu nshaho ye; bo na ishebo ku baareebire ebifunyika by'efeeza, baatiina. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.35",
            "verseOrgIds": [
              "GEN.42.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 42:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.43.14"
              },
              "items": [
                {
                  "text": "Kut 43:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ishebo Yakobo yaabagira ati: Mbwenu ho mwancwa; Yosefu takibaho, na Simeoni tariho; mbwenu nimwenda kuunyihaho na Benyamiini. Ebyo byona niinye biiziire! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.36",
            "verseOrgIds": [
              "GEN.42.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 42:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reubeeni yaagira ishe ati: Ku ndiba ntamukugaruriire, oite batabani bangye bombi; munkwatse, ndyamukugarurira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.37",
            "verseOrgIds": [
              "GEN.42.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 42:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.28+GEN.44.29+GEN.44.30+GEN.44.31"
              },
              "items": [
                {
                  "text": "Kut 44:28-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Onu ati: Omwana wangye tarikwija kugyenda naimwe; ahabw'okuba mukuru we akafa, niwe atsigaireho wenka; akabi katakaamuhikaho, mukandeetera obujune bukampuhura, nkashuuma okuzimu nk'oku murikundeeba n'ezi nju.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.38",
            "verseOrgIds": [
              "GEN.42.38"
            ]
          }
        }
      ]
