          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.30.1"
              },
              "items": [
                {
                  "text": "Kut 30:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA ku yaareebire Lea yaaba enyangwakazi, yaigura enda ye; kwonka Rakeeli we yaaba engumba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea yaagira enda, yaazaara omwana w'omwojo; yaamweta Reubeeni; ahakuba akagira ati: MUKAMA areebire okwitwa kubi kwangye; mbwenu ibanye naija kunkunda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaagira enda, yaazaara ondiijo mwojo; yaagira ati: MUKAMA ahuriire ku ndikwangwa, nikyo yampeera n'ogu; yaamweta Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaagira enda, yaazaara omwojo; yaagira ati: Aha murundi ogu ibanye naija kukwatanisa naanye, ahakuba mmuzaariire aboojo bashatu; n'ahabw'ekyo yaamweta Leevi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaagira enda, yaazaara omwojo; yaagira ati: Omurundi ogu naaza kuhimbisa MUKAMA; nikyo yaamweteire Yuda; bwanyima oruzaaro rwayemerera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        }
      ]
