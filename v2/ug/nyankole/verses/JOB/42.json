              "attrs": {
                "loc": "1JN.5.16"
              },
              "items": [
                {
                  "text": "1 Yoh 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.23"
              },
              "items": [
                {
                  "text": "1 Sam 12:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.23.1"
              },
              "items": [
                {
                  "text": "Kub 23:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.7"
              },
              "items": [
                {
                  "text": "Kut 20:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo hati mutware enimi mushanju n'empaya z'entaama mushanju, muze ow'omwiru wangye Yobu, mwetambirireyo ekitambo ky'okwotsya; bwanyima omwiru wangye Yobu naija kubashabira; ahabw'okuba niwe ndikwija kwikiriza, nkareka kubatwaza nk'obushema bwanyu oku buri; ahakuba timungambireho bihikire nk'omwiru wangye Yobu oku agizire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifaazi Omutemaani na Biludaadi Omushuuhi na Zofari Omunaamasi nikwo kugyenda, bakakora eki MUKAMA yaabaragiira, na MUKAMA akaikiriza okushaba kwa Yobu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
