                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5"
              },
              "items": [
                {
                  "text": "Kush 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka otagyera ekibuga kyayo; okirekye, ahabw'okuba kikaheebwayo omu mikono y'Abanyamahanga, kandi baryaribatiirira orurembo orurikwera okumara ameezi makumi ana n'abiri. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.2",
            "verseOrgIds": [
              "REV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abajurizi bangye babiri ndyabaha obushoboorozi bw'okumara ebiro rukumi na magana abiri na makumi mukaaga nibaranga bajwaire ebiguniya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        }
      ]
    },
