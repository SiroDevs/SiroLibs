            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima naaheebwa ekibingo ekyemi nk'orubango; omwe yangira ati: Imuka, ogyere hekalu ya Ruhanga n'eitambiro n'abarikugiramizamu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.1",
            "verseOrgIds": [
              "REV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
