              "items": [
                {
                  "text": "Oba 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maraika owa mushanju yaateera enzamba; haabaho amaraka mahango omu iguru nigagira gati: Obukama bw'ensi bwahinduka obwa Mukama waitu n'obwa Kristo we, kandi aryaguma aha ngoma ebiro n'ebiro. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru abo makumi abiri na bana, abashutama aha bitebe byabo omu maisho ga Ruhanga, baagwa, baajuumara, baaramya Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.16",
            "verseOrgIds": [
              "REV.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.4"
              },
              "items": [
                {
                  "text": "Isa 41:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nibagira bati: Nitukusiima, Mukama Ruhanga ow'obushoboorozi bwona, oriho kandi owaabaireho, ahakuba otwaire obushoboorozi bwawe obukuru, kandi oyemire, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.17",
            "verseOrgIds": [
              "REV.11.17"
            ]
          }
        },
