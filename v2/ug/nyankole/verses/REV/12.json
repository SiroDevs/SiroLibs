              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekijoka ku kyareebire kyanagwa aha nsi, kyahiiga omukazi owaazaire omwana w'omwojo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.13",
            "verseOrgIds": [
              "REV.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.7"
              },
              "items": [
                {
                  "text": "Dan 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka omukazi yaaheebwa amapapa abiri g'eishemba rihango, ngu agurukye ahungire ekyo kijoka omu ihamba, omu mwanya ogu aririisizibwamu okumara omwanya n'emyanya n'ekicweka ky'omwanya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekijoka kyacwera amaizi agarikwingana omwegyemure enyima y'ogwo mukazi, ngu gamutware; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.15",
            "verseOrgIds": [
              "REV.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka ensi yaahwera omukazi, yaayashama, yaamira omwegyemure, ogu ekyo kijoka cyacweire. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.16",
            "verseOrgIds": [
              "REV.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.7"
              },
              "items": [
                {
                  "text": "Kush 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.15"
              },
              "items": [
                {
                  "text": "Kut 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekijoka nikwo kugirira ogwo mukazi ekiniga, kikaza kurwanisa oruzaaro rwe orutsigaireho, orurikworobera ebiragiro bya Ruhanga, rukahamya ebya Yesu; kikeemerera aha musheenyi gw'enyanja.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.17",
            "verseOrgIds": [
              "REV.12.17"
            ]
          }
        }
      ]
    }
