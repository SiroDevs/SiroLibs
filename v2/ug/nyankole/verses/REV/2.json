          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkamuha omwanya gw'okweteisa; kwonka yaayanga kweteisa obushambani bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.21",
            "verseOrgIds": [
              "REV.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reeba, niinyija kumunaga aha kitabo n'abashambane be omu kubonabona kwingi, ku baraabe bateeteisize by'emicwe ye; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
            "verseOrgIds": [
              "REV.2.22"
            ]
          }
        },
