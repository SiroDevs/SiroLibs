          ]
        },
        {
          "text": " kandi aryabategyeka n'enkoni y'ekyoma, nk'oku omuntu ayatagura enyabya z'eibumba, nkaanye oku naahairwe Tata obutegyeki; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.27",
            "verseOrgIds": [
              "REV.2.27"
            ]
          }
        },
