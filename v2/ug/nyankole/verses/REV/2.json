              "REV.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.12"
              },
              "items": [
                {
                  "text": "Heb 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.15"
              },
              "items": [
                {
                  "text": "Kush 19:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Handiikira maraika w'ekanisa ey'omuri Perugamo oti: Ebi nibyo bigambo by'Ogwo oine rurara y'amoogi abiri arikugamba, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "naagira ati: Nimmanya ahu otuura ku niho ekitebe ky'obukama bwa Sitaane kiba; ku ogumiza kimwe eiziina ryangye, kandi ku otareehakaine ku orikuunyikiriza, nangwa n'omu biryo bya Antipa, kareebi wangye omwesigwa, owaitiirwe owaanyu, ahu Sitaane atuura. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.13",
            "verseOrgIds": [
              "REV.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.16"
              },
              "items": [
                {
                  "text": "Kub 31:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka nyine ebigambo bikye ebi ndikufa naiwe; okwo oineyo abarikwikiriza enyegyesa ya Balamu, owaayegyeise Balaki kuta enkongi omu maisho g'Abaisraeli, ngu barye ebitambiirwe ebishushani ebirikuramibwa, kandi bashambane. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hoona oine n'abandi abarikwikiriza enyegyesa ey'Abanikolaiti. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo oyeteise; ku oraabe oteeteisize, niinyija kwija juba ahariiwe, mbarwanise na rurara ey'omu kanwa kangye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
            "verseOrgIds": [
              "REV.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.24"
              },
              "items": [
                {
                  "text": "Zab 78:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.2"
              },
              "items": [
                {
                  "text": "Isa 62:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oine amatu, ahurire eki Omwoyo arikugambira amakanisa. Orikusingura ndyamuha omugabo aha maanu esherekirwe, kandi ndyamuha eibaare eririkwera, erihandiikirweho eiziina risya, eritarikumanywa muntu weena kureka ogwo owaariheebwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.17",
            "verseOrgIds": [
              "REV.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.17",
            "verseOrgIds": [
              "REV.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handiikira maraika w'ekanisa ey'omuri Suatira, oti: Ebi nibyo bigambo by'Omwana wa Ruhanga, oine amaisho agari nk'endimi z'omuriro, n'ebigyere bye biri nk'omuringa ogurikwengyengyeta. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagira ati: Nimmanya emirimo yaawe, n'okukunda kwawe n'okwikiriza n'okuheereza n'okugumisiriza kwawe, kandi nimmanya ngu emirimo yaawe eya bwanyima neekira ey'okubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.19",
            "verseOrgIds": [
              "REV.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.22"
              },
              "items": [
                {
                  "text": "2 Bag 9:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka nyine eki ndikufa naiwe; ogumisiririza omukazi Yezebeeli, orikweyeta nabikazi, kandi oyegyesa abahuuku bangye, akabahabya ngu bashambane, kandi ngu barye ebitambiirwe ebishushani. ",
          "type": "text",
          "attrs": {
