                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi n'abaana be ndyabaitsa rufu; amakanisa goona garyamanya ngu niinye ocaaka emitima n'emyoyo; kandi ndyazimuurira omuntu weena omuriimwe ebishemereire ebi yaakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        },
        {
