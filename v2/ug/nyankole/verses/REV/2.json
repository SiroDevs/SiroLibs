          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka imwe ab'omuri Suatira abatsigaire mutaikiriize nyegyesa egyo, abatarikumanya bi abandi beeta enaama za Sitaane, nimbagambira ku ntarikubakorera gundi mutwaro; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
