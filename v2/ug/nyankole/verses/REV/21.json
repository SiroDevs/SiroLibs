              },
              "items": [
                {
                  "text": "2 Kor 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo owaabaire ashutami aha kitebe ky'obukama yaagira ati: Reeba nimpindura byona bisya. Kandi yangira ati: Handiika, ahakuba ebigambo ebi n'eby'okwesigwa kandi eby'amazima. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.5",
            "verseOrgIds": [
              "REV.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.17"
              },
              "items": [
                {
                  "text": "Kush 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Isa 55:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yangira ati: Kyahwa. Niinye Alufa na Omega, obutandikiro n'obugarukiro. Oine eiriho ndyamuhera busha amaizi agarikuruga aha nshuro y'amaizi g'amagara. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.6",
            "verseOrgIds": [
              "REV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orikusingura aryahungura ebi, ndyaba Ruhanga we, nawe abe omwana wangye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.7",
            "verseOrgIds": [
              "REV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.15"
              },
              "items": [
                {
                  "text": "Kush 22:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka abatiini, abatarikwikiriza, abakora ebihagaro, abaitsi, abashambani, abarogi, abaramya ebishushani, n'ababeihi, boona omugabo gwabo guryaba omu nyanja erikwaka omuriro n'obuganga bw'ekibiriiti, nikwo kufa kwa kabiri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
