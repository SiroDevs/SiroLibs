        },
        {
          "text": "ogwa kataano sarudoniksi, ogwa mukaga sarudio, ogwa mushanju krosoliito, ogwa munaana berulo, ogwa mwenda topazi, ogwa ikumi krusopuraso, ogwa ikumi na gumwe huwakinto, ogwa ikumi n'ebiri amesuusito, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.20",
            "verseOrgIds": [
