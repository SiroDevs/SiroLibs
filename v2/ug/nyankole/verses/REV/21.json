                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo owaagambire naanye akaba aine orubango rw'okugyeresa rw'ezaabu kugyeresa orurembo n'amarembo gaarwo n'orugo rwarwo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi orurembo rukaingaingana embaju zoona; oburaingwa bwarwo bwingana n'obukiika bwarwo; yaagaruka yaagyera orurembo n'orubango rwe, yaashanga ziri mahiro rukumi na magana ataano; oburaingwa bwarwo n'obukiika bwarwo n'obwemi bwarwo byona nibiingana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaagyera orugo rwarwo, yaashanga rurimu mikono igana na makumi ana n'ena omu migyerere y'abantu, nikyo kimwe n'eya maraika.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.17",
            "verseOrgIds": [
              "REV.21.17"
            ]
          }
        }
      ]
    },
