              "REV.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima haija omwe ahari baamaraika mushanju abaabaire baine enyabya mushanju eziijwire ebibonaboneso mushanju eby'aha mperu, yangira ati: Ija nkworekye omugore muka Omwana gw'entaama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.9",
            "verseOrgIds": [
              "REV.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.1"
              },
              "items": [
                {
                  "text": "Isa 52:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yantwara aha rushozi ruhango kandi ruraingwa ndi omu Mwoyo, yaanyoreka orurembo orurikwera Yerusaalemu, nirushuuma okuruga omu iguru ahari Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.10",
            "verseOrgIds": [
              "REV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "rwine ekitiinisa kya Ruhanga; okumurinkana kwarwo nikushusha nk'okw'eibaare ry'obuguzi bwingi, eririkwetwa yasipi, eririkwengyengyeta nka ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.11",
            "verseOrgIds": [
              "REV.21.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:11",
              "type": "text"
            },
            {
              "text": "kristalo n'eibaare eririkushusha nk'endeeberwamu.",
              "type": "text"
            }
          ]
        },
        {
          "text": "kristalo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.11",
            "verseOrgIds": [
              "REV.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.31+EZK.48.32+EZK.48.33+EZK.48.34+EZK.48.35"
              },
              "items": [
                {
                  "text": "Ezk 48:31-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rukaba rwine orugo ruhango kandi ruraingwa n'amarembo ikumi n'abari; aha marembo ago hariho baamaraika ikumi na babiri, kandi hahandiikirweho amaziina g'enganda ikumi na ibiri z'abaana ba Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.12",
            "verseOrgIds": [
              "REV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rubaju rw'oburugwa-izooba amarembo ashatu, aha bukiizi-bwa-bumohso ashatu, aha bukiizi-bwa-buryo ashatu, n'aha rubaju rw'oburengyerwa-izooba amarembo ashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.13",
            "verseOrgIds": [
              "REV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi orugo rw'orwo rurembo rukaba rwine emisingi ikumi n'ebiri, ehandiikirweho amaziina g'entumwa ikumi na ibiri ez'Omwana gw'entaama.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.14",
            "verseOrgIds": [
              "REV.21.14"
            ]
          }
        }
      ]
    },
