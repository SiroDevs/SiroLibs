          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.2"
              },
              "items": [
                {
                  "text": "Mat 17:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaashuuma, yaaruga aha rushozi Sinai, aine ebishate bibiri eby'Ebirikuhamya omu ngaro; ku yaabaire naashuuma, tiyaamanya aha maisho ge ku harikumurinkana, ahakuba akaba naagaaniira na Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.29",
            "verseOrgIds": [
              "EXO.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni n'Abaisraeli boona ku baareebire Musa, reeba aha maisho ge hakaba nihamurinkana; baatiina kumuhika haihi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.30",
            "verseOrgIds": [
              "EXO.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaabeeta, Arooni n'abategyeki boona ab'eihanga eryo baagaruka ah'ari; Musa yaagaaniira nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.31",
            "verseOrgIds": [
              "EXO.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Abaisraeli boona bairira haihi; yaabamanyisa ebiragiro byona oku biri, ebi MUKAMA amugambiriire aha rushozi Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.32",
            "verseOrgIds": [
              "EXO.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.13+2CO.3.14+2CO.3.15+2CO.3.16"
              },
              "items": [
                {
                  "text": "2 Kor 3:13-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa ku yaaherize kugamba nabo, yaata eky'okwetwekyerera aha maisho ge. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.33",
            "verseOrgIds": [
              "EXO.34.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku yaabaire aza omu maisho ga MUKAMA kugamba nawe, akiihaho okuhitsya ahu araashohorere; kandi ku yaabaire ashohora kugambira Abaisraeli ebi yaaragiirwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.34",
            "verseOrgIds": [
              "EXO.34.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 34:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli bareeba aha maisho ge nihamurinkana; Musa agaruka ayeta eky'okwetwekyerera aha maisho, okuhitsya obu yaabaire agarukayo kugaaniira na MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.35",
            "verseOrgIds": [
              "EXO.34.35"
            ]
          }
        }
      ]
