            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro mukaaga oryakora, kwonka aha kiro kya mushanju oryahuumura; omu ibiba n'omu igyesha oryahuumura. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.21",
            "verseOrgIds": [
              "EXO.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.16"
              },
              "items": [
                {
                  "text": "Kur 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oryarinda obugyenyi bwa saabiiti mushanju, ez'omuganuro gw'eigyesha ry'engano, kandi n'obugyenyi bw'eishaaruura ry'aha muheru gw'omwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
              "EXO.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kashatu omu mwaka abeetwa abashaija boona baryaguma baije, bareebwe omu maisho ga Mukama RUHANGA, Ruhanga wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.55"
              },
              "items": [
                {
                  "text": "Zab 78:55",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.17.10"
              },
              "items": [
                {
                  "text": "2 Bus 17:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba ndyabinga amahanga, garugye omu maisho gaawe, nyirizeyo emyatano yaawe; ku oriba ogiire kureebwa omu maisho ga MUKAMA kashatu omu mwaka, tihaine muntu weena oryetenga ensi yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otarihayo eshagama y'ekitambo ekintambiirwe hamwe n'omugaati ogutumbisiibwe, kandi ekitambo ky'obugyenyi bw'ekiro kikuru ky'Okuhingurwaho kitaritsigaraho okuhitsya omu kasheeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.9"
              },
              "items": [
                {
                  "text": "Enf 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emiganuro y'ebirikubanza kwera omu misiri yaawe oryagireeta omu nju ya MUKAMA Ruhanga waawe. Otariteeka omwana gw'embuzi omu mahenahene ga nyinagwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: Handiika ebigambo ebyo; ahakuba endagaano ei ndagaine naiwe n'Abaisraeli neehamira aha bigambo ebyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaamarayo ebiro makumi ana nyomushana na nyekiro, ari hamwe na MUKAMA; omu biro ebyo tarariire by'okurya n'obu kwakuba okunywa amaizi. Yaahandiika ahari ebyo bishate by'amabaare ebigambo by'endagaano egyo, nibyo biragiro ikumi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
      ]
    },
