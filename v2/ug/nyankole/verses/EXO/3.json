              },
              "items": [
                {
                  "text": "Yer 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaagira Ruhanga ati: Niinye oha kuturukirira Faraho nkaiha Abaisraeli omuri Misri? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.11",
            "verseOrgIds": [
              "EXO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.5"
              },
              "items": [
                {
                  "text": "Yos 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.2"
              },
              "items": [
                {
                  "text": "Isa 43:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaamugira ati: Buzimazima ndyaba nkwine. Akamanyiso akarihamya ku niinye naakutumire n'aka; ku oriba waihire abantu omuri Misri, muryaheerereza Ruhanga aha rushozi oru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.12",
            "verseOrgIds": [
              "EXO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagarukamu Ruhanga ati: Ku ndihika Abaisraeli, naabagira nti: Ruhanga wa baashwenkuriimwe abantumireho; bambuuza bati: Eiziina rye n'oha? ndyabagarukamu nta? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.13",
            "verseOrgIds": [
              "EXO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.6.3"
              },
              "items": [
                {
                  "text": "Kur 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.8"
              },
              "items": [
                {
                  "text": "Heb 13:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruhanga yaagira Musa ati: Ndi MBAHO; kandi yaagira ati: Oku nikwo origambira Abaisraeli, oti: MBAHO niwe abantumireho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.14",
            "verseOrgIds": [
              "EXO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ruhanga yaagambira Musa ati: Oku nikwo origambira Abaisraeli, oti: MUKAMA, Ruhanga wa baashwenkuriimwe, Ruhanga wa Abrahamu, Ruhanga wa Isaaka, Ruhanga wa Yakobo niwe abantumireho; eryo niryo iziina ryangye ebiro byona, kandi okwo nikwo nshemereire kwijukwa obusingye bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.15",
            "verseOrgIds": [
              "EXO.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.68"
              },
              "items": [
                {
                  "text": "Luk 1:68",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Irooko oteeranire hamwe abakuru b'Abaisraeli, obagire oti: MUKAMA Ruhanga wa baashwenkuriimwe, Ruhanga wa Abrahamu na Isaaka na Yakobo akanyeyoreka naagira ati: Mbareebire, naareeba n'okubarikubagira omuri Misri; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.16",
            "verseOrgIds": [
              "EXO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbwenu nindaganisa okubaiha omu kubonabona kwa Misri, mbatware omu nsi y'Abanyakanaani, ey'Abahiiti, ey'Abaamori, ey'Abaperizi, ey'Abahiivi kandi n'ey'Abayebusi, ensi ey'amate n'obwoki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.17",
            "verseOrgIds": [
              "EXO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baryakuhurira; bwanyima oryagyenda n'abakuru b'Abaisraeli ow'omugabe wa Misri mumugire muti: MUKAMA Ruhanga w'Abaheburaayo atutaayaayiire; mbwenu nitukweshengyereza, orekye tugyende orugyendo rw'ebiro bishatu omu ihamba tutambiririreyo MUKAMA Ruhanga waitu ebitambo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.18",
            "verseOrgIds": [
              "EXO.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nimmanya ku omugabe wa Misri ataribaikiriza kugyenda, kureka yaagyemwa omukono gw'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.19",
            "verseOrgIds": [
              "EXO.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
