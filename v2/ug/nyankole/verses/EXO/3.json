            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.9"
              },
              "items": [
                {
                  "text": "Isa 63:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.30"
              },
              "items": [
                {
                  "text": "Byak 7:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maraika wa MUKAMA yaamweyorekyera omu rurimi rw'omuriro nigunaga enkobe ahagati y'orushaka; yaayetegyereza, yaareeba orushaka nirwaka, kwonka rutarikusya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.2",
            "verseOrgIds": [
              "EXO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagira ati: Ka nkiikame, ndeebe eri ihano, orushaka okwaka rutasye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.3",
            "verseOrgIds": [
              "EXO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA ku yaareebire yaakiikama kureeba, Ruhanga yaamweta naayema ahagati omu rushaka, naagira ati: Musa, Musa! Yaamwetaba ati: Ndi aha, Mukama wangye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.4",
            "verseOrgIds": [
              "EXO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.5.15"
              },
              "items": [
                {
                  "text": "Yos 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruhanga yaagira ati: Otairira haihi; juura enkaito omu bigyere byawe, ahakuba omwanya ogu oyemereiremu n'ogurikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.5",
            "verseOrgIds": [
              "EXO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.26"
              },
              "items": [
                {
                  "text": "Mak 12:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.1"
              },
              "items": [
                {
                  "text": "Isa 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaagira ati: Ndi Ruhanga wa sho, Ruhanga wa Abrahamu, Ruhanga wa Yakobo. Musa yaayekwata aha maisho, ahakuba akatiina kureeba Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.6",
            "verseOrgIds": [
              "EXO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.6",
            "verseOrgIds": [
              "EXO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira ati: Buzimazima ndeebire okubonabonesibwa kw'abantu bangye abari omuri Misri, naahurira okutaka kwabo oku barikutakisibwa abanyampara; ahabw'okuba nimmanya obusaasi bwabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.7",
            "verseOrgIds": [
              "EXO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.27"
              },
              "items": [
                {
                  "text": "Kub 13:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi naashuuma kubajuna, kubaiha omu mikono y'Abanyamisri, barugye omu nsi egyo, mbatware omu nsi enungi kandi egarami, ensi ey'amate n'obwoki, ensi ey'Abanyakanaani, ey'Abahiiti, ey'Abaamori, ey'Abaperizi, ey'abahiivi n'ey'Abayebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.8",
            "verseOrgIds": [
              "EXO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbwenu reeba, okutaka kw'Abaisraeli kumpikireho, kandi ndeebire okuhatwa oku Abanyamisri barikubahata. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.9",
            "verseOrgIds": [
              "EXO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo ija, nkutume ahari Faraho, oihe abantu bangye Abaisraeli omuri Misri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.10",
            "verseOrgIds": [
              "EXO.3.10"
            ]
          }
        }
      ]
    },
