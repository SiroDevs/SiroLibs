                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro ebyo Musa akaba naariisa obusyo bwa ishezaara Yesero omunyamurwa wa Midiani; yaatwara obusyo aha rubaju rw'oburengyerwa-izooba bw'eihamba, yaahika aha rushozi rwa Ruhanga orurikwetwa Horebu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.1",
            "verseOrgIds": [
              "EXO.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
