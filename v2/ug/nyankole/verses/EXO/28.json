                "loc": "NUM.16.1+NUM.16.2+NUM.16.3"
              },
              "items": [
                {
                  "text": "Kub 16:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.1+HEB.5.2+HEB.5.3+HEB.5.4"
              },
              "items": [
                {
                  "text": "Heb 5:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oyeirize Arooni mukuru waawe n'abatabani, Nadabu, Abihu, Eleazaari na Itamaari, obaihe omu Baisraeli, bankorere omurimo gw'obunyamurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.1",
            "verseOrgIds": [
              "EXO.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.26+NUM.20.27+NUM.20.28"
              },
              "items": [
                {
                  "text": "Kub 20:26-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okorere Arooni mukuru waawe ebijwaro birikwera, bimuhaise ekitiinisa n'okureebeka gye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.2",
            "verseOrgIds": [
              "EXO.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.12"
              },
              "items": [
                {
                  "text": "1 Bag 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.7+1CO.12.8+1CO.12.9+1CO.12.10+1CO.12.11"
              },
              "items": [
                {
                  "text": "1 Kor 12:7-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ogambire boona abarikumanya munonga kubaziira, abu nyijwize omwoyo gw'obwengye, bakore ebijwaro bya Arooni okumushoroora, abone kunkorera omurimo gw'obunyamurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.3",
            "verseOrgIds": [
              "EXO.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebijwaro ebi baraakore nibyo ebi eky'aha kifuba, efodi, ekanzu yaayo, n'ekooti y'akatimba, ekikwemba n'eky'okwezirikisa; kandi bakorere Arooni mukuru waawe n'abatabani ebijwaro birikwera, babone kunkorera omurimo gw'obunyamurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.4",
            "verseOrgIds": [
              "EXO.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batware eby'okukoresa, ezaabu, emyenda ya bururu, eya bujwa, eya karari n'eya bafuta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.6",
            "verseOrgIds": [
              "EXO.28.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.39.2"
              },
              "items": [
                {
                  "text": "Kur 39:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Efodi baryagikoresa ezaabu n'emyenda ya bururu, eya bujwa, eya karari n'eya kitaani, abahangu baabyo babe nibo baagikora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.6",
            "verseOrgIds": [
              "EXO.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egire ebiremu bibiri aha mabega, biteerane emikugiro yaayo yombi, efodi ebone kuteeranwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.7",
            "verseOrgIds": [
              "EXO.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eky'okwezirikisa ekigikoreirweho, ekirukirwe abanyamwoga, kikorwe nkayo, kandi kirukwe omu bintu bimwe n'ebyayo, ezaabu, emyenda ya bururu, eya bujwa, eya karari n'eya kitaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.8",
            "verseOrgIds": [
              "EXO.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ogire amabaare abiri agarikwetwa shohamu, ogasharureho amaziina g'abaana ba Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.9",
            "verseOrgIds": [
              "EXO.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "amaziina gaabo mukaaga ogahandiikye aha ibaare rimwe, n'amaziina g'abandi mukaaga ogahandiikye aha rindi, nk'oku barikukuratana omu bukuru bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.10",
            "verseOrgIds": [
              "EXO.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'oku omusharuzi asharura aha ibaare akamanyiso, obe nikwo waasharura ahari ago mabaare gombi amaziina g'abaana ba Israeli; ogahamise ezaabu ekwegire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.11",
            "verseOrgIds": [
              "EXO.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago mabaare ogate aha biremu bya efodi eby'aha mabega, gabe ag'okwijukiraho abaana ba Israeli; kandi Arooni aryaguma atware amaziina gaabo aha mabega ge gombi omu maisho ga MUKAMA kuba ekiijutsyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okore omu zaabu ekwegire eby'okuhamya amabaare, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.13",
            "verseOrgIds": [
              "EXO.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'emikuufu y'ezaabu eshemeziibwe ebiri, ogikore omu zaabu ehotoire nk'omugoye guhotoire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.17"
              },
              "items": [
                {
                  "text": "Isa 59:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.8"
              },
              "items": [
                {
                  "text": "1 Tes 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.14"
              },
              "items": [
                {
                  "text": "Efe 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okore n'eky'aha kifuba eky'okumanyisa eby'oburyo, ekikozirwe omunyamwoga; okikore nk'oku efodi ekozirwe, okikore omu zaabu, omu myenda ya bururu, omu ya bujwa, omu ya karari, n'omu ya kitaani, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.15",
            "verseOrgIds": [
              "EXO.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kingane embaju zoona kikubiraine, oburaingwa bwakyo bube ekita, n'obuhango bwakyo nabwo ekita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.16",
            "verseOrgIds": [
              "EXO.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okiteho emishorongo y'amabaare ena; omushorongo ogw'okubanza gubemu amabaare aga sarudio, topazi na barekesi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.17",
            "verseOrgIds": [
              "EXO.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "omushorongo gwa kabiri simaragido, safiro na arimasi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.18",
            "verseOrgIds": [
              "EXO.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "omushorongo gwa kashatu huwakinto, kalukedoni na amesuusito, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.19",
            "verseOrgIds": [
              "EXO.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'omushorongo ogwa kana berulo, shohamu na yasipi; goona gahamibwe omu zaabu ekwegire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.20",
            "verseOrgIds": [
              "EXO.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago mabaare garyaba ikumi n'abiri, nk'amaziina g'abaana ba Israeli oku gari; gahandiikwe nk'oku basharura akamanyiso, buri rimwe rihandiikweho eiziina ryaryo, ahabw'enganda ikumi na ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.21",
            "verseOrgIds": [
              "EXO.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi okorere eky'aha kifuba emikuufu ehotoire nk'emigoye ekozire omu zaabu eshemeziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.22",
            "verseOrgIds": [
              "EXO.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oheeshere eky'aha kifuba empeta z'ezaabu ibiri, ozite aha nshonda zombi ez'aha mutwe gwakyo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.23",
            "verseOrgIds": [
              "EXO.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "orabye emikuufu y'ezaabu yombi omuri ezo mpeta ez'aha nshonda zombi ez'eky'aha kifuba; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.24",
            "verseOrgIds": [
              "EXO.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "emitwe yombi ey'emikuufu yombi ogikome aha by'okuhamya amabaare, obone kukikwatsa aha biremu bya efodi eby'aha mabega aha rubaju rwabyo orw'omumaisho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.25",
            "verseOrgIds": [
              "EXO.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi okore ezindi mpeta z'ezaabu ibiri, ozite aha nshonda ibiri ez'omukugiro gw'eky'aha kifuba ogw'omunda, aha rubaju oruri haihi na efodi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.26",
            "verseOrgIds": [
              "EXO.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi okore empeta z'ezaabu ibiri, ozite aha mukugiro gw'ahansi ogw'ebiremu bibiri eby'aha mabega omumaisho, ahu birikuteeranira n'eky'okwezirikisa efodi ekirukirwe abanyamwoga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.27",
            "verseOrgIds": [
              "EXO.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi eky'aha kifuba bakikome aha mpeta za efodi, bakikomese otwenda twa bururu nibaturabya omu mpeta zaakyo, kibone kuza aha ky'okwezirikisa kya efodi, ekirukirwe abanyamwoga, eky'aha kifuba kirekye kuyuga kikataana na efodi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 28:29"
          },
          "items": [
