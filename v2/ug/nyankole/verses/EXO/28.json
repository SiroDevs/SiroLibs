                  "text": "Kur 30:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obijwekye Arooni mukuru waawe hamwe n'abatabani; kandi obashukyeho amajuta, obashoroore, obeeze, babone kunkorera omurimo gw'obunyamurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.41",
            "verseOrgIds": [
              "EXO.28.41"
            ]
          }
        },
        {
