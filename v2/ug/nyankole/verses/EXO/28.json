            "number": "32",
            "style": "v",
            "sid": "EXO 28:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egire ebitsya by'okurabyamu omutwe; egire n'omutarizo ogurukire okwehinguririza ebitsya byayo, nk'oku bakora ebitsya by'ekijwaro kya kitaani, ngu etataaguka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.32",
            "verseOrgIds": [
              "EXO.28.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 28:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha mukugiro gwayo ogw'ahansi obaziireho ebirikushusha amakoma-mahanga ebirukire omu huuzi za bururu na bujwa na karari, bigwehinguririze; ohundemu amajugo g'ezaabu, gagyende nigaza ahagati yaabyo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.33",
            "verseOrgIds": [
              "EXO.28.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 28:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "eijugo ry'ezaabu rikuratwe eikoma-mahanga, eijugo ry'ezaabu eikoma-mahanga, bityo bityo, okwehinguririza omukugiro gw'ekanzu gwona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.34",
            "verseOrgIds": [
              "EXO.28.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni agume agijware, yaaba naaza kuheereza; ago majugo gagambe, yaaba naaza omu Mwanya ogurikwera omu maisho ga MUKAMA, kandi naarugayo, atakaafa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        }
