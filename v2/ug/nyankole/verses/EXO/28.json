          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "okite aha kikwemba, obikwatanise n'otwenda twa bururu, kize omu maisho g'ekyo kikwemba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.37",
