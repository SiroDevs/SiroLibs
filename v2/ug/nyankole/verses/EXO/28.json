            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batabani ba Arooni obakorere ekooti n'eby'okwezirikisa n'enkofiira, okubahaisa ekitiinisa n'okureebeka gye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
