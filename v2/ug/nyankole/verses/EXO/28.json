              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi obakorere empare za kitaani, bazijware, barekye kujwara busha; ezo mpare zirugye omu bwezirikiro zihikye omu bibero; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.42",
            "verseOrgIds": [
              "EXO.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
