              "items": [
                {
                  "text": "Heb 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arooni aryaguma ajware aha mutima gwe amaziina g'abaana ba Israeli agahandiikirwe aha ky'aha kifuba eky'okumanyisa eby'oburyo, yaaba naataaha omu Mwanya ogurikwera, kuba ekiijutsyo omu maisho ga MUKAMA obutoosha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.29",
            "verseOrgIds": [
              "EXO.28.29"
            ]
          }
        },
        {
