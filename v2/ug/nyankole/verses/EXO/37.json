              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.20"
              },
              "items": [
                {
                  "text": "Kush 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaakora ekikondo ky'amatabaaza omu zaabu eshemeziibwe; ekibunu kyakyo, omukono gwakyo, ebikopo byakyo, ebintu byakyo ebyebumburikire, n'ebirabyo byakyo byaheesheranwa nakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyagira amataagi mukaaga agarikuruga ahari ogwo mukono, ashatu aha rubaju rumwe, n'ashatu aha rundi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.18",
            "verseOrgIds": [
              "EXO.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "aha itaagi rimwe ebikopo bishatu ebirikushusha nk'ebirabyo by'endozi, hamwe n'ekintu ekyebumburikire n'ekirabyo kyakyo; aha itaagi erindi ebikopo bishatu ebirikushusha nk'ebirabyo by'endozi, hamwe n'ekintu ekyebumburikire n'ekirabyo kyakyo; goona mukaaga nk'oku garikuruga aha mukono gumwe gaaba nikwo gaaba gatyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.19",
            "verseOrgIds": [
              "EXO.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahari ogwo mukono gw'ekikondo ky'etabaaza haabaho ebikopo bina ebirikushusha nk'ebirabyo by'endozi, n'ebintu ebyebumburikire n'ebirabyo byabyo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.20",
            "verseOrgIds": [
              "EXO.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekintu ekyebumburikire kyaheesheranwa n'omukono gw'etabaaza ahansi ya buri mataagi abiri agarikugurugaho; goona mukaaga gaaba nikwo gaaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.21",
            "verseOrgIds": [
              "EXO.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyebumburikire n'amataagi gaabyo byaheesheranwa nagwo omu zaabu eshemeziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.22",
            "verseOrgIds": [
              "EXO.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaheesha amatabaaza gaakyo mushanju n'empana zaago n'otusohaani twago omu zaabu eshemeziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.23",
            "verseOrgIds": [
              "EXO.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekikondo y'amatabaaza n'ebintu byakyo byona, yaabikora omu zaabu eshemeziibwe ey'oburemeezi bw'etalanta emwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        }
      ]
    },
