      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Bezaleeli yaakora eshanduukye omu munyinya, oburaingwa bwayo mikono ebiri n'ekicweka, obuhango bwayo mukono gumwe n'ekicweka, n'obwemi bwayo mukono gumwe n'ekicweka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.1",
            "verseOrgIds": [
              "EXO.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagishweka n'ezaabu eshemeziibwe omunda n'enyima, yaagitaho omuguno gw'ezaabu kugyehinguririza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.2",
            "verseOrgIds": [
              "EXO.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaayazya ezaabu, yaagiheeshamu ebifunga bina, yaabita aha nshonda zaayo ina, bibiri aha rubaju rumwe, n'ebindi bibiri aha rundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.3",
            "verseOrgIds": [
              "EXO.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakora emigamba omu munyinya, yaagishweka n'ezaabu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.4",
            "verseOrgIds": [
              "EXO.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.3"
              },
              "items": [
                {
                  "text": "2 Sam 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaata egyo migamba omu bifunga eby'omu mbaju z'eshanduukye, ngu bagume bagiheekyese. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.5",
            "verseOrgIds": [
              "EXO.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakora ekitebe ky'okusaasira omu zaabu eshemeziibwe, oburaingwa bwakyo mikono ebiri n'ekicweka, n'obuhango bwakyo mukono gumwe n'ekicweka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.6",
            "verseOrgIds": [
              "EXO.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaakora baakerubi babiri omu zaabu; omu kubakora yaabaheeshera aha mitwe yombi ey'ekyo kitebe ky'okusaasira; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.7",
            "verseOrgIds": [
              "EXO.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kerubi omwe aha mutwe gumwe, n'ondi aha gundi; yaabaheesherana n'ekitebe ky'okusaasira aha mitwe yaakyo yombi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.8",
            "verseOrgIds": [
              "EXO.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.22"
              },
              "items": [
                {
                  "text": "Kur 25:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.10"
              },
              "items": [
                {
                  "text": "2 Bus 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baakerubi baashashaanura amapapa gaabo ahaiguru, baagasangiza ekitebe ky'okusaasira, boorekyeraine nibareeba ekyo kitebe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        }
      ]
    },
