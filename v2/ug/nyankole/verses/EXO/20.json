              "items": [
                {
                  "text": "2 Bus 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ombumbire eitambiro ry'eitaka, otambireho ebitambo byawe eby'okwotsya, n'empongano zaawe ez'okusiima ahabw'obusingye, entaama zaawe n'ente zaawe; omu mwanya gwona ogu eiziina ryangye ririijukirwaho, ndyaija ah' ori, nkuhe omugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.24",
            "verseOrgIds": [
              "EXO.20.24"
            ]
          }
        },
