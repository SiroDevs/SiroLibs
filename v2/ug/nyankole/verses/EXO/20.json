              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: Oku nikwo orangambirire Abaisraeli ebi ndikubagambira nti: Imwe ahabwanyu mwayereebera oku naagamba naimwe niinyema omu iguru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
            "verseOrgIds": [
              "EXO.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaryekorera baaruhanga abandi kubamparika; baaruhanga b'efeeza nari ab'ezaabu mutaribeekorera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.23",
            "verseOrgIds": [
              "EXO.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 20:24"
          },
          "items": [
