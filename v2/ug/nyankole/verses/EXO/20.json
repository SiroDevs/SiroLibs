          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaryekorera ekishushani kyona ekibaizire, n'obu kyakuba ekishushani ky'ekintu kyona ekiri ahaiguru omu iguru, nari ekiri omu nsi ahansi, nari ekiri omu maizi okuzimu;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.4",
            "verseOrgIds": [
              "EXO.20.4"
            ]
          }
        }
