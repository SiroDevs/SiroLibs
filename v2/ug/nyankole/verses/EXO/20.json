              "type": "text"
            }
          ]
        },
        {
          "text": " Otarizaanisa eiziina rya MUKAMA Ruhanga waawe; ahakuba MUKAMA tarimubara nk'otaine rubanja orikuzaanisa eiziina rye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.7",
            "verseOrgIds": [
              "EXO.20.7"
