              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ku orinkorera eitambiro ry'amabaare, otaririkoresa amabaare gabaizire; ahakuba ku oriribaizisaho oti ekyoma kyawe, oryaba orihagaire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
