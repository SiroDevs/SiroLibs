                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu boona ku baahuriire okuhinda kw'enkuba, baareeba okutyankana kw'emirabyo, baahurira eiraka ry'enzamba, kandi baareeba orushozi nirucumba omwika, baatetema, baayemerera hare munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.18",
            "verseOrgIds": [
              "EXO.20.18"
            ]
          }
        },
        {
