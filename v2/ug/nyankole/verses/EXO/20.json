              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Niinye MUKAMA Ruhanga waawe, owaakwihire omu nsi ya Misri, omu nju y'obuhuuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.2",
            "verseOrgIds": [
              "EXO.20.2"
            ]
