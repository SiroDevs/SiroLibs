              },
              "items": [
                {
                  "text": "Bir 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka abaana b'abarikunkunda bakoorobera ebiragiro byangye, mbagirira embabazi okuhitsya obusingye enkumi n'enkumi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
