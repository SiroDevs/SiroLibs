                "loc": "DEU.5.6+DEU.5.7+DEU.5.8+DEU.5.9+DEU.5.10+DEU.5.11+DEU.5.12+DEU.5.13+DEU.5.14+DEU.5.15+DEU.5.16+DEU.5.17+DEU.5.18+DEU.5.19+DEU.5.20+DEU.5.21"
