                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka ekiro kya mushanju niyo sabato ahari MUKAMA Ruhanga waawe; otarikoreraho omurimo gwona, iwe nari mutabani waawe, nari muhara waawe, nari omuhuuku waawe, nari omuzaana waawe, nari amatungo gaawe, nari omunyaihanga ori omu ka yaawe; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        },
        {
