          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba omu biro mukaaga nimwo MUKAMA yaahangiire eiguru n'ensi, enyanja n'ebirimu byona, akahuumura aha kiro kya mushanju; nikyo MUKAMA yaaheereire omugisha ekiro kya mushanju, akakyeza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        }
