            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Bir 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oryaguma ogire obugyenyi bw'ebiro bikuru ahabwangye kashatu omu mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.14",
            "verseOrgIds": [
              "EXO.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryagira obugyenyi bw'emigaati etatumbisiibwe; omare ebiro mushanju noorya emigaati etatumbisiibwe, nk'oku naakuragiire, omu bunaku obwatairweho omu kwezi Abibu, ahakuba nikwo waarugiiremu Misri; hatarigira owaija omu maisho gangye engaro nsha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryagira obugyenyi bw'eigyesha ry'ebi waahingire omu misiri, nigwo muganuro gw'ebi waahendekyeire; kandi ku oriheza kushaaruura byona eby'omu misiri yaawe ebi waahendekyeire aha muheru gw'omwaka, oryagira obugyenyi bw'eishaaruura. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyetwa omushaija weena aryaija areebwe omu maisho ga MUKAMA Ruhanga kashatu omu mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        }
      ]
    },
