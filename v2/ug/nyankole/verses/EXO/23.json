            "sid": "EXO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otarihonga eshagama y'ekitambo, eki ntambiirwe, hamwe n'omugaati ogutumbisiibwe; kandi ebishaju by'obugyenyi bwangye otaribiraaza okuhitsya omu kasheeshe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
