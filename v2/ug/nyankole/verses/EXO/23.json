              },
              "items": [
                {
                  "text": "Efe 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oyetantare ekigambo kyona eky'ebishuba; kandi otariita otaine rubanja kandi ohikiriire; ahabw'okuba omubi tindimwihaho rubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otarirya enguzi, ahakuba enguzi eita amaisho g'abarikureeba, kandi ekiikamya ebigambo by'abataine rubanja.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        }
      ]
    },
    {
