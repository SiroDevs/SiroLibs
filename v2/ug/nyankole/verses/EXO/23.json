            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro mukaaga obe nimwo waakorera emirimo yaawe; aha kiro kya mushanju ohuumure, ente yaawe n'endogoya yaawe zihuumure, mutabani w'omuzaana waawe n'omunyaihanga bagarukwemu amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mute omutima aha bi mbagambiire byona; mutarigira obu mugambire aha maziina ga baaruhanga abandi, kandi gatarihurirwa omu kanwa kaanyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        }
      ]
    },
    {
