              "attrs": {
                "loc": "DEU.12.30"
              },
              "items": [
                {
                  "text": "Bir 12:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.23.13"
