          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otariita kubi omunyaihanga, haza kunu noomanya omutima gw'omunyaihanga; ahabw'okuba naimwe mukaba muri abanyaihanga omu nsi ya Misri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
            "verseOrgIds": [
              "EXO.23.9"
            ]
          }
        }
