          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryamara emyaka mukaaga noohinga emisiri yaawe, kandi nooshaaruura ebi oyerizemu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka omu mwaka gwa mushanju ogirekye eraare, abooro barye ebyemerizemu; kandi ebiritsigaramu biriibwe enyamaishwa. Okwo nikwo oritwaza omusiri gwawe ogw'emizaabibu, n'ogw'emizeituuni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
    },
