              "items": [
                {
                  "text": "Enf 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuganuro gw'ebirikubanza kwera omu misiri yaawe, oryaguma ogureete omu nju ya MUKAMA Ruhanga waawe. Otariteeka omwana gw'embuzi omu mahenehene ga nyinagwo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
