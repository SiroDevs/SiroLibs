              "type": "text"
            }
          ]
        },
        {
          "text": " Otaritwara enkuru z'ebishuba; otarikwatanisa n'omubi okuba mushinja w'eitima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
