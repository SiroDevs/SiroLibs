                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku oribugana ente y'omuzigu waawe, nari endogoya ye ehabire, ogimutangire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku orishanga endogoya y'orikukwanga egwire n'omutwaro, otaryehuzya, okatsiga naafa kubi atyo, kureka omuhwere kugiimutsya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
    },
