              "items": [
                {
                  "text": "Yos 23:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batariguma omu nsi yaawe, nyentsya bakakuncumuzaho; ahabw'okuba ku oriheereza baaruhanga baabo, buzimazima kiryakubeera omutego.",
          "type": "text",
