              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otariita orubanja rw'omworo w'owaanyu, yaaba naatongana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
          }
