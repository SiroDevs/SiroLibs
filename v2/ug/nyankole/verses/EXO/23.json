              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.23"
              },
              "items": [
                {
                  "text": "Luk 23:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otarikurata abaingi kukora ebibi; ku oryetwa kuba mushinja, otarigwera orubaju rw'abaingi okajurira eby'okusingisiriza orubanja; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi otarigwera orubaju rw'omuntu, ngu ahabw'okuba n'omworo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
      ]
    },
