          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: enkoni yaawe, obangye omukono gwawe ahaiguru y'amaizi g'omuri Misri, emigyera yaabo n'otugyera twabo n'ebiyanja byabo n'ahu amaizi gateeraniire hoona, gahindukye eshagama; kandi omu nsi ya Misri yoona omu bintu byabo eby'ebiti n'eby'amabaare nihaija kubamu eshagama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        },
