                "loc": "2CO.11.13"
              },
              "items": [
                {
                  "text": "2 Kor 11:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.14"
              },
              "items": [
                {
                  "text": "Kush 13:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Faraho nawe yaayeta abanyabwengye n'abarogi, kandi n'abafumu ba Misri, baakora batyo n'oburogo bwabo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.11",
            "verseOrgIds": [
              "EXO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba nabo bakanaga ahansi, buri muntu enkoni ye zaahinduka enjoka; kwonka enkoni ya Arooni yaamira ezaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.12",
            "verseOrgIds": [
              "EXO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutima gwa Faraho gwagangaara, tiyaabahurira, nk'oku MUKAMA yaagambire.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.13",
            "verseOrgIds": [
              "EXO.7.13"
            ]
          }
        }
      ]
    },
