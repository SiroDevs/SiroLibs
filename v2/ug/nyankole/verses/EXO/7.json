                "loc": "EZK.25.17"
              },
              "items": [
                {
                  "text": "Ezk 25:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.4"
              },
              "items": [
                {
                  "text": "Kush 16:4",
                  "type": "text"
                }
              ]
