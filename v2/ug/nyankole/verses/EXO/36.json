              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaakora omukingo gwa bururu na bujwa na karari na kitaani; yaagutamu ebishushani bya baakerubi ebikozirwe abanyamwoga baabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
