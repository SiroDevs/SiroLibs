      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihanga ryona ey'Abaisraeli baaruga Elimu, baahika omu ihamba rya Siini, eriri ahagati ya Elimu na Sinai aha kiro kya ikumi na bitaano eky'okwezi kwa kabiri, baherize kuruga omu nsi ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.1",
            "verseOrgIds": [
              "EXO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.10"
              },
              "items": [
                {
                  "text": "1 Kor 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eihanga ryona ery'Abaisraeli baayetomboitera Musa na Arooni omu ihamba, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.2",
            "verseOrgIds": [
              "EXO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.4"
              },
              "items": [
                {
                  "text": "Kub 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nibagira bati: Nangwa kuri twaitsirwe omukono gwa MUKAMA, tukiri omu nsi ya Misri, obu twabaire tushutama aha nyungu z'enyama, tukarya emigaati, tukahaaga. Mbwenu mukatwihayo, mwatureeta omuri eri ihamba kwitsa eri ihanga ryona enjara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.3",
            "verseOrgIds": [
              "EXO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
