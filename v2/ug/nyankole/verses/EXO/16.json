              "EXO.16.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.31"
              },
              "items": [
                {
                  "text": "Yoh 6:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.2"
              },
              "items": [
                {
                  "text": "Bir 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagambira Musa ati: Niinyija kubagwisiza eby'okurya nk'enjura okuruga omu iguru; ebiro byona abantu nibaija kuguma nibatorotoora omugabo gw'eizooba rimwe, mbone kubagyeza, mmanye ku baraabe nibaija kuguma niboorobera ebiragiro byangye, nari batarikubyorobera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.4",
            "verseOrgIds": [
              "EXO.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ahari buri kiro kya mukaaga baryayeteguura eby'okutwara omuka, biingane n'ebi batorotoora buri izooba kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.5",
            "verseOrgIds": [
              "EXO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.28"
              },
              "items": [
                {
                  "text": "Kub 16:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa na Arooni baagambira Abaisraeli boona bati: Omu mwabazyo nimwija kumanya ku owaabaihire omu nsi ya Misri ari MUKAMA; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.6",
            "verseOrgIds": [
              "EXO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.5"
              },
              "items": [
                {
                  "text": "Isa 40:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi omu kasheeshe nibwo murikwija kureeba ekitiinisa kya MUKAMA, ahabw'okuba ahuriire ebi murikumwetomboitera. Mbwenu itwe turi baahi, abu murikwetomboitera? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.7",
            "verseOrgIds": [
              "EXO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.7"
              },
              "items": [
                {
                  "text": "1 Sam 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.8"
              },
              "items": [
                {
                  "text": "1 Tes 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaagaruka yaabagira ati: MUKAMA ku araabahe enyama y'okurya omu mwabazyo, n'omu kasheeshe yaabaha omugaati mwahaaga; niho muraamanyire ku ahuriire okwetomboita kwanyu oku murikumwetomboitera. Mbwenu itwe turi baahi? Tiitwe murikwetomboitera, kureka nimwetomboitera MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagambira Arooni ati: Gambira eihanga ryona ery'Abaisraeli oti: Mwirire haihi omu maisho ga MUKAMA, ahakuba ahuriire ebi murikwetomboita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.9",
            "verseOrgIds": [
              "EXO.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni ku yaabareinaakigambira eihanga ryona ery'Abaisraeli, baanaga amaisho omu ihamba, baareeba ekitiinisa kya MUKAMA nikireebekyera omuri kiri kicu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.10",
            "verseOrgIds": [
              "EXO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.11",
            "verseOrgIds": [
              "EXO.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.27"
              },
              "items": [
                {
                  "text": "Kub 14:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mpuriire okwetomboita kw'Abaisraeli; bagambire oti: Omu mwabazyo nimwija kurya enyama, kandi omu kasheeshe nimwija kurya eby'okurya muhaagye; haza mumanye ku ndi MUKAMA Ruhanga waanyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.12",
            "verseOrgIds": [
              "EXO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
