              "EXO.16.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.31"
              },
              "items": [
                {
                  "text": "Kub 11:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.27"
              },
              "items": [
                {
                  "text": "Zab 78:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwabazyo haija endahi, zaashweka orusiisira; kandi omu kasheeshe baashanga haimukiireho orume rwehinguririize orusiisira. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.13",
            "verseOrgIds": [
              "EXO.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.40"
              },
              "items": [
                {
                  "text": "Zab 105:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Orume ku rwakyeire, aha nsi omu ihamba haareebeka otuntu tukye twekuringiriire, nk'amatondo g'orume rw'embeho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.14",
            "verseOrgIds": [
              "EXO.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.3"
              },
              "items": [
                {
                  "text": "1 Kor 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli ku baatureebire, baabuuzana bati: Ebi n'enki? ahakuba tibarabimanyire. Musa yaabagira ati: Ebyo nibyo by'okura ebi MUKAMA abahaire kurya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.15",
            "verseOrgIds": [
              "EXO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki nikyo MUKAMA arikubaragiira, naagira ati: Mutorotoore, buri muntu nk'okurya kwe oku kuri, omuntu weena homeri emwe nk'omubaro gw'abantu baanyu oku guri; buri muntu abitwarire ab'omu ihema rye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli baakora batyo, abamwe baatorotoora bingi, n'abandi bikye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.17",
            "verseOrgIds": [
              "EXO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.15"
              },
              "items": [
                {
                  "text": "2 Kor 8:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ku baabirengire omuri homeri, owaashangurwize bingi, tiyaashaazyaho; n'owaashangurwize bikye, tiyaakyenire. Buri muntu yaatorotoora nk'okurya kwe oku kwabaire kuri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.18",
            "verseOrgIds": [
              "EXO.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Musa yaabagira ati: Hatagira omuntu owaabiraazaho okuhitsya omu kasheeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.19",
            "verseOrgIds": [
              "EXO.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beitu kwonka tibaamuhurira; abamwe aharibo baabiraazaho okuhihitsya omu kasheeshe, byagiibwamu enyogori, byanuuka. Musa yaabagirira ekiniga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.20",
            "verseOrgIds": [
              "EXO.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga aho baaguma nibatorotoora buri kasheeshe, nk'okurya kwa buri muntu oku kwabaire kuri; omushana gukijwa, bihwerera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.21",
            "verseOrgIds": [
              "EXO.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.21",
            "verseOrgIds": [
              "EXO.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kya mukaaga baatorotoora eby'okurya ebirikwingana na biri kabiri, buri muntu homeri ibiri; abakuru b'eihanga boona baija, baabigambira Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.22",
            "verseOrgIds": [
              "EXO.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.15"
              },
              "items": [
                {
                  "text": "Kur 31:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaabagarukamu ati: Okwo nikwo MUKAMA agizire ati: Nyencakare n'eizooba rikuru ry'okuruhuukiraho, sabato eyereziibwe MUKAMA; mwotsye ebi murikwenda kwotsya; muteekye ebi muri kwenda kuteeka; ebiraashaagye byona mubibiikye okuhitsya omu kasheeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.23",
            "verseOrgIds": [
              "EXO.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baabiraaza, byahitsya omu kasheeshe, nk'oku Musa yaaragiire, tibyanuuka, n'obu kwakuba okugiibwamu enyogori n'emwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.24",
            "verseOrgIds": [
              "EXO.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaabagira ati: Ebyo mube nibyo mwarya eri izooba, ahakuba eri izooba ni sabato ahari MUKAMA; eri izooba timurikwija kubibona omu ishwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.25",
            "verseOrgIds": [
              "EXO.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.9"
              },
              "items": [
                {
                  "text": "Kur 20:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muryaguma nimubitorotoora okumara ebiro mukaaga; kwonka aha kiro kya mushanju, niyo sabato, tibirireebeka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.26",
            "verseOrgIds": [
              "EXO.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima aha kiro kya mushanju abantu bamwe baashohora, baaza kutorotoora, tibaabibona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.27",
            "verseOrgIds": [
              "EXO.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: Muryahitsya hi okwanga kworobera ebiragiro byangye n'ebi naaragiire? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.28",
            "verseOrgIds": [
              "EXO.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumanye ngu MUKAMA akabaha sabato, n'ahabw'ekyo ahakiro kya mukaaga nikyo abaheera eby'okurya by'okumara amazooba abiri; omuntu weena agume omu mwanya gwe; hatarigira omuntu weena owaaruga omu mwanya gwe aha kiro kya mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.29",
            "verseOrgIds": [
              "EXO.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo abantu baaruhuuka aha kiro kya mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.30",
            "verseOrgIds": [
              "EXO.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eby'okurya ebyo ab'enju ya Israeli baabyeta Emaanu; ekaba neeyera nk'enjuma z'obunyaatsi oburikwetwa gaadi; kandi neenura nk'omugaati ogukoreirwemu obwoki.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        }
      ]
