                "loc": "EXO.6.20"
              },
              "items": [
                {
                  "text": "Kur 6:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omushaija ow'omu ruganda rwa Leevi akagyenda, yaashwera omwishiki w'omu Baleevi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.1",
            "verseOrgIds": [
              "EXO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.23"
              },
              "items": [
                {
                  "text": "Heb 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omukazi ogwo yaagira enda, yaazaara omwana w'omwojo; ku yaareebire ari omwana murungi, yaamushereka okumara ameezi ashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.2",
            "verseOrgIds": [
              "EXO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ku yaareebire atakibaasa kuguma amusherekire, yaareeta akagozi k'omubimbiri k'okumutamu, yaakasiiga eibumba na koroto, yaamutamu; ako kagozi yaakata ahagati y'ebifunjo omu nkungu y'omugyera; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.3",
            "verseOrgIds": [
              "EXO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.20"
              },
              "items": [
                {
                  "text": "Kur 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
