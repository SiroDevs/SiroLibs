                "loc": "NUM.26.59"
              },
              "items": [
                {
                  "text": "Kub 26:59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " munyaanya yaayemerera hangahari kureeba ekiraamubeho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.4",
            "verseOrgIds": [
              "EXO.2.4"
            ]
          }
        }
