          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oribyama n'enyamaishwa weena, aitwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.19",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
