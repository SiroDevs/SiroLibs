            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka omu kyaro kya Gosheni kyonka, eki Abaisraeli baabaire batwiremu, nimwo orubaare rutarahikire.",
          "type": "text",
