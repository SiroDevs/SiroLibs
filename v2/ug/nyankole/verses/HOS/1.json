            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eryo izooba ndyahendera obuta bwa Israeli omu ruhita rwa Yezereeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
