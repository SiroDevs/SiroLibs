        },
        {
          "text": " MUKAMA obu yaatandika kugamba naaraba omuri Hosea, akamugira ati: Irooko, oshwere omukazi maraaya, ozaare abaana b'obwamaraaya, ahabw'okuba ensi egi erengyesereize kukora obwamaraaya ahabw'okutsigaho MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe nikwo kugyenda akashwera Gomeri muhara wa Dibulaimu, akagira enda, akzaara omwana w'omwojo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        }
