            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka enju ya Yuda yo, ndyagigirira embabazi, mbajunise MUKAMA Ruhanga waabo; tindibajunisa buta, rurara, rugamba, mbaraasi, n'obu baakuba abazigyenderaho. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        },
