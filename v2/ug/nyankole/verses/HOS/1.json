              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaacuukize Lo-ruhama, yaagaruka yaagira enda, yaazaara omwana w'omwojo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.8",
            "verseOrgIds": [
              "HOS.1.8"
            ]
          }
        },
