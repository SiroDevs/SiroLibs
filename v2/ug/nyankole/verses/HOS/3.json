                {
                  "text": "Lev 27:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikwo kumucunguza shekeli z'efeeza ikumi na itaano, na homeri ya sayiri. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
