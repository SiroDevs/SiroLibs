            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwecuma kwanyu kurekye kuba okw'aharuguru, okw'okutisba eishokye, n'okujwara eby'ezaabu, n'okujwara ebijwaro ebiragaize aha bigyere, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kureka okwecuma kwanyu kube okw'omunda omu mutima, okw'ekijwaro ekitasiisikara eky'omwoyo omucureezi ogutuurize ogw'obuguzi bwingi omu maisho ga Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abakazi abarikwera aba ira, abaabaire baine amatsiko ahari Ruhanga, nikwo baabaire beecuma, niboorobera baibabo; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
