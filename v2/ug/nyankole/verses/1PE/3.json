                  "text": "Kut 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nk'oku Saara yaabaire ayorobera Abrahamu, naamweta mukama we. Naimwe hati muri bahara be, ku muraabe nimukora gye, mutaine kirikubatiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        }
