            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naimwe abashaija, mugume mutyo n'abakazi baanyu, nk'abarikwetegyereza ebishemeire, nimubaha ekitiinisa, ahakuba ni nk'enyabya zitagumire, kandi n'abahunguzi abakwataniise naimwe omu magara agu mwahereirwe busha, okushaba kwanyu kurekye kugira ekyakuzibira.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
