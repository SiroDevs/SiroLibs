            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naimwe abakazi, mworobere mutyo baabaroimwe; ku haraabe harih abatarikworobera kigambo kya Ruhanga, bahindurwe emitwarize y'abakazi baabo, bataine kigambo kyona eki babagambiire, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
