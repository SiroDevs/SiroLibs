              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabagarukamu ati: Murekye kuunyeta ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
            "verseOrgIds": [
              "RUT.1.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:20",
              "type": "text"
            },
            {
              "text": "Naomi, amakuru ngu Orikukundwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi, kureka muunyete ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
            "verseOrgIds": [
              "RUT.1.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:20",
              "type": "text"
            },
            {
              "text": "Maara, amakuru ngu Obushaarizi.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maara; ahabw'okuba Ow'obushoboorozi bwona akankorera ebirikushaarira munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
