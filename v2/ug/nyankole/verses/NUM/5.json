              "items": [
                {
                  "text": "Isa 52:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ragiira Abaisraeli baihe omu rusiisira omubembe weena, na buri muntu orikureeta amahira, n'osiisikaire ahabw'omutumbi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.2",
            "verseOrgIds": [
              "NUM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
