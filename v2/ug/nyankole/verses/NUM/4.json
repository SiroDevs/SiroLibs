          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA yaagambira Musa na Arooni ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.17",
            "verseOrgIds": [
              "NUM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutareka omuryango gw'aba Kohasi kuhwerekyerezibwa, bakahwaho omu Baleevi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.18",
            "verseOrgIds": [
              "NUM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "oku mube nikwo mwabatwaza, babone kugumaho, barekye kufa baahika aha bintu ebirikwera munonga. Arooni n'abatabani bagume bataahemu, baragiire buri omwe omurimo gwe n'eki ashemereire kutwara; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.19",
            "verseOrgIds": [
              "NUM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
