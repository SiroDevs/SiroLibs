        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Eleazaari mwene Arooni omunyamurwa akwatsibwe amajuta g'okuhemba, n'obubaane burikutaamirana, n'empongano y'esaano y'obutoosha, n'amajuta ag'okushukaho ahabw'okushoroora; kandi akwatsibwe n'Obutaaho bwona n'ebirimu byona, n'Omwanya ogurikwera n'ebintu byaho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.16",
            "verseOrgIds": [
              "NUM.4.16"
            ]
          }
        }
      ]
    },
    {
