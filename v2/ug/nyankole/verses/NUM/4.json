                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka bataritaahamu bakareeba Aharikwera, n'obu kaakuba akaanya akarikwingana busha, batakaafa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.20",
