      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA yaagambira Musa na Arooni ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.1",
            "verseOrgIds": [
              "NUM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubare beene Kohasi, mubashoroore omu Baleevi, mubabare nk'emiryango yaabo oku eri, n'amaju ga baishenkurubo oku gari, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.2",
            "verseOrgIds": [
              "NUM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "okwiha aha bahikize emyaka makumi ashatu, abatakarengize myaka makumi ataano, boona abarikubaasa kuza omu buheereza obwo, kukora omurimo gw'Eihema ry'okubugaabuganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.3",
            "verseOrgIds": [
              "NUM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu nigwo murimo gwa beene Kohasi, ogu bashemereire kukora omu Ihema ry'okubugaabuganiramu; ogwo murimo n'ogw'ebintu birikwera munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.4",
            "verseOrgIds": [
              "NUM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'omu rusiisira ku baryenda kwimutsya orugyendo, Arooni n'abatabani bataahemu, bahanure omukingo ogukingiire Aharikwera munonga, bagushwekye eshanduukye erimu Ebirikuhamya, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.5",
            "verseOrgIds": [
              "NUM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bashwekyeho eky'okushweka ky'empu z'engongi, nakyo bakiteho omwenda gwa bururu gwonka, bwanyima bate emigamba omu bifunga byayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.6",
            "verseOrgIds": [
              "NUM.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aha meeza y'emigaati y'okumurika bateho omwenda gwa bururu, baguteho enyabya n'ebikopo n'ebakuri n'emidumo y'okushukisa empongano z'eby'okunywa; kandi emigaati y'obutoosha nayo ebeho; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.7",
            "verseOrgIds": [
              "NUM.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "babishwekye omwenda gurikutukura, nagwo baguteho eky'okushweka ky'empu z'engongi, bate emigamba omu bifunga byayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.8",
            "verseOrgIds": [
              "NUM.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi batware omwenda gwa bururu, bagushwekye ekikondo ky'etabaaza n'amatabaaza gaakyo n'empana zaakyo n'otusohaani twago, n'ebintu byakyo eby'okushukisa amajuta, ebi barikukoresa omurimo gwakyo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.9",
            "verseOrgIds": [
              "NUM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakikomerane n'ebintu byakyo byona omu ky'okushweka ky'empu z'engongi, babite aha biti by'okubiheekyesa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.10",
            "verseOrgIds": [
              "NUM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ekyoterero ky'ezaabu bakishwekye omwenda gwa bururu, baguteho eky'okushweka ky'empu z'engongi, bate emigamba omu bifunga byakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.11",
            "verseOrgIds": [
              "NUM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bareete ebintu ebi barikukoresa byona, ebiri kukoresibwa omu Mwanya ogurikwera, babikome omu mwenda gwa bururu, babishwekye eky'okushweka ky'empu z'engongi, babite aha biti by'okubiheekyesa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.12",
            "verseOrgIds": [
              "NUM.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bayoore eiju aha itambiro, bariteho omwenda gwa bujwa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.13",
            "verseOrgIds": [
              "NUM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "bariteho n'ebintu byaryo byona, ebi barikukoresa emirimo yaaryo, n'eby'okuguhisa omuriro gw'amakara n'eby'okwihuza enyama, n'eby'okuyooreraho eiju, n'eby'okuriyooresa, n'enyabya, ebintu eby'eitambiro byona; babishwekye eky'okushweka ky'empu z'engongi, bate emigamba omu bifunga byaryo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.14",
            "verseOrgIds": [
              "NUM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni n'abatabani ku bariguma baaheza kushweka eby'Omwanya ogurikwera n'ebirikukoresibwaho byona, ab'omu rusiisira baaba nibenda kwimutsya orugyendo, bwanyima beene Kohasi babone kwija kubiheeka; kwonka batarikora aha birikwera, batakaafa. Ebyo nibyo bintu by'omu Ihema ry'okubugaabuganiramu ebiriheekwa beene Kohasi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        }
      ]
    },
    {
