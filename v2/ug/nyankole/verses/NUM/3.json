          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaraagume nibateera amahema aha rubaju rw'Obutaaho orw'oburugwa-izooba, omu maisho g'Eihema ry'okubugaabuganiramu, aharikureeba ei eizooba rireetwa, ni Musa na Arooni n'abatabani, abaakwatsiibwe omurimo gw'Omwanya ogurikwera, ogurikukorwa ahabw'Abaisraeli; otari w'omuribo ku arihika haihi yaabyetaasyamu, aitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.38",
            "verseOrgIds": [
              "NUM.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaleevi boona abaabazirwe, abu Musa na Arooni baabazire ahabw'ekiragiro kya MUKAMA, nk'emiryango yaabo oku eri, abeetwa abashaija boona okwiha aha beereere abahikize okwezi kumwe, bakaba bari obukumi bubiri n'enkumi ibiri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 3:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA yaaragiira Musa ati: Bara abeetwa abashaija boona ab'emijigaijo omu Baisraeli okwiha aha beereere abahikize okwezi kumwe, ohandiikye omubaro gw'amaziina gaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.40",
            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 3:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ontooranire Abaleevi niinye MUKAMA omu mwanya gw'emijigaijo yoona ey'Abaisraeli; ompe n'amatungo g'Abaleevi omu mwanya gw'emijigaijo yoona ey'amatungo g'Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 3:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaabara emijigaijo yoona ey'Abaisraeli, nk'oku MUKAMA yaamuragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.42",
            "verseOrgIds": [
              "NUM.3.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeetwa abashaija boona ab'emijigaijo okwiha aha beereere abahikize okwezi, omubaro gw'amaziina gaabo gwaba obukumi bubiri n'enkumi ibiri na magana abiri na makumi mushanju na bashatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
        }
      ]
    },
    {
