              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " muryaguma mubiriire ahu murikwenda hoona, imwe n'ab'omu maka gaanyu; ahabw'okuba n'ebihembo byanyu ebi murikuheebwa ahabw'omurimo gwanyu ogu murikukora omu Ihema ry'okubugaabuganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.31",
            "verseOrgIds": [
              "NUM.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi timurigira rubanja rw'ekibi ahabwabyo, ku muriheza kubiihaho ebirikukira oburungi, mwabihonga; kandi mutarishiisha ebintu by'Abaisraeli ebirikwera, mukafa.",
          "type": "text",
