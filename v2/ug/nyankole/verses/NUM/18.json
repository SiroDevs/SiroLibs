        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.20",
            "verseOrgIds": [
              "NUM.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
