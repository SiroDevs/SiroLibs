              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
