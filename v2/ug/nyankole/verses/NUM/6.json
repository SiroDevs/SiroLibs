              "NUM.6.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.1.11"
              },
              "items": [
                {
                  "text": "1 Sam 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebiro byona ebi arimara omu bunaziiri, orumweiso rutarimuraba aha mutwe; aryaba orikwera, arekye obutsibo bw'eishokye rye bukure, okuhitsya obu ebiro by'okweshoroora kwe ahari MUKAMA birihwaho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro byona eby'okweshoroora kwe ahari MUKAMA atarihika aha mutumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe nari nyina nari mwene nyina nari munyaanya, ku arifa, ataryeshiisha ahabw'orufu rwabo, ahabw'okuba okweshoroora kwe ahari Ruhanga kuri aha mutwe gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.7",
            "verseOrgIds": [
              "NUM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro byona ebi arimara omu bunaziiri aryaba oyereziibwe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku harigira omuntu yaamukinukira aha rubaju, yaashiisha omutwe gw'obunaziiri bwe, aryamwa eishokye rye aha izooba ry'okushemezibwa kwe; aha kiro kya mushanju niho aririmwera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.9",
            "verseOrgIds": [
              "NUM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aha kiro kya munana aryareeta obwiba bubiri nari enkombe nto ibiri, abiheere omunyamurwa aha muryango gw'Eihema ry'okubugaabuganiramu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.10",
            "verseOrgIds": [
              "NUM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "omunyamurwa ahongyeho emwe kuba ekitambo ky'ekibi, n'endi okuba ekitambo eky'okwotsya, amurihiirire, ahabw'okuba asiisire ahabw'omufu. Bwanyima ahari eryo izooba ayeze omutwe gwe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.11",
            "verseOrgIds": [
              "NUM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayeshoroore ahari MUKAMA okumara ebiro byona eby'obunaziiri bwe, areete empaya nto y'entaama ehikize omwaka kuba ekitambo ky'okwihaho orubanja; ahakuba ebiro bye eby'okubanza biryaba bifiire busha, ahabw'okuba obunaziiri bwe busiisikaire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
