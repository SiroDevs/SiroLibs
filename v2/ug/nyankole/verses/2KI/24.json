                "loc": "2KI.21.16"
              },
              "items": [
                {
                  "text": "2 Bag 21:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi n'eshagama y'abataine rubanja ei yaaseesire; ahabw'okuba akagiijuza Yerusaalemu, na'ahabw'ekyo MUKAMA yaayanga kubimusaasira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 24:5"
          },
          "items": [
