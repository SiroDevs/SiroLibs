            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yehoyakimu yaagwejegyera, yaashanga baishenkuru, Yehoyakiini omutabani yaategyeka omu mwanya gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
