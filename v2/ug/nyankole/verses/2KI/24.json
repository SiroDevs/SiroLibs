            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaamwoherereza emtwe y'engabo z'Abakaludaaya, n'ez'Abasiria, n'ez'Abamoabu kandi n'ez'Abaamoni, ngu bateere Yuda bagicwekyereze, nk'oku MUKAMA yaagambire naaraba omu bairu be baanabi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 24:3"
          },
