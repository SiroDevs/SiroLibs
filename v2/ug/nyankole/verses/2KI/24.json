            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu endiijo mirimo ya Yehoyakimu n'ebi yaakozire byona tibihandiikirwe omu kitabo ky'eby'omu busingye bw'abagabe ba Yuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
