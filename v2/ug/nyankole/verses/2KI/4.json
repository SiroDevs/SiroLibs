          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.20+1KI.17.21+1KI.17.22+1KI.17.23"
              },
              "items": [
                {
                  "text": "1 Bag 17:20-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.6"
              },
              "items": [
                {
                  "text": "Mat 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.25"
              },
              "items": [
                {
                  "text": "9:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo yaataahamu, yaayekingiranamu n'omwana, yaashaba MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.33",
            "verseOrgIds": [
              "2KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaaza aha kitanda, yaayegororera aha mwana, yaata omunwa aha munwa gwe, n'amaisho aha maisho ge, n'engaro aha ngaro ze; ku yaamwegororeireho, omubiri gw'omwana gwatandika kutagata. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.34",
            "verseOrgIds": [
              "2KI.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.10"
              },
              "items": [
                {
                  "text": "Byak 20:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagaruka yaimuka, yaagyendagyendaho omu nju rimwe, yaagaruka yaaza aha kitanda, yaamwegororeraho, omwana yaayetsyamura emirundi mushanju, yaabuuruura amaisho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.35",
            "verseOrgIds": [
              "2KI.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaayeta Gehazi, yaamugira ati: Yeta ogwo mukazi wa Shuneemu. Atyo yaamweta. Ku yaamuhikire, yaagira ati: Ihaho omwana waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.36",
            "verseOrgIds": [
              "2KI.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.1+2KI.8.2+2KI.8.3+2KI.8.4+2KI.8.5+2KI.8.6"
              },
              "items": [
                {
                  "text": "2 Bag 8:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.35"
              },
              "items": [
                {
                  "text": "Heb 11:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaija, yaagwa aha bigyere bye, yaajuumara ahansi, yaihaho omwana we, yaashohora.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.37",
            "verseOrgIds": [
              "2KI.4.37"
            ]
          }
        }
      ]
