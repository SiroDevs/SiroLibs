              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.37",
            "verseOrgIds": [
              "2KI.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Elisa yaagaruka Gilugaali; kandi hakaba hatereyo enjara. Abaana ba baanabi ku baabaire bamushutami omu maisho, yaagira omuheereza we ati: Ta enyungu mpango aha mahega, oteekyere abaana ba baanabi ekicumbe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.38",
            "verseOrgIds": [
              "2KI.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwe aharibo yaaza omu ishwa kushoroma emboga, yaashangayo omutanga, yaagushoromaho entanga, yaaziijuza omwenda gwe, yaija, yaazikyeka, yaazita omu nyungu eri ey'ekicumbe, atazimanyire. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.39",
            "verseOrgIds": [
              "2KI.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo baihura kugaburira abantu. Kwonka ku baabaire nibarya ekyo kicumbe, baagamba munonga nibagira bati: Ai bambe, mushaija wa Ruhanga, omu nyungu harimu rufu. Tibaabaawsa kukirya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.40",
            "verseOrgIds": [
              "2KI.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.21"
              },
              "items": [
                {
                  "text": "2 Bag 2:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elisa yaagira ati: Mureete esaano. Yaaginaga omu nyungu, yaagira ati: Mwihurire abantu, barye. Baashanga omu nyungu hatakirimu kabi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.41",
            "verseOrgIds": [
              "2KI.4.41"
            ]
          }
        }
      ]
    },
