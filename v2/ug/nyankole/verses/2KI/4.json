                {
                  "text": "Kub 28:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iba ati: Ekirikukuhuuta owe eri izooba niki? Okwezi tikukabonekire, kandi ti sabato. Onu ati: Ni kirungi nzeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.23",
            "verseOrgIds": [
              "2KI.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo yaatandiika endogoya, yaagira omwambari we ati: Irukanzya endogoya; oteetwara ntakugambiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.24",
            "verseOrgIds": [
              "2KI.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.25"
              },
              "items": [
                {
                  "text": "2 Bag 2:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo yaagyenda yaahika aha mushaija wa Ruhanga aha kibungo Karumeeli. Ogwo mushaija wa Ruhanga ku yaamureebeire hare naakiija, yaagira Gehazi omuheereza we ati: Reeba, oriya ga n'omukazi ori owa Shuneemu; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.25",
            "verseOrgIds": [
              "2KI.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "gyenda noiruka, omubugane, omubuuze oti: ni buhooro? Baro ari buhooro? N'omwana waawe ari buhooro? Omukazi yaamugarukamu ati: Ni buhooro. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.26",
            "verseOrgIds": [
              "2KI.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaahikire aha mushaija wa Ruhanga omu kibungo, yaayaija kumutsindika. Kwonka omushaija wa Ruhanga yaagira ati: Mrekye, ahakuba omutima gwe gwine enaku nyingi; kandi MUKAMA akinsherekire, tiyaakingambira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.27",
            "verseOrgIds": [
              "2KI.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi yaamugira ati: Niinye naashabire mukama wangye omwana w'omwojo? Tindakugizire nti: Otambeiha? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.28",
            "verseOrgIds": [
              "2KI.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.19"
              },
              "items": [
                {
                  "text": "Kur 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.16"
              },
              "items": [
                {
                  "text": "14:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.4"
              },
              "items": [
                {
                  "text": "Luk 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.12"
              },
              "items": [
                {
                  "text": "Byak 19:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elisa yaagira Gehazi ati: Yezirikye, otware enkoni yangye, ogyende. Ku oraabugane omuntu, otamuramutsya; kandi ku haraagire owaakuramutsya, owetsize; orambikye egi nkono aha maisho g'omwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.29",
            "verseOrgIds": [
              "2KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyina w'omwana yaamugira ati: Nindahira MUKAMA, kandi ninkurahira, tindikwija kukutsiga aha. Atyo yaimuka, yaamukuratira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.30",
            "verseOrgIds": [
              "2KI.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.11"
              },
              "items": [
                {
                  "text": "Yoh 11:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gehazi yaagyenda abeebembeire, yaarambika egyo nkoni aha maisho g'omwana; tihaabaho kateezo n'obu kwakuba okwetengyetsa. Nikyo yaagarukiireyo kumubugana, akamugira ati: omwana tiyaahimbuuka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.31",
            "verseOrgIds": [
              "2KI.4.31"
            ]
          }
        }
      ]
    },
    {
