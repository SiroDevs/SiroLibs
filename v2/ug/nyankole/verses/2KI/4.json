          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa ku yaatahire omu nju, yaareeba omwana abyami aha kitanda kye afiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.32",
            "verseOrgIds": [
              "2KI.4.32"
            ]
          }
        },
        {
