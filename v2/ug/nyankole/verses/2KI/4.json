                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.4"
              },
              "items": [
                {
                  "text": "8:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagira Gehazi omuheereza we ati: Nyetera ogwo mukazi wa Shuneemu. Ku yaamwetsire, yaayemerera omu maisho ge. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.12",
            "verseOrgIds": [
              "2KI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa yaagira Gehazi ati: Mugire oti: Mbwenu, obu otufeereire kubi oti, tukaakukorera ki? Nooyenda ku tugira eki twakugambirira omugabe, nari omukuru w'amahe? Ogwo mukazi yaagarukamu ati: Ngaaha! Ndi omu baitu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.13",
            "verseOrgIds": [
              "2KI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa yaabuuza ati: Mbwenu shi, ekindi tumukorere ki? Gehazi yaagarukamu ati: Manya taine mwana w'omwojo, kandi na iba n'omugurusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.14",
            "verseOrgIds": [
              "2KI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa yaagira ati: Mwete. Ku yaamwetsire, ogwo mukazi yaayemerera omu muryango. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.15",
            "verseOrgIds": [
              "2KI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.14"
              },
              "items": [
                {
                  "text": "Kut 18:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elisa yaamugira ati: Omu bunaku nk'obu omu mwaka ogurikwija oryakiikira omwana w'omwojo. Onu ati: Ngaaha, mukama wangye, iwe mushaija wa Ruhanga 'we, reka kubeiha omuzaana waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.16",
            "verseOrgIds": [
              "2KI.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ogwo mukazi yaabaka enda, yaazaara omwana w'omwojo omu bunaku nk'obwo omu kutandika kw'omwaka, nk'oku Elisa yaamugambiire.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.17",
            "verseOrgIds": [
              "2KI.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.17",
            "verseOrgIds": [
              "2KI.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwo mwana ku yaakuzire, eizooba rimwe yaaza kureeba ishe omu bagyesi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.18",
            "verseOrgIds": [
              "2KI.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagira ishe ati: Ai bambe! Omutwe gwanyita! Omutwe gwanyita! Ishe yaagira omuhuuku we ati: Mutwarire nyina. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.19",
            "verseOrgIds": [
              "2KI.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaamuheekire, yaamutwarira nyina, omwana yaamushutama aha bibero okuhitsya omu ihangwe, yaakaba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.20",
            "verseOrgIds": [
              "2KI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyina yainamuka, yaamurambika aha kitanda ky'omushaija wa Ruhanga, yaamukingirana, yaashohora. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.21",
            "verseOrgIds": [
              "2KI.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaayeta iba, yaamugira ati: Nyoherereza omwe aha bambari baawe, n'endogoya emwe, ngyende ahonaaho nze ow'omushaija wa Ruhanga, ngarukye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.22",
            "verseOrgIds": [
              "2KI.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
