              "2KI.4.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.3"
              },
              "items": [
                {
                  "text": "1 Sam 25:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eizooba rimwe Elisa akaimuka, yaaza Shuneemu, ei omukazi omutungi yaabaire atwire; omukazi ogwo yaamugyemesereza kurya eby'okurya. Okwiha obwo, ku yaabaire arabayo, ahungukayo kurya ak'okurya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.8",
            "verseOrgIds": [
              "2KI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwo mukazi yaagira iba ati: Mbwenu nyetegyereize ogu mushaija orikuturabaho obutoosha ku ari omushaija orikwera wa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.9",
            "verseOrgIds": [
              "2KI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka tumwombekyere akashengye kakye aha mutwe gw'enju, tumuteeremu ekitanda, emeeza, entebe n'etabaaza; ku araagume yaatuhungukaho, abe nimwo yaaza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.10",
            "verseOrgIds": [
              "2KI.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.10",
            "verseOrgIds": [
              "2KI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizooba rimwe akahungukayo, yaaza omuri ako kashengye, yaahuumuiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.11",
            "verseOrgIds": [
              "2KI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
