        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.31",
            "verseOrgIds": [
              "2KI.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
