          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ebyo byona mbikora ahabw'engiri, ngu ntungye aha migisha yaayo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.23",
            "verseOrgIds": [
