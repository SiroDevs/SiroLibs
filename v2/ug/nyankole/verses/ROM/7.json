  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "ROM 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "B'eishe-emwe, timurikumanya ku Ebiragiro bitegyeka omuntu, akiriho? (Ningambira abarikumanya Ebiragiro.) ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.1",
            "verseOrgIds": [
              "ROM.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimumanya ngu omukazi oine iba, ekiragiro kimutegyeka kuguma na iba, akiriho; kandi iba ku afa, aba atakitegyekwa kiragiro kya iba. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.2",
            "verseOrgIds": [
              "ROM.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku ashwerwa ondiijo mushaija, iba akiriho, ayetwa omushambani; kwonka iba ku afa, aba atakitegyekwa ekyo kiragiro; n'ahabw'ekyo ku ashwerwa omushaija ondiijo, tayetwa mushambani.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.3",
            "verseOrgIds": [
              "ROM.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.3",
            "verseOrgIds": [
              "ROM.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo kimwe, B'eishe-emwe, mukafa aha Biragiro ahabw'okufeera hamwe na Kristo omu mubiri gwe, ngu mubone kuba ab'ondiijo owaazoirwe omu bafu, ngu twanire Ruhanga ebyana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.4",
            "verseOrgIds": [
              "ROM.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku twabaire tukiri omu buzaarwa bw'omubiri, okwetenga ebibi kwaitu, okwaimukiibwe Ebiragiro, kukakorera omu ngingo zaitu ngu twanire okufa ebyana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.5",
            "verseOrgIds": [
              "ROM.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.1"
              },
              "items": [
                {
                  "text": "Rom 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka hati tukomoroirwe, titwakitegyekwa Biragiro ahabw'okufa ahari ekyo ekyabaire kitukwatsire, ngu tubone kuheereza omu buhuuku busya obw'Omwoyo, butari bwa ira obw'ebihandiiko.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.6",
            "verseOrgIds": [
              "ROM.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.6",
            "verseOrgIds": [
              "ROM.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.7",
            "verseOrgIds": [
              "ROM.7.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.14"
              },
              "items": [
                {
                  "text": "Kur 20:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu tugambe ki? Tuti: Ebiragiro nikyo kibi? Ngaaha! Tinkumanyire kibi, kuri ntarakimanyisiibwe Biragiro; ahakuba tinkumanyire kwetenga, kuri Ebiragiro bitaragizire biti: Otaryetenga. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.7",
            "verseOrgIds": [
              "ROM.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ekibi, ku kyaboine obwiho omu Biragiro, kyaimutsya omuriinye emiringo yoona ey'okwetenga; ahakuba ahatari Biragiro, ekibi kiba kifiire. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.8",
            "verseOrgIds": [
              "ROM.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanye ira nkaba ndi ohuriire ahatari Biragiro; kwonka Ekiragiro, ku kyaizire, ekibi kyahimbuuka, nyowe naafa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.9",
            "verseOrgIds": [
              "ROM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.15"
              },
              "items": [
                {
                  "text": "Yak 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Lev 18:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekiragiro, ekyakubaire eky'okumpa amagara, nkashanga kindugiiremu okufa; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.10",
            "verseOrgIds": [
              "ROM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.13"
              },
              "items": [
                {
                  "text": "Heb 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba ekibi, ku kyaboine obwiho omu kiragiro, kyangobeza, kyanyita nikyema omuri ekyo kiragiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.11",
            "verseOrgIds": [
              "ROM.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu Ebiragiro nibyera, n'ekiragiro nikyera, kihikire, kandi ni kirungi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.12",
            "verseOrgIds": [
              "ROM.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.12",
            "verseOrgIds": [
              "ROM.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimugira ngu ekirungi nikyo kyandeeteire okufa? Ngaaha! Ekyakundeeteire n'ekibi; kikaanyitsa ekirungi, ngu ekibi kimanywe ku kiri kibi, kandi ahabw'Ebiragiro kihindukye kibi buzima ekirengyesereize. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.13",
            "verseOrgIds": [
              "ROM.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.6"
              },
              "items": [
                {
                  "text": "Yoh 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka nitumanya ngu Ebiragiro n'eby'Omwoyo; kwonka nyowe ndi ow'obuzaarwa bw'obuntu, nkagurwa kutegyekwa ekibi; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.14",
            "verseOrgIds": [
              "ROM.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "eki nkora, tinkimanya; ahabw'okuba eki nkunda kukora tikyo nkora; kureka eki nyanga nikyo nkora. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.15",
            "verseOrgIds": [
              "ROM.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu ku ndaabe nkora eki ntenda, biri niinyikiriza ngu Ebiragiro ni birungi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.16",
            "verseOrgIds": [
              "ROM.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo tiinye nkikora, kureka ekibi ekituura omuriinye. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.17",
            "verseOrgIds": [
              "ROM.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.5"
              },
              "items": [
                {
                  "text": "Kut 6:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimmanya ngu omuriinye omu buntu bwangye tihabamu karungi koona; ahakuba obutoosha nkunda kukora ekirungi, kwonka okukikora kundema. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.18",
            "verseOrgIds": [
              "ROM.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekirungi eki nkunda kukora tikyo nkora; kureka ekibi eki nyanga nikyo nkora. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.19",
            "verseOrgIds": [
              "ROM.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo ku ndaabe nkora eki ntenda, tiinye nkikora, kureka ekibi ekintuuramu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.20",
            "verseOrgIds": [
              "ROM.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.20",
            "verseOrgIds": [
              "ROM.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo nshangire ebiragiro biri biti, nyowe ku mba niinyenda kukora ekirungi, ekibi kimba haihi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.21",
            "verseOrgIds": [
              "ROM.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mutima gwangye nsiima ebiragiro bya Ruhanga; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.22",
            "verseOrgIds": [
              "ROM.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.17"
              },
              "items": [
                {
                  "text": "Gal 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka omu ngingo zangye nshangamu ekindi kiragiro ekirwanisa ekiragiro eky'omu bwengye bwangye, kimpindura omuhuuku w'ebiragiro by'ekibi ebiri omu ngingo zangye. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.23",
            "verseOrgIds": [
              "ROM.7.23"
            ]
          }
        },
        {
          "name": "verse",
