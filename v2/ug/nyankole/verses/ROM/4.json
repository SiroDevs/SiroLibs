  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ROM 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku biraabe biri bityo, tugambe ki ahari Abrahamu, tatenkuriitwe omu mubiri, eki yaareebire? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.1",
            "verseOrgIds": [
              "ROM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabw'okuba Abrahamu, kuri yaihirweho orubanja ahabw'emirimo, akaagizire eky'okwehimbisizaho, kwonka takiine ahari Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.2",
            "verseOrgIds": [
              "ROM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.6"
              },
              "items": [
                {
                  "text": "Kut 15:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyahandiikirwe nibigira bita? Biti: Abrahamu akaikiriza Ruhanga, kyamubarirwa okuba okuhikiirira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.3",
            "verseOrgIds": [
              "ROM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.6"
              },
              "items": [
                {
                  "text": "Rom 11:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimumanya ngu, okora omurimo, ebihembo bye tibibarwa nk'ekiconco kureka nk'enyihurano. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.4",
            "verseOrgIds": [
              "ROM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka otakora mirimo, akaikiriza Ogwo oiha orubanja aha batatiina Ruhanga, okwikiriza kwe kumubarirwa okuba okuhikiirira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.5",
            "verseOrgIds": [
              "ROM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'oku Daudi nawe yaagambire aha mugisha oguheebwa omuntu ou Ruhanga abarira okuhikiirira, okutari habw'okukora emirimo, ati:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.6",
            "verseOrgIds": [
              "ROM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo okuhikiirira kuruga omu kwikiriza, ngu ebyaraganisiibwe ebyo bibone kwegamira embabazi, kandi bihamibwe aha baijukuru boona, t'abarikwesiga Biragiro bonka, kureka nabo abarikugyendera omu kwikiriza kwa Abrahamu; ahabw'okuba niwe tatenkuriitwe twena; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.16",
            "verseOrgIds": [
              "ROM.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.5"
              },
              "items": [
                {
                  "text": "Kut 17:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nk'oku kyahandiikirwe ngu: Nkakugira ishenkuru w'amahanga maingi omu maisho g'Ogwo ou yaikiriize, niwe Ruhanga ozoora abafu, kandi oyeta ebitariho nk'ebiriho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.17",
            "verseOrgIds": [
              "ROM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu ogwo akaikiriza, yaagira amatsiko omu bunaku obu yaakugahwereiremu, ngu aryaba ishenkuru w'amahanga maingi, nk'oku kyagambirwe ngu: Abaijukuru nikwo bariba batyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.18",
            "verseOrgIds": [
              "ROM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'obu araabe yaareebire omubiri gwe nigushusha nk'ogufiire ahabw'okumara emyaka y'obukuru nka igana, akareeba na Saara yaabaire ekicura atakibaasa kuzaara, okwikiriza kwe tikuratentebukire; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.19",
            "verseOrgIds": [
              "ROM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.11"
              },
              "items": [
                {
                  "text": "Heb 11:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka, ku yaataire amaisho aha bi Ruhanga yaaraganiise, tiyaabanganisisibwa kutaikiriza, kureka yaagumibwa okwikiriza, yaahimbisa Ruhanga; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.20",
            "verseOrgIds": [
              "ROM.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi yaamanyira kimwe ngu eki Ruhanga yaaraganiise, naabaasa kukikora. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.21",
            "verseOrgIds": [
              "ROM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo okwikiriza kwe kwamubariirwe okuba okuhikiirira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.22",
            "verseOrgIds": [
              "ROM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikiramuhandiikiirwe wenka, ngu kikamubarirwa okuba okuhikiirira, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.23",
            "verseOrgIds": [
              "ROM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kureka ahabwaitu naitwe abaribarirwa okuhikiirira, itwe abarikwikiriza Ogwo owaazoire Yesu Mukama waitu omu bafu; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.24",
            "verseOrgIds": [
              "ROM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.5"
              },
              "items": [
                {
                  "text": "Isa 53:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.17"
              },
              "items": [
                {
                  "text": "1 Kor 15:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " niwe yaahairweyo ahabw'eby'okushiisha byaitu, kandi akazoorwa kutwihaho orubanja.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.25",
            "verseOrgIds": [
              "ROM.4.25"
            ]
          }
        }
      ]
    }
