            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.19.4"
              },
              "items": [
                {
                  "text": "Zab 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Beitu nimbuuza nti: Tibarahuriire? Eego, buzima bakahurira; ahakuba",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
