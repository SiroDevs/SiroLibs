            "verseOrgIds": [
              "ROM.12.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.5"
              },
              "items": [
                {
                  "text": "1 Pet 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo, B'eishe-emwe, nimbeeshengyereza ahabw'embabazi za Ruhanga, ku muhayo embiri yaanyu kuba ebitambo ebihuriire, ebirikwera, kandi ebirikusiima Ruhanga, nikwo kuheereza kwanyu oku mushemereire kumuha. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.1",
            "verseOrgIds": [
              "ROM.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.17"
              },
              "items": [
                {
                  "text": "Efe 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi mutashushanisibwa n'ab'obusingye obu, kureka muhindurwe basya ahabw'okugarurwa obusya omu biteekateeko byanyu, mubone kumanya gye ebi Ruhanga akunda, oku biri birungi, ebirikusiimwa, kandi ebihikire buzima.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
