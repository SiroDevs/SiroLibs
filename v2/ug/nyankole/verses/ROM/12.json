        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.44"
              },
              "items": [
                {
                  "text": "Mat 5:44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.59"
              },
              "items": [
                {
                  "text": "Byak 7:59",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.12"
              },
              "items": [
                {
                  "text": "1 Kor 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mushabire omugisha abarikubahiiga; mubashabire omugisha, mutabakyeena. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.14",
            "verseOrgIds": [
              "ROM.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushemererwe hamwe n'abarikushemererwa; murire hamwe n'abarikurira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.15",
            "verseOrgIds": [
              "ROM.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.21"
              },
              "items": [
                {
                  "text": "Isa 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mugire omutima gumwe omu bi murikuteekateekanaho; mutata omutima aha by'ekitiinisa, kureka mugyende hamwe n'abataine kitiinisa. Muteemanya ku muri abanyabwengye. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.16",
            "verseOrgIds": [
              "ROM.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.15"
              },
              "items": [
                {
                  "text": "1 Tes 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutaihura omuntu weena ekibi ahabw'ekibi; mwerinde, ebi murikukora bireebekye bihikire omu maisho g'abantu boona. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.17",
            "verseOrgIds": [
              "ROM.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 12:18"
          },
