              "1SA.4.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.6"
              },
              "items": [
                {
                  "text": "Yos 7:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.32"
              },
              "items": [
                {
                  "text": "2 Sam 15:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.1"
              },
              "items": [
                {
                  "text": "Neh 9:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omushaija Omubenyamiini yaacwa omu ngabo, yaahika Shiilo eryo izooba, ebijwaro bye bitaagukire, n'eitaka rimuri omu mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.12",
            "verseOrgIds": [
              "1SA.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.1.9"
              },
              "items": [
                {
                  "text": "1 Sam 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obu yaija, Eli akaba ashutami aha kitebe kye aha rubaju rw'omuhanda, ataireyo amaisho; ahakuba omutima gukaba gumuhweire omunda ahabw'eshanduukye ya Ruhanga. Ogwo mushaija ku yaahikire omu rurembo, yaabagambira ebibaireho; ab'omu rurembo boona baayeha ekiboroogo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.13",
            "verseOrgIds": [
              "1SA.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli ku yaahuriire okwo kuborooga, yaabuuza ati: Okwo kujagarara n'okw'enki? Ogwo mushaija yaija naayehuuta, yaabimugambira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.14",
            "verseOrgIds": [
              "1SA.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo Eli akaba ahikize emyaka makumi mwenda na munaana; amaisho ge gaahumire, atakihweza. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.15",
            "verseOrgIds": [
              "1SA.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.1.4"
              },
              "items": [
                {
                  "text": "2 Sam 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo mushaija yaagira Eli ati: Niinye ogwo owaaruga omu rugamba eri izooba, naacwa omu ngabo. Onu yaamubuuza ati: Bibaire bita, mwana wangye? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwo owaareeta amakuru yaamugarukamu ati: Abaisraeli baahunga Abafilistia, haabaho okwitwa kw'abantu baingi, batabani baawe bombi, Hofuni na Finehaasi, baafa; kandi eshanduukye ya Ruhanga yaanyagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.17",
            "verseOrgIds": [
              "1SA.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaagambire eby'eshanduukye ya Ruhanga, Eli yaaruga aha kitebe kye, yaagwa agarami aha kiti ky'omuryango, yaahendeka ebitsya, yaafa; ahakuba akaba ari omugurusi, orikweremeera. Kandi akaba amazire emyaka makumi ana naacwera Abaisraeli emanja.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo mukaamwana wa Eli, muka Finehaasi, akaba aine enda ari haihi kuzaara; ku yaahuriire enkuru ngu eshanduukye ya Ruhanga enyagirwe, kandi ngu ishezaara na iba baafa, yaafukama, yaazaara, ahakuba ebisha bikamukwatira aho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.19",
            "verseOrgIds": [
              "1SA.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
