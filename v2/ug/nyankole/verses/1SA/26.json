              "items": [
                {
                  "text": "Kut 32:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Saulo yaagira Daudi ati: Oheebwe omugisha, mwana wangye Daudi; oryakora bikuru, kandi n'okusingura oryasingura. Atyo Daudi yaayegyendera, Saulo nawe yaagaruka owe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
