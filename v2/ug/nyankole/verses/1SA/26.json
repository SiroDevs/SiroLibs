              },
              "items": [
                {
                  "text": "2 Sam 14:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu ninkweshengyereza, Nyakusinga omugabe, hurira ebigambo by'omwiru waawe. MUKAMA ku araabe niwe anteeraine naiwe, aikirize empongano; kwonka ku baraabe bari abantu, bakyeenwe omu maisho ga MUKAMA, ahakuba eri izooba bambinga ngu ntagira omugabo omu buhunguzi bwa MUKAMA, nibagira bati: Irooko oheereze baaruhanga abandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.19",
            "verseOrgIds": [
              "1SA.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo hati otaikiriza eshagama yangye kugwa ahansi, ahu MUKAMA atari; ahabw'okuba omugabe wa Israeli aizire kusherura omura, nk'ohiigire endahi omu bibungo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
        }
      ]
