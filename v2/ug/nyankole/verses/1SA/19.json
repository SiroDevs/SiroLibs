                "loc": "PRO.27.4"
              },
              "items": [
                {
                  "text": "Enf 27:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Saulo yaagambira omutabani Yonasaani n'abagaragwa be boona kwita Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.1",
            "verseOrgIds": [
              "1SA.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Yonasaani mwene Saulo akaba naakunda Daudi munonga; mbwenu Yonasaani yaagira Daudi ati: Tata Saulo naayenda kukwita; n'ahabw'ekyo omu kasheeshe oyerinde, oyesherekye omu mwanya gwekiikire, ogumeyo; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.2",
            "verseOrgIds": [
              "1SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "naanye niinyija kushohora, nyemerere aha rubaju rwa taata omu ishwa ahu oraabe ori, ngaaniire nawe aha byawe; ku ndaagire eki naareeba, niinyija kukikugambira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.3",
            "verseOrgIds": [
              "1SA.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.109.5"
              },
              "items": [
                {
                  "text": "Zab 109:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.17.13"
              },
              "items": [
                {
                  "text": "Enf 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku bwaseesire, Yonasaani yaagamba gye Daudi ahari Saulo ishe, naamugira ati: Nyakusinga, otakora ekibi aha mwiru waawe Daudi, ahabw'okuba takakucumurahoga, kureka ebi akukorera byona ni birungi; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.4",
            "verseOrgIds": [
              "1SA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.12.3"
              },
              "items": [
                {
                  "text": "Bar 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.20.32"
              },
              "items": [
                {
                  "text": "1 Sam 20:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba akooga amagara, yaita Omufilistia, MUKAMA yaaha Abaisraeli boona obusinguzi buhango. Naiwe okakireeba, waakishemerererwa. Mbwenu ahabw'enki nooyenda kukora kubi kusheesha eshagama y'otaine rubanja, kwitira Daudi busha? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.5",
            "verseOrgIds": [
              "1SA.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo yaahurira ebi Yonasaani yaamugambira, yaarahira naagira ati: Nindahira MUKAMA otahwaho, tariitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.6",
            "verseOrgIds": [
              "1SA.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonasaani yaayeta Daudi, yaamugambira ebyo byona; bwanyima Yonasaani yaagarura Daudi ahari Saulo, yaaguma omu maisho ge nk'obunyakare.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.7",
            "verseOrgIds": [
              "1SA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.7",
            "verseOrgIds": [
              "1SA.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haagaruka haabaho obweme; Daudi yaahurura, yaarwanisa Abafilistia, yaabaitamu abantu baingi munonga; baamuhunga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.8",
            "verseOrgIds": [
              "1SA.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.10"
              },
              "items": [
                {
                  "text": "1 Sam 18:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eizooba rimwe Saulo akaba ashutami omu nju ye, aine eicumu omu ngaro, Daudi naamuteerera enanga; omwoyo mubi ogwarugire ahari MUKAMA gwamwijaho; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.9",
            "verseOrgIds": [
              "1SA.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo yaateeraho kucumita Daudi eicumu, ngu rimuhamize aha kisiika; kwonka Daudi yaaryeshumba, ryacumita ekisiika; Daudi yaacwa, yaahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.10",
            "verseOrgIds": [
              "1SA.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kiro Saulo yaatuma entumwa owa Daudi kuraara bamugwereire, ngu bamwite omu kasheeshe; Mikaali muka Daudi yaamugambira naagira ati: Ku oraabe otakirize magara gaawe eki kiro, nyencakare noija kwitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.11",
            "verseOrgIds": [
              "1SA.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.15"
              },
              "items": [
                {
                  "text": "Yos 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.24"
              },
              "items": [
                {
                  "text": "Byak 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.32"
              },
              "items": [
                {
                  "text": "2 Kor 11:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Mikaali yaarabya Daudi omu dirisa, yaacwa, yaahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.12",
            "verseOrgIds": [
              "1SA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaali yaiha ekishushani kya teraafi omu mwanya gwakyo, yaakita aha kitanda, yaakishegura omushego gw'obwoshe bw'embuzi, yaakishweka emyenda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.13",
            "verseOrgIds": [
              "1SA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo ku yaatumire entumwa kukwata Daudi, Mikaali yaagira ati: Arwaire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.14",
            "verseOrgIds": [
              "1SA.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaagaruka yaatuma entumwa kureeba Daudi, naagira ati: Mumuheekye aha kitanda, mumundeetere, mmwite. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.15",
            "verseOrgIds": [
              "1SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entumwa ku zaataahire omu nju, zaashanga ekishushani kya teraafi omu kitanda kishegwire omushego gw'obwoshe bw'embuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.16",
            "verseOrgIds": [
              "1SA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo ku yaabimanyire, yaagira Mikaali ati: Ombeihiire ki otyo, okareka omuzigu wangye, akacwa, akagyenda. Mikaali yaagarukamu Saulo ati: Angizire ati: Reka ngyende; mbwenu nkwitire ki?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaacwa, yaahunga, yaashanga Samueli Raama, yaamuteekyerereza oku Saulo amugizire kwona. Yaimuka na Samueli, baaza Nayosi, baagumayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.18",
            "verseOrgIds": [
              "1SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima baagambira Saulo ku Daudi ari Nayosi omuri Raama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.19",
            "verseOrgIds": [
              "1SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.32"
              },
              "items": [
                {
                  "text": "Yoh 7:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.45"
              },
              "items": [
                {
                  "text": "45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.5"
              },
              "items": [
                {
                  "text": "1 Sam 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Saulo yaatuma entumwa kukwata Daudi; ku zaareebire omutwe gwa baanabi nibaragura, na Samueli ayemereire aho nk'omukuru waabo, Omwoyo wa Ruhanga yaaza aha ntumwa za Saulo, nazo zaaragura. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.20",
            "verseOrgIds": [
              "1SA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baakigambiire Saulo, yaatuma ezindi ntumwa, nazo zaaragura. Yaagaruka yaatuma ezindi obwa kashatu, nazo zaaragura. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.21",
            "verseOrgIds": [
              "1SA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaayeimukira, yaaza Raama, yaahika aha iziba rihango rya Seeku, yaabuuza ati: Samueli na Daudi barahi? Baamugarukamu bati: Reeba, bari Nayosi omuri Raama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.22",
            "verseOrgIds": [
              "1SA.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
