        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.8",
            "verseOrgIds": [
              "JOS.13.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Kub 32:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abareubeeni n'Abagaadi n'ekindi kicweka ky'oruganda rwa Manaase bakaba bahairwe obuhunguzi bwabo seeri ya Yorudani aha rubaju rw'oburugwa-izooba, nka Musa omugaragwa wa MUKAMA oku yaabubahaire; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.8",
            "verseOrgIds": [
              "JOS.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuruga Aroeri eri aha rubaju rw'oruhanga rwa Arunooni, n'orurembo oruri ahagati y'orwo ruhanga, n'omurambi gwona ogwa Medeba okuhika Diboni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.9",
            "verseOrgIds": [
              "JOS.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'endembo zoona eza Sihooni omugabe w'Abaamoni owaategyekyeire Heshibooni, okuhika aha mwatano gw'Abaamoni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.10",
            "verseOrgIds": [
              "JOS.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Gileadi n'omu myatano y'aba Geshuri n'aba Maaka, n'orushozi rwa Herumooni rwona, na Bashani okuhika Saleka; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.11",
            "verseOrgIds": [
              "JOS.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'obugabe bwona obwa Ogi omuri Bashani, owaategyekyeire Ashitaroosi na Edurei, Ogi ogwo n'omwe ahari abo abaatsigaireho omu Bareefa; abo nibo Musa yaarwaine nabo akabinga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.12",
            "verseOrgIds": [
              "JOS.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Abaisraeli bo tibarabingire ba Geshuri nari aba Maaka; kureka aba Geshuri n'aba Maaka bakituura nabo n'okuhitsya hati. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.13",
            "verseOrgIds": [
              "JOS.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.20"
              },
              "items": [
                {
                  "text": "Kub 18:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka oruganda rwa Leevi rwo Musa tararuhaire buhunguzi, kureka ebitambo ebyokize eby'okuhayo ahari MUKAMA Ruhanga wa Israeli nibwo buhunguzi bwabo, nk'oku MUKAMA yaagambiire Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.14",
            "verseOrgIds": [
              "JOS.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.14",
            "verseOrgIds": [
              "JOS.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaaha oruganda rwa Reubeeni obuhunguzi bwabo, nk'oku emiryango yaabo yaabaire eri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.15",
            "verseOrgIds": [
              "JOS.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyanga kyabo kikaba nikitandikira Aroeri aha rubaju rw'oruhanga rwa Arunooni, n'orurembo rw'ahagati yaarwo, n'omurambi gwona ogwa Medeba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.16",
            "verseOrgIds": [
              "JOS.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Heshibooni n'endembo zaayo zoona eziri omu mirambi; na Diboni na Bamosi-baali na Besi-baali-meoni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.17",
            "verseOrgIds": [
              "JOS.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yahazi na Kedemoosi na Mefaasi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.18",
            "verseOrgIds": [
              "JOS.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kiryasaimu na Sibuma na Zeresi-shahaari aha kabungo akari omu ruhita; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.19",
            "verseOrgIds": [
              "JOS.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Besi-peori n'enkiizi za Pisiga, na Besi-yeshimoosi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.20",
            "verseOrgIds": [
              "JOS.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ezo nizo ndembo zoona ez'omu mirambi; n'obugabe bwona bwa Sihooni omugabe w'aba Amori, owaategyekyeire Heshibooni, ou Musa yaitsire hamwe n'abategyeki ba Midiani Evi, Rekemu, Zuuri, Huuri na Reeba, abanyiginya ba Sihooni abaabaire batwire omu nsi egyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.21",
            "verseOrgIds": [
              "JOS.13.21"
            ]
          }
        }
      ]
    },
