              },
              "items": [
                {
                  "text": "Oba 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoshua ku yaakuzire, yaahika omu ngingo zaabukuru, MUKAMA yaamugira ati: okuzire, waahika omu ngingo zaabukuru; kwonka hakitsigaireyo ensi mpango munonga eshemereire kukubuurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.1",
            "verseOrgIds": [
              "JOS.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi ekitsigaire n'egi; ebyanga byona eby'Abafilistia n'eby'aba Geshuri byona ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.2",
            "verseOrgIds": [
              "JOS.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "(okwiha Shihoori eri aha rubaju rw'oburugwa-izooba bwa Misri okuta aha bukiizi-bwa-bumosho aha mwatano gwa Ekurooni, n'ah'Abanyakanaani; kandi abategyeki bataano b'Abafilistia n'aba; owa Gaaza, owa Ashidoodi, owa Ashkelooni, owa Gaasi n'owa Ekurooni), n'eby'aba Avimu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.3",
            "verseOrgIds": [
              "JOS.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi aha bukiizi-bwa-buryo, ensi yoona ey'Abanyakanaani, na Meara ey'aba Sidoni, okuhika Afeki aha mwatano gw'Abaamori, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.4",
            "verseOrgIds": [
              "JOS.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ensi y'aba Gebali na Lebanooni yoona aha rubaju rw'oburugwa-izooba, okuruga Baali-gaadi ahansi y'orushozi Herumooni okuhika ah'orikutaahira omuri Hamasi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.5",
            "verseOrgIds": [
              "JOS.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abatwire omu nsi y'ebibungo boona okuruga Lebanooni okuhika Miserofoosi-maimu, n'aba Sidoni boona, ndyababinga omu maisho g'Abaisraeli; kwonka ogibaganisize Abaisraeli kuba obuhunguzi bwabo, nk'oku naakuragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.6",
            "verseOrgIds": [
              "JOS.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo hati ensi egi ogibaganisize enganda mwenda n'ekicweka ky'oruganda rwa Manaase kuba obuhunguzi bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.7",
            "verseOrgIds": [
              "JOS.13.7"
            ]
          }
        }
      ]
    },
    {
