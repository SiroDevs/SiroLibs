              },
              "items": [
                {
                  "text": "Kush 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Balamu mwene Beori omufumu, Abaisraeli bakamwitsa rurara omuri abo abu baitsire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.22",
            "verseOrgIds": [
              "JOS.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omwatano gw'aba Reubeeni gukaba guri Yorudani. Obwo nibwo buhunguzi bw'aba Reubeeni, nk'oku emiryango yaabo n'endembo zaabo n'ebirorero byazo byabaire biri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.23",
            "verseOrgIds": [
              "JOS.13.23"
            ]
          }
        }
      ]
    },
