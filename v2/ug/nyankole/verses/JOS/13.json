        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.23",
            "verseOrgIds": [
              "JOS.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Musa yaaha oruganda rwa Gaadi obuhunguzi bwabo nk'oku emiryango yaabo yaabaire eri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.24",
            "verseOrgIds": [
              "JOS.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyanga kyabo kikaba kiri Yazeri, n'endembo zoona eza Gileadi, n'ekicweka ky'ensi y'Abaamoni okuhitsya Aroeri aharikureebana na Rabba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.25",
            "verseOrgIds": [
              "JOS.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi okuruga Heshibooni okuhika Ramasi-mizipe na Betonimu; kandi okuruga Mahanaimu okuhika aha mwatano gwa Debira; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.26",
            "verseOrgIds": [
              "JOS.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'endembo z'omu ruhita, Besi-haramu, Besi-nimura, Sukoosi na Zafooni, n'ekicweka ky'obugabe bwa Sihooni omugabe wa Heshibooni ekyabaire kitsigaireho, omwatano gukaba guri Yorudani okuhika aha isheeshero ry'enyanja ya Kinereesi oburugwa-izooba bwa Yorudani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.27",
            "verseOrgIds": [
              "JOS.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo nibwo buhunguzi bw'aba Gaadi, nk'oku emiryango yaabo yaabaire eri, n'endembo zaabo n'ebirorero byazo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.28",
            "verseOrgIds": [
              "JOS.13.28"
            ]
          }
        }
      ]
    },
