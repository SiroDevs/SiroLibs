            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.58+PSA.78.59+PSA.78.60"
              },
              "items": [
                {
                  "text": "Zab 78:58-60",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.1.3"
              },
              "items": [
                {
                  "text": "1 Sam 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eihanga ryona ry'Abaisraeli ryateeranira hamwe Shiilo; baimutsyayo Eihema ry'okuteeraniramu. Ensi yaabagomookyera. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.1",
            "verseOrgIds": [
              "JOS.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omu Baisraeli hakaba hatsigaire enganda mushanju, ezaabaire zitakahairwe buhunguzi bwazo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.2",
            "verseOrgIds": [
              "JOS.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.9"
              },
              "items": [
                {
                  "text": "Bar 18:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.16"
              },
              "items": [
                {
                  "text": "Zef 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.27"
              },
              "items": [
                {
                  "text": "Yoh 6:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.13"
              },
              "items": [
                {
                  "text": "Fil 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoshua yaagambira Abaisraeli ati: Muryahitsya hi okweganda kuza kukubuura ensi, ei MUKAMA Ruhanga wa baashwenkuriimwe yaabahaire? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.3",
            "verseOrgIds": [
              "JOS.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu mutoorane abashaija bashatu omuri buri ruganda; naanye ndyaboohereza, baimukye, bagyendagyende omu nsi, beetegyereze ensi y'obuhunguzi bwabo oku erikushusha, haza bagarukye ahariinye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.4",
            "verseOrgIds": [
              "JOS.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi baryagibaganisa omu bicweka mushanju; Abayuda baryaguma omu kyanga kyabo aha bukiizi-bwa-buryo, n'aba Yosefu bagume omu kyabo aha bukiizi-bwa-bumosho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.5",
            "verseOrgIds": [
              "JOS.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.2"
              },
              "items": [
                {
                  "text": "Yos 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muryabaganisa ensi omu bicweka mushanju, mubireete aha, mubinshobororere; naanye ndyagibabaganisiriza n'enteenyu omu maisho ga MUKAMA Ruhanga waitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.6",
            "verseOrgIds": [
              "JOS.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.20"
              },
              "items": [
                {
                  "text": "Kub 18:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.8"
              },
              "items": [
                {
                  "text": "Yos 13:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Abaleevi tibaine mugabo omuriimwe, ahakuba obunyamurwa bwa MUKAMA nibwo buhunguzi bwabo; n'Abagaadi n'Abareubeeni, n'ekicweka ky'oruganda rwa Manaase, baaherize kuheebwa obuhunguzi bwabo oburugwa-izooba seeri ya Yorudani, obu Musa omugaragwa wa MUKAMA yaabahaire.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.7",
            "verseOrgIds": [
              "JOS.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.7",
            "verseOrgIds": [
              "JOS.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bashaija ku baabaire nibaimuka kugyenda kushoboorora ensi, Yoshua yaabeehanangiriza ati: Mugyende omu nsi yoona, muhandikye emyatano yaayo, mugarukye ahi ndi; naanye ndyagibabaganisiriza aha Shiilo omu maisho ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.8",
            "verseOrgIds": [
              "JOS.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashaija abo baagyenda, baaraba omuri egyo nsi, baahandika ebicweka byayo mushanju omu kitabo, nibooreka n'endembo zaamwo; bwanyima baagaruka ahari Yoshua omu rusiisira Shiilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.9",
            "verseOrgIds": [
              "JOS.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.33"
              },
              "items": [
                {
                  "text": "Enf 16:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoshua yaabateerera enteenyu ari omuri Shiilo omu maisho ga MUKAMA. Aho niho Yoshua yaabaganisiriize Abaisraeli ensi, nk'enganda zaabo oku zaabaire ziri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.10",
            "verseOrgIds": [
              "JOS.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.10",
            "verseOrgIds": [
              "JOS.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabo gw'oruganda rwa Benyamiini gwaija nk'oku emiryango yaabo yaabaire eri; kandi omwatano gw'ekyanga kyabo gukaba gutandikira ahagati y'eky'Abayuda n'eky'aba Yosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.11",
            "verseOrgIds": [
              "JOS.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omwatano gwabo aha bukiizi-bwa-bumosho, gukaba gutandikira Yorudani, gwinamuka, guraba aha rubaju rwa Yeriko aha bukiizi-bwa-bumosho, gugumizamu guraba omu nsi y'ebibungo oburengyerwa-izooba, gugarukira aha ihamba rya Besaveeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.12",
            "verseOrgIds": [
              "JOS.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga aho guza Luuzi, niyo Beseeli, aha rubaju rwayo rw'obukiizi-bwa-buryo, gushuuma guhika Ataroosi-adari, haihi n'ekibungo ekiri aha bukiizi-bwa-buryo bwa Besi-horoni eya ifo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.13",
            "verseOrgIds": [
              "JOS.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rubaju rw'oburengyerwa-izooba gukiikama gutoora obukiizi-bwa-buryo, okuruga aha kibungo ekirikureeba Besi-horoni aha rubaju rwa buryo, gugarukira Kiryasi-baali, niyo Kiryasi-yearimu orurembo rw'Abayuda; orubaju orwo nirwo rw'oburengyerwa-izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.14",
            "verseOrgIds": [
              "JOS.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi orubaju rw'obukiizi-bwa-buryo gutandikira aha muheru gwa Kiryasi-yearimu, gutoora oburengyerwa-izooba, guhika aha nshuro z'amaizi za Nefutoa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.15",
            "verseOrgIds": [
              "JOS.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "gushuuma, guhika aha muheru gw'ekibungo, ekirikureebana n'oruhanga rwa beene Hinoomu, kandi ekiri aha muheru gw'obukiizi-bwa-bumosho bw'oruhanga rwa Reefa; gushuuma omu ruhanga rwa Hinoomu, okuhika aha rubaju rw'Abayebusi aha bukiizi-bwa-buryo, gugumizamu gushuuma Eni-rogeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.16",
            "verseOrgIds": [
              "JOS.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "gukiikama, gutoora obukiizi-bwa-bumosho, guza Eni-shemeshi, gugumizamu guza Elilooti, erikureebana n'aharikwinamuka Adumimu; gushuuma guhika aha rukiri rwa Bohani mwene Reubeeni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.17",
            "verseOrgIds": [
              "JOS.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "gugumizamu guraba aha rubaju rw'obukiizi-bwa-bumosho bwa Besaraba, gushuuma guhika Araba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.18",
            "verseOrgIds": [
              "JOS.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi gwogamu guhika aha rubaju rwa Besi-hogola aha bukiizi-bwa-bumosho, gugarukira aha mukono gw'Enyanja y'omwonyo, ogw'aha bukiizi-bwa-bumosho aha isheeshero rya Yorudani; ogwo nigwo mwatano gw'obukiizi-bwa-buryo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.19",
            "verseOrgIds": [
              "JOS.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yorudani niyo yaabaire eri omwatano gwayo aha rubaju rw'oburugwa-izooba. Ekyo nikyo kyanga ky'obuhunguzi bw'aba Benyamiini, nk'oku emiryango yaabo yaabaire eri, n'emyatano yaakyo oku yaabaire eri aha mbaju zoona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.20",
            "verseOrgIds": [
              "JOS.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi endembo z'oruganda rwa Benyamiini, nk'oku emiryango yaabo yaabaire eri, nizo ezi; Yeriko, Besi-hogola, Emekezizi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.21",
            "verseOrgIds": [
              "JOS.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besaraba, Zemaraimu, Beseeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.22",
            "verseOrgIds": [
              "JOS.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avimu, Paara, Ofura, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.23",
            "verseOrgIds": [
              "JOS.18.23"
