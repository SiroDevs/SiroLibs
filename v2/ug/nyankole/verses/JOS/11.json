            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yabini omugabe wa Hazori ku yaakihuriire, yaatuma ahari Yobabu omugabe wa Madoni, n'owa Shimirooni, n'owa Akisaafu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.1",
            "verseOrgIds": [
              "JOS.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'aha bagabe abaabaire batwire aha bukiizi-bwa-bumosho omu nsi y'ebibungo n'omuri Araba aha bukiizi-bwa-buryo obwa Kineroosi, omu mpita n'omu bibungo bya Doori aha rubaju rw'oburengyerwa-izooba, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.2",
            "verseOrgIds": [
              "JOS.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ah'Abanyakanaani aha rubaju rw'oburugwa-izooba n'oburengyerwa-izooba, n'ah'Abaamori n'Abahiiti n'Abaperizi n'Abayebusi omu nsi y'ebibungo, n'ah'Abahiivi ahansi ya Herumooni omu nsi ya Mizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.3",
            "verseOrgIds": [
              "JOS.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baahurura n'amahe gaabo goona, engabo nyingi munonga ezirikwingana n'omusheenyi ogw'aha rubaju rw'enyanja, baine embaraasi n'ebigaari bingi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.4",
            "verseOrgIds": [
              "JOS.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bagabe boona baayeteerana, baija baasiisira hamwe aha nyanja ya Meromu kurwanisa Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.5",
            "verseOrgIds": [
              "JOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.5",
            "verseOrgIds": [
              "JOS.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Yoshua ati: Otabatiina, ahakuba boona niinyija kubahayo omu mikono y'Abaisraeli kubaita; embaraasi zaabo muziteme ebiteega, n'ebigaari byabo mubyotsye n'omuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.6",
            "verseOrgIds": [
              "JOS.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua nikwo kwija n'engabo ze zoona, bakabagwaho aha nyanja ya Meromu batakimanyire; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.7",
            "verseOrgIds": [
              "JOS.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akabahayo omu mikono y'Abaisraeli, bakabaita, bakababinga, bakabahitsya Sidoni empango na Miserofoosi-maimu n'omu ruhanga rwa Mizipe aha rubaju rw'oburugwa-izooba; bakabaita, batatsigyeho n'omwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.8",
            "verseOrgIds": [
              "JOS.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yoshua yaabagira nk'oku MUKAMA yaamuragiire; yaatema ebiteega by'embaraasi zaabo, n'ebigaari byabo yaabyotsya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.9",
            "verseOrgIds": [
              "JOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.9",
            "verseOrgIds": [
              "JOS.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebyo Yoshua yaakubuuka, yaakwata Hazori, yaitsa omugabe waayo rurara; ahakuba obunyakare Hazori ekaba eri omutwe gw'obugabe obwo bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.10",
            "verseOrgIds": [
              "JOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli baitsa rurara boona abaabaire barimu, baabacwekyerereza kimwe; tihaatsigaraho n'omwe orikwitsya; n'orurembo Hazori baarwotsya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.11",
            "verseOrgIds": [
              "JOS.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi endembo zoona ez'abo bagabe Yoshua yaazikwata, n'abagabe baazo boona yaabaitsa rurara, yaabacwekyerereza kimwe, nka Musa omugaragwa wa MUKAMA oku yaaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.12",
            "verseOrgIds": [
              "JOS.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Abaisraeli tibarookize rurembo na rumwe ahari ezo ezaayombekirwe aha mituumo y'ezindi, kureka Hazori yonka; niyo Yoshua yaayokize. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.13",
            "verseOrgIds": [
              "JOS.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi eminyago yoona n'amatungo goona ebyarugire omu ndembo ezo Abaisraeli bakabyetwarira; kwonka abantu boona baabaitsa rurara, okuhitsya obu baabahwerekyerereize kimwe, batatsigyeho n'omwe orikwitsya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.14",
            "verseOrgIds": [
              "JOS.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.2"
              },
              "items": [
                {
                  "text": "Bir 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku MUKAMA yaaragiire Musa omugaragwa we, nikwo Musa yaaragiire Yoshua, na Yoshua nikwo yaatwarize; taine kyona eki yaatsigire kitakozirwe ahari byona ebi MUKAMA yaaragiire Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo Yoshua yaakubwire egyo nsi yoona, ey'enshozi na Negebu yoona, n'ensi ya Gosheni yoona, n'ey'empita na Araba, n'ey'ebibungo bya Israeli n'empita zaayo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.16",
            "verseOrgIds": [
              "JOS.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.24"
              },
              "items": [
                {
                  "text": "Bir 7:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " okwiha aha kibungo kya Halaki ekirikwinamuka Seiri, okuhitsya Baali-gaadi omu ruhanga rwa Lebanooni ahansi y'orushozi Herumooni. N'abagabe baayo boona yaabakwata, yaabacumita, yaabaita. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.17",
            "verseOrgIds": [
              "JOS.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua yaamara omwanya muhango naarwanisa abo bagabe boona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.18",
            "verseOrgIds": [
              "JOS.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.9.3"
              },
              "items": [
                {
                  "text": "Yos 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.9.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tihariho rurembo orwaragaine kugira n'Abaisraeli obusingye, kureka Abahiivi abaabaire batwire Gibeoni; ezindi zoona bakazirwanisa, baazikwata; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.19",
            "verseOrgIds": [
              "JOS.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 11:20"
          },
          "items": [
