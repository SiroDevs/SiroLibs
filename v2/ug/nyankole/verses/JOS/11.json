              "items": [
                {
                  "text": "Rom 9:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba ekyo kikaruga ahari MUKAMA kugangaaza emitima yaabo, bakaza kurwanisa Abaisraeli, ngu abone kubahwerekyerereza kimwe, barekye kugirirwa embabazi, kureka bahwerekyerezibwe, nk'oku MUKAMA yaaragiire Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        }
