        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.11"
              },
              "items": [
                {
                  "text": "Yer 44:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu weena ow'omu nju ya Israeli nari ow'omu banyamahanga obashuhuukiiremu, orirya eshagama yoona, ndyamuta aha kaso, mmucwe omu ihanga rye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.14"
              },
              "items": [
                {
                  "text": "Kol 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.7"
              },
              "items": [
                {
                  "text": "1 Yoh 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.22"
              },
              "items": [
                {
                  "text": "Heb 9:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumanye ngu amagara g'omubiri gaba omu shagama; nikyo naagibaheera kushukwa aha itambiro ngu erihiirire amagara gaanyu; eshagama niyo erihiirira ahabw'okuba erimu amagara. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo naagambirira Abaisraeli nti: Hatarigira omuntu weena omuriimwe owaarya eshagama, n'obu yaakuba omunyaihanga obashuhuukiiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.7"
              },
              "items": [
                {
                  "text": "Ezk 24:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omuntu weena omu Baisraeli nari ow'omu banyamahanga obashuhuukiiremu, oriita enyamaishwa erikuriibwa nari enyonyi ahiigire, ayate eshagama yaayo ahansi, agishwekye eiju; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.9.4"
              },
              "items": [
                {
                  "text": "Kut 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba amagara g'ekihangirwe kyona gaba omu shagama yaakyo; nikyo ngiriire Abaisraeli nti: Mutarirya eshagama y'ekihangirwe kyona; ahakuba amagara g'ekihangirwe kyona gaba omu shagama yaakyo; origirya weena, aryacuubwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.14",
            "verseOrgIds": [
              "LEV.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.4.14"
              },
              "items": [
                {
                  "text": "Ezk 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omuntu weena orirya ekintu kyona ekyefeereire, nari ekiitsirwe enyamaishwa, yaaba muntu enzaarwa nari omunyaihanga, aryayozya ebijwaro bye, ayogye omu maizi, kandi agume ari otashemeire okuhitsya omu mwabazyo; obwo aryaba oshemeire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.15",
            "verseOrgIds": [
              "LEV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku ariba atabyogize, nawe akooga, orubanja rw'okutahikiirira ruryamugumaho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.16",
            "verseOrgIds": [
              "LEV.17.16"
            ]
          }
        }
      ]
