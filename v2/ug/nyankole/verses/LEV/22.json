    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.38"
              },
              "items": [
                {
                  "text": "Kur 28:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gambira Arooni n'abatabani beetantare ebintu ebirikwera, ebi Abaisraeli barikuunyereza, barekye kujumisa eiziina ryangye eririkwera. Niinye MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obagambire ebigambo byangye ebi ndikugamba ningira nti: Omuntu weena ow'omu ruzaaro rwanyu omu busingye bwanyu bwona orihika aha bintu birikwera ebi Abaisraeli barikwereza MUKAMA akisiisikaire, omuntu ogwo aryacuubwa omu maisho gangye. Niinye MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weena ow'omu ruzaaro rwa Arooni obembire, nari orikureeta amahira, atarirya aha bintu ebirikwera okuhitsya obu ariba oshemeire. Omuntu weena orikora aha kintu kyona ekisiisikaire ahabw'okuhika aha mutumbi, nari orikureeta amahira, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.4",
            "verseOrgIds": [
              "LEV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nari orikora aha kintu kyona ekirikugyendera ahansi ekirikubaasa kumuhindura otashemeire, nari omuntu ondiijo ou yaihaho okutashemera okw'omuringo gwona, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.5",
            "verseOrgIds": [
              "LEV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuntu orikora aha kintu ekirikushusha kityo, aryaba otashemeire okuhitsya omu mwabazyo, kandi tariikirizibwa kurya aha bintu birikwera, atabandize kwoga omubiri gwe omu maizi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizooba ku ririrenga, aryaba oshemeire; bwanyima abone kurya aha bintu ebirikwera; ahabw'okuba ebyo n'eby'okurya bye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atarirya ekyefeereire nari ekiitsirwe enyamaishwa okukyesiisisa. Niinye MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo bashemereire kworobera eki ndikubaragiira, batakaagiibwaho orubanja rw'ekibi, bakakifeeramu ahabw'okushiisha ekiragiro ekyo. Niinye MUKAMA orikubeeza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatarigira otari w'omu banyamurwa weena owaarya aha kintu ekirikwera; omushuhuuki w'omunyamurwa nari omupakasi orikumukorera taribiryaho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.10",
            "verseOrgIds": [
              "LEV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omunyamurwa ku arigura omuntu n'empiiha ze, ogwo aryabiryaho; kandi n'abo abazaariirwe omu ka ye, baryarya aha by'okurya bye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.11",
            "verseOrgIds": [
              "LEV.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhara w'omunyamurwa ku arishwerwa otari w'omu banyamurwa, atarirya aha mpongano z'ebintu ebirikwera; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.12",
            "verseOrgIds": [
              "LEV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.11"
              },
              "items": [
                {
                  "text": "Kub 18:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka muhara w'omunyamurwa ku ariba ari omufaakazi nari oshenzirwe, ataine mwana, yaagaruka aha mahega ga ishe, nk'oku yaabaire ari akiri omwishiki, aryaikirizibwa kurya aha by'okurya bya ishe; kwonka tihariho otari w'omu banyamurwa weena oribiryaho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.13",
            "verseOrgIds": [
              "LEV.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omuntu ku arirya aha kintu kirikwera atakimanyire, akirihe omunyamurwa, kandi ayongyereho ekicweka kimwe kya kataano eky'obuguzi bwakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.14",
            "verseOrgIds": [
              "LEV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamurwa batarishiisha ebintu ebirikwera ebi Abaisraeli bahongyera MUKAMA, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.15",
            "verseOrgIds": [
              "LEV.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakabareetera kugiibwaho okutahikiirira n'orubanja ahabw'okurya ebintu byabo ebirikwera; ahabw'okuba niinye MUKAMA orikubeeza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.17",
            "verseOrgIds": [
              "LEV.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gambira Arooni n'abatabani n'eihanga ryona ery'Abaisraeli oti: Omuntu weena ow'omu nju ya Israeli nari ow'omu babashuhuukiiremu ku arireeta empongano ye, yaaba y'okuhikiiriza eki yaaraganiise nari eki yaatoizire ahabw'okweyendera, kuba empongano ehongyeirwe MUKAMA ey'ekitambo ky'okwotsya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okwenda ngu eikirizibwe, mushemereire kuhonga enimi nari empaya y'entaama nari ey'embuzi etaine kamogo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.19",
            "verseOrgIds": [
              "LEV.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.8"
              },
              "items": [
                {
                  "text": "Mal 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.19"
              },
              "items": [
                {
                  "text": "1 Pet 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka ekiine akamogo mutarikihonga, ahabw'okuba tikiritoorwa habwanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
            "verseOrgIds": [
              "LEV.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.21"
              },
              "items": [
                {
                  "text": "Bir 23:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omuntu weena oritambira MUKAMA ekitambo ky'empongano z'okusiima ahabw'obusingye, okuhikiiriza eki yaaraganiise nari eki atoizire ahabw'okweyendera, naakiiha omu masyo g'ente nari ag'entaama, kyaza kwikirizibwa kishemereire kuba ekishugaine, kitainemu kamogo koona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.8"
              },
              "items": [
                {
                  "text": "Mal 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Enyamaishwa ehumire nari ehendekire nari ebuzireho orugingo nari erikureeta amahira nari erwaire orukamba nari akanyamutinda, mutaribihongyera MUKAMA, n'obu kwakuba okubitamba mukabyokyeza MUKAMA aha itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enimi nari omwana gw'entaama ebiine ebicweka ebirikukiraakirana, nimwikirizibwa kukihonga kuba omutoijo gw'okweyendera; kwonka tibirikwikirizibwa kuba empongano y'okuhikiiriza eki mwaraganiise. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.23",
            "verseOrgIds": [
              "LEV.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyamaishwa eine amagosi gahonokire nari gahonzire nari gataagukire nari gashaahwirwe, mutarigitoijera MUKAMA n'obu kwakuba okugimutambira omu nsi yaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mutaryakiira ezirikushusha nk'ezo okuruga omu mikono y'omunyaihanga kuba eby'okurya eby'okuhongyera Ruhanga waanyu; ahabw'okuba ziine obumogo; ahabw'obumogo bwazo tiziritoorwa habwanyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
