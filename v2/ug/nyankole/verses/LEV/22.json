          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26",
            "verseOrgIds": [
              "LEV.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enimi nari entaama nari embuzi ku erizaarwa, eryamara ebiro mushanju na nyinayo; okuruga aha kiro kya munaana eryaikirizibwa kuhongyerwa MUKAMA kuba empongano eyokiibwe omu muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.6"
              },
              "items": [
                {
                  "text": "Bir 22:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyinayo, ku eriba eri ente nari entaama, otarigiita hamwe n'omwana gwayo aha izooba rimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.116.17"
              },
              "items": [
                {
                  "text": "Zab 116:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku muritambira MUKAMA ekitambo ky'okusiima, mukitambe omu muringo ogu murikubaasa kwikiririzibwamu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiriibwe aha izooba eryo eri kyatambirwaho; mutarigira eki mwatsigaho okuhitsya omu kasheeshe. Niinye MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo muryaguma mworobere ebiragiro byangye, mukore ebi naataireho. Niinye MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 22:32"
          },
          "items": [
