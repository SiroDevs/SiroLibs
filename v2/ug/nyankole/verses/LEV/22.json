            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi mutarijumisa eiziina ryangye eririkwera; kureka ndyaguma nyezibwe omu ihanga rya Israeli. Niinye MUKAMA orikubeeza, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "verse",
