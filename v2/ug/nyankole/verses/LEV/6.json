                "loc": "PRO.26.19"
              },
              "items": [
                {
                  "text": "26:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu weena ku arishiisha, yaacumura ahari MUKAMA omu kuryangatanisa ebi mutaahi we amubiikize, nari ebi ayemerereire, nari omu kumunyaga nari omu kumuhata, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.1"
              },
              "items": [
                {
                  "text": "Kur 22:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.9"
              },
              "items": [
                {
                  "text": "Yer 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nari okugwa aha kibuzire, akakiryangatanisa naarahira ebishuba, nari ekintu kyona omu bi abantu bakora bakabisiisiramu, biryatwazibwa biti; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.5"
              },
              "items": [
                {
                  "text": "Lev 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " omuntu ku arikikora, yaagiibwaho orubanja, aryariha eki aibire, nari eki anyagiise eishaija, nari eki aryangataniise bamubiikize, nari eki atorotoire kibuzire, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4",
            "verseOrgIds": [
              "LEV.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nari ekintu kyona eki ayehakaine naarahira ebishuba, aryabigarura byona, kandi abyongyereho ekicweka kimwe kya kataano, abihe mukama waabyo aha izooba eri arihongyeraho empongano y'okwihaho orubanja; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima areetere omunyamurwa empongano egyo, ei ahongyeire MUKAMA kumwihaho orubanja, empaya y'entaama etaine kamogo, nk'oku oribariirira obuguzi bwayo, kuba empongano y'okumwihaho orubanja; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "omunyamurwa amuhongyerere empongano y'okumurihiirira omu maisho ga MUKAMA; nawe aryasaasirwa eki ariba akozire kyona ekyamureeteire orwo rubanja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.8",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ragiira Arooni n'abatabani oti: Eki nikyo kiragiro ky'ebitambo by'okwotsya. Ekitambo ky'okwotsya kiryaguma kiteebwe aha nku z'aha itambiro, kiraareho okuhitsya omu kasheeshe, kandi omuriro gw'aha itambiro gugume nigwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.39+EXO.28.40+EXO.28.41+EXO.28.42+EXO.28.43"
              },
              "items": [
                {
                  "text": "Kur 28:39-43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omunyamurwa ajware ekanzu ye ya bafuta, n'empare ye ya kitaani, ayoore eiju ry'ekitambo ekyokize, ekyokiibwe omu muriro aha itambiro, arite aha rubaju rw'eitambiro; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima ajuure ebyo bijwaro, ajware ebindi, atware eiju aheeru y'orusiisira, aryate omu mwanya murungi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuriro gw'aha itambiro guryaguma nigwaka, gutariraara; omunyamurwa agume agutemu enku buri kasheeshe, ariteho gye ekitambo ky'okwotsya, ayotsyeho ebishaju by'empongano z'okusiima ahabw'obusingye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwo muriro gugume nigwaka aha itambiro obutoosha, gutariraara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki nikyo kiragiro ky'empongano y'esaano. Batabani ba Arooni baryaguma bagihongye omu maisho ga MUKAMA omu maisho g'eitambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyamurwa agiiheho oruhi rw'esaano y'obunono n'amajuta gaayo n'obubaane bwa lebona bwona obugimemeereirweho, abyokyeze aha itambiro kuba ekiijutsyo kyayo ky'ekisooroora kirungi ahari MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.10"
              },
              "items": [
                {
                  "text": "Kub 18:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebiraatsigareho biriibwe Arooni n'abatabani; babiriire omu mwanya gurikwera bitatumbisiibwe; omu kibuga ky'Eihema ry'okubugaabuganiramu babe nimwo baabiriira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.16",
            "verseOrgIds": [
              "LEV.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bataribiteekyerana n'ekitumbisa; naakibaha kuba omugabo gwabo ogw'empongano ezi mpongyeirwe ezokiibwe omu muriro; n'ebirikwera munonga, nk'empongano y'ekibi n'ey'okwihaho orubanja oku biri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.17",
            "verseOrgIds": [
              "LEV.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyetwa omushaija weena omuri beene Arooni akiryeho, nk'omugabo gwe ogurikuruga omu mpongano ezokiibwe omu muriro ezihongyeirwe MUKAMA; kibe ekiragiro ky'ebiro byona omu busingye bwanyu bwona; oribikoraho weena aryaba orikwera.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egi niyo mpongano ei Arooni n'abatabani barihongyera MUKAMA aha izooba eri arishukirwaho amajuta; ekicweka kimwe kya ikumi ekya eefa y'esaano y'obunono kuba empongano y'esaano obutoosha, ekicweka kyayo kihongwe omu kasheeshe, n'ekindi omu mwabazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogiteekyerane n'amajuta aha kyoma ky'okukarangaho; ku eraahikwemu amajuta, ogireete, ogihongye omu bicweka bikarangire kuba empongano y'esaano y'ekisooroora kirungi ehongyeirwe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.26"
              },
              "items": [
                {
                  "text": "Dan 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omunyamurwa ow'omuri batabani ba Arooni oriba ashukirweho amajuta kumuhungurira, abe niwe yaagihongyera MUKAMA, nk'ekiragiro ky'obutoosha oku kirikuragiira; empongano egyo eyokibwe yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buri mpongano y'esaano erihongwa omunyamurwa eryayokibwa yoona, teririibwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
