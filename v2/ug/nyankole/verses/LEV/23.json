                {
                  "text": "Yoh 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gambira Abaisraeli oti: Aha kiro kya ikumi na bitaano eky'okwo kwezi kwa mushanju haryabaho obugyenyi bw'Ensiisira ahari MUKAMA okumara ebiro mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha izooba ry'okubanza haryabaho okuteerana okurikwera; mutaririkoreraho omurimo gwona ogurikurusya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.37"
              },
              "items": [
                {
                  "text": "Yoh 7:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muryaguma nimureeta empongano y'okuhongyera MUKAMA y'okwotsya omu muriro okumara ebiro mushanju; aha kiro kya munaana muryagira okuteerana okurikwera, mureete empongano y'okuhongyera MUKAMA y'okwotsya omu muriro; eryo izooba n'ery'okuteerana okurikwera; mutaririkoreraho omurimo gwona ogurikurusya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago nigo magyenyi ga MUKAMA agaatairweho agu muriranga kuba ag'okuteerana okurikwera, mukabona kureetera MUKAMA empongano z'okwotsya omu muriro, n'ekitambo ky'okwotsya, n'empongano y'esaano, n'ebindi bitambo, n'empongano z'eby'okunywa, buri kimwe aha izooba ryakyo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.37",
            "verseOrgIds": [
              "LEV.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutaihiremu sabato za MUKAMA, n'emitoijo yaanyu, n'ebi muraganisa nimuhiga byona, n'ebi mutoija ahabw'okweyendera ebi mutoijera MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        }
      ]
