                {
                  "text": "Kub 29:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ekiro kya ikumi eky'okwo kwezi kwa mushanju kiryaba eizooba ry'okurihiiriraho; riryababeera eizooba ry'okuteerana okurikwera; muryabonabonesa amagara gaanyu, muhongyere MUKAMA empongano y'okwotsya omu muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.27",
            "verseOrgIds": [
              "LEV.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro ekyo mutarikora omurimo gwona, ahakuba n'eizooba ry'okurihiiriraho, okubarihiirira omu maisho ga MUKAMA Ruhanga waanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.28",
            "verseOrgIds": [
              "LEV.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.6"
              },
              "items": [
                {
                  "text": "2 Tes 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba omuntu oriba atabonaboneise magara ge eryo izooba, aryacuubwa omu ihanga rye; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.29",
            "verseOrgIds": [
              "LEV.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'omuntu weena orikora omurimo gwona ahari eryo izooba, ndyamuhwerekyereza, mmwihe omu ihanga rye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.30",
            "verseOrgIds": [
              "LEV.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutarigira omurimo gwona ogu mwakora. Ekyo n'ekiragiro ekitarihwaho omu maka gaanyu goona n'omu busingye bwanyu bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.31",
            "verseOrgIds": [
              "LEV.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eryo izooba riryababeera sabato erikwera ey'okuhuumuriraho, mubonabonese amagara gaanyu; aha kiro kya mwenda eky'okwezi okwo okwiha omu mwabazyo muryarinda sabato yaanyu okuhitsya omu mwabazyo ogundi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        }
      ]
