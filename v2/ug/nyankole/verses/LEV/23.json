                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahari eryo izooba ry'okutandikiraho muryatwara ebijuma by'emiti emirungi, n'amataagi g'enkindo, n'amataagi g'emiti eyumbize, n'emiti y'aha migyera; muryamara ebiro mushanju nimushemerererwa omu maisho ga MUKAMA Ruhanga waanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.40",
            "verseOrgIds": [
              "LEV.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muryaguma mugire obwo bugyenyi bw'ebiro mushanju ahari MUKAMA buri mwaka. Ekyo n'ekiragiro ekitarihwaho omu busingye bwanyu bwona. Muryaguma mubugire omu kwezi kwa mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.41",
            "verseOrgIds": [
              "LEV.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muryamara ebiro mushanju nimuraara omu nsiisira; Abaisraeli enzaarwa boona bagume omu nsiisira, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
          }
        },
