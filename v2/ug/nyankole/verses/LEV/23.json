            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.1"
              },
              "items": [
                {
                  "text": "29:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gambira Abaisraeli oti: Omu kwezi kwa mushanju, ekiro ky'okubanza ky'okwo kwezi murykigira eizooba eririkwera ery'okuhuumuriraho, ery'ekiijutsyo eki muriranga nimuteera enzamba, kuba okweteerana okurikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.24",
            "verseOrgIds": [
              "LEV.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaririkoreraho omurimo gwona ogurikurusya; kureka muryahongyera MUKAMA empongano y'okwotsya omu muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.25",
            "verseOrgIds": [
              "LEV.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.26",
            "verseOrgIds": [
              "LEV.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
