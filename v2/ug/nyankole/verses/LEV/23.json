              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.9",
            "verseOrgIds": [
              "LEV.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.9"
              },
              "items": [
                {
                  "text": "Enf 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gambira Abaisraeli ebi ndikuragiira ningira nti: Ku murihika omu nsi ei ndikubaha, mwashaaruura emyaka yaayo, muryareetera omunyamurwa ekiba ky'omuganuro gw'ebi mwerize, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.10",
            "verseOrgIds": [
              "LEV.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe azongazonzye ekyo kiba omu maisho ga MUKAMA, kiikirizibwe ahabwanyu; aha izooba eririkurata sabato niryo omunyamurwa arikizongazongyezaho; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.11",
            "verseOrgIds": [
              "LEV.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi aha izooba eryo eri murizongazongyezaho ekyo kiba, muryahonga empaya nto y'entaama etaine kamogo ehikize omwaka, kuba ekitambo ky'okwotsya ekihongyeirwe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.12",
            "verseOrgIds": [
              "LEV.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi empongano y'esaano ey'okuhongwa nakyo eryaguma ebe ebicweka bibiri bya ikumi bya eefa y'esaano y'obunono ejwangize n'amajuta, ebe empongano ey'okuhongyera MUKAMA ey'okwotsya omu muriro kuba ekisooroora kirungi; empongano y'eby'okunywa ey'okuhongwa nakyo eryaguma ebe ekicweka kimwe kya kana kya hiini ya viinyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutarirya omugaati gwona nari enjuma y'ekintu kyona ekarangire nari embisi eryo izooba eri muriheeraho empongano ahari Ruhanga waanyu ritakahikire. Ekyo n'ekiragiro ekitarihwaho omu busingye bwanyu bwona n'omu maka gaanyu goona.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.14",
            "verseOrgIds": [
              "LEV.23.14"
            ]
          }
        }
      ]
    },
