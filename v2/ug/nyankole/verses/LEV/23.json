          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.22"
              },
              "items": [
                {
                  "text": "Kur 34:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.9"
              },
              "items": [
                {
                  "text": "Bir 16:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi muryayebarira ebiro okwiha aha izooba eririkurata sabato, eri muriba mureeteireho ekiba ky'empongano ey'okuzongazonzya; ebyo biro bihikye sabato mushanju eziijwire, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.15",
            "verseOrgIds": [
              "LEV.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimubara ebiro makumi ataano okuhitsya aha izooba eririkukurata sabato ya mushanju; obwo muryareeta empongano y'esaano y'omwaka musya y'okuhongyera MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.16",
            "verseOrgIds": [
              "LEV.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwihe omu maka gaanyu emigaati ebiri ekozirwe omu bicweka bibiri bya ikumi bya eefa kuba empongano y'okuzongazonzya, eteekwe omu saano y'obunono, bagiteekyerane n'ekitumbisa kuganurirwa MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.17",
            "verseOrgIds": [
              "LEV.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwe n'egyo migaati mureete abaana b'entaama mushanju abataine kamogo, abahikize omwaka, n'enimi nto emwe n'empaya z'entaama ibiri; bibe ekitambo ky'okwotsya eky'okutambirwa MUKAMA, n'empongano y'esaano ereetsirwe nabyo, n'ez'eby'okunywa ezireetsirwe nabyo, kuba empongano ey'okwotsya omu muriro y'ekisooroora kirungi ahari MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.18",
            "verseOrgIds": [
              "LEV.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muhongye empaya y'embuzi kuba empongano y'ekibi, n'empaya nto ibiri z'entaama ezihikize omwaka kuba ekitambo ky'empongano z'okusiima ahabw'obusingye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.19",
            "verseOrgIds": [
              "LEV.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyamurwa abizongazonzye hamwe n'emigaati y'omuganuro kuba empongano ezongazongiibwe omu maisho ga MUKAMA hamwe n'abo baana b'entaama bombi, bibe ebyereziibwe MUKAMA, bitwarwe omunyamurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.20",
            "verseOrgIds": [
              "LEV.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eryo izooba murangye ku murigira okuteerana okurikwera; mutaririkoreraho omurimo gwona ogurikurusya. Ekyo n'ekiragiro ekitarihwaho omu maka gaanyu goona n'omu busingye bwanyu bwona.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.21",
            "verseOrgIds": [
              "LEV.23.21"
            ]
          }
        }
      ]
    },
