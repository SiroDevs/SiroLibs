            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.1",
            "verseOrgIds": [
              "LEV.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.30.5"
              },
              "items": [
                {
                  "text": "2 Bus 30:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gambira Abaisraeli ebi ndikugamba ningira nti: Aga nigo magyenyi ga MUKAMA agu naataireho, agu oshemereire kuranga kuba okuteerana okurikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.2"
              },
              "items": [
                {
                  "text": "Isa 56:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.58.13"
              },
              "items": [
                {
                  "text": "58:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro mukaaga emirimo ebe nimwo yaakorerwa; kwonka ekiro kya mushanju ni sabato y'okuhuumuriraho ey'okuteerana okurikwera; mutarigikoreraho omurimo gwona; ni sabato ahari MUKAMA omu maka gaanyu goona.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga nigo magyenyi ga MUKAMA agaatairweho ag'okuteerana okurikwera, agu oshemereire kuranga omu bunaku bwago obwatairweho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.6"
              },
              "items": [
                {
                  "text": "Kur 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.1"
              },
              "items": [
                {
                  "text": "Bir 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu kwezi kw'okubanza aha kiro kya ikumi na bina omu mwabazyo, nikwo kuhinguraho kwa MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kya ikumi na bitaano eky'okwezi okwo n'obugyenyi bw'emigaati etatumbisiibwe ahari MUKAMA; muryaguma mumare ebiro mushanju nimurya emigaati etatumbisiibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.6",
            "verseOrgIds": [
              "LEV.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro ky'okutandikiraho obwo bugyenyi muryagira okuteerana kurikwera; mutarikikoreraho omurimo gwona ogurikurusya; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.7",
            "verseOrgIds": [
              "LEV.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka muryaguma nimureeta empongano y'okuhongyera MUKAMA ey'okwotsya omu muriro okumara ebiro mushanju; aha kiro kya mushanju haryabaho okuteerana okurikwera; mutarikikoreraho omurimo gwona ogurikurusya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        }
      ]
    },
    {
