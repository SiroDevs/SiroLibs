            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku muriba nimushaaruura emyaka y'omu misiri yaanyu, mutarimariramu kimwe n'ey'aha mbibi, n'obu kwakuba okuhumba ebitsigairemu; kureka mubitsigire abooro n'abanyamahanga. Niinye MUKAMA Ruhanga waanyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
