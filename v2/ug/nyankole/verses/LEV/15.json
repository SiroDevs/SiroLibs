              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo nibyo biragiro by'orikurugwamu amahira, nari orikurugwamu amaizi agarikuzaara, bikamuhindura otashemeire, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
