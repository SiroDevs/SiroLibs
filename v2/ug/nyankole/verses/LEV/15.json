            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.13",
            "verseOrgIds": [
              "LEV.15.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.14"
              },
              "items": [
                {
                  "text": "Kub 12:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Orikurugwamu amahira ku arikira, ayebarire ebiro mushanju eby'okushemerezibwamu, ayozye ebijwaro bye, ayogye omubiri gwe gwona omu maizi agarikugyenda, abe oshemeire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.13",
            "verseOrgIds": [
              "LEV.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kya munaana atware obwiba bubiri, nari enkombe nto ibiri, aije omu maisho ga MUKAMA aha muryango gw'Eihema ry'okubugaabuganiramu, abihe omunyamurwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.14",
            "verseOrgIds": [
              "LEV.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "omunyamurwa abihongye, kimwe kibe empongano y'ekibi, ekindi kibe ekitambo ky'okwotsya; omunyamurwa amurihiirire omu maisho ga MUKAMA ahabw'okurugwamu amahira kwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu weena ku arirugwamu amaizi agarikuzaara, ayogye omubiri gwe gwona omu maizi, agume ari osiisikaire okuhitsya omu mwabazyo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.16",
            "verseOrgIds": [
              "LEV.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi buri kijwaro n'oruhu rwona ebirihikwaho ago maizi agarikuzaara, byogibwe omu maizi, bigume biri ebisiisikaire okuhitsya omu mwabazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.17",
            "verseOrgIds": [
              "LEV.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.4"
              },
              "items": [
                {
                  "text": "1 Sam 21:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omushaija ku ariba abyami n'omukazi, yaarugwamu ago maizi, bombi boogye omu maizi, bagume bari abasiisikaire okuhitsya omu mwabazyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.18",
            "verseOrgIds": [
              "LEV.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.18",
            "verseOrgIds": [
              "LEV.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi ku ariza omu kwezi nk'obutoosha, aryamara ebiro mushanju ari otashemeire; orimukoraho weena abe otashemeire okuhitsya omu mwabazyo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.19",
            "verseOrgIds": [
              "LEV.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ekintu kyona eki aribyamaho ari omu kwezi, kibe ekisiisikaire; n'eki arishutamaho kyona kibe ekisiisikaire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.20",
            "verseOrgIds": [
              "LEV.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weena orikora aha kitanda kye, ayozye ebijwaro bye, ayogye omu maizi, agume ari otashemeire okuhitsya omu mwabazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.21",
            "verseOrgIds": [
              "LEV.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi weena orikora aha kintu kyona eki ashutamireho, ayozye ebijwaro bye, ayogye omu maizi, agume ari otashemeire okuhitsya omu mwabazyo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.22",
            "verseOrgIds": [
              "LEV.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaaba kitanda kye nari ekintu kyona eki ashutamireho, orikikoraho aryaba otashemeire okuhitsya omu mwabazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.23",
            "verseOrgIds": [
              "LEV.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omushaija oribyama nawe, ebirikumurugamu byamuzaho, amare ebiro mushanju ari otashemeire; kandi ekitanda kyona eki ogwo mushaija aribyamaho, kiryaba ekisiisikaire.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi ku arimara ebiro bingi naajwa eshagama, butari bunaku bwe bw'okuza omu kwezi, nari shi yaarenzya ebiro ebi ashangwa amara omu kwezi, aryaba nk'oku ashangwa aba omu biro bye by'okuza omu kwezi; abe otashemeire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.25",
            "verseOrgIds": [
              "LEV.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitanda kyona eki aribyamaho omu biro byona ebi arimara arwaire ekyejwiso, kiryaba nk'ekitanda eki abyamaho omu biro bye by'okuba omu kwezi, n'ekintu kyona eki arishutamaho, kiryaba ekisiisikaire nk'ekisiisirwe okuba omu kwezi kwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.26",
            "verseOrgIds": [
              "LEV.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orikora ahari ebyo weena aryaba otashemeire, ayozye ebijwaro bye, ayogye omu maizi, kandi agume ari otashemeire okuhitsya omu mwabazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.27",
            "verseOrgIds": [
              "LEV.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku arikira ekyejwiso, ayebarire ebiro mushanju, bwanyima yaabyo aryaba oshemeire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.28",
            "verseOrgIds": [
              "LEV.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kya munaana aryatwara obwiba bubiri nari enkombe nto ibiri, azireetere omunyamurwa aha muryango gw'Eihema ry'okubugaabuganiramu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.29",
            "verseOrgIds": [
              "LEV.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "omunyamurwa ahongye emwe kuba empongano y'ekibi, n'endiijo kuba ekitambo ky'okwotsya, omunyamurwa amurihiirire ahabw'okutashemera kw'ekyejwiso kye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
            ]
          }
        }
