          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.40"
              },
              "items": [
                {
                  "text": "Mak 1:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebi nibyo biragiro by'omubembe aha izooba ry'okushemezibwa kwe. Aryareetwa aha munyamurwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "omunyamurwa ashohore aheeru y'orusiisira, ashwijume ogwo mubembe; ku arishanga akizire endwara y'ebibembe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.22"
              },
              "items": [
                {
                  "text": "Kur 12:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.51.7"
              },
              "items": [
                {
                  "text": "Zab 51:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " aragiire bareete enyonyi ibiri ezitarikuzira, ezihuriire, n'ekiti ky'omwereezi, n'akenda ka karari, n'enganda y'enyaweera ahabw'orikwenda kushemezibwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "omunyamurwa aragiire kwitira emwe ahari ezo nyonyi omu rwabya rw'eibumba ahaiguru y'amaizi agarikugyenda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "atware enyonyi ehuriire n'ekyo kiti ky'omwereezi n'akenda ka karari n'enganda y'enyaweera, abijabikye hamwe n'enyonyi ehuriire omu shagama y'enyonyi ei baitira ahaiguru y'amaizi agarikugyenda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.25"
              },
              "items": [
                {
                  "text": "Ezk 36:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.13"
              },
              "items": [
                {
                  "text": "Heb 9:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bwanyima agimiisiire orikuza kushemezibwaho ebibembe emirundi mushanju, amurangye ku ashemeziibwe, bwanyima arekure egyo nyonyi ehuriire, eze omu ishwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.14"
              },
              "items": [
                {
                  "text": "Kub 12:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Orikushemezibwa ayozye emyenda ye, amwe omubiri gwe gwona, ayogye omu maizi, abe oshemeziibwe; bwanyima y'ebyo agarukye omu rusiisira, kwonka amare ebiro mushanju aheeru y'eihema rye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kya mushanju amwe eishokye rye ryona n'ebireju bye na bahungu n'obundi bwoya bwe bwona, kandi ayozye emyenda ye, ayogye omubiri gwe omu maizi, abe oshemeziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.4"
              },
              "items": [
                {
                  "text": "Mat 8:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi aha kiro kya munaana atware abaana b'entaama babiri b'empaya, abataine kamogo n'omwagazi gw'entaama oguhikize omwaka, ogutaine kamogo, hamwe n'ebicweka bishatu bya ikumi bya eefa y'esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano na ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:10",
              "type": "text"
            },
            {
              "text": "logi emwe neingana na painta.",
              "type": "text"
            }
          ]
        },
        {
          "text": "logi emwe y'amajuta g'emizeituuni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyamurwa orikumushemeza atware omushaija orikushemezibwa n'ebintu ebyo omu maisho ga MUKAMA aha muryango gw'Eihema ry'okubugaabuganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima omunyamurwa atware emwe ahari ezo mpaya nto z'entaama, agihongye kuba empongano y'okwihaho orubanja, hamwe na logi y'amajuta, abizongazonzye kuba empongano ezongazongiibwe omu maisho ga MUKAMA; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima aitire egyo mpaya nto omu mwanya ogu baitiramu empongano y'ekibi n'ekitambo ky'okwotsya omu mwanya gw'Aharikwera; ahakuba nk'oku empongano y'ekibi eri ey'omunyamurwa, nikwo n'empongano y'okwihaho orubanja eri; n'erikwera munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.1"
              },
              "items": [
                {
                  "text": "Rom 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omunyamurwa atware ah shagama y'empongano y'okwihaho rubanga, agite aha nshonga y'okutu kwa buryo kw'orikushemezibwa, n'aha kikumu kishaija eky'engaro ye ya buryo, kandi n'aha kikumu kishaija eky'ekigyere kye kya buryo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi omunyamurwa atware ahari logi y'amajuta, agashukye aha kiganja kye kya bumosho, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "akoze orukumu rwe rwa buryo omu majuta agari aha kiganja kye kya bumosho, arumiisiize ago majuta emirundi mushanju omu maisho ga MUKAMA; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.13+ROM.6.14+ROM.6.15+ROM.6.16+ROM.6.17+ROM.6.18+ROM.6.19+ROM.6.20+ROM.6.21+ROM.6.22"
              },
              "items": [
                {
                  "text": "Rom 6:13-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " amajuta agaatsigara aha kiganja kye omunyamurwa agate aha nshonga y'okutu kwa buryo kw'orukushemezibwa n'aha kikumu kishaija eky'engaro ye ya buryo, n'aha kikumu kishaija eky'ekigyere kye kya buryo, ahu yaata eshagama y'empongano y'okwihaho orubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.11"
              },
              "items": [
                {
                  "text": "Rom 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Agandi majuta agaatsigara aha kiganja ky'omunyamurwa agasiigye aha mutwe gw'orikushemezibwa; omu nyamurwa amurihiirire omu maisho ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omunyamurwa ahongye empongano y'ekibi, arihiirire owaashemezibwaho okusiisikara; bwanyima aite ekitambo ky'okwotsya; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahongyere aha itambiro ekyo kitambo ky'okwotsya n'empongano y'esaano; amurihiirire, abe oshemeziibwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
