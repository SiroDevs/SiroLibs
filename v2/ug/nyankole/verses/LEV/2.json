          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogishukyeho amajuta, kandi ogimemeerereho obubaane bwa lebona; egyo n'empongano y'esaano. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.15",
            "verseOrgIds": [
              "LEV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyamurwa ayotsye akacweka k'ebihere by'engano n'amajuta hamwe n'obwo bubaane bwona kuba ekiijutsyo kyayo; egyo n'empongano ehongyeirwe MUKAMA eyokiibwe omu muriro.",
          "type": "text",
