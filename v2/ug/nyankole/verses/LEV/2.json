              "items": [
                {
                  "text": "Gal 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hatarigira empongano y'esaano ei mwahongyera MUKAMA ekozirwe n'ekitumbisa; ahabw'okuba timushemereire kwotsya kitumbisa nari obwoki bwona kuba empongano eyokiibwe omu muriro ehongyeirwe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empongano z'esaano ezirimu ekitumbisa n'obwoki muryazihongyera MUKAMA nk'omuganuro, kwonka zitarihongyerwa aha itambiro kuba empongano y'ekisooroora kirungi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.49"
              },
              "items": [
                {
                  "text": "Mak 9:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.6"
              },
              "items": [
                {
                  "text": "Kol 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Empongano y'esaano yoona oryaguma ogitemu omwonyo, kandi otariikiriza empongano zaawe ez'esaano kuburamu omwonyo gw'endagaano ya Ruhanga waawe; empongano zaawe zoona oryaguma ozihongye n'omwonyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        }
      ]
