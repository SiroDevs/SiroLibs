            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ku orihongyera MUKAMA empongano y'esaano ey'omuganuro, oryareeta obushiisha bw'engano obutarikire aha muriro, ebihere by'engano mbisi, kuba empongano y'esaano ey'omuganuro gwawe; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.14",
            "verseOrgIds": [
              "LEV.2.14"
            ]
          }
        },
        {
