                "loc": "NUM.5.15"
              },
              "items": [
                {
                  "text": "Kub 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku ariba ari omworo otarikubaasa kureeta obwiba bubiri nari enkombe nto ibiri, areete ekicweka kimwe kya ikumi kya eefa y'esaano y'obunono kuba empongano y'ekibi ey'okuhongyerera ekibi eki akozire; arekye kugitamu amajuta n'obu kwakuba okugimemeereraho obubaane bwa lebona; ahabw'okuba egyo n'empongano y'ekibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egyo saano agireetere omunyamurwa, ogwo munyamurwa agiiheho oruhi kuba ekiijutsyo kyayo, agyokyeze aha itambiro ahaiguru y'empongano ehongyeirwe MUKAMA eyokiibwe omu muriro; egyo n'empongano y'ekibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo omunyamurwa amuhongyerere empongano y'okurihiirira ekibi kyona eki akozire omuri ebyo byona, nawe aryasaasirwa. Esaano eritsigaraho ebe ey'omunyamurwa, nk'empongano y'esaano oku etwazibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ku arishobya ekintu kimwe omu birikwera ebya MUKAMA, yaakora ekibi atakimanyire, areetere MUKAMA empongano y'okumwihisaho orubanja ey'empaya y'entaama ey'omu busyo etaine kamogo, obariirire obuguzi bwayo omu shekeli z'efeeza, nka shekeli ey'Omwanya ogurikwera oku eri, kuba empongano y'okwihaho orubanja; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.22.14"
              },
              "items": [
                {
                  "text": "Lev 22:14",
                  "type": "text"
