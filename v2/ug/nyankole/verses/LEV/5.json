              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omuntu weena ku arishiisha, yaagira eki yaakora omu bi MUKAMA yaazibiire, n'obu ariba atakimanyire, aryaba aine orubanja, kandi okutahikiirira kwe kuryamugumaho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aryaiha omu busyo empaya y'entaama etaine kamogo, nk'oku oribariirira obuguzi bwayo, kuba empongano y'okwihaho orubanja, agireetere omunyamurwa; omunyamurwa amuhongyerere kurihiirira eki ashobize atamanyire, nawe aryasaasirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egyo n'empongano ey'okwihaho orubanja; ahakuba buzima naaba aine orubanja omu maisho ga MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
