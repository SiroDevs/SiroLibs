                "loc": "PRO.29.24"
              },
              "items": [
                {
                  "text": "Enf 29:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu weena ku arirahizibwa, yaakora ekibi ky'okwanga kujurira eki areebire, nari eki arikumanya, aryagiibwaho orubanja rw'okutahikiirira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nari omuntu weena ku arikora aha kintu kyona ekirikuzira, yaaba omutumbi gw'enyamaishwa erikuzira, nari ogw'ekitungirwe ekirikuzira, nari ogw'ekirikugyendesa enda ekirikuzira, atakimanyire, yaasiisikara, aryagiibwaho orubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nari ku arikora aha kirikuzira ekirikuruga omu muntu ondiijo eky'omuringo gwona atakimanyire, ku arikimanya, aryagiibwaho orubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.24"
              },
              "items": [
                {
                  "text": "1 Sam 14:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.22"
              },
              "items": [
                {
                  "text": "25:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nari omuntu ku arirahukwa aha rurimi, yaarahira kukora kubi nari kukora gye kyonakyona eki arirahuka kurahira atakimanyire, ku arikimanya aryagiibwaho orubanja rw'ekyo eki yaarahukire kurahira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.40"
              },
              "items": [
                {
                  "text": "Lev 26:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.10.11"
              },
              "items": [
                {
                  "text": "Ezr 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu omuntu ku arimanya ku aine orubanja rwa kimwe ahari ebyo, ayature ekyo kibi ki akozire, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "areetere MUKAMA omwagazi gw'entaama nari ogw'embuzi ogw'omu busyo kuba empongano ey'okumwihisaho orubanja rw'ekibi eki akozire; omunyamurwa amuhongyerere empongano y'okurihiirira ekibi kye; nawe aryasaasirwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku ariba ari omworo otarikubaasa kureeta omwana gw'entaama, areete obwiba bubiri nari enkombe nto ibiri, azihongyere MUKAMA kuba empongano y'okumwihisaho orubanja rw'ekibi eki akozire, emwe ebe empongano ey'ekibi, endiijo ebe empongano ey'okwotsya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azireetere omunyamurwa, nawe abanze kutamba ey'empongano y'ekibi, agihotore ebitsya, agicweho omutwe, kwonka atagibaganisamu habiri; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "atware aha shagama y'egyo mpongano y'ekibi, agimiisiire aha rubaju rw'eitambiro; endiijo shagama yoona egikamuukyemu, neejwera ahansi aha kibunu ky'eitambiro; egyo n'empongano y'ekibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eya kabiri agihongye kuba empongano y'okwotsya, nk'omugyenzo ogwatairweho oku guri; omunyamurwa amuhongyerere empongano y'okurihiirira ekibi eki akozire, nawe aryasaasirwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
