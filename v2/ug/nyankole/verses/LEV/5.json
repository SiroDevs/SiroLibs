              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.5.7"
              },
              "items": [
                {
                  "text": "Kub 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi arihe eki asiisire ahari ekyo kintu ekirikwera, akyongyereho ekicweka kimwe kya kataano kyakyo, abihe omunyamurwa; bwanyima omunyamurwa amuhongyerere empongano y'egyo mpaya y'entaama ey'okwihaho orubanja, ebe empongano ey'okumurihiirira; kandi aryasaasirwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
