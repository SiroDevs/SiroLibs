              "type": "text"
            }
          ]
        },
        {
          "text": "Ijuka ekigambo eki waaragiire omugaragwa waawe ogwo, noogira oti: Ku muricumura, ndyabataataanisiza omu mahanga; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.8",
