              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hanaani, omwe ahari beene waitu, yaija n'abashaija nibaruga Yuda; naababuuza eby'Abayudaaya, abaahonokire batatwarwe omu bukwatwa, n'ebya Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
