              "items": [
                {
                  "text": "Fil 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abakuru abarikutegyeka gye bateekateekweho kuba abashemereire kuheebwa ekitiinisa kingi okukira abandi, na buzima abarikukora omurimo gw'okubuurira n'okwegyesa; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.17",
            "verseOrgIds": [
              "1TI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.4"
              },
              "items": [
                {
                  "text": "Bir 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.9"
              },
              "items": [
                {
                  "text": "1 Kor 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba Ebyahandiikirwe biragiira biti: Otariboha akanwa k'ente erikujunga engano. Kandi biti: Omukozi ashemereire ebihembo bye.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        }
      ]
    },
