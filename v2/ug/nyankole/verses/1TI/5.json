        },
        {
          "text": "Okuruga hati otarinywa amaizi gonka; kureka onywe viinyo nkye ahabw'enda yaawe, n'ahabw'okurwararwara kwawwe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
