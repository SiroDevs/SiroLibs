              "1TI.6.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.62.10"
              },
              "items": [
                {
                  "text": "Zab 62:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.20"
              },
              "items": [
                {
                  "text": "Luk 12:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebirikukwata aha batungi b'ensi egi, obeehanangirize barekye kwemanya, nari kwegamiza amatsiko gaabo aha butungi obutarikwesigwa, kureka bagagire ahari Ruhanga, otuha byona atarikubariirira, ngu tubishemerererwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.17",
            "verseOrgIds": [
              "1TI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bakore ebirungi, babe abatungi omu micwe mirungi, babe efura omu kugaba, bagire omutima gw'okukwatanisa n'abandi; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.18",
            "verseOrgIds": [
              "1TI.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
