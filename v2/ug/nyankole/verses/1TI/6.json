                "loc": "TIT.2.9"
              },
              "items": [
                {
                  "text": "Tit 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abahuuku boona abarikutegyekwa bamanye bakama baabo ku bashemereire kuheebwa ekitiinisa, buzima, eiziina rya Ruhanga n'enyegyesa yaitu birekye kujumwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.1",
            "verseOrgIds": [
              "1TI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.16"
              },
              "items": [
                {
                  "text": "Film 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaine bakama baabo abarikwikiriza bataribagaya ngu niho bari ab'eishe-emwe; kureka bakizeho okubakorera gye, ahabw'okuba abaine omugisha gw'okuheerezibwa okwo n'abantu abarikwikiriza kandi abarikukundwa. Ebyo guma obyegyese kandi obyehanangirize abantu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
