            "verseOrgIds": [
              "1TI.6.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.6+GAL.1.7+GAL.1.8+GAL.1.9"
              },
              "items": [
                {
                  "text": "Gal 1:6-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu weena oyegyesa okundi, akahakanisa ebigambo by'amazima ebya Mukama waitu Yesu Kristo n'enyegyesa erikwikirizana n'okutiina Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.3",
            "verseOrgIds": [
              "1TI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba ayekurize, kandi ataine ki arikumanya; arwaire endwara y'empaka n'okuhakana aha bigambo, ezriugwamu eihari n'okutongana n'okugambuurana n'okurengyerera, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.4",
            "verseOrgIds": [
              "1TI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.3.8"
              },
              "items": [
                {
                  "text": "2 Tim 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'empaka z'abantu abasiisikaire obwengye, abaihiirweho amazima, nibateekateeka ngu okutiina Ruhanga n'oburyo bw'okutunga enshaagi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
            "verseOrgIds": [
              "1TI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.11"
              },
              "items": [
                {
                  "text": "Fil 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Haza kunu okutiina Ruhanga, okurimu okumarwa, kurimu enshaagi nyingi; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.6",
            "verseOrgIds": [
              "1TI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.5.15"
              },
              "items": [
                {
                  "text": "Mub 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba titurareetsire kintu mu nsi, kandi titurikubaasa kwihamu kintu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.7",
            "verseOrgIds": [
              "1TI.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.30.8"
              },
              "items": [
                {
                  "text": "Enf 30:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku turaabe twine eby'okurya n'eby'okujwara, ebyo bigume bitumare. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.8",
            "verseOrgIds": [
              "1TI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.28.22"
              },
              "items": [
                {
                  "text": "Enf 28:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka abeetenga kuba abatungi bagwa omu kwohibwa n'omu mutego n'omu kwetenga kwingi kw'obushema okurikushiisha, kukaroha abantu omu kuconcoboza n'okuhwerekyerera. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.9",
            "verseOrgIds": [
              "1TI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba okwetenga empiiha n'omuzi gw'ebibi byona; hariho bamwe abaagiriire ebyo omururu, bakahaba, bakaruga omu kwikiriza, bakeecumitira kimwe n'enaku nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka iwe omuntu wa Ruhanga, oyetantare ebyo; okuratire okuhikiirira n'okutiina Ruhanga, okwikiriza, okukunda, okugumisiriza, n'obucureezi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.11",
            "verseOrgIds": [
              "1TI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.25"
              },
              "items": [
                {
                  "text": "1 Kor 9:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.7"
              },
              "items": [
                {
                  "text": "2 Tim 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rwana okurwana okurungi okw'okwikiriza, ohamize kimwe amagara agatahwaho, agu waayeteirwe, obu waagamba butunu okuhamya okurungi omu maisho ga baakareebi baingi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.12",
            "verseOrgIds": [
              "1TI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninkwehanangiriza omu maisho ga Ruhanga oha ebintu byona amagara, na Kristo Yesu, owaahamize okuhamya okurungi omu maisho ga Pontio Pilaato, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.13",
            "verseOrgIds": [
              "1TI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyorobere ekiragiro otaine kamogo, kandi otaine ki orikugaywaho okuhitsya aha kworekwa kwa Mukama waitu Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.14",
            "verseOrgIds": [
              "1TI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.14"
              },
              "items": [
                {
                  "text": "Kush 17:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " okuryorekwa omu bunaku bwakwo, Omutegyeki ogwo orikusiimwa omwe wenka, Omugabe w'abagabe, Omukama w'abakama, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.15",
            "verseOrgIds": [
              "1TI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "niwe wenka oine okutafa, otuura omu mushana ogutahikwaho, otakareebwaga muntu weena, kandi otabaasa kureebwa. Ekitiinisa n'obutegyeki obutahwaho bibe ebye. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.16",
            "verseOrgIds": [
              "1TI.6.16"
            ]
          }
        }
      ]
    },
    {
