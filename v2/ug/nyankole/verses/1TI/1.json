              "1TI.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.13+GAL.1.14+GAL.1.15+GAL.1.16"
              },
              "items": [
                {
                  "text": "Gal 1:13-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ninsiima Kristo Yesu Mukama waitu owampaire amaani, ahabw'okuba akanteekateekaho kuba omwesigwa, yampa omurimo gw'okumuheereza, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.12",
            "verseOrgIds": [
              "1TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'obu ndaabe obunyakare naamurogotsireho, nkamujuma, ndi omuntu enshaarizi; kwonka nkasaasirwa ahabw'okubikorera omu butamanya n'omu butaikiriza; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.13",
            "verseOrgIds": [
              "1TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi embabazi za Mukama waitu zikaba nyingi munonga hariinye hamwe n'okwikiriza n'okukunda okuri omuri Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.14",
            "verseOrgIds": [
              "1TI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.10"
              },
              "items": [
                {
                  "text": "Luk 19:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekigambo eki n'eky'okwesigwa, kishemereire kwikiririzibwa kimwe, ngu Kristo Yesu akaija omu nsi kujuna abasiisi; kandi omuri abo niinye w'okubanza; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.15",
            "verseOrgIds": [
              "1TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka eki naasaasiriirwe, Yesu Kristo akenda kworekyera omuriinye, omusiisi w'okubanza, eky'okureeberaho ahari abo abarimwikiriza kutunga amagara agatahwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.16",
            "verseOrgIds": [
              "1TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama otahwaho, otafa, otareebwa, Ruhanga Nyamuhanga, aheebwe ekitiinisa, ahimbisibwe ebiro n'ebiro. Amiina. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.17",
            "verseOrgIds": [
              "1TI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.3"
              },
              "items": [
                {
                  "text": "Yud 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omurimo ogwo naagukukwatsa, Timoseo mwana wangye, nk'ebi baanabi baabire bakugambireho, ngu bikwezirikise kurwana okurwana okurungi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.18",
            "verseOrgIds": [
              "1TI.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.10"
              },
              "items": [
                {
                  "text": "1 Tim 6:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " noohamya okwikiriza n'omutima murungi ogutarikweshinja, ogu abamwe baanagire hare, bakasiisikarirwa okwikiriza kwabo nk'obwato oku bufeera omu nyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.19",
            "verseOrgIds": [
              "1TI.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.5"
              },
              "items": [
                {
                  "text": "1 Kor 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri abo ni Humenaayo na Alegizanda, abu naarekyeire Sitaane, ngu bakaayega okutarogota.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.20",
            "verseOrgIds": [
              "1TI.1.20"
            ]
          }
        }
