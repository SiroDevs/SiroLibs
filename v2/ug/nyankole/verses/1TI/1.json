              "1TI.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.12"
              },
              "items": [
                {
                  "text": "Rom 7:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka itwe nitumanya ngu Ebiragiro ni birungi, omuntu yaaba naabikoresa nk'oku bishemereire, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.8",
            "verseOrgIds": [
              "1TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "naashoborokyerwa ngu Ebiragiro tibiratairweho habw'abahikiriire, kureka ahabw'abagomi n'abatarikuhurira, ahabw'abatatiina Ruhanga n'abasiisi, ahabw'abatarikwera n'abateeta ha bya Ruhanga, ahabw'abaita baishebo na baanyinabo, n'abaitsi b'abandi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.9",
            "verseOrgIds": [
              "1TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abashambani, n'abashaija abakorana eby'enshoni, n'abanyaga abantu bakabatunda, n'ababeihi, n'abarahira ebishuba, n'ebindi byona ebirikurwanisa enyegyesa ehikire, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.10",
            "verseOrgIds": [
              "1TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "erikukuratira engiri y'ekitiinisa eya Ruhanga orikusiimwa, ei naakwatsiibwe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
            "verseOrgIds": [
              "1TI.1.11"
            ]
          }
        }
      ]
    },
    {
