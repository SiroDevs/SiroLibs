          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.35+MRK.10.36+MRK.10.37+MRK.10.38+MRK.10.39+MRK.10.40+MRK.10.41+MRK.10.42+MRK.10.43+MRK.10.44+MRK.10.45"
              },
              "items": [
                {
                  "text": "Mak 10:35-45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima nyina wa beene Zebedaayo yaija ahari Yesu n'abatabani, yaamutsimbira amaju, aine eki arikwenda kumushaba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.28"
              },
              "items": [
                {
                  "text": "Mat 19:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaamubuuza ati: Nooyenda ki? Yaamugarukamu ati: Ragiira batabani bangye bombi bashutame omwe aha rubaju rwawe rwa buryo n'ondi aha rwa bumosho omu bukama bwawe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        }
      ]
    },
