              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaabeeta, yaabagira ati: Nimumanya abakuru b'abanyamahanga ku babategyekyesa eikama, n'abakuru baabo bakabaragiiza obushoboorozi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
