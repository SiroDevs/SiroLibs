              "type": "text"
            }
          ]
        },
        {
          "text": "n'orikwenda kuba ow'okubanza omuriimwe ashemereire kuba omuhuuku waanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
