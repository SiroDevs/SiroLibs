            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka omuriimwe tikwo kiriba; weena orikwenda kuba mukuru omuriimwe, ashemereire kuba omuheereza waanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
