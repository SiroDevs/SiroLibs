          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ahabw'ekyo mushabe Mukama w'eigyesha ayohereze abagyesi omu by'okugyesha bye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.38",
            "verseOrgIds": [
              "MAT.9.38"
            ]
          }
        }
