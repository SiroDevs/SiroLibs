              "attrs": {
                "loc": "MRK.5.22+MRK.5.23+MRK.5.24+MRK.5.25+MRK.5.26+MRK.5.27+MRK.5.28+MRK.5.29+MRK.5.30+MRK.5.31+MRK.5.32+MRK.5.33+MRK.5.34+MRK.5.35+MRK.5.36+MRK.5.37+MRK.5.38+MRK.5.39+MRK.5.40+MRK.5.41+MRK.5.42+MRK.5.43"
              },
              "items": [
                {
                  "text": "Mak 5:22-43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaabaire naakibagambira ebigambo ebyo, haija omukungu, yaamukwata amaguru, yaamweshengyereza ati: Muhara wangye yaakaba; mbwenu oije, omuteho engaro, naija kuhimbuuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.18",
            "verseOrgIds": [
              "MAT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaimuka, yaamukuratira n'abeegi be.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.19",
            "verseOrgIds": [
              "MAT.9.19"
            ]
          }
        }
      ]
    },
