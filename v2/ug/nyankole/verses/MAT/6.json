          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tihariho muntu orikubaasa kuheereza abakama babiri; ahakuba aryayangaho omwe, akunde ondi; nari aryagumira kyarimwe ahari omwe, agaye ondi. Timurikubaasa kuheereza Ruhanga na ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.24",
            "verseOrgIds": [
              "MAT.6.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:24",
              "type": "text"
            },
            {
              "text": "Mamona:",
              "type": "text"
            },
            {
              "text": "n'ekigambo ky'orurimi orurikwetwa “Aramaic”, amakuru ngu eitungo.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.24",
