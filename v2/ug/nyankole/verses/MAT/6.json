        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etabaaza ey'omubiri niryo riisho. N'ahabw'ekyo eriisho ryawe ku riraabe riri rirungi, omubiri gwawe gwona nigwija kwijura omushana; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka eriisho ryawe ku riraabe riri ribi, omubiri gwawe gwona nigwija kwijura omwirima. Mbwenu omushana oguri omuriiwe ku guraabe guri omwirima, omwirima ogwo ka ni mwingi!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.23",
            "verseOrgIds": [
              "MAT.6.23"
            ]
          }
        }
      ]
    },
