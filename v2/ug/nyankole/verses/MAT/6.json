                  "text": "Zab 37:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka mubanze musherure obukama bwe n'okuhikiirira kwe; n'ebyo byona muryabyongyerwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.33",
            "verseOrgIds": [
              "MAT.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo mutaryemereza emitima aha bya nyencakare; ahakuba ebya nyencakare biryayemererezibwa omutima okwabyo. Reka buri kiro kihwe n'amaganya gaakyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.34",
            "verseOrgIds": [
              "MAT.6.34"
            ]
          }
        }
