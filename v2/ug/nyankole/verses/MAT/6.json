                "loc": "LUK.11.2+LUK.11.3+LUK.11.4"
              },
              "items": [
                {
                  "text": "Luk 11:2-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo mushabe muti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.9",
            "verseOrgIds": [
              "MAT.6.9"
            ]
