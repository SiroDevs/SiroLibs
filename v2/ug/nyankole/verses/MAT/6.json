                {
                  "text": "Isa 58:5-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku muraabe nimwesiibyakwo, murekye kuba nk'endyarya, abeeyoreka baine enaku; ahakuba beeshiisha ahamaisho, ngu abantu babareebe ku beesiibizekwo. Buzimazima nimbagambira nti: Abo baherize kuheebwa ebihembo byabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka iwe, ku oraayesiibyekwo, ogume oyesiigye amajuta omu mutwe, onaabe ahamaisho, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu barekye kukureeba ku oyesiibizekwo, kureka Sho ori omu mubonano; kandi Sho oreeba eby'omu mubonano aryakuha ebihembo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.18",
            "verseOrgIds": [
              "MAT.6.18"
            ]
          }
        }
      ]
    },
    {
