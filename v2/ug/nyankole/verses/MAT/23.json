            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yerusaalemu, Yerusaalemu, oita baanabi, okateera abarikukutumwaho amabaare! Ka ni kaingi abaana baawe, nk'oku enkoko ebumbatira abaana baayo omunda y'amapapa gaayo, haza mutankundire! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
