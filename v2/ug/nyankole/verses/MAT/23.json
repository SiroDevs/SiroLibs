            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.6.6+MIC.6.7+MIC.6.8"
              },
              "items": [
                {
                  "text": "Mik 6:6-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muryakareeba, imwe abahandiiki n'Abafarisaayo, endyarya! ahabw'okuba muganura kimwe kya ikumi ky'esogi, na anisi, na kumino; kwonka mutsigaho ebigambo bikuru eby'omu Bragiro, okucwa emanja ez'amazima, n'embabazi, n'okwikiriza; ebyo mukaashemereire kubikora, kandi na biri okutabireka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe abeebembezi empumi, abagyegyena omubu, mukamira engamira!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.24",
            "verseOrgIds": [
              "MAT.23.24"
            ]
          }
        }
      ]
    },
