          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reeba, enju yaanyu etsigirweho n'omushaka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
