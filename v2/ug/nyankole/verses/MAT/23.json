                "loc": "MRK.12.38+MRK.12.39+MRK.12.40"
              },
              "items": [
                {
                  "text": "Mak 12:38-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Yesu akagaruka yaagira emitwe y'abantu n'abeegi be ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.1",
            "verseOrgIds": [
              "MAT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahandiiki n'Abafarisaayo bashutama aha kitebe kya Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.2",
            "verseOrgIds": [
              "MAT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.7"
              },
              "items": [
                {
                  "text": "Mal 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo ebi babaragiira byona, mubikore, kandi mubihitsye; kwonka mutarikora nk'oku bakora; ahabw'okuba bagamba, kwonka tibakora. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.3",
            "verseOrgIds": [
              "MAT.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakoma emitwaro erikuremeera, etarikubaasa kwekorerwa, bagyekoreza abantu aha mabega; kwonka bo tibenda kugitenzyaho n'orukumu rwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.4",
            "verseOrgIds": [
              "MAT.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.1"
              },
              "items": [
                {
                  "text": "Mat 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.38"
              },
              "items": [
                {
                  "text": "Kub 15:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.39"
              },
              "items": [
                {
                  "text": "39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebi bakora byona babikora kureebwa abantu; bahangutsya ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:5",
              "type": "text"
            },
            {
              "text": "Fulakateeri n'akantu akakozirwe omu ruhu, aku batamu ebigambo bikuru bikye eby'omu Biragiro, akajwarwa aha buso n'aha mukono gwa bumosho.",
              "type": "text"
            }
          ]
        },
        {
          "text": "fulakateeri zaabo, baraisya ebijwengye by'emyenda yaabo; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.7"
              },
              "items": [
                {
                  "text": "Luk 14:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.5"
              },
              "items": [
                {
                  "text": "Mat 6:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bakunda emyanya y'ekitiinisa omu magyenyi, n'ebitebe by'ekitiinisa omuri sinagogi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.6",
            "verseOrgIds": [
              "MAT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okutangirirwa omu katare, n'okwetwa abantu Rabi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.7",
            "verseOrgIds": [
              "MAT.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka imwe mutaryetwa Rabi, ahabw'okuba Omwegyesa waanyu n'omwe, kandi naimwe mwena muri eishe-emwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.8",
            "verseOrgIds": [
              "MAT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mutaryeta omuntu weena ow'omu nsi Shoimwe; ahabw'okuba mwine Shoimwe omwe ori omu iguru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.9",
            "verseOrgIds": [
              "MAT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mutaryetwa abakama, ahabw'okuba mwine Omukama omwe, niwe Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.10",
            "verseOrgIds": [
              "MAT.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orikukira obukuru omuriimwe aryaba omuheereza waanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.11",
            "verseOrgIds": [
              "MAT.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.29.23"
              },
              "items": [
                {
                  "text": "Enf 29:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.21.26"
              },
              "items": [
                {
                  "text": "Ezk 21:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.5"
              },
              "items": [
                {
                  "text": "1 Pet 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " orikwetunguura aryagarurwa ahansi; kandi orikwegarura ahansi, aryatunguurwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.12",
            "verseOrgIds": [
              "MAT.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.12",
            "verseOrgIds": [
              "MAT.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka muryakareeba, imwe Abahandiiki n'Abafarisaayo, endyarya! ahabw'okuba mukinga obukama bw'omu iguru, ngu abantu batabutaahamu; imwe mwenka timubutaahamu, kandi abarikwenda kubutaahamu, timubaikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.13",
            "verseOrgIds": [
              "MAT.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muryakareeba, imwe Abahandiiki n'Abafarisaayo, endyarya; ahabw'okuba munyaga enju z'abafaakazi, kandi murandagatana omu kushaba, haza kunu nimuryarya; n'ahabw'ekyo muryacwerwa orubanja orurikukira obuhango. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.14",
            "verseOrgIds": [
              "MAT.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muryakareeba, imwe Abahandiiki n'Abafarisaayo, endyarya! ahabw'okuba mwambuka enyanja, mugyendagyenda n'omu mahanga kuhindura omuntu omwe, ngu aikirize ediini yaanyu; kandi ku mumubona, mumuhindura omwana wa Gehena okukira emwe kabiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.15",
            "verseOrgIds": [
              "MAT.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
