                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Zab 118:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimbagambira nti: Timurindeeba okuruga hati okuhitsya obu murigira muti: Orikwija omu iziina rya Mukama asiimwe!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
