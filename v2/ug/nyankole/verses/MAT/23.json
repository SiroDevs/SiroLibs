          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.4"
              },
              "items": [
                {
                  "text": "Mak 7:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muryakareeba, imwe abahandiiki n'Abafarisaayo, endyarya! ahabw'okuba enkyeka n'enyabya mubyozya aharuguru, haza omunda biijwire obunyagi n'okuteerinda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe Omufarisaayo empumi, banza oyozye omunda y'enkyeka n'orwabya, aharuguru yaabyo habone kushemera. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.26",
            "verseOrgIds": [
              "MAT.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muryakareeba, imwe abahandiiki n'Abafarisaayo, endyarya! ahabw'okuba nimushusha nk'ebituuro ebisiigire einoni; aharuguru bikareebeka nk'ebishemeire, haza omunda biijwire amagufa n'oburofa bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo naimwe omu by'aharuguru mureebeka nka'abahikiriire omu maisho g'abantu, kwonka omunda mwijwire oburyarya n'obugomi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.28",
            "verseOrgIds": [
              "MAT.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
