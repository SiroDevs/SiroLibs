            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abafarisaayo ku baabaire bakiteeraine hamwe, Yesu yaababuuza ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.41",
            "verseOrgIds": [
              "MAT.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristo nimumuteekateekaho muta? N'Omwana w'oha? Baamugarukamu bati: N'Omwana wa Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
              "MAT.22.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaababuuza ati: Kandi shi ahanki Daudi, obu yaagambisibwa Omwoyo Orikwera, akamweta Mukama we ati:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.43",
            "verseOrgIds": [
              "MAT.22.43"
            ]
          }
        }
