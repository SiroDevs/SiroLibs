              "MAT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Heroode ku yaareebire abo banyabwengye bamureebize, yaagira ekiniga kingi, yaatuma abantu kwita abaana b'aboojo boona abaabaire bari Betelehemu n'omu kyanga ekyo kyona, abaabaire bahikize emyaka ebiri, kandi n'abatakagihikize, naihirira aha bunaku obu yaamanyisiibwemu abanyabwengye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.16",
            "verseOrgIds": [
              "MAT.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.15"
              },
              "items": [
                {
                  "text": "Yer 31:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu eki nabi Yeremia yaagambire kyahikiirizibwa, eki yaagizire ati:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.17",
            "verseOrgIds": [
              "MAT.2.17"
            ]
          }
        }
