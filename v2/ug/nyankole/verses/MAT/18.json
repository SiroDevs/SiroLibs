              "MAT.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
