              "GAL.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.13",
            "verseOrgIds": [
              "GAL.5.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.16"
              },
              "items": [
                {
                  "text": "1 Pet 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " B'eishe-emwe, mukeetwa ngu mugire obusingye; kwonka obusingye obu mutabuhindura orwekwatso rw'okukora eby'okwetenga kw'omubiri, kureka okukunda kubagyeme kuheerezana. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.13",
            "verseOrgIds": [
              "GAL.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba Ebiragiro bihikiirizibwa omu kigambo kimwe eki ngu: Kunda mutaahi waawe, nk'oku oyekunda. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.14",
            "verseOrgIds": [
              "GAL.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku muraabe nimurumana, mwaryana, mwerinde mutamaranaho.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.15",
            "verseOrgIds": [
              "GAL.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.15",
            "verseOrgIds": [
              "GAL.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka nyowe ningira nti: Mugume mugyendere omu Mwoyo; obwo nibwo mutarihikiiriza eby'okwetenga kw'omubiri; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.16",
            "verseOrgIds": [
              "GAL.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.15"
              },
              "items": [
                {
                  "text": "Rom 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba omubiri gurwanisa Omwoyo, kandi n'Omwoyo arwanisa omubiri; ahabw'okuba ebyo byombi birwanisana; n'ahabw'ekyo timurikubaasa kukora ki murikwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.17",
            "verseOrgIds": [
              "GAL.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.14"
              },
              "items": [
                {
                  "text": "Rom 8:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku mwebemberwa Omwoyo, muba mutakitegyekwa Biragiro. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.18",
            "verseOrgIds": [
              "GAL.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu emirimo y'obuzaarwa bw'omubiri neemanywa, niyo egi: obushambani, ebirikwitsa enshoni, okurigira okubi, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.19",
            "verseOrgIds": [
              "GAL.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuramya ebishushani, okuroga, obuzigu, okurwana, eihari, ekiniga, empaka, okwebaganisamu, okurwanira orubanju, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.20",
            "verseOrgIds": [
              "GAL.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.5"
              },
              "items": [
                {
                  "text": "Efe 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " okweangirana, obusinzi, okuraara enkyera, n'ebindi nk'ebyo. Nimbateisa, nk'oku naabateisize ira, nti: Abarikukora nk'ebyo tibarihungura bukama bwa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.21",
            "verseOrgIds": [
              "GAL.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ebyana by'Omwoyo nibyo ebi: okukunda, okushemererwa, obusingye, okugumisiriza, embabazi, oburungi, obwesigwa, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.22",
            "verseOrgIds": [
              "GAL.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.9"
              },
              "items": [
                {
                  "text": "1 Tim 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obucureezi, n'okwerinda; ebiri nk'ebyo tihariho kiragiro ekirikubizibira. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.23",
            "verseOrgIds": [
              "GAL.5.23"
            ]
          }
        },
