            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.2"
              },
              "items": [
                {
                  "text": "Byak 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ku haahingwireho emyaka ikumi n'ena, naagaruka nainamuka Yerusaalemu na Barunaba, naatwara na Tito. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nainamukayo ahabw'ebi naashuururiirwe; naabashobororera engiri ei mbuurira omu Banyamahanga, kwonka omu mubonano aha baabaire nibasiimwa ahabw'obukuru, ngu ndekye kushusha nk'orikwirukira busha, nari nk'owairukiire busha. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.3"
              },
              "items": [
                {
                  "text": "Byak 16:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nangwa na Tito ou twagyendaine, n'obu araabe ari Omugriika, taragyemirwe kusharwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.3",
            "verseOrgIds": [
              "GAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka hakaba hariho ab'eishe-emwe ab'ebishuba, abaataahire omuriitwe bwesherekye kutata obusingye bwaitu obu twine omuri Kristo Yesu, ngu batugarure omu buhuuku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo tituraboorobeire nangwa n'akaingana busha, ngu amazima g'engiri gabone kurindwa ahabwanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abo abaabaire nibasiimwa ngu ni bakuru oku baabaire bari ira, ebyo timbyetaireho; Ruhanga tashoroora mu bantu ahabw'obuganzi abakuru abo tibaine ki baanyongyeireho, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.15"
              },
              "items": [
                {
                  "text": "Byak 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka bakeetegyereza ku naakwatsiibwe engiri kugibuurira Abanyamahanga, nk'oku Petero yaagikwatsiibwe kugibuurira abashazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.7",
            "verseOrgIds": [
              "GAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Mumanye ngu Oawabaasize Petero kuba entumwa aha bashazirwe, naanye niwe yambaasize kuba entumwa aha Banyamahanga.) ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baayetegyereize omugisha ogu naahairwe, Yakobo na Keefa na Yohaana, abaabire nibasiimwe kuba enyomyo, baatuha omukono gwa buryo, nyowe na Barunaba, okworeka ku bakwataniise naitwe, ngu itwe tugyenda omu Banyamahanga, nabo omu bashazirwe; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.30"
              },
              "items": [
                {
                  "text": "Byak 11:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka eki baatushabire ni kimwe, n'okwijuka abooro; kandi ekyo naanye nkaba nkyezirikiire kukikora.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Keefa ku yaahikire Antiokia, naamuhakanisiza kimwe nitureebana, ahakuba akaba ashobize butunu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.3"
              },
              "items": [
                {
                  "text": "Byak 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba abaatumirwe Yakobo batakaizire, akaba naarya n'Abanyamahanga; kwonka ku baizire, yaayehinya, yaabeecwaho ahabw'okutiina abashazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.12",
            "verseOrgIds": [
              "GAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'Abayudaaya abandi baamutooreza, baakwatanisa nawe omu buryarya, nangwa na Barunaba nawe yaatwarwa obwo buryarya bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
            "verseOrgIds": [
              "GAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku naareebire bataakuratira mazima g'engiri, naagambira Petero omu maisho ga boona nti: Iwe ku oraabe nootwaza nk'Abanyamahanga, etari mitwarize y'ekiyudaaya, haza ori Omuyudaaya, ahabw'enki noogyema Abanyamahanga kutwaza nk'Abayudaaya? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itwe n'obu turaabe turi Abayudaaya enzaarwa, tutari basiisi b'Abanyamahanga, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.15",
            "verseOrgIds": [
              "GAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.10"
              },
              "items": [
                {
                  "text": "Byak 15:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.20"
              },
              "items": [
                {
                  "text": "Rom 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nitumanya ngu omuntu taihwaho rubanja habw'okuhikiiriza Ebiragiro, kureka ahabw'okwikiriza Yesu Kristo; kandi naitwe tukaikiriza Kristo Yesu, ngu tubone kwihwaho orubanja ahabw'okwikiriza Kristo, kunu ti habw'okuhikiiriza Ebiragiro; ahabw'okuba tihariho muntu weena oihwaho orubanja ahabw'okuhikiiriza Ebiragiro. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.16",
            "verseOrgIds": [
              "GAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka, ku turaabe twayenzire kwihwaho orubanja omuri Kristo, kandi tukashangwa turi abasiisi, mbwenu shi nimugira ngu Kristo naakwatsiza ekibi? Rubuuza! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.17",
            "verseOrgIds": [
              "GAL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba ku ngaruka kwombeka ebi naasheenyire, mba nyeyorekire ku ndi omusiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.18",
            "verseOrgIds": [
              "GAL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba nyowe ahabw'Ebiragiro nkafa aha Biragiro, ngu mbone kuba ohuriire ahari Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.19",
            "verseOrgIds": [
              "GAL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.23"
              },
              "items": [
                {
                  "text": "Yoh 17:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nkabambwa na Kristo; tinkiri nyowe ori, kureka Kristo niwe ari omuriinye; kandi amagara agu nyine omu mubiri ngaine ahabw'okwikiriza Omwana wa Ruhanga, owankunzire akeehayo ahabwangye. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.20",
            "verseOrgIds": [
              "GAL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tindikuhindura busha mbabazi za Ruhanga; ahakuba kuri okwihwaho orubanja kuheebwa ahabw'okuhikiiriza Ebiragiro, Kristo akaabaire afeereire busha.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.21",
            "verseOrgIds": [
              "GAL.2.21"
            ]
          }
        }
      ]
    }
