        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.20",
            "verseOrgIds": [
              "GAL.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe abarikwenda kutegyekwa Ebiragiro, nimungambire. Timuhurira Ebiragiro? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.21",
            "verseOrgIds": [
              "GAL.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.16.15"
              },
              "items": [
                {
                  "text": "Kut 16:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.2"
              },
              "items": [
                {
                  "text": "21:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimumanya ku kyahandiikirwe ngu: Abrahamu akaba aine abatabani babiri, omwe akaba ari ow'omuzaana, ondiijo ari ow'omukazi nyeiteeka. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.22",
            "verseOrgIds": [
              "GAL.4.22"
            ]
          }
        },
