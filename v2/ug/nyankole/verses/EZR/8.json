            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima naarangira ahari ogwo mugyera Ahava, ku habaho okwesiibyakwo, ngu tubone kwecureeza omu maisho ga Ruhanga waitu, tumuhabuzeho omuhanda gugororokire ahabwaitu, ahabw'abaana baitu abato n'ahabw'ebintu byaitu byona; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 8:22"
          },
          "items": [
