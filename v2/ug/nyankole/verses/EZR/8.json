                "loc": "NEH.2.9"
              },
              "items": [
                {
                  "text": "Neh 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba nkagira enshoni z'okushaba omugabe omutwe gw'engabo z'abaserukare n'ab'aha mbaraasi kturinda abazigu omu muhanda, ahakuba tukaba twagambiire omugabe tuti: Omukono gwa Ruhanga waitu guri aha barikumusherura boona kubagirira gye; kwonka amaani ge n'ekiniga kye birwanisa abamutsigaho boona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.22",
            "verseOrgIds": [
              "EZR.8.22"
            ]
          }
        },
        {
          "name": "verse",
