                  "text": "Ezr 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naabapimira efeeza n'ezaabu n'ebintu, ebyatoizirwe omugabe n'abahi b'obwengye be n'abatware be n'Abaisraeli boona abaabaire bari aho, ahabw'enju ya Ruhanga waitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntyo naabakwatsa etalanta z'efeeza magana mukaaga na makumi ataano, n'ebintu by'efeeza eby'etalanta igana n'etalanta z'ezaabu igana, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'enyabya z'ezaabu makumi abiri eza dariki rukumi, n'ebintu bibiri by'emiringa mirungi ekuubirwe eby'obuguzi bwingi nk'obw'ezaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
