            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " aha izooba rya kana twapimira efeeza n'ezaabu n'ebindi bintu omu nju ya Ruhanga waitu, twabikwatsa Meremoosi omunyamurwa mwene Uriya, owaabaire ari hamwe na Eleazaari mwene Finehaasi, bakwataniise n'Abaleevi Yozabaadi mene Yeshua na Noadia mwene Binui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
