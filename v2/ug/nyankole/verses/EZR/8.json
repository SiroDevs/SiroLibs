              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Byona byabarwa, byapimwa, kandi oburemeezi bwa buri kintu bwahandiikwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
