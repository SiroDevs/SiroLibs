              },
              "items": [
                {
                  "text": "Luk 9:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwoyo Orikwera yaamushuumaho nk'enkombe, omu kushushani ky'omubiri, n'eiraka ryayema omu iguru, nirigira riti: Niiwe Mwana wangye ou nkunda, kandi ou nshemerererwa munonga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        }
      ]
