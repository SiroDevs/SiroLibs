            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.19+JHN.1.20+JHN.1.21+JHN.1.22+JHN.1.23+JHN.1.24+JHN.1.25+JHN.1.26+JHN.1.27+JHN.1.28"
              },
              "items": [
                {
                  "text": "Yoh 1:19-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu boona ku baabaire bategyereize n'amatsiko, baayebuuza omu mitima yaabo ebya Yohaana ngu shana akaaba ari Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohaana yaabagarukamu boona naabagira ati: Buzima nyowe nimbabatiza n'amaizi: kwonka nihaija kwija Orikunkiza amaani, kandi tinshemereire n'okuyuzya orukoba rw'enkaito ze; Ogwo aryababatiza n'Omwoyo Orikwera n'omuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orugari rwe ruri omu mukono gwe, aryayeyerera gye embuga ye, ahunikye oburo omu kitara kye, kandi ebishushunga abyotsye omu muriro ogutaraara.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
