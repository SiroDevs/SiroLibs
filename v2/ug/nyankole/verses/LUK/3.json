          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka gwa ikumi n'etaano ogw'omu busingye bwa Tiberio Kaisaari, Pntio Pilaato obu yaabaire ari omutegyeki wa Buyudaaya, na Heroode ari ow'eishaza rya Galilaaya, n'omurumuna Filipo ari ow'eishaza rya Iturea na Tirakoniiti, na Lusania ari ow'eishaza rya Abileene, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.1",
            "verseOrgIds": [
              "LUK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi Ana na Kayaafa bari abanyamurwa abakuru, ekigambo kya Ruhanga kikaizira Yohaana mwene Zaakaria omu ihamba; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.2",
            "verseOrgIds": [
              "LUK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
