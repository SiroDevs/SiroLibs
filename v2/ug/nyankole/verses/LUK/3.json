                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu boona ku baaherize kubatizibwa, Yesu nawe yaabatizibwa; ku yaabaire naashaba, eiguru ryakinguuka, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
        {
          "name": "verse",
