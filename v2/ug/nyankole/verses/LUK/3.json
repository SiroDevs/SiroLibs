                "loc": "MRK.1.1+MRK.1.2+MRK.1.3+MRK.1.4+MRK.1.5+MRK.1.6+MRK.1.7+MRK.1.8"
              },
              "items": [
                {
                  "text": "Mak 1:1-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaagyenda omu byanga byona ebiri haihi na Yorudani, naabuurira okubatizibwa kw'okweteisa, ahabw'okusaasirwa ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.3",
            "verseOrgIds": [
              "LUK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.3+ISA.40.4+ISA.40.5"
              },
              "items": [
                {
                  "text": "Isa 40:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku kyahandiikirwe omu kitabo ky'ebigambo bya nabi Isaaya ngu:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
