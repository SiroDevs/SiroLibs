                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iwe Yerusaalemu, Yerusaalemu, oita baanabi, kandi oteera amabaare abakutumwaho! Ka ni kaingi obu naayenzire kubumbatira abaana baawe, nk'oku enkoko ebumbatira abaana baayo omunda y'amapapa gaayo, haza mutankundire! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
