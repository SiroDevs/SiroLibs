                {
                  "text": "Mal 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ogwo niwe yaahandiikirweho ngu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.27",
            "verseOrgIds": [
              "LUK.7.27"
            ]
          }
        }
