          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beitu mukaza kureebayo ki? Nabi? Eego, nimbagambira nti: N'okukira naakirira kimwe nabi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.26",
            "verseOrgIds": [
              "LUK.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 7:27"
          },
          "items": [
