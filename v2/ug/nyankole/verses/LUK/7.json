              "items": [
                {
                  "text": "18:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu yaagambira omukazi ati: Okwikiriza kwawe nikwo kwakujuna; gyenda n'obusingye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.50",
            "verseOrgIds": [
              "LUK.7.50"
            ]
          }
        }
