          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.50"
              },
              "items": [
                {
                  "text": "Mak 9:50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwonyo ni murungi; kwonka ku guraabe guhweirwemu ensha, muryagigaruramu muta? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niguba gutakishemererera musiri, n'obu rwakuba orubungo; bafa okugunaga. Oine amatu agarikuhurira, ahurire.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.35",
            "verseOrgIds": [
              "LUK.14.35"
            ]
          }
        }
      ]
    }
