              "items": [
                {
                  "text": "Ezk 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yangira ati: Iwe Danieli omushaija orikukundwa munonga, ta omutima aha bi ndikukugambira, kandi oyemerere gye; ahabw'okuba naakutumwaho. Ku yaabaire naakingambira ekyo kigambo, naayemerera nintetema. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.11",
            "verseOrgIds": [
              "DAN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
