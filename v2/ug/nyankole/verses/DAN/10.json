              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi reeba, omukono gwankoraho, gwantsiga nintetema, ntsimbire emikono n'amaju. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.10",
            "verseOrgIds": [
