              "items": [
                {
                  "text": "Kush 15:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku naimukize amaisho, naareeba omu shaija ojwaire omwenda gwa kitaani, ayezirikiise orukoba rw'ezaabu nungi eya Ufaazi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.5",
            "verseOrgIds": [
              "DAN.10.5"
            ]
          }
