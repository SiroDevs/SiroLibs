                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omubiri gwe gukaba nigushusha berulo, aha maisho ge nihashusha omurabyo, amaishoge nigashusha amatabaaza g'omuriro, emikono ye n'amaguru ge nibyengyengyeta nk'omuringa ogweziibwe, n'eiraka rye riri nk'ery'abantu baingi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.6",
            "verseOrgIds": [
              "DAN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.7"
              },
              "items": [
                {
                  "text": "Byak 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyowe nyenka, Danieli, niinye naareebire okwo kworekwa; abantu abu naabaire nyine tibarakureebire, kwonka bakatetema munonga, baahunga baaza kweshereka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.7",
            "verseOrgIds": [
              "DAN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.28"
              },
              "items": [
                {
                  "text": "Dan 7:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ntyo naatsigara nyenka, naareeba okwo kworekwa kuhango, omuriinye tihaatsigaramu twani twona, n'oburungi bwangye bwahindukira kimwe obujunde, amaani gampweramu kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.8",
            "verseOrgIds": [
              "DAN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.18"
              },
              "items": [
                {
                  "text": "Dan 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.17"
              },
              "items": [
                {
                  "text": "Kush 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima naamuhurira naagamba; ku naahuriire eiraka rye, naagwa ahansi njuumaire, naagwejegyerera kimwe, omutwe ngucurikire okuzimu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.9",
            "verseOrgIds": [
              "DAN.10.9"
            ]
          }
        }
