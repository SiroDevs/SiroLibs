          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu nkaanye omwiru waawe, Mukama wangye, nimbaasa kugamba naiwe? Ahabw'okuba tinkiine twani twona, n'omwitsyo gwampweiremu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.17",
            "verseOrgIds": [
              "DAN.10.17"
            ]
          }
        }
