            }
          ]
        },
        {
          "text": " Omu mwaka gwa kashatu ogw'omu busingye bwa Kuuro omugabe wa Buperesi ekigambo kikashuuruurirwa Danieli owaayetsirwe Beliteeshaza. Kandi ekyo kigmbo kikaba kkiri eky'amazima, nikimanyisa eby'orugamba rw'amaani. Yaakyetegyereza, ebi yaayorekirwe byamushoborokyera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.1",
            "verseOrgIds": [
              "DAN.10.1"
            ]
          }
        }
