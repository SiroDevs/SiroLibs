              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebyo, nyowe Danieli nkamara saabiiti ishatu ninganya; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.2",
            "verseOrgIds": [
              "DAN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.13"
              },
              "items": [
                {
                  "text": "Dan 10:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.17"
              },
              "items": [
                {
                  "text": "Mat 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi omu saabiiti ezo zoona tindariire k'okurya koona akanuzire; enyama n'obu yaakuba viinyo tibirahikire mu kanwa kangye, kandi tindeerabizeho kajuta koona. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.3",
            "verseOrgIds": [
              "DAN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.14"
              },
              "items": [
                {
                  "text": "Kut 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha kiro kya makumi abiri na bina omu kwezi kw'okubanza, nkaba nyemereire aha nkungu y'omugyera ogurikwetwa Hidekeeli; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.4",
            "verseOrgIds": [
              "DAN.10.4"
            ]
          }
        },
        {
