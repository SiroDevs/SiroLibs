              "items": [
                {
                  "text": "Kush 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo yangira ati: Danieli, otatiina, ahakuba okwiha aha izooba eri otandikiireho kutaho omutima kwetegyereza n'okwecureeza omu maisho ga Ruhanga waawe, ebigambo byawe bihuriirwe; kandi nikyo kyandeeta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.12",
            "verseOrgIds": [
              "DAN.10.12"
            ]
          }
        },
