                "loc": "ACT.10.4"
              },
              "items": [
                {
                  "text": "Byak 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.17"
