                {
                  "text": "2 Pet 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imwe amahanga goona, n'enganda zoona ez'endimi ezitari zimwe, abatwire omu nsi yoona, nyowe, omugabe Nebukadeneeza, naabahandiikira. Obusingye bukanye omuriimwe! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.3.26"
              },
              "items": [
                {
                  "text": "Dan 3:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kyanshemeza kworeka obumanyiso n'eby'okutangaaza ebi Ruhanga orikukira boona ankoreire.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.2",
            "verseOrgIds": [
              "DAN.4.2"
            ]
          }
        }
      ]
    },
