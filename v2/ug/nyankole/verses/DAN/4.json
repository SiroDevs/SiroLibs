                {
                  "text": "Bir 33:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebindi ebi ndeebire ndi aha kitanda kyangye nibyo ebi; ndeebire orikwera owaagizirwe omurinzi naashuuma naaruga omu iguru. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.13",
            "verseOrgIds": [
              "DAN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.10"
              },
              "items": [
                {
                  "text": "Mat 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaaragiira n'eiraka rihango naagira ati: Tema ekyo kiti, okikonkoboreho amataagi, okiiheho amababi, onaganagye ebijuma byakyo, enyamaishwa zihungye ahansi yaakyo, n'amahungu garugye omu mataagi gaakyo; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.14",
            "verseOrgIds": [
              "DAN.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka ekitsintsi okirekye kiri aha mizi yaakyo omu itaka omu bunyaatsi bw'omuroba obw'omu ishwa kibohirwe ebyoma n'emiringa, kigume nikitondwaho orume orurikuruga omu iguru, kandi kirye n'enyamaishwa obunyaatsi bw'omu ishwa; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "omutima gwakyo gurekye kuguma guri ogw'omuntu, kureka kiheebwe omutima gw'enyamaishwa; kigume kityo okumara omwanya nk'ogw'emyaka mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.16",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.21"
              },
              "items": [
                {
                  "text": "Dan 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.8"
              },
              "items": [
                {
                  "text": "1 Sam 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.5"
              },
              "items": [
                {
                  "text": "Yer 27:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekyo kifubiro kiragiirwe abarinzi, kyateebwaho ekigambo ky'abarikwera, ngu abakiriho abahuriire bamanye ngu Orikukira boona niwe ategyeka obugabe bw'abantu, kandi akabugabira ou arikwenda, akabwemekamu ab'ahansi okukira abandi boona. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.17",
            "verseOrgIds": [
              "DAN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.8"
              },
              "items": [
                {
                  "text": "Dan 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.8"
              },
              "items": [
                {
                  "text": "Kut 41:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekyo kirooto, nyowe omugabe Nebukadeneeza, niinye nkirootsire. Mbwenu iwe Beliteeshaza, okunshobororere, ahabw'okuba abanyabwengye boona tibarikubaasa kukinshobororera; kwonka iwe nookibaasa, ahabw'okuba omwoyo gwa baaruhanga abarikwera guri omuriiwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.18",
            "verseOrgIds": [
              "DAN.4.18"
            ]
          }
        }
      ]
    },
