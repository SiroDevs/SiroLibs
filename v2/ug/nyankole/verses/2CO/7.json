            "sid": "2CO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.1",
            "verseOrgIds": [
              "2CO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.2",
            "verseOrgIds": [
              "2CO.7.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.33"
              },
              "items": [
                {
                  "text": "Byak 20:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mmutwakiire omu mitima yaanyu; tihariho muntu weena ou twakozire kubi, tihariho ou twasiisire, tihariho ou twagobeize. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.2",
            "verseOrgIds": [
              "2CO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tindikugamba ekyo kubacwera orubanja; ahakuba nkabagambira kare, ku muri omu mitima yaitu okufa hamwe naitwe, kandi n'okuguma naitwe turi abahuriire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.3",
            "verseOrgIds": [
              "2CO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbeesiga buzima; niinyehimbisa munonga ahabwanyu; nyijwire obuhuumure; nangwa n'omu busaasi bwaitu bwona nyine okushemererwa okushaagire.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.4",
            "verseOrgIds": [
              "2CO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.4",
            "verseOrgIds": [
              "2CO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'obu twahikire Makedonia, emibiri yaitu teraboine kuhuumura na kakye, kureka tukagira obusaasi embaju zoona; aheeru hakaba hariyo engamba, omunda harimu obwoba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.5",
            "verseOrgIds": [
              "2CO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.13"
              },
              "items": [
                {
                  "text": "2 Kor 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Ruhanga, ohuumuza enshoberwa, akatuhuumuza ahabw'okwija kwa Tito; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.6",
            "verseOrgIds": [
              "2CO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ti kwija kwe kwonka, kureka n'okuhuumuzibwa oku yaahuumuziibwe omuriimwe, ku yaatuteekyerereize orushusho rwanyu oru munyiniire, n'okurira kwanyu n'obweziriki bwanyu ahabwangye; nikyo kyandeeteire kweyongyera kushemererwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.7",
            "verseOrgIds": [
              "2CO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.4"
              },
              "items": [
                {
                  "text": "2 Kor 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'obu ndaabe naabareeteire obusaasi ahabw'ebaruha ei naabahandiikiire, tindikwefuuza, (n'obu ndaabe naabandize kwefuuza); ekyanyefuuriise n'okureeba ngu ebaruha egyo ekabasaasa, n'obu muraabe mwasaasire omwanya mukye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.8",
            "verseOrgIds": [
              "2CO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka hati ninshemererwa, ti habw'okushaasha kwanyu, kureka ahabw'okushaasha oku mwagizire kukabareetera okweteisa; ahakuba mukashaasha omu buryo bwa Ruhanga, ngu mutagira eki mwafeerwa ahabwaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.9",
            "verseOrgIds": [
              "2CO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.3+MAT.27.4+MAT.27.5"
              },
              "items": [
                {
                  "text": "Mat 27:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumanye ngu okwefuuza okurimu kutiina Ruhanga kureeta okweteisa okutarikwefuuzibwa, okurikuhitsya aha kujunwa; kwonka okwefuuza okw'ensi kureeta okufa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.10",
            "verseOrgIds": [
              "2CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu mureebe okwefuuza oku okw'omu buryo bwa Ruhanga oku kwabareeteire okutaho munonga omutima, kukabareetera okwetonganira, n'okutamwa, n'obwoba, n'okwetenga, n'obweziriki, n'okuhana abarikushobya! Omuri byona mukeeyoreka ku mutaine rubanja omu kigambo ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.11",
            "verseOrgIds": [
              "2CO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'obu naabahandiikiire, tindabahandiikiire ahabw'ogwo owaasiisire, nari shi ahabw'ogwo owaasiisirwe, kureka ngu mushuuruurirwe obweziriki bwanyu oku buri ahabwaitu omu maisho ga Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.12",
            "verseOrgIds": [
              "2CO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.12",
            "verseOrgIds": [
              "2CO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo tukahuumuzibwa; kandi omu buhuumure obwo twayeyongyera kushemererwa munonga ahabw'okushemererwa kwa Tito, ahakuba mwena mukaruhuura omwoyo gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.13",
            "verseOrgIds": [
              "2CO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ndaabe naamugambiire ekigambo kyona eky'okwehimbisa ahabwanyu, tindakwatsirwe nshoni; kwonka nk'oku twabagambiire byona omu mazima, nikwo n'okwehimbisa kwaitu ahari Tito kwashangirwe kuri okw'amazima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.14",
            "verseOrgIds": [
              "2CO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku aijuka oku mwamworobeire mwena, mukamwakiira mwine obwoba n'okutetema, omutima gwe gweyongyera kubakunda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.15",
            "verseOrgIds": [
              "2CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanye ninshemererwa, ahabw'okuba omuri byona ngumire omutima ahabwanyu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.16",
            "verseOrgIds": [
              "2CO.7.16"
            ]
          }
        }
      ]
    }
  ],
