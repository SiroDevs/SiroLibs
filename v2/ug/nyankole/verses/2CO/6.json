          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timufunzire muriitwe, kureka mufunzire omu mitima yaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.12",
            "verseOrgIds": [
              "2CO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbagambira nk'abaana bangye, naimwe mushashaanukye, mukore nk'oku mwagiriirwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.13",
            "verseOrgIds": [
              "2CO.6.13"
            ]
