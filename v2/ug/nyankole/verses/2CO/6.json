              "type": "text"
            }
          ]
        },
        {
          "text": " Imwe Bakorinso 'mwe, akanwa kaitu kaabamarirayo, twabashashaanurira emitima yaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
            "verseOrgIds": [
              "2CO.6.11"
            ]
          }
