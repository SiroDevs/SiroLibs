              "type": "text"
            }
          ]
        },
        {
          "text": " Ahari ebyo bicweka oiheho rikye, orizingiririre omu kicweka kya ifo ky'ekanzu yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.3",
