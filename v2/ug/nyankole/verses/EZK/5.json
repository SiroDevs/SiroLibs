          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nikwo Mukama RUHANGA arikugamba naagira ati: Egi niyo Yerusaalemu, ei naataire ahagati y'amahanga n'ensi ezigyehinguriririize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.5",
            "verseOrgIds": [
              "EZK.5.5"
            ]
          }
        },
        {
          "name": "verse",
