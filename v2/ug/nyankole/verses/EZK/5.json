        {
          "text": " Kandi oihe rikye ahari eryo orinagye omu muriro, risye; aho niho omuriro guriruga gukahika aha nju ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.4",
            "verseOrgIds": [
              "EZK.5.4"
            ]
          }
