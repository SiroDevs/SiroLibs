            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ekagomera ebiragiro byangye, yaarengyesereza okukira ago mahanga, kandi ekagomera ebi naataireho okukira ezo nsi ezigyehinguriririize, ahabw'okwanga ebiragiro byangye n'okutagyendera mu bi naataireho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.6",
            "verseOrgIds": [
              "EZK.5.6"
            ]
