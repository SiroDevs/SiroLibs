          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi okuruga aha mahega gaaryo habeho amahembe ana ageemereire bwemi, oburaingwa bwa buri ihembe mukono gumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.15",
            "verseOrgIds": [
              "EZK.43.15"
            ]
          }
        },
        {
          "name": "verse",
