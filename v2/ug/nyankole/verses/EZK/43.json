          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahega g'eitambiro garyagira embaju ina ezirikwingaingana, oburaingwa mikono ikumi n'ebiri, n'obukiika mikono ikumi n'ebiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.16",
            "verseOrgIds": [
              "EZK.43.16"
            ]
          }
        },
