          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu nibwo buriba obwemi bw'eitambiro, okuruga ahansi aha kitebe kyaryo okuhika ah amukugiro gw'ahansi mikono ebiri, n'obukiika bwaryo mukono gumwe; kandi okuruga aha mukugiro omukye okuhika aha muhango mikono ena, n'obukiika mukono gumwe; n'amahega gaaryo mikono ena; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.14",
            "verseOrgIds": [
              "EZK.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
