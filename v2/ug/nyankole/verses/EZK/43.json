            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku oriheza kurishemereza kimwe, oryahonga enimi etaine kamogo, n'empaya y'entaama y'omu busyo etaine kamogo, ",
          "type": "text",
          "attrs": {
