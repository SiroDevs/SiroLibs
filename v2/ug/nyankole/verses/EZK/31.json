            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nayo yaagyenda nagwo Okuzimu, yaashangayo abaitsirwe rurara; eego n'abaabaire batwire omu kicuucu kyagwo baahwerekyerera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.17",
            "verseOrgIds": [
              "EZK.31.17"
            ]
          }
