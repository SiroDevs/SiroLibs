              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwaka gwa ikumi na gumwe omu kwezi kwa kashatu, aha kiro kyakwo ky'okubanza, ekigambo kya MUKAMA kikanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.1",
            "verseOrgIds": [
              "EZK.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana w'omuntu, gambira Faraho omugabe wa Misri n'enyanja ye y'abantu, omugire oti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
            "verseOrgIds": [
              "EZK.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
