              "items": [
                {
                  "text": "Mat 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu miti y'omuri Edeni ni muti ki ogurikwinganisa naiwe ekitiinisa n'obukuru? Kwonka oryagarurwa ahansi hamwe n'emiti y'omuri Edeni, ohikye Okuzimu owa Nyamuteza, obyame ahagati y'abatashazirwe hamwe n'abaitsirwe rurara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
      ]
    },
    {
