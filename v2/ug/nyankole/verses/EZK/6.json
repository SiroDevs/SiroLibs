                {
                  "text": "Ezk 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ndyagira omuriimwe abu naarokora. Ku muriba mwagizire abaahonoka ahari rurara omu mahanga, ku muriba mwataataaniire omu nsi zaago, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.8",
            "verseOrgIds": [
              "EZK.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.16"
              },
              "items": [
                {
                  "text": "Ezk 7:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.43"
              },
              "items": [
                {
                  "text": "20:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.15"
              },
              "items": [
                {
                  "text": "Kur 34:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bwanyima abarirokokaho omuriimwe baryanyijukira omu mahanga, ei bariba batwairwe bari enkwatwa, bamanye oku naahenzirwe emitima yaabo erikururuuha eyaanyimwire, n'amaisho gaabo agarikururuuha gakatwarwa ebishushani byabo ebirikuramibwa; baryayetamwa ahabw'ebihagaro byona ebi baakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.9",
            "verseOrgIds": [
              "EZK.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo baryamanya ku ndi MUKAMA, kandi eki naagambire nti: Ndyabareetaho ako kabi, ku ntarakigambiire busha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.10",
            "verseOrgIds": [
              "EZK.6.10"
            ]
          }
        }
      ]
