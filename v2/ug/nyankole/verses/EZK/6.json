                {
                  "text": "Ezk 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ori hare aryaitwa rurara, n'oriba yaatsigaireho agoteirwe omu rurembo, aryaitwa enjara. Okwo nikwo ndihikiiriza ekiniga kyangye aharibo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.12",
            "verseOrgIds": [
              "EZK.6.12"
            ]
          }
        },
