              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ekigambo kya MUKAMA kyanyijaho nikigira kiti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.1",
            "verseOrgIds": [
              "EZK.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.1"
              },
              "items": [
                {
                  "text": "Ezk 36:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwana w'omuntu, naga amaisho aha bibungo bya Israeli, obihanuurire ebiribigwera, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.2",
            "verseOrgIds": [
              "EZK.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.30"
              },
              "items": [
                {
                  "text": "Lev 26:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " noogira oti: Imwe bibungo bya Israeli 'mwe, muhurire ekigambo kya Mukama RUHANGA. Oku nikwo Mukama RUHANGA arikugambira enshozi, ebibungo, emigyera n'empanga, naagira ati: Reeba, nyowe, nyowe nyenka ndyabareetaho rurara, ncwekyereze emyanya yaanyu mikuru ey'okuramizamu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.3",
            "verseOrgIds": [
              "EZK.6.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.4"
              },
              "items": [
                {
                  "text": "Ezk 36:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.3",
            "verseOrgIds": [
              "EZK.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatambiro gaanyu garyacweka busha, n'ebishushani byanyu by'eizooba bisheenyagurwe, kandi emitumbi y'abantu baanyu abariitwa ndyaginaga omu maisho g'ebishushani byanyu ebirikuramibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.4",
            "verseOrgIds": [
              "EZK.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.14"
              },
              "items": [
                {
                  "text": "2 Bag 23:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi emitumbi y'Abaisraeli ndyaginaga omu maisho g'ebishushani byabo, nnaganagye amagufa gaanyu embaju zoona ez'amatambiro gaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.5",
            "verseOrgIds": [
              "EZK.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahu murituura hoona, endembo zaanyu ziryahinduka amatongo, n'myanya yaanyu mikuru y'okuramizamu eryasheenywa, amatambiro gaanyu gasheenywe, gacwekye busha; ebishushani byanyu ebirikuramibwa biryayatagurwa, bicwekyerezibwe, ebyoterero byanyu biihweho, n'emirimo yaanyu emarweho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.6",
            "verseOrgIds": [
              "EZK.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarikwitwa baryagwa ahaga tiyaanyu, mumanyireho ku ndi MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.7",
            "verseOrgIds": [
              "EZK.6.7"
            ]
          }
        }
      ]
    },
