            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.49.34+JER.49.35+JER.49.36+JER.49.37+JER.49.38+JER.49.39"
              },
              "items": [
                {
                  "text": "Yer 49:34-39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwo niyo Elamu eri, n'enyanja y'abantu baayo boona, bakiikiize ekituuro kyayo, boona abaitsirwe rurara, ekabagwisaho, bakashuuma Okuzimu owa Nyamuteza, bakabuzya okutiina omu nsi y'abahuriire, bakeemera enshoni zaabo hamwe n'abashuuma omu Kiina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.24",
            "verseOrgIds": [
              "EZK.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwariire ekitabo ahagati y'abaitsirwe hamwe n'enyanja y'abantu baayo boona, abu ebituuro byayo bigyehinguririize, abo boona n'abatashazirwe abaitsirwe rurara; ahabw'okuba okutiinisakwabo kukabuga omu nsi y'abahuriire, kandi baayemera enshoni zaabo hamwe n'abashuuma omu Kiina, baateebwa ahagati y'abaitsirwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        }
      ]
    },
