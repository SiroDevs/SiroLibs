                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwaka gwa ikumi n'ebiri, omu kwezi kwa ikumi n'abiri, aha kiro kyakwo ky'okubanza, ekigambo kya MUKAMA kikanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
