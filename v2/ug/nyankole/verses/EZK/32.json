            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.13"
              },
              "items": [
                {
                  "text": "Ezk 27:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwo niyo Mesheki na Tubali n'enyanja y'abantu baabo boona bari, beehinguririziibwe ebituuro byabo, boona abatashazirwe baitsirwe rurara; ahabw'okuba bakabuzya okutiinisa kwabo omu nsi y'abahuriire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.18"
              },
              "items": [
                {
                  "text": "Isa 14:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi tibabyami n'amamanzi ga ira agaagwire, gakashuuma Okuzimu n'eby'okurwanisa byago by'orugamba, gakeeshegura zaarurara zaago, n'engabo zaago ziaktungamira amagufa gaago; ahabw'okuba okutiinisa kwago kukaba kuri omu nsi y'abahuriire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo naimwe murihendeka, mukabyama n'abatashazirwe abaitsirwe rurara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        }
      ]
    },
