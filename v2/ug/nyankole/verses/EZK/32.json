                "loc": "EZK.29.2"
              },
              "items": [
                {
                  "text": "Ezk 29:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.3"
              },
              "items": [
                {
