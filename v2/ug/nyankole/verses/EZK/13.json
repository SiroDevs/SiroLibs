              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo Mukama RUHANGA arikugirira ati: Reeba, niinyanga engisha zaanyu ezi murikutegyesa abantu; ndyazibahuruutura aha mikono, ndekye abantu abu murikutega beegyendere nk'enyonyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.20",
            "verseOrgIds": [
              "EZK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
