              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebitambaara byanyu eby'okwetwekyerera ndyabibataagurira aha mutwe, njune abantu bangye, mbaihe omu mikono yaanyu; tibarigaruka kuba mu mikono yaanyu obundi nk'eminyago; kandi murymanya ku ndi MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.21",
            "verseOrgIds": [
              "EZK.13.21"
            ]
