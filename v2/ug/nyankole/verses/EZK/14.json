                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'obu abantu aba bashatu, Noa, Danieli na Yobu baakuba barimu, bakaakiza amagara gaabo bonka ahabw'okuhikiirira kwabo; nikwo Mukama RUHANGA arikugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.14",
            "verseOrgIds": [
              "EZK.14.14"
            ]
