          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.20"
              },
              "items": [
                {
                  "text": "Ezk 11:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.23"
              },
              "items": [
                {
                  "text": "37:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ab'enju ya Israeli barekye kugaruka kuhaba kundugaho, nari kugaruka kweshiisha n'ebicumuro byabo byona; kureka babe abantu bangye, naanye mbe Ruhanga waabo; nikwo Mukama RUHANGA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.11",
