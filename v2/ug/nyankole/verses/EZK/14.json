              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya MUKAMA kyagaruka kyanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.12",
            "verseOrgIds": [
