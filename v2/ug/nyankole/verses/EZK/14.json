            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nari shi, ku nditeeza ensi rurara, ningira nti: Ka rurara ebugye ensi, nigmaremu abantu n'amatungo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.17",
            "verseOrgIds": [
