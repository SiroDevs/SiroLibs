                {
                  "text": "Ezk 18:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo ogire enju ya Israeli oti: Oku nikwo Mukama RUHANGA arikugamba naagira ati: Mweteise, mutaane n'ebishushani byanyu, mwihe amaisho aha bihagaro byanyu byona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.6",
            "verseOrgIds": [
              "EZK.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabw'okuba ibara muntu ow'omu nju ya Israeli nari ow'omu banyamahanga owaabashuuhuukiremu orikumpararuka, akataasya omu mutima gwe ebishushani bye ebirikuramibwa, akata ekirikuteeza entsibo eky'okutahikiirira kwe omu maisho ge, haza akaza owa nabi ngu amuunyehanuuzeho, nyowe MUKAMA niinye ndimwegarukiramu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.7",
            "verseOrgIds": [
              "EZK.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
