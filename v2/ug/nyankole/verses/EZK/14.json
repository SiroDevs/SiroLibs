              "items": [
                {
                  "text": "15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwana w'omuntu, ensi ku erincumuraho, yaakora ebitari by'obwesigwa, naanye naagibangira omukono, naahenda eki erikwehimbagiririzaho, nibyo by'okurya byayo, naagiteeza enjara, naagimaramu abantu n'amatungo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.13",
            "verseOrgIds": [
              "EZK.14.13"
            ]
          }
        },
