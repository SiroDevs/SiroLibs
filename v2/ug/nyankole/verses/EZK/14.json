            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.11"
              },
              "items": [
                {
                  "text": "2 Tes 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi nabi ku aribeihwabeihwa, yaagira eki yaagamba, nyowe MUKAMA niinye ndiba mmubeihabeihire, ndyamubangira omukono, mmucwekyereze arugye omu bantu bangye Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.9",
            "verseOrgIds": [
              "EZK.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baryagiibwaho ekifubiro, ekifubiro kya nabi n'eky'orimwehanuuzaho biryaingana, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.10",
            "verseOrgIds": [
              "EZK.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 14:11"
          },
          "items": [
