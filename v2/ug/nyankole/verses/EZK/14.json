                  "text": "Lev 26:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku ndyohereza enyamaishwa kubuga ensi, zaagishiisha, yaaba amatongo, hataagira owaagirabamu ahabw'ezi nyamaishwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.15",
            "verseOrgIds": [
              "EZK.14.15"
            ]
          }
        },
        {
          "name": "verse",
