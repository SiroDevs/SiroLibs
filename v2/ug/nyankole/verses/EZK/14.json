            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ogwo mushaija ndyamuta omu kaso, mmugire eky'okureeberaho n'eky'okucweraho enfumu, mmucwere kimwe omu bantu bangye; kandi muryamanya ku ndi MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.8",
            "verseOrgIds": [
              "EZK.14.8"
            ]
          }
        },
        {
