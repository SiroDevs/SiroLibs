          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'obu abo bantu bonshatu baakuba barimu, niinyerahira, tibakaabaasa kukiza batabani baabo nari bahara baabo; bo bonka bakaakira, kwonka ensi yo ehinduka amatongo; nikwo Mukama RUHANGA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.16",
            "verseOrgIds": [
              "EZK.14.16"
            ]
          }
        },
