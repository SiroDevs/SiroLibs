                "loc": "EZK.8.1"
              },
              "items": [
                {
                  "text": "Ezk 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima bamwe aha bakuru ba Israeli baija ahi ndi, banshutama omumaisho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.1",
            "verseOrgIds": [
              "EZK.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya MUKAMA kyanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.2",
            "verseOrgIds": [
              "EZK.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.19"
              },
              "items": [
                {
                  "text": "Ezk 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.3"
              },
              "items": [
                {
                  "text": "20:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwana w'omuntu, aba bantu bataahize omu mitima yaabo ebishushani byabo ebirikuramibwa, baata ekirikuteeza entsibo eky'okutahikiirira kwabo omu maisho gaabo. Noogira ngu nshemereire kubaikiriza kugira ekintu kyona eki baanyehanuuzaho? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.3",
            "verseOrgIds": [
              "EZK.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu ogambe nabo, obagire oti: Oku nikwo Mukama RUHANGA arikugamba naagira ati: Ibara muntu ow'omu nju ya Israeli otaahize omu mutima gwe ebishushani bye ebirikuramibwa, akata ekirikuteeza entsibo eky'okutahikiirira kwe omu maisho ge, haza akaza owa nabi, nyowe MUKAMA niinye ndimwegarukiramu nimmutura omuna gw'ebishushani bye ebirikuramibwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.4",
            "verseOrgIds": [
              "EZK.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbone kukwata emitima y'ab'enju ya Israeli, abampararukire ahabw'ebishushani byabo ebirikuramibwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.5",
            "verseOrgIds": [
              "EZK.14.5"
            ]
          }
        }
      ]
    },
