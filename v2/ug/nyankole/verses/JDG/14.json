            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.11.6"
              },
              "items": [
                {
                  "text": "1 Sam 11:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.13"
              },
              "items": [
                {
                  "text": "16:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwoyo wa MUKAMA yaamwijaho n'amaani, yaashuuma Ashikelooni, yaitayo abashaija makumi ashatu, yaabanyaga, yaaha abaitsire ekyo kiito ebijwaro by'ekitiinisa. Yaagira ekiniga kingi, yainamuka, yaataaha omu ka ya ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.19",
            "verseOrgIds": [
              "JDG.14.19"
            ]
          }
        },
        {
