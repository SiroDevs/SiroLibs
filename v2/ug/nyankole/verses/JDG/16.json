                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu ku baamureebire, baasiima ruhanga waabo; ahakuba bakagira bati: Ruhanga waitu ahaireyo omu mikono yaitu omuzigu waitu obaire naahwerekyereza ensi yaitu, naatwitamu abantu baingi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.15"
              },
              "items": [
                {
                  "text": "Est 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima emitima yaabo ku yaashemerereirwe munonga, baagira bati: Mwete Samusooni, atuzaanire. Baayeta Samusooni kuruga omu nju y'embohe; yaabazaanira; baamuta ahagati y'enyomyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.25",
            "verseOrgIds": [
              "JDG.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusooni yaagambira omwojo owaabaire amukwaitse omukono, ati: Ka nkorakoze, nkwate enyomyo ezi enju ehamiizeho, nzeegamire. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.26",
            "verseOrgIds": [
              "JDG.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.8"
              },
              "items": [
                {
                  "text": "Bir 22:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.6"
              },
              "items": [
                {
                  "text": "Yos 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obwo enju ekaba eijwire abashaija n'abakazi; n'abategyeki b'Abafilistia boona bakaba barimu; kandi n'aha mutwe gw'enju hakaba hariho abantu nk'enkumi ishatu, abashaija n'abakazi, abaabaire nibareeba Samusooni oku arikubazaanira.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.27",
            "verseOrgIds": [
              "JDG.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
