              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.17",
            "verseOrgIds": [
              "JDG.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deila ku yaareebire yaamugambira omubonano gwe gwona, yaatuma kweta abategyeki b'Abafilistia naagira ati: Mwije obu bwonka, ahakuba yangambira omubonano gwe gwona. Ahonaaho abategyeki b'Abafilistia baija owe, baine empiiha omu ngaro zaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.18",
            "verseOrgIds": [
              "JDG.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.7.25"
              },
              "items": [
                {
                  "text": "Mub 7:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.7.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Delila yaamugwejegyereza aha maju ge; yaayeta omushaija, yaamugambira kumumwa obutsibo bw'eishokye rye mushanju; yaatandika kumwita kubi, amaani gaamuhweramu kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.19",
            "verseOrgIds": [
              "JDG.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
