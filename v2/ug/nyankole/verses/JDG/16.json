                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.5.3+PRO.5.4+PRO.5.5+PRO.5.6+PRO.5.7+PRO.5.8+PRO.5.9+PRO.5.10+PRO.5.11+PRO.5.12+PRO.5.13+PRO.5.14"
              },
              "items": [
                {
                  "text": "Enf 5:3-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Delila yaamugira ati: Noobaasa ota kugira oti, Ninkukunda, haza omutima gwawe gutandiho? Onshungiise emirundi egi yoona eshatu, kandi otarikungambira i amaani gaawe maingi gakomooka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.15",
            "verseOrgIds": [
              "JDG.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaamucondoorize munonga buri izooba, yaaguma naamujugutirira, Samusooni yaarugaho yaaremba; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.16",
            "verseOrgIds": [
              "JDG.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.2"
              },
              "items": [
                {
                  "text": "2 Bus 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.5"
              },
              "items": [
                {
                  "text": "Kub 6:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nikwo kumugambira omubonano gwe gwona, akamugira ati: Orumweiso tirukandabaga ha mutwe, ahakuba okwiha obu naaruga omu nda ya maawe, ntuura ndi Omunaziiri ahari Ruhanga. Ku baakuumwa, obwo nkaahwamu amaani, mba otaine maani, nk'abandi bantu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.17",
            "verseOrgIds": [
              "JDG.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
