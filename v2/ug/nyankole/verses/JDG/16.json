          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abategyeki b'Abafilistia baateerana abantu okutambira Dagoni ruhanga waabo ekitambo kihango, n'okwesiima; ahakuba bakagira bati: Ruhanga waitu ahaireyo Samusooni omuzigu waitu omu mikono yaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.23",
            "verseOrgIds": [
              "JDG.16.23"
            ]
          }
        },
