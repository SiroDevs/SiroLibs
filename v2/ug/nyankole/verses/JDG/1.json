                  "text": "Kut 28:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ab'omuryango gwa Yosefu baatuma ab'okutata Beseeli; (orwo rurembo ira rukaba rwetwa Luuzi;) ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.23",
            "verseOrgIds": [
              "JDG.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 1:24"
          },
          "items": [
