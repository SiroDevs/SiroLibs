                "loc": "ROM.8.31"
              },
              "items": [
                {
                  "text": "Rom 8:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.16"
              },
              "items": [
                {
                  "text": "Yos 17:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi MUKAMA yaaguma n'Abayuda, baakubuura ensi y'ebibungo; kwonka tibaabaasa kubinga abaabaire batwire omu mpita, ahabw'okuba bakaba baine ebigaari by'ebyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.19",
            "verseOrgIds": [
              "JDG.1.19"
            ]
          }
        },
