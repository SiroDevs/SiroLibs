              "type": "text"
            }
          ]
        },
        {
          "text": " kureka Abaasheri bakatuura n'Abanyakanaani, abatuuzi b'omuri egyo nsi, ahakuba tibarababingiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
