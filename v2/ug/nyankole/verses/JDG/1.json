            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kalebu yaaheebwa Heburooni, nk'oku Musa yaagambire, yaabingamu beene Anaki bonshatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.20",
            "verseOrgIds": [
              "JDG.1.20"
            ]
          }
        },
        {
