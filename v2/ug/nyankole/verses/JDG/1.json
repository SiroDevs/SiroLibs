              },
              "items": [
                {
                  "text": "1 Sam 30:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ezo ntatsi zaareeba omuntu naaruga omuri orwo rurembo, zaamugira ziti: Nitukweshengyereza, tworekye omuhanda ogurikuza omu rurembo; naitwe nitwija kukukorera eby'embabazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.24",
            "verseOrgIds": [
              "JDG.1.24"
            ]
          }
        },
        {
