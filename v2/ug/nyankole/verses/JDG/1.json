          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe yaabooreka omuhanda gurikuza omu rurembo, baarucwekyereza na rurara; kwonka ogwo mushaija baamureka n'ab'omu ka ye boona. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.25",
            "verseOrgIds": [
              "JDG.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija ogwo yaagyenda, yaataaha omu nsi y'Abahiiti, yaayombeka orurembo, yaarweta Luuzi; eryo niryo iziina ryarwo n'okuhitsya hati.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        }
