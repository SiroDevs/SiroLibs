          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi emyatano y'Abaamori ekaba neetandikira aharikwinamuka Akarabiimu, neiha ahari Seela n'okwinamuka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
