                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Ababenyamiini tibarabingire Abayebusi abaabaire batwire Yerusaalemu; kureka Abayebusi bakaguma batwire n'Ababenyamiini omuri Yerusaalemu n'okuhitsya hati. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.21",
            "verseOrgIds": [
              "JDG.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'omuryango gwa Yosefu nabo bainamuka, baateera Beseeli, MUKAMA yaaguma nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.22",
            "verseOrgIds": [
              "JDG.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 1:23"
          },
          "items": [
