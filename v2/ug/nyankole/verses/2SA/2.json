                "loc": "JDG.1.1"
              },
              "items": [
                {
                  "text": "Bar 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.23.2+1SA.23.3+1SA.23.4+1SA.23.5+1SA.23.6+1SA.23.7+1SA.23.8+1SA.23.9"
              },
              "items": [
                {
                  "text": "1 Sam 23:2-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'ebyo Daudi yaayehanuuza ahari MUKAMA naagira ati; Nyinamukye omu rurembo rumwe aha ndembo za Yuda? MUKAMA yaamugira ati: Inamuka. Daudi yaamubuuza ati: Nyinamukye omuri ruuha? Yaamugarukamu ati: Omuri Heburooni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Daudi yainamukayo n'abakazi be bombi, Ahinoamu owa Yezereeli, na Abigaili owaabaire ari muka Nabali owa Karumeeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.2",
            "verseOrgIds": [
              "2SA.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.27.2"
              },
              "items": [
                {
                  "text": "1 Sam 27:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Daudi yainamuka n'abantu abu yaabaire aine, buri muntu n'ab'omu ka ye; baatuura omu ndembo za Heburooni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.3",
            "verseOrgIds": [
              "2SA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.5"
              },
              "items": [
                {
                  "text": "2 Sam 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.11"
              },
              "items": [
                {
                  "text": "1 Sam 31:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abayuda baija, baashukiraho okwo Daudi amajuta kuba omugabe w'enju ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima baagambira Daudi ngu, Aba Yabeshi-gileadi nibo baziikire Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nikwo kubatumaho entumwa naabagira ati: MUKAMA abahe omugisha, ahabw'okuba mugiriire mukama waanyu Saulo embabazi, mwamuziika. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.5",
            "verseOrgIds": [
              "2SA.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.44"
              },
              "items": [
                {
                  "text": "Mat 5:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu MUKAMA abagirire embabazi, kandi abakorere eby'obwesigwa; naanye ndabazimuurira ahabw'eby'embabazi ebyo ebi mukozire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.6",
            "verseOrgIds": [
              "2SA.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo emikono yaanyu egire amaani, mube amamanzi; ahakuba Saulo mukama waanyu afiire, kandi ab'enju ya Yuda banshukireho amajuta kuba omugabe waabo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.7",
            "verseOrgIds": [
              "2SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.7",
            "verseOrgIds": [
              "2SA.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.8",
            "verseOrgIds": [
              "2SA.2.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.50"
              },
              "items": [
                {
                  "text": "1 Sam 14:50",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.55"
              },
              "items": [
                {
                  "text": "17:55",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu bunaku obwo Abuneeri mwene Neeri, omukuru w'engabo za Saulo, akaba atwaire Isheboshesi, mwene Saulo, amwambukize Mahanaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.8",
            "verseOrgIds": [
              "2SA.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "amwemekire kuba omugabe wa Gileadi na Ashura na Yezereeli na Efuraimu na Benyamiini na Israeli yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.9",
            "verseOrgIds": [
              "2SA.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Isheboshesi mwene Saulo akaba ahikize emyaka makumi ana obu yaaza aha ngoma kutegyeka Israeli, yaamara aha ngoma emyaka ebiri. Kwonka enju ya Yuda yaakurata Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.10",
            "verseOrgIds": [
              "2SA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwanya ogu Daudi yaamazire Heburooni ari aha ngoma naategyeka enju ya Yuda gukahika emyaka mushanju n'ameezi mukaaga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.11",
            "verseOrgIds": [
              "2SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.11",
            "verseOrgIds": [
              "2SA.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Abuneeri mwene Neeri, n'abagaragwa ba Isheboshesi mwene Saulo, baaruga Mahanaimu, baaza Gibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.12",
            "verseOrgIds": [
              "2SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yoabu mwene Zeruiya n'abagaragwa ba Daudi baashohora, baabugabugana nabo aha kiyanja kya Gibeoni; abamwe baashutama seeri yaacyo, abandi seenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.13",
            "verseOrgIds": [
              "2SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuneeri yaagira Yoabu ati: Abatsigazi baimukye, batuzaanire. Yoabu yaamugarukamu ati: Nibaimukye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo baimuka, baayambuka, baababara; ab'orubaju rwa Benyamiini na Isheboshesi mwene Saulo baaba ikumi na babiri, kandi ab'orubaju rwa Daudi nabo baaba ikumi na babiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.15",
            "verseOrgIds": [
              "2SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buri omwe yaagwa omuzigu we omu maraka, yaamutimbura rurara omu rubaju; boona baagwera kyarimwe, baafa. Nikyo omwanya ogwo gwayeteirwe Helukasi-hazurimu, oguri haihi na Gibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.16",
            "verseOrgIds": [
              "2SA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eryo izooba orugamba rwaba orw'amaani munonga; Abuneeri n'abashaija ba Israeli baasingurwa abagaragwa ba Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.17",
            "verseOrgIds": [
              "2SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.17",
            "verseOrgIds": [
              "2SA.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.18",
            "verseOrgIds": [
              "2SA.2.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.16"
              },
              "items": [
                {
                  "text": "1 Bus 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.12.8"
              },
              "items": [
                {
                  "text": "12:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi batabani ba Zeruiya bonshatu, Yoabu, Abishai na Asaheeli, bakaba bariyo; kandi Asaheeli ogwo akaba atarikwiruka, akaba ari esirabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.18",
            "verseOrgIds": [
              "2SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Asaheeli yaakurata Abuneeri amubingire; kandi omu kumubinga tiyaareeba ha rubaju rwa buryo nari orwa bumosho kuteishuka Abuneeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.19",
            "verseOrgIds": [
              "2SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuneeri ku yaareebire enyima, yaagira ati: Biri niiwe, Asaheeli? Onu ati: Niinye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuneeri yaamugira ati: Kikaama, otoore aha rubaju rwawe rwa buryo nari orwa bumosho, okwate omwe aha batsigazi, obe niwe waanyaga eby'okurwanisa. Kwonka Asaheeli yaayanga kumurugaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.21",
            "verseOrgIds": [
              "2SA.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuneeri yaagaruka yaagira Asaheeri ati: Toora ahandi orekye kunkurata; mbwenu ku naakucumita, naakutuura aha, okaazira ki? Kandi nkaareebana nta na Yoabu mwene sho? ",
          "type": "text",
          "attrs": {
