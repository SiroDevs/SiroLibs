        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu yaateera enzamba, engabo zaagaruka, zaareereera kukurata Abaisraeli, ahabw'okuzibirwa Yoabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.16",
            "verseOrgIds": [
              "2SA.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
