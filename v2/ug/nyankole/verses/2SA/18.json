              "items": [
                {
                  "text": "2 Sam 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ogwo Mukuushi yaija, yaagira ati: Ndeeteire mukama wangye omugabe amakuru; ahakuba eri izooba MUKAMA yaakuhoorera enzigu aha bantu boona ababaire baimukire kukurwanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.4"
              },
              "items": [
                {
                  "text": "2 Sam 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe yaabuuza Omukuushi ati: Omwojo ori Abusalomu ari buhooro? Omukuushi yaamugarukamu ati: Abazigu ba mukama wangye omugabe, n'abantu boona abaimukire kukukora kubi, nibakabe nk'ogwo mwojo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe yaashaasha munonga, yaatemba omu kishengye ky'aha mutwe gw'eirembo, yaarira; ku yaabaire naagyenda, yaagyenda naagira ati: Ai bambe omwana wangye Abusalomu! Omwana wangye, Omwana wangye Abusalomu! Kuri niinye naafa omu mwanya gwawe, ai bambe Abusalomu, mwana wangye, mwana wangye!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.18.33"
            ]
          }
