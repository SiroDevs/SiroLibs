              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batyo abantu baaza kurwanira n'Abaisraeli omu ishwa; orugamba rwatengyerwa omu kibira kya Efuraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.6",
            "verseOrgIds": [
              "2SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli baasingurirwayo abashaija ba Daudi; kandi eryo izooba haafa abantu obukumi bubiri, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.7",
            "verseOrgIds": [
              "2SA.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba orugamba rukaba rujanjaire omuri egyo ensi yoona; eryo izooba ekibira kyamara abantu baingi okukira abaitsirwe rurara.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
