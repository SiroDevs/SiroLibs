                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.29"
              },
              "items": [
                {
                  "text": "8:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baatwara Abusalomu, baamunaga omu kiina kihango ky'omu kibira, baamurundaho ekirundo kihango munonga ky'amabaare; Abaisraeli baahunga, buri muntu yaaza omu ka ye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.17",
            "verseOrgIds": [
              "2SA.18.17"
            ]
          }
        }
      ]
    },
