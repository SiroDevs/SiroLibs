              "2SA.18.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.14.26"
              },
              "items": [
                {
                  "text": "2 Sam 14:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abusalomu yaabugaabugana n'abashaija ba Daudi atakimanyire. Kandi Abusalomu akaba atembire enyumbu ye; egyo nyumbu yaamurabya ahansi y'amataagi g'omwela muhango agakwataine; omutwe gwe gwakwatirwa omuri ago mataagi, yaaguma, naareereetera omu mwanya, enyumbu ei yaabaire atembire yaagumizamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.9",
            "verseOrgIds": [
              "2SA.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija yaamureeba, yaagambira Yoabu ati: Naareeba Abusalomu ari omu mwela naareereeta. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.10",
            "verseOrgIds": [
              "2SA.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu yaabuuza owaamugambira ati: Ot'enki! Waamureeba! Ahabw'enki otaamucumita, okamutuura ahansi? Naaba ninkuha ebicweka by'efeeza ikumi n'orukoba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.11",
            "verseOrgIds": [
              "2SA.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.18.5"
              },
              "items": [
                {
                  "text": "2 Sam 18:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo mushaija yaagarukamu Yoabu ati: N'obu naakuheebwa ebicweka by'efeeza rukumi, tinkaabanga mukono gwangye kwita omwana w'omugabe; ahakuba twahurira omugabe naakwehanangiriza iwe, na Abishai na Itaayi ati: Mwerinde, hatagira owaakora ahari ogwo mwojo Abusalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.12",
            "verseOrgIds": [
              "2SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hoona kuri naabitwaza okundi, nkamureebya, (manya omugabe tagira ki asherekwa,) iwe waaba noija kubyejuura. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.13",
            "verseOrgIds": [
              "2SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu yaagira ati: Tinaaza kusiisira mwanya gwangye busha ningamba naiwe. Yaakwata emyambi eshatu omu ngaro, yaagitimbura Abusalomu omu mutima, akiri omu mwela ahuriire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.14",
            "verseOrgIds": [
              "2SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima abatsigazi ikumi abatwazi b'eby'okurwanisa bya Yoabu baayehinguririza Abusalomu, baamurezya, yaafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.15",
            "verseOrgIds": [
              "2SA.18.15"
            ]
          }
        }
      ]
    },
    {
