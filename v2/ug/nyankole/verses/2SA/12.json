            }
          ]
        },
        {
          "text": " Kwonka ahabw'ekyo eki okozire, okareetera abazigu ba MUKAMA kumujuma, omwana ogwo ozairwe buzimazima naija kufa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.14",
