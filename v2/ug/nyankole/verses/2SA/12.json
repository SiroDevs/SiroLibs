          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaatuma nabi Nasani, yaamweta Yedidiya ahabwa MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        }
