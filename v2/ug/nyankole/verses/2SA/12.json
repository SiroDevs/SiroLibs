              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Nasani yaagarukayo owe. MUKAMA yaarwza ogwo mwana, ou muka Uriya yaazaariire Daudi, yaaremba munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        },
        {
          "name": "verse",
