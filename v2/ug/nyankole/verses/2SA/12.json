                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.27"
              },
              "items": [
                {
                  "text": "1 Bag 21:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo Daudi yaayeshengyereza MUKAMA ahabwe; Daudi yaayesiibyakwo, yaataaha omu nju, yaabyama ahansi, bwarugaho bwasheesha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.16",
            "verseOrgIds": [
              "2SA.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru b'enju ye baamwemerera aha rubaju kumwimutsya ahansi, yaabangira, kandi tiyaarya nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.17",
            "verseOrgIds": [
              "2SA.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kya mushanju, ogwo mwana yaakaba. Abagaragwa ba Daudi baatiina kumugambira ku omwana yaakaba; ahakuba bakagira bati: Reeba, ku turaabe tumugambiire, omwana akihuriire, akanga kutuhurira, nitwija kumugambira tuta omwana yaakabire? Tarikwija kwekora kubi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.18",
            "verseOrgIds": [
              "2SA.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Daudi, ku yaareebire abagaragwa nibagambirana omu kutu, yaamanyira aho ku omwana yaakaba. Daudi yaababuuza ati: Omwana yaakaba? Baamugarukamu bati: Yaakaba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.19",
            "verseOrgIds": [
              "2SA.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.20"
              },
              "items": [
                {
                  "text": "Yob 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaimuka ahansi, yaayoga, yaayesiiga, yaahindura ebijwaro bye, yaataaha omu nju ya MUKAMA, yaaramya. Ku yaaherize, yaataaha omwe, yaashaba eby'okurya, baabimuta omumaisho, yaarya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.20",
            "verseOrgIds": [
              "2SA.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagaragwa be baamubuuza bati: Eki waakora ki? Oyesiibizekwo, waaririra omwana akihuriire; mbwenu omwana ku yaaheza kufa, waimuka waarya! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.21",
            "verseOrgIds": [
              "2SA.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.3.9"
              },
              "items": [
                {
                  "text": "Yon 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaagira ati: Omwana obu abaire akihuriire, nyesiibizekwo, naarira; ahakuba ngizire nti: N'oha orikumanya ngu MUKAMA tarikwija kungirira embabazi, omwana akagumaho? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.22",
            "verseOrgIds": [
              "2SA.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.7.8+JOB.7.9+JOB.7.10"
              },
              "items": [
                {
                  "text": "Yob 7:8-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu ka yaafiire, niinyesiibizakwo ki? Nimbaasa kumuhimbuura? Ndyamukurata, kwonka we taringarukira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        }
