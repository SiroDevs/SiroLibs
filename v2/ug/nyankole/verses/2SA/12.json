                "loc": "2SA.11.1"
              },
              "items": [
                {
                  "text": "2 Sam 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.20.1+1CH.20.2+1CH.20.3"
              },
              "items": [
                {
                  "text": "1 Bus 20:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri ebyo biro Yoabu yaarwanisa Rabba ey'Abaamoni, yaakwata orurembo rw'obugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.26",
            "verseOrgIds": [
              "2SA.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu yaatuma entumwa ahari Daudi, naagira ati: Ndwaniise Rabba, kandi naakwata orurembo rw'amaizi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.27",
            "verseOrgIds": [
              "2SA.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo oteerane engabo ezitsigaireho, ziteere ensiisira ahari orwo rurembo, obe niiwe waarukwata, ntakaarukwata, rukaanyetererwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.28",
            "verseOrgIds": [
              "2SA.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Daudi yaateerana engabo zoona, yaaza Rabba, yaagirwanisa, yaagikwata. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.29",
            "verseOrgIds": [
              "2SA.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaiha ekirunga aha mutwe gwa Milikomu, ekishushani kyabo ekirikuramibwa, oburemeezi bwakyo etalanta emwe y'ezaabu, ekyabaire kirimu eibaare ry'obuguzi bwingi; baakita aha mutwe gwa Daudi. Kandi omuri orwo rurembo yaanyagamu eminyago mingi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaihamu abantu abaabaire barimu, yaabashara n'emisimeeno n'ebyoma by'amaino, n'empango z'ebyoma, yaabarabya omu tanuuru z'amatafaari; okwo nikwo yaagizire endembo zoona ez'Abaamoni. Bwanyima Daudi n'engabo zoona baagaruka Yerusaalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.31",
            "verseOrgIds": [
              "2SA.12.31"
            ]
          }
        }
