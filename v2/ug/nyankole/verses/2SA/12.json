            }
          ]
        },
        {
          "text": " Daudi yaagira Nasani ati: Ncumwire ahari MUKAMA. Naasani yaagira Daudi ati: MUKAMA nawe yihaho ekibi kyawe; tokifa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        },
