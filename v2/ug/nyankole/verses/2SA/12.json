                "loc": "2SA.11.15"
              },
              "items": [
                {
                  "text": "2 Sam 11:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
