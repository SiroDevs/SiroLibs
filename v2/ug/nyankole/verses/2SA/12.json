                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.6"
              },
              "items": [
                {
                  "text": "Mat 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Daudi yaagumya omukazi we Betisheba, yaamuraarira; ebiro ku byahingwireho, yaamuzaarira omwana w'omwojo, yaamweta Sulemaani. Omwana ogwo MUKAMA yaamukunda; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
