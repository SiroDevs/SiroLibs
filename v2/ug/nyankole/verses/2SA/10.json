                "loc": "2SA.8.3"
              },
              "items": [
                {
                  "text": "2 Sam 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaamoni ku baamanyire ngu beetamiise Daudi, baatuma aha Basiria ba Besi-rehobu n'aba Zooba kubagurira ngu babahe engabo ezirikugyendesa ebigyere obukumi bubiri, n'omugabe wa Maaka kureeta engabo rukumi, n'aba Tobu kureeta kakumi n'enkumi ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.6",
            "verseOrgIds": [
              "2SA.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.8"
              },
              "items": [
                {
                  "text": "2 Sam 23:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi ku yaakihuriire, yaayohereza Yoabu n'eihe ryona ery'amamanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.7",
            "verseOrgIds": [
              "2SA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaamoni baashohora, baatenga orugamba aha irembo; kandi Abasiria ba Zooba n'aba Rehobu n'engabo za Tobu na Maaka bakaba bari ahakwabo omu ishwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.8",
            "verseOrgIds": [
              "2SA.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu ku yaareebire engabo zimuri omumaisho n'enyima, yaatoorana abashaija entoore omu Baisraeli boona, yaabatengyesa orugamba kurwana n'Abasiria; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.9",
            "verseOrgIds": [
              "2SA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "abandi boona yaabaha omurumuna Abishai, nawe yaabatengyesa orugamba kurwana n'Abaamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.10",
            "verseOrgIds": [
              "2SA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamugira ati: Abasiria ku barankize amaani, oije ompe emikono; kandi naiwe Abaamoni ku baraakukize amaani, naanye niinyija kugikuha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.11",
            "verseOrgIds": [
              "2SA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.6"
              },
              "items": [
                {
                  "text": "Bir 31:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.13"
              },
              "items": [
                {
                  "text": "1 Kor 16:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Guma omutima, turwane mashaija ahabw'eihanga ryaitu n'ahabw'endembo za Ruhanga waitu; kandi MUKAMA akore eki arikusiima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Yoabu n'engabo ezi yaabaire aine, bairira haihi kurwanisa Abasiria; Abasiria baabahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.13",
            "verseOrgIds": [
              "2SA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaamoni ku baareebire Abasiria baahunga, nabo baahunga Abishai, baataaha omu rurembo rwabo. Bwanyima Yoabu yaareka Abaamoni, yaagaruka Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.14",
            "verseOrgIds": [
              "2SA.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Abasiria ku baareebire babingirwe Abaisraeli baayeteerana. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.15",
            "verseOrgIds": [
              "2SA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.3"
              },
              "items": [
                {
                  "text": "2 Sam 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hadadezeeri yaatuma aha Basiria abaabaire batwire seeri y'omugyera Furaati baarugayo, baaza Helamu, beebembeirwe Shobaki omukuru w'eihe rya Hadadezeeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.16",
            "verseOrgIds": [
              "2SA.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baagambiire Daudi, nawe yaateerana Israeli yoona, baayambuka Yorudani, baaza Helamu, Abasiria baatenga orugamba, baarwana na Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.17",
            "verseOrgIds": [
              "2SA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasiria baahunga Abaisraeli, Daudi yaita omu Basiria abantu abarikurwanira aha bigaari magana mushanju, n'ab'aha mbaraasi obukumi buna, kandi baacumita Shobaki omukuru w'eihe ryabo, baamugwisaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.18",
            "verseOrgIds": [
              "2SA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.6"
              },
              "items": [
                {
                  "text": "2 Sam 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo bagabe boona abaabaire nibaheereza Hadadezeeri, ku baareebire baasingurwa Abaisraeli, baabeehongyera, baabatabaarira. N'ahabw'ekyo Abasiria baatiina kugaruka kuha Abaamoni emikono.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    }
