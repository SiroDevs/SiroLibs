              "items": [
                {
                  "text": "Byak 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oryayebarira saabiiti mushanju; ozibare noihirira aha bunaku obu oritandikiraho kuta omusyo gw'engyesho aha ngano zaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.22"
              },
              "items": [
                {
                  "text": "Enf 10:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oryarinda obugyenyi bwa saabiiti mushanju ahari MUKAMA Ruhanga waawe nooreeta omutoijo gw'empongano yaawe ogu oritoija n'omutima ogwekundiire, nk'oku MUKAMA Ruhanga waawe ariba akuhaire omugisha; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi oryayesiimira omu maisho ga MUKAMA Ruhanga waawe omu mwanya ogu MUKAMA aritoorana kugumyamu eiziina rye, iwe na mutabani waawe na muhara waawe n'omuhuuku waawe n'omuzaana waawe n'Omuleevi otwire omu marembo gaawe n'omunyaihanga n'efuuzi n'omufaakazi abatwire naimwe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.15"
              },
              "items": [
                {
                  "text": "Bir 15:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi oryaijuka ku waabaire ori omuhuuku omuri Misiri; ote omutima aha biragiro ebi ebyatairweho, kandi obyorobere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
