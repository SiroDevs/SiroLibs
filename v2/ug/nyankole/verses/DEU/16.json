          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buri mwaka abantu baawe boona abeetwa abashaija baryaguma bareebwe kashatu omu maisho ga MUKAMA Ruhanga waawe omu mwanya ogu aritoorana-aha bugyenyi bw'emigaati etatumbisiibwe, aha bugyenyi bwa saabiiti mushanju, n'aha bugyenyi bw'Ensiisira; kandi batarireebwa omu maisho ga MUKAMA engaro nsha; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
