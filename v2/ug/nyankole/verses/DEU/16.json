            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " oryashemererwa aha bugyenyi bwawe, iwe na mutabani waawe na muhara waawe n'omuhuuku waawe n'omuzaana waawe n'Omuleevi n'omunyaihanga n'efuuzi n'omufaakazi abatwire naiwe. ",
          "type": "text",
          "attrs": {
