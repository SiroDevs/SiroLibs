            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryamara ebiro mushanju noorinda obwo bugyenyi ahari MUKAMA Ruhanga waawe, ori omu mwanya ogu aritoorana; ahakuba MUKAMA Ruhanga waawe aryakuha omugisha omu bi oriba oyerize byona, n'omu bi oriba okozire n'emikono yaawe byona; kandi oshemerererwe kimwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        }
