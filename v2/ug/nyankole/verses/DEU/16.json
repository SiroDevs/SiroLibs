                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.28"
              },
              "items": [
                {
                  "text": "Heb 11:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oryaguma oijukye okwezi kwa Abibu, orinde obugyenyi bw'Okuhingurwaho ahari MUKAMA Ruhanga waawe; ahabw'okuba omu kwezi kwa Abibu nibwo MUKAMA Ruhanga waawe yaakwiha omuri Misri nyekiro. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.7"
              },
              "items": [
                {
                  "text": "1 Kor 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oryatambira MUKAMA Ruhanga waawe ekitambo ky'Okuhingurwaho, nookiiha omu masyo g'entaama nari ag'ente, okitambire omu mwanya ogu MUKAMA aritoorana kugumyamu eiziina rye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otarikiriisa omugaati gutumbisiibwe; oryamara ebiro mushanju nookiriisa omugaati gutatumbisiibwe, nigwo mugaati gw'okubonabona,–ahabw'okuba okaruga omu nsi ya Misri n'obwira,–obone kwijuka eizooba eri waarugiireho omu nsi ya Misri ebiro byawe byona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.3",
            "verseOrgIds": [
              "DEU.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otarireebwa oine ekitumbisa kyona omu nsi yaawe yoona okumara ebiro mushanju; kandi hatarigira enyama yoona ey'eikitambo, eki oritamba aha izooba ry'okubanza omu mwabazyo, eyaaraaraho okuhitsya omu kasheeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaritambira ekitambo ky'Okuhingurwaho omu rurembo rwona aha ndembo ezi MUKAMA Ruhanga waawe arikukuha; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.46"
              },
              "items": [
                {
                  "text": "Mat 27:46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka omu mwanya ogu MUKAMA Ruhanga waawe aritoorana kugumyamu eiziina rye, nimwo oritambira omwana gw'entaama gw'Okuhingurwaho omu mwabazyo, eizooba nirirengarenga, omu bunaku obu waarugiiremu Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.6",
            "verseOrgIds": [
              "DEU.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.8"
              },
              "items": [
                {
                  "text": "Kur 12:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oryagwotsya, oguriire omu mwanya ogu MUKAMA Ruhanga waawe aritoorana; kandi omu kasheeshe ohindukye ogarukye omu mahema gaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.7",
            "verseOrgIds": [
              "DEU.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryamara ebiro mukaaga noorya emigaati etatumbisiibwe, kandi aha kiro kya mushanju habeho okuteerana okwereziibwe MUKAMA Ruhanga waawe; otarikikoreraho omurimo gwona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        }
      ]
    },
