                "loc": "2CO.8.12"
              },
              "items": [
                {
                  "text": "2 Kor 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " buri muntu aryaguma ahe nk'oku arikubaasa, nk'omugisha ogu MUKAMA Ruhanga waawe ariba amuhaire oku guri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
