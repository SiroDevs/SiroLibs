          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku oriba waahikire omu nsi ei MUKAMA Ruhanga waawe arikukuha kuba obuhunguzi, waagikubuura, waagituuramu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.19"
              },
              "items": [
                {
                  "text": "Kur 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.9"
              },
              "items": [
                {
                  "text": "Enf 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " oryatwara emiganuro y'ebi oyerize omu misiri yaawe byona, ebi orishaaruura omu nsi ei MUKAMA Ruhanga waawe arikukuha, obite omu kiibo, obitware omu mwanya ogu MUKAMA Ruhanga waawe aritoorana kugumyamu eiziina rye, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ohikye aha munyamurwa oriba ariho omu biro ebyo, omugire oti: Eri izooba nimpamya omu maisho ga MUKAMA Ruhanga waawe, ku mpikire omu nsi ei MUKAMA yaarahiire naaraganisa baatatenkuriitwe kugituha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwo munyamurwa akwakiire ekyo kiibo, akite ahansi omu maisho g'eitambiro rya MUKAMA Ruhanga waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.5"
              },
              "items": [
                {
                  "text": "Kut 28:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.12.12"
              },
              "items": [
                {
                  "text": "Hos 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.22"
              },
              "items": [
                {
                  "text": "Bir 10:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.23+EXO.2.24+EXO.2.25"
              },
              "items": [
                {
                  "text": "Kur 2:23-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naiwe oryagarukamu ogambire omu maisho ga MUKAMA Ruhanga waawe, oti: Tatenkuru akaba ari Omuaramu, ari haihi kufa; bwanyima yaashuuma Misri n'abantu bakye, baashuhuukirayo; yaahindukirayo eihanga rikuru, ry'amaani, kandi ery'abantu baingi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamisri baatwita kubi, baatubonabonesa, baatukoresa emirimo y'obuhuuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.6",
            "verseOrgIds": [
              "DEU.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twatakira MUKAMA, Ruhanga wa baatatenkuriitwe, yaatuhurira, yaareeba okubonabona kwaitu, n'okufa kubi kwaitu n'okuhatwa kwaitu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.34"
              },
              "items": [
                {
                  "text": "Bir 4:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bwanyima MUKAMA yaatwiha omuri Misri n'omukono gw'amaani kandi ogubangire, n'ebirikutiinisa munonga, n'obumanyiso n'eby'okutangaaza; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.8"
              },
              "items": [
                {
                  "text": "Kur 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaatureeta omu mwanya ogu, yaatuha egi nsi y'amate n'obwoki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.9",
            "verseOrgIds": [
              "DEU.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu MUKAMA, reeba ndeetsire emiganuro y'ebyezire omu misiri ei wampaire. Bwanyima okite ahansi omu maisho ga MUKAMA Ruhanga waawe, oramize omu maisho ge, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.5.18+ECC.5.19+ECC.5.20"
              },
              "items": [
                {
                  "text": "Mub 5:18-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.46"
              },
              "items": [
                {
                  "text": "Byak 2:46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.47"
              },
              "items": [
                {
                  "text": "47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.17"
              },
              "items": [
                {
                  "text": "1 Tim 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " oshemerererwe ebirungi byona ebi MUKAMA Ruhanga waawe akuhaire n'eka yaawe, iwe n'Omuleevi n'omunyaihanga, abatwire naimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.24"
              },
              "items": [
                {
                  "text": "Kub 18:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.10"
              },
              "items": [
                {
                  "text": "Mal 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku oriheza kwiha kimwe kya ikumi ahari byona ebi oyerize omu mwaka gwa kashatu nigwo mwaka gw'okuheeramu kimwe kya ikumi, bwanyima okihe Omuleevi n'omunyaihanga n'efuuzi n'omufaakazi, kuriira owaawe, bahaagye; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.12",
            "verseOrgIds": [
              "DEU.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ogambire omu maisho ga MUKAMA Ruhanga waawe oti: Nyihire omu ka yangye ebintu ebishoroirwe, naabiha Omuleevi, omunyaihanga, efuuzi, n'omufaakazi, nk'ebiragiro byawe byona ebi wandagiire oku biri; omu biragiro byawe byona tihaine ki nshobize, nari eki nyebirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.4"
              },
              "items": [
                {
                  "text": "Hos 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tindabiriireho ndi omu rufu; tihariho bi naihireho nsiisikaire; kandi tihariho bi naagaburiire emizimu y'abafiire; kureka nkahurira eiraka rya MUKAMA Ruhanga wangye, naakora ebi wandagiire byona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.26"
              },
              "items": [
                {
                  "text": "2 Bus 6:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.15"
              },
              "items": [
                {
                  "text": "Isa 57:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naga amaisho ahansi nooyema omu iguru, omu mwanya gwawe ogurikwera, ohe abantu baawe Israeli omugisha, kandi n'ensi ei waatuhaire ogihe omugisha, ensi y'amate n'eobwoki, nk'oku waarahiire nooraganisa baatatenkuriitwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
