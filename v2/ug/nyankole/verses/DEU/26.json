            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi eri izooba MUKAMA yaagamba naahamya ku muri eihanga rye eri yaayetooraniire, nk'oku yaabaraganiise, kandi ku muriguma nimworobera ebiragiro bye, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
