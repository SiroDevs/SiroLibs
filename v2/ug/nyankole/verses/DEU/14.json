              "DEU.14.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30"
              },
              "items": [
                {
                  "text": "Lev 27:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.10.37"
              },
              "items": [
                {
                  "text": "Neh 10:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otaribura kuha kimwe kya ikumi eky'ebi oyeza omu misiri yaawe buri mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.22",
            "verseOrgIds": [
              "DEU.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryaguma oriire omu maisho ga MUKAMA Ruhanga waawe, omu mwanya ogu aritoorana kugumyamu eiziina rye, kimwe kya ikumi ky'engano zaawe, n'ekya viinyo yaawe n'eky'amajuta gaawe g'emizeituuni, n'emijigaijo y'amasyo gaawe g'ente n'ag'entaama, obone kwega kuguma nootiina MUKAMA Ruhanga waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.23",
            "verseOrgIds": [
              "DEU.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obundi MUKAMA Ruhanga waawe ku ariheza kukuha omugisha, orugyendo ruryakubeera ruraingwa, oremwe kukitwarayo ahabw'omwanya kukuba hare ogu MUKAMA Ruhanga waawe ariba atooraine kugumyamu eiziina rye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
