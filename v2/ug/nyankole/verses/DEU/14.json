        },
        {
          "text": "Ku kiriba kyabaire kityo, oryabiihamu efeeza, ozizingirire, ozitware omu mwanya ogu MUKAMA Ruhanga waawe ariba atooraine; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
