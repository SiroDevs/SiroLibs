                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muri abaana ba MUKAMA Ruhanga waanyu; mutaryesharashara n'obu kwakuba okwemwa omu buso, nari okumwa bahungu ahabw'okuba omu rufu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
