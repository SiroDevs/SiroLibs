          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "oziguremu ebi orikwenda byona, yaaba nte, nari entaama, nari viinyo, nari eky'okunywa eky'amaani, nari ekindi kyona eki omutima gwawe gurikwenda; obiriire omu maisho ga MUKAMA Ruhanga waawe n'ab'omu ka yaawe boona, mushemererwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
