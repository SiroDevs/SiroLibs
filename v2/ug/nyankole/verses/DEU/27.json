          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaayehanangiriza abantu eryo izooba, naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.11",
            "verseOrgIds": [
              "DEU.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.29"
              },
              "items": [
                {
                  "text": "Bir 11:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku muriheza kwambuka Yorudani, aba nibo baryemerera aha rushozi Gerizimu okushabira abantu omugisha; ab'oruganda rwa Simeoni, orwa Leevi, orwa Yuda, orwa Isakaari, orwa Yosefu n'orwa Benyamiini; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi aba nibo baryemerera aha rushozi Ebali ahabw'okukyeena; ab'oruganda rwa Reubeeni, orwa Gaadi, orwa Asheri, orwa Zebuluuni, orwa Daani n'orwa Nafutaali.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        }
      ]
