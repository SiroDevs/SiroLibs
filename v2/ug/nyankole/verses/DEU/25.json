                "loc": "EXO.17.8+EXO.17.9+EXO.17.10+EXO.17.11+EXO.17.12+EXO.17.13+EXO.17.14+EXO.17.15+EXO.17.16"
              },
              "items": [
                {
                  "text": "Kur 17:8-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwijukye oku Abaamaleki baabagizire nimuruga Misri, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "oku baababugaine omu muhanda, bakashanga muruhire, mugwire enshazi, bakaita abantu baanyu abaabaire bataine maani, batsigaire enyima; kandi tibaratiinire Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
