                "loc": "PSA.23.4"
              },
              "items": [
                {
                  "text": "Zab 23:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku murihurura kurwanisa abazigu baanyu, mwareeba embaraasi n'ebigaari, n'engabo ezirikukira ezaanyu, mutaribatiina; ahabw'okuba MUKAMA Ruhanga waanyu owaabaihire omu nsi ya Misri aryaba ari hamwe naimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.1",
            "verseOrgIds": [
              "DEU.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku muriba muri haihi kurwana, omunyamurwa airire haihi abantu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.2",
            "verseOrgIds": [
              "DEU.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "abagire ati: Muhurire, imwe Abaisraeli; eri izooba mwairira haihi abazigu baanyu kubarwanisa; emitima yaanyu etafoobeera; mutatiina, mutatetema, mutahahaaza emitima ahabwabo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.3",
            "verseOrgIds": [
              "DEU.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.30"
              },
              "items": [
                {
                  "text": "Bir 1:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.23.10"
              },
              "items": [
                {
                  "text": "Yos 23:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba MUKAMA Ruhanga waanyu niwe arikugyenda naimwe kubarwanira n'abazigu baanyu n'okubajuna. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.4",
            "verseOrgIds": [
              "DEU.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.27"
              },
              "items": [
                {
                  "text": "Neh 12:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'abakuru b'engabo baryabuuza abantu bati: Omuriimwe harimu obaire ayombekire enju nsya, otakagyerize; ku araabe ariho, agarukyeyo, ataahe omuri egyo nju, atakaafeera omu rugamba, ekeezibwa ondiijo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.5",
            "verseOrgIds": [
              "DEU.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hariho owaabyaire omusiri gw'emizaabibu, otakariire ha bijuma byagwo? Nawe agarukyeyo, ataahe omu ka ye, atakaafeera omu rugamba, ondiijo akabirya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.6",
            "verseOrgIds": [
              "DEU.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.5"
              },
              "items": [
                {
                  "text": "Bir 24:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hariho ogambire omukazi obugyenyi, otakamushweire? Nawe agarukyeyo, ataahe omu ka ye, atakaafeera omu rugamba, ondiijo akamushwera. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.7",
            "verseOrgIds": [
              "DEU.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.3"
              },
              "items": [
                {
                  "text": "Bar 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi abakuru b'engabo baryagaruka babuuze abantu bati: Omuriimwe harimu omuntu ekinyabwoba, ow'omutima gufoobeire? Ogwo nawe agarukyeyo, ataahe omu ka ye, emitima ya beene waabo etakaahaha nk'ogwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.8",
            "verseOrgIds": [
              "DEU.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bakuru b'engabo ku bariheza kugambira abantu ebigambo ebyo, bateho abakuru b'amahe kwebembera abantu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.9",
            "verseOrgIds": [
              "DEU.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.9",
            "verseOrgIds": [
              "DEU.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku murihika haihi n'orurembo kururwanisa, mubanze murugambire eby'obusingye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.10",
            "verseOrgIds": [
              "DEU.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.21"
              },
              "items": [
                {
                  "text": "1 Bag 9:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku ruribagarukamu eby'obusingye, rwabaigurira, boona abu murishangamu baryabakorera emirimo y'obuhuuku, kandi babaheereze. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.11",
            "verseOrgIds": [
              "DEU.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku ruryanga kuragaana naimwe eby'obusingye, kureka rwayenda kubarwanisa, muryarugota; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.12",
            "verseOrgIds": [
              "DEU.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA ku ariruhayo omu mikono yaanyu, muryaita oyetwa omushaija weena na rurara; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.13",
            "verseOrgIds": [
              "DEU.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.2"
              },
              "items": [
                {
                  "text": "Yos 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka abakazi n'abaana bato, n'ebirurimu byona, n'amatungo, niyo minyago yaamwo yoona mubyetwarire; kandi muryarya ebi murinyaga aha bazigu baanyu, ebi MUKAMA Ruhanga waanyu abahaire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.14",
            "verseOrgIds": [
              "DEU.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo muritwaza endembo zoona ezibari hare munonga, ezitari z'aga mahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.15",
            "verseOrgIds": [
              "DEU.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.2"
              },
              "items": [
                {
                  "text": "Kub 21:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.35"
              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.11.14"
              },
              "items": [
                {
                  "text": "Yos 11:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka omu ndembo ez'aga mahanga, ezi MUKAMA Ruhanga waanyu arikubaha kuba obuhunguzi, mutarigira ekintu kyona ekirikwitsya eki mwarokora; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.16",
            "verseOrgIds": [
              "DEU.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kureka muryabahwerekyerereza kimwe, Abahiiti, n'Abaamori, n'Abanyakanaani, n'Abaperizi, n'Abahiivi, n'Abayebusi, nk'oku MUKAMA Ruhanga waanyu yaabaragiire, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.17",
            "verseOrgIds": [
              "DEU.20.17"
            ]
          }
        },
        {
