                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nyentsya bataribeegyesa kutooreza ebihagaro byabo byona ebi baabaire nibakorera baaruhanga baabo, mukacumura ahari MUKAMA Ruhanga waanyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.18",
