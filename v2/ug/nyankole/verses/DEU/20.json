    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.18",
            "verseOrgIds": [
              "DEU.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku murimara omwanya muraingwa mugotsire orurembo nimururwanisa kurukwata, mutaritema emiti yaarwo n'empango, mukagiraza; ahabw'okuba obundi mukaabaasa kurya aha bijuma byayo; n'ahabw'ekyo mutarigitema. Nimugira ngu emiti y'omu ishwea nayo n'abantu, imwe okugigota? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.19",
            "verseOrgIds": [
