          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bunaku obwo nkeeshengyereza MUKAMA ningira nti: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.145.3"
              },
              "items": [
                {
                  "text": "Zab 145:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.145.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.18+JER.32.19+JER.32.20+JER.32.21"
              },
              "items": [
                {
                  "text": "Yer 32:18-21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.71.19"
              },
              "items": [
                {
                  "text": "Zab 71:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ai Mukama RUHANGA, otandikire kworeka omwiru waawe obukuru bwawe n'omukono gwawe ogw'amaani; ahakuba ni ruhanga ki omu iguru nari aha nsi, orikubaasa kukora emirimo nk'eyaawe, kandi n'eby'amaani ebi waakozire oku biri? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninkweshengyereza onyikirize nyambukye, ndeebe ensi egyo enungi eri seeri ya Yorudani, n'ebyo bibungo birungi na Lebanooni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
