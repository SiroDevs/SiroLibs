                  "text": "Kub 27:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka oyehanangirize Yoshua, omwezirikise, omugumye; ahabw'okuba niwe aryambuka ayebembeire aba bantu, akabahunguza ensi ei oraareebe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.28",
            "verseOrgIds": [
              "DEU.3.28"
            ]
          }
        },
