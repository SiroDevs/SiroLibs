        },
        {
          "text": " Kwonka MUKAMA yangwerwa kubi ahabwanyu, tiyaanyikiriza; yangira ati: Rekyera aho, otagaruka kungambira ahari ekyo kigambo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
