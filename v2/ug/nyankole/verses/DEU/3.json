          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inamuka oze aha mutwe gwa Pisiga, onagye amaisho oburengyerwa-izooba, n'aha bukiizi-bwa-bumosho, n'aha bwa buryo, n'oburugwa-izooba, oreebe n'amaisho gaawe; ahakuba toryambuka Yorudani egi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
