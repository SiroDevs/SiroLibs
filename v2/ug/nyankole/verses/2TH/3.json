        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.3"
              },
              "items": [
                {
                  "text": "Kol 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eky'aha muheru, B'eishe-emwe, mutushabire, ekigambo kya Mukama kirahukye kubuga, nikiheebwa ekitiinisa, nk'oku kyabaire omuriimwe, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.1",
            "verseOrgIds": [
              "2TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi naitwe tukire abantu babi abahabire; ahakuba abaine okwikiriza ti boona. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.2",
            "verseOrgIds": [
              "2TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.24"
              },
              "items": [
                {
                  "text": "1 Tes 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Mukama waitu n'ow'okwesigwa; aryabagumya, kandi abarinde Omubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.3",
            "verseOrgIds": [
              "2TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.10"
              },
              "items": [
                {
                  "text": "Gal 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi hoona twine obwesigye omuri Mukama ahabwanyu, ngu nimukora ebi turikubaragiira, kandi nimwija kugumizamu nimubikora. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.4",
            "verseOrgIds": [
              "2TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama waitu atebeekanise emitima yaanyu omu kukunda kwa Ruhanga n'omu kugumisiriza kwa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
            "verseOrgIds": [
              "2TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
