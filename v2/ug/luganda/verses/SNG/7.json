  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "SNG 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigere byo nga birabika bulungi mu ngatto,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "ggwe omumbejja!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "Amagulu go gali ng'amayinja ag'omuwendo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "omulimu gw'omuweesi omukalabakalaba.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekkundi lyo kibya kyekulungirivu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "ekitaggwaamu nvinnyo entabule obulungi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "Ekiwato kyo ntuumu ya ŋŋaano",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "eyeetooloddwa amalanga.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabeere go gali ng'abaana b'empeewo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:3"
      },
      "items": [
        {
          "text": "abalongo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensingo yo eri ng'omunaala ogw'amasanga.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "Amaaso go gali ng'ebidiba eby'omu Kesuboni",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "ebiri ku mulyango ogw'e Basulabbimu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "Ennyindo yo eri ng'omulongooti ogw'e Lebanooni",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "ogwolekera Ddamasiko.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutwe gwo gukuwoomera ng'olusozi Kalumeeri,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "n'enviiri zo ziranga emiguwa egy'effulungu;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "Kabaka asendebwasendebwa ebintu byakwo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'olabika bulungi, ng'osanyusa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:6"
      },
      "items": [
        {
          "text": "ggwe omwagalwa n'obulungi bwo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oli muwanvu ng'olukindu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:7"
      },
      "items": [
        {
          "text": "n'amabeere go gali ng'ebirimba eby'ebibala byakwo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayogera nti, \"Ndirinnya olukindu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "era ndikwata ebibala byalwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "Amabeere go gabeere ng'ebirimba eby'oku muzabbibu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "n'akawoowo ak'omu kamwa ko ng'ebibala eby'omucungwa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'akamwa ko nga nvinnyo esinga obulungi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "Omwagalwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "Ne wayini amirwe bulungi muganzi wange,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "ng'akulukuta mpola mpola ku mimwa gy'abo abeebase.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi wa muganzi wange,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:10"
      },
      "items": [
        {
          "text": "era naye anjagala nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jjangu, muganzi wange tugende ebweru w'ekibuga,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.11",
            "verseOrgIds": [
              "SNG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:11"
      },
      "items": [
        {
          "text": "tusuleko mu byalo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.11",
            "verseOrgIds": [
              "SNG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukeere tugende mu nnimiro z'emizabbibu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "tulabe obanga emizabbibu gimulisizza,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "obanga n'ebimuli byagwo byanjuluzza,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "obanga n'emikomamawanga gimulisizza,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "era eyo gye nnaakulagira okwagala kwange.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadudayimu",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.13",
            "verseOrgIds": [
              "SNG.7.14"
            ]
          }
        },
        {
          "text": "gawunya akawoowo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.13",
            "verseOrgIds": [
              "SNG.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:13"
      },
      "items": [
        {
          "text": "ne ku miryango gyaffe waliwo ebibala ebisinga obulungi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.13",
            "verseOrgIds": [
              "SNG.7.14"
            ]
          }
