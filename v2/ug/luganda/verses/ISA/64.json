    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okusingibwa Omusango mu Maaso ga",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale singa oyuzizza eggulu n'okka wansi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:1"
      },
      "items": [
        {
          "text": "ensozi ne zikankana mu maaso go!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'omuliro bwe gukoleerera mu buku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "oba nga bwe gufumba amazzi ne gatuuka okwesera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "ka wansi omanyise erinnya lyo eri abalabe bo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "n'amawanga galyoke gakankanire mu maaso go!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga bwe wakola ebintu eby'entiisa bye twali tetusuubira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:3"
      },
      "items": [
        {
          "text": "wakka ensozi ne ziryoka zikankanira mu maaso go.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva mu mirembe egy'edda teri yali awulidde",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "oba kutu kwali kutegedde,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "oba liiso lyali lirabye Katonda yenna okuggyako ggwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "alwanirira abo abamulindirira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojja n'odduukirira abo abakola eby'obutuukirivu n'essanyu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "abo abajjukira amakubo go.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "Naye bwe tweyongera okwonoona ne tugavaako, wakwatibwa obusungu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "Ebbanga ddene lye tumaze mu bibi byaffe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "ddala tulirokolebwa?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ffenna twafuuka batali balongoofu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "era obutuukirivu bwaffe buli nga nziina ezijjudde obukyafu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "Ffenna tuwotookerera ne tukala ng'ekikoola,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "era ebibi byaffe bitutwala nga mpewo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewali n'omu akoowoola linnya lyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "oba eyewaliriza okukukwatako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "kubanga watwekweka tetukyalaba maaso go,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "era n'otuwaayo ne tuzikirira olw'ebibi byaffe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate ng'era, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.64.8",
                "verseOrgIds": [
                  "ISA.64.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, ggwe Kitaffe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:8"
      },
      "items": [
        {
          "text": "Ffe tuli bbumba, ggwe mubumbi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:8"
      },
      "items": [
        {
          "text": "ffe ffenna tuli mulimu gwa mikono gyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosunguwala kisukkiridde nnyo, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.64.9",
                "verseOrgIds": [
                  "ISA.64.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "tojjukira bibi byaffe mirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "Weewaawo, tutunuulire, tusaba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "kubanga tuli bantu bo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibuga byo ebitukuvu bifuuse malungu ne Sayuuni kifuuse ddungu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:10"
      },
      "items": [
        {
          "text": "ne Yerusaalemi nakyo kifulukwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 64:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeekaalu yaffe entukuvu ey'ekitiibwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:11"
      },
      "items": [
        {
          "text": "bakitaffe gye bakutendererezangamu eyokebbwa omuliro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:11"
      },
      "items": [
        {
          "text": "era byonna eby'obugagga bye twakuumanga byazikirira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 64:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
