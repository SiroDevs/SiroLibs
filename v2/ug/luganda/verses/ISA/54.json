          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yimba ggwe omugumba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "atazaalanga;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "tandika okuyimbira mu ddoboozi ery'omwanguka osanyukire ddala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "ggwe atalumwanga kuzaala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "Kubanga ggwe eyalekebwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "ojja kuba n'abaana bangi okusinga oyo akyalina bba,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.54.1",
                "verseOrgIds": [
                  "ISA.54.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 54:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gaziya weema yo, owanvuye emiguwa gyayo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "tokwata mpola;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "nyweza enkondo zo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga olisaasaanira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "ku mukono gwo ogwa ddyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "era n'ogwa kkono,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "n'ezzadde lyo lirirya amawanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "era abantu bo balituula mu bibuga ebyalekebwa awo ebyereere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 54:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Totya kubanga toliddayo kukwatibwa nsonyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "Toggwaamu maanyi kubanga togenda kuswazibwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "Olyerabira ensonyi z'obuvubuka bwo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "n'ekivume ky'obwannamwandu bwo tolikijjukira nate.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 54:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Omutonzi wo ye balo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.54.5",
                "verseOrgIds": [
                  "ISA.54.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye lye linnya lye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "Omutukuvu wa Isirayiri ye Mununuzi wo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "Katonda ow'ensi yonna, bw'ayitibwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 54:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.54.6",
                "verseOrgIds": [
                  "ISA.54.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda yakuyita okomewo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "ng'omukazi eyali alekeddwawo ng'alina ennaku ku mutima;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "omukazi eyafumbirwa ng'akyali muto, n'alekebwawo,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "bw'ayogera Katonda wo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 54:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nakulekako akaseera katono nnyo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.7",
            "verseOrgIds": [
              "ISA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:7"
      },
      "items": [
        {
          "text": "naye ndikukuŋŋaanya n'okusaasira okungi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.7",
            "verseOrgIds": [
              "ISA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 54:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusungu obubuubuuka bwe bwankwata",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "nakweka amaaso gange okumala ekiseera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "naye ndikukwatirwa ekisa n'okwagala okutaliggwaawo,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.54.8",
                "verseOrgIds": [
                  "ISA.54.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "Omununuzi wo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 54:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kubanga gye ndi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "bino biri nga bwe byali mu biseera bya Nuuwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "Nga bwe nalayira nti amazzi ga Nuuwa tegagenda kuddamu kulabikako ku nsi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "bwe ntyo ndayira nti siriddayo kukusunguwalira wadde okukunenya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
