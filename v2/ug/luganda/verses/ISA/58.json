  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "58",
        "style": "c",
        "sid": "ISA 58"
      },
      "items": [
        {
          "text": "58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okusiiba okw'Amazima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 58:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyogere mu ddoboozi ery'omwanguka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "tokisirikira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "Yimusa eddoboozi lyo ng'ekkondeere,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "obuulire abantu bange okusobya kwabwe, n'ennyumba ya Yakobo ebibi byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 58:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga bannoonya buli lunaku",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "era beegomba okumanya amakubo gange,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "nga bali ng'abantu abakola eby'obutuukirivu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "so si abaaleka edda ebiragiro bya Katonda waabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "Bambuuza ensala ennuŋŋamu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "ne basanyukira Katonda okusembera gye bali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 58:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beebuuza nti, \"Lwaki twasiiba, naye ggwe n'otokifaako?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "Lwaki twetoowaza naye ggwe n'otokissaako mwoyo?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "Musooke mulabe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "ennaku ze musiiba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "muba munoonya ssanyu lyammwe ku bwammwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "musigala munyigiriza abakozi bammwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 58:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njagala mulabe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "Kalungi ki akali mu kusiiba ng'ate mugenda kudda mu nnyombo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "n'okukaayana n'okukuba bannammwe agakonde.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "Temuyinza kusiiba nga bwe mukola kaakano eddoboozi lyammwe ne liwulirwa mu ggulu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 58:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okusiiba kwe nalonda bwe kutyo bwe kufaanana?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "Olunaku omuntu lw'eyetoowalizaako?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "Kukutamya bukutamya mutwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "kuguweta nga lumuli n'okugalamira mu bibukutu mu vvu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "Okwo kwe muyita okusiiba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "olunaku olusiimibwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.58.5",
                "verseOrgIds": [
                  "ISA.58.5"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 58:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuno kwe kusiiba kwe nalonda;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "okusumulula enjegere ezinyigiriza abantu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "n'okuggyawo emiguwa gy'ekikoligo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "n'okuta abo abanyigirizibwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "n'okumenya buli kikoligo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 58:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si kugabira bayala ku mmere yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "n'okusembeza abaavu abatalina maka mu nnyumba yo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "bw'olaba ali obwereere, n'omwambaza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "n'otekweka baŋŋanda zo abeetaaga obuyambi bwo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 58:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omusana gwo gulyoke guveeyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "gwake ng'emmambya esala, era okuwonyezebwa kwo kujje mangu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "obutuukirivu bwo bukukulembere,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "era ekitiibwa kya Katonda kikuveeko emabega.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 58:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo olikoowoola,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.9",
            "verseOrgIds": [
              "ISA.58.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.58.9",
                "verseOrgIds": [
                  "ISA.58.9"
                ]
              }
            }
          ]
        },
        {
          "text": "n'akuddamu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.9",
            "verseOrgIds": [
              "ISA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:9"
      },
      "items": [
        {
