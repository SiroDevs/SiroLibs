  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "ISA 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katonda bye Yayogera Bituukirira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muwulire kino, mmwe ennyumba ya Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "abayitibwa erinnya lya Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "era abaava mu nda ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "Mmwe abalayirira mu linnya lya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.1",
                "verseOrgIds": [
                  "ISA.48.1"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "era abaatula Katonda wa Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "naye si mu mazima wadde mu butuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga beeyita ab'ekibuga ekitukuvu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:2"
      },
      "items": [
        {
          "text": "abeesiga Katonda wa Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.2",
                "verseOrgIds": [
                  "ISA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye lye linnya lye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva ku ntandikwa, nayasanguza ebyali bigenda okubaawo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "byava mu kamwa kange ne mbyogera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "Amangwago ne tubikola ne bituukirira.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga namanya obukakanyavu bwammwe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "ebinywa by'ensingo nga bikakanyavu ng'ekyuma;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "ekyenyi ng'ekikomo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabamanyisizaawo edda ebyali bigenda okujja nga tebinnabaawo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "muleme kugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "\"Bakatonda bange be baabikola:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "Ekifaananyi kyange ekyole",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "n'ekifaananyi ekisaanuuse bye byakikola.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulabe ebintu bino nabibagamba dda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "era temubikkirize?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 48:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "\"Okuva leero nzija kubabuulira ku bintu ebiggya ebigenda okujja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "eby'ekyama bye mutawulirangako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbikola kaakano,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "so si ekiseera ekyayita:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "mwali temubiwulirangako mu biseera eby'emabega",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "si kulwa nga mugamba nti, 'Laba nnali mbimanyi.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Towulirangako wadde okutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "Okuva edda n'edda okutu kwo tekuggukanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "Kubanga namanya nti wali kyewaggula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "okuva ku kuzaalibwa kwo wayitibwa mujeemu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'erinnya lyange",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "ndwawo okusunguwala. Olw'ettendo lyange",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "ndwawo okukusunguwalira nneme okukuzikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba nkugezesezza naye si nga ffeeza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.10",
            "verseOrgIds": [
              "ISA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:10"
      },
      "items": [
        {
          "text": "Nkugezesezza mu kirombe ky'okubonaabona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.10",
            "verseOrgIds": [
              "ISA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lwange nze,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:11"
      },
      "items": [
        {
          "text": "ku lwange nze ndikikola. Erinnya lyange nga livumiddwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:11"
      },
      "items": [
        {
          "text": "Ekitiibwa kyange sirikiwa mulala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
