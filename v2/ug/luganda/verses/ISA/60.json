  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "60",
        "style": "c",
        "sid": "ISA 60"
      },
      "items": [
        {
          "text": "60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekitiibwa kya Sayuuni Ekijja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 60:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yimuka, oyake, kubanga ekitangaala kyo kizze kyase",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:1"
      },
      "items": [
        {
          "text": "era ekitiibwa kya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.1",
                "verseOrgIds": [
                  "ISA.60.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kikwakirako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 60:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga laba ensi eribikkibwa ekizikiza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "era n'ekizikiza ekikutte ennyo kibikke abantu baamawanga gonna,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "naye ggwe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.2",
                "verseOrgIds": [
                  "ISA.60.2"
                ]
              }
            }
          ]
        },
        {
          "text": "alikwakirako",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "era ekitiibwa kye kikulabikeko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 60:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawanga galijja eri omusana gwo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.3",
            "verseOrgIds": [
              "ISA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:3"
      },
      "items": [
        {
          "text": "ne bakabaka eri okumasamasa okunaakubangako ng'ojja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.3",
            "verseOrgIds": [
              "ISA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 60:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yimusa amaaso go olabe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "abantu bo bonna bakuŋŋaana okujja gy'oli",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "batabani bo abava ewala ne bawala bo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "abasituliddwa mu mikono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 60:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino oli wakukirabako ojjule essanyu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "omutima gwo, gujjule okweyagala n'okujaguza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "Obugagga bw'amawanga bulyoke bukuleetebwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "era n'ebirungi byonna eby'omu nnyanja birikweyuna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 60:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebisibo by'eŋŋamira birijjula ensi yammwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "eŋŋamira ento ez'e Midiyaani ne Efa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "Era ne zonna ez'e Seba zirijja nga zeetisse zaabu n'obubaane",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "okulangirira ettendo lya Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 60:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ebisibo byonna eby'e Kedali birikukuŋŋanyizibwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "endiga ennume ez'e Nebayoosi zirikuweereza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "Zirikkirizibwa ng'ekiweebwayo ku kyoto kyange",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "era ndyolesa ekitiibwa kyange mu yeekaalu yange.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 60:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bano baani abaseyeeya nga ebire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.8",
            "verseOrgIds": [
              "ISA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:8"
      },
      "items": [
        {
          "text": "ng'amayiba agadda mu bisu byago?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.8",
            "verseOrgIds": [
              "ISA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 60:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ddala ddala ebizinga bitunuulidde nze;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "ebidyeri by'e Talusiisi bye bikulembedde",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "bireete batabani bammwe okubaggya ewala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "awamu ne zaabu yaabwe ne ffeeza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "olw'ekitiibwa kya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.9",
                "verseOrgIds": [
                  "ISA.60.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "Omutukuvu wa Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "kubanga akufudde ow'ekitiibwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 60:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abaana b'abamawanga amalala balizimba bbugwe wo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "era bakabaka baabwe bakuweereze;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "Olw'obusungu bwange, nakukuba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "naye mu kusaasira kwange ndikukwatirwa ekisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 60:11"
          },
          "items": [
            {
