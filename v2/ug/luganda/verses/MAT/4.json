{
  "id": "MAT.4",
  "number": "4",
  "bookId": "MAT",
  "reference": "Matayo 4",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "MAT 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okukemebwa kwa Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'atwalibwa Mwoyo Mutukuvu mu ddungu okukemebwa Setaani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.1",
            "verseOrgIds": [
              "MAT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amala ennaku amakumi ana ng'asiiba, nga talya, emisana n'ekiro, oluvannyuma enjala n'emuluma.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Setaani n'ajja gy'ali n'amugamba nti, \"Obanga oli Mwana wa Katonda, lagira amayinja gano gafuuke emmere.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.3",
            "verseOrgIds": [
              "MAT.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yesu n'amuddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kyawandiikibwa nti: 'Omuntu tabeera mulamu na mmere yokka, wabula na buli kigambo ekiva mu kamwa ka Katonda.' \"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.4.4",
                "verseOrgIds": [
                  "MAT.4.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Setaani n'amutwala mu kibuga ekitukuvu n'amussa ku kitikkiro kya Yeekaalu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.5",
            "verseOrgIds": [
              "MAT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 4:6"
      },
      "items": [
        {
          "text": "\"Obanga oli Mwana wa Katonda weesuule wansi",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 4:6"
      },
      "items": [
        {
          "text": "kubanga kyawandiikibwa nti, 'Katonda aliweereza bamalayika be bakuwanirire mu mikono gyabwe",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 4:6"
      },
      "items": [
        {
          "text": "oleme okwekoona ekigere kyo ku jjinja.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'addamu Setaani nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.7",
            "verseOrgIds": [
              "MAT.4.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kyawandiikibwa nti, 'Tokemanga Mukama Katonda wo.' \"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.4.7",
                "verseOrgIds": [
                  "MAT.4.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate Setaani n'amutwala ku lusozi oluwanvu n'amulengeza ensi zonna n'obwakabaka bwamu n'ekitiibwa kyabwo kyonna,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.8",
            "verseOrgIds": [
              "MAT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'amugamba nti, \"Bino byonna nnaabikuwa bw'onoovuunama n'onsinza.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.9",
            "verseOrgIds": [
              "MAT.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'addamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.10",
            "verseOrgIds": [
              "MAT.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Vvaawo, genda Setaani. Kyawandiikibwa nti, 'Osinzanga Mukama Katonda wo yekka, era gw'oweerezanga.' \"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.4.10",
                "verseOrgIds": [
                  "MAT.4.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Setaani n'amuviira n'agenda. Bamalayika ne bajja ne bamuweereza.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.11",
            "verseOrgIds": [
              "MAT.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Atandika Okubuulira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yawulira nga Yokaana bamusibye mu kkomera n'agenda e Ggaliraaya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yava e Nazaaleesi n'agenda abeera e Kaperunawumu ekiri ku lubalama lw'ennyanja mu byalo by'e Zebbulooni n'e Nafutaali.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino ne kituukiriza ekyayogerwa nnabbi Isaaya ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.14",
            "verseOrgIds": [
              "MAT.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ensi ya Zebbulooni n'ensi ya Nafutaali, okuliraana ennyanja,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.15",
            "verseOrgIds": [
              "MAT.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 4:15"
      },
      "items": [
        {
          "text": "n'ebyalo ebiri emitala w'omugga Yoludaani,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.15",
            "verseOrgIds": [
              "MAT.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 4:15"
      },
      "items": [
        {
          "text": "n'e Ggaliraaya ey'ekyengulu omuli bannaggwanga abangi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.15",
            "verseOrgIds": [
              "MAT.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu abaatuulanga mu kizikiza,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.16",
            "verseOrgIds": [
              "MAT.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 4:16"
      },
      "items": [
        {
          "text": "balabye Omusana mungi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.16",
            "verseOrgIds": [
              "MAT.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 4:16"
      },
      "items": [
        {
          "text": "Abaatuulanga mu nsi ey'ekisiikirize eky'okufa,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.16",
            "verseOrgIds": [
              "MAT.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 4:16"
      },
      "items": [
        {
          "text": "omusana gubaakidde.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.16",
            "verseOrgIds": [
              "MAT.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva mu kiseera ekyo Yesu n'atandika okubuulira nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
              "MAT.4.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwenenye, kubanga obwakabaka obw'omu ggulu busembedde.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.4.17",
                "verseOrgIds": [
                  "MAT.4.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuyitibwa kw'Abayigirizwa Abaasooka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yali ng'atambula ku lubalama lw'ennyanja y'e Ggaliraaya n'alaba abooluganda babiri: Simooni, gwe bayita Peetero, ne Andereya, nga basuula obutimba bwabwe mu nnyanja, kubanga baali bavubi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.18",
            "verseOrgIds": [
              "MAT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu, n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.19",
            "verseOrgIds": [
              "MAT.4.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mujje mungoberere, nange ndibafuula abavubi b'abantu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.4.19",
                "verseOrgIds": [
                  "MAT.4.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.19",
            "verseOrgIds": [
              "MAT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago ne baleka awo obutimba bwabwe, ne bamugoberera.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.20",
            "verseOrgIds": [
              "MAT.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yeeyongerayo katono, n'asanga abooluganda abalala babiri: Yakobo, ne Yokaana, nga batudde ne kitaabwe Zebbedaayo mu lyato nga baddaabiriza obutimba bwabwe, nabo n'abayita bamugoberere.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.21",
            "verseOrgIds": [
              "MAT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago, ne baleka awo kitaabwe mu lyato ne bagenda naye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
