        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye obutabanyiiza, genda ku nnyanja osuulemu eddobo, ekyennyanja ky'onoosooka okukwasa okyasamye akamwa. Mu kamwa kaakyo onoolabamu esutateri,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.27",
                "verseOrgIds": [
                  "MAT.17.27"
                ]
              }
