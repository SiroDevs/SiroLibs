  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "HAB 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okusaba kwa Kaabakuuku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okusaba kwa nnabbi Kaabakuuku, okw'Ekisigiyonosi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.2",
                "verseOrgIds": [
                  "HAB.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", mpulidde ebigambo byo;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "mpulidde ettutumu lyo Ayi",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.2",
                "verseOrgIds": [
                  "HAB.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ne ntya.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "Bizze buggya mu nnaku zaffe,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "bimanyise mu biro bino,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "era mu busungu jjukira okusaasira.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda yajja ng'ava e Temani,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Omutukuvu oyo ng'ava ku lusozi Palani.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Ekitiibwa kye kyatimbibwa ku ggulu,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "ensi n'eryoka ejjula ettendo lye.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okumasamasa kwe ne kulyoka kubeera ng'enjuba evaayo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:4"
      },
      "items": [
        {
          "text": "Ebimyanso byayakanga okuva mu mukono gwe,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:4"
      },
      "items": [
        {
          "text": "era omwo mwe mwasinziiranga amaanyi ge ag'ekitalo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kawumpuli ye yakulembera,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:5"
      },
      "items": [
        {
          "text": "Endwadde endala zinaamutta ne zigoberera.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayimirira n'anyeenyanyeenya ensi;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Yatunula n'akankanya amawanga.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Ensozi ez'edda za merenguka,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "obusozi obw'edda ne buggwaawo. Engeri ze, za mirembe na mirembe.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalaba eweema z'e Kusani nga ziri mu nnaku:",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:7"
      },
      "items": [
        {
          "text": "n'entimbe ez'ensi ya Midiyaani nga zijugumira.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.8",
                "verseOrgIds": [
                  "HAB.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", wanyiigira emigga?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "Obusungu bwo bwali ku bugga obutono?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "Wanyiigira ennyanja",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "bwe weebagala embalaasi zo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "n'olinnya ku magaali go ag'obuwanguzi?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasowolayo akasaale ko,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:9"
      },
      "items": [
        {
          "text": "wategeka okulasa obusaale;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:9"
      },
      "items": [
        {
          "text": "ensi n'ogyawulayawulamu n'emigga.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensozi zaakulaba, ne zeenyogootola;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "Amataba ne gayitawo mbiro,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "obuziba bw'ennyanja ne buwuluguma,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "ne busitula amayengo gaayo waggulu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enjuba n'omwezi ne biyimirira butengerera mu bifo byabyo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:11"
      },
      "items": [
        {
          "text": "olw'okumyansa kw'obusaale bwo nga buwenyuka,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:11"
      },
      "items": [
        {
          "text": "n'olw'okumyansa kw'effumu lyo eritemagana.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watambula okuyita mu nsi ng'ojjudde ekiruyi,",
