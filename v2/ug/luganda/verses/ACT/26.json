              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe badda ebbali ne bakkiriziganya ne bagamba nti, \"Omusajja ono talina ky'akoze kimusaanyiza kuttibwa wadde okusibwa mu njegere.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
