              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Kabaka, ne gavana ne Berenike, n'abalala bwe baali batudde, ne basituka ne bafuluma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
