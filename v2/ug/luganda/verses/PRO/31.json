          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyweza omuti oguluka ppamba mu mukono gwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.19",
            "verseOrgIds": [
              "PRO.31.19"
