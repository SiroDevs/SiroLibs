      "attrs": {
        "style": "q2",
        "vid": "PRO 31:20"
      },
      "items": [
        {
          "text": "n'agololera omukono gwe oyo ali mu bwetaavu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.20",
            "verseOrgIds": [
              "PRO.31.20"
