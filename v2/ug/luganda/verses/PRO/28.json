      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:10"
      },
      "items": [
        {
          "text": "aligwa mu katego ke ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.10",
            "verseOrgIds": [
              "PRO.28.10"
            ]
          }
        }
      ]
