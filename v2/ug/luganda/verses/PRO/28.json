                "verseId": "PRO.28.7",
                "verseOrgIds": [
                  "PRO.28.7"
                ]
              }
            }
          ]
        },
        {
          "text": "mwana eyeegendereza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.7",
            "verseOrgIds": [
              "PRO.28.7"
            ]
          }
        }
      ]
