      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:7"
      },
      "items": [
        {
          "text": "naye mukwano gw'ab'omululu akwasa kitaawe ensonyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.7",
            "verseOrgIds": [
              "PRO.28.7"
            ]
