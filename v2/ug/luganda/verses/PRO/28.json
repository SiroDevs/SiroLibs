      "attrs": {
        "style": "q2",
        "vid": "PRO 28:12"
      },
      "items": [
        {
          "text": "naye abakakanyalira mu kukola ebikyamu bwe bafuna obuyinza abantu beekweka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.12",
            "verseOrgIds": [
              "PRO.28.12"
            ]
          }
