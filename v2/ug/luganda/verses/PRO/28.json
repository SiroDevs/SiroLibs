      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:6"
      },
      "items": [
        {
          "text": "asinga omugagga ow'amakubo amakyamu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.6",
            "verseOrgIds": [
              "PRO.28.6"
            ]
          }
        }
      ]
    },
    {
