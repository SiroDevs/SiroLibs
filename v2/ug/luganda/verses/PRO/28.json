      "items": [
        {
          "text": "abukuŋŋaanyiza omulala anaayinza okuba ow'ekisa eri abaavu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.8",
            "verseOrgIds": [
              "PRO.28.8"
            ]
          }
