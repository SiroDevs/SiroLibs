      "items": [
        {
          "text": "naye buli abyatula n'abireka, alisaasirwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.13",
            "verseOrgIds": [
              "PRO.28.13"
            ]
          }
