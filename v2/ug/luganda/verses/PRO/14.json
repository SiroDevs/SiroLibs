      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu atambulira mu bugolokofu atya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.2",
                "verseOrgIds": [
                  "PRO.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:2"
      },
      "items": [
        {
          "text": "naye ow'amakubo amakyamu anyooma",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.2",
                "verseOrgIds": [
                  "PRO.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo by'omusirusiru bye bimuviirako okukubwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:3"
      },
      "items": [
        {
          "text": "naye eby'abatuukirivu binaabakuumanga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awataba nte nnume ezirima ebyagi biba bikalu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:4"
      },
      "items": [
        {
          "text": "naye emmere ennyingi eva mu maanyi gaazo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omujulizi ow'amazima talimba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.5",
            "verseOrgIds": [
              "PRO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:5"
      },
      "items": [
        {
          "text": "naye ow'obulimba ayogera bya bulimba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.5",
            "verseOrgIds": [
              "PRO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukudaazi anoonya amagezi n'atagalaba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:6"
      },
      "items": [
        {
          "text": "naye okumanya kwanguyira omuntu ategeera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teweeretereza muntu musirusiru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.7",
            "verseOrgIds": [
              "PRO.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:7"
      },
      "items": [
        {
          "text": "kubanga tewali by'amagezi biva mu kamwa ke.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.7",
            "verseOrgIds": [
              "PRO.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutegeevu mugezi kubanga afaayo okutegeera by'akola,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.8",
            "verseOrgIds": [
              "PRO.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:8"
      },
      "items": [
        {
          "text": "naye atalina magezi musirusiru kubanga yeerimba nti amanyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.8",
            "verseOrgIds": [
              "PRO.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasirusiru banyooma okugololwa nga bakoze ensobi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
            "verseOrgIds": [
              "PRO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:9"
      },
      "items": [
        {
          "text": "naye abalongoofu baagala emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
            "verseOrgIds": [
              "PRO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mutima gumanya okulumwa kwagwo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.10",
            "verseOrgIds": [
              "PRO.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:10"
      },
      "items": [
        {
          "text": "tewali ayinza kugusanyukirako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.10",
            "verseOrgIds": [
              "PRO.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennyumba y'abakozi b'ebibi erizikirizibwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.11",
            "verseOrgIds": [
              "PRO.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:11"
      },
      "items": [
        {
          "text": "naye eweema y'abatuukirivu erikulaakulana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.11",
            "verseOrgIds": [
              "PRO.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwo ekkubo erirabika nga ttuufu eri omuntu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.12",
            "verseOrgIds": [
              "PRO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:12"
      },
      "items": [
        {
          "text": "naye ng'enkomerero yaalyo kufa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.12",
            "verseOrgIds": [
              "PRO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enseko zandibaawo naye ng'omutima gujjudde ennaku,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.13",
            "verseOrgIds": [
              "PRO.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:13"
      },
      "items": [
        {
          "text": "era n'enkomerero y'essanyu eyinza okufuuka obuyinike.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.13",
            "verseOrgIds": [
              "PRO.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu atalina kukkiriza alisasulwa empeera emusaanira olw'ebikolwa bye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:14"
      },
      "items": [
        {
          "text": "n'omuntu omulungi naye alisasulwa eyiye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ow'amagezi amatono amala gakkiriza buli kigambo ky'awulira,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:15"
      },
      "items": [
        {
          "text": "naye omuntu omutegeevu yeegendereza amakubo ge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ow'amagezi atya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.16",
            "verseOrgIds": [
              "PRO.14.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.16",
                "verseOrgIds": [
                  "PRO.14.16"
                ]
              }
            }
          ]
        },
        {
          "text": "n'aleka okukola ebibi,",
