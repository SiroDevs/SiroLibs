      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:20"
      },
      "items": [
        {
          "text": "gayimusa amaloboozi gaago, mu bifo ebigazi eby'omu bibuga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.20",
            "verseOrgIds": [
              "PRO.1.20"
