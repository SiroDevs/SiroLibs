          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagezi galeekaanira waggulu mu nguudo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.20",
            "verseOrgIds": [
              "PRO.1.20"
