      "attrs": {
        "style": "q2",
        "vid": "PRO 1:21"
      },
      "items": [
        {
          "text": "era gasinzira mu miryango gy'ekibuga ne googera:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.21",
            "verseOrgIds": [
              "PRO.1.21"
            ]
          }
        }
      ]
