            "number": "1",
            "style": "v",
            "sid": "PRO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli asanyukira okukangavvulwa ayagala amagezi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.1",
            "verseOrgIds": [
              "PRO.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:1"
      },
      "items": [
        {
          "text": "naye oyo akyawa okunenyezebwa musirusiru.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.1",
            "verseOrgIds": [
              "PRO.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu omulungi aganja mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.12.2",
                "verseOrgIds": [
                  "PRO.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:2"
      },
      "items": [
        {
          "text": "naye",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.12.2",
                "verseOrgIds": [
                  "PRO.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": "asalira omusango omuntu ow'enkwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu tanywezebwa lwa kukola bitali bya butuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.3",
            "verseOrgIds": [
              "PRO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:3"
      },
      "items": [
        {
          "text": "naye omulandira gw'omutuukirivu tegulisigulwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.3",
            "verseOrgIds": [
              "PRO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukyala ow'empisa ennungi ssanyu era ngule ya mwami we,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.4",
            "verseOrgIds": [
              "PRO.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:4"
      },
      "items": [
        {
          "text": "naye omukazi eyeeyisa obubi ali nga kookolo mu magumba ga bba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.4",
            "verseOrgIds": [
              "PRO.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enteekateeka z'omutuukirivu ziba za mazima,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.5",
            "verseOrgIds": [
              "PRO.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:5"
      },
      "items": [
        {
          "text": "naye amagezi g'abakozi b'ebibi ge bawa gaba ga bulimba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.5",
            "verseOrgIds": [
              "PRO.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiteeso by'abakozi b'ebibi kuyiwa musaayi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.6",
            "verseOrgIds": [
              "PRO.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:6"
      },
      "items": [
        {
          "text": "naye ebigambo by'abatuukirivu bye bibawonya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.6",
            "verseOrgIds": [
              "PRO.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakozi b'ebibi bagwa ne basaanirawo ddala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.7",
            "verseOrgIds": [
              "PRO.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:7"
      },
      "items": [
        {
          "text": "naye ennyumba y'omutuukirivu teesagaasaganenga emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.7",
            "verseOrgIds": [
              "PRO.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo by'omugezi bimuleetera okusiimibwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.8",
            "verseOrgIds": [
              "PRO.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:8"
      },
      "items": [
        {
          "text": "naye eby'omusirusiru bimunyoomesa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.8",
            "verseOrgIds": [
              "PRO.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu eyeetoowaza ne yeekolera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.9",
            "verseOrgIds": [
              "PRO.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:9"
      },
      "items": [
        {
          "text": "asinga oyo eyeegulumiza n'abulwa ky'alya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.9",
            "verseOrgIds": [
              "PRO.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutuukirivu afaayo ku bisolo bye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.10",
            "verseOrgIds": [
              "PRO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:10"
      },
      "items": [
        {
          "text": "naye omukozi w'ebibi abiraga bukambwe bwereere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.10",
            "verseOrgIds": [
              "PRO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo eyeerimira aliba n'emmere nnyingi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.11",
            "verseOrgIds": [
              "PRO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:11"
      },
      "items": [
        {
          "text": "naye oyo anoonya ebitaliimu talina magezi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.11",
            "verseOrgIds": [
              "PRO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakozi b'ebibi baagala okubba omunyago gwa babbi bannaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.12",
            "verseOrgIds": [
              "PRO.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:12"
      },
      "items": [
        {
          "text": "naye omulandira gw'abatuukirivu gunywera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.12",
            "verseOrgIds": [
              "PRO.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo by'omukozi w'ebibi bimusuula mu mitawaana,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.13",
            "verseOrgIds": [
              "PRO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:13"
      },
      "items": [
        {
          "text": "naye omutuukirivu awona akabi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.13",
            "verseOrgIds": [
              "PRO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ajjuzibwa ebirungi okuva mu bibala bye bigambo by'akamwa ke,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.14",
            "verseOrgIds": [
              "PRO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:14"
      },
      "items": [
        {
          "text": "n'emirimu gy'emikono gye gimusasula bulungi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.14",
            "verseOrgIds": [
              "PRO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekkubo ly'omusirusiru ddungi mu kulaba kwe ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.15",
            "verseOrgIds": [
              "PRO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:15"
      },
      "items": [
        {
          "text": "naye omugezi assaayo omwoyo ku magezi agamuweebwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.15",
            "verseOrgIds": [
              "PRO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusirusiru alaga mangu obusungu bwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.16",
            "verseOrgIds": [
              "PRO.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:16"
      },
      "items": [
        {
          "text": "naye omutegeevu tassa mwoyo ku kivume.",
