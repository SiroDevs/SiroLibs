            "sid": "PRO 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutima gwa kabaka guli ng'amazzi agakulukutira mu mukono gwa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.1",
            "verseOrgIds": [
              "PRO.21.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.21.1",
                "verseOrgIds": [
                  "PRO.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.1",
            "verseOrgIds": [
              "PRO.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:1"
      },
      "items": [
        {
          "text": "era agukyusiza gy'ayagala yonna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.1",
            "verseOrgIds": [
              "PRO.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kkubo lya muntu liba ng'ettuufu mu maaso ge,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.2",
            "verseOrgIds": [
              "PRO.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:2"
      },
      "items": [
        {
          "text": "naye",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.2",
            "verseOrgIds": [
              "PRO.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.21.2",
                "verseOrgIds": [
                  "PRO.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "apima omutima.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.2",
            "verseOrgIds": [
              "PRO.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okukola ebituufu n'eby'amazima",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.3",
            "verseOrgIds": [
              "PRO.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:3"
      },
      "items": [
        {
          "text": "kisanyusa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.3",
            "verseOrgIds": [
              "PRO.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.21.3",
                "verseOrgIds": [
                  "PRO.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "okusinga ssaddaaka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.3",
            "verseOrgIds": [
              "PRO.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaaso ageegulumiza, n'omutima ogw'amalala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.4",
            "verseOrgIds": [
              "PRO.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:4"
      },
      "items": [
        {
          "text": "ye ttabaaza y'ababi, era ebyo kwonoona.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.4",
            "verseOrgIds": [
              "PRO.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enteekateeka z'omunyiikivu zivaamu magoba meereere,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.5",
            "verseOrgIds": [
              "PRO.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:5"
      },
      "items": [
        {
          "text": "naye okwanguyiriza okutalina nteekateeka kuvaamu bwavu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.5",
            "verseOrgIds": [
              "PRO.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okufuna obugagga n'olulimi olulimba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.6",
            "verseOrgIds": [
              "PRO.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:6"
      },
      "items": [
        {
          "text": "mpewo buwewo etwalibwa eruuyi n'eruuyi era mutego gwa kufa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.6",
            "verseOrgIds": [
              "PRO.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukambwe bw'ababi bulibamalawo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.7",
            "verseOrgIds": [
              "PRO.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:7"
      },
      "items": [
        {
          "text": "kubanga bagaana okukola eby'ensonga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.7",
            "verseOrgIds": [
              "PRO.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekkubo ly'abazza emisango liba kyamu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.8",
            "verseOrgIds": [
              "PRO.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:8"
      },
      "items": [
        {
          "text": "naye ery'abataliiko musango liba golokofu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.8",
            "verseOrgIds": [
              "PRO.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okusula ku kasolya k'ennyumba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.9",
            "verseOrgIds": [
              "PRO.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:9"
      },
      "items": [
        {
          "text": "kisinga okubeera mu nnyumba n'omukazi omuyombi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.9",
            "verseOrgIds": [
              "PRO.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emmeeme y'omubi yeegomba okukola ebibi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.10",
            "verseOrgIds": [
              "PRO.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:10"
      },
      "items": [
        {
          "text": "talaga muliraanwa we kisa n'akatono.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.10",
            "verseOrgIds": [
              "PRO.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukudaazi bw'abonerezebwa, atalina magezi agafuna;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.11",
            "verseOrgIds": [
              "PRO.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:11"
      },
      "items": [
        {
          "text": "n'ow'amagezi bw'ayigirizibwa afuna okutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.11",
            "verseOrgIds": [
              "PRO.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda alaba ebifa mu nnyumba y'omubi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.12",
            "verseOrgIds": [
              "PRO.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:12"
      },
      "items": [
        {
          "text": "era abakozi b'ebibi abazikkiririza ddala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.12",
            "verseOrgIds": [
              "PRO.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo aziba amatu ge eri okulaajana kw'omwavu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.13",
            "verseOrgIds": [
              "PRO.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:13"
      },
      "items": [
        {
          "text": "naye alikoowoola nga talina amwanukula.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.13",
            "verseOrgIds": [
              "PRO.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekirabo ekigabire mu kyama kikakkanya obusungu obungi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.14",
            "verseOrgIds": [
              "PRO.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:14"
      },
      "items": [
        {
          "text": "n'enguzi ebikiddwa mu munagiro eggyawo ekiruyi ekingi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.14",
            "verseOrgIds": [
              "PRO.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensonga bwe zisalibwa mu bwenkanya, lye ssanyu eri abatuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.15",
            "verseOrgIds": [
              "PRO.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 21:15"
      },
      "items": [
        {
          "text": "naye kiba kyekango eri abakozi b'ebibi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.15",
            "verseOrgIds": [
              "PRO.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
