      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:3"
      },
      "items": [
        {
          "text": "ne bannyaffe bafuuse bannamwandu.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
