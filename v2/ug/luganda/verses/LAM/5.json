      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:5"
      },
      "items": [
        {
          "text": "tukooye ate nga tetulina wa kuwummulira.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
