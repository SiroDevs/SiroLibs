      "attrs": {
        "style": "q2",
        "vid": "LAM 5:7"
      },
      "items": [
        {
          "text": "naye tubonerezebwa olw'ebikolwa byabwe ebitaali bya butuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
