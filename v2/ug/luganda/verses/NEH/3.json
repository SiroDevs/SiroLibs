    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona ne baddaabiriza ekyengulu w'Omulyango ogw'Embalaasi buli muntu okwolekera ennyumba ye.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
              "NEH.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zadooki mutabani wa Immeri n'addaabiriza ekifo ekyolekedde ennyumba ye, ne Semaaya mutabani wa Sekaniya omukuumi w'omulyango gw'ebuvanjuba n'addaabiriza ekitundu ekyaddirira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.29",
            "verseOrgIds": [
              "NEH.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kananiya mutabani wa Seremiya ne Kanuni mutabani wa Zalafu ow'omukaaga n'addaabiriza ekitundu ekyaddirira. Mesullamu mutabani wa Berekiya n'addaabiriza ekitundu ekyaddirira okwolekera amaka ge.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malukiya omu ku baweesi ba zaabu n'addaabiriza ekitundu okutuuka ku nnyumba y'abaweereza ba yeekaalu, ne ku nnyumba ya basuubuzi okwolekera Omulyango Awaakeberebwanga Ebyamaguzi, n'okutuuka ku kisenge ekya waggulu ku nsonda.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaweesi ba zaabu n'abasuubuzi ne baddaabiriza ekitundu ekiri wakati w'ekisenge ekya waggulu ku nsonda n'Omulyango gw'Endiga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.32",
            "verseOrgIds": [
              "NEH.3.32"
            ]
          }
        }
