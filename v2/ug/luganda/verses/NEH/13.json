          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ntukuza bakabona awamu n'Abaleevi okuva mu buli kintu kyonna ekitali kitukuvu, buli omu ne mmuwa emirimu egy'okukola.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
