              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bajjukire, Ayi Katonda wange, kubanga baayonoona omulimu gw'obwakabona n'endagaano y'obwakabona ne ey'Abaleevi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
