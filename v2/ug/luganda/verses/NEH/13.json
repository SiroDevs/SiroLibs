              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nteekawo enkola ey'abantu okuwaayo enku mu biseera ebigereke, era n'ebibala ebibereberye.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
