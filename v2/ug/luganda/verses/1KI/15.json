          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola ebibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
            "verseOrgIds": [
              "1KI.15.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.34",
                "verseOrgIds": [
                  "1KI.15.34"
                ]
              }
            }
          ]
        },
        {
          "text": ", ng'atambulira mu ngeri za Yerobowaamu, ne mu kibi kye, kye yayonoonyesa Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
