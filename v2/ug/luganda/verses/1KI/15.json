  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1KI 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abiyaamu Kabaka wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu mwaka ogw'ekkumi n'omunaana ogw'obufuzi bwa Yerobowaamu mutabani wa Nebati, Abiyaamu n'atandika okufuga Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.1",
            "verseOrgIds": [
              "1KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yafugira mu Yerusaalemi emyaka esatu. Nnyina ye yali Maaka muwala wa Abusaalomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.2",
            "verseOrgIds": [
              "1KI.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola ebibi byonna kitaawe bye yakolanga, omutima gwe ne gutatuukirira mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.3",
            "verseOrgIds": [
              "1KI.15.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.3",
                "verseOrgIds": [
                  "1KI.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda we ng'omutima gwa jjajjaawe Dawudi bwe gwali.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.3",
            "verseOrgIds": [
              "1KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ku lwa Dawudi,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.4",
            "verseOrgIds": [
              "1KI.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.4",
                "verseOrgIds": [
                  "1KI.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda we n'amuteerawo ettabaaza mu Yerusaalemi era n'ayimusa ne mutabani we okumusikira, era n'okunyweza Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.4",
            "verseOrgIds": [
              "1KI.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawudi yakola ebirungi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.5",
                "verseOrgIds": [
                  "1KI.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'agondera ebiragiro bya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.5",
                "verseOrgIds": [
                  "1KI.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ennaku zonna ez'obulamu bwe, okuggyako ensonga ya Uliya Omukiiti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne wabangawo entalo wakati w'ennyumba ya Lekobowaamu n'ennyumba ya Yerobowaamu ennaku zonna ez'obulamu bwa Abiyaamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.6",
            "verseOrgIds": [
              "1KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ebyafaayo ebirala byonna eby'okufuga kwa Abiyaamu, ne bye yakola, tebyawandiikibwa mu kitabo eky'ebyomumirembe gya bassekabaka ba Yuda? Ne wabangawo entalo wakati wa Abiyaamu ne Yerobowaamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.7",
            "verseOrgIds": [
              "1KI.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abiyaamu ne yeebakira wamu ne bajjajjaabe era n'aziikibwa mu kibuga kya Dawudi. Asa mutabani we n'amusikira, n'alya obwakabaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.8",
            "verseOrgIds": [
              "1KI.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asa Kabaka wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu mwaka ogw'amakumi abiri ogw'obufuzi bwa Yerobowaamu kabaka wa Isirayiri, Asa n'alya obwakabaka bwa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.9",
            "verseOrgIds": [
              "1KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yafugira mu Yerusaalemi emyaka amakumi ana mu gumu. Jjajjaawe omukazi nga ye Maaka muwala wa Abusaalomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.10",
            "verseOrgIds": [
              "1KI.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa n'akola ebirungi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.11",
            "verseOrgIds": [
              "1KI.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.11",
                "verseOrgIds": [
                  "1KI.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", nga jjajjaawe Dawudi bwe yakola.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.11",
            "verseOrgIds": [
              "1KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agoba mu nsi abaalyanga ebisiyaga, era n'aggyawo n'ebifaananyi ebyakolebwa n'emikono byonna bajjajjaabe bye baakola.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.12",
            "verseOrgIds": [
              "1KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'agoba ne jjajjaawe Maaka ku bwa namasole kubanga yali akoze empagi ya Asera. Asa n'agitema era n'agyokera ku kagga Kidulooni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.13",
            "verseOrgIds": [
              "1KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde nga teyaggyawo bifo bigulumivu, omutima gwe gwali ku",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.14",
            "verseOrgIds": [
              "1KI.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.14",
                "verseOrgIds": [
                  "1KI.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ennaku ze zonna.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.14",
            "verseOrgIds": [
              "1KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayingiza mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.15",
                "verseOrgIds": [
                  "1KI.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "effeeza, ne zaabu n'ebintu ebirala kitaawe bye yawaayo ne Asa yennyini bye yawaayo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne wabangawo entalo wakati wa Asa ne Baasa kabaka wa Isirayiri ennaku zonna ez'okufuga kwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.16",
            "verseOrgIds": [
              "1KI.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasa kabaka wa Isirayiri n'alumba Yuda n'azingiza Laama obutaganya muntu n'omu okufuluma wadde okuyingira mu kitundu kya Asa kabaka wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.17",
            "verseOrgIds": [
              "1KI.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Asa n'addira effeeza ne zaabu yonna eyali esigadde mu ggwanika lya yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.18",
                "verseOrgIds": [
                  "1KI.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "n'ey'olubiri lwe, n'abikwasa abakungu be, n'abiweereza Benikadadi mutabani wa Tabulimmoni, muzzukulu wa Keziyoni, eyali kabaka wa Busuuli ng'afugira e Ddamasiko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayogera nti, \"Wabeewo endagaano wakati wo nange, ng'eyaliwo wakati wa kitaawo ne kitange. Laba nkuweereza ekirabo ekya ffeeza ne zaabu, omenyewo kaakano endagaano yo ne Baasa kabaka wa Isirayiri, anveeko.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.19",
            "verseOrgIds": [
              "1KI.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benikadadi n'akkiriziganya ne kabaka Asa era n'aweereza abaduumizi b'eggye lye okulumba ebibuga bya Isirayiri. N'akuba Iyoni, ne Ddaani, ne Aberubesumaaka ne Kinnerosi yonna ng'okwo kw'otadde Nafutaali.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.20",
            "verseOrgIds": [
              "1KI.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Baasa bwe yakiwulira n'alekeraawo okuzimba Laama, n'addukira e Tiruza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.21",
            "verseOrgIds": [
              "1KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka Asa n'awa ekiragiro mu Yuda yonna nga kikwata ku buli muntu. Ne batwala amayinja ag'e Laama n'embaawo Baasa bye yazimbisanga, kabaka Asa n'abizimbisa Geba ekya Benyamini, ne Mizupa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.22",
            "verseOrgIds": [
              "1KI.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyafaayo ebirala byonna eby'omu mirembe gya Asa, n'obuwanguzi bwe era n'ebibuga bye yazimba, tebyawandiikibwa mu kitabo eky'ebyomumirembe gya bassekabaka ba Yuda? Kyokka mu bukadde bwe, n'alwala ebigere.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.23",
            "verseOrgIds": [
              "1KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Asa ne yeebakira wamu ne bajjajjaabe n'aziikibwa mu kibuga kya jjajjaawe Dawudi. Yekosafaati, mutabani we n'amusikira, n'alya obwakabaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.24",
            "verseOrgIds": [
              "1KI.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nadabu Kabaka wa Isirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadabu mutabani wa Yerobowaamu n'alya obwakabaka bwa Isirayiri mu mwaka ogwokubiri ogw'obufuzi bwa Asa kabaka wa Yuda. Yafugira Isirayiri emyaka ebiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola ebibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.26",
                "verseOrgIds": [
                  "1KI.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", ng'atambulira mu ngeri za kitaawe ne mu kibi kye, ebyaleetera Isirayiri okwonoona.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Baasa mutabani wa Akiya ow'omu nnyumba ya Isakaali n'amukolera olukwe, n'amuttira e Gibbesoni ekibuga ky'Abafirisuuti, Nadabu ne Isirayiri yenna bwe baali bakitaayizza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.27",
            "verseOrgIds": [
              "1KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasa n'atta Nadabu mu mwaka ogwokusatu ogw'obufuzi bwa Asa kabaka wa Yuda, ye n'alya obwakabaka bwa Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
            "verseOrgIds": [
              "1KI.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago nga kyajje alye obwakabaka, n'atta ennyumba ya Yerobowaamu yonna n'atalekaawo muntu n'omu omulamu. Yabazikiriza bonna ng'ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.29",
                "verseOrgIds": [
                  "1KI.15.29"
                ]
              }
            }
          ]
        },
        {
          "text": "kye yayogerera mu muddu we Akiya Omusiiro,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "olw'ebibi bya Yerobowaamu bye yakola, era bye yayonoonyesa Isirayiri, n'okusunguwaza ne bisunguwaza",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.30",
                "verseOrgIds": [
                  "1KI.15.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyafaayo ebirala eby'omu mirembe gya Nadabu, ne bye yakola, tebyawandiikibwa mu kitabo eky'ebyomumirembe gya bassekabaka ba Isirayiri?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne wabangawo entalo wakati wa Asa ne Baasa kabaka wa Isirayiri, ennaku zonna ez'okufuga kwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baasa Kabaka wa Isirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu mwaka ogwokusatu ogw'obufuzi bwa Asa kabaka wa Yuda, Baasa mutabani wa Akiya n'afuuka kabaka wa Isirayiri yonna e Tiruza, era n'afugira emyaka amakumi abiri mu ena.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
