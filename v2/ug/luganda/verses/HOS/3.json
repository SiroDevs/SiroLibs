              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.3.1",
                "verseOrgIds": [
                  "HOS.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'aŋŋamba nti, \"Genda, mukyala wo oyongere okumwagala, newaakubadde nga mwenzi era yakwaniddwa omusajja omulala. Mwagale nga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.3.1",
                "verseOrgIds": [
                  "HOS.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bw'ayagala Abayisirayiri newaakubadde nga bakyukira bakatonda abalala ne baagala obugaati obw'emizabbibu enkalu obuwonge eri bakatonda abalala.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne mmugula n'effeeza obuzito bwayo gulaamu kikumi mu nsavu ne lita ebikumi bisatu mu amakumi asatu eza sayiri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ntyo ne mugamba nti, \"Oteekwa okubeera nange ebbanga lyonna. Lekeraawo okukuba obwamalaaya, oba okukola obwenzi, nange bwe ntyo naabeeranga naawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bwe batyo abaana ba Isirayiri bwe balibeera okumala ennaku ennyingi nga tebalina kabaka newaakubadde omulangira, nga tebakyawaayo ssaddaaka eri bakatonda abalala, newaakubadde okusinza amayinja amawonge oba bakatonda abalala, wadde efodi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'oluvannyuma abaana ba Isirayiri balidda ne banoonya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.3.5",
                "verseOrgIds": [
                  "HOS.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waabwe ne Dawudi kabaka waabwe. Balijja eri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.3.5",
                "verseOrgIds": [
                  "HOS.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nga bakankana nga banoonya emikisa gye mu nnaku ez'oluvannyuma.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        }
      ]
    }
