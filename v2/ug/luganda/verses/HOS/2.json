  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "HOS 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwogere ku baganda bammwe nti, 'bantu bange,' mwogere ne ku bannyinammwe nti, 'baagalwa bange.' \"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okubonerezebwa kwa Isirayiri, n'Okuzzibwa Obuggya kwabwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munenye nnyammwe,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "mumunenye,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "kubanga si mukazi wange, so nange siri bba.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "Aggyewo obukaba obuli mu maaso ge,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "n'obwenzi obuva wakati w'amabeere ge;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nneme okumwambulira ddala",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "ne mmulekeraawo nga bwe yali ku lunaku kwe yazaalibwa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "ne mmufuula ng'eddungu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "ne mmulekawo ng'ensi enkalu eteriiko ky'egasa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "ne mmussa ennyonta.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sirilaga kwagala kwange eri abaana be,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.4",
            "verseOrgIds": [
              "HOS.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:4"
      },
      "items": [
        {
          "text": "kubanga baana ba bwenzi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.4",
            "verseOrgIds": [
              "HOS.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnyabwe yakola obwenzi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "n'abazaalira mu buwemu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "Yayogera nti, \"Ndigenda eri baganzi bange abampa emmere n'amazzi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "n'ebimbugumya n'ebyokwambala,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "n'amafuta n'ekyokunywa.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyendiva nziba ekkubo lye n'amaggwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.6",
            "verseOrgIds": [
              "HOS.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:6"
      },
      "items": [
        {
          "text": "ne mmuzimbako bbugwe okumwetooloola, aleme okulaba ekkubo wayitira.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.6",
            "verseOrgIds": [
              "HOS.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aligezaako okugoberera baganzi be abakwate,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "naye talibatuukako, alibanoonya naye talibalaba.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "Oluvannyuma alyogera nti, \"Naagenda eri bba wange eyasooka,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "kubanga mu biro ebyo nabanga bulungi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "okusinga bwe ndi kaakano.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tajjukira nga nze namuwanga eŋŋaano,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "ne wayini n'amafuta,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "era eyamuwa effeeza ne zaabu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "bye baakozesanga okuweerezanga Baali.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kyendiva neddiza emmere yange ey'empeke ng'eyengedde,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "ne wayini wange ng'atuuse;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "era nzija kumuggyako ebyambalo byange eby'ebbugumu n'ebyambalo byange ebya bulijjo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "bye yayambalanga.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kyenaava nyanika obukaba bwe",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:10"
      },
      "items": [
        {
          "text": "mu maaso ga baganzi be,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:10"
      },
      "items": [
        {
          "text": "so tewaliba amuwonya mu mukono gwange.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikomya ebinyumu bye byonna, n'embaga ze eza buli mwaka,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:11"
      },
      "items": [
        {
          "text": "n'embaga ze ez'emyezi egyakaboneka, ne ssabbiiti ze,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:11"
      },
      "items": [
        {
          "text": "n'enkuŋŋaana ze zonna entukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndizikiriza emizabbibu gye n'emitiini gye,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
              "HOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:12"
      },
      "items": [
        {
          "text": "gye yayogerako nti, 'Guno gwe musaala baganzi bange gwe bansasula.'",
          "type": "text",
          "attrs": {
