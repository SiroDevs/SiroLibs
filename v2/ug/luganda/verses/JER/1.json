  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JER 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo ebyayogerwa Yeremiya, mutabani wa Kirukiya, ow'oku bakabona abaali mu Anasosi mu nsi ya Benyamini.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.2",
                "verseOrgIds": [
                  "JER.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda yayogera naye mu mirembe gya Yosiya, kabaka wa Yuda, mutabani wa Amoni, nga yakafugira emyaka kkumi n'esatu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mu biro bya Yekoyakimu mutabani wa Yosiya kabaka wa Yuda, okutuusa mu mwezi ogwokutaano, ogw'omwaka ogw'ekkumi n'ogumu ogw'obufuzi bwa Zeddekiya mutabani wa Yosiya kabaka wa Yuda, abantu b'e Yerusaalemi lwe baatwalibwa mu buwaŋŋanguse.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuyitibwa kwa Yeremiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.4",
            "verseOrgIds": [
              "JER.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.4",
                "verseOrgIds": [
                  "JER.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ne kinzijira, ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.4",
            "verseOrgIds": [
              "JER.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nakumanya bwe nnali sinnakubumba mu lubuto lwa maama wo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:5"
      },
      "items": [
        {
          "text": "nga tonnava mu lubuto n'akutukuza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:5"
      },
      "items": [
        {
          "text": "Nakulonda okubeera nnabbi eri amawanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndyoka ŋŋamba nti, \"Laba nno,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.6",
            "verseOrgIds": [
              "JER.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.6",
                "verseOrgIds": [
                  "JER.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda! Simanyi kwogera mu bantu, ndi mwana muto.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.6",
            "verseOrgIds": [
              "JER.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.7",
            "verseOrgIds": [
              "JER.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.7",
                "verseOrgIds": [
                  "JER.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'aŋŋamba nti, \"Toyogera nti, 'Ndi mwana bwana;' kubanga yonna gye nnaakutumanga gy'onoogendanga, era byonna bye nnaakulagiranga by'onooyogeranga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.7",
            "verseOrgIds": [
              "JER.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobatyanga, kubanga nze ndi naawe okukuwonya,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.8",
            "verseOrgIds": [
              "JER.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.8",
                "verseOrgIds": [
                  "JER.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.8",
            "verseOrgIds": [
              "JER.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.9",
            "verseOrgIds": [
              "JER.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.9",
                "verseOrgIds": [
                  "JER.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'agolola omukono gwe, n'akwata ku mimwa gyange, n'aŋŋamba, nti, \"Wuliriza. Nkuwa ebigambo by'onooyogeranga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.9",
            "verseOrgIds": [
              "JER.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leero nkutaddewo okuba n'obuyinza ku mawanga era ne ku bwakabaka. Okusimbula n'okumenya, okuzikiriza n'okuwamba; okuzimba n'okusimba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.10",
            "verseOrgIds": [
              "JER.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.11",
                "verseOrgIds": [
                  "JER.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ate ne kinzijira nga kigamba nti, \"Yeremiya kiki ekyo ky'olaba?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 1:11"
      },
      "items": [
        {
          "text": "Ne ŋŋamba nti, \"Ndaba ettabi ly'omuti ogw'omulozi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.12",
                "verseOrgIds": [
                  "JER.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'aŋŋamba nti, \"Olabye bulungi, kubanga neetegereza ndabe ng'ekigambo kyange kituukirira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.13",
                "verseOrgIds": [
                  "JER.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ne kinzijjira nate nti, \"Kiki ky'olaba, kaakano?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 1:13"
      },
      "items": [
        {
          "text": "Ne ŋŋamba nti, \"Ndaba ensuwa ey'amazzi ageesera, ng'etunudde waggulu mu bukiikakkono.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
            "verseOrgIds": [
              "JER.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.14",
                "verseOrgIds": [
                  "JER.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'aŋŋamba nti, \"Okuzikirira kujja kubaawo nga kutandikira mu bukiikakkono kutuuke ku bantu bonna abali mu ggwanga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
            "verseOrgIds": [
              "JER.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga laba nnaatera okuyita abantu bonna ab'omu bwakabaka obuli mu bukiikakkono,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.15",
                "verseOrgIds": [
                  "JER.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "Bakabaka baabwe balyoke bajje bateeke entebe zaabwe ez'obwakabaka",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "mu miryango egiyingira ekibuga Yerusaalemi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "balizinda bbugwe waakyo yenna",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "era bazinde n'ebibuga byonna ebya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndibonereza abantu bange olw'ebibi byabwe byonna,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
