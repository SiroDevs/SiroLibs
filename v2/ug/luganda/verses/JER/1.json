          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga leero nze nkufudde ekibuga ekiriko enkomera ez'amaanyi, era empagi ey'ekyuma, era bbugwe ow'ekikomo eri ensi yonna, eri bakabaka ba Yuda, eri abakungu baayo, ne bakabona n'abantu ab'omu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.18",
            "verseOrgIds": [
              "JER.1.18"
            ]
          }
        },
