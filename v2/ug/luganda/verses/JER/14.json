              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'erinnya lyo totugoba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.21",
            "verseOrgIds": [
              "JER.14.21"
            ]
          }
        }
