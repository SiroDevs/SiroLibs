      "attrs": {
        "style": "q2",
        "vid": "JER 14:20"
      },
      "items": [
        {
          "text": "era n'obutali butuukirivu bwa bajjajjaffe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.20",
            "verseOrgIds": [
              "JER.14.20"
            ]
          }
        }
