          "type": "text",
          "attrs": {
            "verseId": "JER.14.20",
            "verseOrgIds": [
              "JER.14.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.20",
                "verseOrgIds": [
                  "JER.14.20"
                ]
              }
            }
          ]
        },
        {
          "text": "tukkiriza ebibi byaffe",
          "type": "text",
          "attrs": {
