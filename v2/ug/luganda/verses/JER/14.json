          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda ogigaanidde ddala?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
