      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "Bwe ŋŋenda mu kibuga",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "ndaba okutaagulwataagulwa okw'enjala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
