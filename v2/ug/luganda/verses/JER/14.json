      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Sayuuni ogyetamiriddwa ddala?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Otufumitidde ddala awatali kuwonyezebwa?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Twasuubira emirembe naye tewali kalungi ke tufunye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "ekiseera eky'okuwonyezebwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "naye laba tufunye bulabe bwereere.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
