    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekyeya, Enjala, n'Ekitala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.1",
            "verseOrgIds": [
              "JER.14.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.1",
                "verseOrgIds": [
                  "JER.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyajjira Yerusaalemi ekikwata ku kyeya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.1",
            "verseOrgIds": [
              "JER.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yuda ekungubaga n'ebibuga byayo bifaafaaganye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "bakaabira ensi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "era omulanga",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "gusimbuse mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakungu batuma abaddu baabwe okuleeta amazzi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "bagenda mu ttanka ez'omu ttaka nga temuli kantu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "bakomawo n'ebintu ebikalu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "ensonyi nga zibakutte",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "n'essuubi nga libaweddemu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "babikka amaaso gaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ettaka lyatise",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "kubanga enkuba tekyatonnya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "abalimi baweddemu amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "babikka ku mitwe gyabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'empeewo ku ttale ezaala",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:5"
      },
      "items": [
        {
          "text": "n'ereka awo omwana gwayo",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:5"
      },
      "items": [
        {
          "text": "kubanga tewali muddo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ennyumbu ez'omu nsiko ziyimirira ku busozi obukalu",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "nga ziwejjawejja ng'ebibe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "amaaso gaazo nga tegalaba bulungi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "kubanga tezirina kye zirya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadde obutali butuukirivu bwaffe butulumiriza, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.7",
                "verseOrgIds": [
                  "JER.14.7"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "baako ky'okola olw'erinnya lyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "Kubanga tuzze ennyuma emirundi mingi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "tukwonoonye nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi ggwe essuubi lya Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "Omulokozi waalyo mu biseera eby'okulabiramu ennaku,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "lwaki oli ng'omuyise mu nsi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "ng'omutambuze asula ekiro ekimu?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki oli ng'omuntu gwe baguddeko obugwi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "ng'omulwanyi ataliimu maanyi ganunula?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "Ggwe, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.9",
                "verseOrgIds": [
                  "JER.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, oli wakati mu ffe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "era tuyitibwa linnya lyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "Totuleka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.10",
                "verseOrgIds": [
                  "JER.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ku bantu be nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "\"Baagala nnyo okubula,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
