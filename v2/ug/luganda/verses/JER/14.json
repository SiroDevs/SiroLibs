      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "ndaba abafumitiddwa n'ekitala!",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
