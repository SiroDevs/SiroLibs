      "attrs": {
        "style": "q2",
        "vid": "JER 14:20"
      },
      "items": [
        {
          "text": "kubanga ddala twayonoona gy'oli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.20",
            "verseOrgIds": [
              "JER.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
