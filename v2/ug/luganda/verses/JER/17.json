    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekibi n'Ekibonerezo kya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ekibi kya Yuda kiwandiikiddwa n'ekkalaamu ey'ekyuma",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "n'ejjinja essongovu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "kirambiddwa ku mitima gyabwe",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "ne ku mayembe g'ebyoto byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abaana baabwe basinziza",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "ku byoto bya bakatonda ba Asera",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "ebiri ku buli muti oguyimiridde",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "era ne ku busozi obuwanvu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olusozi lwange oluli mu nsi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "obugagga bwammwe n'ebintu byo eby'omuwendo byonna,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "ndibiwaayo byonna binyagibwe",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "n'ebifo byammwe ebigulumivu kwe musaddaakira",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "olw'ekibi ekibunye mu nsi yonna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musango gwo ggwe nti olifiirwa ensi gye nakuwa okuba omugabo gwo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "ndikufuula muddu wa balabe bo mu nsi gy'otomanyangako,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "kubanga mu busungu bwange omuliro gukoleezeddwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "ogunaayakanga emirembe gyonna.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.5",
                "verseOrgIds": [
                  "JER.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "Akolimiddwa oyo eyeesiga omuntu",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "era eyeesiga omubiri okuba amaanyi ge,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "era alina omutima oguva ku Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliba ng'ekisaka mu ddungu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "ataliraba birungi bwe birijja,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "naye alibeera mu biwalakate mu ddungu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "ensi ey'omunnyo omutali abeeramu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
