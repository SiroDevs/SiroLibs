          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka bwe muneegendereza ne muŋŋondera, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
              "JER.17.24"
            ]
          }
