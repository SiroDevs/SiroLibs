          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "era kuuma olunaku lwa Ssabbiiti nga lutukuvu nga bwe nalagira bajjajjammwe.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.22",
