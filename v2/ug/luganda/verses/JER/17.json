                "verseOrgIds": [
                  "JER.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'ne mutayisa kintu kyonna kye mwetisse mu miryango gy'ekibuga ku ssabbiiti, naye ne mukuuma olwa Ssabbiiti nga lutukuvu obutakolerako mulimu gwonna,",
          "type": "text",
          "attrs": {
