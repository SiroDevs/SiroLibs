              "attrs": {
                "verseId": "JER.17.7",
                "verseOrgIds": [
                  "JER.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.7",
            "verseOrgIds": [
              "JER.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:7"
      },
      "items": [
        {
          "text": "nga",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.7",
            "verseOrgIds": [
              "JER.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.7",
                "verseOrgIds": [
                  "JER.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ly'essuubi lye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.7",
            "verseOrgIds": [
              "JER.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ng'omuti ogusimbiddwa awali amazzi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "ne gulandiza emirandira gyagwo ku mabbali g'omugga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "nga wadde omusana gujja, tegutya",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "n'amakoola gaagwo tegawotoka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "so tegulyeraliikirira mu mwaka ogw'ekyeya",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "era teguliremwa kubala bibala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutima mulimba okusinga ebintu byonna,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.9",
            "verseOrgIds": [
              "JER.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:9"
      },
      "items": [
        {
          "text": "era gulwadde endwadde etawonyezeka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.9",
            "verseOrgIds": [
              "JER.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:9"
      },
      "items": [
        {
          "text": "Ani ayinza okugutegeera?",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.9",
            "verseOrgIds": [
              "JER.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nze",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.10",
            "verseOrgIds": [
              "JER.17.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.10",
                "verseOrgIds": [
                  "JER.17.10"
                ]
              }
            }
          ]
        },
