              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye tebaawuliriza wadde okukkiriza okunenyezebwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        },
