            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nnaku ezo Yuda alirokolebwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
