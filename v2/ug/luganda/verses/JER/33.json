            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.23",
                "verseOrgIds": [
                  "JER.33.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Yeremiya nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonategeera nti abantu bano bagamba nti, \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.24",
                "verseOrgIds": [
                  "JER.33.24"
                ]
              }
            }
          ]
        },
        {
          "text": "agaanye obwakabaka obubiri bwe yalonda? Kale banyooma abantu bange era tebakyababala ng'eggwanga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.25",
                "verseOrgIds": [
                  "JER.33.25"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, 'Bwe mba nga sassaawo ndagaano yange n'emisana n'ekiro n'amateeka ag'enkalakkalira ag'eggulu n'ensi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwo nzija kwegaana ezzadde lya Yakobo ne Dawudi omuddu wange era sirironda n'omu ku batabani be okufuga ezzadde lya Ibulayimu, ne Isaaka ne Yakobo. Kubanga ndizzaawo nate emikisa gyabwe, era ne mbakwatirwa ekisa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.26",
            "verseOrgIds": [
              "JER.33.26"
            ]
          }
        }
      ]
    }
