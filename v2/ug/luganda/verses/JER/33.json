      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:16"
      },
      "items": [
        {
          "text": "ne Yerusaalemi alibeera mirembe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        }
      ]
    },
    {
