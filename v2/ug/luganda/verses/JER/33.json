      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 33:16"
      },
      "items": [
        {
          "text": "Lino lye linnya ly'aliyitibwa nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        }
