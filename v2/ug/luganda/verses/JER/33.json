    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebisuubizo by'Okuddawo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya bwe yali ng'akyali mu kkomera mu luggya lw'omukuumi, ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.1",
                "verseOrgIds": [
                  "JER.33.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kimujjira omulundi ogwokubiri nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", oyo eyakola ensi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "eyagikola era n'agiteekawo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "lye linnya lye:",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Mumpite n'abayitaba ne mbalaga ebikulu ebitanoonyezeka bye mutamanyi.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.3",
            "verseOrgIds": [
              "JER.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4",
            "verseOrgIds": [
              "JER.33.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.4",
                "verseOrgIds": [
                  "JER.33.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Katonda wa Isirayiri ku mayumba agali mu kibuga kino era ne ku mbiri z'obwakabaka bwa Yuda ebyamenyebwamenyebwa okukozesebwa ng'entuumo eziziyiza obulumbaganyi n'ekitala",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4",
            "verseOrgIds": [
              "JER.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu lutalo n'Abakaludaaya. 'Birijjula emirambo gy'abasajja be nditta olw'obusungu bwange n'ekiruyi. Ndikweka amaaso gange okuva ku kibuga kino olw'obutali butuukirivu bwabwe bwonna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.5",
            "verseOrgIds": [
              "JER.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Naye ndikiwa obulamu n'okuwonyezebwa; ndiwonya abantu bange, mbaleetere okweyagalira mu mirembe emigazi era eminywevu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.6",
            "verseOrgIds": [
              "JER.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikomyawo Yuda ne Isirayiri okubaggya mu buwambe era mbazimbe nga bwe baasooka okubeera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.7",
            "verseOrgIds": [
              "JER.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibalongoosa okubaggyako ebibi byonna bye bannyonoona era mbasonyiwe n'ekibi eky'okunjeemera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.8",
            "verseOrgIds": [
              "JER.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo ekibuga kino kirindetera okwongera okumanyika, n'essanyu, n'ettendo era n'ekitiibwa eri amawanga gonna ku nsi agaliwulira ebintu byonna ebirungi bye mbakolera; era balyewuunya bakankane olw'okukulaakulana n'emirembe gye nkiwa.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.9",
            "verseOrgIds": [
              "JER.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.10",
                "verseOrgIds": [
                  "JER.33.10"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, 'Mwogera ku kifo kino nti, \"Matongo agaalekebwa awo, omutali bantu wadde ensolo.\" Ate nga mu bibuga bya Yuda n'enguudo za Yerusaalemi ezalekebwawo omutali bantu wadde ensolo, muliddamu okuwulirwa nate",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "amaloboozi ag'essanyu n'okujaguza, n'amaloboozi g'omugole ne bba, n'amaloboozi gaabo abaleeta ekiweebwayo eky'okwebaza eri ennyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", nga bagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "\" ' \"Mumwebaze",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "kubanga",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "mulungi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "okwagala kwe kubeerera emirembe gyonna.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "Kubanga ndizzaawo omukisa gw'eggwanga lino nga bwe gwali mu kusooka,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.12",
                "verseOrgIds": [
                  "JER.33.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye nti, 'Mu kifo kino ekirekeddwa awo omutali bantu wadde ensolo, mu bibuga byakyo byonna nate muliddamu amalundiro ag'abasumba mwe banaawummulizanga ebisibo byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bibuga eby'ensi ey'obusozi, eby'eri wansi w'ensozi ez'omu bugwanjuba era ne Negebu, mu kitundu kya Benyamini, mu byalo ebyetoolodde Yerusaalemi n'ebibuga ebyetoolodde Yuda mwonna ebisibo biriddamu okuyita wansi w'omukono gw'oyo abibala,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.13",
                "verseOrgIds": [
                  "JER.33.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ennaku zijja,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.14",
                "verseOrgIds": [
                  "JER.33.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'lwe ndituukiriza ekisuubizo eky'ekisa kye nakolera ennyumba ya Isirayiri n'ennyumba ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mu nnaku ezo era mu kiseera ekyo",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:15"
      },
      "items": [
        {
          "text": "ndireeta Ettabi ettukuvu mu lunyiriri lwa Dawudi",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:15"
      },
      "items": [
        {
          "text": "era alikola eby'amazima era ebituufu mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
