  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "2KI 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koseya, Kabaka eyasembayo owa Isirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogw'ekkumi n'ebiri ogw'obufuzi bwa Akazi kabaka wa Yuda, Koseya mutabani wa Era n'afuuka kabaka wa Isirayiri mu Samaliya, n'afugira emyaka mwenda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.1",
            "verseOrgIds": [
              "2KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola ebibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.2",
                "verseOrgIds": [
                  "2KI.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", naye tebyenkana nga bassekabaka ba Isirayiri bye baakola.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salumaneseri kabaka w'e Bwasuli n'amulumba, Koseya n'afuuka muddu we era n'amuwanga obusuulu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.3",
            "verseOrgIds": [
              "2KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye oluvannyuma kabaka w'e Bwasuli n'akizuula nga Koseya yali amuliddemu olukwe, kubanga yali atumye ababaka ewa So kabaka w'e Misiri, ate nga takyaweereza busuulu ewa kabaka w'e Bwasuli, nga bwe yakolanga buli mwaka. Salumaneseri kyeyava amukwata n'amuteeka mu kkomera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka w'e Bwasuli n'alumba ensi yonna, n'atuuka e Samaliya, n'akizingiriza emyaka esatu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.5",
            "verseOrgIds": [
              "2KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogw'omwenda ogwa Koseya, kabaka w'e Bwasuli n'awamba Samaliya, n'atwala Abayisirayiri mu buwaŋŋanguse",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        },
        {
          "text": "e Bwasuli, n'abateeka mu Kala, ne mu Kaboli ku mugga ogw'e Gozani, ne mu bibuga eby'Abameedi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isirayiri Batwalibwa mu Buwaŋŋanguse olw'Ekibi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino byonna byabaawo kubanga Abayisirayiri bayonoona mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.7",
                "verseOrgIds": [
                  "2KI.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waabwe, eyali abaggye mu Misiri okuva mu mukono gwa Falaawo, ye kabaka w'e Misiri. Baasinzanga bakatonda abalala,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bagobereranga empisa za baamawanga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.8",
                "verseOrgIds": [
                  "2KI.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ge yali agobye mu maaso gaabwe. Era bagobereranga n'emizizo bassekabaka ba Isirayiri gye baali bataddewo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayisirayiri ne bakolanga mu nkizo ebyo ebitaali birungi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.9",
                "verseOrgIds": [
                  "2KI.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ne bazimba ebifo ebigulumivu mu bibuga byabwe byonna, okuviira ddala ku minaala omwabeeranga abakuumi okutuuka ku kibuga ekiriko bbugwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne beesimbira empagi ez'amayinja n'eza Baasera, ku buli kasozi akawanvu, ne wansi wa buli muti.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.10",
            "verseOrgIds": [
              "2KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bookera obubaane ku buli kifo ekigulumivu ng'amawanga gali",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.11",
                "verseOrgIds": [
                  "2KI.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ge yali agobye mu maaso gaabwe bwe gaakolanga. Ne bakola ebintu eby'ekivve ne basunguwaza",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.11",
                "verseOrgIds": [
                  "2KI.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne basinza ebifaananyi, ate nga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.12",
                "verseOrgIds": [
                  "2KI.17.12"
                ]
              }
            }
          ]
        },
        {
          "text": "yali abalagidde nti, \"Temukolanga ekyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.13",
                "verseOrgIds": [
                  "2KI.17.13"
                ]
              }
            }
          ]
        },
        {
          "text": "n'alabula Isirayiri ne Yuda ng'akozesa bannabbi n'abalabi nti, \"Mukyuke muve mu bibi byammwe, mukuume amateeka gange n'ebiragiro byange, ng'etteeka bwe liri lye nalagira bajjajjammwe, lye nabaweereza nga nkozesa abaddu bange bannabbi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.13",
            "verseOrgIds": [
              "2KI.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ne batawuliriza, ne baba bakakanyavu nga bajjajjaabwe bwe baali, abateesiga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.14",
                "verseOrgIds": [
                  "2KI.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waabwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne banyooma ebiragiro n'endagaano gye yali akoze ne bajjajjaabwe, n'okulabula kwe yali abawadde. Ne bagoberera bakatonda abataliimu, ate nabo ne bafuuka ebitagasa. Ne bakola ng'amawanga agaali gabeetoolodde bwe gaakolanga, newaakubadde nga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.15",
                "verseOrgIds": [
                  "2KI.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "yali abalabudde nti, \"Temukolanga ebyo bye bakola.\" Ne bakola byonna",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.15",
                "verseOrgIds": [
                  "2KI.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "bye yali abagaanye okukola.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bava ku mateeka ga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.16",
                "verseOrgIds": [
                  "2KI.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waabwe gonna, ne baweesa ebifaananyi by'ennyana bibiri, n'empagi ey'Asera, ne basinza n'eggye lyonna ery'omu ggulu era ne basinzanga ne Baali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bawaayo abaana baabwe aboobulenzi n'aboobuwala ng'ebiweebwayo mu muliro, ne bakola eby'obufumu n'eby'obulogo, ne beetunda okukola ebibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.17",
                "verseOrgIds": [
                  "2KI.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", okumusunguwaza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.18",
                "verseOrgIds": [
                  "2KI.17.18"
                ]
              }
            }
          ]
        },
        {
          "text": "kyeyava asunguwalira ennyo Isirayiri, n'abagoba mu maaso ge, n'alekawo ekika kya Yuda kyokka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka ne Yuda ne batakuuma mateeka ga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.19",
                "verseOrgIds": [
                  "2KI.17.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waabwe, naye ne bagoberera empisa za Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.20",
                "verseOrgIds": [
                  "2KI.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "kyeyava aleka ezzadde lyonna erya Isirayiri, n'ababonereza, n'abawaayo mu mikono gy'abanyazi, n'okubagoba n'abagobera ddala okuva mu maaso ge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yayawula Isirayiri ku nnyumba ya Dawudi, ne bafuula Yerobowaamu mutabani wa Nebati kabaka waabwe. Yerobowaamu n'aleetera Isirayiri okuviira ddala ku mukama, n'abayonoonyesa n'okusingawo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana ba Isirayiri ne batambulira mu bibi byonna Yerobowaamu bye yakola, ne batabirekaayo,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.22",
            "verseOrgIds": [
              "2KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "okutuusa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.23",
                "verseOrgIds": [
                  "2KI.17.23"
                ]
              }
            }
          ]
        },
        {
          "text": "lwe yabaggyira ddala okuva mu maaso ge, nga bwe yali abalabudde ng'ayita mu baddu be bannabbi. Awo Abayisirayiri ne batwalibwa mu buwaŋŋanguse mu nsi eya Bwasuli, gye bali ne kaakano.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abayisirayiri Babeera awamu n'Abasuuli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka w'e Bwasuli n'akuŋŋaanya abantu okuva e Babulooni, Kusa, Ava, Kamasi ne Sefavayimu, n'abaleeta mu bibuga bya Samaliya, Abayisirayiri mwe baabeeranga, Samaliya ne bakitwalira ddala era ne babeera mu bibuga byakyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.24",
            "verseOrgIds": [
              "2KI.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ntandikwa bwe babeeramu ne batasinza",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.25",
                "verseOrgIds": [
                  "2KI.17.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", kyeyava abasindikira empologoma",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "text": "ne zitta abamu ku bo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka w'e Bwasuli n'ategeezebwa nti, \"Amawanga ge watwala n'obateeka mu bibuga bya Samaliya tebamanyi tteeka lya Katonda w'ensi eyo,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.26",
            "verseOrgIds": [
              "2KI.17.26"
            ]
          }
        },
        {
          "text": "kyeyavudde abasindikira empologoma okubatta, kubanga tebamanyi Katonda w'ensi kye yeetaaga.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.26",
            "verseOrgIds": [
              "2KI.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago kabaka w'e Bwasuli n'alagira nti, \"Mutumeyo omu ku bakabona be mwawamba okuva mu Samaliya agende abeere eyo, ayigirize abantu amateeka ga Katonda w'ensi eyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.27",
            "verseOrgIds": [
              "2KI.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omu ku bakabona eyali awaŋŋangusibbwa okuva mu Samaliya n'agenda n'abeera e Beseri, n'abayigiriza bwe kibagwanira okusinza",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.28",
                "verseOrgIds": [
                  "2KI.17.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde nga kabona yagendayo, buli ggwanga beekolera bakatonda baabwe, ne babateeka mu masabo Abasamaliya ge baali bazimbye ku bifo ebigulumivu mu bibuga byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasajja ab'e Babulooni ne bakola Sukkosubenosi, abasajja ab'e Kuusi ne bakola Nengali, abasajja ab'e Kamasi ne bakola Asima:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.30",
            "verseOrgIds": [
              "2KI.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abavi ne bakola Nibukazi ne Talutaki, Abasefavayimu ne bookera abaana baabwe mu muliro, nga babawaayo ng'ebiweebwayo eri Adulammereki ne Anammereki, bakatonda ba Sefavayimu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.31",
            "verseOrgIds": [
              "2KI.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasinzanga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.32",
                "verseOrgIds": [
                  "2KI.17.32"
                ]
              }
            }
          ]
        },
        {
          "text": ", naye ne balonda n'abantu ab'engeri zonna okuva mu bokka ne bokka okuba bakabona, ab'ebifo ebigulumivu, abaabaweerangayo ssaddaaka mu masabo ag'ebifo ebigulumivu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne basinzanga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.33",
                "verseOrgIds": [
                  "2KI.17.33"
                ]
              }
            }
          ]
        },
        {
          "text": ", naye nga bwe baweereza ne bakatonda baabwe, ng'empisa ez'amawanga gye baali bavudde bwe zalinga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne leero bakyeyisa mu ngeri y'emu. Tebasinza",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.34",
                "verseOrgIds": [
                  "2KI.17.34"
                ]
              }
            }
          ]
        },
        {
          "text": "so tebagoberera biragiro n'amateeka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.34",
                "verseOrgIds": [
                  "2KI.17.34"
                ]
              }
            }
          ]
        },
        {
          "text": "bye yalagira bazzukulu ba Yakobo, gwe yatuuma Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.35",
                "verseOrgIds": [
                  "2KI.17.35"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yakola endagaano n'Abayisirayiri, yabalagira nti, \"Temusinzanga bakatonda balala, so temubavuunamiranga so temubaweerezanga, wadde okuwaayo ssaddaaka gye bali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwekuumenga okugobereranga ebiragiro n'amateeka, n'etteeka, n'ekiragiro bye yabawandiikira. Temusinzanga bakatonda abalala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye musinzanga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.37",
            "verseOrgIds": [
              "2KI.17.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.37",
                "verseOrgIds": [
                  "2KI.17.37"
                ]
              }
            }
          ]
        },
        {
          "text": "eyabaggya mu Misiri n'amaanyi amangi n'omukono gwe, gwe yagolola. Oyo ggwe munavuunamiranga era ne muwaayo ssaddaaka eri ye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.37",
            "verseOrgIds": [
              "2KI.17.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temwerabiranga endagaano gye nakola nammwe, era temusinzanga bakatonda abalala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.38",
            "verseOrgIds": [
              "2KI.17.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabula musinzanga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.39",
                "verseOrgIds": [
                  "2KI.17.39"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe, kubanga y'anaabalokolanga mu mukono gw'abalabe bammwe bonna.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 17:40"
          },
