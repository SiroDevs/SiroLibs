            "number": "23",
            "style": "v",
            "sid": "2KI 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abakungu ba Amoni ne bamusalira olukwe, ne bamuttira mu lubiri lwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.23",
            "verseOrgIds": [
              "2KI.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo olwatuuka, abantu mu nsi ne beekobaana, ne batta abo bonna abaali mu lukwe olw'okumutta, era ne bafuula Yosiya mutabani we kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.24",
            "verseOrgIds": [
              "2KI.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyafaayo ebirala ebyabaawo mu mirembe gya Amoni, tebyawandiikibwa mu kitabo eky'ebyomumirembe gya bassekabaka ba Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.25",
            "verseOrgIds": [
              "2KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka n'aziikibwa mu ntaana ye mu nnimiro ya Uzza, mutabani we Yosiya n'amusikira okuba kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.26",
            "verseOrgIds": [
              "2KI.21.26"
            ]
          }
        }
