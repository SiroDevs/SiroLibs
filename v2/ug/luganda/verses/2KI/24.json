  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2KI 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biro ebyo, Nebukadduneeza kabaka w'e Babulooni n'alumba, era n'afuula Yekoyakimu omuddu we okumala emyaka esatu. Naye Yekoyakimu oluvannyuma n'ajeema, n'akola olutalo ku Nebukadduneeza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.2",
                "verseOrgIds": [
                  "2KI.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "n'asindikira Yekoyakimu ebibinja by'Abakaludaaya, n'Abasuuli, n'Abamowaabu, n'Abamoni, n'abatuma okulumba Yuda, ng'ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.2",
                "verseOrgIds": [
                  "2KI.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kye yayogerera mu baweereza be bannabbi bwe kyali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ddala ebyo by'atuukirira ku Yuda ng'ekiragiro kya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.3",
                "verseOrgIds": [
                  "2KI.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe kyali, okubaggya mu maaso ge olw'ebibi bya Manase n'ebirala byonna bye yakola,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'okwo kwe kuli okuyiwa omusaayi ogutaliiko musango. Yajjuza Yerusaalemi n'omusaayi ogutaliiko musango,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.4",
                "verseOrgIds": [
                  "2KI.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kye yali tagenda kusonyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyafaayo ebirala ebyaliwo ku mulembe gwa Yekoyakimu ne byonna bye yakola, tebyawandiikibwa mu kitabo eky'ebyomumirembe gya bassekabaka ba Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yekoyakimu n'afa, mutabani we Yekoyakini n'amusikira okuba kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka w'e Misiri teyava nate mu nsi ye, kubanga kabaka w'e Babulooni yali awambye ebibye byonna okuviira ddala ku mukutu gw'Omugga ogw'e Misiri oguyiwa ku Nnyanja Ennene okutuuka ku Mugga Fulaati.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yekoyakini Kabaka wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yekoyakini we yafuukira kabaka yalina emyaka kkumi na munaana, era n'afugira mu Yerusaalemi okumala emyezi esatu. Nnyina erinnya lye yali Nekusita muwala wa Erunasani ow'e Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.8",
            "verseOrgIds": [
              "2KI.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola ebibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.9",
                "verseOrgIds": [
                  "2KI.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", nga kitaawe bwe yakola.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biro ebyo eggye lya Nebukadduneeza kabaka w'e Babulooni ne lirumba ekibuga ky'e Yerusaalemi, ne kizingizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadduneeza yennyini n'ajja mu kibuga, ng'eggye lye likyakizingizza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yekoyakini kabaka wa Yuda, ne nnyina, n'abaddu ba kabaka, n'abakungu be, n'abaami be bonna ne beewaayo eri kabaka w'e Babulooni mu mwaka gwe ogw'omunaana bukya alya bwakabaka, era Yekoyakini n'atwalibwa nga musibe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era mu kiseera kye kimu, Nebukadduneeza n'atwala eby'obugagga byonna okuva mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.13",
                "verseOrgIds": [
                  "2KI.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'okuva mu lubiri lwa kabaka, era n'atemaatema ebibya byonna ebya zaabu, Sulemaani kabaka wa Isirayiri bye yali akoze ng'abitadde mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.13",
                "verseOrgIds": [
                  "2KI.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", nga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.13",
                "verseOrgIds": [
                  "2KI.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yalagira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'atwala Yerusaalemi kyonna, n'abakungu bonna, n'abasajja abalwanyi bonna, ne baffundi bonna n'abaweesi bonna mu buwaŋŋanguse, awamu ne bawera abantu ng'omutwalo gumu. Abasemberayo ddala obwavu be yalekamu bokka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadduneeza n'atwala Yekoyakini e Babulooni nga musibe okuva mu Yerusaalemi, era n'atwala ne nnyina, ne bakyala ba kabaka, n'abakungu be, n'abaami abaali ab'ekitiibwa mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate era yawamba abasajja ab'amaanyi kasanvu, ne baffundi n'abaweesi lukumi, bonna n'abatwala e Babulooni nga basibe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadduneeza n'addira Mataniya kitaawe wa Yekoyakini omuto, n'amufuula kabaka, era n'amukyusa n'erinnya n'amutuuma Zeddekiya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.17",
            "verseOrgIds": [
              "2KI.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zeddekiya, Kabaka wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zeddekiya we yafuukira kabaka yalina emyaka amakumi abiri mu gumu, era n'afugira mu Yerusaalemi emyaka kkumi na gumu. Nnyina erinnya lye yali Kamutali muwala wa Yeremiya ow'e Libuna.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.18",
            "verseOrgIds": [
              "2KI.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola ebibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.19",
            "verseOrgIds": [
              "2KI.24.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.19",
                "verseOrgIds": [
                  "2KI.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", nga Yekoyakini bwe yakola.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.19",
            "verseOrgIds": [
              "2KI.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo byonna ebyatuuka ku Yerusaalemi ne ku Yuda, byabaawo olw'obusungu bwa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.20",
            "verseOrgIds": [
              "2KI.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.20",
                "verseOrgIds": [
                  "2KI.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": "obwababubuukirako, era n'oluvannyuma n'abagoba mu maaso ge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.20",
            "verseOrgIds": [
              "2KI.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 24:20"
      },
      "items": [
        {
          "text": "Naye oluvannyuma Zeddekiya y'ajeemera kabaka w'e Babulooni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.20",
            "verseOrgIds": [
              "2KI.24.20"
            ]
          }
        }
      ]
    }
  ],
