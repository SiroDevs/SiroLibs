{
  "id": "JOL.3",
  "number": "3",
  "bookId": "JOL",
  "reference": "Yoweeri 3",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JOL 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abalabe ba Isirayiri Basalirwa Omusango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOL 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mu nnaku ezo, era mu biseera ebyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:1"
      },
      "items": [
        {
          "text": "Yuda n'ekibuga Yerusaalemi ndibiddiza emikisa gyabyo nga bwe gyabanga edda.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikuŋŋaanya abamawanga bonna",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "ne mbaserengesa mu kiwonvu Yekosafaati,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "ne mbasalira omusango",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "olwa byonna bye baakola abantu bange Abayisirayiri ab'obusika bwange.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "Kubanga baasaasaanya Abayisirayiri mu mawanga,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "ne bagabana ensi yange.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagabana abantu bange nga babakubirako obululu;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:3"
      },
      "items": [
        {
          "text": "ne batunda abalenzi olw'abakazi bamalaaya,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:3"
      },
      "items": [
        {
          "text": "n'abawala ne babatundamu omwenge",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:3"
      },
      "items": [
        {
          "text": "ne beenywera.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwe Ttuulo ne Sidoni n'enjuyi zonna ez'Abafirisuuti, mmwe b'ani ku Nze? Nnina kye nabakola kye mugezaako okwesasuza? Bwe munaaba nga mugezaako kwesasuza, ebikolwa byammwe nzija kubibakyusizaako mangwago.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.4",
            "verseOrgIds": [
              "JOL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga mwatwala effeeza yange ne zaabu yange n'ebintu byange eby'omuwendo omungi ne mubissa mu masabo gammwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwatwala abantu b'omu Yuda ne mu Yerusaalemi ne mubatunza Abayonaani.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.6",
            "verseOrgIds": [
              "JOL.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laba, ndibaggyayo mu mawanga gye mwabatunda; mmwe mbakole nga bwe mwabakola.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.7",
            "verseOrgIds": [
              "JOL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani bammwe ne bawala bammwe ndibaguza batabani ba Yuda, nabo balibaguza abantu ab'omu ggwanga ery'ewala ennyo, ery'e Seba.\" Ebyo",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.8",
            "verseOrgIds": [
              "JOL.4.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOL.3.8",
                "verseOrgIds": [
                  "JOL.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": "y'abyogedde.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.8",
            "verseOrgIds": [
              "JOL.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bakabona Balangirira Omusango eri Abaamawanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona mulangirire mu mawanga bwe muti nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:9"
      },
      "items": [
        {
          "text": "Mwetegekere olutalo!",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:9"
      },
      "items": [
        {
          "text": "Muyite abalwanyi bammwe ab'amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:9"
      },
      "items": [
        {
          "text": "buli mulwanyi yenna asembere ajje mu lutalo.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkumbi zammwe muziweeseemu ebitala,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:10"
      },
      "items": [
        {
          "text": "n'obwambe bwammwe mubuweeseemu amafumu;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:10"
      },
      "items": [
        {
          "text": "omunafu agambe nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:10"
      },
      "items": [
        {
          "text": "\"Ndi wa maanyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujje mangu mwe mwenna abamawanga agatwetoolodde,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:11"
      },
      "items": [
        {
          "text": "mukuŋŋaanire mu kiwonvu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:11"
      },
      "items": [
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOL.3.11",
                "verseOrgIds": [
                  "JOL.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", weereza eggye lyo libalumbe.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Amawanga geeteeketeeke",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:12"
      },
      "items": [
        {
          "text": "gajje mu kiwonvu ekya Yekosafaati;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:12"
      },
      "items": [
        {
          "text": "kubanga eyo gye ndisinzira",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:12"
      },
      "items": [
        {
          "text": "ne nsalira amawanga gonna ageetoolodde wano omusango.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kozesa oluwabyo lwo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "kubanga ekiseera eky'amakungula kituuse.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "Mujje mubabetente nga bwe mulinnyirira emizabbibu mu ssogolero",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "okutuusa envinnyo lw'ekulukuta,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "ekibi kyabwe kinene nnyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
