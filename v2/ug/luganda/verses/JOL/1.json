            "sid": "JOL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buno bwe bubaka bwa",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.1",
            "verseOrgIds": [
              "JOL.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOL.1.1",
                "verseOrgIds": [
                  "JOL.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "obwajjira Yoweeri mutabani wa Pesweri.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.1",
            "verseOrgIds": [
              "JOL.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwulirize mmwe abakadde ba Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "buli ali mu nsi naye awulirize.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "Kino kyali kibaddewo mu biseera byammwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "oba mu biseera bya bakitammwe?",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukibuulire abaana bammwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:3"
      },
      "items": [
        {
          "text": "nabo balikibuulira abaana baabwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:3"
      },
      "items": [
        {
          "text": "nabo balikibuulira ab'emirembe egiriddawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibinja by'enzige ebisooka bye zitalidde,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "enzige eziddirira zibirumbye,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "ate ezo bye zireseewo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "enzige ento bye ziridde,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "ate zino bye zireseewo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "enzige endala ne zibizikiririza ddala byonna!",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzuukuke, mmwe abatamiivu, mwekaabire amaziga;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "mukube ebiwoobe mmwe mwenna abanywi b'omwenge,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "mukube ebiwoobe kubanga akamwa kammwe",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "katuuse okwerabira omwenge omusu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eggwanga lirumbye ensi yange,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "ery'amaanyi ennyo era ery'abantu abatabalika.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "Amannyo gaalyo gali ng'ag'empologoma,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "n'amasongezo gaalyo ng'ag'empologoma enkazi.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eggwanga eryo lizikirizza emizabbibu gyange,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "ne limalawo emitiini gyange.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "Lisusumbudde ebikuta byagyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "byonna biri ku ttaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "amatabi gaagyo gasigadde gatukuuliridde.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukungubage nga nnamwandu omuto afiiriddwa bba,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.8",
            "verseOrgIds": [
              "JOL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:8"
      },
      "items": [
        {
          "text": "ng'ayambadde ebibukutu olw'ennaku.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.8",
            "verseOrgIds": [
              "JOL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiweebwayo eby'emmere ey'empeke n'ebiweebwayo eby'okunywa",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:9"
      },
      "items": [
        {
          "text": "tewakyali kirabikako mu nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOL.1.9",
                "verseOrgIds": [
                  "JOL.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:9"
      },
      "items": [
        {
          "text": "Bakabona abaweerereza mu maaso ga Katonda",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:9"
      },
      "items": [
        {
          "text": "bakungubaga.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennimiro ziweddemu ebirime;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:10"
      },
      "items": [
        {
          "text": "ettaka likaze,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:10"
      },
      "items": [
        {
          "text": "Emmere ey'empeke eweddewo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:10"
      },
      "items": [
        {
          "text": "omwenge omusu n'amafuta g'emizeeyituuni ne bibulira ddala.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmwe abalimi mukwatibwe entiisa,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
              "JOL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:11"
      },
      "items": [
        {
          "text": "mmwe abalima emizabbibu mukaabe.",
          "type": "text",
