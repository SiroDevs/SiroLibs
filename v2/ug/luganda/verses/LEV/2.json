    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etteeka ery'Ekiweebwayo eky'Empeke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Omuntu yenna bw'anaaleetanga eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.1",
            "verseOrgIds": [
              "LEV.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.1",
                "verseOrgIds": [
                  "LEV.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ekiweebwayo eky'emmere ey'empeke; empeke anaamalanga kuzisa, n'aleeta obuwunga obulungi. Anaabufukangako amafuta ag'omuzeeyituuni, n'ateekako n'obubaane,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.1",
            "verseOrgIds": [
              "LEV.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'alyoka abuleetera batabani ba Alooni, bakabona. Kabona anaayoolanga olubatu lw'obuwunga obulimu amafuta ag'omuzeeyituuni n'obubaane, n'abwokya mu kyoto ng'ekijjukizo, nga kye kiweebwayo ekyokeddwa mu muliro ne kivaamu evvumbe eddungi erisanyusa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.2",
            "verseOrgIds": [
              "LEV.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.2",
                "verseOrgIds": [
                  "LEV.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.2",
            "verseOrgIds": [
              "LEV.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuwunga obunaasigalangawo ku kiweebwayo, bunaatwalibwanga Alooni ne batabani be, nga kye kitundu ekitukuvu ennyo eky'ekiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.3",
                "verseOrgIds": [
                  "LEV.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyokeddwa mu muliro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bw'onooleetanga emigaati egifumbiddwa mu oveni nga kye kiweebwayo, ginaabanga emigaati egikoleddwa mu buwunga obulungi nga mutabuddwamu n'amafuta ag'omuzeeyituuni nga tegiriimu kizimbulukusa, oba bunaabanga obusukuuti obw'oluwewere obutaliimu kizimbulukusa nga busiigiddwako amafuta ag'omuzeeyituuni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.4",
            "verseOrgIds": [
              "LEV.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiweebwayo kyo bwe kinaabanga eky'emmere ey'empeke nga kitegekeddwa ku lukalango, kinaakolebwanga mu buwunga obulungi obutaliimu kizimbulukusa nga butabuddwamu amafuta ag'omuzeeyituuni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.5",
            "verseOrgIds": [
              "LEV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onookimenyaamenyanga mu butundutundu, n'okifukako amafuta ag'omuzeeyituuni. Ekyo kye kiweebwayo eky'emmere ey'empeke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.6",
            "verseOrgIds": [
              "LEV.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiweebwayo kyo bwe kinaabanga eky'emmere ey'empeke nga kyakufumbirwa mu fulampeni, kinaateekebwateekebwanga mu buwunga obulungi n'amafuta ag'omuzeeyituuni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.7",
            "verseOrgIds": [
              "LEV.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onooleeteranga",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.8",
            "verseOrgIds": [
              "LEV.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.8",
                "verseOrgIds": [
                  "LEV.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ekiweebwayo ekyo eky'emmere ey'empeke ekitabuddwa mu bintu ebyo; bwe kinaakwasibwanga kabona, ye anaakireetanga ku kyoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.8",
            "verseOrgIds": [
              "LEV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabona anaggyanga ku kiweebwayo eky'emmere ey'empeke, ekitundu eky'ekijjukizo kyakyo, n'akyokya ku kyoto, nga kye kiweebwayo ekyokeddwa mu muliro ne kivaamu evvumbe eddungi erisanyusa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.9",
            "verseOrgIds": [
              "LEV.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.9",
                "verseOrgIds": [
                  "LEV.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.9",
            "verseOrgIds": [
              "LEV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ekinaafikkanga ku kiweebwayo eky'emmere ey'empeke, Alooni ne batabani be, be banaakitwalanga; nga kye kitundu ekitukuvu ennyo ekibalirwa ku biweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.10",
                "verseOrgIds": [
                  "LEV.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyokeddwa mu muliro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekizimbulukusa n'Omunnyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Temuleeteranga",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.11",
                "verseOrgIds": [
                  "LEV.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ekiweebwayo eky'emmere ey'empeke nga kiteekeddwamu n'ekizimbulukusa; kubanga temuuyokyenga kizimbulukusa wadde omubisi gw'enjuki ng'ekiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.11",
                "verseOrgIds": [
                  "LEV.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyokeddwa mu muliro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munaabireetanga eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.12",
                "verseOrgIds": [
                  "LEV.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ng'ebiweebwayo eby'ebibala ebibereberye, naye tebiiweerwengayo ku kyoto okubeera evvumbe eddungi erisanyusa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.12",
                "verseOrgIds": [
                  "LEV.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiweebwayo byo byonna eby'emmere ey'empeke onoobirungangamu omunnyo",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        },
        {
          "text": ": tokkirizanga munnyo ogw'endagaano ne Katonda wo okubula mu biweebwayo byo eby'emmere ey'empeke; mu biweebwayo byo byonna ossangamu omunnyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bw'onooleetanga eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.14",
            "verseOrgIds": [
              "LEV.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.14",
                "verseOrgIds": [
                  "LEV.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ebiweebwayo eby'ebibala ebibereberye eby'emmere ey'empeke, binaabanga ebirimba ebibisi ebibereberye eby'emmere ey'empeke nga bibetenteddwa era nga byokeddwako mu muliro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.14",
            "verseOrgIds": [
              "LEV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoobifukangako amafuta ag'omuzeeyituuni, n'obiteekangako n'obubaane; ekyo nga kye kiweebwayo eky'emmere ey'empeke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.15",
            "verseOrgIds": [
              "LEV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabona anaggyanga ku kiweebwayo eky'emmere ey'empeke, ekimaze okubetentebwa nga mulimu amafuta ag'omuzeeyituuni n'obubaane, ekitundu eky'ekijjukizo kyakyo, n'akyokya; ekyo nga kye kiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.16",
            "verseOrgIds": [
              "LEV.2.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.2.16",
                "verseOrgIds": [
                  "LEV.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyokeddwa mu muliro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.16",
            "verseOrgIds": [
              "LEV.2.16"
            ]
          }
        }
      ]
    }
