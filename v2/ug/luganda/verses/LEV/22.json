          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bwe mutyo mukwatenga amateeka gange era mugagonderenga. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.31",
                "verseOrgIds": [
                  "LEV.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temuvumisanga linnya lyange. Abaana ba Isirayiri kibagwanira okunzisangamu ekitiibwa nga Nze mutukuvu. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.32",
                "verseOrgIds": [
                  "LEV.22.32"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda abatukuza mmwe,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "era Nze nabaggya mu nsi y'e Misiri mbeerenga Katonda wammwe. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.33",
            "verseOrgIds": [
              "LEV.22.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
