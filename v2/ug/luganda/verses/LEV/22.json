            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.33",
                "verseOrgIds": [
                  "LEV.22.33"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.\"",
          "type": "text",
