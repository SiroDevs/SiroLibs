      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukolo ogw'Okutangiririra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.1",
                "verseOrgIds": [
                  "LEV.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'ayogera ne Musa, abaana ba Alooni ababiri bwe baali bamaze okufa olwokubanga baasemberera",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.1",
                "verseOrgIds": [
                  "LEV.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.2",
                "verseOrgIds": [
                  "LEV.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti, \"Tegeeza muganda wo Alooni alemenga okujja buli w'anaayagaliranga, mu kifo Awatukuvu ekiri munda w'eggigi, okutunuulira entebe ey'okusaasira eri ku Ssanduuko ey'Endagaano; bw'alikikola talirema kufa; kubanga nzijanga kulabikira mu kire nga kiri waggulu w'entebe ey'okusaasira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.2",
            "verseOrgIds": [
              "LEV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Alooni bw'anaabanga ajja mu kifo Awatukuvu anaaleetanga ennyana ennume olw'ekiweebwayo olw'ekibi, n'endiga ennume olw'ekiweebwayo ekyokebwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.3",
            "verseOrgIds": [
              "LEV.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaayambalanga ekkooti entukuvu eya bafuta, ne munda ku mubiri gwe anaasookangako empale eya bafuta, nga yeesibye olukoba olwa bafuta, ne ku mutwe ng'asibyeko ekitambaala ekya bafuta. Ebyambalo ebyo bitukuvu, noolwekyo kimusaaniranga okusooka okunaaba omubiri gwe mu mazzi nga tannabyambala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.4",
            "verseOrgIds": [
              "LEV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era anaggyanga mu baana ba Isirayiri embuzi ennume bbiri nga za kiweebwayo olw'ekibi, n'endiga emu nga ya kiweebwayo ekyokebwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.5",
            "verseOrgIds": [
              "LEV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Alooni anaawangayo ennyana ennume nga ya kiweebwayo kye olw'ekibi alyoke yeetangiririre awamu n'ab'omu maka ge.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.6",
            "verseOrgIds": [
              "LEV.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era anaddiranga embuzi ebbiri n'azireeta eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.7",
                "verseOrgIds": [
                  "LEV.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "mu mulyango gw'Eweema ey'Okukuŋŋaanirangamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embuzi ebbiri Alooni anaazikubirangako obululu; akalulu akamu nga ka kugwa ku mbuzi ya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.8",
                "verseOrgIds": [
                  "LEV.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'akalala nga ka kugwa ku mbuzi enessibwangako omusango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alooni anaddiranga embuzi akalulu ka",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.9",
                "verseOrgIds": [
                  "LEV.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kwe kanaagwanga, n'agiwaayo okubeera ekiweebwayo olw'okwonoona.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye embuzi eneegwangako akalulu ak'okugissibyako omusango, eneeweebwangayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.10",
                "verseOrgIds": [
                  "LEV.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "nga nnamu, n'eteebwa n'eddukira mu ddungu mu kifo Azazeri ng'esibiddwako omusango olw'okutangirira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekiweebwayo olw'Ekibi ekya Kabona n'Abantu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Alooni anaawangayo ennyana eyo ennume nga ya kiweebwayo kye olw'ekibi, alyoke yeetangiririre awamu n'ab'omu maka ge; ennyana eyo ennume anaagittanga nga kye kiweebwayo kye olw'ekibi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.11",
            "verseOrgIds": [
              "LEV.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaddiranga ekyoterezo ky'obubaane nga kijjudde amanda g'omuliro nga gavudde ku kyoto eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.12",
                "verseOrgIds": [
                  "LEV.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'embatu bbiri ez'obubaane obw'akaloosa obumerunguddwa obulungi, n'abireeta munda w'eggigi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anassanga obubaane ku muliro eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.13",
                "verseOrgIds": [
                  "LEV.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'omukka ogunaavanga mu bubaane gunaabikkanga entebe ey'okusaasira eri kungulu w'Essanduuko ey'Endagaano, alyoke aleme okufa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaddiranga ku musaayi ogw'ennyana eyo ennume n'agumansira n'olunwe lwe ku ludda olw'ebuvanjuba olw'entebe ey'okusaasira; era omusaayi ogumu anaagumansiranga n'olunwe lwe emirundi musanvu mu maaso g'entebe ey'okusaasira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.14",
            "verseOrgIds": [
              "LEV.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Era anattanga embuzi ey'ekiweebwayo ky'abantu olw'ekibi, n'atwala omusaayi gwayo munda w'eggigi n'agukola nga bwe yakola omusaayi gw'ennyana ennume; anaagumansiranga ku ntebe ey'okusaasira ne mu maaso gaayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.15",
            "verseOrgIds": [
              "LEV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ngeri eyo anaatangiririranga Ekifo eky'Awatukuvu Ennyo olw'obutali bulongoofu n'obujeemu eby'abaana ba Isirayiri, n'olw'ebyonoono byabwe ebirala byonna nga bwe byali. Era anaakolanga bw'atyo ne ku Weema ey'Okukuŋŋaanirangamu eri mu bo wakati mu butali bulongoofu bwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.16",
            "verseOrgIds": [
              "LEV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu Weema ey'Okukuŋŋaanirangamu temuubengamu muntu n'omu Alooni bw'anaayingirangamu okutangiririra Ekifo eky'Awatukuvu Ennyo, okutuusa lw'anaafulumanga ng'amaze okwetangiririra awamu n'ab'omu maka ge, n'ekibiina kyonna ekya Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.17",
            "verseOrgIds": [
              "LEV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era anaafulumanga n'ajja ku kyoto ekiri awali",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.18",
                "verseOrgIds": [
                  "LEV.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "n'akitangiririra. Anaddiranga ku musaayi gw'ennyana eya seddume ne ku musaayi gw'embuzi n'agusiiga ku mayembe gonna ag'ekyoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musaayi ogwo anaamansirangako ku kyoto n'olunwe lwe emirundi musanvu okukifuula ekirongoofu n'okukitukuza okukiggya mu butali bulongoofu obw'abaana ba Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Embuzi Esibibwako Omusango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Awo Alooni bw'anaamalanga okutangiririra Ekifo eky'Awatukuvu Ennyo, n'Eweema ey'Okukuŋŋaanirangamu, n'ekyoto, anaaleetanga embuzi ennamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
            "verseOrgIds": [
              "LEV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaateekanga emikono gye gyombi ku mutwe gw'embuzi eyo ennamu n'agikwatako, n'agyenenyerezaako ebyonoono by'abaana ba Isirayiri, n'obujeemu bwabwe, n'ebibi byabwe byonna, ng'abitadde ku mutwe gw'embuzi eyo. Embuzi anaagisindikanga mu ddungu ng'etwalibwa omusajja anaalondebwanga okukola omulimu ogwo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.21",
            "verseOrgIds": [
              "LEV.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embuzi eyo eneetikkanga ebyonoono by'abaana ba Isirayiri byonna n'ebitwala mu kifo eteri bantu, eyo omusajja oyo gy'anaagiteeranga n'eraga mu ddungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
            "verseOrgIds": [
              "LEV.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Alooni anaayingiranga mu Weema ey'Okukuŋŋaanirangamu, ne yeeyambulamu ebyambalo ebya bafuta bye yayambadde nga tannayingira mu Kifo eky'Awatukuvu Ennyo, era naabirekanga awo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaanaabiranga omubiri gwe mu mazzi nga gali mu kifo ekitukuvu, n'alyoka ayambala ebyambalo bye ebya bulijjo. Anaafulumanga n'awaayo ekiweebwayo kye ekyokebwa ku lulwe, n'ekiweebwayo ekyokebwa olw'abantu bonna, alyoke yeetangiririre era n'abantu abatangiririre.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'amasavu ag'ekiweebwayo olw'ekibi anaagookeranga ku kyoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omusajja anaatanga embuzi esibiddwako omusango, eraze mu Azazeri mu ddungu, kinaamugwaniranga okwoza engoye ze n'okunaaba omubiri gwe n'amazzi; oluvannyuma anaakomangawo mu lusiisira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennyana ennume n'embuzi ennume ez'okuwaayo olw'ebiweebwayo olw'ekibi, era omwava omusaayi ogwaleetebwa mu Kifo eky'Awatukuvu Ennyo olw'okutangiririra, ziteekwa okufulumizibwa ebweru w'olusiisira, amaliba gaazo n'ennyama yaazo eriibwa n'eyo eteriibwa, zonna binaayokebwanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo anaazokyanga anaateekwanga okwoza engoye ze, n'okunaaba omubiri gwe mu mazzi; oluvannyuma anaakomangawo mu lusiisira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olunaku olw'Okutangiririra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Etteeka lino munaalikwatanga emirembe gyonna: Ku lunaku olw'ekkumi mu mwezi ogw'omusanvu muneelesanga eby'amasanyu byonna n'emirimu gyammwe gyonna, temuukolerengako mulimu gwonna mmwe bannannyini nsi era n'abagwira ababeera mu mmwe,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubanga ku lunaku olwo mulitangiririrwa ne mufuulibwa abalongoofu. Bwe mutyo munaabeeranga muvudde mu byonoono byammwe ne mufuulibwa balongoofu mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.30",
                "verseOrgIds": [
                  "LEV.16.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lunaabanga ssabbiiti nga lwa kuwummula; era kibasaanira okwefiisanga bye mwandiyagadde; etteeka eryo linaabanga lya mirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabona eyafukibwako amafuta ag'omuzeeyituuni era ng'ayawulibbwa n'asikira kitaawe, y'anaatangiririranga. Anaayambalanga ebyambalo ebya linena ebitukuvu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'atangiririra Ekifo Awatukuvu Ennyo, n'atangiririra n'Eweema ey'Okukuŋŋaanirangamu, n'atangiririra n'ekyoto, ne bakabona awamu n'abantu bonna mu kibiina kyonna.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Etteeka eryo linaababeereranga lya mirembe gyonna, ng'okutangiririra okwo kukolebwa omulundi gumu buli mwaka olw'ebyonoono byonna eby'abaana ba Isirayiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 16:34"
      },
      "items": [
        {
          "text": "Awo byonna ne bikolebwa nga",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.34",
                "verseOrgIds": [
                  "LEV.16.34"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda bwe yalagira Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    }
  ],
