              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Musa n'avaayo n'amagumba ga Yusufu, kubanga Yusufu yali alayizza abaana ba Isirayiri. Yabagamba nti, \"Ddala, ddala",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.19",
                "verseOrgIds": [
                  "EXO.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "agenda kubadduukirira. Kale, amagumba gange mugendanga nago nga muva wano.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
