                "verseId": "EXO.13.21",
                "verseOrgIds": [
                  "EXO.13.21"
                ]
              }
            }
          ]
        },
        {
          "text": "yabakulemberanga ng'ali mu mpagi ey'ekire okubalaga ekkubo, n'ekiro ng'ali mu mpagi ey'omuliro okubamulisiza, balyoke batambulenga emisana n'ekiro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.21",
            "verseOrgIds": [
