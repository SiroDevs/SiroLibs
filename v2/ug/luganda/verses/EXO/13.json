              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empagi ey'ekire ey'emisana, n'empagi ey'omuliro ey'ekiro tezaggibwawo mu maaso g'abantu obudde bwonna.",
          "type": "text",
