        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okulondebwa kw'Abakozi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.1",
            "verseOrgIds": [
              "EXO.31.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.1",
                "verseOrgIds": [
                  "EXO.31.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.1",
            "verseOrgIds": [
              "EXO.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laba, nnonze Bezaaleeri mutabani wa Uli, muzzukulu wa Kuuli, ow'omu kika kya Yuda;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.2",
            "verseOrgIds": [
              "EXO.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "era mmujjuzza Omwoyo wa Katonda, n'okumanya, n'obusobozi n'amagezi mu kukola ebitali bimu ebyemikono",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.3",
            "verseOrgIds": [
              "EXO.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "okutetenkanya ebintu ebinaakolebwa mu zaabu ne ffeeza n'ekikomo, nga bwe binaafaanana,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.4",
            "verseOrgIds": [
              "EXO.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "okwola amayinja n'okugategeka, n'okwola emiti, era n'okukola byonna ebyemikono ebya buli ngeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.5",
            "verseOrgIds": [
              "EXO.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate mmulondeddeko Okoliyaabu mutabani wa Akisamaki, ow'omu kika kya Ddaani, okumuyamba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.6",
            "verseOrgIds": [
              "EXO.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EXO 31:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 31:6"
      },
      "items": [
        {
          "text": "\"Era abakugu abakola ebintu byonna ebya buli ngeri, mbawadde amagezi okukola bino byonna bye nkulagidde:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Eweema ey'Okukuŋŋaanirangamu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 31:7"
      },
      "items": [
        {
          "text": "n'Essanduuko ey'Endagaano n'ekibikkako eky'entebe ey'okusaasira,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 31:7"
      },
      "items": [
        {
          "text": "awamu n'ebikozesebwa byonna mu Weema,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "emmeeza n'ebigenderako,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 31:8"
      },
      "items": [
        {
          "text": "ekikondo ekya zaabu omuka eky'ettaala n'ebigenderako,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 31:8"
      },
      "items": [
        {
          "text": "n'ekyoto eky'obubaane,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ekyoto eky'ebiweebwayo ebyokebwa n'ebigenderako,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.9",
            "verseOrgIds": [
              "EXO.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 31:9"
      },
      "items": [
        {
          "text": "n'ebbensani ne kw'etuula;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.9",
            "verseOrgIds": [
              "EXO.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ebyambalo ebyalukibwa obulungi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 31:10"
      },
      "items": [
        {
          "text": "ebyambalo ebitukuvu ebya Alooni, kabona,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 31:10"
      },
      "items": [
        {
          "text": "n'ebyambalo bya batabani be bye baweererezaamu mu bwakabona;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'amafuta ag'okufukibwa, n'ebyakaloosa akalungi ak'omu Kifo Ekitukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EXO 31:11"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 31:11"
      },
      "items": [
        {
          "text": "\"Byonna babikole nga bwe nakulagira.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ssabbiiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.12",
            "verseOrgIds": [
              "EXO.31.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.12",
                "verseOrgIds": [
                  "EXO.31.12"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.12",
            "verseOrgIds": [
              "EXO.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tegeeza abaana ba Isirayiri nti, Munaateekwanga okukuuma Ssabbiiti zange, kubanga ako ke kabonero akanaabeeranga wakati wammwe nange mu mirembe gyammwe gyonna, mulyoke mumanye nga Nze",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.13",
                "verseOrgIds": [
                  "EXO.31.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Nze mbatukuza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Munaakuumanga Ssabbiiti, kubanga lunaku lutukuvu. Buli anaaluweebuulanga waakufa; ne buli anaakolanga omulimu gwonna ku lunaku olwo waakuggibwa mu bantu be, attibwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.14",
            "verseOrgIds": [
              "EXO.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emirimu ginaakolwanga mu nnaku mukaaga, naye olunaku olw'omusanvu ye Ssabbiiti ey'okuwummula, lunaku lwa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.15",
                "verseOrgIds": [
                  "EXO.31.15"
                ]
              }
            }
          ]
        },
        {
          "text": "lutukuvu. Buli anaakolanga omulimu ku lunaku lwa Ssabbiiti wa kuttibwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo abaana ba Isirayiri banaakumanga olunaku lwa Ssabbiiti, nga balujjukira mu mirembe gyabwe gyonna, ng'endagaano etaggwaawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaabeeranga kabonero wakati wange n'abaana ba Isirayiri emirembe gyonna, akalaga nti",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.17",
                "verseOrgIds": [
                  "EXO.31.17"
                ]
              }
            }
          ]
        },
        {
          "text": "yakola eggulu n'ensi mu nnaku mukaaga, ne ku lunaku olw'omusanvu n'alekeraawo okukola, n'awummula.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.18",
                "verseOrgIds": [
                  "EXO.31.18"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yamaliriza okwogera ne Musa ku lusozi Sinaayi, n'awa Musa ebipande bibiri eby'amayinja, eby'Endagaano Katonda gye yawandiika n'engalo ye, ye kennyini.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
        }
      ]
    }
  ],
