              "type": "text"
            }
          ]
        },
        {
          "text": "Ekikomo ekyaweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
            ]
          }
