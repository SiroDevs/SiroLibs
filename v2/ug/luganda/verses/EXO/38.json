                "verseOrgIds": [
                  "EXO.38.29"
                ]
              }
            }
          ]
        },
        {
          "text": "olw'ekiweebwayo ekiwuubibwa kyali kilo enkumi bbiri mu ebikumi bina.",
          "type": "text",
