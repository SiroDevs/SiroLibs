  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ROM 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nze Pawulo, omuddu",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        },
        {
          "text": "wa Yesu Kristo, Mukama waffe Kristo, nayitibwa okuba omutume, eyayawulibwa okubuulira Enjiri ya Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "gye yasuubiriza mu bannabbi be mu byawandiikibwa ebitukuvu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.2",
            "verseOrgIds": [
              "ROM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebyogera ku Mwana we, eyava mu zadde lya Dawudi mu mubiri,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.3",
            "verseOrgIds": [
              "ROM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyakakasibwa okuba Omwana wa Katonda mu maanyi aga Mwoyo Mutukuvu olw'okuzuukira kw'abafu, ye Yesu Kristo Mukama waffe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.4",
            "verseOrgIds": [
              "ROM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu Yesu Kristo Mukama waffe, mwe twaweerwa ekisa, ne mpitibwa okuba omutume, amawanga gonna galyoke gamugondere mu kukkiriza ku lw'erinnya lye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.5",
            "verseOrgIds": [
              "ROM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nammwe muli mu abo abaayitibwa okuba abayigirizwa ba Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.6",
            "verseOrgIds": [
              "ROM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpandikira abo bonna ababeera mu Ruumi, abaagalwa ba Katonda, abaayitibwa okuba abatukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ROM 1:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 1:7"
      },
      "items": [
        {
          "text": "Ekisa n'emirembe ebiva eri Katonda Kitaffe ne Yesu Kristo Mukama waffe, bibeerenga nammwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pawulo Ayagala Okukyala mu Ruumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okusooka neebaza nnyo Katonda wange ku lwammwe mwenna, ku bwa Yesu Kristo, olw'okukkiriza kwammwe okunywevu okwogerwako mu nsi yonna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda gwe mpeereza n'omutima gwange gwonna nga mbulira Enjiri ey'Omwana we, ye mujulirwa wange, nga bwe mbasabira bulijjo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga mbegayiririra bulijjo mu kusaba kwange, ndyoke nsobole okubatuukako nga Katonda bw'anaayagala.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.10",
            "verseOrgIds": [
              "ROM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga neesunga nnyo okubalaba, ndyoke mbawe ku kirabo eky'omwoyo, mulyoke munywezebwe okutuuka ku nkomerero,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.11",
            "verseOrgIds": [
              "ROM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwe kugamba: twezengamu amaanyi ffekka ne ffekka olw'okukkiriza kwe tulina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabula njagala mumanye kino, abooluganda nti, Emirundi mingi nateekateeka okujja gye muli naye ne nziyizibwa okutuusa kaakano, ndyoke nkungule ebibala mu mmwe, nga bwe kiri mu mawanga amalala.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga nnina ebbanja eri Abayonaani n'abatali Bayonaani, n'eri ab'amagezi n'eri abasirusiru,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.14",
            "verseOrgIds": [
              "ROM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "era nammwe ab'e Ruumi kyenva njagala okubabuulira Enjiri.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.15",
            "verseOrgIds": [
              "ROM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enjiri tenkwasa nsonyi: kubanga ge maanyi ga Katonda agalokola buli muntu akkiriza, okusooka eri Omuyudaaya n'eri Omunnamawanga.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga mu yo obutuukirivu bwa Katonda bubikkulibwa. Obutuukirivu obwo butuweebwa olw'okukkiriza, olw'okukkiriza kwokka, nga bwe kyawandiikibwa nti, \"Abatuukirivu banaabeeranga balamu lwa kukkiriza.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obusungu bwa Katonda eri Abantu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga obusungu bwa Katonda bubikkulibbwa okuva mu ggulu ku abo abatatya Katonda bonna n'abakaafiiri bonna ku bye bakola okuziyiza amazima okuvaayo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.18",
            "verseOrgIds": [
              "ROM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ebisoboka okumanyibwa ku Katonda bibabikkuliddwa, kubanga Katonda abibalaze byonna mu bujjuvu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
            "verseOrgIds": [
              "ROM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga okuviira ddala ku kutondebwa kw'ensi, ebintu bye ebitalabika, bwe buyinza bwe obutaggwaawo n'obwa Katonda bwe, bitegeerwa ne birabikira ddala mu by'obutonde bwe, abantu balyoke baleme kubaako na kya kwewolereza.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga newaakubadde nga Katonda bamumanyi, tebaamugulumiza nga Katonda wadde okumwebazanga, naye ne bagobereranga ebitaliimu mu mpaka zaabwe, omutima gwabwe omusirusiru ne gujjuzibwa ekizikiza.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.21",
            "verseOrgIds": [
              "ROM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beeyita ab'amagezi ne bafuuka abasirusiru,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.22",
            "verseOrgIds": [
              "ROM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bawanyisa ekitiibwa kya Katonda ataggwaawo okukifaananyiriza ekifaananyi ky'omuntu aggwaawo, n'eky'ebinyonyi, n'eky'ebirina amagulu ana n'eky'ebyewalula.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.23",
            "verseOrgIds": [
              "ROM.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda kyeyava abaleka, emitima gyabwe ne girulunkanira eby'obugwagwa ne bawemula emibiri gyabwe bokka na bokka.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.24",
            "verseOrgIds": [
              "ROM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bafuula amazima ga Katonda okuba obulimba ne basinza era ne baweereza ebitonde, mu kifo ky'okusinza eyabitonda, eyeebazibwa emirembe n'emirembe. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.25",
            "verseOrgIds": [
              "ROM.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda kyeyava abaleka ne beeyongera mu kwegomba kwabwe okw'obuwemu. Abakazi baabwe baawanyisa enkolagana yaabwe ey'obuzaaliranwa n'abasajja, ne bakola ebitali bya buzaaliranwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.26",
            "verseOrgIds": [
              "ROM.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasajja nabo baalekayo okwegatta ne bakazi baabwe mu ngeri ey'obuzaaliranwa, ne bajjuzibwa obukaba ne beegatta ne basajja bannaabwe. N'ekyava mu bikolwa ebyo eby'obugwagwa, kwe kusasulibwa empeera esaanira okwonoona kwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baagaana okumanya Katonda, Katonda kyeyava abaleka ne babeera n'omutima omwonoonefu ne bakola ebitasaana.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bajjuzibbwa obutali butuukirivu bwonna, n'ebibi, n'omululu, n'obukyayi, n'obuggya, n'obussi, n'entalo, n'obulimba, n'enkwe, n'okwogera ebitasaana, nga basala ku bannaabwe ebigambo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "era nga bageya, nga bakyawa Katonda, nga bavuma bannaabwe, nga bajjudde amalala n'okwekulumbaza, nga bagunjawo enkola y'ebikyamu, era nga bajeemera bakadde baabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
