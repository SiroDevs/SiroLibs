            "number": "31",
            "style": "v",
            "sid": "ROM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tebategeera so tebalina kukkiriza, tebalina kwagala, era tebalina mutima gusaasira.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
