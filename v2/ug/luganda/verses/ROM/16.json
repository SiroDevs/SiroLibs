  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ROM 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okulamusa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano mbanjulira Foyibe mwannyinaffe, era omuweereza w'ekkanisa",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        },
        {
          "text": "ey'omu Kenkereya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwanirize mu Mukama waffe, nga bwe kigwanidde abatukuvu, era muyimirire naye nga mumuyamba mu nsonga yonna gye yeetaaga, kubanga naye yennyini yayamba bangi era nange kennyini.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.2",
            "verseOrgIds": [
              "ROM.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Pulisikira ne Akula, bwe tukola omulimu mu Kristo Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.3",
            "verseOrgIds": [
              "ROM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeewaayo wakiri okutemwako emitwe olw'obulamu bwange, era si beebaza bokka wabula n'Ekkanisa z'Abamawanga zonna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.4",
            "verseOrgIds": [
              "ROM.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutuuse okulamusa kwange eri abo bonna abakuŋŋaana ng'ekkanisa mu maka gaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.5",
            "verseOrgIds": [
              "ROM.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:5"
      },
      "items": [
        {
          "text": "Mundabire mukwano gwange omwagalwa Epayineeto, kye kibala eky'olubereberye eky'omu Asiya eri Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.5",
            "verseOrgIds": [
              "ROM.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Maliyamu eyabakolera ennyo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.6",
            "verseOrgIds": [
              "ROM.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Anduloniiko ne Yuniya ab'ekika kyange, abaasibibwa awamu nange mu kkomera, era bassibwamu nnyo ekitiibwa abatume era be bansooka okubeera mu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.7",
            "verseOrgIds": [
              "ROM.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Ampuliyaato omwagalwa wange mu Mukama waffe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.8",
            "verseOrgIds": [
              "ROM.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Ulubano, mukozi munnaffe mu Kristo, n'omwagalwa waffe Sutaku.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.9",
            "verseOrgIds": [
              "ROM.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Apere, asiimibwa mu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.10",
            "verseOrgIds": [
              "ROM.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:10"
      },
      "items": [
        {
          "text": "Mundabire n'ab'omu nnyumba ya Alisutobulo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.10",
            "verseOrgIds": [
              "ROM.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Kerodiyoni muganda wange.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.11",
            "verseOrgIds": [
              "ROM.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:11"
      },
      "items": [
        {
          "text": "Mundabire ab'omu nnyumba ya Nalukiso.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.11",
            "verseOrgIds": [
              "ROM.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Terufayina ne Terufoosa, abaakola ennyo omulimu gwa Mukama waffe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.12",
            "verseOrgIds": [
              "ROM.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:12"
      },
      "items": [
        {
          "text": "Mundabire Perusi omwagalwa eyakola ennyo omulimu mu Mukama waffe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.12",
            "verseOrgIds": [
              "ROM.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Luufo Mukama gwe yalonda, era ne nnyina ali nga mmange.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.13",
            "verseOrgIds": [
              "ROM.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Asunkulito ne Felegoni, ne Kerume, ne Patuloba, ne Keruma era n'abooluganda abali nabo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.14",
            "verseOrgIds": [
              "ROM.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundabire Firologo ne Yuliya, ne Nerewu ne mwannyina, ne Olumpa n'abatukuvu bonna abali awamu nabo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.15",
            "verseOrgIds": [
              "ROM.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulamusagane n'okunywegera okutukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.16",
            "verseOrgIds": [
              "ROM.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:16"
      },
      "items": [
        {
          "text": "Ekkanisa zonna eza Kristo, zibalamusizza.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.16",
            "verseOrgIds": [
              "ROM.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebisembayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo mbakuutira abooluganda mwegenderezenga abo abaleeta enjawukana, n'eby'esittaza ebikontana n'okuyigiriza kwe mwayiga, era mubakubenga amabega.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.17",
            "verseOrgIds": [
              "ROM.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga abantu ng'abo tebaweereza Mukama waffe Yesu, wabula embuto zaabwe. Bakozesa ebigambo ebirungi eby'okuwaanawaana nga balimbalimba emitima gy'abanafu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.18",
            "verseOrgIds": [
              "ROM.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga amawulire ag'okuwulira kwammwe gaabuna mu bantu bonna, kyenvudde mbasanyukira. Naye njagala mubenga bagezi mu kukola obulungi, era abalongoofu abeewala ekibi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.19",
            "verseOrgIds": [
              "ROM.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano Katonda ow'emirembe ajja kubetentera Setaani wansi w'ebigere byammwe, mangu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
              "ROM.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ROM 16:20"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:20"
      },
      "items": [
        {
          "text": "Ekisa kya Mukama waffe Yesu kibeerenga nammwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
              "ROM.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoseewo mukozi munnange, ne Lukiyo ne Yasooni wamu ne Sosipateri, baganda bange, babatumidde.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nange Terutiyo",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.22",
            "verseOrgIds": [
              "ROM.16.22"
            ]
          }
        },
        {
          "text": "awandiika ebbaluwa eno, mbatumidde mu Mukama waffe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.22",
            "verseOrgIds": [
              "ROM.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaayo",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        },
        {
          "text": "ansuza, n'ekkanisa yonna babalamusizza. Mundabire Erasuto omuwanika w'ekibuga, ne Kwaluto muganda we.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekisa kya Mukama waffe Yesu Kristo kibeerenga nammwe mwenna. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.24",
            "verseOrgIds": [
              "ROM.16.24"
            ]
          }
        }
      ]
    },
    {
