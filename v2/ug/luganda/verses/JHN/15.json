        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Singa saakola mirimu egitaakolebwa muntu yenna mu bo tebandibaddeko musango. Naye kaakano balabye emirimu egyo, n'okutukyawa ne batukyawa, Nze ne Kitange.",
