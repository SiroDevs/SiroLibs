  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "JOB 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kaakano ggwe Yobu, wuliriza ebigambo byange:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.1",
            "verseOrgIds": [
              "JOB.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:1"
      },
      "items": [
        {
          "text": "ssaayo omwoyo ku byonna bye njogera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.1",
            "verseOrgIds": [
              "JOB.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba nnaatera okwasamya akamwa kange,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.2",
            "verseOrgIds": [
              "JOB.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:2"
      },
      "items": [
        {
          "text": "ebigambo byange bindi ku lulimi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.2",
            "verseOrgIds": [
              "JOB.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo byange biva mu mutima omulongoofu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:3"
      },
      "items": [
        {
          "text": "olulimi lwange, mu bwesimbu, lwogera bye mmanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoyo wa Katonda ye yankola,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.4",
            "verseOrgIds": [
              "JOB.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:4"
      },
      "items": [
        {
          "text": "era omukka gw'oyo Ayinzabyonna gumpa obulamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.4",
            "verseOrgIds": [
              "JOB.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onnyanukule nno bw'oba osobola,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:5"
      },
      "items": [
        {
          "text": "teekateeka ebigambo byo onjolekere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba, nange ndi ggwe mu maaso ga Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:6"
      },
      "items": [
        {
          "text": "Nange nava mu bbumba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobaako ky'otya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.7",
            "verseOrgIds": [
              "JOB.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:7"
      },
      "items": [
        {
          "text": "sijja kukunyigiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.7",
            "verseOrgIds": [
              "JOB.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ddala ddala oyogedde mpulira,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:8"
      },
      "items": [
        {
          "text": "ebigambo byennyini mbiwulidde ng'ogamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi mulongoofu sirina kibi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:9"
      },
      "items": [
        {
          "text": "siriiko musango so mu nze temuli butali butuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka Katonda anteekako omusango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.10",
            "verseOrgIds": [
              "JOB.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:10"
      },
      "items": [
        {
          "text": "anfudde omulabe we.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.10",
            "verseOrgIds": [
              "JOB.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiba ebigere byange mu nvuba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:11"
      },
      "items": [
        {
          "text": "antwala okuba omulabe we.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye leka nkubuulire, mu kino toli mutuufu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.12",
            "verseOrgIds": [
              "JOB.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:12"
      },
      "items": [
        {
          "text": "Katonda asinga omuntu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.12",
            "verseOrgIds": [
              "JOB.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki omwemulugunyiza nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:13"
      },
      "items": [
        {
          "text": "taddamu bigambo bya muntu yenna?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Katonda ayogerera mu ngeri emu, n'awalala n'ayogerera mu ngeri endala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:14"
      },
      "items": [
        {
          "text": "wadde ng'omuntu tassaayo mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kirooto mu kwolesebwa ekiro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:15"
      },
      "items": [
        {
          "text": "ng'otulo tungi tukutte abantu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:15"
      },
      "items": [
        {
          "text": "nga beebase ku bitanda byabwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "aggula amatu g'abantu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.16",
            "verseOrgIds": [
              "JOB.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:16"
      },
      "items": [
        {
          "text": "n'abalabula n'ebyekango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.16",
            "verseOrgIds": [
              "JOB.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "alyoke akyuse omuntu okumuggya mu bikolwa ebibi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:17"
      },
      "items": [
        {
          "text": "n'amalala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "aziyize emmeeme ye okukka mu bunnya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.18",
            "verseOrgIds": [
              "JOB.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:18"
      },
      "items": [
        {
          "text": "n'obulamu bwe buleme okuzikirira n'ekitala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.18",
            "verseOrgIds": [
              "JOB.33.18"
            ]
          }
        }
      ]
    },
