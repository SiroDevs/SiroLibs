  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "JOB 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lwaki Ayinzabyonna tagera biseera?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:1"
      },
      "items": [
        {
          "text": "Lwaki abo abamumanyi tebalaba nnaku zaageze?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bajjulula amayinja agalamba ensalo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:2"
      },
      "items": [
        {
          "text": "ne balunda ebisolo bye babbye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batwala endogoyi ya mulekwa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.3",
            "verseOrgIds": [
              "JOB.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:3"
      },
      "items": [
        {
          "text": "ne batwala ennume ya nnamwandu ng'omusingo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.3",
            "verseOrgIds": [
              "JOB.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basindiikiriza omunaku ne bamuggya mu kkubo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:4"
      },
      "items": [
        {
          "text": "ne bawaliriza abaavu bonna mu ggwanga okwekweka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endogoyi ez'omu ddungu nga bwe zeeyisa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:5"
      },
      "items": [
        {
          "text": "n'abaavu bagenda bategana nnyo nga balondalonda obumere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:5"
      },
      "items": [
        {
          "text": "mu ddungu mwe balonderera emmere y'abaana baabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Essubi eririibwa ensolo zaabwe baliggya ku ttale lye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.6",
            "verseOrgIds": [
              "JOB.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:6"
      },
      "items": [
        {
          "text": "ne banoga n'emizabbibu gy'aboonoonyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.6",
            "verseOrgIds": [
              "JOB.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'okubulwa engoye, basula bwereere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.7",
            "verseOrgIds": [
              "JOB.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:7"
      },
      "items": [
        {
          "text": "tebalina kye beebikka mu mpewo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.7",
            "verseOrgIds": [
              "JOB.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkuba y'oku nsozi ebatobya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:8"
      },
      "items": [
        {
          "text": "ne banywegera enjazi olw'okubulwa we beggama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana atalina kitaawe bamusika ku mabeere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.9",
            "verseOrgIds": [
              "JOB.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:9"
      },
      "items": [
        {
          "text": "omwana omuwere ow'omwavu bamuwamba olw'ebbanja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.9",
            "verseOrgIds": [
              "JOB.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'okubulwa engoye bayita bwereere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.10",
            "verseOrgIds": [
              "JOB.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:10"
      },
      "items": [
        {
          "text": "betikka ebinywa by'emmere naye basigala tebalidde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.10",
            "verseOrgIds": [
              "JOB.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basogolera emizabbibu ku mayinja,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.11",
            "verseOrgIds": [
              "JOB.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:11"
      },
      "items": [
        {
          "text": "ne basambira mu ssogolero, naye ne basigala nga balumwa ennyonta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.11",
            "verseOrgIds": [
              "JOB.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okusinda kw'abantu kuwulirwa mu kibuga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:12"
      },
      "items": [
        {
          "text": "n'emmeeme z'abafunye ebisago zikaabira obuyambi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:12"
      },
      "items": [
        {
          "text": "Naye Katonda talina gw'asinzisa musango.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waliwo abo abajeemera omusana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:13"
      },
      "items": [
        {
          "text": "abatamanyi makubo ge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:13"
      },
      "items": [
        {
          "text": "abatasigala mu kwaka kwagwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutemu agolokoka nga obudde buzibye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:14"
      },
      "items": [
        {
          "text": "n'atta omwavu n'ali mu kwetaaga;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:14"
      },
      "items": [
        {
          "text": "ekiro abbira ddala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriiso ly'omwenzi lirinda buzibe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:15"
      },
      "items": [
        {
          "text": "ng'agamba nti, 'Tewali liiso linandaba,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:15"
      },
      "items": [
        {
          "text": "n'abikka ne ku maaso ge.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kizikiza mwe basimira amayumba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:16"
      },
      "items": [
        {
          "text": "kyokka emisana baba beggalidde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:16"
      },
      "items": [
        {
          "text": "Tebaagala kitangaala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
