      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:32"
      },
      "items": [
        {
          "text": "Kadesi mu Ggaliraaya n'amalundiro gaakyo, ebibuga ebyokwekwekamu, ne Kammasudoli n'amalundiro gaakyo, ne Kalutani n'amalundiro gaakyo, bye bibuga bisatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.32",
            "verseOrgIds": [
              "JOS.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
