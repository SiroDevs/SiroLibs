      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:28"
      },
      "items": [
        {
          "text": "Kisioni n'amalundiro gaakyo, Daberasi n'amalundiro gaakyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
            "verseOrgIds": [
              "JOS.21.28"
            ]
          }
        },
