      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:30"
      },
      "items": [
        {
          "text": "Misali n'amalundiro gaakyo, Abudoni n'amalundiro gaakyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.30",
            "verseOrgIds": [
              "JOS.21.30"
            ]
          }
        },
