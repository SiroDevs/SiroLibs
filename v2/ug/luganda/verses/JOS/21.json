      "attrs": {
        "style": "li2",
        "vid": "JOS 21:38"
      },
      "items": [
        {
          "text": "Lamosi mu Gireyaali n'amalundiro gaakyo, ekibuga ekyokwekwekamu oyo asse, ne Makanayimu n'amalundiro gaakyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.38",
            "verseOrgIds": [
              "JOS.21.38"
            ]
          }
