          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaleevi abaali basigaddewo abaana ba Merali ne baweebwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 21:34"
      },
      "items": [
        {
          "text": "okuva mu kika kya Zebbulooni,",
