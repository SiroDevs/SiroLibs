          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.44",
                "verseOrgIds": [
                  "JOS.21.44"
                ]
              }
            }
          ]
        },
        {
          "text": "n'abawa emirembe ne bawummula ku buli luuyi nga bwe yalayirira bajjajjaabwe, tewali mulabe waabwe n'omu gwe bataawangula kubanga",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.44",
                "verseOrgIds": [
                  "JOS.21.44"
                ]
              }
            }
          ]
        },
        {
          "text": "yali agabudde abalabe baabwe mu mukono gwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kintu kyonna ekirungi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.45",
                "verseOrgIds": [
                  "JOS.21.45"
                ]
              }
            }
          ]
        },
        {
          "text": "kye yasuubiza ennyumba ya Isirayiri yakituukiriza. Byonna byatuukirira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
