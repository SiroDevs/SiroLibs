          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibuga byonna eby'Abagerusoni ng'ennyumba zaabwe bwe zaali, byali ebibuga kkumi na bisatu n'amalundiro gaabyo.",
          "type": "text"
        }
      ]
    },
