              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedemosi n'amalundiro gaakyo, ne Mefaasi n'amalundiro gaakyo bye bibuga bina.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
