          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mu kika kya Isakaali,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
            "verseOrgIds": [
              "JOS.21.28"
            ]
