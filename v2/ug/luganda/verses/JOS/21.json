      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:36"
      },
      "items": [
        {
          "text": "Bezeri n'amalundiro gaakyo, ne Yakazi n'amalundiro gaakyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
            "verseOrgIds": [
              "JOS.21.36"
            ]
