              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.43",
                "verseOrgIds": [
                  "JOS.21.43"
                ]
              }
            }
          ]
        },
        {
          "text": "n'awa Isirayiri ettaka lyonna nga bwe yalayirira bajjajjaabwe, era bwe baamala okulifuna ne babeera omwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
