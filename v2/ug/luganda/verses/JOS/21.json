          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerukasi n'amalundiro gaakyo, ne Lekobu n'amalundiro gaakyo, bye bibuga bina.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.31",
            "verseOrgIds": [
              "JOS.21.31"
            ]
          }
        }
      ]
    },
    {
