          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalamusi n'amalundiro gaakyo, ne Engannimu n'amalundiro gaakyo, bye bibuga bina,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.29",
            "verseOrgIds": [
              "JOS.21.29"
            ]
          }
        }
      ]
    },
    {
