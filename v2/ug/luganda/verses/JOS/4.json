  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JOS 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amayinja Ekkumi n'Abiri ag'Ekijjukizo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abayisirayiri bonna bwe baamala okusomoka omugga Yoludaani,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.1",
            "verseOrgIds": [
              "JOS.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.1",
                "verseOrgIds": [
                  "JOS.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Yoswa nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.1",
            "verseOrgIds": [
              "JOS.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yungula abasajja kkumi na babiri mu buli kika ng'olondamu omu omu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.2",
            "verseOrgIds": [
              "JOS.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obakuutire nti, \"Mulonde amayinja kkumi n'abiri nga mugaggya wakati mu mugga Yoludaani awo wennyini bakabona we balinnye ebigere byabwe, mugende nago okutuukira ddala we munaasula ekiro kino.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.3",
            "verseOrgIds": [
              "JOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa n'ayita abasajja kkumi na babiri be yalonda mu bika byonna ebya Isirayiri, n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.4",
            "verseOrgIds": [
              "JOS.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mukulembere mu maaso g'Essanduuko ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.5",
                "verseOrgIds": [
                  "JOS.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe era buli omu ku mmwe alonde ejjinja limu ng'aliggya mu mugga guno Yoludaani alyetikke ku kibegabega kye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano kalyoke kababeerere akabonero gye muli era mu mirembe ejijja, abaana bammwe bwe balibabuuza amayinja gano kye gategeeza,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.6",
            "verseOrgIds": [
              "JOS.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mulibagamba nti essanduuko y'Endagaano ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.7",
            "verseOrgIds": [
              "JOS.4.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.7",
                "verseOrgIds": [
                  "JOS.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yali ng'esomosebwa omugga Yoludaani, amazzi gaagwo ne geetuuma ng'ogusenge okutuusa Essanduuko bwe yamala okuyisibwawo. Kale amayinja gano, Abayisirayiri galibabeerera ekijjukizo emirembe gyonna.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.7",
            "verseOrgIds": [
              "JOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasajja Abayisirayiri ne bakola nga Yoswa bwe yabakuutira, ne balonda amayinja kkumi n'abiri nga bagaggya mu mugga Yoludaani ng'omuwendo gw'ebika by'Abayisirayiri bwe gwali. Ne bagasitula okugatuusiza ddala we baali bagenda okusula nga",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.8",
            "verseOrgIds": [
              "JOS.4.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.8",
                "verseOrgIds": [
                  "JOS.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yagamba Yoswa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.8",
            "verseOrgIds": [
              "JOS.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa n'asimba amayinja kkumi n'abiri mu kifo bakabona abaasitula Essanduuko ey'Endagaano we baalinnya era we gali ne kaakano.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.9",
            "verseOrgIds": [
              "JOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona abaasitula Essanduuko ne bayimirira wakati mu Yoludaani okutuusa nga Abayisirayiri bamaze okutuukiriza byonna",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.10",
                "verseOrgIds": [
                  "JOS.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bye yabalagira ng'ayita mu Musa ne Yoswa. Abantu bonna ne basomoka bunnambiro.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bonna nga bamaze okusomoka, bakabona ne basomosa Essanduuko ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
              "JOS.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.11",
                "verseOrgIds": [
                  "JOS.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "abantu bonna nga babayeegese amaaso.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
              "JOS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abasajja ab'ekika kya Lewubeeni, n'ekya Gaadi, n'ekitundu ky'ekika kya Manase ne basomoka ne bayita ku Bayisirayiri bonna nga babagalidde ebyokulwanyisa nga Musa bwe yabagamba,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.12",
            "verseOrgIds": [
              "JOS.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bonna abaali bambalidde ebyokulwanyisa baali emitwalo ng'ena mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.13",
                "verseOrgIds": [
                  "JOS.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, olwo ne boolekera eyali olutalo mu lusenyi lw'e Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.14",
                "verseOrgIds": [
                  "JOS.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agulumiza nnyo Yoswa mu maaso g'Abayisirayiri bonna, ne bamussaamu ekitiibwa ennaku zonna ez'obulamu bwe nga bwe baakolanga Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.15",
            "verseOrgIds": [
              "JOS.4.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.15",
                "verseOrgIds": [
                  "JOS.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Yoswa nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.15",
            "verseOrgIds": [
              "JOS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lagira bakabona abasitula Essanduuko ey'Obujulirwa baveeyo mu mugga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.16",
            "verseOrgIds": [
              "JOS.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo Yoswa n'alagira bakabona nti, \"Muveeyo mu mugga Yoludaani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.17",
            "verseOrgIds": [
              "JOS.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona abasitula Essanduuko ey'Endagaano ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.18",
                "verseOrgIds": [
                  "JOS.4.18"
                ]
              }
            }
          ]
        },
        {
          "text": "olwalinnya ebigere byabwe ku lukalu, amazzi gonna aga Yoludaani ne gakomawo mu kkubo lyago n'okwanjaala ne ganjaala nga bulijjo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe batyo Abayisirayiri ne basitula okuva ku Yoludaani ku lunaku olw'ekkumi mu mwezi ogw'olubereberye ne batuuka e Girugaali ne basiisira awo kumpi n'ensalo ey'ebuvanjuba eya Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.19",
            "verseOrgIds": [
              "JOS.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayinja ekkumi n'abiri agaggibwa mu Yoludaani, Yoswa n'agasimba mu Girugaali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.20",
            "verseOrgIds": [
              "JOS.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agamba Abayisirayiri nti, \"Abaana bammwe bwe balibabuuza amakulu g'amayinja gano,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.21",
            "verseOrgIds": [
              "JOS.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "mulibaddamu nti, 'Abayisirayiri bwe baali banaatera okusomoka omugga Yoludaani,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.22",
            "verseOrgIds": [
              "JOS.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
