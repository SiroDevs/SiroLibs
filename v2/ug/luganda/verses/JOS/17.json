  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JOS 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omugabo gwa Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabo ne guweebwa ekika kya Manase kubanga ye yali omubereberye owa Yusufu. Makiri omubereberye wa Manase era kitaawe wa Gireyaadi yaweebwa Gireyaadi ne Basani, era yali mulwanyi muzira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.1",
            "verseOrgIds": [
              "JOS.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era emigabo ne giweeba abaana ba Manase abalala nga bwe baali bazaalibwa mu buli maka. Omugabo gw'abaana ba Abiyezeeri, n'ogw'abaana ba Kereki n'abaana ba Asuliyeri n'ogw'abaana ba Sekemu, n'ogw'abaana ba Keferi, n'ogw'abaana ba Semida be baana bonna aboobulenzi aba Manase omwana wa Yusufu ng'amaka mwe baazaalibwa bwe gaali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.2",
            "verseOrgIds": [
              "JOS.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Zerofekadi mutabani wa Keferi mutabani wa Gireyaadi mutabani wa Manase teyazaala baana balenzi wabula bawala bokka era baali bayitibwa Maala ne Noowa, ne Kogula, ne Mirika ne Tiruza.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.3",
            "verseOrgIds": [
              "JOS.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano baagenda eri Eriyazaali kabona ne Yoswa omwana wa Nuuni n'abakulu ne babagamba nti, \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.17.4",
                "verseOrgIds": [
                  "JOS.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "yalagira Musa okutuwa omugabo nga baganda baffe.\" Yoswa kyeyava abawa ettaka nga",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.17.4",
                "verseOrgIds": [
                  "JOS.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yalagira. Yabawa omugabo mu baganda bakitaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo Manase n'afuna ebitundu kkumi ng'oggyeko ensi ya Gireyaadi ne Basani ebiri emitala wa Yoludaani,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.5",
            "verseOrgIds": [
              "JOS.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubanga abaana ba Manase abawala baafuna omugabo ng'abaana be abalenzi. Ensi ya Gireyaadi yaweebwa abaana ba Manase abaali basigaddewo ne bagitwala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ensalo ya Manase yava ku Aseri n'etuuka ku Mikumesasi ebuvanjuba bwa Sekemu, n'eyita ku bukiikaddyo n'ekka n'etwaliramu abantu abaali mu Entappua.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.7",
            "verseOrgIds": [
              "JOS.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi ya Tappua Manase n'agitwala wabula Tappua ekibuga ekyali ku nsalo ya Manase abaana ba Efulayimu be baakigabana.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.8",
            "verseOrgIds": [
              "JOS.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensalo n'ekka n'etuuka ku kagga Kana ku luuyi mu bukiikakkono obw'omugga. Bino bye bibuga bya Efulayimu ebiri mu bibuga bya Manase, naye ensalo ya Manase yali mu bukiikakkono obwa kagga n'ekoma ku nnyanja.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.9",
            "verseOrgIds": [
              "JOS.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efulayimu n'atwala oluuyi olw'omu bukiikaddyo ne Manase n'atwala oluuyi olw'omu bukiikakkono n'ensalo ye n'ekoma ku nnyanja mu bukiikakkono n'etuuka ku Aseri ate ebuvanjuba n'etuuka ku Isakaali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.10",
            "verseOrgIds": [
              "JOS.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nsi ya Isakaali n'eya Aseri, Manase n'atwala Besuseani n'ebibuga byakyo ne Ibuleamu n'ebibuga byakyo n'abaali mu Endoli n'ebibuga byakyo n'abaali mu Doli n'abaali mu Taanaki n'ebibuga byakyo, n'abaali mu Megiddo n'ebibuga byakyo z'ensozi essatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.11",
            "verseOrgIds": [
              "JOS.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abaana ba Manase tebasobola kugobamu Bakanani kubanga baali bamaliridde okusigala mu nsi eyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abaana ba Isirayiri bwe beeyongera amaanyi ne bafuula Abakanani abaddu baabwe ab'okubakozesanga emirimu, ne batabeegoberako ddala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwemulugunya kw'Abaana ba Yusufu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana ba Yusufu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        },
        {
          "text": "ne boogera ne Yoswa nti, \"Lwaki ffe otuwadde omugabo gumu n'ekitundu kimu ate nga tuli kika kinene?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.17.14",
                "verseOrgIds": [
                  "JOS.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "atuwadde nnyo omukisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa n'abagamba nti, \"Obanga muli kika kinene mugende mu nsi y'Abaperezi n'ey'Abalefa mwesaayire ekibira, ensi ey'ensozi eya Efulayimu nga bwe tebamala.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana ba Yusufu ne bagamba nti, \"Ensi ey'ensozi tetumala; ate nga Abakanani bonna abali mu nsi ey'ekiwonvu n'abali mu Besuseani n'ebibuga byakyo era n'abali mu kiwonvu eky'e Yezuleeri balina amagaali ag'ebyuma.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.16",
            "verseOrgIds": [
              "JOS.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa n'ayogera eri ennyumba ya Yusufu, n'eya Efulayimu n'eya Manase nti, \"Muli kika kinene era mulina amaanyi mangi temuliba na mugabo gumu gwokka,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.17",
            "verseOrgIds": [
              "JOS.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye ensi ey'ensozi eribeera yammwe, newaakubadde nga ya kibira mulikisaawa okutuuka gye kikoma, kubanga muligobamu Abakanani newaakubadde nga balina amagaali ag'ebyuma era nga baamaanyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.18",
            "verseOrgIds": [
              "JOS.17.18"
            ]
          }
        }
      ]
    }
  ],
