    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Zerubbaberi mutabani wa Seyalutyeri, ne Yoswa mutabani wa Yekozadaaki, ye yali kabona asinga obukulu, n'abantu bonna abaasigalawo ne bagondera eddoboozi lya",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.12",
                "verseOrgIds": [
                  "HAG.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waabwe, n'obubaka bwa nnabbi Kaggayi, kubanga",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.12",
                "verseOrgIds": [
                  "HAG.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waabwe ye yamutuma. Abantu ne batya",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.12",
                "verseOrgIds": [
                  "HAG.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        }
      ]
    },
    {
