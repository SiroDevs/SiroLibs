          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Kaggayi omubaka wa",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.13",
                "verseOrgIds": [
                  "HAG.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "n'ategeeza abantu obubaka obwava eri",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.13",
                "verseOrgIds": [
                  "HAG.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, \"Ndi wamu nammwe,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.13",
                "verseOrgIds": [
                  "HAG.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.14",
                "verseOrgIds": [
                  "HAG.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "n'akubiriza omutima gwa Zerubbaberi mutabani wa Seyalutyeri, ow'essaza lya Yuda, n'omutima gwa Yoswa mutabani wa Yekozadaaki, kabona asinga obukulu, n'emitima egy'abantu bonna abaasigalawo, ne bajja ne batandika omulimu ku nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.14",
                "verseOrgIds": [
                  "HAG.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, Katonda waabwe,",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku lunaku olw'amakumi abiri mu ennya mu mwezi ogw'omukaaga mu mwaka ogwokubiri ogw'okufuga kwa kabaka Daliyo.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.15",
            "verseOrgIds": [
              "HAG.1.15"
            ]
          }
        }
