          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.1",
            "verseOrgIds": [
              "ZEC.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.1",
                "verseOrgIds": [
                  "ZEC.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye ne kinzijira nate nti:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.1",
            "verseOrgIds": [
              "ZEC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
