            "number": "2",
            "style": "v",
            "sid": "ZEC 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.2",
            "verseOrgIds": [
              "ZEC.8.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.2",
                "verseOrgIds": [
                  "ZEC.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye nti, \"Nkwatirwa Sayuuni obuggya, obuggya obungi obw'ekitalo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.2",
            "verseOrgIds": [
              "ZEC.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.3",
            "verseOrgIds": [
              "ZEC.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.3",
                "verseOrgIds": [
                  "ZEC.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, \"Ndikomawo mu Sayuuni, ndibeera wakati mu Yerusaalemi era Yerusaalemi kiriyitibwa ekibuga ekyesigwa, olusozi olwa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.3",
            "verseOrgIds": [
              "ZEC.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.3",
                "verseOrgIds": [
                  "ZEC.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, Olusozi Olutukuvu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.3",
            "verseOrgIds": [
              "ZEC.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.4",
            "verseOrgIds": [
              "ZEC.8.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.4",
                "verseOrgIds": [
                  "ZEC.8.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye nti, \"Abakadde abasajja n'abakazi bajja kuddamu okutuula mu nguudo za Yerusaalemi, nga buli omu akutte omuggo, olw'obukadde.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.4",
            "verseOrgIds": [
              "ZEC.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'enguudo ez'ekibuga zirijjula abalenzi n'abawala nga bazannya.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.5",
            "verseOrgIds": [
              "ZEC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.6",
            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.6",
                "verseOrgIds": [
                  "ZEC.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye nti, \"Kirirabika ng'eky'ekitalo mu maaso g'abantu abo abaasigalawo mu nnaku ezo, naye nange gye ndi bwe kiriba?\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.6",
            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.6",
                "verseOrgIds": [
                  "ZEC.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.6",
            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.7",
            "verseOrgIds": [
              "ZEC.8.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.7",
                "verseOrgIds": [
                  "ZEC.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye nti, \"Laba ndirokola abantu bange abali mu nsi ey'Ebuvanjuba n'abali mu nsi ey'Ebugwanjuba:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.7",
            "verseOrgIds": [
              "ZEC.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibakomyawo, babeere mu Yerusaalemi, nange nnaabeeranga Katonda waabwe mu bwesigwa ne mu butuukirivu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.8",
            "verseOrgIds": [
              "ZEC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.9",
            "verseOrgIds": [
              "ZEC.8.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.9",
                "verseOrgIds": [
                  "ZEC.8.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye nti, \"Emikono gyammwe gibe n'amaanyi, mmwe, mu nnaku zino ababadde bawulira ebigambo bino ebiva mu kamwa ka bannabbi abaaliwo mu nnaku okuva omusingi gw'ennyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.9",
            "verseOrgIds": [
              "ZEC.8.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.9",
                "verseOrgIds": [
                  "ZEC.8.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye lwe gwasimbibwa, yeekaalu ye eryoke ezimbibwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.9",
            "verseOrgIds": [
              "ZEC.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiseera ekyo nga tekinnatuuka, tewaali asobola kutoola nsimbi okupangisa omuntu wadde okupangisa ensolo. Era tewaali muntu ayinza kukola mirimu gye mu mirembe olw'omulabe we, kubanga buli muntu nnali mufudde mulabe wa muliraanwa we.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.10",
            "verseOrgIds": [
              "ZEC.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kaakano abantu bano abaasigalawo sijja kubakola nga mu nnaku ezaayita,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.11",
            "verseOrgIds": [
              "ZEC.8.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.11",
                "verseOrgIds": [
                  "ZEC.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.11",
            "verseOrgIds": [
              "ZEC.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kubanga ensigo erikula bulungi, n'omuzabbibu gubale ekibala kyagwo, n'ettaka lireetenga ekimera kyalyo, n'eggulu lireetenga omusulo gwalyo. Nange abantu bange abaasigalawo ndibawa ebintu ebyo byonna nga gwe mugabo gwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.12",
            "verseOrgIds": [
              "ZEC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga bwe mwali ekikolimo mu baamawanga, ggwe ennyumba ya Yuda, naawe ennyumba ya Isirayiri, bwe ntyo bwe ndibalokola, era mulibeera omukisa eri abalala. Temutya, munywere emikono gyammwe gibe n'amaanyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.13",
            "verseOrgIds": [
              "ZEC.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.14",
            "verseOrgIds": [
              "ZEC.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.14",
                "verseOrgIds": [
                  "ZEC.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye nti, \"Nga bwe nasalawo okubabonereza, bajjajjammwe bwe bansunguwaza,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.14",
            "verseOrgIds": [
              "ZEC.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.14",
                "verseOrgIds": [
                  "ZEC.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, \"era ne sibasaasira,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.14",
            "verseOrgIds": [
              "ZEC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwe ntyo nate bwe nsazeewo kaakano mu nnaku zino okukola obulungi Yerusaalemi n'ennyumba ya Yuda. Temutya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.15",
            "verseOrgIds": [
              "ZEC.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bye bintu bye munaakolanga: buli muntu ayogerenga bya mazima ne muntu munne, musalenga emisango mu bwenkanya mu mpya zammwe;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.16",
            "verseOrgIds": [
              "ZEC.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "tosaliranga muliraanwa wo lukwe. So tolayiranga bya bulimba, kubanga ebyo byonna mbikyawa,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.17",
            "verseOrgIds": [
              "ZEC.8.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.17",
                "verseOrgIds": [
                  "ZEC.8.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.17",
            "verseOrgIds": [
              "ZEC.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
