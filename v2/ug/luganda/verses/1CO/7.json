  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1CO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obufumbo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano ku bintu bye mwampandiikira, kirungi omusajja obutakwatanga ku mukazi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.1",
            "verseOrgIds": [
              "1CO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye olw'ebikolwa eby'obwenzi, buli musajja abeerenga ne mukazi we; era na buli mukazi abeerenga ne bba.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.2",
            "verseOrgIds": [
              "1CO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusajja ateekwa okutuukirizanga eby'obufumbo byonna eri mukazi we era n'omukazi bw'atyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.3",
            "verseOrgIds": [
              "1CO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga omukazi bw'afumbirwa aba takyafuga mubiri gwe ye wabula bba, era n'omusajja bw'atyo aba takyafuga mubiri gwe ye wabula mukazi we y'aba agulinako obuyinza.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.4",
            "verseOrgIds": [
              "1CO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli omu alemenga okumma munne wabula nga mulagaanye ekiseera mulyoke mufune ebbanga ery'okusabiramu n'oluvannyuma muddiŋŋanenga, Setaani aleme okubasuula olw'obuteefuga bwammwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.5",
            "verseOrgIds": [
              "1CO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kino nkyogera mu ngeri ya kukkiriziganya so si mu ngeri ya kuwa kiragiro.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.6",
            "verseOrgIds": [
              "1CO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandyagadde buli omu abeere nga nze; naye buli muntu alina ekirabo ekikye ku bubwe ekiva eri Katonda, omu mu ngeri emu n'omulala mu ngeri endala.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.7",
            "verseOrgIds": [
              "1CO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye njogera eri abo abatannawasa ne bannamwandu; kirungi okusigala nga bwe bali, era nga nze bwe ndi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.8",
            "verseOrgIds": [
              "1CO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bwe baba tebasobola kwefuga bafumbirwe, oba bawase, kubanga okufumbiriganwa kisinga okwakiriranga okw'okwegomba.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.9",
            "verseOrgIds": [
              "1CO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abafumbo mbawa etteeka eriva eri Mukama waffe: omukazi tanobanga ku bba.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.10",
            "verseOrgIds": [
              "1CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Singa baawukana, omukazi ateekwa kubeerera awo, oba si ekyo addeyo ewa bba basonyiwagane; n'omusajja tagobanga mukazi we.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.11",
            "verseOrgIds": [
              "1CO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalala njogera gye bali kubanga si tteeka eriva eri Mukama waffe, naye mbagamba nti owooluganda bw'abeera n'omukazi atali mukkiriza ng'ayagala okubeera naye, tamugobanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.12",
            "verseOrgIds": [
              "1CO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era omukazi omukkiriza alina bba atali mukkiriza naye ng'amwagala, tamuvangako.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.13",
            "verseOrgIds": [
              "1CO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga omusajja atali mukkiriza ayinza okufuulibwa omukkiriza ng'ayambibwa mukyala we omukkiriza, oba omukyala atali mukkiriza ayinza okufuulibwa omukkiriza ng'ayambibwa bba omukkiriza. Kubanga bwe kitaba ekyo abaana bammwe banditwaliddwa ng'abatali balongoofu naye ku lw'ekyo abaana bammwe baba balongoofu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.14",
            "verseOrgIds": [
              "1CO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka oyo atali mukkiriza bw'ayagala okwawukana, baawukane; mu nsonga eyo omusajja omukkiriza oba omukyala taasibwenga mu ekyo, kubanga Katonda ayagala abaana be okubeera n'eddembe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.15",
            "verseOrgIds": [
              "1CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ggwe omukazi omukkiriza omanyi otya ng'olirokola balo? Oba ggwe omusajja omukkiriza omanyi otya ng'olirokola mukazi wo?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.16",
            "verseOrgIds": [
              "1CO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli omu abeere mu bulamu Mukama bwe yamuwa, era Katonda mwe yamuyitira mw'abatambuliranga. Ekyo ky'ekiragiro kye mpa ekkanisa zonna.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.17",
            "verseOrgIds": [
              "1CO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyayitibwa ng'amaze okukomolebwa aleme kugamba nti ssinga teyakomolebwa, n'oyo eyakkiriza nga si mukomole aleme kufaayo ku kukomolebwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.18",
            "verseOrgIds": [
              "1CO.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga okukomolebwa si kintu era obutakomolebwa si kintu, wabula ekikulu kwe kukwata amateeka ga Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.19",
            "verseOrgIds": [
              "1CO.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli omu abeerenga mu kuyitibwa Katonda kwe yamuyitiramu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.20",
            "verseOrgIds": [
              "1CO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oba nga wayitibwa ng'oli muddu ekyo kireme okuba ekikulu; naye bw'oba ng'ofunye omukisa okufuuka ow'eddembe, gukozese.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.21",
            "verseOrgIds": [
              "1CO.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga eyayitibwa Mukama nga muddu, Mukama yamufuula wa ddembe, n'oyo eyali ow'eddembe yafuuka muddu wa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.22",
            "verseOrgIds": [
              "1CO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwagulibwa na muwendo noolwekyo temufuukanga baddu ba bantu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.23",
            "verseOrgIds": [
              "1CO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale abooluganda, buli kifo kyonna omuntu yenna ky'alimu, mwe yayitirwa abeere mu ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.24",
            "verseOrgIds": [
              "1CO.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abatali Bafumbo ne Bannamwandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ku ky'abatafumbirwanga wadde okuwasa, sirina kiragiro kiva eri Mukama wabula Mukama mu kusaasira kwe yampa amagezi agayinza okwesigibwa kwe nnaasinziira okubawa ekirowoozo kyange.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.25",
            "verseOrgIds": [
              "1CO.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino nkirowooza nga kirungi, olw'embeera eya kaakano, nga kirungi omuntu okusigala nga bw'ali.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.26",
            "verseOrgIds": [
              "1CO.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obanga oli mufumbo tosaanye kwawukana na munno. Naye obanga wayawukana n'omukazi, tonoonya wa kuwasa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.27",
            "verseOrgIds": [
              "1CO.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka omusajja bw'awasa aba tayonoonye, era n'embeerera bw'afumbirwa naye aba tayonoonye. Wabula abafumbo, obufumbo bujja kubaleetera emitawaana gye nandiyagadde mwewale.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.28",
            "verseOrgIds": [
              "1CO.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kino kye mbategeeza abooluganda nti ekiseera kiyimpawadde. Noolwekyo abo abalina abakazi babe ng'abatabalina.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.29",
            "verseOrgIds": [
              "1CO.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abo abakaaba babe ng'abatakaaba, n'abo abasanyuka babe ng'abatasanyuka. N'abo abagula ebintu babe ng'abatalina kintu kye bayita kyabwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.30",
            "verseOrgIds": [
              "1CO.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'abo abakozesa eby'oku nsi kuno bireme okubamalamu ennyo, kubanga ensi eya kaakano eggwaawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.31",
            "verseOrgIds": [
              "1CO.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kye mbagaliza mmwe bwe buteraliikirira. Omusajja atali mufumbo yeemalira ku bya Mukama, engeri gy'asanyusa Mukama.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.32",
            "verseOrgIds": [
              "1CO.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omufumbo yeeraliikirira bya nsi, nga bw'anaasanyusa mukazi we;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.33",
            "verseOrgIds": [
              "1CO.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba yeesazeemu, ng'atta aga n'aga. N'omukazi atali mufumbo n'embeerera bafaayo ku bintu bya Mukama, babeerenga batukuvu mu mubiri ne mu mwoyo. Naye omukazi omufumbo yeeraliikirira bya mu nsi, engeri gy'anaasanyusaamu bba.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.34",
            "verseOrgIds": [
              "1CO.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino mbyogera olw'okubagasa, so si kubaziyiza kuwasa na kufumbirwa. Kubanga njagala musobole okuweereza Mukama nga tewali birala bibaziyiza okweweerayo ddala.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusajja bw'alowooza nti aba teyeeyisizza bulungi eri omuwala oyo gw'ayogereza bw'atamuwasa, bwe bafumbiriganwa, aba tayonoonye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.36",
            "verseOrgIds": [
              "1CO.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye oyo asobola okwefuga ng'alina omutima omunywevu, n'asalawo awatali kuwalirizibwa nti omuwala tajja kumuwasa, aba asazeewo bulungi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.37",
            "verseOrgIds": [
              "1CO.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale oyo awasa omuwala gw'ayogereza aba akoze bulungi, naye oyo atamuwasa y'aba asinze okukola obulungi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi omufumbo abeera kitundu kya bba, bba bw'aba akyali mulamu. Naye bba bw'afa olwo ayinza okufumbirwa omusajja omulala gw'ayagala, kyokka omusajja oyo ateekwa kuba mu Mukama waffe yekka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nze ndowooza nti alina omukisa oyo singa taddayo kufumbirwa. Era ndowooza nga nange nnina Omwoyo wa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
      ]
    }
  ],
