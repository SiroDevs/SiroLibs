  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "1CO 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuyamba Abantu ba Katonda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ebyo ebikwata ku kuyamba abantu ba Katonda, mmwe mukole nga bwe nagamba ab'Ekkanisa z'e Ggalatiya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.1",
            "verseOrgIds": [
              "1CO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli omu ku mmwe ng'asinziira ku kufuna kwe mu wiiki, abengako ky'atereka, ebintu bireme kukuŋŋaanyizibwa nga nzize.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.2",
            "verseOrgIds": [
              "1CO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale bwe ndituuka ne mutuma abo be munaasiima ne mbawa ebbaluwa ne batwala ebirabo byammwe e Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.3",
            "verseOrgIds": [
              "1CO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bwe kirirabika nga nange nsaanye ŋŋende, kale balimperekerako.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.4",
            "verseOrgIds": [
              "1CO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enteekateeka za Pawulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋŋenda kujja gye muli nga mpitira e Makedoniya, gye ndimala akabanga akatono.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osanga ewammwe gye ndimala ebbanga eriwera, oboolyawo ndiba nammwe mu biseera eby'obutiti byonna, mulyoke munnyambe buli gye nnaalaganga.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saagala kubalabako kaseera katono, nsuubira okumala nammwe ekiseera, Mukama waffe bw'alisiima.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka ŋŋenda kubeera mu Efeso okutuusa ku Pentekoote.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.8",
            "verseOrgIds": [
              "1CO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ddala oluggi lw'Enjiri lunziguliddwawo, newaakubadde ng'eriyo bangi abampakanya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
              "1CO.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoseewo bw'ajjanga, mumuyambe atereere bulungi mu mmwe, kubanga naye akola omulimu gwa Mukama waffe nga nze.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.10",
            "verseOrgIds": [
              "1CO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo waleme kubaawo amunyooma. Mumuyambe olugendo lwe lube lwa mirembe, ajje gye ndi. Kubanga nze n'abooluganda tumulindiridde.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.11",
            "verseOrgIds": [
              "1CO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ebyo ebikwata ku wooluganda Apolo, namwegayirira nnyo ajje gye muli, ng'ali n'abooluganda abalala, kyokka ye n'atayagala kujja kaakano, wabula alijja ng'afunye ebbanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.12",
            "verseOrgIds": [
              "1CO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebikomererayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutunulenga, munywerere mu kukkiriza, mubeere bazira era ab'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.13",
            "verseOrgIds": [
              "1CO.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kye mukola mukikolerenga mu kwagala.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.14",
            "verseOrgIds": [
              "1CO.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abooluganda, mumanyi nti mu Akaya ab'omu nnyumba ya Suteefana be baasooka okukkiriza Mukama waffe, era beewaayo okuyamba n'okuweereza abantu ba Katonda. Kale, abooluganda, mbasaba",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.15",
            "verseOrgIds": [
              "1CO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "muwulirenga abantu ng'abo, era na buli omu afube okukoleranga awamu nabo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suteefana ne Folutunaato ne Akayiko",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.17",
            "verseOrgIds": [
              "1CO.16.17"
            ]
          }
        },
        {
          "text": "bwe bajja gye ndi nasanyuka, kubanga baaliwo mu kifo kyammwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.17",
            "verseOrgIds": [
              "1CO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bansanyusa, era nga nammwe bwe baabasanyusa. Abantu ng'abo musaana mubalage nga bwe musiimye okuweereza kwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.18",
            "verseOrgIds": [
              "1CO.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekkanisa ey'omu Asiya ebalamusizza.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.19",
            "verseOrgIds": [
              "1CO.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CO 16:19"
      },
      "items": [
        {
          "text": "Akula ne Pulisikira awamu n'Ekkanisa ya Kristo eri mu maka gaabwe babalamusizza nnyo mu Mukama waffe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.19",
            "verseOrgIds": [
              "1CO.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era abooluganda bonna babalamusizza.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CO 16:20"
      },
      "items": [
        {
          "text": "Mulamusagane mu n'okunywegera okutukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nze, Pawulo, mbaweereza okulamusa kwange kuno, kwe mpandiika nze nzennyini n'omukono gwange.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.21",
            "verseOrgIds": [
              "1CO.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obanga waliwo atayagala Mukama, akolimirwe. Mukama waffe Yesu, jjangu!",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.22",
            "verseOrgIds": [
              "1CO.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekisa kya Mukama waffe Yesu Kristo kibeerenga nammwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.23",
            "verseOrgIds": [
              "1CO.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenna mbalamusizza n'okwagala mu Kristo Yesu. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.24",
            "verseOrgIds": [
              "1CO.16.24"
            ]
          }
        }
      ]
    }
  ],
