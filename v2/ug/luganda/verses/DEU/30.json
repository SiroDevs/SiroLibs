  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "DEU 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwesigwa bwa",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda Obutajjulukuka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emikisa n'ebikolimo ebyo byonna bye nkutegeezezza, bwe binaakutuukangako n'ojjukiranga ng'oli eyo mu nsi ezo zonna",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.1",
                "verseOrgIds": [
                  "DEU.30.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo gy'anaabanga akusaasaanyizza,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okyuka n'odda eri",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.2",
                "verseOrgIds": [
                  "DEU.30.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo, n'omugonderanga, n'abaana bo bonna, n'omutima gwo gwonna, n'emmeeme yo yonna, nga bwe nkulagira leero,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kale",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.3",
                "verseOrgIds": [
                  "DEU.30.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo anaakusaasiranga n'akuzza mu mbeera yo ennungi eneekweyagazanga, ng'akuwumbyewumbye okukuggya eyo gy'anaabanga akusaasaanyirizza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde onoobanga owaŋŋangusiriddwa mu nsi esinga okubeera ey'ewala ennyo wansi w'eggulu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.4",
                "verseOrgIds": [
                  "DEU.30.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo anaakukuŋŋaanyangayo, n'akuggyayo n'akukomyawo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.5",
                "verseOrgIds": [
                  "DEU.30.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo anaakukomyangawo mu nsi bajjajjaabo gye baafuna, naawe onoogifunanga. Alikugaggawaza era n'akwaza nnyo okukira bajjajjaabo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.5",
            "verseOrgIds": [
              "DEU.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.6",
                "verseOrgIds": [
                  "DEU.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo alikomola omutima gwo, n'omutima gwa bazzukulu bo, bw'otyo oyagalanga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.6",
                "verseOrgIds": [
                  "DEU.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo n'omutima gwo gwonna, n'emmeeme yo yonna, olyoke obeerenga omulamu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.7",
                "verseOrgIds": [
                  "DEU.30.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo aliteeka ebikolimo ebyo byonna ku balabe bo ne ku abo abanaakuyigganyanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'otyo n'oddamu okugonderanga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.8",
                "verseOrgIds": [
                  "DEU.30.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ng'okwata amateeka ge, ge nkulagira leero.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.9",
                "verseOrgIds": [
                  "DEU.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo alikugaggawaza mu buli kintu kyonna ky'onookolanga, mu bibala eby'omubiri gwo, ne mu bibala eby'ebisolo byo, ne mu bibala eby'ettaka lyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.9",
                "verseOrgIds": [
                  "DEU.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "alisanyuka nnyo okukugaggawazanga n'obeeranga bulungi, nga bwe kyamusanyusanga okugaggawazanga bajjajjaabo,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'ogondeddenga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.10",
                "verseOrgIds": [
                  "DEU.30.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo, n'okwatanga amateeka ge n'ebiragiro bye ebiwandiikiddwa mu Kitabo eky'Amateeka kino, n'odda eri",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.10",
                "verseOrgIds": [
                  "DEU.30.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo n'omukyukiranga n'omutima gwo gwonna, n'emmeeme yo yonna.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okweronderawo ku Bulamu n'Okufa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etteeka lye nkulagira leero terisaana kukukaluubirira, kubanga terikuli wala nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.11",
            "verseOrgIds": [
              "DEU.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teriri mu ggulu, n'okugamba ne kikugambisa nti, \"Ani anaatulinnyirayo mu ggulu n'atulireeterayo tulyoke tuliwulire tuligonderenga?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "So teriri mitala wa nnyanja, olyoke ogambe nti, \"Ani anaatusomokera ennyanja, alituleetere tuwulire bye ligamba, tuligondere?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.13",
            "verseOrgIds": [
              "DEU.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedda, ekigambo kiri kumpi ddala ne w'oli, kiri mu kamwa ko ne mu mutima gwo, olyoke okigondere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale laba, olwa leero ntadde mu maaso go obulamu n'okufa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga nkulagira leero okwagalanga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.16",
                "verseOrgIds": [
                  "DEU.30.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo, okutambuliranga mu makubo ge, awamu n'okukwatanga amateeka ge n'okugobereranga ebiragiro bye byonna. Bw'onookolanga bw'otyo ojjanga kuba mulamu era oyale, ne",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.16",
                "verseOrgIds": [
                  "DEU.30.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo anaakuwanga omukisa ng'oli mu nsi gy'oyingira okugifuna.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omutima gwo bwe gunaakyamanga n'otowulira, era bw'onoosendebwasendebwanga okusinzanga bakatonda abalala n'okubaweerezanga,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.17",
            "verseOrgIds": [
              "DEU.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbalangirira leero nti, Mugenda kuzikirizibwa; era temuliwangaala mu nsi gy'ogenda okusomokera omugga Yoludaani okugiyingira okugifuna.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.18",
            "verseOrgIds": [
              "DEU.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 30:19"
          },
