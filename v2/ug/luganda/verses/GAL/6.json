  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "GAL 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abooluganda omuntu bw'abanga alina ekibi ky'akoze, mmwe ab'omwoyo mumuluŋŋamyenga mu buwombeefu nga mwegendereza si kulwa nga nammwe mugwa mu kukemebwa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.1",
            "verseOrgIds": [
              "GAL.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyambaganenga, bwe mutyo bwe munaatuukirizanga etteeka lya Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.2",
            "verseOrgIds": [
              "GAL.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga omuntu yenna bwe yeerowooza okuba owa waggulu so nga si bw'ali, yeerimbarimba.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.3",
            "verseOrgIds": [
              "GAL.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye buli muntu yeekebere akakase omulimu ggwe, yenyumirize ye yekka so si mu muntu omulala.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.4",
            "verseOrgIds": [
              "GAL.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga buli muntu aneetikkanga obuvunaanyizibwa bwe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.5",
            "verseOrgIds": [
              "GAL.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo ayigirizibwa ekigambo kya Katonda, agabanirenga wamu n'amuyigiriza ku birungi byonna by'alina.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.6",
            "verseOrgIds": [
              "GAL.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temubuzibwabuzibwanga, Katonda tasekererwa, kubanga omuntu ky'asiga era ky'alikungula.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.7",
            "verseOrgIds": [
              "GAL.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga oyo asiga eri omubiri gwe, alikungula ebiggwaawo. Naye oyo asiga eri omwoyo, alikungula obulamu obutaggwaawo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.8",
            "verseOrgIds": [
              "GAL.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale tulemenga okuterebuka mu kukola obulungi, kubanga oluvannyuma tulikungula emikisa, bwe tutaggwaamu maanyi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.9",
            "verseOrgIds": [
              "GAL.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo, buli lwe kinaabanga kisobose tukolerenga abantu bonna ebirungi, na ddala ab'omu nnyumba ey'okukkiriza.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.10",
            "verseOrgIds": [
              "GAL.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Si Kukomola Wabula Abantu Abaggya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulabe, bwe nnabawandiikira n'omukono gwange mu nnukuta ennene!",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.11",
            "verseOrgIds": [
              "GAL.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abanoonya okweraga mu mubiri be babawaliriza okukomolebwa mu mubiri, balemenga okuyigganyizibwanga olw'omusaalaba gwa Kristo, balyoke beenyumirize olw'omubiri gwammwe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.12",
            "verseOrgIds": [
              "GAL.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga n'abo bennyini abakomolebwa tebakwata mateeka, naye baagala mukomolebwe balyoke beenyumirize olw'omubiri gwammwe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.13",
            "verseOrgIds": [
              "GAL.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nze sigenda kwenyumiririza mu kintu kyonna okuggyako omusaalaba gwa Mukama waffe Yesu Kristo, kubanga olw'omusaalaba ogwo, nkomereddwa eri ensi, n'ensi ekomereddwa eri nze.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.14",
            "verseOrgIds": [
              "GAL.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga okukomolebwa oba obutakomolebwa si kintu, wabula ekikulu kye kitonde ekiggya.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.15",
            "verseOrgIds": [
              "GAL.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abo bonna abanaatambuliranga mu tteeka eryo, emirembe gibeerenga ku bo, n'okusaasirwa, ne ku Isirayiri ya Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.16",
            "verseOrgIds": [
              "GAL.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva kaakano tewabanga muntu n'omu anteganya, kubanga nnina enkovu za Yesu ku mubiri gwange.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abooluganda, ekisa kya Mukama waffe Yesu Kristo kibeerenga nammwe n'omwoyo gwammwe. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.18",
            "verseOrgIds": [
              "GAL.6.18"
            ]
          }
        }
      ]
    }
  ],
