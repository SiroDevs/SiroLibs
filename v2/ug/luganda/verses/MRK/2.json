          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "bwe yayingira mu nnyumba ya Katonda mu biro bya Abiyasaali kabona omukulu, n'alya emigaati egy'okulaga n'awaako n'abo be yali nabo, egitakkirizibwa kuliibwako bantu balala okuggyako bakabona.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.26",
                "verseOrgIds": [
                  "MRK.2.26"
                ]
              }
            }
