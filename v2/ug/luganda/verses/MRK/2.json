              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ssabbiiti yateekebwawo lwa muntu, so si omuntu ku lwa Ssabbiiti.",
