  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "GEN 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Endagaano ya",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Ibulaamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo nga biwedde, ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.1",
                "verseOrgIds": [
                  "GEN.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Ibulaamu mu kwolesebwa nti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 15:1"
      },
      "items": [
        {
          "text": "\"Totya Ibulaamu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 15:1"
      },
      "items": [
        {
          "text": "Nze ngabo yo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 15:1"
      },
      "items": [
        {
          "text": "era empeera yo ennene ennyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Ibulaamu n'addamu nti, \"Kiki ky'olimpa Ayi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.2",
            "verseOrgIds": [
              "GEN.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.2",
                "verseOrgIds": [
                  "GEN.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, kubanga sirina mwana, n'omusika w'ennyumba yange ye Eryeza ow'omu Ddamasiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.2",
            "verseOrgIds": [
              "GEN.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulaamu ne yeeyongera n'agamba nti, \"Laba tompadde mwana; omuddu eyazaalibwa mu nnyumba yange ye musika wange.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.3",
            "verseOrgIds": [
              "GEN.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.4",
            "verseOrgIds": [
              "GEN.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.4",
                "verseOrgIds": [
                  "GEN.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kimujjira nti, \"Omusajja oyo tagenda kuba musika wo; mutabani wo, y'aliba omusika wo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.4",
            "verseOrgIds": [
              "GEN.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amufulumya ebweru n'amugamba nti, \"Tunuulira eggulu, obale emunyeenye, obanga osobola okuzibala.\" Awo n'amugamba nti, \"N'ezzadde lyo bwe liriba bwe lityo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.5",
            "verseOrgIds": [
              "GEN.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulaamu n'akkiriza",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.6",
                "verseOrgIds": [
                  "GEN.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'akimubalira okuba obutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amugamba nti, \"Nze",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.7",
            "verseOrgIds": [
              "GEN.15.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.7",
                "verseOrgIds": [
                  "GEN.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": "eyakuggya mu Uli ensi ey'Abakaludaaya, nkuwe ensi eno ebeere yiyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.7",
            "verseOrgIds": [
              "GEN.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulaamu n'addamu nti, \"Ayi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.8",
                "verseOrgIds": [
                  "GEN.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nnaamanya ntya nti eriba yange?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.9",
                "verseOrgIds": [
                  "GEN.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amuddamu nti, \"Ndeetera ennyana eyaakamala emyaka esatu, embuzi ey'emyaka esatu, endiga ensajja ey'emyaka esatu, kaamukuukulu n'ejjiba.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.9",
            "verseOrgIds": [
              "GEN.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulaamu n'abireeta byonna n'abisalamu wakati n'ateeka buli kitundu kungulu ku kinnaakyo, naye ebinyonyi byo teyabisalamu bitundu nga biri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.10",
            "verseOrgIds": [
              "GEN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensega bwe zajja okubirya, Ibulaamu n'azigoba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.11",
            "verseOrgIds": [
              "GEN.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enjuba yali egwa, Ibulaamu ne yeebaka otulo tungi; era laba, ekizikiza ekingi eky'amaanyi ne kimubuutikira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.12",
            "verseOrgIds": [
              "GEN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.13",
            "verseOrgIds": [
              "GEN.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.13",
                "verseOrgIds": [
                  "GEN.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Ibulaamu nti, \"Manyira ddala nti ezzadde lyo baliba batambuze mu nsi eteri yaabwe, era baliba baddu eyo, balibonyaabonyezebwa eyo okumala emyaka ebikumi bina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.13",
            "verseOrgIds": [
              "GEN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ndibonereza eggwanga lye balikolera n'oluvannyuma balivaayo n'obugagga bungi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.14",
            "verseOrgIds": [
              "GEN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ggwe oligenda mirembe eri bajjajjaabo; oliziikibwa ng'owangaalidde ddala nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.15",
            "verseOrgIds": [
              "GEN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era balikomawo wano mu mulembe ogwokuna; kubanga obutali butuukirivu bw'Omwamoli tebunnayitirira.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enjuba bwe yagwa ng'ekizikiza kikutte, laba, ensuwa eyaka omuliro era enyooka omukka n'ekimulisa ne biyita wakati w'ebitundu bino.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.17",
            "verseOrgIds": [
              "GEN.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.18",
            "verseOrgIds": [
              "GEN.15.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.18",
                "verseOrgIds": [
                  "GEN.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "n'akola endagaano ne Ibulaamu ng'agamba nti, \"Ezadde lyo ndiwa ensi eno, okuva ku mugga ogw'e Misiri okutuuka ku mugga omunene, omugga Fulaati:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.18",
            "verseOrgIds": [
              "GEN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukeeni, n'Omukenizi, n'Omukadumoni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.19",
            "verseOrgIds": [
              "GEN.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'Omukiiti, n'Omuperizi, n'Abaleefa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.20",
            "verseOrgIds": [
              "GEN.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'Omwamoli, n'Omukanani, n'Omugirugaasi n'Omuyebusi, mbagabula mu mukono gwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.21",
            "verseOrgIds": [
              "GEN.15.21"
            ]
          }
        }
      ]
    }
  ],
