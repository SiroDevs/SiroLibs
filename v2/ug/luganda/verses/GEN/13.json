  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "GEN 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo Ibulaamu n'ayambuka okuva mu Misiri ye ne mukazi we, ne byonna bye yalina, ne Lutti ne bayingira mu Negevu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibulaamu ne Lutti Baawukana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo Ibulaamu yalina ente nnyingi, ne ffeeza ne zaabu nnyingi nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.2",
            "verseOrgIds": [
              "GEN.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'atambula okuva e Negevu n'atuuka e Beseri, mu kifo eweema ye we yali olubereberye, wakati wa Beseri ne Ayi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.3",
            "verseOrgIds": [
              "GEN.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu kifo we yasooka okuzimbira",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.4",
            "verseOrgIds": [
              "GEN.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.13.4",
                "verseOrgIds": [
                  "GEN.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyoto, Ibulaamu n'akoowoolera eyo erinnya lya",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.4",
            "verseOrgIds": [
              "GEN.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.13.4",
                "verseOrgIds": [
                  "GEN.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.4",
            "verseOrgIds": [
              "GEN.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Lutti eyagenda ne Ibulaamu naye yalina ebisibo by'endiga n'amagana g'ente n'ab'enju ye nga bangi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.5",
            "verseOrgIds": [
              "GEN.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekitundu mwe baali nga tekibamala bombi. Obugagga bwabwe bwali bungi nnyo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.6",
            "verseOrgIds": [
              "GEN.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ate nga n'abasumba baabwe bayombagana. Mu kiseera ekyo Abakanani n'Abaperezi nabo baabanga mu nsi omwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.7",
            "verseOrgIds": [
              "GEN.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Ibulaamu n'agamba Lutti nti, \"Tewasaana kubaawo kuyombagana wakati wange naawe, wadde wakati w'abalunzi bo n'abange, kubanga tuli baaluganda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.8",
            "verseOrgIds": [
              "GEN.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi yonna teri mu maaso go? Leka twawukane. Bwonoolonda oluuyi olwa kkono, nze n'alaga ku luuyi olwa ddyo, bw'onoolaga ku luuyi olwa ddyo nze n'alaga ku luuyi olwa kkono.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.9",
            "verseOrgIds": [
              "GEN.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lutti n'ayimusa amaaso ge, n'alaba ekiwonvu kya Yoludaani nga kirungi, nga kirimu amazzi buli wantu nga kifaanana ng'ennimiro ya",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.13.10",
                "verseOrgIds": [
                  "GEN.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "; nga kiri ng'ensi ya Misiri ku luuyi olwa Zowaali. Kino kyaliwo nga",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.13.10",
                "verseOrgIds": [
                  "GEN.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "tannazikkiriza Sodomu ne Ggomola.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo Lutti ne yeeronderawo olusenyi lwa Yoludaani n'agenda ku luuyi olw'ebuvanjuba; bwe batyo ne baawukana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.11",
            "verseOrgIds": [
              "GEN.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulaamu n'abeera mu nsi ya Kanani, ye Lutti n'abeera mu bibuga eby'omu lusenyi n'atwala eweema ye n'agisimba okumpi ne Sodomu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.12",
            "verseOrgIds": [
              "GEN.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasajja aba Sodomu baali babi era nga boonoonyi nnyo eri",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
              "GEN.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.13.13",
                "verseOrgIds": [
                  "GEN.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
              "GEN.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.13.14",
                "verseOrgIds": [
                  "GEN.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Ibulaamu ng'amaze okwawukana ne Lutti nti, \"Yimusa amaaso go ng'osinziira mu kifo mw'oli, otunule ku bukiikakkono, ne ku bukiikaddyo, n'ebuvanjuba n'ebugwanjuba;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.14",
            "verseOrgIds": [
              "GEN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubanga ensi gy'olaba ndigikuwa ggwe n'ezzadde lyo emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.15",
            "verseOrgIds": [
              "GEN.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndyaza ezzadde lyo ng'enfuufu ey'oku nsi; omuntu bw'alisobola okubala enfuufu ey'oku nsi, n'ezzadde lyo aliribala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.16",
            "verseOrgIds": [
              "GEN.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Situka, tambula obuwanvu n'obukiika obw'ensi kubanga ngikuwadde.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.17",
            "verseOrgIds": [
              "GEN.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Ibulaamu n'asimbula eweema ye n'agenda n'abeera okumpi n'emivule gya Mamule, ekiri e Kebbulooni, n'azimbira eyo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.18",
            "verseOrgIds": [
              "GEN.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.13.18",
                "verseOrgIds": [
                  "GEN.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyoto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.18",
            "verseOrgIds": [
              "GEN.13.18"
            ]
          }
        }
      ]
    }
  ],
