              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.22",
                "verseOrgIds": [
                  "GEN.3.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'agamba nti, \"Laba omuntu afuuse ng'omu ku ffe okumanyanga ekirungi n'ekibi; kale kaakano talwa kugolola mukono gwe n'anoga ku muti ogw'obulamu n'alya, n'awangaala emirembe gyonna.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
