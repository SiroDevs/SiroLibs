                "verseOrgIds": [
                  "GEN.3.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'agoba omuntu mu nnimiro Adeni agende alimenga ettaka mwe yaggyibwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
