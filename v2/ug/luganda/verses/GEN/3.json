{
  "id": "GEN.3",
  "number": "3",
  "bookId": "GEN",
  "reference": "Olubereberye 3",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "GEN 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okujeema kw'Omuntu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nno omusota gwali mukalabakalaba okukira ensolo zonna ez'omu nsiko,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.1",
                "verseOrgIds": [
                  "GEN.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ze yatonda. Ne gugamba omukazi nti, \"Kazzi Katonda yagamba nti, 'Temulyanga ku muti gwonna ogw'omu nnimiro!' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi n'addamu omusota nti, \"Tulya ku buli muti ogw'omu nnimiro,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.2",
            "verseOrgIds": [
              "GEN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyokka Katonda yatulagira nti, 'Temulyanga ku kibala ky'omuti oguli wakati mu nnimiro, wadde okugukwatako, muleme okufa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.3",
            "verseOrgIds": [
              "GEN.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omusota ne gugamba omukazi nti, \"Temugenda kufa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.4",
            "verseOrgIds": [
              "GEN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Katonda amanyi nga lwe muligulyako amaaso gammwe lwe galizibuka, era mulifaanana nga ye, okumanyanga ekirungi n'ekibi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.5",
            "verseOrgIds": [
              "GEN.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omukazi bwe yalaba ng'omuti mulungi nga gusanyusa okutunulako era gwegombebwa okuleeta amagezi, n'anoga ekibala kyagwo n'alya; n'awaako ne bba naye n'alya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.6",
            "verseOrgIds": [
              "GEN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo amaaso gaabwe bombi ne gazibuka, ne bategeera nga baali bwereere; ne baluka amalagala g'emiti ne beekolera ebyokwambala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.7",
            "verseOrgIds": [
              "GEN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne bawulira eddoboozi lya",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.8",
                "verseOrgIds": [
                  "GEN.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ng'atambula mu nnimiro, mu budde obuweeweevu. Omusajja n'omukazi ne beekweka mu miti",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.8",
                "verseOrgIds": [
                  "GEN.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda aleme okubalaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.9",
            "verseOrgIds": [
              "GEN.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.9",
                "verseOrgIds": [
                  "GEN.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'ayita omusajja nti, \"Oli ludda wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.9",
            "verseOrgIds": [
              "GEN.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'addamu nti, \"Mpulidde eddoboozi lyo mu nnimiro, ne ntya, kubanga mbadde bwereere; ne nneekweka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.10",
            "verseOrgIds": [
              "GEN.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amubuuza nti, \"Ani akubuulidde nti oli bwereere? Olidde ku muti gwe nakulagira obutagulyangako?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.11",
            "verseOrgIds": [
              "GEN.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusajja n'addamu nti, \"Omukazi gwe wampa okubeeranga nange y'ampadde ekibala ne ndya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.12",
            "verseOrgIds": [
              "GEN.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.13",
                "verseOrgIds": [
                  "GEN.3.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda kwe kubuuza omukazi nti, \"Kiki kino ky'okoze?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 3:13"
      },
      "items": [
        {
          "text": "Omukazi n'addamu nti, \"Omusota gwe gunsenzesenze ne ndya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.14",
                "verseOrgIds": [
                  "GEN.3.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'agamba omusota nti, Kubanga okoze kino",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "okolimiddwa okukira ensolo zonna ez'awaka",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "n'ez'omu nsiko,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "oneekululiranga ku lubuto lwo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "era onoolyanga nfuufu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "ennaku zonna ez'obulamu bwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nteeka obulabe",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "wakati wo n'omukazi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "ne wakati w'ezzadde lyo n'ezzadde ly'omukazi;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "ezzadde lye linaakubetentanga omutwe,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "naawe onoolibojjanga ekisinziiro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agamba omukazi nti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "\"Nnaayongeranga nnyo ku bulumi bwo ng'oli lubuto,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "onoozaaliranga mu bulumi;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "musajja wo anaakukoleranga bye weetaaga",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "kyokka anaakufuganga.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agamba Adamu nti, \"Kubanga owulidde eddoboozi lya mukazi wo, n'olya ku muti gwe nakulagira obutagulyangako,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.17",
            "verseOrgIds": [
              "GEN.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
