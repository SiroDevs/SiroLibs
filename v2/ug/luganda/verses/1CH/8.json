          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Ulamu baali basajja bazira era nga b'amaanyi, nga balasi ba busaale, nga n'abaana n'abazzukulu bangi ddala.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
      ]
