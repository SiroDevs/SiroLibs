          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neeri n'azaala Kiisi, ne Kiisi n'azaala Sawulo, ne Sawulo n'azaala Yonasaani, ne Malukisuwa, ne Abinadaabu ne Esubaali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
