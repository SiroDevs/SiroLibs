          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazi n'azaala Yekoyaada, Yekoyaada n'azaala Alemesi, ne Azumavesi, ne Zimuli, ne Zimuli n'azaala Moza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
            "verseOrgIds": [
              "1CH.8.36"
            ]
          }
