          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azeri yazaala abaana aboobulenzi mukaaga, nga be ba",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        }
      ]
    },
