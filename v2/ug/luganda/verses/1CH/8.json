      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:34"
      },
      "items": [
        {
          "text": "Meribubaali, ye Mefibosesi, eyazaala Mikka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
