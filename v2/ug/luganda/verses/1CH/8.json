          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moza n'azaala Bineya, Bineya n'azaala Lafa, ne Ereyaasa ne Azeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
              "1CH.8.37"
            ]
