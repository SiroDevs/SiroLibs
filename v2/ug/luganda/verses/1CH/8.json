          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Mikuloosi n'azaala Simeeyi. Nabo baabeeranga kumpi ne baganda baabwe mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
