      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:39"
      },
      "items": [
        {
          "text": "Ulamu omubereberye, ne Yewusi nga ye owookubiri ne Erifereti nga ye wookusatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        },
