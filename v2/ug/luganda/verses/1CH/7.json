      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:30"
      },
      "items": [
        {
          "text": "Imuna, ne Isuva, ne Isuvi, ne Beriya, ne Seera mwannyinaabwe.",
