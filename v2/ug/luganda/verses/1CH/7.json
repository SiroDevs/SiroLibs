      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:36"
      },
      "items": [
        {
          "text": "Suwa, ne Kaluneferi, ne Suwali, ne Beri, ne Imula,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
              "1CH.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Bezeri, ne Kodi, ne Samma, ne Sirusa, ne Isulani ne Beera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.37",
            "verseOrgIds": [
              "1CH.7.37"
            ]
          }
        }
      ]
    },
