  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1CH 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekika kya Isakaali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana ba Isakaali baali bana:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:1"
      },
      "items": [
        {
          "text": "Tola, ne Puwa, ne Yasubu, ne Simuloni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Tola baali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:2"
      },
      "items": [
        {
          "text": "Uzzi, Lefaya, Yeryeri, Yamayi, Ibusamu ne Semweri, era be baali abakulu b'enda zaabwe. Ku mulembe gwa Dawudi, bazzukulu ba Tola baali abasajja abalwanyi nga bawera emitwalo ebiri mu enkumi bbiri mu lukaaga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzzi n'azaala",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Izulakiya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Izulakiya n'azaala",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Mikayiri, ne Obadiya, ne Yoweeri ne Issiya, era bonna baali bakulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okusinziira ku nda yaabwe, baali basajja b'amaanyi era nga balwanyi ba ntalo, nga balina abakyala n'abaana bangi, nga bawera abasajja emitwalo esatu mu kakaaga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.4",
            "verseOrgIds": [
              "1CH.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baganda baabwe bonna awamu abaali ab'ekika kya Isakaali baali abasajja abalwanyi emitwalo munaana mu kasanvu bonna awamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekika kya Benyamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benyamini yalina abatabani basatu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:6"
      },
      "items": [
        {
          "text": "Bera, ne Bekeri ne Yediyayeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Bera baali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:7"
      },
      "items": [
        {
          "text": "Ezuboni, ne Uzzi, ne Wuziyeeri, ne Yerimosi ne Iri, be baana bataano, ate nga bonna bakulu b'enda zaabwe. Mu kubalibwa baali abasajja abalwanyi emitwalo ebiri mu enkumi bbiri mu amakumi asatu mu bana.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Bekeri baali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:8"
      },
      "items": [
        {
          "text": "Zemira, ne Yowaasi, ne Eryeza, ne Eriwenayi, ne Omuli, ne Yeremosi, ne Abiya, ne Anasosi ne Alemesi. Bano be baali abaana ba Bekeri ate nga bonna bakulu b'enda zaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kubalibwa baali abasajja abalwanyi emitwalo ebiri mu ebikumi bibiri mu bibiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.9",
            "verseOrgIds": [
              "1CH.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Yediyayeri,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "yali Birukani,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "ate batabani ba Birukani nga be ba",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "Yewusi, ne Benyamini, ne Ekudi, ne Kenaana, ne Zesani, ne Talusiisi ne Akisakali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano bonna baali bazzukulu ba Yediyayeri ate nga be bakulu b'enda zaabwe. Era baali abasajja abalwanyi omutwalo gumu mu kasanvu mu ebikumi bibiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.11",
            "verseOrgIds": [
              "1CH.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasuppimu n'Abakupimu baali bazzukulu ba Iri, ate ng'Abakusimu bazzukulu ba Akeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekika kya Nafutaali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Nafutaali baali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:13"
      },
      "items": [
        {
          "text": "Yaziyeri, ne Guni, ne Yezeri ne Sallumu, era bano be bazzukulu ba Biruka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekika kya Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano be baali bazzukulu ba Manase:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:14"
      },
      "items": [
        {
          "text": "Asuliyeri ne Makiri mukyala we Omwalamu. Be yamuzaalira. Makiri n'azaala Gireyaadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makiri n'awasa okuva mu Bakupimu n'Abasuppimu, n'erinnya lya mwannyina nga ye Maaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.15",
            "verseOrgIds": [
              "1CH.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:15"
      },
      "items": [
        {
          "text": "Omuzzukulu omulala yali Zerofekadi, era ng'alina baana ba buwala bokka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.15",
            "verseOrgIds": [
              "1CH.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaka mukyala wa Makiri n'azaala omwana wabulenzi n'amutuuma Peresi. Muganda we ye yali Seresi, nga ne batabani ba Seresi be ba Ulamu ne Lekemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.16",
            "verseOrgIds": [
              "1CH.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Ulamu yali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:17"
      },
      "items": [
        {
          "text": "Bedani,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:17"
      },
      "items": [
        {
          "text": "era bano nga be batabani ba Gireyaadi, mutabani wa Makiri, mutabani wa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwannyina Kammolekisi n'azaala Isukondi, ne Abiyezeeri ne Makula.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.18",
            "verseOrgIds": [
              "1CH.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Semida baali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:19"
      },
      "items": [
        {
          "text": "Akyani, ne Sekemu, ne Liki ne Aniyamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekika kya Efulayimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Efulayimu yali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:20"
      },
      "items": [
        {
          "text": "Susera, mutabani wa Susera nga ye Beredi, mutabani wa Beredi nga ye Takasi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:20"
      },
      "items": [
        {
          "text": "mutabani wa Takasi nga ye Ereyadda,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:20"
      },
      "items": [
        {
          "text": "mutabani wa Ereyadda nga ye Takasi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutabani wa Takasi nga ye Zabadi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:21"
      },
      "items": [
        {
          "text": "ate mutabani wa Zabadi nga ye Susera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:21"
      },
      "items": [
        {
          "text": "Efulayimu yalina batabani be abalala babiri, nga be ba Ezeri ne Ereyaddi abattibwa mu nsi ya Gusi nga bagenze okubba (okunyaga) ente.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efulayimu n'abakungubagira okumala ennaku nnyingi, era baganda be ne bajja okumukungubagirako.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.22",
            "verseOrgIds": [
              "1CH.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Efulayimu n'amanya mukyala we, mukyala we n'azaala omwana owoobulenzi omulala, n'amutuuma Beriya kubanga ennyumba ye yatuukibwako emitawaana.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne muwala we yali Sera, era oyo yazimba Besukoloni ekya eky'emmanga n'eky'engulu, ne Uzzemmuseera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
            "verseOrgIds": [
              "1CH.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efulayimu yalinayo n'omutabani omulala erinnya lye Leefa, nga ye kitaawe wa Lesefu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:25"
      },
      "items": [
        {
          "text": "Lesefu n'azaala Teera, Teera n'azaala Takani,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takani n'azaala Ladani, Ladani n'azaala Ammikudi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.26",
            "verseOrgIds": [
              "1CH.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:26"
      },
      "items": [
        {
          "text": "Ladani n'azaala Erisaama,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.26",
            "verseOrgIds": [
              "1CH.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisaama n'azaala Nuuni,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.27",
            "verseOrgIds": [
              "1CH.7.27"
            ]
          }
        }
      ]
    },
    {
