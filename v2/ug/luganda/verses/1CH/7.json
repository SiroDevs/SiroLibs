          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keberi n'azaala Yafuleti, ne Somera, ne Kosamu ne mwannyinaabwe Suwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
            "verseOrgIds": [
