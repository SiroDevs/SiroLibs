      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:31"
      },
      "items": [
        {
          "text": "Keberi ne Malukiyeeri, ne Malukiyeeri nga ye kitaawe wa Biruzayisi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
            "verseOrgIds": [
              "1CH.7.31"
            ]
          }
        }
      ]
    },
    {
