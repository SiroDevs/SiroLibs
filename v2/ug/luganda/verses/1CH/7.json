      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:27"
      },
      "items": [
        {
          "text": "Nuuni n'azaala Yoswa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.27",
            "verseOrgIds": [
              "1CH.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ettaka lyabwe n'ebifo we baasenga byali Beseri n'obubuga obutono obukyetoolodde, ebuvanjuba w'e Naalani, ebugwanjuba w'e Gezeri, n'obubuga bwakyo, n'e Sekemu n'obubuga bwakyo, okutuukira ddala ku Azza n'obubuga obukyetoolodde.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazzukulu ba Yusufu, Abamanase, mutabani wa Isirayiri babeeranga Besuseyani, n'e Taanaki, n'e Megiddo, n'e Doli n'obubuga obwali bubiriranye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekika kya Aseri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
