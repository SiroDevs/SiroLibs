          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano bonna baali bazzukulu ba Aseri, abamu nga bakulu ba nda zaabwe abalala nga basajja baakitiibwa, n'abalala nga balwanyi abazira, n'abalala nga baami bakulu ddala mu bitiibwa byabwe. Abasajja abalwanyi bonna awamu bawera emitwalo ebiri mu kakaaga.",
          "type": "text"
        }
      ]
    }
