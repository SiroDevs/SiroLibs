          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.27",
                "verseOrgIds": [
                  "1CH.21.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'alagira malayika okuzaayo ekitala kye mu kiraato kyakyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva mu kiseera ekyo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.28",
                "verseOrgIds": [
                  "1CH.21.28"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yaddamu Dawudi ku gguuliro lya Olunaani Omuyebusi, Dawudi n'aweerangayo ssaddaaka eyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biro ebyo Eweema ya",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.29",
                "verseOrgIds": [
                  "1CH.21.29"
                ]
              }
            }
          ]
        },
        {
          "text": ", Musa gye yali azimbidde mu ddungu, n'ekyoto eky'ebiweebwayo ebyokebwa byali mu kifo ekigulumivu e Gibyoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Dawudi yali tasobola kugendayo kwebuuza ku Katonda, kubanga yali atya ekitala kya malayika wa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
            "verseOrgIds": [
              "1CH.21.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.30",
                "verseOrgIds": [
                  "1CH.21.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
            "verseOrgIds": [
              "1CH.21.30"
            ]
          }
        }
