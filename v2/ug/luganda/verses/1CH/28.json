                "verseOrgIds": [
                  "1CH.28.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, Katonda wange ali wamu naawe. Taakwabulirenga so taakulekenga okutuusa omulimu gwonna ogw'okuweereza ogwa yeekaalu ye",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.20",
