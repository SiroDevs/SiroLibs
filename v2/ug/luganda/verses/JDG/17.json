  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JDG 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mikka n'Ebifaananyi bye Ebyole",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaliwo omusajja eyabeeranga mu nsi ey'ensozi Efulayimu, erinnya lye Mikka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.1",
            "verseOrgIds": [
              "JDG.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agamba nnyina nti, \"Ebitundu bya ffeeza olukumi mu ekikumi",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        },
        {
          "text": "ebyakubulako, n'okukolima n'okolima, nga mpulira, laba, effeeza eyo nze njirina. Nze nagitwala.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 17:2"
      },
      "items": [
        {
          "text": "Awo nnyina n'amugamba nti, \"Mwana wange,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JDG.17.2",
                "verseOrgIds": [
                  "JDG.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda akuwe omukisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe yakomyawo ebitundu bya ffeeza ebyo olukumi mu ekikumi, eri nnyina, nnyina n'amugamba nti, \"Mpaayo effeeza eno eri",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.3",
            "verseOrgIds": [
              "JDG.17.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JDG.17.3",
                "verseOrgIds": [
                  "JDG.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, okuva mu mukono gwange ku lw'omwana wange, ekolebwemu ekifaananyi ekyole n'ekifaananyi ekisaanuuse, era ndimuzza gy'oli.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.3",
            "verseOrgIds": [
              "JDG.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe yazza effeeza, nnyina n'addira ebitundu ebikumi bibiri ebya ffeeza",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.4",
            "verseOrgIds": [
              "JDG.17.4"
            ]
          }
        },
        {
          "text": ", n'abiwa omuweesi wa ffeeza, n'abikolamu ekifaananyi ekyole n'ekifaananyi ekisaanuuse. Ne biteekebwa mu nnyumba ya Mikka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.4",
            "verseOrgIds": [
              "JDG.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusajja oyo Mikka yalina essabo. N'akola efodi, n'ebifaananyi ebyole n'ayawula omu ku batabani be okuba kabona we.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.5",
            "verseOrgIds": [
              "JDG.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biro ebyo tewaaliwo kabaka mu Isirayiri, era buli muntu yakolanga nga bw'alaba.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.6",
            "verseOrgIds": [
              "JDG.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne wabaawo omuvubuka ow'omu kika kya Yuda nga Muleevi, eyabeeranga mu Besirekemuyuda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.7",
            "verseOrgIds": [
              "JDG.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ava mu kibuga kya Besirekemuyuda n'atandika okunoonya gy'anaabera, n'atuuka mu nsi ey'ensozi eya Efulayimu mu nnyumba ya Mikka. Wabula yali akyali ku lugendo ng'akyanoonya aw'okubeera.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.8",
            "verseOrgIds": [
              "JDG.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikka n'amubuuza nti, \"Ova wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.9",
            "verseOrgIds": [
              "JDG.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 17:9"
      },
      "items": [
        {
          "text": "Omuleevi n'amuddamu nti, \"Nva mu Besirekemuyuda, era nnoonya we nnyinza okubeera.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.9",
            "verseOrgIds": [
              "JDG.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikka n'amugamba nti, \"Beera nange, obeere kitange era kabona, nange ndikuwa ebitundu bya ffeeza kkumi",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.10",
            "verseOrgIds": [
              "JDG.17.10"
            ]
          }
        },
        {
          "text": "ng'empeera, era ne nkuwa n'engoye n'emmere.\" Omuleevi n'abeera naye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.10",
            "verseOrgIds": [
              "JDG.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Omuleevi n'akkiriza okubeera n'omusajja oyo, era omuvubuka n'aba gy'ali ng'omu ku batabani be.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.11",
            "verseOrgIds": [
              "JDG.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Mikka n'ayawula Omuleevi, era omuvubuka oyo n'abeera kabona we n'abeera mu nnyumba ya Mikka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.12",
            "verseOrgIds": [
              "JDG.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikka n'ayogera nti, \"Kaakano mmanyi nga",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.13",
            "verseOrgIds": [
              "JDG.17.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JDG.17.13",
                "verseOrgIds": [
                  "JDG.17.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda anankoleranga ebirungi, kubanga nnina Omuleevi nga kabona wange.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.13",
            "verseOrgIds": [
              "JDG.17.13"
            ]
          }
        }
      ]
    }
  ],
