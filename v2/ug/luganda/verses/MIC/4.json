            "number": "1",
            "style": "v",
            "sid": "MIC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nnaku ez'oluvannyuma",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "olusozi lw'ennyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "MIC.4.1",
                "verseOrgIds": [
                  "MIC.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "luligulumizibwa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "okusinga ensozi zonna;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "lulisitulibwa waggulu okusukkuluma ku busozi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "era abantu balisimba ennyiriri nga balaga gye luli.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawanga mangi galiragayo ne googera nti,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "\"Mujje twambuke ku lusozi lwa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "MIC.4.2",
                "verseOrgIds": [
                  "MIC.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "mu nnyumba ya Katonda wa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "Alituyigiriza by'ayagala",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "tulyoke tutambulire mu makubo ge.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "Alisinziira mu Sayuuni okuwa abantu etteeka lye,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "n'ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "MIC.4.2",
                "verseOrgIds": [
                  "MIC.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kiriva mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliramula amawanga",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "atereeze ensonga wakati w'amawanga gakirimaanyi ag'ewala.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "Baliddira ebitala byabwe ne babiweesaamu enkumbi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "n'amafumu gaabwe ne bagaweesaamu ebiwabyo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "Eggwanga teririyimusa kitala ku ggwanga linnaalyo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "so tebalyetegeka kulwana ntalo nate.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli muntu aliba mu ddembe wansi w'omuzabbibu gwe",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "ne mu mutiini gwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "Tewalibaawo abatiisa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "kubanga akamwa ka",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "MIC.4.4",
                "verseOrgIds": [
                  "MIC.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Ayinzabyonna ke kakyogedde.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
