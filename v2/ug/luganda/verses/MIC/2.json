      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zibasanze mmwe abateesa okukola ebitali bya butuukirivu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:1"
      },
      "items": [
        {
          "text": "era abateesa okukola ebibi nga bali ku buliri bwabwe;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:1"
      },
      "items": [
        {
          "text": "Obudde bwe bukya ne batuukiriza entegeka zaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:1"
      },
      "items": [
        {
          "text": "kubanga kiri mu nteekateeka yaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beegomba ebyalo ne babitwala,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:2"
      },
      "items": [
        {
          "text": "ne beegomba ennyumba nazo ne bazitwala.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:2"
      },
      "items": [
        {
          "text": "Banyigiriza omuntu ne batwala amaka ge olw'amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:2"
      },
      "items": [
        {
          "text": "ne bamubbako ebyobusika bwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.3",
                "verseOrgIds": [
                  "MIC.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kyava agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "\"Laba, ndireeta akabi ku bantu abo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "ke mutagenda kweggyamu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "Temuliddayo kubeera n'amalala nate",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "kubanga kiriba kiseera kya mitawaana.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo abantu balikusekerera;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "Balikuyeeyereza nga bayimba oluyimba luno olw'okukungubaga nti:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "'Tugwereddewo ddala;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "ebintu by'abantu bange bigabanyizibbwamu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.4",
                "verseOrgIds": [
                  "MIC.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "anziggirako ddala ettaka lyange,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "n'aliwa abo abatulyamu enkwe.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo tewalisigalawo muntu n'omu mu kuŋŋaaniro lya",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.5",
            "verseOrgIds": [
              "MIC.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.5",
                "verseOrgIds": [
                  "MIC.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.5",
            "verseOrgIds": [
              "MIC.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:5"
      },
      "items": [
        {
          "text": "aligabanyaamu ettaka ku bululu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.5",
            "verseOrgIds": [
              "MIC.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bannabbi baabwe boogera nti, \"Temuwa bunnabbi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:6"
      },
      "items": [
        {
          "text": "Temuwa bunnabbi ku bintu ebyo;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:6"
      },
      "items": [
        {
          "text": "tewali kabi kagenda kututuukako.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kye ky'okuddamu ggwe ennyumba ya Yakobo?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:7"
      },
      "items": [
        {
          "text": "Olowooza Omwoyo wa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.7",
                "verseOrgIds": [
                  "MIC.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "asunguwalira bwereere, si lwa bulungi bwo?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:7"
      },
      "items": [
        {
          "text": "Ebigambo bye tebiba birungi eri abo abakola obulungi?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennaku zino abantu bange bannyimukiddeko",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:8"
      },
      "items": [
        {
          "text": "ng'omulabe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:8"
      },
      "items": [
        {
          "text": "Basika ne bambula eminagiro emirungi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:8"
      },
      "items": [
        {
          "text": "ne baggigya ku migongo gy'abayise ababa beetambulira mu mirembe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:8"
      },
      "items": [
        {
          "text": "ng'abasajja abakomawo okuva mu lutabaalo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakazi b'abantu bange mubagoba",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:9"
      },
      "items": [
        {
          "text": "mu mayumba gaabwe amalungi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:9"
      },
      "items": [
        {
          "text": "abaana baabwe ne mubaggyirako ddala buli mukisa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:9"
      },
      "items": [
        {
          "text": "oguva eri Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyimuke mugende,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.10",
            "verseOrgIds": [
              "MIC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:10"
      },
      "items": [
        {
          "text": "kubanga kino tekikyali kiwummulo kyammwe;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.10",
            "verseOrgIds": [
              "MIC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:10"
      },
      "items": [
        {
          "text": "olw'ebikolwa ebibi bye mukijjuzza,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.10",
            "verseOrgIds": [
              "MIC.2.10"
