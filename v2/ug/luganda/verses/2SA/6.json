                "verseOrgIds": [
                  "2SA.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", Isirayiri, era nzija kujagulizanga mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
