                "verseOrgIds": [
                  "2SA.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "eyannonda okusinga kitaawo, n'ennyumba ye yonna okuba omukulembeze w'abantu ba",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
        {
