              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Dawudi n'agamba Mikali nti, \"Nakikoledde mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
