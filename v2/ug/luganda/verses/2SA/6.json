                "verseOrgIds": [
                  "2SA.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'eggye,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
