                  "NUM.8.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, n'abatangiririra okubafuula abalongoofu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.21",
            "verseOrgIds": [
              "NUM.8.21"
            ]
          }
        },
        {
