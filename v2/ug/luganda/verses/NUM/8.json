                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'agamba Musa nti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.23",
            "verseOrgIds": [
              "NUM.8.23"
            ]
          }
        },
        {
