                "verseOrgIds": [
                  "NUM.8.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda bwe yalagira Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        }
