              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma baligoberera ebiragiro byange, ne bagenderera okukuuma amateeka gange, era baliba bantu bange, nange ndiba Katonda waabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.20",
            "verseOrgIds": [
