          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoyo n'ansitula mu kwolesebwa okw'Omwoyo wa Katonda n'antwala mu Bukaludaaya eri abaawaŋŋangusibwa.",
          "type": "text",
          "attrs": {
