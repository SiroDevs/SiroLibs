              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abo abanaagoberera ebitali bya butuukirivu n'eby'emizizo, ndibaleetako ebyo bye baakola ku mitwe gyabwe, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.21",
