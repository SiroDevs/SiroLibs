                "verseOrgIds": [
                  "EZK.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kiva wakati mu kibuga ne kiyimirira waggulu w'olusozi oluli ku luuyi olw'ebuvanjuba w'ekibuga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.23",
