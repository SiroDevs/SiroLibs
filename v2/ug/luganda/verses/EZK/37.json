  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "EZK 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekiwonvu eky'Amagumba Amakalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukono gwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.1",
                "verseOrgIds": [
                  "EZK.37.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwali ku nze, Mwoyo wa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.1",
                "verseOrgIds": [
                  "EZK.37.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'anfulumya, n'andeeta wakati mu kiwonvu ekyali kijjudde amagumba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agannaambuza, ne ndaba amagumba mangi, amakalu ennyo wansi mu kiwonvu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.2",
            "verseOrgIds": [
              "EZK.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ambuuza nti, \"Omwana w'omuntu, amagumba gano gayinza okuba amalamu?\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 37:3"
      },
      "items": [
        {
          "text": "Ne nziramu nti, \"Ggwe Ayi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.3",
                "verseOrgIds": [
                  "EZK.37.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, ggwe wekka gw'omanyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'aŋŋamba nti, \"Wa obunnabbi ku magumba gano, oyogere nti, 'Mmwe amagumba amakalu, muwulire ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.4",
                "verseOrgIds": [
                  "EZK.37.4"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.5",
                "verseOrgIds": [
                  "EZK.37.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda eri amagumba gano nti, Laba ndibateekamu omukka ne mufuuka abalamu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibateekako ebinywa n'ennyama ne mbabikkako n'olususu; ndibateekamu omukka, ne mufuuka abalamu. Olwo mulimanya nga nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.6",
            "verseOrgIds": [
              "EZK.37.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.6",
                "verseOrgIds": [
                  "EZK.37.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.6",
            "verseOrgIds": [
              "EZK.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne njogera nga bwe nalagirwa. Awo bwe nnali nga njogera, ne waba eddoboozi, ng'ebintu ebikubagana, amagumba ne geegatta, buli limu ku linnaalyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.7",
            "verseOrgIds": [
              "EZK.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ntunula, ebinywa n'ennyama ne birabika ku go, n'olususu ne luddako, naye temwali mukka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.8",
            "verseOrgIds": [
              "EZK.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'aŋŋamba nti, \"Wa obunnabbi eri omukka; yogera omwana w'omuntu, ogambe nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.9",
            "verseOrgIds": [
              "EZK.37.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.9",
                "verseOrgIds": [
                  "EZK.37.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nti, Ggwe omukka vva eri empewo ennya, oyingire mu battibwa, babe balamu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.9",
            "verseOrgIds": [
              "EZK.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mpa obunnabbi nga bwe yandagira, omukka ne gubayingiramu ne balamuka, ne bayimirira, era ne baba eggye ddene nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.10",
            "verseOrgIds": [
              "EZK.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'aŋŋamba nti, \"Omwana w'omuntu, amagumba gano ye nnyumba yonna eya Isirayiri. Boogera nti, 'Amagumba gaffe gaakala era n'essuubi lyaffe lyaggwaawo, twasalibwako.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.11",
            "verseOrgIds": [
              "EZK.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonoova owa obunnabbi gye bali n'oyogera nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.12",
            "verseOrgIds": [
              "EZK.37.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.12",
                "verseOrgIds": [
                  "EZK.37.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nti, Mmwe abantu bange, ndyasamya amalaalo gammwe ne mbazuukiza, era ndibakomyawo mu nsi ya Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.12",
            "verseOrgIds": [
              "EZK.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale mulimanya nga nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.13",
            "verseOrgIds": [
              "EZK.37.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.13",
                "verseOrgIds": [
                  "EZK.37.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", era nga nammwe muli bantu bange, bwe ndyasamya amalaalo gammwe ne mbazuukiza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.13",
            "verseOrgIds": [
              "EZK.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibateekamu Omwoyo wange era muliba balamu; ndibateeka mu nsi yammwe mmwe ne mutuula omwo, mulyoke mumanye nga nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.14",
                "verseOrgIds": [
                  "EZK.37.14"
                ]
              }
            }
          ]
        },
        {
          "text": "nkyogedde, era nkikoze, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.14",
                "verseOrgIds": [
                  "EZK.37.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eggwanga Limu Lifugibwa Kabaka Omu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.15",
            "verseOrgIds": [
              "EZK.37.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.15",
                "verseOrgIds": [
                  "EZK.37.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ne kinzijira n'aŋŋamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.15",
            "verseOrgIds": [
              "EZK.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omwana w'omuntu ddira omuggo owandiikeko nti, 'Guno gwa Yuda n'Abayisirayiri abakolagana nabo.' Oddire n'omuggo omulala owandiikeko nti, 'Guno muggo gwa Efulayimu owa Yusufu n'ennyumba ya Isirayiri yonna, bwe bakolagana.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.16",
            "verseOrgIds": [
              "EZK.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagatte bafuuke omuggo gumu, bafuuke omuntu omu mu mukono gwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.17",
            "verseOrgIds": [
              "EZK.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Awo abantu bo bwe bakubuuzanga nti, 'Amakulu ga bino kye ki?'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.18",
            "verseOrgIds": [
              "EZK.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obategeezanga nti, Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.19",
            "verseOrgIds": [
              "EZK.37.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.19",
                "verseOrgIds": [
                  "EZK.37.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nti, 'Ndiddira omuggo gwa Yusufu oguli mu mukono gwa Efulayimu, n'ebika bya Isirayiri n'abo bwe bakolagana, ne mbigatta ku muggo gwa Yuda, bafuuke omuntu omu mu mukono gwange.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.19",
            "verseOrgIds": [
              "EZK.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balage emiggo gy'owandiiseeko,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.20",
            "verseOrgIds": [
              "EZK.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "obagambe nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.21",
            "verseOrgIds": [
              "EZK.37.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.21",
                "verseOrgIds": [
                  "EZK.37.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nti, Ndiggya Abayisirayiri mu mawanga gye baagenda. Ndibakuŋŋaanya okuva wonna, ne mbakomyawo mu nsi yaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.21",
            "verseOrgIds": [
              "EZK.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibafuula eggwanga limu mu nsi, ku nsozi za Isirayiri. Balifugibwa kabaka omu, tebaliddayo kubeera mawanga abiri, wadde okwawulibwa mu bwakabaka obubiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.22",
            "verseOrgIds": [
              "EZK.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tebaliddayo kweyonoonyesa ne bakatonda abalala, ebintu ebikole obukozi n'emikono eby'ekivve, wadde okweyonoonyesa mu bibi byabwe. Ndibawonya okuva mu bifo byonna gye beeyonoonyesa, ndibafuula abalongoofu, muliba bantu bange, nange ndiba Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.23",
            "verseOrgIds": [
              "EZK.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Omuweereza wange Dawudi alibeera kabaka waabwe, era bonna baliba n'omusumba omu. Baligoberera amateeka gange, babeere beegendereza okukwata ebiragiro byange.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.24",
            "verseOrgIds": [
              "EZK.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balibeera mu nsi gye nawa omuweereza wange Yakobo, ensi bajjajjammwe mwe baabeeranga. Bo n'abaana baabwe, balibeera omwo ennaku zonna, era Dawudi omuweereza wange alibeera mulangira waabwe emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.25",
            "verseOrgIds": [
              "EZK.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikola endagaano yange ebawa emirembe, eriba ndagaano ey'olubeerera. Ndibanyweza ne mbaaza, era nditeeka ekifo kyange eky'okubeeramu wakati mu bo emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.26",
            "verseOrgIds": [
              "EZK.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekifo kyange eky'okubeeramu kinaabeeranga mu bo. Nnaabeeranga Katonda waabwe nabo banaabeeranga bantu bange.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.27",
            "verseOrgIds": [
              "EZK.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawanga galimanya nga nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.28",
            "verseOrgIds": [
              "EZK.37.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.28",
                "verseOrgIds": [
                  "EZK.37.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, nze ntukuza Isirayiri; ekifo kyange eky'okubeeramu kiri mu bo emirembe gyonna.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.28",
            "verseOrgIds": [
              "EZK.37.28"
            ]
          }
        }
      ]
    }
