              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiziba akamwa ko, n'osirikira ddala, n'olema okubanenya, newaakubadde nga nnyumba njeemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.26",
