              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka bwe ndyogera gy'oli, ndizibula akamwa ko era olibagamba nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.27",
