  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "LUK 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Atuma Abayigirizwa Ensanvu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo oluvannyuma lw'ebyo Yesu n'alonda abayigirizwa abalala nsanvu mu babiri",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.1",
            "verseOrgIds": [
              "LUK.10.1"
            ]
          }
        },
        {
          "text": ", n'abatuma babiri babiri bamukulembere bagende mu buli kibuga ekinene, na buli kifo mwe yali anaatera okutuuka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.1",
            "verseOrgIds": [
              "LUK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.2",
            "verseOrgIds": [
              "LUK.10.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Eby'okukungula bingi, naye abakozi abakungula batono. Noolwekyo musabe nannyini nnimiro, aweereze abakozi mu nnimiro ye.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.2",
                "verseOrgIds": [
                  "LUK.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.2",
            "verseOrgIds": [
              "LUK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale, mugende. Kyokka mbatuma ng'abaana b'endiga mu misege.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.3",
                "verseOrgIds": [
                  "LUK.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.3",
            "verseOrgIds": [
              "LUK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Temugenda na nsimbi era temutwala nsawo ya kusabiriza wadde omugogo gw'engatto, ate temubaako gwe mulamusa mu kkubo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.4",
                "verseOrgIds": [
                  "LUK.10.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Buli nnyumba gye muyingirangamu musookanga kugamba nti, 'Emirembe gibeere mu nnyumba eno.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.5",
                "verseOrgIds": [
                  "LUK.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.5",
            "verseOrgIds": [
              "LUK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ennyumba eyo bw'eneebangamu omuntu ow'emirembe, emirembe gyammwe ginaabeeranga ku ye, bwe kitaabenga bwe kityo, emirembe gyammwe ginaabaddiranga.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.6",
                "verseOrgIds": [
                  "LUK.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.6",
            "verseOrgIds": [
              "LUK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mu nnyumba omwo, mwe musookedde, munaalyanga era ne munywa nabo, kubanga omukozi asaanira empeera ye. Temuvanga mu nnyumba emu ne mudda mu ndala.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.7",
                "verseOrgIds": [
                  "LUK.10.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Buli kibuga kye mutuukangamu ne babaaniriza, mulyenga ebyo bye babawadde okulya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.8",
                "verseOrgIds": [
                  "LUK.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.8",
            "verseOrgIds": [
              "LUK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Muwonyenga abalwadde abalimu, era mugambenga abantu abo nti, 'Obwakabaka bwa Katonda bubasemberedde.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.9",
                "verseOrgIds": [
                  "LUK.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.9",
            "verseOrgIds": [
              "LUK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye bwe muyingiranga mu kibuga kyonna ne batabaaniriza, mulaganga mu nguudo zaakyo ne mugamba nti,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.10",
                "verseOrgIds": [
                  "LUK.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.10",
            "verseOrgIds": [
              "LUK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'N'enfuufu ekwatidde ku bigere byaffe tugibakunkumulira. Naye mumanye kino nti obwakabaka bwa Katonda busembedde.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.11",
                "verseOrgIds": [
                  "LUK.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.11",
            "verseOrgIds": [
              "LUK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mbategeeza nti ku lunaku luli, Sodomu kigenda kugumiikirizika okusinga ekibuga ekyo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.12",
                "verseOrgIds": [
                  "LUK.10.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zikusanze, ggwe Kolaziini! Naawe zikusanze, Besusayida! Kubanga ebyamagero ekyakolerwa mu mmwe, singa byakolerwa mu Ttuulo ne mu Sidoni, abantu baamu bandibadde beenenya dda, nga bambadde n'ebibukutu nga batudde mu vvu okulaga nti beenenyezza.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.13",
                "verseOrgIds": [
                  "LUK.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye Ttuulo ne Sidoni birisaasirwa okusinga mmwe ku lunaku olw'okusalirako omusango.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.14",
                "verseOrgIds": [
                  "LUK.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ate ggwe Kaperunawumu, oligulumizibwa okutuuka mu ggulu? Nedda, ogenda kuserengesebwa wansi emagombe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.15",
                "verseOrgIds": [
                  "LUK.10.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Buli abawuliriza mmwe aba awulirizza Nze, na buli abanyooma aba anyoomye Nze, n'oyo anyooma Nze aba anyoomye eyantuma.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.16",
                "verseOrgIds": [
                  "LUK.10.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abayigirizwa ensavu mu ababiri bwe baakomawo, nga basanyuka ne bategeeza Yesu nti, \"Mukama waffe, ne baddayimooni baatugondera mu linnya lyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.17",
            "verseOrgIds": [
              "LUK.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.18",
            "verseOrgIds": [
              "LUK.10.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nalaba Setaani ng'agwa okuva mu ggulu ng'okumyansa kw'eraddu!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.18",
                "verseOrgIds": [
                  "LUK.10.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.18",
            "verseOrgIds": [
              "LUK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Laba mbawadde obuyinza okulinnya ku misota ne ku njaba ez'obusagwa n'okuwangula amaanyi gonna ag'omulabe. Era tewali kigenda kubakola kabi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.19",
                "verseOrgIds": [
                  "LUK.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.19",
            "verseOrgIds": [
              "LUK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye temusanyuka nnyo kubanga baddayimooni babagondera, wabula mujaguze nti amannya gammwe gawandiikiddwa mu ggulu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.20",
                "verseOrgIds": [
                  "LUK.10.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo Yesu n'ajjula essanyu ku bwa Mwoyo Mutukuvu n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.21",
            "verseOrgIds": [
              "LUK.10.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nkutendereza Kitange, Mukama w'eggulu n'ensi, kubanga wakweka ebintu bino abagezi n'abayivu, naye n'obibikkulira abaana abato. Weewaawo Kitange, bw'otyo bwe wasiima.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.21",
                "verseOrgIds": [
                  "LUK.10.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kitange yankwasa ebintu byonna. Tewali amanyi Mwana wabula Kitange, era tewali amanyi Kitange wabula Omwana awamu n'abo Omwana b'asiima okubamubikkulira.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.22",
                "verseOrgIds": [
                  "LUK.10.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'akyukira abayigirizwa be n'abagamba mu kyama nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.23",
            "verseOrgIds": [
              "LUK.10.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mulina omukisa mmwe okulaba bino bye mulaba.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.23",
                "verseOrgIds": [
                  "LUK.10.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.23",
            "verseOrgIds": [
              "LUK.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga mbagamba nti, bannabbi bangi ne bakabaka bangi abaayagala okulaba bye mulaba n'okuwulira bye muwulira naye tekyasoboka.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.24",
                "verseOrgIds": [
                  "LUK.10.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omusamaliya Omulungi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale laba omunnyonnyozi w'amateeka n'asituka, ng'ayagala okugezesa Yesu, n'amubuuza nti, \"Omuyigiriza, nsaana nkole ki okusikira obulamu obutaggwaawo?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.25",
            "verseOrgIds": [
              "LUK.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amuddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.26",
            "verseOrgIds": [
              "LUK.10.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kyawandiikibwa kitya mu mateeka? Gagamba gatya?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.26",
                "verseOrgIds": [
                  "LUK.10.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunnyonnyozi w'amateeka n'addamu nti, \" 'Yagalanga Mukama Katonda wo n'omutima gwo gwonna, n'emmeeme yo yonna, n'amaanyi go gonna, n'amagezi go gonna.' Era 'yagalanga muliraanwa wo nga naawe bwe weeyagala.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.27",
            "verseOrgIds": [
              "LUK.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.28",
            "verseOrgIds": [
              "LUK.10.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ozzeemu bulungi. Kale kolanga bw'otyo oliba mulamu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.28",
                "verseOrgIds": [
                  "LUK.10.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omunnyonnyozi w'amateeka okwagala okulaga nga bw'ali omutuufu n'agamba Yesu nti, \"Muliraanwa wange ye ani?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.29",
            "verseOrgIds": [
              "LUK.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amuddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.30",
            "verseOrgIds": [
              "LUK.10.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Waaliwo omuntu eyali ava e Yerusaalemi ng'aserengeta e Yeriko, n'agwa mu banyazi, ne bamukwata ne bamwambulamu engoye ze ne bazimutwalako, ne bamukuba nnyo, ne bamuleka awo ku kkubo ng'abulako katono okufa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.30",
                "verseOrgIds": [
                  "LUK.10.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.30",
            "verseOrgIds": [
              "LUK.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Awo kabona eyali tategedde n'ajjira mu kkubo eryo, naye bwe yatuuka ku musajja ng'agudde awo ku kkubo n'amwebalama bwebalami n'amuyitako.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.31",
                "verseOrgIds": [
                  "LUK.10.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.31",
            "verseOrgIds": [
              "LUK.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omuleevi naye yamutuukako n'amulaba, n'adda ku ludda olulala olw'oluguudo, n'amuyitako buyisi",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.32",
                "verseOrgIds": [
                  "LUK.10.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.32",
            "verseOrgIds": [
              "LUK.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye Omusamaliya bwe yali ng'ali ku lugendo lwe mu kkubo eryo, n'atuuka omusajja we yali; bwe yamulaba n'amukwatirwa ekisa,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.33",
                "verseOrgIds": [
                  "LUK.10.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.33",
            "verseOrgIds": [
              "LUK.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "n'ajja w'ali, n'amunyiga ebiwundu ng'ayiwako amafuta, ne wayini ebiwundu n'abisibako ebiwero. Awo n'ateeka omusajja ku nsolo ye n'amutwala mu nnyumba esulwamu abatambuze, n'amujjanjaba.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.34",
                "verseOrgIds": [
                  "LUK.10.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.34",
            "verseOrgIds": [
              "LUK.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Enkeera Omusamaliya n'addira ddinaali bbiri n'aziwa nannyini nnyumba. N'amugamba nti, 'Nkusaba omujjanjabe, era ensimbi ezizo zonna z'olikozesa nga zino ze nkulekedde ziweddewo, ndizikuddizaawo nga nkomyewo.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.35",
                "verseOrgIds": [
                  "LUK.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kale olowooza, ku bantu abo abasatu aluwa eyali muliraanwa w'omusajja oli eyagwa mu banyazi?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.36",
            "verseOrgIds": [
              "LUK.10.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunnyonnyozi w'amateeka n'addamu nti, \"Oyo eyamukolera ebyekisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.37",
            "verseOrgIds": [
              "LUK.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 10:37"
      },
      "items": [
        {
          "text": "Yesu n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.37",
            "verseOrgIds": [
              "LUK.10.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naawe genda okole bw'otyo.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.37",
                "verseOrgIds": [
                  "LUK.10.37"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Akyalira Maliza ne Maliyamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'abayigirizwa be nga bali ku lugendo lwabwe, ne batuuka mu kabuga akamu, omukazi erinnya lye Maliza n'asembeza Yesu mu maka ge.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.38",
            "verseOrgIds": [
              "LUK.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalina muganda we erinnya lye Maliyamu. N'atuula awo wansi ku bigere bya Yesu, ng'awuliriza ebigambo Yesu bye yali ayogera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.39",
            "verseOrgIds": [
              "LUK.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Maliza yali yeetawula mu mirimu ng'ategekera abagenyi, n'ajja awali Yesu n'amugamba nti, \"Mukama wange, tofaayo ng'olaba muganda wange andekedde emirimu nzekka?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.40",
            "verseOrgIds": [
              "LUK.10.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Mukama waffe n'amuddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.41",
            "verseOrgIds": [
              "LUK.10.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Maliza, Maliza, ebintu ebikutawaanya bingi,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.41",
                "verseOrgIds": [
                  "LUK.10.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.41",
            "verseOrgIds": [
              "LUK.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "naye waliwo ekintu kimu kyokka ekyetaagibwa, Maliyamu alonze omugabo omulungi ogutagenda kumuggyibwako.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.42",
                "verseOrgIds": [
                  "LUK.10.42"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
