{
  "id": "LUK.18",
  "number": "18",
  "bookId": "LUK",
  "reference": "Lukka 18",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "LUK 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero lwa Nnamwandu n'Omulamuzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'agerera abayigirizwa be olugero ng'agamba nga bwe bagwanidde obutakoowanga kusaba n'obutaggwaamu mwoyo, ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.1",
            "verseOrgIds": [
              "LUK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Waaliwo omulamuzi mu kibuga ekimu, nga tatya Katonda era nga tafa ku muntu yenna.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.2",
                "verseOrgIds": [
                  "LUK.18.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.2",
            "verseOrgIds": [
              "LUK.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mu kibuga ekyo mwalimu nnamwandu eyajjanga ew'omulamuzi oyo buli lunaku ng'amwegayirira nti, 'Nnamula n'omulabe wange.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.3",
                "verseOrgIds": [
                  "LUK.18.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Omulamuzi n'amala ebbanga ng'akyagaanyi. Naye oluvannyuma n'agamba mu mutima gwe nti, 'Newaakubadde nga sitya Katonda era nga sirina muntu gwe nzisaamu kitiibwa,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.4",
                "verseOrgIds": [
                  "LUK.18.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.4",
            "verseOrgIds": [
              "LUK.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "naye olwokubanga nnamwandu ono aneetayiridde nnyo, nzijja kumumalira ensonga ze, kubanga ajja kunkooya olw'okuneetayirira ng'ajja gye ndi buli lunaku!' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.5",
                "verseOrgIds": [
                  "LUK.18.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Mukama waffe n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.6",
            "verseOrgIds": [
              "LUK.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Muwulire omulamuzi atali wa mazima bw'agamba.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.6",
                "verseOrgIds": [
                  "LUK.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.6",
            "verseOrgIds": [
              "LUK.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale Katonda talisingawo nnyo kulamula abantu be, be yeerondera, abamukaabirira emisana n'ekiro ate ng'abagumiikiriza?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.7",
                "verseOrgIds": [
                  "LUK.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.7",
            "verseOrgIds": [
              "LUK.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mbagamba nti agenda kubalamula mangu. Naye Omwana w'Omuntu, bw'alijja, alisanga okukkiriza ku nsi?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.8",
                "verseOrgIds": [
                  "LUK.18.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'agerera olugero luno abo abeerowooza nga batuukirivu nga banyoomoola n'abantu abalala, n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.9",
            "verseOrgIds": [
              "LUK.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Abantu babiri baayambuka mu Yeekaalu okusaba, omu yali Mufalisaayo n'omulala nga muwooza.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.10",
                "verseOrgIds": [
                  "LUK.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.10",
            "verseOrgIds": [
              "LUK.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omufalisaayo n'ayimirira n'atandika okusaba nga yeeyogerako nti, 'Nkwebaza, Katonda, kubanga sifaanana ng'abantu abalala: ab'omululu, abalyazaamaanyi, abenzi, oba omuwooza ono.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.11",
                "verseOrgIds": [
                  "LUK.18.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.11",
            "verseOrgIds": [
              "LUK.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nsiiba emirundi ebiri mu wiiki, era mpaayo eri Katonda, ekimu eky'ekkumi ku bintu byonna bye nfuna.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.12",
                "verseOrgIds": [
                  "LUK.18.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye omuwooza n'ayimirira wala n'atasobola na kuyimusa maaso ge kutunula eri eggulu ng'asaba, wabula ne yeekuba mu kifuba ng'asaba nti, 'Katonda, onsaasire, nze omwonoonyi.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.13",
                "verseOrgIds": [
                  "LUK.18.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mbagamba nti omusajja ono, omuwooza ye yaddayo eka ng'asonyiyiddwa ebibi bye. Kubanga buli eyeegulumiza alitoowazibwa, n'oyo eyeetoowaza aligulumizibwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.14",
                "verseOrgIds": [
                  "LUK.18.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu n'Abaana Abato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lumu ne wabaawo abaaleetera Yesu abaana baabwe abato abakwateko abawe omukisa. Naye abayigirizwa bwe baakiraba ne bajunga abaabaleeta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.15",
            "verseOrgIds": [
              "LUK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yesu abaana n'abayita, n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.16",
            "verseOrgIds": [
              "LUK.18.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Muleke abaana abato bajje gye ndi, temubagaana, kubanga abali nga bano be b'obwakabaka bwa Katonda.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.16",
                "verseOrgIds": [
                  "LUK.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.16",
            "verseOrgIds": [
              "LUK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ddala ddala mbagamba nti atayaniriza bwakabaka bwa Katonda ng'omwana omuto, talibuyingiramu n'akatono.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.17",
                "verseOrgIds": [
                  "LUK.18.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukungu Omugagga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omu ku bakulembeze b'Abayudaaya n'abuuza Yesu nti, \"Omuyigiriza omulungi, nkole ki okufuna obulamu obutaggwaawo?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.18",
            "verseOrgIds": [
              "LUK.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amuddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.19",
            "verseOrgIds": [
              "LUK.18.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lwaki ompita omulungi? Tewali mulungi n'omu wabula Katonda yekka.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.19",
                "verseOrgIds": [
                  "LUK.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.19",
            "verseOrgIds": [
              "LUK.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amateeka ogamanyi nti, 'Toyendanga, tottanga, tobbanga, tolimbanga, kitaawo ne nnyoko obassangamu ekitiibwa.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.20",
                "verseOrgIds": [
                  "LUK.18.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amuddamu nti, \"Amateeka ago gonna ngagondedde ebbanga lyonna okuva mu buto bwange.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.21",
            "verseOrgIds": [
              "LUK.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yawulira ebyo, n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.22",
            "verseOrgIds": [
              "LUK.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Okyabulako ekintu kimu. Genda otunde ebibyo byonna, ensimbi z'onoggyamu ozigabire abaavu, olibeera n'obugagga mu ggulu, olyoke ojje ongoberere.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.22",
                "verseOrgIds": [
                  "LUK.18.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bwe yawulira ebigambo ebyo n'agenda ng'anakuwadde nnyo, kubanga yali mugagga nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.23",
            "verseOrgIds": [
              "LUK.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yamulaba ng'anakuwadde nnyo, n'ayogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.24",
            "verseOrgIds": [
              "LUK.18.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nga kizibu omugagga okuyingira mu bwakabaka bwa Katonda!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.24",
                "verseOrgIds": [
                  "LUK.18.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.24",
            "verseOrgIds": [
              "LUK.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kyangu eŋŋamira okuyita mu nnyindo y'empiso okusinga omugagga okuyingira mu bwakabaka bwa Katonda.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.25",
                "verseOrgIds": [
                  "LUK.18.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abaawulira ebyo kwe kubuuza nti, \"Kale ani ayinza okulokolebwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.26",
            "verseOrgIds": [
              "LUK.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'addamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.27",
            "verseOrgIds": [
              "LUK.18.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ebitayinzika eri abantu, biyinzika eri Katonda.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.27",
                "verseOrgIds": [
                  "LUK.18.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peetero n'amugamba nti, \"Ffe twalekawo ebyaffe byonna ne tukugoberera!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.28",
            "verseOrgIds": [
              "LUK.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'addamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.29",
            "verseOrgIds": [
              "LUK.18.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ddala ddala mbagamba nti teri muntu n'omu eyalekawo amaka ge, oba omukazi we, oba baganda be, oba abazadde be, oba abaana be, olw'obwakabaka bwa Katonda,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.29",
                "verseOrgIds": [
                  "LUK.18.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.29",
            "verseOrgIds": [
              "LUK.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "atalifuna mirundi mingi n'okusingawo mu mulembe guno, ate ne mu mulembe ogugenda okujja aweebwe obulamu obutaggwaawo.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.30",
                "verseOrgIds": [
                  "LUK.18.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Ayongera Okwogera ku Kufa kwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'azza ku bbali ekkumi n'ababiri, n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Laba, twambuka e Yerusaalemi, era bwe tunaatuuka eyo, byonna bannabbi bye bawandiika ku Mwana w'Omuntu, bijja kutuukirizibwa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.31",
                "verseOrgIds": [
                  "LUK.18.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ajja kuweebwayo eri Abamawanga okukudaalirwa n'okuvumibwa. Balimuduulira, ne bamubonyaabonya, ne bamuwandira amalusu,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.32",
                "verseOrgIds": [
                  "LUK.18.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.32",
            "verseOrgIds": [
              "LUK.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "balimukuba era ne bamutta. Ne ku lunaku olwokusatu alizuukira.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.33",
                "verseOrgIds": [
                  "LUK.18.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abayigirizwa be tebaategeera ky'agamba, amakulu gaakyo gaali gabakwekeddwa, ne batategeera bye yayogera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awonya Omuzibe w'Amaaso Omusabiriza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu bwe yali ng'asemberera Yeriko, ne wabaawo omusajja omuzibe w'amaaso eyali atudde ku kkubo ng'asabiriza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.35",
            "verseOrgIds": [
              "LUK.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omusajja oyo bwe yawulira ng'ekibiina ky'abantu bayitawo, n'abuuza nti, \"Kiki ekyo?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.36",
            "verseOrgIds": [
              "LUK.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bamuddamu nti, \"Yesu Omunnazaaleesi ye ayitawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.37",
            "verseOrgIds": [
              "LUK.18.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuzibe w'amaaso n'akoowoola nti, \"Yesu, Omwana wa Dawudi, onsaasire!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.38",
            "verseOrgIds": [
              "LUK.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abaali bakulembeddemu ne bamuboggolera asirike, kyokka ye ne yeeyongera bweyongezi okuleekaana nti, \"Omwana wa Dawudi, onsaasire!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.39",
            "verseOrgIds": [
              "LUK.18.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'ayimirira, n'alagira, omusajja bamumuleetere. Bwe yasembera, Yesu n'amubuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.40",
            "verseOrgIds": [
              "LUK.18.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kiki ky'oyagala nkukolere?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.41",
                "verseOrgIds": [
                  "LUK.18.41"
                ]
              }
            }
          ]
        },
        {
          "text": "Omusajja n'addamu nti, \"Mukama wange, njagala nziremu okulaba!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.41",
            "verseOrgIds": [
              "LUK.18.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.42",
            "verseOrgIds": [
              "LUK.18.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ddamu okulaba. Okukkirizakwo kukuwonyezza.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.18.42",
                "verseOrgIds": [
                  "LUK.18.42"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.42",
            "verseOrgIds": [
              "LUK.18.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago n'addamu okulaba, n'agoberera Yesu ng'atendereza Katonda. Bonna abaakiraba ne batendereza Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.43",
            "verseOrgIds": [
              "LUK.18.43"
            ]
          }
        }
      ]
    }
  ],
