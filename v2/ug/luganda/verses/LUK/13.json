  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "LUK 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwenenya oba Kuzikirira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo ne wabaawo abategeeza Yesu nga Piraato bwe yatta Abagaliraaya, omusaayi gwabwe n'agutabula mu biweebwayo byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.1",
            "verseOrgIds": [
              "LUK.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mulowooza nti Abagaliraaya abo baali boonoonyi nnyo okusinga Abagaliraaya abalala bonna, balyoke baboneebone batyo?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.2",
                "verseOrgIds": [
                  "LUK.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nedda! Mbagamba nti bwe muteenenya nammwe mugenda kuzikirira ng'abo bwe baazikirira.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.3",
                "verseOrgIds": [
                  "LUK.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.3",
            "verseOrgIds": [
              "LUK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ate bali ekkumi n'omunaana omunaala gwa Sirowamu be gwagwako, ne gubatta, mulowooza be baali basinga obwonoonyi okusinga abantu abaabeeranga mu Yerusaalemi bonna?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.4",
                "verseOrgIds": [
                  "LUK.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.4",
            "verseOrgIds": [
              "LUK.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nedda! Mbagamba nti bwe muteenenya nammwe bwe mugenda okuzikirira bwe mutyo.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.5",
                "verseOrgIds": [
                  "LUK.13.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero lw'Omutiini Ogutabala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'abagerera olugero luno nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Waaliwo omusajja eyasimba omutiini mu nnimiro ye. N'agendangayo okugulambula okulaba obanga gubazeeko ebibala, n'asanga nga tegubazeeko kibala na kimu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.6",
                "verseOrgIds": [
                  "LUK.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kyeyava alagira omusajja we amulimira ennimiro eyo nti, 'Omuti guno gutemewo. Kubanga gino emyaka esatu nga nambula omuti guno, naye tegubalangako kibala na kimu. Gwemalira bwereere ettaka lyaffe.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.7",
                "verseOrgIds": [
                  "LUK.13.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.7",
            "verseOrgIds": [
              "LUK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omulimi we n'addamu nti, 'Mukama wange, tuguleke tetugutemawo. Ka tuguweeyo omwaka gumu, nzija kugutemeratemera era nguteekeko n'ebigimusa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.8",
                "verseOrgIds": [
                  "LUK.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.8",
            "verseOrgIds": [
              "LUK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe gulibala ebibala gye bujja, kiriba kirungi! Naye bwe gutalibala, olwo noolyoka ogutemawo.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.9",
                "verseOrgIds": [
                  "LUK.13.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awonya Omukazi Omulema ku Ssabbiiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ku lunaku lwa Ssabbiiti Yesu yali ng'ayigiriza mu kkuŋŋaaniro,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.10",
            "verseOrgIds": [
              "LUK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne wabaawo omukazi eyaliko omuzimu ogwamulwaza okumala emyaka kkumi na munaana, nga yeewese emirundi ebiri era nga tasobola kwegolola.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.11",
            "verseOrgIds": [
              "LUK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amulaba, n'amuyita n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mukazi wattu, owonyezeddwa obulwadde bwo.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.12",
                "verseOrgIds": [
                  "LUK.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amukwatako. Amangwago omukazi ne yeegolola n'ayimirira bulungi, n'atendereza Katonda!",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.13",
            "verseOrgIds": [
              "LUK.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukulembeze w'ekkuŋŋaaniro eryo n'anyiiga nnyo, kubanga Yesu yawonya ku lunaku lwa Ssabbiiti. N'agamba ekibiina nti, \"Mu wiiki mulimu ennaku mukaaga, muyinza okujjanga mu nnaku ezo ne muwonyezebwa, naye so si ku Ssabbiiti!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.14",
            "verseOrgIds": [
              "LUK.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama waffe n'amuddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bannanfuusi mmwe! Buli omu ku mmwe tasumulula nte ye oba ndogoyi ye ku Ssabbiiti n'agitwala okunywa amazzi?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.15",
                "verseOrgIds": [
                  "LUK.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye si kituufu omukazi ono, muwala wa Ibulayimu, okusumululwa ku Ssabbiiti mu busibe bwa Setaani bw'amazeemu emyaka ekkumi n'omunaana?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.16",
                "verseOrgIds": [
                  "LUK.13.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yayogera bw'atyo abaali bamuwakanya bonna ne baswala, naye ekibiina ky'abantu bonna ne bajjula essanyu olw'ebintu eby'ekitalo bye yakola.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.17",
            "verseOrgIds": [
              "LUK.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero lw'Akaweke ka Kaladaali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu kyeyava abayigiriza ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Obwakabaka bwa Katonda bufaanana na ki? Mbugeraageranye na ki?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.18",
                "verseOrgIds": [
                  "LUK.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bufaanana na kaweke ka kaladaali omusajja ke yasiga mu nnimiro ye. Kaamera ne kavaamu omuti, n'ennyonyi ez'omu bbanga ne zituula ku matabi gaagwo.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.19",
                "verseOrgIds": [
                  "LUK.13.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate era n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Obwakabaka bwa Katonda mbugeraageranye na ki?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.20",
                "verseOrgIds": [
                  "LUK.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Buliŋŋanga ekizimbulukusa omukazi kye yatabulira mu bipimo by'obuwunga bisatu okutuusa obuwunga bwonna lwe bwazimbulukuka.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.21",
                "verseOrgIds": [
                  "LUK.13.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omulyango Omufunda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'ayita mu bibuga ne mu bubuga; yagendanga ayigiriza ng'ali ku lugendo lwe ng'agenda e Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.22",
            "verseOrgIds": [
              "LUK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne wabaawo eyeewuunya nti, \"Mukama waffe, abantu abalirokolebwa nga baliba batono?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 13:23"
      },
      "items": [
        {
          "text": "Yesu n'addamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mufube okuyingira mu mulyango omufunda kubanga mbagamba nti, bangi balyagala okuyingira naye tebalisobola.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.24",
                "verseOrgIds": [
                  "LUK.13.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.24",
            "verseOrgIds": [
              "LUK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nannyinimu bw'alisituka n'aggalawo oluggi, mugenda kubeera bweru nga mukonkona nga bwe mwegayirira nti, 'Mukama waffe, tuggulirewo.' Agenda kubaanukula nti, 'Sibamanyi, ne gye muva simanyiiyo.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.25",
                "verseOrgIds": [
                  "LUK.13.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.25",
            "verseOrgIds": [
              "LUK.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nammwe muliddamu nti, 'Twalyanga naawe era twanywanga ffenna, era wayigirizanga mu nguudo z'ewaffe.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.26",
                "verseOrgIds": [
                  "LUK.13.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.26",
            "verseOrgIds": [
              "LUK.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye alibaddamu nti, 'Sibamanyi, ne gye muva simanyiiyo. Munviire mwenna abakozi b'ebitali bya bituukirivu.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.27",
                "verseOrgIds": [
                  "LUK.13.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.27",
            "verseOrgIds": [
              "LUK.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era waliba okukuba ebiwoobe n'okuluma obujiji bwe muliraba Ibulayimu, ne Isaaka, ne Yakobo ne bannabbi bonna nga bali mu bwakabaka bwa Katonda, naye nga mmwe musuulibbwa ebweru.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.28",
                "verseOrgIds": [
                  "LUK.13.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga abantu baliva ebuvanjuba n'ebugwanjuba, ne bava ne mu bukiikakkono ne mu bukiikaddyo, ne batuula ku mmeeza mu bwakabaka bwa Katonda.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.29",
                "verseOrgIds": [
                  "LUK.13.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era laba, abooluvannyuma baliba aboolubereberye, n'aboolubereberye baliba abooluvannyuma.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.30",
                "verseOrgIds": [
                  "LUK.13.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Anakuwalira Yerusaalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo ne wabaawo abamu ku Bafalisaayo abajja eri Yesu ne bamugamba nti, \"Tambula ove wano, kubanga Kerode ayagala kukutta.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'abaddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mugende mugambe ekibe ekyo nti laba ngoba baddayimooni, n'okuwonya abalwadde, leero, n'enkya, era ku lunaku olwokusatu ndimaliriza.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.32",
                "verseOrgIds": [
                  "LUK.13.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye leero, n'enkya, ne luli nsaana mbeere ku lugendo lwange nga ntambula, kubanga tekisoboka nnabbi okufiira ebweru wa Yerusaalemi!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.33",
                "verseOrgIds": [
                  "LUK.13.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ggwe Yerusaalemi, ggwe Yerusaalemi, atta bannabbi, n'okuba amayinja abo ababa batumiddwa gy'oli, emirundi nga mingi nnyo gye njagadde okukuŋŋaanya abaana bo ng'enkoko bw'ekuŋŋaanya obwana bwayo mu biwaawaatiro byayo, naye n'ogaana!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.34",
                "verseOrgIds": [
                  "LUK.13.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale laba ennyumba yammwe erekeddwa awo. Era mbagamba nti temugenda kuddayo kundaba okutuusa ekiseera lwe kirituuka ne mugamba nti, 'Aweereddwa omukisa oyo ajja mu linnya lya Mukama.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.35",
                "verseOrgIds": [
                  "LUK.13.35"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
