              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye kitaawe n'alagira abaddu be nti, 'Mwanguwe mangu! Muleete ekkanzu esinga obulungi mugimwambaze. Mumunaanike empeta ku ngalo ye, mumwambaze n'engatto!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.22",
                "verseOrgIds": [
                  "LUK.15.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.22",
            "verseOrgIds": [
              "LUK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era mugende mutte ennyana eya ssava. Tufumbe embaga nnene tujaguze.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.23",
                "verseOrgIds": [
                  "LUK.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.23",
            "verseOrgIds": [
              "LUK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga mutabani wange ono yali afudde kaakano mulamu, yali azaaye laba wuuno azaawuse.' Embaga n'etandika.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.24",
                "verseOrgIds": [
                  "LUK.15.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 15:25"
          },
