        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Muganda we omukulu n'anyiiga, n'okuyingira n'atayingira mu nnyumba. Naye kitaawe n'ajja n'amwegayirira ayingire,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.28",
                "verseOrgIds": [
                  "LUK.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.28",
            "verseOrgIds": [
              "LUK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "naye omwana n'amuddamu nti, 'Emyaka gino gyonna nkukoledde, era tewali mulundi na gumu Lwe wali ondagidde ne nkujeemera. Naye tompangayo wadde akabuzi akato neesanyuseeko ne mikwano gyange.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.29",
                "verseOrgIds": [
                  "LUK.15.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.29",
            "verseOrgIds": [
              "LUK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye kale mutabani wo olukomyewo ng'ebintu byo bye wamuwa amaze okubimalira mu bamalaaya, n'omuttira ennyana ensava.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.30",
                "verseOrgIds": [
                  "LUK.15.30"
                ]
              }
            }
          ]
        }
      ]
    },
