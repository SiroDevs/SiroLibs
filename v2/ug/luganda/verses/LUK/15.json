              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mu kiseera ekyo omwana omukulu yali ali mu nnimiro. Awo bwe yali akomawo eka ng'asemberedde ennyumba, n'awulira ennyimba ez'amazina.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.25",
                "verseOrgIds": [
                  "LUK.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.25",
            "verseOrgIds": [
              "LUK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "N'ayita omu ku baweereza n'amubuuza bwe bibadde.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.26",
                "verseOrgIds": [
                  "LUK.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.26",
            "verseOrgIds": [
              "LUK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omuweereza n'amutegeeza nti, 'Muganda wo akomyewo, era kitammwe amuttidde ennyana eya ssava olwokubanga muganda wo akomyewo nga mulamu bulungi.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.27",
                "verseOrgIds": [
                  "LUK.15.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
