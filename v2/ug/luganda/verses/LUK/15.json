        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kitaawe n'amuddamu nti, 'Laba mwana wange, tuli ffenna bulijjo, era byonna bye nnina bibyo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.31",
                "verseOrgIds": [
                  "LUK.15.31"
                ]
              }
            }
