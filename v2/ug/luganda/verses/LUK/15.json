          "attrs": {
            "verseId": "LUK.15.31",
            "verseOrgIds": [
              "LUK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kaakano kituufu okusanyuka n'okujaguza. Kubanga muganda wo, yali afudde, kaakano mulamu! Yali azaaye, wuuno azaawuse!' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.32",
