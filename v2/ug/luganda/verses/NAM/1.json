    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "Ekkubo lye liri mu mpewo ey'akazimu ne mu kibuyaga,",
