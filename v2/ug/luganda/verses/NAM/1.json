          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:4"
      },
      "items": [
        {
          "text": "ennimiro ez'omu Basani zikala, olusozi Kalumeeri lwonna lukayuse,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
