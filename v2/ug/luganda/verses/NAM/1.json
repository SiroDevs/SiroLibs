      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "n'ebire ye nfuufu y'ebigere bye.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
