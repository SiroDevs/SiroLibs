      "items": [
        {
          "text": "n'ebimuli bya Lebanooni biwotose.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
