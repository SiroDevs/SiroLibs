      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:4"
      },
      "items": [
        {
          "text": "nga bawulidde ebigambo ebiva mu kamwa ko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.4",
            "verseOrgIds": [
              "PSA.138.4"
            ]
          }
        }
