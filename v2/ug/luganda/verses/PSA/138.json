      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 138:7"
      },
      "items": [
        {
          "text": "ogolola omukono gwo eri abalabe bange abakambwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
