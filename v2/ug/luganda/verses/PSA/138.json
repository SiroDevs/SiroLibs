          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde nga neetooloddwa ebizibu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
