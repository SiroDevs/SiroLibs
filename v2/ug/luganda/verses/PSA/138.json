          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaakutenderezanga Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.1",
                "verseOrgIds": [
                  "PSA.138.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'omutima gwange gwonna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:1"
      },
      "items": [
        {
          "text": "ne mu maaso ga bakatonda abalala nnaayimbanga okukutendereza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 138:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nvuunama nga njolekedde Yeekaalu yo Entukuvu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:2"
      },
      "items": [
        {
          "text": "ne ntendereza erinnya lyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:2"
      },
      "items": [
        {
          "text": "olw'okwagala kwo n'olw'obwesigwa bwo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 138:2"
      },
      "items": [
        {
          "text": "kubanga wagulumiza ekigambo kyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:2"
      },
      "items": [
        {
          "text": "n'erinnya lyo okusinga ebintu byonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
