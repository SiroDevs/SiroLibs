      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:1"
      },
      "items": [
        {
          "text": "lwanyisa abo abannwanyisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golokoka okwate engabo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.2",
            "verseOrgIds": [
              "PSA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:2"
      },
      "items": [
        {
          "text": "n'akagabo onziruukirire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.2",
            "verseOrgIds": [
              "PSA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galula effumu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "abangigganya obazibire ekkubo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "otegeeze omwoyo gwange nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "\"Nze bulokozi bwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bonna abannoonya okunzita bajolongebwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "era baswazibwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "abo abateesa okunsanyaawo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "bazzibweyo ennyuma babune emiwabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
