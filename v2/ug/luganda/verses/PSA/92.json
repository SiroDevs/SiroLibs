    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:9"
      },
      "items": [
        {
          "text": "abalabe bo balizikirira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
      ]
    },
