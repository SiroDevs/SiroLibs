      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:9"
      },
      "items": [
        {
          "text": "abakola ebibi bonna balisaasaanyizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 92:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nze wanfuula wa maanyi okwenkana embogo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.10",
            "verseOrgIds": [
              "PSA.92.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:10"
      },
      "items": [
        {
          "text": "n'onfukako amafuta amalungi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.10",
            "verseOrgIds": [
              "PSA.92.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
