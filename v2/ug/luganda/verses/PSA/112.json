      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 112",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 112:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutendereze",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.112.1",
                "verseOrgIds": [
                  "PSA.112.1"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 112:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 112:1"
      },
      "items": [
        {
          "text": "Alina omukisa omuntu atya Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:1"
      },
      "items": [
        {
          "text": "era asanyukira ennyo mu mateeka ge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 112:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana be baliba ba kitiibwa mu nsi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:2"
      },
      "items": [
        {
          "text": "omulembe gw'abalongoofu guliweebwa omukisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 112:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennyumba ye enejjulanga ebintu n'obugagga obungi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:3"
      },
      "items": [
        {
          "text": "era anaabanga mutuukirivu ennaku zonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 112:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mu kizikiza, ekitangaala kyakira omulongoofu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:4"
      },
      "items": [
        {
          "text": "alina ekisa, n'oyo alina okusaasira, era omutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 112:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu oyo agabira abeetaaga, era tawolera magoba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:5"
      },
      "items": [
        {
          "text": "era akola emirimu gye gyonna n'obwenkanya, alifuna ebirungi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 112:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutuukirivu talinyeenyezebwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.6",
            "verseOrgIds": [
              "PSA.112.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:6"
      },
      "items": [
        {
          "text": "era anajjukirwanga ennaku zonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.6",
            "verseOrgIds": [
              "PSA.112.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 112:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawulire amabi tegaamutiisenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:7"
      },
      "items": [
        {
          "text": "kubanga omutima gwe munywevu gwesiga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.112.7",
                "verseOrgIds": [
                  "PSA.112.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 112:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutima gwe guteredde, tewali ky'anaatyanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:8"
      },
      "items": [
        {
          "text": "era oluvannyuma alitunuulira abalabe be n'amaaso ag'obuwanguzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 112:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agabidde abaavu bye beetaaga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:9"
      },
      "items": [
        {
          "text": "mutuukirivu ebbanga lyonna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:9"
      },
      "items": [
        {
          "text": "era bonna banaamussangamu ekitiibwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 112:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubi anaabirabanga ebyo, n'asunguwala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:10"
      },
      "items": [
        {
          "text": "n'aluma abugigi, naye nga talina kya kukola.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:10"
      },
      "items": [
        {
          "text": "Okwegomba kw'ababi tekuubengako kye kubagasa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    }
  ],
