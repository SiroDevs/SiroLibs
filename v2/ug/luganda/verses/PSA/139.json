    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 139",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 139:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.139.1",
                "verseOrgIds": [
                  "PSA.139.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", okebedde omutima gwange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:1"
      },
      "items": [
        {
          "text": "n'otegeera byonna ebiri munda yange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 139:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ntuula omanya, ne bwe ngolokoka omanya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.2",
            "verseOrgIds": [
              "PSA.139.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:2"
      },
      "items": [
        {
          "text": "era otegeera byonna bye ndowooza, ne bwe mbeera ewala ennyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.2",
            "verseOrgIds": [
              "PSA.139.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 139:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otegeera okutambula kwange kwonna n'okuwummula kwange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.3",
            "verseOrgIds": [
              "PSA.139.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:3"
      },
      "items": [
        {
          "text": "Omanyi amakubo gange gonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.3",
            "verseOrgIds": [
              "PSA.139.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 139:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kye nnaayogera, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.139.4",
                "verseOrgIds": [
                  "PSA.139.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:4"
      },
      "items": [
        {
          "text": "okimanya nga sinnaba na kukyogera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 139:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ondi mu maaso n'emabega,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.5",
            "verseOrgIds": [
              "PSA.139.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:5"
      },
      "items": [
        {
          "text": "era ontaddeko omukono gwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.5",
            "verseOrgIds": [
              "PSA.139.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 139:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okumanya okw'engeri eyo kunsukkiridde,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.6",
            "verseOrgIds": [
              "PSA.139.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:6"
      },
      "items": [
        {
          "text": "era nkwewuunya nnyo, kunnema okutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.6",
            "verseOrgIds": [
              "PSA.139.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 139:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaagenda wa Omwoyo wo gy'atali?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.7",
            "verseOrgIds": [
              "PSA.139.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:7"
      },
      "items": [
        {
          "text": "Oba nnaagenda wa ggwe gy'otoli?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.7",
            "verseOrgIds": [
              "PSA.139.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 139:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe nnaalinya mu ggulu, nga gy'oli;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:8"
      },
      "items": [
        {
          "text": "bwe nnakka emagombe, nayo nga gy'oli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 139:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe nneebagala empewo ez'oku makya ne zintwala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:9"
      },
      "items": [
        {
          "text": "ne mbeera mu bitundu by'ennyanja ebisinga okuba ewala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 139:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "era n'eyo omukono gwo gunannuŋŋamya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.10",
            "verseOrgIds": [
              "PSA.139.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:10"
      },
      "items": [
        {
          "text": "omukono gwo ogwa ddyo gunannywezanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.10",
            "verseOrgIds": [
              "PSA.139.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 139:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe nnaagamba nti, \"Ekizikiza kimbuutikire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:11"
      },
      "items": [
        {
          "text": "n'obudde obw'emisana bwe ndimu bufuuke ekiro.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 139:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye era ekizikiza gy'oli tekiba kizikiza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:12"
      },
      "items": [
        {
          "text": "ekiro kyakaayakana ng'emisana;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:12"
      },
      "items": [
        {
          "text": "kubanga gy'oli ekizikiza n'omusana bifaanana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 139:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ggwe watonda byonna ebiri munda mu nze;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.13",
            "verseOrgIds": [
              "PSA.139.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:13"
      },
      "items": [
        {
          "text": "ggwe wammumbira mu lubuto lwa mmange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.13",
            "verseOrgIds": [
              "PSA.139.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 139:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkutendereza, kubanga wankola mu ngeri ey'entiisa era ey'ekitalo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:14"
      },
      "items": [
        {
          "text": "emirimu gyo gya kyewuunyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:14"
      },
      "items": [
        {
          "text": "era ekyo nkimanyidde ddala bulungi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 139:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wammanya nga ntondebwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:15"
      },
      "items": [
        {
          "text": "bwe nakolerwa mu kyama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 139:15"
      },
      "items": [
        {
          "text": "bwe natondebwa mu buziba bw'ensi n'amagezi go amangi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 139:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandaba nga si natondebwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 139:16"
      },
      "items": [
        {
          "text": "Ennaku zange zonna ze wanteekerateekera",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
