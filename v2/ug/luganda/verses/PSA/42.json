        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi: Zabbuli ya Batabani ba Koola.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'empeewo bw'ewejjawejja olw'amazzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.1",
            "verseOrgIds": [
              "PSA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:1"
      },
      "items": [
        {
          "text": "n'emmeeme yange bw'etyo bwe wejjawejja ku lulwo, Ayi Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.1",
            "verseOrgIds": [
              "PSA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emmeeme yange eyaayaanira Katonda, Katonda omulamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:2"
      },
      "items": [
        {
          "text": "Ndigenda ddi ne nsisinkana Katonda?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaabirira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.42.3",
                "verseOrgIds": [
                  "PSA.42.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "emisana n'ekiro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "Amaziga gange gabadde emmere yange emisana n'ekiro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "abantu ne baŋŋamba nti, \"Katonda wo ali ludda wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino mbijjukira nga nfuka emmeeme yange",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "nga bwe nagendanga n'ekibiina ekinene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "ne nkulembera ennyiriri z'abantu empanvu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "nga tugenda mu nnyumba ya Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "nga tuyimba mu ddoboozi ery'omwanguka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "n'okwebaza mu kibiina ekijaguza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki oweddemu amaanyi ggwe emmeeme yange?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Lwaki otabusetabuse mu nda yange?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Essuubi lyo liteeke mu Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "kubanga natenderezanga omulokozi wange era Katonda wange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "ye mubeezi wange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda wange, emmeeme yange yennyise,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "yeeraliikiridde;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "naye nkujjukira olw'ebyo bye wakola mu nsi ya Yoludaani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "ne ku nsozi engulumivu eza Kalumooni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        },
        {
          "text": "ne ku Lusozi Mizali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuziba bukoowoola obuziba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "olw'okuwuluguma kw'ebiyiriro",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "amayengo n'amasingisira go",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "bimpiseeko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.42.8",
                "verseOrgIds": [
                  "PSA.42.9"
                ]
              }
            }
          ]
        },
        {
          "text": "alaga okwagala kwe emisana n'ekiro",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:8"
      },
      "items": [
        {
          "text": "ne muyimbira oluyimba lwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:8"
      },
      "items": [
        {
          "text": "y'essaala eri Katonda w'obulamu bwange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋŋamba Katonda, olwazi lwange nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "\"Lwaki onneerabidde?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "Lwaki ŋŋenda nkungubaga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "olw'okujoogebwa abalabe bange?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbonyaabonyezebwa ng'abalabe bange",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "bancocca,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "nga bwe bagamba buli kiseera nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
