      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:4"
      },
      "items": [
        {
          "text": "era n'akwagala n'okwagala okutaggwaawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.4",
            "verseOrgIds": [
              "PSA.103.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
