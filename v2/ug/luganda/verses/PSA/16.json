          "text": "Kubanga omwoyo gwange toliguleka magombe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:10"
      },
      "items": [
        {
          "text": "wadde okukkiriza Omutukuvu wo okuvunda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
