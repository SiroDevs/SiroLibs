      "attrs": {
        "style": "q2",
        "vid": "PSA 16:7"
      },
      "items": [
        {
          "text": "ne mu kiro ayigiriza omutima gwange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.7",
            "verseOrgIds": [
              "PSA.16.7"
            ]
          }
        }
