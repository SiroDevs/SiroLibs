      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:11"
      },
      "items": [
        {
          "text": "era mu mukono gwo ogwa ddyo nga mwe muli ebisanyusa emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
