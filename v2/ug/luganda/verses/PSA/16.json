        "vid": "PSA 16:5"
      },
      "items": [
        {
          "text": "era ggw'oliisa obulamu bwange; era ggw'olabirira ebyange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
