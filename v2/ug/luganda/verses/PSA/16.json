          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo omutima gwange gusanyuka, n'akamwa kange ne kajaguza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.9",
            "verseOrgIds": [
              "PSA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:9"
      },
      "items": [
        {
          "text": "era n'omubiri gwange gunaabeeranga mu mirembe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.9",
            "verseOrgIds": [
              "PSA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
