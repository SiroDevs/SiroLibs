    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Zabbuli ya Batabani ba Koola.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukube mu ngalo mmwe amawanga gonna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:1"
      },
      "items": [
        {
          "text": "muyimuse amaloboozi muyimbire nnyo Katonda ennyimba ez'essanyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.47.2",
                "verseOrgIds": [
                  "PSA.47.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ali Waggulu Ennyo wa ntiisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:2"
      },
      "items": [
        {
          "text": "Ye Kabaka afuga ensi yonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatujeemululira abantu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.3",
            "verseOrgIds": [
              "PSA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:3"
      },
      "items": [
        {
          "text": "n'atujeemululira amawanga ne tugafuga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.3",
            "verseOrgIds": [
              "PSA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatulondera omugabo gwaffe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:4"
      },
      "items": [
        {
          "text": "Yakobo gw'ayagala mwe yeenyumiririza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda alinnye waggulu ng'atenderezebwa mu maloboozi ag'essanyu eringi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.47.5",
                "verseOrgIds": [
                  "PSA.47.6"
                ]
              }
            }
          ]
        },
        {
          "text": "alinnye nga n'amakondeere gamuvugira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutendereze Katonda, mumutendereze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:6"
      },
      "items": [
        {
          "text": "Mumutendereze Kabaka waffe, mumutendereze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Katonda ye Kabaka w'ensi yonna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:7"
      },
      "items": [
        {
          "text": "mumutendereze ne Zabbuli ey'ettendo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda afuga amawanga gonna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.8",
            "verseOrgIds": [
              "PSA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:8"
      },
      "items": [
        {
          "text": "afuga amawanga ng'atudde ku ntebe ye entukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.8",
            "verseOrgIds": [
              "PSA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakungu bannaggwanga bakuŋŋanye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "ng'abantu ba Katonda wa Ibulayimu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "kubanga Katonda y'afuga abakulembeze b'ensi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "Katonda agulumizibwenga nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    }
