          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumutendereze nga mukuba ebitaasa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.5",
            "verseOrgIds": [
              "PSA.150.5"
            ]
