      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:4"
      },
      "items": [
        {
          "text": "mumutendereze n'ebivuga eby'enkoba n'endere!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.4",
            "verseOrgIds": [
              "PSA.150.4"
            ]
          }
        }
      ]
    },
    {
