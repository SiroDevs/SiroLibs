          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumutendereze n'ebitaasa n'amazina;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.4",
            "verseOrgIds": [
              "PSA.150.4"
            ]
          }
        }
