              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayiri ayogere nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.1",
            "verseOrgIds": [
              "PSA.129.1"
            ]
