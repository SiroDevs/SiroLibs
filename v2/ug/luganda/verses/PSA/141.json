        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 141",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zabbuli Ya Dawudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 141:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.141.1",
                "verseOrgIds": [
                  "PSA.141.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nkukaabira; oyanguwe okujja gye ndi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:1"
      },
      "items": [
        {
          "text": "Owulire eddoboozi lyange, nga nkukoowoola.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 141:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okusaba kwange kubeere ng'ebyakaloosa mu maaso go,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.2",
            "verseOrgIds": [
              "PSA.141.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:2"
      },
      "items": [
        {
          "text": "n'okugolola emikono gyange gy'oli kubeere nga ssaddaaka ey'akawungeezi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.2",
            "verseOrgIds": [
              "PSA.141.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 141:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onkuume, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.141.3",
                "verseOrgIds": [
                  "PSA.141.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", nneme okwasamya akamwa kange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:3"
      },
      "items": [
        {
          "text": "era bwe njogera onkomeko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 141:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okyuse omutima gwange guleme kugoberera kibi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "n'okwemalira mu bikolwa ebibi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "nneme okwetaba n'abantu abakola ebitali bya butuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "wadde okulya ku mmere yaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 141:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leka omuntu omutuukirivu ankube, kubanga anaaba ankwatiddwa ekisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "muleke annenye, ekyo kinaaba ng'amafuta amalungi agafukiddwa ku mutwe gwange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "sijja kugagaana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "Naye nnaasabanga bulijjo nga sikkiriziganya na babi wadde n'ebikolwa byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 141:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakola ebibi bwe baliweebwayo eri ab'okubasalira omusango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.6",
            "verseOrgIds": [
              "PSA.141.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:6"
      },
      "items": [
        {
          "text": "olwo ne balyoka bayiga nti ebigambo byange bya mazima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.6",
            "verseOrgIds": [
              "PSA.141.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 141:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balyogera nti, \"Ng'omuntu bw'akabala n'akuba amavuunike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.7",
            "verseOrgIds": [
              "PSA.141.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:7"
      },
      "items": [
        {
          "text": "n'amagumba gaffe bwe galisaasaanyizibwa bwe gatyo mu kamwa k'emagombe.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.7",
            "verseOrgIds": [
              "PSA.141.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 141:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nze amaaso ngatadde ku ggwe, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.141.8",
                "verseOrgIds": [
                  "PSA.141.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:8"
      },
      "items": [
        {
          "text": "mu ggwe mwe neekwese, tondeka nga sirina anambeera!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 141:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkuuma omponye omutego gwe banteze,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.9",
            "verseOrgIds": [
              "PSA.141.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:9"
      },
      "items": [
        {
          "text": "n'ebitimba by'abo abakola ebitali bya butuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.9",
            "verseOrgIds": [
              "PSA.141.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 141:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebitimba bye banteze abakola ebibi abo bonna, baleke babigwemu, kyokka nze mpone.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.10",
            "verseOrgIds": [
              "PSA.141.10"
            ]
          }
        }
      ]
    }
  ],
