          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.15.1",
                "verseOrgIds": [
                  "PSA.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ani anaabeeranga mu nnyumba yo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:1"
      },
      "items": [
        {
          "text": "Ani anaatuulanga ku lusozi lwo olutukuvu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo ataliiko kya kunenyezebwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:2"
      },
      "items": [
        {
          "text": "akola eby'obutuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 15:2"
      },
      "items": [
        {
          "text": "era ayogera eby'amazima nga biviira ddala mu mutima gwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olulimi lwe talwogeza bya bulimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 15:3"
      },
      "items": [
        {
          "text": "era mikwano gye tagiyisa bubi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:3"
      },
      "items": [
        {
          "text": "so tasaasaanya ŋŋambo ku baliraanwa be.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyooma ababi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "naye abatya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.15.4",
                "verseOrgIds": [
                  "PSA.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "abassaamu ekitiibwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "Atuukiriza ky'asuubiza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "ne bwe kiba nga kimulumya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'awola tasaba magoba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:5"
      },
      "items": [
        {
          "text": "so takkiriza kulya nguzi ku muntu yenna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 15:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 15:5"
      },
      "items": [
        {
          "text": "Oyo akola ebyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:5"
      },
      "items": [
        {
          "text": "aliba munywevu emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    }
