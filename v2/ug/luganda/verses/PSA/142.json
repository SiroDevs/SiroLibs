          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaabirira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.142.1",
                "verseOrgIds": [
                  "PSA.142.2"
                ]
              }
            }
          ]
        },
        {
          "text": "n'eddoboozi ery'omwanguka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:1"
      },
      "items": [
        {
          "text": "neegayirira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.142.1",
                "verseOrgIds": [
                  "PSA.142.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ansaasire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
