  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "59",
        "style": "c",
        "sid": "PSA 59"
      },
      "items": [
        {
          "text": "59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Ku ddoboozi, \"Tozikiriza.\" Zabbuli ya Dawudi, Sawulo bwe yatuma bakuume enju ya Dawudi bamutte.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 59:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda wange, mponya abalabe bange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.1",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:1"
      },
      "items": [
        {
          "text": "onnwanirire, abantu bwe bangolokokerako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.1",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 59:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omponye abakola ebitali bya butuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:2"
      },
      "items": [
        {
          "text": "era ondokole mu batemu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 59:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba banneekwekeredde nga banteega okunzita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:3"
      },
      "items": [
        {
          "text": "Abasajja ab'amaanyi abakambwe banneekobera, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.59.3",
                "verseOrgIds": [
                  "PSA.59.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:3"
      },
      "items": [
        {
          "text": "so nga soonoonye wadde okubaako ne kye nsobezza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 59:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sirina kye nsobezza, naye bateekateeka okunnumba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:4"
      },
      "items": [
        {
          "text": "Tunuulira obuzibu bwange, osituke, onnyambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 59:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.59.5",
                "verseOrgIds": [
                  "PSA.59.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye, Katonda wa Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:5"
      },
      "items": [
        {
          "text": "golokoka obonereze amawanga gonna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:5"
      },
      "items": [
        {
          "text": "abo bonna abasala enkwe tobasaasira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 59:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakomawo buli kiro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:6"
      },
      "items": [
        {
          "text": "nga babolooga ng'embwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:6"
      },
      "items": [
        {
          "text": "ne batambulatambula mu kibuga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 59:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba, bwe bavuma!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:7"
      },
      "items": [
        {
          "text": "Ebigambo biwamatuka mu kamwa kaabwe ng'ebitala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:7"
      },
      "items": [
        {
          "text": "nga boogera nti, \"Ani atuwulira?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 59:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ggwe, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.59.8",
                "verseOrgIds": [
                  "PSA.59.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", obasekerera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:8"
      },
      "items": [
        {
          "text": "era amawanga ago gonna oganyooma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 59:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda, Amaanyi gange, nnaakwesiganga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.9",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:9"
      },
      "items": [
        {
          "text": "era nnaakutenderezanga, kubanga ggwe kigo kyange ekinywevu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.9",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 59:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda wange anjagala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:10"
      },
      "items": [
        {
          "text": "anankulemberanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:10"
      },
      "items": [
        {
          "text": "ne ndyoka neeyagalira ku balabe bange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 59:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobatta, Ayi Mukama, engabo yaffe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "abantu bange baleme kwerabira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "mu buyinza bwo obungi, baleke batangetange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "n'oluvannyuma obakkakkanyize ddala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 59:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalala gaabwe n'ebyonoono ebiva mu kamwa kaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "n'ebigambo by'oku mimwa gyabwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "leka byonna bibatege ng'omutego.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "Kubanga bakolima era ne boogera eby'obulimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 59:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaleewo n'ekiruyi kyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:13"
      },
      "items": [
        {
          "text": "bamalirewo ddala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:13"
      },
      "items": [
        {
