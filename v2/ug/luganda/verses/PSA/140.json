            "sid": "PSA 140:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo byabwe byogi ng'ennimi z'emisota;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.3",
            "verseOrgIds": [
              "PSA.140.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:3"
      },
      "items": [
        {
          "text": "ebiva mu kamwa kaabwe busagwa ng'obw'essalambwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.3",
            "verseOrgIds": [
              "PSA.140.4"
            ]
          }
        }
      ]
    },
    {
