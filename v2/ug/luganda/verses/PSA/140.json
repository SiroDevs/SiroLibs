    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya mukulu w'okuyimba. Zabbuli ya Dawudi.",
          "type": "text"
        }
      ]
    },
    {
