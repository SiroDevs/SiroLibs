      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:2"
      },
      "items": [
        {
          "text": "abanoonya entalo buli kiseera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.2",
            "verseOrgIds": [
              "PSA.140.3"
            ]
          }
        }
      ]
    },
    {
