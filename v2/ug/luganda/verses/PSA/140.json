    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 140:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "abateesa mu mitima gyabwe okukola ebibi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.2",
            "verseOrgIds": [
              "PSA.140.3"
            ]
          }
        }
