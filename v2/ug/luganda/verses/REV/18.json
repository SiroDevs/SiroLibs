      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:22"
      },
      "items": [
        {
          "text": "tekuliwulirwa mu ggwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.22",
            "verseOrgIds": [
              "REV.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
