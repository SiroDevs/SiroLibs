      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "tekirirabikira mu ggwe nate,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "kubanga abasuubuzi be wasuubulanga nabo baamanyika nnyo mu nsi yonna,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "era walimbalimba amawanga gonna n'eby'obulogo bwo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
