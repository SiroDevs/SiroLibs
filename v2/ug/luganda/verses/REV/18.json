              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era mu Babulooni mwasangibwamu omusaayi gw'abatukuvu n'ogwa bannabbi,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.24",
            "verseOrgIds": [
              "REV.18.24"
            ]
          }
        }
