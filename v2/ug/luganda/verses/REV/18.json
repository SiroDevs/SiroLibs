          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitangaala ky'ettabaaza ng'eyaka",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
