            "number": "23",
            "style": "v",
            "sid": "2CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzziya n'afa, n'aziikibwa okumpi ne bajjajjaabe mu kiggya kya bakabaka, kubanga, yali mugenge. Yosamu mutabani we n'amusikira, bw'atyo n'afuga mu kifo kye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.23",
            "verseOrgIds": [
              "2CH.26.23"
