  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "2CH 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Omwoyo wa Katonda n'akka ku Azaliya mutabani wa Obedi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.1",
            "verseOrgIds": [
              "2CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'agenda n'asisinkana Asa n'amugamba nti, \"Mumpulirize, mmwe Asa, ne Yuda ne Benyamini mwenna,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.2",
            "verseOrgIds": [
              "2CH.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.2",
                "verseOrgIds": [
                  "2CH.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ali nammwe bwe muba mu ye. Bwe munaamunoonyanga, munaamulabanga, naye bwe munaamulekuliranga naye anaabalekuliranga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.2",
            "verseOrgIds": [
              "2CH.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayiri yamala ebbanga ddene nga tegondera Katonda ow'amazima, nga tebalina kabona abayigiriza, wadde okuba n'amateeka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye wakati mu nnaku yaabwe ne bakyukira",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.4",
                "verseOrgIds": [
                  "2CH.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Isirayiri, ne bamunoonya, era ne bamulaba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biro ebyo tewaali mirembe abantu okutambula nga bwe baayagalanga, kubanga baali mu kweraliikirira kungi nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.5",
            "verseOrgIds": [
              "2CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawanga n'amawanga gaalwanagananga, n'ebibuga ne birumbagananga kubanga Katonda yabaleetako ebizibu bingi nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.6",
            "verseOrgIds": [
              "2CH.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mmwe mugume omwoyo! Temuganya mikono gyammwe kunafuwa kubanga omulimu gwammwe guliko empeera.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.7",
            "verseOrgIds": [
              "2CH.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Asa bwe yawulira ebigambo ebyo, n'ebyobunnabbi bwa Azaliya mutabani wa Obedi, n'aguma omwoyo, n'aggyawo ebifaananyi ebyole okuva mu nsi yonna eya Yuda ne Benyamini, n'okuva mu bibuga bye yali awambye mu nsi ey'ensozi eya Efulayimu. N'addaabiriza ekyoto kya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.8",
                "verseOrgIds": [
                  "2CH.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyali mu maaso g'ekisasi ekya yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.8",
                "verseOrgIds": [
                  "2CH.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akuŋŋaanya aba Yuda n'aba Benyamini bonna, n'abantu b'e Efulayimu, n'e Manase, n'e Simyoni abaabeeranga nabo, kubanga bangi basenga gyali okuva mu Isirayiri bwe baalaba nga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.9",
                "verseOrgIds": [
                  "2CH.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ali wamu naye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bakuŋŋaanira e Yerusaalemi mu mwezi ogwokusatu mu mwaka ogw'ekkumi n'ettaano ogw'obufuzi bwa Asa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.10",
            "verseOrgIds": [
              "2CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo ne bawaayo eri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.11",
            "verseOrgIds": [
              "2CH.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.11",
                "verseOrgIds": [
                  "2CH.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ebimu ku by'omunyago: ente lusanvu, n'endiga n'embuzi zonna kasanvu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.11",
            "verseOrgIds": [
              "2CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne beeyama okunoonyanga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.12",
            "verseOrgIds": [
              "2CH.15.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.12",
                "verseOrgIds": [
                  "2CH.15.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Katonda wa bajjajjaabwe, n'omutima gwabwe gwonna, n'emmeeme yaabwe yonna.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.12",
            "verseOrgIds": [
              "2CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era abo bonna abatanoonyanga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
              "2CH.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.13",
                "verseOrgIds": [
                  "2CH.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Katonda wa Isirayiri battibwanga, oba bato oba bakulu, oba bakazi oba basajja.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
              "2CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne balayirira",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
              "2CH.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.14",
                "verseOrgIds": [
                  "2CH.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "mu ddoboozi ery'omwanguka, wamu n'okufuuwa amakondeere n'eŋŋombe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
              "2CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda yonna ne basanyukira ekirayiro ekyo, kubanga baali balayidde n'omutima gwabwe gwonna, era nga bamunoonyezza n'okwagala kwabwe kwonna, ne bamulaba. Era",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.15",
                "verseOrgIds": [
                  "2CH.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "n'abawa emirembe enjuuyi zonna.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka Asa n'agoba jjajjaawe Maaka ku bwannamasole kubanga yali akoze ekifaananyi ekyole ekya Asera. Asa n'akitemaatema n'akimenyaamenya, n'akyokera mu kagga Kidulooni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.16",
            "verseOrgIds": [
              "2CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde nga teyaggyawo bifo ebigulumivu mu Isirayiri, Asa yamalirira mu mutima gwe okunywerera ku",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.17",
            "verseOrgIds": [
              "2CH.15.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.17",
                "verseOrgIds": [
                  "2CH.15.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ennaku ze zonna.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.17",
            "verseOrgIds": [
              "2CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.18",
            "verseOrgIds": [
              "2CH.15.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.18",
                "verseOrgIds": [
                  "2CH.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "n'aleetamu effeeza ne zaabu, n'ebintu ye ne kitaawe bye baawonga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.18",
            "verseOrgIds": [
              "2CH.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne wataba ntalo nate okumala emyaka amakumi asatu mu etaano egy'obufuzi bwa Asa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.19",
            "verseOrgIds": [
              "2CH.15.19"
            ]
          }
        }
      ]
    }
  ],
