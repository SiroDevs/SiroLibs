  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "2CH 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akazi Kabaka wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazi yali wa myaka amakumi abiri we yaliira obwakabaka, n'afugira emyaka kkumi na mukaaga mu Yerusaalemi. Naye obutafaanana nga jjajjaawe Dawudi, yakola ebitali bya butuukirivu mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.1",
            "verseOrgIds": [
              "2CH.28.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.1",
                "verseOrgIds": [
                  "2CH.28.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.1",
            "verseOrgIds": [
              "2CH.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'atambulira mu makubo ga bassekabaka ba Isirayiri, n'okukola n'akola ebifaananyi ebisaanuuse ebyakozesebwanga mu kusinza Baali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.2",
            "verseOrgIds": [
              "2CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayoterezanga obubaane mu kiwonvu kya mutabani wa Kinomu, n'awaayo batabani be okuba ebiweebwayo ebyokebwa, ng'agoberera emizizo gy'abannaggwanga,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.3",
                "verseOrgIds": [
                  "2CH.28.3"
                ]
              }
            }
          ]
        },
        {
          "text": "be yagoba mu maaso g'Abayisirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'awangayo ssaddaaka wamu n'okwoterezanga obubaane mu bifo ebigulumivu, ne ku ntikko z'ensozi, ne wansi wa buli muti omubisi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.4",
            "verseOrgIds": [
              "2CH.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.5",
                "verseOrgIds": [
                  "2CH.28.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda we kyeyava amuwaayo mu mukono gwa kabaka w'e Busuuli, eyamuwangula n'atwala abantu ba Yuda bangi nga basibe, n'abaleeta e Ddamasiko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 28:5"
      },
      "items": [
        {
          "text": "Ate era yaweebwayo ne mu mukono gwa kabaka wa Isirayiri, eyaleeta ku bantu ba Yuda ebisago ebinene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peka mutabani wa Lemaliya yatta abaserikale ba Yuda emitwalo kkumi n'ebiri mu lunaku lumu, kubanga baali bavudde ku",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.6",
                "verseOrgIds": [
                  "2CH.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa bajjajjaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Zikuli, omusajja omulwanyi omuzira owa Efulayimu n'atta Maaseya mutabani wa kabaka, ne Azulikamu omukulu w'olubiri ne Erukaana omukungu, addirira kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.7",
            "verseOrgIds": [
              "2CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayisirayiri ne bawamba abakyala, n'abaana aboobulenzi, n'aboobuwala, emitwalo amakumi abiri ku baganda baabwe, ne babatwala nga basibe e Samaliya, ate ne babatwalako n'omunyago mungi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
              "2CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Odedi nnabbi wa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.9",
                "verseOrgIds": [
                  "2CH.28.9"
                ]
              }
            }
          ]
        },
        {
          "text": "eyali eyo n'agenda okusisinkana eggye eryali lijja e Samaliya, n'abagamba nti, \"Laba, kubanga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.9",
                "verseOrgIds": [
                  "2CH.28.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa bajjajjammwe yasunguwalira Yuda, kyeyava abawaayo mu mukono gwammwe, kyokka mubasse n'ekiruyi n'okutuuka ne kituuka mu ggulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano, abasajja n'abakazi aba Yuda ne Yerusaalemi mumaliridde, okubafuula abaddu bammwe. Naye bwe mmwekebera, temulina kye mwali musobezza",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.10",
                "verseOrgIds": [
                  "2CH.28.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nno, mumpulirize, muleke baganda bammwe be muwambye baddeyo ewaabwe, kubanga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.11",
                "verseOrgIds": [
                  "2CH.28.11"
                ]
              }
            }
          ]
        },
        {
          "text": "abasunguwalidde mmwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abamu ku bakadde ba Efulayimu, Azaliya mutabani wa Yokanaani, ne Berakiya mutabani wa Mesiremosi, ne Yekizukiya mutabani wa Sallumu, ne Amasa mutabani wa Kadalayi, ne bayimirira okuziyiza abo abaali bava mu lutalo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.12",
            "verseOrgIds": [
              "2CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne babagamba nti, \"Temujja kuleeta basibe abo wano, kubanga mujja kutuleetako omusango eri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.13",
                "verseOrgIds": [
                  "2CH.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nga mwongereza ku kibi ne ku musango bye tulina. Omusango gwaffe munene, n'obusungu bwe buli ku Isirayiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abaserikale ne basumulula abasibe, n'omunyago ne baguwaayo mu maaso g'abakungu n'ekibiina kyonna.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.14",
            "verseOrgIds": [
              "2CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne balonda abasajja abaatwala abasibe ne baggya engoye mu munyago ne bambaza abo bonna abaali obwereere, ne babawa engoye endala, n'engatto, ne babawa emmere n'ekyokunywa, ne babanyiga n'ebiwundu. N'abaali abanafu ennyo bonna ne babasitulira ku ndogoyi, ne babazzaayo eri baganda baabwe e Yeriko, ekibuga eky'enkindu, bo ne bakomawo e Samaliya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu biro ebyo kabaka Akazi n'asaba kabaka w'e Bwasuli amuyambe,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.16",
            "verseOrgIds": [
              "2CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubanga Abayedomu baali bazeemu okulumba Yuda, ne batwala abantu mu busibe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.17",
            "verseOrgIds": [
              "2CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera kyekimu Abafirisuuti baali balumbye ebibuga eby'omu nsenyi n'eby'omu bukiikaddyo obwa Yuda, nga bawambye Besusemesi, ne Ayalooni, ne Gederosi, ne Soko, ne Timuna, ne Gimuzo n'ebyalo ebyali byetoolodde ebibuga ebyo, era ng'omwo mwe babeera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.18",
            "verseOrgIds": [
              "2CH.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.19",
                "verseOrgIds": [
                  "2CH.28.19"
                ]
              }
            }
          ]
        },
        {
          "text": "yakkakkanya nnyo Yuda olw'ebibi n'obutali bwesigwa bwa Akazi kabaka wa Isirayiri eri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.19",
                "verseOrgIds": [
                  "2CH.28.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", Akazi bye yakola mu Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tirugazupiruneseri kabaka w'e Bwasuli n'ajja gy'ali, n'amucocca mu kifo eky'okumuyamba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.20",
            "verseOrgIds": [
              "2CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazi n'aggya ebimu ku bintu ebyali mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.21",
                "verseOrgIds": [
                  "2CH.28.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", ne ku ebyo ebyali mu lubiri lwa kabaka, ne ku bya balangira n'abiwa kabaka w'e Bwasuli; naye ekyo ne kitamuyamba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo kabaka Akazi we yalabira ennyo ennaku, yeeyongera obutaba mwesigwa eri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.22",
            "verseOrgIds": [
              "2CH.28.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.22",
                "verseOrgIds": [
                  "2CH.28.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.22",
            "verseOrgIds": [
              "2CH.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'awangayo ssaddaaka eri bakatonda b'e Ddamasiko, abaali bamuwangudde, kubanga yalowooza nti, \"Engeri bakatonda ba bakabaka b'e Busuuli bwe babayambye, nnaawaayo ssaddaaka gye bali, nange bannyambe.\" Naye okwo kwe kwali okuzikirira kwe n'okwa Isirayiri yenna.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.23",
            "verseOrgIds": [
              "2CH.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazi n'akuŋŋaanya ebintu eby'omu yeekaalu ya Katonda, n'abiggyamu, n'aggalawo enzigi za yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.24",
                "verseOrgIds": [
                  "2CH.28.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", ne yeezimbira ebyoto mu buli nsonda mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu buli kibuga kya Yuda n'azimbamu ebifo ebigulumivu okuwerangayo ssaddaaka eri bakatonda abalala, n'asunguwaza",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.25",
                "verseOrgIds": [
                  "2CH.28.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa bajjajjaabe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyafaayo ebirala eby'omu mulembe gwe n'empisa ze zonna, okuva ku ntandikwa okutuusa ku nkomerero, byawandiikibwa mu kitabo kya bassekabaka ba Yuda ne Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.26",
            "verseOrgIds": [
              "2CH.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazi n'afa n'aziikibwa mu kibuga kya Yerusaalemi, naye si mu masiro ga bassekabaka ba Isirayiri. Keezeekiya mutabani we n'amusikira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.27",
            "verseOrgIds": [
              "2CH.28.27"
            ]
          }
        }
      ]
