              "items": [
                {
                  "text": "Luk 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo aikiriza Mwana ali n'obulamu obutawaagho aye aloba okwikiriza Mwana taja kufuna bulamu, era aja kusigala ng'abonerezebwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
          }
        }
