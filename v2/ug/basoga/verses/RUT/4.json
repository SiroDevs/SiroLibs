              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano ni baidhukulu ba Perezi: Perezi n'eyazaala Hezironi, Hezironi yaazaala Ramu, Ramu yaazaala Amminadabu, Amminadabu yaazaala Nahashoni, Nahashoni yaazaala Salumoni, Salumoni yaazaala Boazi, Boazi yaazaala Obedi, Obedi yaazaala Yesse, Yesse yaazaala Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.18+RUT.4.19+RUT.4.20+RUT.4.21+RUT.4.22",
            "verseOrgIds": [
              "RUT.4.18",
              "RUT.4.19",
