              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo yaakoba Daudi ati: “Mwana wange Daudi, Musengwa Katonda akughenga enkabi. Oidha kubanga mughanguzi mu byonabyona by'onaakolanga.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
