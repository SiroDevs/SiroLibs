              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boonaboona mu kikunsu kya Yuda bali emitwalo ikumi na munaana na kakaaga na bina (186,400), era n'abanaasookanga okutambula.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
