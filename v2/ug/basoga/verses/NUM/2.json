          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Abaisiraeli baakola byonabyona Musengwa Katonda bye yalagira Musa. Baasimbanga weema dhaibwe aghali bendera dhaibwe, era baatambulanga, nga buli muntu ajiira mu kika kye ni mu nda ya ise.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.34",
            "verseOrgIds": [
              "NUM.2.34"
            ]
