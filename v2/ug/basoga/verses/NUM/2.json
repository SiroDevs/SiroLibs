              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boonaboona mu kikunsu kya Dani bali emitwalo ikumi n'etaanu na kasanvu na lukaaga (157,600), era n'abanaasembangayo mu kutambula. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.31",
            "verseOrgIds": [
              "NUM.2.31"
            ]
          }
