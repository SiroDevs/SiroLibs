          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo n'Abaisiraeli abaabalibwa nga bajiira ku nda dhaibwe ni ku bikunsu byaibwe. Baali emitwalo nkaaga n'enkumi isatu na bitaanu n'ataanu (603,550). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.32",
            "verseOrgIds": [
              "NUM.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nga Musengwa Katonda bweyalagira Musa, Abalevi tibaabalirwa ghalala na Baisiraeli bandi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.33",
            "verseOrgIds": [
              "NUM.2.33"
            ]
          }
        }
      ]
    },
