            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ebikunsu ebyo ebibiri nga bitooleire okutambula, Abalevi boona baidha kutambulanga nga babbeedie Weema ey'Okwagaananirangamu ni Musengwa Katonda, nga bali ghagati ghe bikunsu ebibiri ebisooka n'ebibiri ebiiraku. Ebikunsu biidha kutambulanga nga bijiira ku nsambo ye biiraganwaku mu kifo ghe basimba weema, nga buli kikunsu kinonereza bendera yaakyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
            "verseOrgIds": [
              "NUM.2.17"
            ]
          }
        }
      ]
