        },
        {
          "text": "Agho Musengwa Katonda yaakoba Musa ni Aaroni ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.1",
            "verseOrgIds": [
              "NUM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisiraeli baidha kusimbanga weema dhaibwe okwezungulula Weema ey'Okwagaananirangamu ni Musengwa Katonda, nga bagiringiriiza. Buli muntu aidha kusimbanga weema ye aghali bendera y'ekikunsu kye era aghali obumanhiso obw'abantu ab'enda ye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        }
      ]
    },
