          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ab'ebendera ey'ekikunsu eky'ekika kya Dani, abaasembayo einhuma w'ebikunsu byonabyona, batoolera okutambula nga boona bali mu bikunsu byaibwe. Ahiezeri mutabane wa Ammishaddai nga n'ali kubakulembera. Abo nga n'abakola ng'abakuumi b'ebikunsu byonabyona nga babiva einhuma. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.25",
            "verseOrgIds": [
              "NUM.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pagieli mutabane wa Okurani yaakulembera ekikunsu eky'ekika kya Asheri, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.26",
            "verseOrgIds": [
              "NUM.10.26"
            ]
          }
        },
        {
