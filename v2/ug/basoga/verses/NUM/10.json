          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bwe baalekeranga okugitambuza, ng'akoba ati: “Wo Musengwa Katonda, ira obe mu nkumi n'enkumi edh'Abaisiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
            "verseOrgIds": [
              "NUM.10.36"
            ]
          }
