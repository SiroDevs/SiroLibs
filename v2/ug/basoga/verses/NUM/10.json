          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ab'ebendera ey'ekikunsu eky'ekika kya Efuraimu, bairaku okutambula nga boona bali mu bikunsu byaibwe. Elishama mutabane wa Ammihudi nga n'ali kubakulembera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.22",
            "verseOrgIds": [
              "NUM.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamalieli mutabane wa Pedahazuri yaakulembera ekikunsu eky'ekika kya Manasse, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.23",
            "verseOrgIds": [
              "NUM.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ate Abidani mutabane wa Gideoni yaakulembera ekikunsu eky'ekika kya Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.24",
            "verseOrgIds": [
              "NUM.10.24"
            ]
          }
        }
      ]
    },
