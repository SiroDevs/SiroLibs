          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ab'ekika eky'Abalevi abasimuka mu Kohathi baatoolera okutambula nga babbeedie ebintu ebitukuvu. Era baajanga okutuuka mu kifo eky'okusimbamu weema edh'abantu, nga Eweema ey'Okwagaananirangamu ni Musengwa Katonda yaweire ira okusimbwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
            "verseOrgIds": [
              "NUM.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
