              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.33",
            "verseOrgIds": [
              "NUM.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Balaamu yaakoba malaika wa Musengwa ati: “Nhonoine, kuba mbaire timanhie nga niiwe weekiise mu ngira okundobera okuja. Aye mpegaano oba nga kiba kibi y'oli nze okuja, ka nkyuke ndhireyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.34",
            "verseOrgIds": [
              "NUM.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye malaika wa Musengwa Katonda yaamukoba ati: “Ja n'abasaadha abo, aye kye nnaakukoba okwogera kyonka ky'onaayogera.” Kale Balaamu yeeyongerayo, yaaja n'abakwenda ba Balaki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
