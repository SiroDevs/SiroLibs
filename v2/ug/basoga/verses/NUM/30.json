              "NUM.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omughala akaali kubayira, ng'akaali mu maka g'abazaire be, bw'aneeyamanga okugha Musengwa Katonda ekintu, oba n'akola ekirayiro ekimusiba, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.3",
            "verseOrgIds": [
              "NUM.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "memale ise n'awulira obweyamo obwo n'ekirayiro ekyo, aye n'abula ky'amutakaniamu, olwo omughala oyo aidha kuteekwanga buteekwe okutuukiriza ky'asuubiiza. Taakimenhengagho naire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.4",
            "verseOrgIds": [
              "NUM.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ise oyo bw'anaatakanianga obweyamo obwo n'ekirayiro ekyo ku lunaku lw'abiwuliire, omughala oyo taavunaanizibwenga kubituukiriza. Era Musengwa Katonda aidha kumusonighanga, kuba ise n'amulobeire okubituukiriza.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye kisoboka omughala oyo yaaja okufumbirwa ng'ate akaali kutuukiriza kye yeeyama, k'abe nga yeeyama mu bugenderevu oba mu butali bugenderevu, oba kyaba nti afumbiirwa ng'akaali kutuukiriza kirayiro kye yalayira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.6",
            "verseOrgIds": [
              "NUM.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe kibanga kityo, memale iba n'awulira obweyamo obwo n'ekirayiro ekyo aye n'abula ky'amutakaniamu, olwo omughala oyo aidha kuteekwanga buteekwe okutuukiriza ky'asuubiiza. Taakimenhengagho naire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.7",
            "verseOrgIds": [
              "NUM.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye iba bw'anaamuloberanga ku lunaku lw'abiwuliire, olwo anaabanga ng'amenhiegho obweyamo mukazi we oyo bwe yakola, ka bube mu bugenderevu oba mu butali bugenderevu. Era anaabanga ng'amenhiegho n'ekirayiro mukazi we oyo kye yalayira. Era Musengwa Katonda aidha kusonighanga omukazi oyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye namwandu oba omukazi eyayawukana n'iba, aidha kuteekwanga buteekwe okutuukiriza obweyamo bwe oba ekirayiro kye. Taakimenhengagho naire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bw'anaabanga ng'aliku kye yeeyama oba kye yalayira nga mufumbo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.10",
            "verseOrgIds": [
              "NUM.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "era nga iba yakiwulira aye yaabula ky'amutakaniamu okumulobera, olwo omukazi oyo aidha kuteekwanga buteekwe okutuukiriza ky'asuubiiza. Taakimenhengagho naire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.11",
            "verseOrgIds": [
              "NUM.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye iba bw'anaabimuloberanga n'abisazaamu ku lunaku lw'abiwuliire, olwo byonabyona omukazi oyo bye yayogera eby'obweyamo bwe oba eby'ekirayiro kye yasuubiza okubaaku ekintu ky'aneerumyamu, binaabanga nga tibikaamufuga. Era Musengwa Katonda aidha kumusonighanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iba w'omukazi oyo asobola okukakasa oba okumenhagho obweyamo n'endagaano omukazi oyo yaaba ng'akoze ng'alayira okubaaku ekintu ky'aneerumyamu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.13",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye bweghabitagho enaku nga iba oyo azira ky'amukobye, olwo anaabanga ng'akakaisa byonabyona mukazi we bye yeeyama ni bye yalayira; kuba okuva lwe yabiwulira azira kye yamukobaku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.14",
            "verseOrgIds": [
              "NUM.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate bw'anaamalanga n'abimenhagho nga ghabiseegho enaku bukyanga abiwulira, olwo mwene n'anaavunaanibwanga omusango gwa mukazi we ogw'obutabituukiriza.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago n'amateeka Musengwa Katonda ge yagha Musa agagema ku bweyamo ni ku birayiro omukazi ali n'iba by'akola, era agagema ni ku mughala akaali kubayira ng'akaali mu maka g'abazaire be.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.16"
            ]
          }
        }
      ]
    }
  ],
