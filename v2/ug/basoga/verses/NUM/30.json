              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musa yaakobera abakulu ab'ebika ebya Abaisiraeli ati: “Bino Musengwa Katonda by'alagiire: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaadha bw'aneeyamanga okugha Musengwa Katonda ekintu, oba n'akola ekirayiro ekimusiba, aidha kuteekwanga buteekwe okutuukiriza ky'asuubiiza. Taakimenhengagho naire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
        {
          "name": "note",
