            "sid": "NUM 33:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava e Moserothi, baaja baasimba weema dhaibwe e Bene Yaakani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.31",
            "verseOrgIds": [
              "NUM.33.31"
            ]
          }
