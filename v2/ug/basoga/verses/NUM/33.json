          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava e Hori Haggidigadi, baaja baasimba weema dhaibwe e Yotubatha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.33",
            "verseOrgIds": [
