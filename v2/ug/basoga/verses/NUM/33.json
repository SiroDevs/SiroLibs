          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava e Kadeshi, baaja baasimba weema dhaibwe ku lusozi Hori, ku mbali okw'ekiketezo eky'Abaedomu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.37",
