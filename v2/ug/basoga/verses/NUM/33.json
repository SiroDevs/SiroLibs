            }
          ]
        },
        {
          "text": "Baava e Bene Yaakani, baaja baasimba weema dhaibwe e Hori Haggidigadi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.32",
            "verseOrgIds": [
