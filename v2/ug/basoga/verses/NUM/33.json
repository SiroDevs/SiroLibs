              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Abaisiraeli baasitula okuva ku lusozi Hori, baaja baasimba weema dhaibwe e Zalumona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.41",
            "verseOrgIds": [
              "NUM.33.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 33:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava e Zalumona, baaja baasimba weema dhaibwe e Punoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.42",
            "verseOrgIds": [
              "NUM.33.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 33:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava e Punoni, baaja baasimba weema dhaibwe mu Obothi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.43",
            "verseOrgIds": [
              "NUM.33.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 33:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava mu Obothi, baaja baasimba weema dhaibwe mu kifo ekyetebwa Iye Abarimu, mu biketezo bya Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.44",
            "verseOrgIds": [
              "NUM.33.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 33:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava mu kifo ekyetebwa Iyimu, baaja baasimba weema dhaibwe e Diboni Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.45",
            "verseOrgIds": [
              "NUM.33.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 33:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava e Diboni Gadi, baaja baasimba weema dhaibwe mu Alumoni Dibulathaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.46",
            "verseOrgIds": [
              "NUM.33.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 33:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava mu Alumoni Dibulathaimu, baaja baasimba weema dhaibwe mu nsozi edh'e Abarimu, ng'olingiriire Nebo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.47",
            "verseOrgIds": [
              "NUM.33.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 33:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava mu nsozi edh'e Abarimu, baaja baasimba weema dhaibwe e Yeriko mu biketezo by'e Moabu eby'oku museetwe, okuliiraana Yorudani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.48",
            "verseOrgIds": [
              "NUM.33.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 33:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasimba weema dhaibwe okumpi n'omwiga Yorudani, okuva e Bethi Yeshimothi okutuukira irala mu Abeli Shittimu, mu biketezo by'e Moabu eby'oku museetwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
            "verseOrgIds": [
              "NUM.33.49"
            ]
          }
        }
      ]
