          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava e Tera, baaja baasimba weema dhaibwe e Mithuka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.28",
            "verseOrgIds": [
              "NUM.33.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava e Mithuka, baaja baasimba weema dhaibwe e Hashimona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.29",
            "verseOrgIds": [
              "NUM.33.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava e Hashimona, baaja baasimba weema dhaibwe e Moserothi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.30",
            "verseOrgIds": [
              "NUM.33.30"
            ]
          }
        },
        {
