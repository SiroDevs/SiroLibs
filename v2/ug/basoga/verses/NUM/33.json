          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava mu Ezioni Geberi, baaja baasimba weema dhaibwe mu irungu ery'e Zini, ekyo nga ni Kadeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.36",
            "verseOrgIds": [
              "NUM.33.36"
            ]
