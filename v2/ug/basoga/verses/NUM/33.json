          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava mu Aburona, baaja baasimba weema dhaibwe mu Ezioni Geberi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.35",
            "verseOrgIds": [
              "NUM.33.35"
            ]
          }
        },
        {
