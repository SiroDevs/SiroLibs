              "type": "text"
            },
            {
              "text": "Kiburothi Hattaava:",
              "type": "text"
            },
            {
              "text": "Kub 11:34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
