            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.9",
            "verseOrgIds": [
              "NUM.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasitula okuva mu Elimu, baaja baasimba weema dhaibwe kumpi n'Enhandha Emyufu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.10",
            "verseOrgIds": [
              "NUM.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava agho okumpi n'Enhandha Emyufu, baaja baasimba weema dhaibwe mu irungu ery'e Sini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.11",
            "verseOrgIds": [
              "NUM.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava agho mu irungu ery'e Sini, baaja baasimba weema dhaibwe e Dofuka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.12",
            "verseOrgIds": [
              "NUM.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava e Dofuka, baaja baasimba weema dhaibwe mu Alushi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.13",
            "verseOrgIds": [
              "NUM.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava mu Alushi, baaja baasimba weema dhaibwe e Refidimu etaali maadhi bantu ge baghanga kunhwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.14",
            "verseOrgIds": [
              "NUM.33.14"
            ]
          }
        }
      ]
    },
