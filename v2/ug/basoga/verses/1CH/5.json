                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.3+GEN.49.4"
              },
              "items": [
                {
                  "text": "49:3-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bano n'abaana n'abaidhukulu aba Reubeni omwana omuberi owa Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.1",
            "verseOrgIds": [
              "1CH.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:1",
              "type": "text"
            },
            {
              "text": "Isiraeli:",
              "type": "text"
            },
            {
              "text": "Aghandi bamweta Yakobo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aye waire nga Reubeni oyo n'eyali omwana omuberi, omugabo gwe ogw'omwana omuberi baagumutoolaku, baagugha abaana ba Yosefu muganda we kuba Reubeni oyo yaba n'owundi ku baka lata we Yakobo mu buliri. Kale mu lukalala olw'obuzaale tiyaghandiikibwa ghe yandibaire ng'omwana omuberi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.1",
            "verseOrgIds": [
              "1CH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.8+GEN.49.9+GEN.49.10"
              },
              "items": [
                {
                  "text": "Mainh 49:8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu butuufu, waire nga Yuda yafuuka ow'amaani mu baganda be boonaboona, era waire nga mu kika kye mwavaamu omukulembeze, aye era obukulu obw'okuzaalibwa bwasigala nga bwa Yosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.2",
            "verseOrgIds": [
              "1CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reubeni oyo omwana omuberi owa Isiraeli yazaala: Hanoka, ni Pallu, ni Hezironi, ni Karumi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.3",
            "verseOrgIds": [
              "1CH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.3",
            "verseOrgIds": [
              "1CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano ni baidhukulu ba Yoeli: Shemaia yazaala Gogi, Gogi yaazaala Shimei, Shimei ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
              "1CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaazaala Mika, Mika yaazaala Reaya, Reaya yaazaala Baali, Baali ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaazaala Beera, kyabazinga Tigulathi Piluneseri ow'e Assiria ye yatwala mu bunhage. Beera oyo n'eyali akulira abasimuka mu Reubeni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.29"
              },
              "items": [
                {
                  "text": "2 Bakyab 15:29",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkalala dhooleka ng'abakulira enda edhiri mu kika kya Reubeni ni bano: Yeieli, ni Zekaria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
            "verseOrgIds": [
              "1CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni Bela mutabane wa Azazi, Azazi mutabane wa Shema, Shema mutabane wa Yoeli. Baidhukulu ba Reubeni abo baabanga mu kiketezo ekiva mu Aroeri okutuukira irala e Nebo n'e Baali Meoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu buvandhuba baali mu kiketezo ekyali okuva eirungu ghe liinhamira, okutuukira irala ku mwiga Eufurate kuba ebyayo byaibwe byali nga byeyongeire inho obungi mu kiketezo ky'e Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biseera bya kyabazinga Saulo, Abareubeni abo baalwana n'Abahagari mu lutalo baabaita, era baasenga mu kiketezo kyaibwe ekiri ku luuyi lw'e buvandhuba wa Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'ekika kya Gadi baasenga ku luuyi olw'omukono omugooda olw'e buvandhuba w'Abareubeni, okuva e Bashani okutuukira irala e Saleka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.11",
            "verseOrgIds": [
              "1CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoeli nga n'abakulira, kwairaku Shafamu, kwairaku Yanai ni Shafati mu Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.12",
            "verseOrgIds": [
              "1CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baganda baibwe ng'ojiira ku nda dha baiseibwe ni bano: Mikaeli, Meshullamu, Sheba, Yorai, Yakani, Zia, ni Eberi. Boonaboona n'abantu omusanvu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo baali baidhukulu ba Abihaili mutabane wa Huri, Huri yaaba mutabane wa Yaroa, Yaroa yaaba mutabane wa Gileadi, Gileadi yaaba mutabane wa Mikaeli, Mikaeli yaaba mutabane wa Yeshishai, Yeshishai yaaba mutabane wa Yahudo, Yahudo yaaba mutabane wa Buzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahi mutabane wa Abudieli era mwidhukulu wa Guni, n'eyali akulira enda dha baiseibwe edho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.15",
            "verseOrgIds": [
              "1CH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagadi baabanga mu kiketezo ky'e Gileadi n'eky'e Bashani, mu bibuga byayo byonabyona ni mu biketezo eby'e Sharoni byonabyona ebyalimu ebyayiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.16",
            "verseOrgIds": [
              "1CH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boonaboona baaghandiikibwa mu nkalala ng'obuzaale bwaibwe bwe bwali, mu biseera kyabazinga Yothamu bye yafugiramu Buyudaaya, ni mu biseera kyabazinga Yeroboamu Owokubiri bye yafugiramu Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekika kya Reubeni, n'ekya Gadi, n'ekitundu ku kika kya Manasse, byonabyona aghalala byali n'abalwani abaziramu ntete emitwalo ena n'enkumi ina na lusanvu na nkaaga (44,760) nga bali n'obumanhirivu mu kukozesa engabo, n'empiima, n'obulaso, era nga baatendekebwa bukalamu mu kulwana entalo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.18",
            "verseOrgIds": [
              "1CH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho baaja baatanula olutalo ku Bahagari, ni ku Bayeturi, ni ku Banafishi, ni ku Banodabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.19",
            "verseOrgIds": [
              "1CH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baata obwesige mu Musengwa Katonda nga bamusaba ababeere, era yaababeera yaabaleetera okughangula Abahagari ghalala ni boonaboona abaali nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.20",
            "verseOrgIds": [
              "1CH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baanhaga ku bazigu abo engamiya emitwalo etaanu (50,000), entaama emitwalo amakumi abiri n'etaanu (250,000), n'endogoyi enkumi ibiri (2,000), era baatwala n'abasibe emitwalo ikumi (100,000). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.21",
            "verseOrgIds": [
              "1CH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era baita mu bazigu abo abantu kamaala, kuba Katonda n'eyalwana olutalo olwo. Baaba mu biketezo ebyo nga babyefuze, okutuusa lwe baatwalibwa mu bunhage.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.22",
            "verseOrgIds": [
              "1CH.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.22",
            "verseOrgIds": [
              "1CH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitundu ku kika eky'Abamanasse baaja nga beeyongerera irala obungi, baabanga mu kiketezo eky'ensi eyo, okuva e Bashani okutuukira irala e Baali Herimoni, n'e Seniri, ni ku lusozi Herimoni. ",
          "type": "text",
          "attrs": {
