              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luno n'olukalala olw'abaakuliranga ebika bya Isiraeli:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
