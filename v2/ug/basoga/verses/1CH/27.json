                  "text": "26:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kyabazinga Daudi tiyabala bantu abakaali okutuusa emyaka amakumi abiri egy'obukulu, kuba Musengwa Katonda yali amaze okusuubiza ng'aja kuleetera Abaisiraeli babe kamaala inho ng'oti n'emuunienie edh'oku igulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu mutabane w'omukazi eyayetebwanga Zeruia, yatoolera okubala abantu, aye yaaloba kusobola kumaliriza. Okubala okwo kwaleetera Musengwa Katonda okusungughalira Isiraeli, era omughendo gwe baabala tibaagughandiika mu kitabo eky'Ebyomubyanda bya kyabazinga Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boonaboona n'abaalabiriranga ebintu bya kyabazinga Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonathani, muganda wa lata wa Daudi, yali muwi wa magezi, nga musaadha mutegeevu era nga mumanhi inho mu by'amateeka. Yonathani oyo ni Yehieli mutabane wa Hakimoni, n'abaalabiriranga batabane ba kyabazinga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
            "verseOrgIds": [
              "1CH.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahithofeli yali muwi wa magezi wa kyabazinga, ate Hushai Omuaraki yaaba mukagwa wa kyabazinga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahithofeli bwe yavaagho, Abiathari ni Yehoiada mutabane wa Benaia baira mu kifo kye. Yoabu n'eyali omuduumizi w'eigye lya kyabazinga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.34",
            "verseOrgIds": [
              "1CH.27.34"
            ]
          }
        }
      ]
    }
