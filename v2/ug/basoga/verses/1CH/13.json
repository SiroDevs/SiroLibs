              "1CH.13.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2MA.7.19"
              },
              "items": [
                {
                  "text": "2 Bamak 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ku lunaku olwo Daudi yaatya inho Musengwa Katonda, yaakoba ati: “Nnaasobola ntya okutwala Sanduuku ya Musengwa Katonda eno ey'Endagaano ewange?” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.12",
            "verseOrgIds": [
              "1CH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Daudi yaaloba kuganha kutwala Sanduuku ya Musengwa Katonda mu kibuga kye ekyetebwa ekya Daudi. Aye baagonhoka, baagitwala mu ndhu ya Obedi Edomu ow'e Gathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.13",
            "verseOrgIds": [
              "1CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.4+1CH.26.5"
              },
              "items": [
                {
                  "text": "1 Byom 26:4-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Esanduuku ya Katonda eyo yaamala emyezi esatu n'ab'omu ndhu ya Obedi Edomu, era Musengwa Katonda yaagha enkabi Obedi Edomu oyo, n'ab'omu ndhu ye, n'ebintu bye yali nabyo byonabyona.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        }
      ]
    }
