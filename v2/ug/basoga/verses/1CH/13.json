              "1CH.13.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.1+1SA.7.2"
              },
              "items": [
                {
                  "text": "1 Sam 7:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Agho Daudi yaasoloza Abaisiraeli boonaboona, okuva e Shihori ku nsalosalo ni Misiri okutuuka aghaingirirwa e Hamathi, baje batooleyo Esanduuku y'Endagaano eya Katonda e Kiriathi Yearimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.5",
            "verseOrgIds": [
              "1CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.22"
              },
              "items": [
                {
                  "text": "Kuv 25:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kale Daudi yaasituka n'Abaisiraeli boonaboona, baaja e Baala, ekyo nga ni Kiriathi Yearimu eky'omu kiketezo kya Yuda, baaja okutoolayo Esanduuku ey'Endagaano ya Katonda eyetebwa eriina lya Musengwa Katonda, oyo atyama ku kityamo kye eky'obwakyabazinga ekiri ku bitonde ebiri n'amaghagha ebyetebwa bikerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baata Esanduuku eyo ku kigaali ekiyaaka, Uzza ni Ahio batabane ba Abinadabu baakivuga nga bakitoola mu ndhu ya Abinadabu oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.7",
            "verseOrgIds": [
              "1CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi n'Abaisiraeli boonaboona baajanga nga bakina n'amaani gaibwe goonagoona mu maiso ga Katonda. Baayemba nga bwe bakuba endingidi, n'entongooli, n'obugoma, n'ensaasi, n'ebide, nga bwe bafuuwa n'amagwala.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baatuuka mu kifo aghakubirwa engaano ekya Kidoni, ente dhaaba oti dhenda kugwa. Kale, Uzza yaagolola omukono, yaagema n'engalo dhe ku Sanduuku ey'endagaano erobe kugwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaamutumbukizaaku obusungu bwe ng'oti muliro, yaamwitiragho olw'okwetulinkiriza n'agema ku Sanduuku eyo. Uzza oyo yaafiira agho mu maiso ga Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaasungughala olwa Musengwa Katonda okubonereza Uzza atyo. Ekifo ekyo baakituuma eriina Perezi Uzza okutuusa ni ye buli eno. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:11",
              "type": "text"
            },
            {
              "text": "Perezi Uzza:",
              "type": "text"
            },
            {
              "text": "Mu Luheburayi kitegeeza “Ekibonerezo kya Uzza”.",
              "type": "text"
            }
          ]
        }
      ]
    },
