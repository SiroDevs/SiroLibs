          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.13",
            "verseOrgIds": [
              "LUK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yesu mu maani ga Mwoyo Mutukuvu yairayo e Galilaaya, era kyawulikika mu biketezo byonabyona ebyetooloire agho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaayegeresa mu sinagoga dhaibwe nga boonaboona bamutaamu ekitiisa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.15",
            "verseOrgIds": [
              "LUK.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
