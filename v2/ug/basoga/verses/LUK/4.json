            "sid": "LUK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye mbakobera mu butuufu bwene: Mu byanda bya Eliya, banamwandu baali kamaala mu Isiraeli eigulu bwe lyesiba emyaka esatu n'emyezi omukaaga, endhala ey'amaani n'egwa mu nsi woonawoona.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.25",
            "verseOrgIds": [
              "LUK.4.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
