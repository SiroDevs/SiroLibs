          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yairamu ati: “Kyaghandiikibwa kiti, ‘Osinzanga Musengwa Katonda wo, era ni yenka y'ogheerezanga.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.8",
            "verseOrgIds": [
              "LUK.4.8"
            ]
          }
