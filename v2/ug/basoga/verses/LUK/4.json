            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaira okuva ku Yorudani, ng'aidhwire Mwoyo Mutukuvu, era Mwoyo yaamutwala mu irungu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.1",
            "verseOrgIds": [
              "LUK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaamala enaku amakumi ana (40) Sitaani ng'amukema. Mu nnaku edho tiyalya ku kantu koonakoona, era bwe dhaawaaku endhala yaamuluma.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.2",
            "verseOrgIds": [
              "LUK.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
