                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Bakyab 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.25",
            "verseOrgIds": [
              "LUK.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Eliya tiyatumwa eri waire omulala ati ku abo, okutoolaku ew'omukazi namwandu ow'omu Zarefathi eky'omu Sidoni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.26",
            "verseOrgIds": [
              "LUK.4.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.8+1KI.17.9+1KI.17.10+1KI.17.11+1KI.17.12+1KI.17.13+1KI.17.14+1KI.17.15+1KI.17.16"
              },
              "items": [
                {
                  "text": "1 Bakyab 17:8-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.26",
            "verseOrgIds": [
              "LUK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate era ab'endwaire ey'ebigenge baali kamaala mu Isiraeli mu byanda bya Elisha omulanzi. Aye era ku abo ghazira naire mulala eyawonezebwa okutoolaku Naamani Omusiria.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.27",
            "verseOrgIds": [
              "LUK.4.27"
            ]
          }
        },
        {
