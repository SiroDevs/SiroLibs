          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Sitaani yaamutwala ku lusozi era mu kaseera akazira ghe kaaga yaamulaga obwakyabazinga bwonabwona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.5",
            "verseOrgIds": [
              "LUK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamukoba ati: “Ndidha kukugha obukumu ku bwakyabazinga obwo bwonabwona n'ebitiibwa byabwo, kuba byampeebwa era ye mba nhenze ye mbigha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.6",
            "verseOrgIds": [
              "LUK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale bw'okuba amakiryaivu n'onsinza, byonabyona biidha kuba bibyo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.7",
            "verseOrgIds": [
              "LUK.4.7"
            ]
          }
        }
      ]
    },
