              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaamukoba ati: “Kyaghandiikibwa kiti, ‘Tokemanga Musengwa Katonda wo.’ ”",
          "type": "text",
          "attrs": {
