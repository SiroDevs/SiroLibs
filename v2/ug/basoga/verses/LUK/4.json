          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitaani ng'amaze okumukema mu ngeri yoonayoona, yaamuviira okutuusa ng'ebiseera bituuse.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.13",
            "verseOrgIds": [
              "LUK.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
