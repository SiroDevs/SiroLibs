          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava agho Sitaani yaamutwala e Yerusalemu yaamuta ku kasolya ak'eisinzizo, yaamukoba ati: “Oba oli Mwana wa Katonda va ghano weesuule ghansi ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.9",
            "verseOrgIds": [
              "LUK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba kyaghandiikibwa kiti, ‘Aliragira bamalaika be baakulabirira, baakukuuma’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.10",
            "verseOrgIds": [
              "LUK.4.10"
            ]
          }
        },
