        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghaaligho omusaadha omukombe eyavaalanga ebivaalo bya nakasooma nga byakolebwa mu ngoye mpegheevu, era nga buli lunaku yabanga oti ali ku mbaga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.19",
            "verseOrgIds": [
              "LUK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaabaagho omusaadha omwavu eyali aidhwire amabwa ye baayetanga Lazaro, ng'aba agho ku mulyango ogw'omukombe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.20",
            "verseOrgIds": [
              "LUK.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeegombanga okulya aigute obukunkumuka obwavanga ku meeza ey'omukombe, era embwa dhaidhanga dhaakomberera amabwa ge.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.21",
            "verseOrgIds": [
              "LUK.16.21"
            ]
          }
        }
      ]
    },
