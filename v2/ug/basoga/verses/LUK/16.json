          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Buli muntu abinga mukazi we n'abayiza owundi aba ayenze, ate omuntu abayiza omukazi oyo iba y'abinze yeena aba ayenze.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
