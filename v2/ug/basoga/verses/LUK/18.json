          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yaayasiikana ati: “Yesu mwidhukulu wa Daudi, nsaasira!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.38",
            "verseOrgIds": [
              "LUK.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaali bakulembeiremu baamudhuuka asirike, aye yayongera bwongere kwasiikana ati: “Mwidhukulu wa Daudi nsaasira!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.39",
            "verseOrgIds": [
              "LUK.18.39"
            ]
          }
        }
      ]
    },
