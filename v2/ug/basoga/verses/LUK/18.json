          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ghazira mu ebyo kye baategeera; amakulu ag'ebibono ebyo gaabeegisaaku era tibaagemya bye yabakoba.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        }
      ]
