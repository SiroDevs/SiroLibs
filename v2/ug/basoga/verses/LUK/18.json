          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaabakoba ati: “Bwenebwene ka mbakobere ezira oyo aleka maka, mukazi, oba baganda be, oba bazaire oba baana olw'okuba Obwakyabazinga bwa Katonda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.29",
            "verseOrgIds": [
              "LUK.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'atafuna ebisingagho kamaala mu nsi muno, ate ni mu biseera ebiidha n'agheebwa obulamu obutawaagho.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.30",
            "verseOrgIds": [
              "LUK.18.30"
            ]
          }
        }
      ]
