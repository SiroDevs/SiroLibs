          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiba kyangu engamiya okubita mu mpami ey'empiso okusinga omukombe okungira mu Bwakyabazinga bwa Katonda.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.25",
