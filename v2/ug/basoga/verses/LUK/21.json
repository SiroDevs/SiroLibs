        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.33",
            "verseOrgIds": [
              "LUK.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwekuume, ti kulwa nga mwemalira bwa mu binhumo, kutamiira na kweraliikirira bya bulamu buno, olunaku lule lwabagwaku nga timwidhi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.34",
            "verseOrgIds": [
              "LUK.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba abantu boonaboona ab'oku nsi lulibagwaku ng'oti iggu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.35",
            "verseOrgIds": [
              "LUK.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulingirire inho ebirigho era musabe, musobole okuwona ebyo ebija okubaagho era n'okwemerera mu maiso g'Omwana w'Omuntu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.36",
            "verseOrgIds": [
              "LUK.21.36"
            ]
          }
        }
      ]
    },
