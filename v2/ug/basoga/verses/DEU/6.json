          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutalebanga Musengwa Katonda waimwe, nga bwe mwamuleba e Massa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
