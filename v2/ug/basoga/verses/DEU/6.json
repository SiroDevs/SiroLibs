        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
