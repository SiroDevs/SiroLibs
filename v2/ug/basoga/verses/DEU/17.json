        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'alityama ku kityamo kye eky'obwakyabazinga, alyeghandiikira amateeka gano mu kitabo ng'agatoola mu ekyo ekiri ni bakabona Abalevi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitabo ekyo kiidha kumubanga kumpi, era aidhanga kukisoma enaku dhoonadhoona edh'obulamu bwe, aghange okwega okutyanga Musengwa Katonda we n'okukuumanga byonabyona ebiragirwa mu kitabo ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
