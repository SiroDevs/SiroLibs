              "type": "text"
            }
          ]
        },
        {
          "text": "Aye bwe muteeyamenga kintu kyonakyona, timuubengaku kibi kye mukoze. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
