              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.4",
            "verseOrgIds": [
              "DEU.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musa omugheereza wa Musengwa Katonda yaafiira eyo mu nsi Moabu, nga Musengwa Katonda bwe yakoba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.5",
            "verseOrgIds": [
              "DEU.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yaamuziika e Moabu mu kiiko ekiringiriire ekibuga Peori. Aye n'okutuusa mpegaano, ghazira aidhi kifo kyene ghe yaziikibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.6",
            "verseOrgIds": [
              "DEU.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaja okufa ng'agheziiza emyaka kikumi n'abiri egy'obukulu. Aye yali ng'akaabona bukalamu, era ng'akaali wa maani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.7",
            "verseOrgIds": [
              "DEU.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Abaisiraeli baalira Musa okumala enaku amakumi asatu, nga bali mu kiketezo eky'oku museetwe e Moabu, okutuusa ekiseera eky'okumulira bwe kyawaaku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
              "DEU.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
              "DEU.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua mutabane wa Nuni yali ng'aidhwire amagezi, kuba Musa yali ng'amaze okumutaagho aire mu kifo kye. Kale ni Abaisiraeli baawuliranga Yoshua oyo, era baakolanga nga Musengwa Katonda bwe yalagira Musa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.9",
            "verseOrgIds": [
              "DEU.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.9",
            "verseOrgIds": [
              "DEU.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva ku olwo tighabangaghooku kabiri mulanzi mu Isiraeli ali ng'oti ni Musa, Musengwa Katonda ye yamanha n'ayogeranga naye maiso ku maiso. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.11"
              },
              "items": [
                {
                  "text": "Kuv 33:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghazira mulanzi wundi eyakola ebyewuunhio n'ebyewuninkiriza, ng'oti n'ebyo Musengwa Katonda bye yatuma Musa okukola ku kyabazinga w'e Misiri, ni ku bakungu be, ni ku bantu b'ensi eyo boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ghazira mulanzi wundi eyakola eby'amaani ebyo n'ebitiisa einho ebyo byonabyona, nga Musa bwe yakola ng'Abaisiraeli boonaboona babona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
      ]
    }
  ],
