              "DEU.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memale olwo mujenga mu kifo Musengwa Katonda waimwe ky'aliba ng'alonzeegho okumusinzizangamu, muliire eyo mu maiso ge ekitundu ekirala ekirala ku buli bitundu ikumi eky'engaano yaimwe, n'eky'omwenge gwaimwe ogw'emizabbibu, n'eky'omuzigo gwaimwe ogw'ebibala eby'emiti emyoliva, ghalala n'ente, n'entaama, n'embuzi dhaimwe edhizaalibwa mu luzaalo olusooka. Mukolenga mutyo, olwo mughange okwega okutyanga Musengwa Katonda waimwe enaku dhoonadhoona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.23",
            "verseOrgIds": [
              "DEU.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye olugendo bwe lunaababitirirangaku obuleeyi olw'okuba ng'ekifo Musengwa Katonda ky'aliba ng'alonzeegho okumusinzizangamu kiri ghala, nga timusobola kutwalayo ekintu ekirala ekirala ku buli bintu ikumi eky'ebyo Musengwa Katonda by'abaghaire okukungula, olwo munaakolanga muti: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwidha kutundanga ekintu ekirala ekirala ku buli bintu ikumi ekyo, mufunemu empiiya, muje nadho mu kifo Musengwa Katonda waimwe ky'aliba ng'alonzeegho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empiiya edho munaadhigulangamu kye munaabanga nga mwenze: ente, oba entaama, oba omwenge ogw'emizabbibu, oba ekitamiiza ekindi kyonakyona, oba ekintu ekindi kyonakyona kye munaabanga nga mwegombye okulya. Munaaliiranga eyo mu maiso ga Musengwa Katonda waimwe, mwasagambira ghalala n'ab'omu maka gaimwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abalevi ababa mu bibuga byaimwe mutabalekuliranga agho, kuba beene bazira mugabo gwa itaka lya nsikirano ng'oti n'imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.27",
            "verseOrgIds": [
              "DEU.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli ku nkomerero y'omwaka ogwokusatu, mwidha kuleetanga ekintu kirala kirala ku buli bintu ikumi eky'ebirime bye mukungwire omwaka ogwo. Ebintu ebyo bye munaaleetanga, munaabiterekanga mu bibuga byaimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo Abalevi abazira mugabo gwa itaka lya nsikirano nga imwe bwe muli nagwo, n'abasenze, ni bamulekwa, ni banamwandu abali mu bibuga byaimwe, banaidhanga baafuna ku mere eyo, baalya baiguta olwo Musengwa Katonda waimwe aghange okubagha imwe enkabi mu byonabyona bye munaakolanga.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.29",
            "verseOrgIds": [
              "DEU.14.29"
            ]
          }
        }
      ]
    }
