  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "EXO 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaalagira Musa ati: “Mu bantu boonaboona Abaisiraeli oidha kulondamu Aaroni muganda wo, ni batabane, Nadabu, ni Abihu, ni Eleazari, ni Ithamari, obaawule bampeereze nga bakabona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.1",
            "verseOrgIds": [
              "EXO.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era oidha kukolera muganda wo oyo Aaroni ebivaalo ebiidhwire obutukuvu ebimugheesa ekitiisa, era ni bimubonesa obulungi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.2",
            "verseOrgIds": [
              "EXO.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oidha kwogera n'abantu abasobola okukola ekyo, abantu be nagha amagezi n'obumanhi, bamukolere ebivaalo ayawulibwe ankolere omulimo ogw'obwakabona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.3",
            "verseOrgIds": [
              "EXO.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebivaalo bye babe bakole ni bino: eky'omu kifuba, eky'obwakabona, ekanzu, ekivaalo ekidholige n'empiso n'ewuuzi, ekitambaala eky'oku mutwe, n'olukoma. Baidha kukolera muganda wo oyo Aaroni ni batabane ebivaalo ebitukuvu bampeereze nga bakabona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.4",
            "verseOrgIds": [
              "EXO.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaja okukola ebivaalo bali n'okukozesa engoye edha langi ya zaabu, n'edh'eya bbululu, n'edh'eya nakasooma, n'edh'eya kasaayisaayi, era n'engoye empegheevu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekivaalo eky'obwakabona baidha kukikola mu ngoye edha langi ya zaabu, n'edh'eya bbululu, n'edh'eya nakasooma, n'edh'eya kasaayisaayi, era n'engoye empegheevu, nga bakidholiga n'empiso n'ewuuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.6",
            "verseOrgIds": [
              "EXO.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiri n'okubaaku ensibiro edhikisiba ku mabega. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.7",
            "verseOrgIds": [
              "EXO.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kiri n'okubaaku olusibiro lwaku olw'omu nkende, nga lwalukibwa bukalamu era nga lwatungibwa ku kivaalo ekyo eky'obwakabona, era nga lwakolebwa mu ngoye ndala edho edha langi ya zaabu, n'edh'eya bbululu, n'edh'eya nakasooma, n'edh'eya kasaayisaayi, era n'engoye empegheevu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.8",
            "verseOrgIds": [
              "EXO.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oidha kufunayo ebibaadho bibiri eby'eibaale ery'omughendo eryetebwa onikisi, oghandiikeku amaina ag'abaana ba Yakobo ng'okozesa ekyuma ekisongovu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.9",
            "verseOrgIds": [
              "EXO.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaina ag'abaana omukaaga oidha kugaghandiika ku kibaadho ekindi, n'omukaaga ag'abandi ku kindi ng'ojiira ku bwe bairaganwaku mu kuzaalibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.10",
            "verseOrgIds": [
              "EXO.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oidha kughandiika amaina ag'abaana ba Yakobo ku bibaadho ebyo ebibiri eby'eibaale, ng'oti n'omubaadhi ow'amabaale ag'omughendo bw'asala obumanhiso. Bw'omala obiteeku emigo egya zaabu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.11",
            "verseOrgIds": [
              "EXO.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "era obite ku nsibiro edhisiba ekivaalo ekyo eky'obwakabona ku mabega, dhibe eky'okwidhusa eri Abaisiraeli. Mu nsambo eyo Aaroni aidha kubanga n'amaina gaibwe ku mabega ge mu maiso ga Musengwa Katonda ng'ekiidhukizo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era oidha kukolayo emigo egindi ebiri nga gya zaabu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.13",
            "verseOrgIds": [
              "EXO.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'endhegere ibiri edha zaabu omukenenule, ng'odhiruse ng'oti migugha. Olwo oyunge endhegere edho ku migo gire.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaalagira Musa ati: “Era oidha kukola ekivaalo eky'omu kifuba Omukulu wa Bakabona ky'anaakozesanga okumanha Katonda ky'ayenda. Oidha kukikola mu nsambo n'endala ng'oti n'ekivaalo eky'obwakabona, ng'okozesa engoye edha langi ya zaabu, n'edh'eya bbululu, n'edh'eya nakasooma, n'edh'eya kasaayisaayi, n'engoye empegheevu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.15",
            "verseOrgIds": [
              "EXO.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiri n'okuba nga kiwumbe kyamu, endhuyi dhaakyo eina dhaaba nga dhaagayaga, obuleeyi sentimita amakumi abiri na ibiri, n'obugazi sentimita amakumi abiri na ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.16",
            "verseOrgIds": [
              "EXO.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku kivaalo ekyo oidha kutaanhaku obunhiriri buna obw'amabaale ag'omughendo. Akanhiriri akasooka kaidha kubaaku amabaale ageetebwa, saradiu, ni topazi, ni karabunkule. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.17",
            "verseOrgIds": [
              "EXO.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate akanhiriri akokubiri kabeeku ageetebwa emeraludo, saffiro, ni diamondi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.18",
            "verseOrgIds": [
              "EXO.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate akanhiriri akokusatu kabeeku ageetebwa yasintha, agate, ni amethisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.19",
            "verseOrgIds": [
              "EXO.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo akokuna kabeeku ageetebwa berulo, onikisi, ni yasipera. Amabaale ago gali n'okubaaku omugo gwa zaabu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.20",
            "verseOrgIds": [
              "EXO.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "era nga bwe gali amabaale eikumi n'abiri, buli irala liidha kukolebwa ng'oti n'empeta ekozesebwa ng'akamanhiso, nga lighandiikiibwaku n'ekyuma ekisongovu eriina irala ku maina ag'abaana ba Yakobo, ku lw'ebika byaibwe eikumi n'ebibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.21",
            "verseOrgIds": [
              "EXO.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekivaalo eky'omu kifuba kino kyona oidha kukikolera endhegere edha zaabu omukenenule, nga dhirukiibwa ng'oti migugha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.22",
            "verseOrgIds": [
              "EXO.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era oidha kukikoleraku obukondo bubiri nga bwa zaabu, obute ku nsonda dhaakyo eibiri edha ghaigulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.23",
            "verseOrgIds": [
              "EXO.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bukondo omwo mw'onaasiba endhegere dhire edha zaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.24",
            "verseOrgIds": [
              "EXO.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate endhuyi edhindi edh'endhegere edho odhisibe ku migo gire ebiri, olwo ekivaalo kino eky'omu kifuba kibe nga kiyimbibwa emberi ku nsibiro edhisiba ekivaalo eky'obwakabona ku mabega. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.25",
            "verseOrgIds": [
              "EXO.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabiri oidha kukolayo obukondo bubiri obwa zaabu obute ku nsonda eibiri edha ghansi, edh'olukugiro olw'omunda olw'ekivaalo eky'omu kifuba okuliiraana n'ekivaalo eky'obwakabona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.26",
            "verseOrgIds": [
              "EXO.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era okoleyo obukondo obundi bubiri obw'obuuma bwa zaabu, obute ku lukugiro olwa ghansi olw'emberi ku nsibiro edhisiba ekivaalo eky'obwakabona ku mabega okumpi n'olusibiro olw'omu nkende olwalukirwa obukalamu ku kivaalo eky'obwakabona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.27",
            "verseOrgIds": [
              "EXO.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho oidha kusiba ghalala obukondo obw'oku kivaalo eky'omu kifuba n'obukondo obw'ekivaalo eky'obwakabona, ng'okozesa akagugha aka langi ya nakasooma. Era olwo ekivaalo eky'omu kifuba ekyo kibe nga kiika bukalamu ku lusibiro olw'omu nkende olwalukirwa obukalamu ku kivaalo eky'obwakabona, era kibe nga tikirekuka kuva ku kivaalo ekyo eky'obwakabona.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
