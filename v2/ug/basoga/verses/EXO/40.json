          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 40:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva n'olwo, ekire ekyo bwe kyavanga ku Weema eyo, nga n'Abaisiraeli boona batambula okuva ghe baalinga basimbye weema dhaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
            "verseOrgIds": [
              "EXO.40.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
