              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'ensonga eyo, Musa yaaba nga taghanga kungira mu Weema eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.35",
            "verseOrgIds": [
              "EXO.40.35"
            ]
          }
        },
        {
