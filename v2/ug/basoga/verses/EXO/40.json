              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yaataagho olugugiriro okwezunguluza Eweema Entukuvu n'alutaari, era yaasiba ekintu ekikinzaagho mu mulyango ogw'oku lugugiriro olwo. Agho Musa yaaba ng'amaze omulimo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.33",
            "verseOrgIds": [
              "EXO.40.33"
            ]
