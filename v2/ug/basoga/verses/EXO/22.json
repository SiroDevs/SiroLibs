              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'olibabisa obubi, baja kundirira era zeena mpulire okulira kwaibwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.23"
            ]
