          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era otyo bw'onaakolanga n'ente, n'entaama, n'embuzi enume enaazaalibwanga mu luzaalo olusooka enaabangaku ni dhiinaadho okumala enaku musanvu, olwomunaana waagimpa ng'ekigheebwayo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
