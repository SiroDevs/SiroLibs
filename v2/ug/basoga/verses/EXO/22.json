          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omusaadha bw'anaasendasendanga omughala omuto omwegha akaali okwandhula n'aba naye, anaaghangayo omwandu yaamubayiza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
