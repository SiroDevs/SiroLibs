          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nsungughale era nkusindike ofiire mu lutalo. Olwo weena bakazi bo babe banamwandu, n'abaana bo babe bamulekwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.24"
            ]
