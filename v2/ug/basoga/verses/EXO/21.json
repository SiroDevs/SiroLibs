            "sid": "EXO 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye bw'anaabanga nga tiyamweteega mu bugenderevu, aye nga nze Katonda ninze nasalagho afe mu nsambo eyo, agho ndidha kutangagho ekifo mw'anaalumukiranga, n'awona omusango ogwo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
