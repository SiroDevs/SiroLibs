            }
          ]
        },
        {
          "text": "“Bwebanaabanga nga bali kulwana, memale owundi ku abo n'alumya omukazi ali enda, enda n'evaamu aye omukazi n'ataba bubi, oyo amulumiiza aidha kumuliyiranga omughendo iba w'omukazi oyo ye balumiiza gw'anaasalanga ni gwikirizibwa abalamuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omukazi bw'anaabanga obubi, amulumiiza aidha kumuliyiranga bulamu olw'obulamu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
