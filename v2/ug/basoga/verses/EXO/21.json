          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omuntu anaalumbanga mwine mu bugenderevu, n'asala amagezi n'amwita, oyo ni bw'anaabanga ng'alumukiire ku alutaari yange okwewonia, anaatoolebwangayo yaitibwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
