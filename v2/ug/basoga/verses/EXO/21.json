          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bw'anaakubanga eriino ery'omwiru we omusaadha oba omwiru we omukazi n'alitoolamu, aidha kulekanga omwiru oyo aje nga wa idembe olw'okusasulira eriino lye.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
