          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "oba eriiso olw'eriiso, oba eriino olw'eriino, oba omukono olw'omukono, oba ekigere olw'ekigere,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
            "verseOrgIds": [
              "EXO.21.24"
            ]
          }
