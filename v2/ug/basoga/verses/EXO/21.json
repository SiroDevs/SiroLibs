          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omuntu yeenayeena anaakubanga omuntu n'amwita, yeena anaabanga n'okwitibwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
