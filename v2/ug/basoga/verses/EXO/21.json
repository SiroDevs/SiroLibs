          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omuntu bw'anaalekanga ekiina nga takisandiikeeku, oba omuntu bw'anaasimanga ekiina n'atakighembaku, memale ente oba endogoyi n'ekigwamu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwene kiina anaabanga n'okuligha ensolo eyo. Aidha kughanga mwene nsolo empiiya, era olwo ensolo enfu enaabanga yiye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        }
      ]
    },
