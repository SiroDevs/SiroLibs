        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ente ey'omuntu bw'enaalumyanga ente ey'omuntu owundi, ere erumiziibwa n'efa, banaatundanga ente enamu baagabana empiiya era baagabana n'emamba ey'ere enfu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.35",
            "verseOrgIds": [
              "EXO.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye bwekinaabanga nti ente eyo erumiiza yiinaayo ebairenga emanhiibwa okuva einhuma ere nga nfulagani, aye mwene yo n'aloba okugisiba, mwene yo oyo aidha kutoolanga ente enamu aliyire mwene ere enfu, olwo ensolo eyo enfu enaafuukanga yiye.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.36",
            "verseOrgIds": [
              "EXO.21.36"
            ]
          }
        }
