                  "text": "Fil 4:18",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.18",
            "verseOrgIds": [
              "EXO.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bw'omala ekyo oidha kuleeta entaama ere enume eyokubiri, Aaroni ni batabane bate emikono gyaibwe ku mutwe gwayo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.19",
            "verseOrgIds": [
              "EXO.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "memale ogiite. Olwo oidha kutoola ku musaayi gwayo ogundi ogusiige ku ntobo ya kutu ow'oku mukono omusaadha ow'Aaroni n'owa buli mutabane, ni ku byala byaibwe ebisaadha eby'oku mikono gyaibwe emisaadha, ni ku bigere byaibwe ebisaadha eby'oku migulu gyaibwe emisaadha. Olwo otoole omusaayi ogunaasigalagho ogumansire ku ndhuyi dhoonadhoona edh'alutaari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.20",
            "verseOrgIds": [
              "EXO.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho oidha kutoola ku musaayi ogunaaba ku alutaari, ni ku muzigo ogusiigibwa, byombi obimansire ku Aaroni ni ku bivaalo bye, ni ku batabane ni ku bivaalo byaibwe. Olwo onaaba otukwiza Aaroni n'ebivaalo bye, ni batabane n'ebivaalo byaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.21",
            "verseOrgIds": [
              "EXO.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.21",
            "verseOrgIds": [
              "EXO.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Entaama eyo, n'ekozesebwa mukwawula n'okugemya Aaroni ni batabane be omulimo ogw'obwakabona. Kale oidha kusoloza amasavu gaayo goonagoona, nga n'omuli: amasavu ag'omukira, n'agali ku byenda, n'ekitundu ekisinga bulungi ku ini, n'ensigo dhombi ghalala n'amasavu agadhiriku, n'ekisambi eky'oku mukono omusaadha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.22",
            "verseOrgIds": [
              "EXO.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era oidha kutoola omugaati mulala mulala okuva ku migaati egitazimbulukusiibwa egy'ebika ebisatu bino egiri mu kiibo mu maiso ga Musengwa Katonda: eminene egitabwirwamu omuzigo, n'egindi egiziramu muzigo, n'emitono egisiigiibwaku omuzigo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.23",
            "verseOrgIds": [
              "EXO.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo byonabyona, oidha kubita mu ngalo dha Aaroni n'edha batabane, babiwuube bibe ekigheebwayo eri nze Musengwa Katonda nga biwuubibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.24",
            "verseOrgIds": [
              "EXO.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho obibatoole mu ngalo obyokere ku alutaari ng'oyongereza ku kigheebwayo ekyokebwa ekinaaba kiriku. Akawoowo akava ku kigheebwayo ekyo ekyokebwa kasangaaza nze Musengwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
