              "EXO.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bw'omala oidha kutoola akafumito ak'entaama eyo enume egheebwayo olw'okwawulibwa kwa Aaroni, ogiwuube ebe ekigheebwayo ye ndi nga kiwuubibwa. Ekitundu ekyo eky'ensolo n'ogunaabanga omugabo gwo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.26",
            "verseOrgIds": [
              "EXO.29.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.26",
            "verseOrgIds": [
              "EXO.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Era ku ntaama enume eyo egheebwayo olw'okwawulibwa kw'Aaroni ni batabane, oidha kutukuzaaku akafumito kaayo, n'ekisambi kyayo, byombi bibe ekigheebwayo nga kiwuubibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.27",
            "verseOrgIds": [
              "EXO.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli Baisiraeli lwe banaaleetanga akafumito n'ekisambi ng'ekigheebwayo olw'okutabagana, ebintu ebyo byombi binaateekwanga okuba ebya Aaroni ni batabane lubeerera. Ebintu ebyo n'ekigheebwayo abantu kye bampa nze Musengwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ebivaalo bya Aaroni eby'obwakabona biidha kugheebwanga mutabane anaamusikiranga, era oyo by'anaavaalanga nga bamusiiga omuzigo olw'okumwawula. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.29",
            "verseOrgIds": [
              "EXO.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabane oyo aidha kufuukanga kabona mu kifo kye, aidha kuvaalanga ebivaalo ebyo okumala entangama ya nnaku musanvu ng'aidhie mu Weema ey'Okwagaananirangamu ni Musengwa Katonda okukola emirimo egy'obwakabona mu Kifo Ekitukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.30",
            "verseOrgIds": [
              "EXO.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.30",
            "verseOrgIds": [
              "EXO.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agho oidha kutoola emamba ey'entaama enume egheebwayo olw'okwawula Aaroni, ogitogokeze mu maadhi mu Kifo Ekitukuvu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.31",
            "verseOrgIds": [
              "EXO.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'eya, oidha kugigha Aaroni ni batabane bagirye n'emigaati eginaaba gisigaire mu kiibo, era nga bagiriira gha mulyango ogw'Eweema ey'Okwagaananirangamu ni Musengwa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.32",
            "verseOrgIds": [
              "EXO.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baidha kulyanga ebintu ebyo ebinaaba bigheereibwayo ng'omusengo olw'ebibi byaibwe ku mukolo ogw'okubaawula. Era atali kabona atabiryangaku, kuba bitukuvu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.33",
            "verseOrgIds": [
              "EXO.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bweghabaagho ku mamba eyo oba ku migaati egyo ebiba nga tibiriiriibwa ni bisigalagho okutuusa enkyo lyaku, tibiirangayo kuliibwa, mubyokyanga bwa muliro kuba bitukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.34",
            "verseOrgIds": [
              "EXO.29.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.34",
            "verseOrgIds": [
              "EXO.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oidha kukola omukolo ogw'okwawula Aaroni ni batabane, ogwidha okutwala enaku omusanvu, ng'ojiira ku ebyo byonabyona bye nkulagiire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.35",
            "verseOrgIds": [
              "EXO.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli lunaku mu nnaku edho omusanvu, oidha kughangayo ente enume ng'ekigheebwayo olw'ebibi. Era ogheeyo ekigheebwayo olw'okutukuza alutaari, olwo ogisiige omuzigo olw'okugitukuza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.36",
            "verseOrgIds": [
              "EXO.29.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 29:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enaku omusanvu edho oidha kughangayo ekigheebwayo olw'ebibi okutukuza alutaari, olwo ebe ng'eidhwire obutukuvu ng'ekintu kyonakyona ekigyekontaku kifuuka kitukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.37",
            "verseOrgIds": [
              "EXO.29.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 29:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.37",
            "verseOrgIds": [
              "EXO.29.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 29:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Buli lunaku oidha kugheerangayo ku alutaari okwo entaama ento ibiri, edh'omwaka omulala omulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.38",
            "verseOrgIds": [
              "EXO.29.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 29:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entaama eyindi oidha kugighangayo enkyo, ate eyindi ogighengayo eigulo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.39",
            "verseOrgIds": [
              "EXO.29.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 29:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'oghaayo entaama esooka, oghaayo ni kilo ey'engaano eseereibwa obukalamu ng'etabwirwamu lita ey'omuzigo omukenenule ogukamwirwa mu bibala eby'emiti emyoliva ebisekwirwa, waateeraku ni lita ey'omwenge ogw'emizabbibu ng'ekigheebwayo eky'ebyokunhwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 29:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere entaama eyindi y'oli n'okughaayo olw'eigulo, oidha kugighaayo n'ebintu bire ebisatu by'onaaba ng'ogheereire ku ere ey'enkyo: engaano, omuzigo n'omwenge ogw'emizabbibu era mu bipimo nga bire eby'ey'enkyo. Ekyo n'ekigheebwayo eri nze Musengwa Katonda ekyokebwa ekiri n'akawoowo akansangaaza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.41",
            "verseOrgIds": [
              "EXO.29.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 29:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buliidho mwidha kughangayo ekigheebwayo ekyo ekyokebwa n'omuliro ebyanda n'ebyanda. Mwidha kukigheerangayo ku mulyango ogw'Eweema ey'Okwagaananirangamu ni Musengwa Katonda, ghe naayagaanananga n'abantu bange era ni ndhogera n'iwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.42",
            "verseOrgIds": [
              "EXO.29.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 29:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kifo ekyo mwe ndidha okwagaanananga n'Abaisiraeli boonaboona, era ekitiisa kyange kiidha kukifuulanga kitukuvu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.43",
            "verseOrgIds": [
              "EXO.29.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 29:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kutukuza alutaari n'Eweema ey'Okwagaananirangamu, era ntukuze ni Aaroni ni batabane be, bampeerezenga nga bakabona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.44",
            "verseOrgIds": [
              "EXO.29.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 29:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nnaabanga mu bantu bange Abaisiraeli, era nnaabanga Katonda waibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.45",
            "verseOrgIds": [
              "EXO.29.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 29:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baidha kukitegeera nga ninze Musengwa Katonda waibwe eyabatoola mu Misiri, mbabengamu. Ninze Musengwa Katonda waibwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.46",
            "verseOrgIds": [
              "EXO.29.46"
            ]
          }
        }
      ]
    }
