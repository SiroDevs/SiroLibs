                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.10"
              },
              "items": [
                {
                  "text": "Kwol 16:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.22",
            "verseOrgIds": [
              "EXO.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nnaku eisatu edho nga ghazira Mumisiri aghanga kubona mwine, waire okusituka okuva mu kifo. Aye ng'ate Abaisiraeli boonaboona baalinga n'obutangaavu ghe baabanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.23",
            "verseOrgIds": [
              "EXO.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho kyabazinga yaayeta Musa yaamukoba ati: “Muje musinze Musengwa Katonda muje ni bakazi baimwe, n'abaana baimwe, aye entaama dhaimwe, n'embuzi, n'ente, muteekwa okubireka.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Musa yaamwiramu ati: “Oteekwa okutuleka tutwale ensolo dhe tulighaayo ng'emisengo era ng'ebigheebwayo ebyokebwa, tuje tugheeyo ye Musengwa Katonda waife emisengo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
              "EXO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale tuli n'okutwala n'ensolo dhaife dhoona, aghazira kulekaku naire ndala. Tuli n'okudhitwala, kuba tuli n'okudhikozesa mu kusinza Musengwa Katonda. Ate, nga tukaali kutuuka ghale ghe tuja okusinziza, titughanga kumanha nsolo ki dhe tuteekwa okughaayo.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye era Musengwa Katonda yaaleetera kyabazinga okukalanguka omwoyo, yaaloba kutya era yaaloba kubaleka ni baja. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yaakoba Musa ati: “Nva mu maiso! Era toirangayo kwidha ye ndi, kuba bwendikubona nga kabiri oize, ku olwo lw'olifa.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaamwiramu ati: “Oli mutuufu, toja kwirayo kumbonaku kabiri.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.29",
            "verseOrgIds": [
              "EXO.10.29"
            ]
          }
        }
