          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaakoba Musa ati: “Ghanika omukono ng'ogwolekeza ku igulu, ghaidhegho enzikiiza egeme ku nsi Misiri enzikiiza ere yeene eri bedimudimu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.21",
            "verseOrgIds": [
              "EXO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Musa yaagololera omukono y'eigulu, memale ghaidhagho enzikiiza ere yeene eri bedimudimu, yaagema ku nsi Misiri okumala enaku isatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.22",
            "verseOrgIds": [
              "EXO.10.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.28"
              },
              "items": [
                {
                  "text": "Zab 105:28",
