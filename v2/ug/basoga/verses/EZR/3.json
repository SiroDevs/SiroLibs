              ]
            }
          ]
        },
        {
          "text": " Baayemba eno nga bwe bairamu, nga basaaka era nga basiima Musengwa Katonda, bati:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
