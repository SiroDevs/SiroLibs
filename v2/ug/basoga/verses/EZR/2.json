              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.63",
            "verseOrgIds": [
              "EZR.2.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "EZR 2:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekikunsu kyonakyona aghalala eky'abo abaira okuva mu bunhage, kyalimu abantu emitwalo ena n'enkumi ibiri na bisatu na nkaaga (42,360).",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.64",
            "verseOrgIds": [
              "EZR.2.64"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
