          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.64",
            "verseOrgIds": [
              "EZR.2.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "EZR 2:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagheereza abasaadha n'abakazi be baira nabo baali,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.65",
            "verseOrgIds": [
              "EZR.2.65"
            ]
          }
        }
      ]
    },
