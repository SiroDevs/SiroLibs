      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano n'amaina ag'abantu ab'omu kiketezo eky'e Buyudaaya abaira okuva mu nsi Babilonia mu bunhage, kyabazinga waayo Nebukadinezzari ye yali abatwaire nga basibe. Abantu abo baira e Yerusalemu n'e Buyudaaya, buli muntu ng'airayo mu kibuga eky'ewaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.1",
            "verseOrgIds": [
              "EZR.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulembeze baibwe baali: Zerubbabeli, Yoshua, Nehemia, Seraia, Reelaia, Morodekai, Bilishani, Misipari, Bigivai, Rehumu, ni Baana.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guno n'omughendo ogw'Abaisiraeli abaira okuva mu bunhage:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "EZR 2:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.54",
            "verseOrgIds": [
              "EZR.2.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "EZR 2:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu baira okuva mu bunhage mwalimu abagheereza aba Solomoni bano:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.55",
            "verseOrgIds": [
              "EZR.2.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "EZR 2:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.57",
            "verseOrgIds": [
              "EZR.2.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "EZR 2:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagheereza ab'omu isinzizo n'abagheereza aba Solomoni boonaboona aghalala baali ebikumi bisatu na kyenda na babiri (392).",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.58",
            "verseOrgIds": [
              "EZR.2.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "EZR 2:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.58",
            "verseOrgIds": [
              "EZR.2.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "EZR 2:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu baira okuva mu bunhage mwalimu abaava e Telimela, n'e Teliharisha, n'e Kerubu, n'e Addani, n'e Immeri. Aye abantu abo baali bazira bukakafu bwoleka nda dha baiseibwe dhe baavaamu, waire obukakafu obwoleka oba nga baali Baisiraeli beenebeene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.59",
            "verseOrgIds": [
              "EZR.2.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "EZR 2:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baali ba ku nda ya Delaia, n'eya Tobia, n'eya Nekoda. Era boonaboona aghalala baali lukaaga n'ataanu na babiri (652).",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.60",
            "verseOrgIds": [
              "EZR.2.60"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "EZR 2:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.60",
            "verseOrgIds": [
              "EZR.2.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "EZR 2:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaligho n'abandi abaali abaana ba bakabona, nga ni bano: Ab'oku nda ya Habaia, n'ab'oku ya Hakkozi, n'ab'oku ya Barazillai, ye baatuuma eriina eryo olw'okuba yafumbirwa owundi ku baghala ba Barazillai Omugileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.61",
            "verseOrgIds": [
              "EZR.2.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "EZR 2:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abo baabanoonia mu nkalala dh'obuzaale aye nga tibabonekamu, kale baabalekeza okukola nga bakabona, nga batwalibwa ng'abatali balongoofu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.62",
            "verseOrgIds": [
              "EZR.2.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "EZR 2:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyali omufuzi mu kiseera ekyo yaabalobera okulyanga ku bigheebwayo eri Katonda okutuusa nga ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.63",
            "verseOrgIds": [
              "EZR.2.63"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.21"
              },
              "items": [
                {
                  "text": "Kub 27:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bafunie kabona asobola okwebuuza ku Musengwa Katonda ng'akozesa Urimu ni Thummimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.63",
            "verseOrgIds": [
              "EZR.2.63"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:63",
              "type": "text"
            },
            {
              "text": "Urimu ni Thummimu:",
              "type": "text"
            },
            {
              "text": "Ebintu bino byombi byateebwanga mu kivaalo eky'omu kifuba kabona kye yavaalanga, era nga bikozesebwa kabona oyo mu kuzuula Katonda ky'ayenda.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
