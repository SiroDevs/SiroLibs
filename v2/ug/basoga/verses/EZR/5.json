                }
              ]
            }
          ]
        },
        {
          "text": " Agho abalanzi babiri, Haggai ni Zekaria mutabane wa Iddo, baalanga eri Abayudaaya abaali mu Buyudaaya ni mu Yerusalemu, nga babita mu liina lya Katonda wa Isiraeli eyabalabiriranga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
