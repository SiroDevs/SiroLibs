              "items": [
                {
                  "text": "Zek 4:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kale Zerubbabeli mutabane wa Shealutieli ni Yeshua mutabane wa Yozadaki, bairamu okuzimba eisinzizo lya Musengwa Katonda e Yerusalemu, nga bayambibwaku abalanzi abo bombi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        }
      ]
