              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaakoba Yoshua ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Koba abantu Abaisiraeli oti, ‘Mulondegho ebibuga ole aise omuntu nga tagendereire mw'asobola okulumukira, nga bwe nakoba Musa abakobere. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.35.6+NUM.35.7+NUM.35.8+NUM.35.9+NUM.35.10+NUM.35.11+NUM.35.12+NUM.35.13+NUM.35.14+NUM.35.15+NUM.35.16+NUM.35.17+NUM.35.18+NUM.35.19+NUM.35.20+NUM.35.21+NUM.35.22+NUM.35.23+NUM.35.24+NUM.35.25+NUM.35.26+NUM.35.27+NUM.35.28+NUM.35.29+NUM.35.30+NUM.35.31+NUM.35.32+NUM.35.33+NUM.35.34"
              },
              "items": [
                {
                  "text": "Kub 35:6-34",
                  "type": "text"
                }
              ]
            },
            {
