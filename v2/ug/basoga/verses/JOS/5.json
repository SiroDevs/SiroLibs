        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua bweyali ng'akaali agho okumpi n'e Yeriko, yaja okulinga ati, ng'abona omusaadha ng'amwemereire mu maiso, era ng'agemye empiima. Yoshua yaaja y'ali, yaamubuuza ati: “Oli ku luuyi lwaife oba lwa bazigu baife?”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.13",
            "verseOrgIds": [
              "JOS.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
