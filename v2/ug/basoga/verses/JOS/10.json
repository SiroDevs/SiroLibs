          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Horamu kyabazinga ow'e Gezeri yali aidhie okubeeraku abantu ab'e Lakishi, aye Yoshua yaamughangula ghalala n'eigye lye lyonalyona. Yaabaita, boonaboona okubazikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
