            "sid": "JOS 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ku lunaku olwo, Yoshua yaagema ekibuga Makkeda, yaita kyabazinga waamu, n'abantu abaalimu boonaboona yaabazikiriza. Kye yakola kyabazinga ow'e Yeriko ni kyene ekyo kye yakola kyabazinga ow'e Makkeda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.28",
            "verseOrgIds": [
              "JOS.10.28"
            ]
          }
        }
      ]
    },
