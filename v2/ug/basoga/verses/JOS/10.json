              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo bwe byawa, Yoshua n'abasaadha be abalwani boonaboona, baava e Makkeda, baaja okughamba ekibuga Libuna. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
