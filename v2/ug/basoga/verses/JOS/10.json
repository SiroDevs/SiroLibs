          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyairaku, Yoshua n'abasaadha be abalwani boonaboona, baava e Lakishi baaja baabwama okwezungulula ekibuga Eguloni, era baakirumba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku lwene olwo baakighangula. Baita buli muntu eyali mu kibuga omwo ng'oti ni bwe baakola abaali mu Lakishi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
