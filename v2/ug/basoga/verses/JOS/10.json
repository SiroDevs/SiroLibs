          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yoshua, n'abasaadha be abalwani boonaboona, baakyuka baira einhuma, baalumba ekibuga Debiri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "baakighangula era baita kyabazinga waamu n'abantu boonaboona abaakirimu. Era baalumba n'ebibuga ebindi ebiriiraine ekibuga ekyo Debiri, baabighangula era baita n'abantu abaabirimu ng'oti ni bwe baakola Heburoni ni Libuna, ni bakyabazinga baamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
