          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kulwanirira ekibuga kino, nkikuume olw'ekitiibwa kyange, ni ku olw'omugheereza wange Daudi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.34",
