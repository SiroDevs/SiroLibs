    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaabaagho ebikunsu eby'Abamoabu ebyaidhanga okulumba ensi Isiraeli agho ng'omwaka gwakainhama. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwali lulala, ghaabaagho Abaisiraeli abaali baja okuziika omuntu, baabona ekindi ku bikunsu ebyo nga kiri kwidha. Agho baasuula omulambo bwa mu magombe ga Elisha, baalumuka. Omulambo ogwo olwasiinha ku magumba ga Elisha guti, ng'omusaadha oyo alamuka, era ng'ayemerera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
