          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Elisha yaalwala obulwaire obwamuviiraku okufa. Yehoashi kyabazinga wa Isiraeli yaaja y'ali okumubona. Yaalira amaziga ng'akoba ati: “Lata wange, lata wange! Iwe ow'amaani ng'oti bigaali bya mu lutalo n'embalaasi, ebirwanirira Isiraeli!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
