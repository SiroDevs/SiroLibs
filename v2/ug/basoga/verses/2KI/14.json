              "2KI.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogweikumi n'etaanu (15) nga kyabazinga Amazia mutabane wa Yoashi n'afuga Buyudaaya, Yeroboamu mutabane wa Yehoashi yaafuuka kyabazinga wa Isiraeli, era yaafugira mu Samaria okumala entangama ya myaka amakumi ana na mulala (41). ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakola ebibi eri Musengwa Katonda nga Yeroboamu mutabane wa Nebati bye yakola, ebyaleetera Isiraeli okwonoona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaghangula yaizaayo ensalosalo ya Isiraeli okuva aghaingirirwa e Hamathi okutuukira irala ku Nhandha Eyomuunhu, nga Musengwa Katonda, Katonda wa Isiraeli bwe yakoba ng'abita mu mugheereza we, omulanzi Yona mutabane wa Amittai ow'e Gathi Heferi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
