          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yabona okudaazibwadaazibwa okw'Abaisiraeli okutaloodheka, era nga ghaziragho muntu yeenayeena aghanga kubayamba, k'abe omusibe oba ow'eidembe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Musengwa Katonda tiyayenda kusaaniagho Baisiraeli kubamalagho ku nsi. Kyeyava n'abawonia ng'abita mu Yeroboamu owokubiri mutabane wa Yehoashi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
      ]
    },
