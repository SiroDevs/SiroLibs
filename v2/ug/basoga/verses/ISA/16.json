              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo n'obukwenda obugema ku Moabu, Musengwa Katonda bwe yayogera. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mpegaano Musengwa Katonda akoba ati: “Mu myaka esatu gyonka, ebitiibwa bya Moabu biriba nga tibikaaligho. Ku bantu baakyo waire nga bangi batyo, batono bati n'abalisigalagho ate nga tibakaali na maani naire.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.14",
            "verseOrgIds": [
              "ISA.16.14"
            ]
          }
        }
