            }
          ]
        },
        {
          "text": "Musengwa Katonda era akoba ati:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
