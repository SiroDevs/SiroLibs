                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.15+2CH.9.16"
              },
              "items": [
                {
                  "text": "2 Byom 9:15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yaanhaga eby'obukombe eby'omu isinzizo n'eby'omu kisaagaati kya kyabazinga, byonabyona yaabitwala. Yaatwala n'engabo dhoonadhoona edha zaabu, Solomoni dhe yagheesa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Rehoboamu yaagheesa engabo mu kyuma ky'ekikomo okwira mu kifo ky'edho, yaadhigemya abakulu ab'abakuumi abaakuumanga omulyango gw'ekisaagaati kye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga buli lwe yaingiranga mu isinzizo, ng'abakuumi batwala engabo edho, ate baamalanga baadhiizaayo mu ndhu mwe baadhikuumiranga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
      ]
