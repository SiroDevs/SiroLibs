        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.6",
            "verseOrgIds": [
              "JER.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati: “Ekiseera kiri kwidha, abantu babe nga tibakaalayira mu liina lyange nga Katonda omulamu eyatoola Abaisiraeli mu nsi Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.7",
            "verseOrgIds": [
              "JER.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye balayirenga mu liina lyange nga Katonda omulamu eyatoola Abaisiraeli mu nsi eri ku luuyi lw'omukono omugooda olw'e buvandhuba, ni mu nsi edhindi dhoonadhoona ye nali mbabingiire. Agho baliba mu nsi eyaibwe yeene.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.8",
            "verseOrgIds": [
              "JER.23.8"
            ]
          }
        }
      ]
    },
