                  "text": "6:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musengwa Katonda era yaakoba ati: “Bona eno, ekiseera kiri kwidha, nteegho omwidhukulu omutuufu owa Daudi abe kyabazinga. Aja kufuganga n'amagezi era aidha kukolanga amazima n'ebituufu mu nsi ye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.5",
            "verseOrgIds": [
              "JER.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ky'alifugiramu, abantu b'omu Buyudaaya baliba bukalamu, n'ab'omu Isiraeli baaba mu miraala. Balimweta eriina ‘Musengwa Katonda n'obulokozi bwaife.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.6",
            "verseOrgIds": [
              "JER.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
