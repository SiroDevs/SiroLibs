                "loc": "2KI.24.18+2KI.24.19+2KI.24.20"
              },
              "items": [
                {
                  "text": "2 Bakyab 24:18-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.11+2CH.36.12+2CH.36.13"
              },
              "items": [
                {
                  "text": "2 Byom 36:11-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu mwaka gwene ogwo, mu mwezi ogwokutaanu nga Zedekia ni kyabazinga wa Buyudaaya, Hanania mutabane wa Azzuri nga yali mulanzi eyava mu kibuga Gibeoni, yaayogera ninze nga tuli mu isinzizo, nga ghaligho ni bakabona, n'abantu abandi boonaboona. Yankoba ati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.1",
            "verseOrgIds": [
              "JER.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda Afuga Amagye, Katonda wa Isiraeli, akoba ati: “Namenhamenha obuyinza bwa kyabazinga w'e Babilonia, bwe yabakakaatikaku ng'oti kikoligo mu nkoto y'ensolo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu myaka ebiri egiidha, nja kwiza mu kifo kino ebintu byonabyona eby'eisinzizo, kyabazinga Nebukadinezzari bye yatwala e Babilonia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nja kwiza kyabazinga wa Buyudaaya Yehoiakini mutabane wa Yehoiakimu, ghalala n'abantu boonaboona ab'omu Buyudaaya abaatwalibwa e Babilonia mu bunhage. Yii, bwenebwene nze nja kumenhamenha obuyinza bwa kyabazinga ow'e Babilonia. Nze Musengwa Katonda, ninze nkobye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho nga bakabona baligho, ghalala n'abantu boonaboona abaali beemereire agho mu isinzizo, nze naakoba Hanania nti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.5",
            "verseOrgIds": [
              "JER.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“N'ekyo kyene! Ka nsuubire nti Musengwa Katonda aja kukola atyo, atuukirize by'olanze, aize okuva e Babilonia ebintu byonabyona bye baanhaga mu isinzizo, era aize n'abantu boonaboona abaatwalibwa mu bunhage. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye wulirisa kino kye nja okukukoba iwe Hanania era kye nja okukoba n'abantu abandi boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.7",
            "verseOrgIds": [
              "JER.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalanzi abaayogera eira, nga iwe ninze tukaali, baakoba entalo, n'endhala, n'endwaire ya kawumpuli, ebyali eby'okwidha biite abantu mu maghanga kamaala ni mu bwakyabazinga obw'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.8",
            "verseOrgIds": [
              "JER.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omulanzi alanga ati ghaja kubaagho miraala, ky'alanze kimala kutuukirira memale yaakakasibwa nga mulanzi mwenemwene atumiibwa Musengwa Katonda.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Hanania yatoola ekikoligo mu nkoto yange, yaakimenhamenha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.10",
            "verseOrgIds": [
              "JER.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakoba ng'abantu boonaboona bali agho ati: “Musengwa Katonda akoba ati, atyo bw'alimenhamenha ekikoligo kyabazinga Nebukadinezzari kye yata mu nkoto edh'amaghanga goonagoona. Era ekyo alikikola mu myaka ebiri.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho nze naavaagho naaja.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo nga bimaze okuwa, Musengwa Katonda yankoba ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.12",
            "verseOrgIds": [
              "JER.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nje nkobe Hanania nti: “Musengwa Katonda akoba ati iwe omenhiemenhie kikoligo kya kiti buti, aye mwene alikola ekikoligo eky'ekyuma ekigumu einho, kyaira mu kifo ky'ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.13",
            "verseOrgIds": [
              "JER.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda Afuga Amagye, Katonda wa Isiraeli, akoba ati aidha kuta ekikoligo eky'ekyuma ekigumu einho mu nkoto edh'amaghanga gano goonagoona gagheerezenga kyabazinga Nebukadinezzari ow'e Babilonia. Musengwa Katonda era akoba ati n'ensolo edh'omu nsiko dhoona aidha kudhireetera okugheerezanga Nebukadinezzari.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.14",
            "verseOrgIds": [
              "JER.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.14",
            "verseOrgIds": [
              "JER.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho naakobera Hanania ebintu ebyo, era naayongeraku ni kino nti: “Wulira iwe Hanania, Musengwa Katonda ti n'eyakutuma. Oli kuleetera bwa bantu bano kwesiga bya buguya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.15",
            "verseOrgIds": [
              "JER.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ni, Musengwa Katonda mwene akoba ati aja kukutoola ku nsi. Oidha kufa ng'omwaka guno gukaali kuwaaku, olw'okukoba abantu badheemere Musengwa Katonda oyo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Hanania yaafa mu mwezi ogwomusanvu ogw'omwaka gwene ogwo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.17",
            "verseOrgIds": [
              "JER.28.17"
            ]
          }
        }
