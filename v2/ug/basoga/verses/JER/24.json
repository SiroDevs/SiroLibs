                {
                  "text": "2 Bakyab 24:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Byom 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Agho Musengwa Katonda yandeetera okubonekerwa ebiibo bibiri nga birimu emitiini, nga biri agho emberi w'eisinzizo lye. Ekyo kyaligho nga Nebukadinezzari kyabazinga w'e Babilonia amaze okutoola e Yerusalemu kyabazinga Yekonia mutabane wa Yehoiakimu, yaamutwala e Babilonia mu bunhage ghalala n'abakungu b'omu Buyudaaya, n'abagheesi, n'abakugu mu mirimo egy'endhawulo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiibo ekindi kyalimu emitiini emirungi einho ng'oti n'egyo egisookereza okwenga ku muti. Aye ekiibo ekindi kyabaamu emitiini nga mibi inho, egitasobola na kuliibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.2",
            "verseOrgIds": [
              "JER.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yambuuza ati: “Yeremia, kiki ky'oli kubona?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamwiramu nti: “Ndi kubona emitiini emirungi einho, era naabona n'emibi, nga mibi inho egitasoboka na kuliibwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yankoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.4",
            "verseOrgIds": [
              "JER.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nze Musengwa Katonda, Katonda wa Isiraeli mbona ng'abantu be nasindika e Babilonia mu bunhage, bali ng'oti n'emitiini egyo emirungi, era ndidha kubabisanga bukalamu n'ekivunika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kubalabiriranga, mmale mbaize mu nsi eno. Ndibazimba, mu kifo ky'okubasansula, era naabasimba, mu kifo ky'okubaiwululagho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.6",
            "verseOrgIds": [
              "JER.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kubaleeteranga okuumanha nga ninze Musengwa Katonda. Olwo beene babenga bantu bange, ate nze mbenga Katonda waibwe, kuba baja kukyuka baire ye ndi n'omwoyo gwaibwe gwonagwona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye kyabazinga Zedekia owa Buyudaaya, n'abakungu be, n'abantu b'omu Yerusalemu abaasigala mu nsi eno, n'abo abaalumukira e Misiri, nze Musengwa Katonda abo boonaboona ndibabisa ng'oti n'emitiini egyo emibi einho, egitasobola na kuliibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kubafuula ekintu ekitiisa einho abantu boonaboona ku nsi, bafuuke eky'okwogerwaku era eky'okuyeeyereza. Baidha kubanga kivumo era kikolimo, eyo yoonayoona ye ndibasansaaniza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.9",
            "verseOrgIds": [
              "JER.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibaleetera entalo era naabasindikira endhala n'endwaire ya kawumpuli, okutuusa lwe balizikirira ni bawaagho mu nsi ye nabagha beene ni badhaadha baibwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.10",
            "verseOrgIds": [
              "JER.24.10"
            ]
          }
        }
      ]
    }
  ],
