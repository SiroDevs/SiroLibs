              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati: “Bona eno, ekiseera kiidha kutuuka mbonereze abo abakekete aye abeebisa ng'oti ti bakekete. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abo ni bano: Abamisiri, Abayudaaya, Abaedomu, Abammoni, Abamoabu, nabo boonaboona ababa mu irungu abasala ku nviiri dhaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:26",
              "type": "text"
            },
            {
              "text": "abasala ku nviiri dhaibwe:",
              "type": "text"
            },
            {
              "text": "Abantu abo ab'omu irungu baasalanga ku nviiri dhaibwe okudhiyimpaya, olw'okugha omusambwa gwaibwe ekitiibwa. Kale Abaisiraeli tibaikirizibwanga kusala ku nviiri dhaibwe mu nsambo ng'oti n'eyo ( Lev 19:27).",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kale ni waire ng'ab'eighanga lya Isiraeli lyonalyona bakekete, aye era beebisa ng'abatali bakekete.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        }
