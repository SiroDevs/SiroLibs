          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.18",
            "verseOrgIds": [
              "JAS.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JAS 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboluganda, owundi ku imwe bw'adaaliima n'ava ku mazima, memale omuntu owundi n'amwiza, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.19",
            "verseOrgIds": [
              "JAS.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyo amwiziiza ali n'okumanha ati: kiisi atoola mukozi wa bibi mu ngira ye ensobu, aja kuwonia omwoyo ogw'omukozi ow'ebibi oyo okufa era ebibi bye olukunkumuli bisoniyibwe.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.20",
            "verseOrgIds": [
              "JAS.5.20"
            ]
          }
        },
        {
