          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo Gideoni yaamanha nga y'aboine abaire malaika wa Musengwa Katonda. Agho yaakoba ati: “Wo Musengwa Katonda wange, nkagwireku! Mboine malaika wo maiso ku maiso!”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        }
      ]
    },
