              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ekiseera nga kibiseegho, omukazi yaazaala omwana mulenzi, yaamutuuma eriina Samusoni. Omwana yaakula, Musengwa Katonda yaamugha enkabi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
