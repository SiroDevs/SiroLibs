            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Manoa yaagema embuzi entototo, n'ekigheebwayo eky'emere ey'empeke, yaabigheerayo agho ku lubaale, ye Musengwa Katonda akola ebyewuninkiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.19",
            "verseOrgIds": [
              "JDG.13.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:19",
              "type": "text"
            },
            {
              "text": "Akola ebyewuninkiriza",
              "type": "text"
            },
            {
              "text": "Mu Luheburayi kikoba kiti",
              "type": "text"
            },
            {
              "text": "Malaika yaakola ebyewuninkiriza nga Manoa ni mukazi we bali kubona.",
              "type": "text"
            }
          ]
        }
      ]
    },
