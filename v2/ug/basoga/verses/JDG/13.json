            "sid": "JDG 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa yaakoba mukazi we ati: “Bwenebwene twidha kufa, kuba tuboine Katonda!”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.22",
            "verseOrgIds": [
              "JDG.13.22"
            ]
