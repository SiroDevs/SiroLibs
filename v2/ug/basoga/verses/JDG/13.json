                "loc": "NUM.6.1+NUM.6.2+NUM.6.3+NUM.6.4+NUM.6.5"
              },
              "items": [
                {
                  "text": "Kub 6:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho omukazi yaaja, yaakobera iba ati: “Omuntu wa Katonda aidhie ye ndi, ng'amaiso ge gatiisa inho ng'oti ga malaika wa Katonda. Timubuuziiza y'aviiriire, era tankobeire liina lye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.6",
            "verseOrgIds": [
              "JDG.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ankobye ati, ‘Bona, oidha kutoola enda ozaale omwana mulenzi. Kale ni otanhwanga mwenge gwa mizabbibu oba ekitamiiza kyonakyona, waire okulya ekintu kyonakyona ekitali kirongoofu kuba omwana oyo aliba Munaziri, okuva lw'alizaalibwa okutuusa lw'alifa.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.7",
            "verseOrgIds": [
              "JDG.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Manoa yaasaba Musengwa Katonda ati: “Wo Musengwa Katonda, nkweghembye leka omuntu wa Katonda ye watumye, aidhe ye tuli kabiri atwegerese kye tuli n'okukolera omwana aja okuzaalibwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda yaakola ekyo Manoa kye yasaba, malaika yaira kabiri y'omukazi, bweyali ng'atyaime mu nimiro. Aye iba, Manoa, tiyali naye agho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.9",
            "verseOrgIds": [
              "JDG.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho omukazi yaalumuka mangu, yaakobera iba ati: “Bona, omuntu ole eyaidha ye ndi ku lunaku lule, aidhie kabiri yambonekera!”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.10",
            "verseOrgIds": [
              "JDG.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.10",
            "verseOrgIds": [
              "JDG.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa yaasituka, yaanonereza mukazi we. Yaaja y'omuntu ole, yaamubuuza ati: “Niiwe omuntu ole eyayogera ni mukazi wange?” Ole yairamu ati: “Ninze.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa yaamubuuza ati: “Ebibono bye wakoba bwe birituukirira, obulamu bw'omwana oyo buliba bwa nsambo ki, era kiki ky'aliba n'okukola?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.12",
            "verseOrgIds": [
              "JDG.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.12",
            "verseOrgIds": [
              "JDG.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa Musengwa Katonda yaamwiramu ati: “Mukazi wo yeegenderezenga okukola byonabyona bye namukoba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.13",
            "verseOrgIds": [
              "JDG.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atalyanga kintu kyonakyona ekiva ku mizabbibu. Atanhwanga mwenge gwa mizabbibu oba ekitamiiza kyonakyona, waire okulya ekintu kyonakyona ekitali kirongoofu. Ebyo bye namulagira by'abe agemenga.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.14",
            "verseOrgIds": [
              "JDG.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.14",
            "verseOrgIds": [
              "JDG.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa yaakoba malaika wa Katonda ati: “Tukweghembye sigala ng'okaaliku n'ife, tukufumbireyo embuzi entototo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.15",
            "verseOrgIds": [
              "JDG.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye malaika wa Musengwa Katonda yaamukoba ati: “Ni bwe nnaasigala nga nkaaliku n'imwe, era tiirye ku mere yaimwe. Aye bwe mwenda okutegeka ekigheebwayo ekyokebwa, mugwaniire kukigha Musengwa Katonda.” Manoa yali amukobye ebyo lwa kuba tiyategeera ng'oyo malaika wa Musengwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa yaakoba malaika wa Musengwa Katonda ati: “Tukobere eriina lyo. Olwo bye wakoba bwe birituukirira, tughange okukutaamu ekitiisa.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa Musengwa Katonda yaamwiramu ati: “Lwaki ombuuza eriina lyange eryewuninkiriza?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.18",
            "verseOrgIds": [
              "JDG.13.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
