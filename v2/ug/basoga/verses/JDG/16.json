        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho baganda be n'ab'endhu ya ise boonaboona, baidha okutwala omulambo gwe. Baamutwala, baamuziika ghagati gh'e Zora n'e Ashitaoli, mu lwambiidhi lwa lata we Manoa. Yali akulembeire Isiraeli okumala emyaka amakumi abiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
