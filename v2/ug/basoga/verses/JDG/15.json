        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.19",
            "verseOrgIds": [
              "JDG.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Samusoni yaakulembera Isiraeli okumala emyaka amakumi abiri, ng'Abafilisiti n'abafuga.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.20",
            "verseOrgIds": [
              "JDG.15.20"
            ]
          }
        }
