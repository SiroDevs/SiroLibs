              "type": "text"
            }
          ]
        },
        {
          "text": "Abamori baasindiikiriza ab'ekika kya Dani, baabairirizaayo mu kiketezo eky'oku nsozi, baaloba kubaganha kwika mu kiketezo eky'oku museetwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
