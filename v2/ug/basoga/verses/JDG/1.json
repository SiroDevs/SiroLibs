          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Abamori abo beeyongera okuba mu Aiyaloni, ni mu Shaalabimu, ni ku lusozi Heresi. Aye ab'ekika kya Efuraimu n'ekya Manasse baabafuganga, era baabakakanga okubakolera emirimo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
