              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'ekika kya Asheri tibaabinga batyamye ba mu bibuga bino: Akko, ni Sidoni, ni Ahalabu, ni Akazibu, ni Afiki, ni Rehobu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ab'ekika kya Asheri abo, baasigala nga bakaali ghalala n'abatyamye abo Abakanaani, kuba tibaababingamu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
