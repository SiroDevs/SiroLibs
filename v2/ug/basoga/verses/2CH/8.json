              "items": [
                {
                  "text": "Ma 16:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yaabighangayo nga bwe kyalinga kiragirwa buli lunaku, ng'Amateeka ga Musa bwe galagira okubighaayo: ku Sabbato, ni ku Kibinuko eky'Okuboneka kw'Omwezi, ni ku bibinuko ebisatu ebya buli mwaka eky'Emigaati Egitazimbulukusiibwa, n'eky'Amakungula, n'eky'Entindi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        }
