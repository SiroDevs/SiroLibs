        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nsambo eyo Solomoni yaamaliriza omulimo gwonagwona, okuviira irala ku lunaku lwe baataagho omusingi gw'eisinzizo, okutuusa lwe lyawa okuzimba. Kale eisinzizo eryo lyamalirizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Kyabazinga Solomoni yaaja mu Ezionigeberi ni mu Elothi, ku mbali kw'enhandha, mu nsi Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Hiramu yaasindika ku bagheereza be n'amaato, abaali n'obumanhi ku by'oku nhandha, baajiira mu maato ago ghalala n'abagheereza ba Solomoni. Baaja mu nsi Ofiri, baatoolayo zaabu agheza kilo ng'oti omutwalo mulala n'enkumi itaanu (15,000), baamuleetera kyabazinga Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
    }
