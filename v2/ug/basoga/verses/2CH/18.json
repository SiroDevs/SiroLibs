          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaia bwe yatuuka mu maiso ga kyabazinga Ahabu, kyabazinga Ahabu oyo yaamubuuza ati: “Nje numbe Ramothi eky'e Gileadi, oba ntakirumba?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaia yaamwiramu ati: “Ja olumbe Ramothi eky'e Gileadi, oidha kukighangula. Musengwa Katonda aidha kukikuta mu ngalo.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        }
      ]
