          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wo Musengwa Katonda, mpegaano ni tulingeku n'amaiso go era otege kutu wo, owulire bye tukusaba mu kifo kino.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
