            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abantu bo bwe banaajanga y'onaabanga ng'obatumye okulwanisa abazigu baibwe, memale ni bakusaba nga balingiriire ekibuga kino kye walonda, era nga balingiriire eisinzizo lino lye nkuzimbiire, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "wuliranga okusaba kwaibwe nga bakweghemba eyo y'oli mu igulu, era obaghenga bye bakusaba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
      ]
    },
