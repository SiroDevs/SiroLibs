              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abantu bo bwe banaakolanga ebibi y'oli, nga bwekiri nti ghazira muntu atakola kibi, memale n'obasungughalira era n'oleka abazigu baibwe ni babaghangula era ni babatwala nga banhage mu nsi ey'abazigu k'ebe ey'okumpi oba ey'eghala, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "aye ni bamala beerowooza nga bali eyo mu nsi ye baatwalibwa ng'abanhage, ni beenenia era ni bakweghemba bati, ‘Twayonoona, twadaaliima era twakola ebibi’, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2CH 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "bawulirenga bwe baneenenianga n'omwoyo gwaibwe gwonagwona nga bali eyo mu nsi y'abazigu baibwe abaabatwala nga banhage. Era obawulirenga bwe banaakusabanga nga balingiriire ensi yaibwe ye wagha badhaadha baibwe, era nga balingiriire ekibuga kye walonda, era n'eisinzizo lino lye nkuzimbiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuliranga bye bakusaba nga bakweghemba eyo y'oli mu igulu, era obaghenga bye bakusaba. Sonighanga abantu bo abo olw'okukola ebibi y'oli ni bakusungughaza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        }
      ]
    },
