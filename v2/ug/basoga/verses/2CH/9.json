            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale atyo kyabazinga Solomoni yaasingira ghala mu bukombe n'amagezi bakyabazinga boonaboona ku nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.22",
            "verseOrgIds": [
              "2CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakyabazinga ab'omu nsi yoonayoona baayendanga okwidha aghali Solomoni oyo, okuwulira ebibono eby'amagezi ge, Katonda ge yamugha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
              "2CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli eyaidhanga, ng'aleeta ekirabo: ebintu bya feeza n'ebya zaabu, ebivaalo, obuwoowo, embalaasi, n'enhumbu. Baaleetanga ebintu ebyo mu bungi buli mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.24",
            "verseOrgIds": [
              "2CH.9.24"
            ]
          }
        }
      ]
