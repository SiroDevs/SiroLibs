                {
                  "text": "1 Bakyab 4:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni era yali n'ebisenge enkumi ina (4,000) eby'embalaasi dhe, n'ebigaali byadho eby'omu lutalo, n'abavuzi ab'embalaasi omutwalo mulala n'enkumi ibiri (12,000), be yata mu bibuga ebikuumirwamu ebigaali eby'omu lutalo ni mu Yerusalemu, mwene mwe yali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
            "verseOrgIds": [
              "2CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Mainh 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.21"
              },
              "items": [
                {
                  "text": "1 Bakyab 4:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Era Solomoni oyo yafuganga bakyabazinga boonaboona okuviira irala ku mwiga Eufurate, okutuukira irala ku nsi y'Abafilisiti, ni ku nsalosalo y'e Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biseera bye, feeza yayala mu Yerusalemu, yaaba mungi ng'oti bwa mabaale. N'emivule gyaba mingi ng'oti miti emisikamore egy'omu biketezo bya Buyudaaya eby'omu biiko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Ma 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Embalaasi Solomoni dhe yali nadho, yadhiragirizanga kuva mu Misiri ni mu nsi edhindi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
      ]
