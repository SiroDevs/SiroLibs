          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
            "verseOrgIds": [
              "2CH.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebindi byonabyona Yothamu bye yakola, n'entalo dhe dhoonadhoona dhe yalwana, era n'enkola ye, byaghandiikibwa mu Kitabo kya Bakyabazinga ba Isiraeli n'aba Buyudaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.7",
            "verseOrgIds": [
              "2CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yothamu oyo yafuuka kyabazinga ng'agheza emyaka amakumi abiri n'etaanu egy'obukulu, era yaafugira entangama ya myaka ikumi na mukaaga mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.8",
            "verseOrgIds": [
              "2CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yaafa yeeyimba ku badhaadha be abaafa, era yaaziikibwa mu kyetebwa Ekibuga kya Daudi. Mutabane we Ahazi yaamusikira ku bwakyabazinga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.9",
            "verseOrgIds": [
              "2CH.27.9"
            ]
          }
        }
      ]
