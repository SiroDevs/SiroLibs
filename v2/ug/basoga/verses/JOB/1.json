            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwali lulala, batabane ba Yobu ni baghala be bwe baali nga bali kulya era nga bali kunhwa omwenge ogw'emizabbibu mu ndhu ya muganda waibwe omukulu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.13",
            "verseOrgIds": [
              "JOB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukwenda yaidha eri Yobu yaakoba ati: “Ente dhibaire dhiri kulima, n'endogoyi nga dhidhiriinaine agho dhiri kulya, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.14",
            "verseOrgIds": [
              "JOB.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "abanhazi Abasabea baadhigwaku, baadhinhaga. Baita abagheereza bo boonaboona; era nze zenka ninze mponiegho okwidha okukukobera.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.15",
            "verseOrgIds": [
              "JOB.1.15"
            ]
          }
        }
      ]
    },
