          },
          "items": [
            {
              "text": "1:16",
              "type": "text"
            },
            {
              "text": "Omuliro gwa Katonda:",
              "type": "text"
            },
            {
              "text": "oba olukuba. 1 Bakyab 18:38",
              "type": "text"
            }
          ]
        },
        {
          "text": " gugwire nga guva mu igulu, gwazikiriza entaama n'abaayi ababaire nga bali kudhaaya; era nze zenka ninze mponiegho okwidha okukukobera.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
            ]
          }
        }
