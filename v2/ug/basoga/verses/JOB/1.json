                "loc": "REV.12.10"
              },
              "items": [
                {
                  "text": "Kwol 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Agho Sitaani yairamu Musengwa Katonda ati: “Olowooza Yobu akutiira bwereere? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamukolera olukomera okumwezunguluza mwene n'amaka ge, n'ebibye byonabyona by'ali nabyo. By'akola byonabyona obigha enkabi, n'obukombe bwe, bweyongeire obungi mu nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.10",
            "verseOrgIds": [
              "JOB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mpegaano golola omukono gwo omutooleku byonabyona by'ali nabyo, aja ku kuvuma ng'obona n'okubona.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.11",
            "verseOrgIds": [
              "JOB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
