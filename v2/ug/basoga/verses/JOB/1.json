              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo yali akaayogera, owundi yaidha yaakoba ati: “Omuliro gwa Katonda ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
            ]
          }
        },
        {
