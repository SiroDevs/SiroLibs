              "JOB.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yaakoba Sitaani ati: “Kale, byonabyona by'ali nabyo biri mu buyinza bwo. Aye mwene otamukolaku kabi.” Agho Sitaani yaava mu maiso ga Musengwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
