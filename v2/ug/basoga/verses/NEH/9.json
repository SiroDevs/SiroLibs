          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalevi bano: Yeshua, Bani, Kadimieli, Shebania, Bunni, Sherebia, Bani, ni Kenani, baayemerera ku madaala g'Abalevi, baasaba Musengwa Katonda waibwe mu mamiro ag'amaani.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.4",
            "verseOrgIds": [
              "NEH.9.4"
            ]
          }
        }
      ]
    },
