                "loc": "DEU.16.13+DEU.16.14+DEU.16.15"
              },
              "items": [
                {
                  "text": "Ma 16:13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era baazuula nga bali n'okulangirira bamanhise ab'omu bibuga byaibwe byonabyona ni mu Yerusalemu bati: “Muje mu nsozi muleete ensaga edh'emiti emyoliva, egyo gye baasimba obusimbe n'egyo egyamera gyene, n'ensaga edh'emiti eminaazi, n'edh'emiti egindi egy'amakaba amangi, muzimbise entindi, nga bwe kyaghandiikibwa.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale abantu baaja baaleeta ensaga edho, baazimba entindi ku ngulu kw'endhu dhaibwe,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:16",
              "type": "text"
            },
            {
              "text": "ku ngulu kw'endhu dhaibwe:",
              "type": "text"
            },
            {
              "text": "Obusolya obw'endhu tibwabangaku migongo, nga buba bwa muserebende.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ni mu mpya dhaibwe, ni mu luya olw'eisinzizo lya Katonda, ni mu luya oluli gha Mulyango ogw'Amaadhi, ni mu luya oluli gha Mulyango ogw'Efuraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boonaboona abaira okuva mu bunhage, baazimba entindi, baadhisulamu. Guno n'ogwali omukuzi ogusooka okukola batyo, okuviira irala mu biseera bya Yoshua mutabane wa Nuni. Kale ghaabaagho okusagamba okw'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.17",
            "verseOrgIds": [
              "NEH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli lunaku, okuva ku lwasooka mu kibinuko ekyo okutuuka ku lwasembayo, baasomanga ekitundu okuva mu Kitabo eky'Amateeka ga Katonda. Baaba ku kibinuko okumala enaku musanvu, ate ku lw'omunaana beesoloza okusinza Katonda, ng'Amateeka bwe galagira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.18",
            "verseOrgIds": [
              "NEH.8.18"
            ]
          }
        }
      ]
    }
  ],
