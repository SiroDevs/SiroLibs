              "EZK.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 29:6"
          },
          "items": [
            {
              "text": "6",
