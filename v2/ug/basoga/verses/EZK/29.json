                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ku lunaku olweikumi n'eibiri mu mwezi ogweikumi, mu mwaka ogweikumi nga tuli mu bunhage, Musengwa Katonda yaayogera ninze, yankoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iwe omuntu, amaiso go galingirize kyabazinga w'e Misiri, olange akabi akalimutuukaku mwene, n'ako akalituuka ku nsi Misiri yoonayoona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.2",
            "verseOrgIds": [
              "EZK.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukobe oti, nze Musengwa Katonda ndi kukoba nti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
