              "EZK.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.17+REV.19.18"
              },
              "items": [
                {
                  "text": "Kwol 19:17-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yankoba ati: “Iwe omuntu, koba enhonhi edha buli nsambo n'ensolo dhoonadhoona edh'omu nsiko, dheesoloze okuva woonawoona dhiidhe ku kibinuko eky'omusengo kye nja okudhitegekera. Kiriba ekibinuko eky'omusengo ekikologho ku nsozi edh'omu Isiraeli. Dhirirya emamba, dhaanhwa n'omusaayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhirirya emamba ey'abalwani ab'amaani, dhaanhwa n'omusaayi ogw'abafuzi b'ensi, ng'oti gwa ntaama nume na ntaama nto, oba ng'oti gwa mbuzi na gwa nte nume nga dhoonadhoona baadhipiitira e Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.18",
            "verseOrgIds": [
              "EZK.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era enhonhi edho n'ensolo edho, nga dhiri ku kibinuko eky'omusengo kye nja okudhitegekera, dhirirya amasavu okutuusa nga dhiigwite, dhaanhwa n'omusaayi okutuusa nga dhigutamiire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhirityama okulya ekiiwulo kye nja okudhitegekera, dhaiguta embalaasi, n'abavuzi baadho, n'abalwani ab'amaani, era n'abaisirukale abandi boonaboona. Nze Musengwa Katonda ninze nkobye.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaakoba ati: “Ndyoleka ekitiisa kyange mu maghanga, abantu baabona bwe nkozesa mu mazima obuyinza bwendi nabwo, okutuukiriza bye mba nsazeegho okukola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.21",
            "verseOrgIds": [
              "EZK.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva ku olwo n'okweyongerayo, ab'eighanga Isiraeli balimanha nga ninze Musengwa Katonda waibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.22",
            "verseOrgIds": [
              "EZK.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era amaghanga galimanha ng'ab'eighanga Isiraeli baatwalibwa mu bunhage lwa bibi byaibwe, kuba baaneefuulaku bandeetera okubalekulira agho, naabaghaayo mu ngalo edh'abazigu baibwe baabaita boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.23",
            "verseOrgIds": [
              "EZK.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababisa nga bwe baali bagwaniire, naabalekulira agho, olw'obutaba balongoofu n'olw'ebibi byaibwe.”",
          "type": "text",
          "attrs": {
