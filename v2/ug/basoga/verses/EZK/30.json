            "number": "2",
            "style": "v",
            "sid": "EZK 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iwe omuntu, langa okobere abantu, nze Musengwa Katonda bye ndi kukoba. Bakobere oti: Muwowoole amaziga nga mukoba muti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        }
