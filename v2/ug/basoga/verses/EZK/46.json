              "EZK.46.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwava agho yantwala ku luya olw'okuliya, yaaja ng'ambisa mu nsonda dhaalwo eina. Naabona nga mu buli nsonda mwalimu oluya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.21",
            "verseOrgIds": [
              "EZK.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empya edho edhaali mu nsonda dhaali ntono, ng'obuleeyi dhigheza mita amakumi abiri ate obugazi dhaagheza mita ikumi na itaanu. Era empya edho eina dhoonadhoona dhaali dhaagayaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu buli luya mwalimu ebimante bye baazimbisa amabaale, era nga ghansi gh'ebimante ebyo ghaligho eziiko okwezunguluza buli kimante. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.23",
            "verseOrgIds": [
              "EZK.46.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaadha yankoba ati: “Ago n'amafumbiro abagheereza ab'omu isinzizo ge banaafumbirangamu emamba ey'emisengo, abantu gye baghaayo.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.24",
            "verseOrgIds": [
              "EZK.46.24"
            ]
          }
        }
