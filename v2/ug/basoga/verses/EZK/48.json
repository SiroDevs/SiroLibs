      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gano n'amaina ag'ebika nga bwe baligabana eitaka: Ekika kya Dani kirifuna omugabo mulala nga gwa kiketezo ekiva ku nsalosalo eri ku luuyi olw'omukono omugooda olw'e buvandhuba. Nga kiviira ku Nhandha Eyaghagati, kyabitira e Hethiloni, kyatuuka gh'oingirira e Hamathi, era kyeyongerayo kyatuuka e Hazari Enoni, ku nsalosalo ey'oku luuyi olw'omukono omugooda olw'e buvandhuba ghagati gha Damasiko ni Hamathi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekika kya Asheri kyona kirifuna omugabo mulala nga gwa kiketezo ekigabana ensalosalo endala n'ekiketezo eky'ekika kya Dani. Nga kiva ku nsalosalo ey'e buvandhuba kyatuuka ku y'e bugwandhuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekika kya Nafutali kyona kirifuna omugabo mulala nga gwa kiketezo ekigabana ensalosalo endala n'ekiketezo eky'ekika kya Asheri. Nga kyona kiva ku nsalosalo ey'e buvandhuba kyatuuka ku y'e bugwandhuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekika kya Manasse kyona kirifuna omugabo mulala nga gwa kiketezo ekigabana ensalosalo endala n'ekiketezo eky'ekika kya Efuraimu. Nga kyona kiva ku nsalosalo ey'e buvandhuba kyatuuka ku y'e bugwandhuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekika kya Efuraimu kyona kirifuna omugabo mulala nga gwa kiketezo ekigabana ensalosalo endala n'ekiketezo eky'ekika kya Manasse. Nga kyona kiva ku nsalosalo ey'e buvandhuba kyatuuka ku y'e bugwandhuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekika kya Reubeni kyona kirifuna omugabo mulala nga gwa kiketezo ekigabana ensalosalo endala n'ekiketezo eky'ekika kya Efuraimu. Nga kyona kiva ku nsalosalo ey'e buvandhuba kyatuuka ku y'e bugwandhuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekika kya Yuda kyona kirifuna omugabo mulala nga gwa kiketezo ekigabana ensalosalo endala n'ekiketezo eky'ekika kya Reubeni. Nga kyona kiva ku nsalosalo ey'e buvandhuba kyatuuka ku y'e bugwandhuba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghalibaagho ekiketezo kye mulyawulaku eky'endhawulo, nga kigabana ensalosalo ndala n'ekiketezo eky'ekika kya Yuda. Kiriba n'obugazi bwa kilomita ikumi na ibiri n'ekitundu, ate nga mu buleeyi kyagayaga n'ekiketezo eky'ekika ekiramba, okuva mu buvandhuba okutuuka mu bugwandhuba. Ghagati gh'ekiketezo ekyo n'aghaliba eisinzizo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiketezo ekyo kye mulyawulaku nga kya Musengwa Katonda, kiriba n'obuleeyi bwa kilomita ikumi na ibiri n'ekitundu, ate obugazi kyaba ni kilomita ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "48:9:",
              "type": "text"
            },
            {
              "text": "Ebighandiiko ebindi eby'eira bikoba",
              "type": "text"
            },
            {
              "text": "Kilomita ikumi,",
              "type": "text"
            },
            {
              "text": "aye Oluheburayi lukoba",
              "type": "text"
            },
            {
              "text": "Kilomita itaanu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo n'ekiketezo ekitukuvu era muti bwe mulikigabaniamu: Bakabona balifunaku ekitundu ekigheza obuleeyi bwa kilomita ikumi na ibiri okuva mu buvandhuba okutuuka mu bugwandhuba, era nga kigheza n'obugazi bwa kilomita itaanu okuva ku luuyi olw'omukono omugooda olw'e buvandhuba okutuuka ku luuyi olw'omukono omusaadha olw'e bugwandhuba. Ekitundu ekyo ekitukuvu n'ekiribaamu eisinzizo lya Musengwa Katonda ghagati ghaakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kiriba kya bakabona Abalevi abaatukuzibwa nga ba ku nda ya Zadoki, abaasigala nga bakampeereza mu isinzizo lyange n'obwesigwa, mu kiseera Abaisiraeli abandi boonaboona kye banviiraku ni badaaliima, ng'oti n'Abalevi abandi bwe baakola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriba kyaibwe ng'omugabo gwaibwe ogwayawulwa okuva ku kiketezo ekitukuvu einho, era kiriba nga kiriiraine n'ekitundu eky'Abalevi abandi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalevi abandi boona baliba n'ekitundu ekyaibwe ng'omugabo, nga kiriiraine n'ekya bakabona ab'oku nda ya Zadoki. Kyona kirigheza obuleeyi bwa kilomita ikumi na ibiri okuva mu buvandhuba okutuuka mu bugwandhuba, era kyagheza n'obugazi bwa kilomita itaanu okuva ku luuyi olw'omukono omugooda olw'e buvandhuba okutuuka ku luuyi olw'omukono omusaadha olw'e bugwandhuba. Ng'ogaise aghalala ekitundu kyonakyona, ekya bakabona n'eky'Abalevi, kiriba kilomita ikumi na ibiri mu buleeyi, ni kilomita ikumi mu bugazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiketezo ekyo kye mulyawulaku nga kya Musengwa Katonda mwene, n'ekirisinga bulungi mu nsi eyo yoonayoona era kiriba kitukuvu. Tikiritundibwaku naire, waire okukifaanisaamu, oba okukigha omuntu owundi yeenayeena.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekitundu ekirisigalagho ku kiketezo ekitukuvu, nga kya kilomita ikumi na ibiri n'ekitundu obuleeyi ni kilomita ibiri n'ekitundu obugazi, kiriba kya kukozesebwanga bantu boonaboona. Kiribaamu amayumba g'abantu, n'ebifo eby'okulimiramu emere, n'eby'okwayiramu ebyayo. Era ghagati ghaakyo n'aghaliba ekibuga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga kyagayaga mu buleeyi ni mu bugazi, mita enkumi ibiri na bibiri n'ataanu (2,250), ku mita enkumi ibiri na bibiri n'ataanu (2,250). ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibuga ekyo kiryezungululwa ekifo ekirisigala nga kyereere, nga kya mita kikumi n'abiri na itaanu (125) ku ndhuyi dhoonadhoona ku luuyi olw'omukono omugooda olw'e buvandhuba, ku luuyi olw'omukono omusaadha olw'e buvandhuba, ku luuyi olw'e buvandhuba, ni ku luuyi olw'e bugwandhuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitaka eririsigalagho okuliiraana n'ekiketezo ekitukuvu ekyayawulwaku, nga lya buleeyi bwa kilomita itaanu e buvandhuba ni kilomita itaanu e bugwandhuba, abantu ababa mu kibuga n'abanaalirimangamu emere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ababa mu kibuga nga bava mu bika byonabyona eby'omu Isiraeli, agho ghe banaalimiranga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kale ekiketezo kyonakyona kye mulyawulaku, kiriba nga kyagayaga mu buleeyi ni mu bugazi, kilomita ikumi na ibiri n'ekitundu ku kilomita ikumi na ibiri n'ekitundu. Era nga kizingiramu ekitundu ekitukuvu n'ekitundu eky'okuzimbamu ekibuga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekiketezo ekirisigalagho ku luuyi ni ku luuyi okw'ekifo ekitukuvu, ni ku luuyi ni ku luuyi okw'ekifo omuli ekibuga, kinaabanga kya kyabazinga. Ekiketezo ekyo kinaajanga nga kinonereza ensalosalo edhikyawula ku migabo gy'ebika, era kirimalirayo irala obuleeyi bwa kilomita ikumi na ibiri n'ekitundu okuva ku nsalosalo ey'e buvandhuba okutuuka ku nsalosalo ey'e bugwandhuba. Kale ekifo ekitukuvu ekyayawulwaku, n'eisinzizo lyene, biriba mu kiketezo kya kyabazinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'ekifo kya bakabona, n'eky'Abalevi abandi, n'eky'ekibuga, byonabyona biribanga mu kiketezo kya kyabazinga. Ku luuyi olw'omukono omugooda olw'e buvandhuba, aligabananga ensalosalo n'ekika kya Yuda, ate ku luuyi olw'omukono omusaadha olw'e buvandhuba yaagabana ensalosalo n'ekika kya Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
