              "type": "text"
            }
          ]
        },
        {
          "text": " Agho Katonda yankoba ati: “Iwe omuntu, lya enzingo ey'ekitabo eyo ekugheereibwa, omale oje oyogere n'abantu b'omu Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        }
