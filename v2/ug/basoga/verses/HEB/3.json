              "items": [
                {
                  "text": "Zab 95:7-11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.11",
            "verseOrgIds": [
              "HEB.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale aboluganda, mwegendereze ghalobe kubaagho naire mulala ku imwe aba na mwoyo mubi era ogutaikiriza, n'ava ku Katonda omulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.12",
            "verseOrgIds": [
              "HEB.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mulambaganenga buli lunaku, kasita luba nga lwetebwa “Olwaleero”, ghalobe kubaagho naire omulala ku imwe obuguya obw'ekibi ye bukalangusa omwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.13",
            "verseOrgIds": [
              "HEB.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiri nti tuba tuli kwisa kirala mu Kurisito, kasita tukalangula obwesige bwaife bwe twatoolera nabwo, ni tubutuukiza irala ku nkomerero. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.14",
            "verseOrgIds": [
              "HEB.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyaghandiikibwa bikoba biti:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.15",
            "verseOrgIds": [
              "HEB.3.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
