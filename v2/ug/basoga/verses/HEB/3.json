              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.6",
            "verseOrgIds": [
              "HEB.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ni nga Mwoyo Mutukuvu bw'akoba ati:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.7",
            "verseOrgIds": [
              "HEB.3.7"
            ]
          }
        },
        {
          "name": "note",
