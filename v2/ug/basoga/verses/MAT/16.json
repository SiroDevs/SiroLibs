          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Yesu yaakyuka yaakoba Petero ati: “Nva mu maiso Sitaani, oli kitimuguunha mu ngira yange kuba ebya Katonda tobitegeera, otegeera bya bantu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
              "MAT.16.23"
            ]
