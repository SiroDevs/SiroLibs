              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
            "verseOrgIds": [
              "MAT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Era ka mbakobere: Ababiri ku imwe bwe baisania ku kintu kye basaba, Lata wange ali mu igulu alikibakolera ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba ababiri oba abasatu ghe beesololeza mu liina lyange, zeena mbaagho agho ghagati waibwe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.20",
            "verseOrgIds": [
              "MAT.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.20",
            "verseOrgIds": [
              "MAT.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Petero yaaseeta yaamukoba ati: “Musengwa, muganda wange ng'ankoze ekibi nnaamusonighanga kutuusa li? Okutuusa ku mikuzi musanvu?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.3+LUK.17.4"
              },
              "items": [
                {
                  "text": "Luk 17:3-4",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaamukoba ati: “Tikukoba nti okutuuka ku mikuzi musanvu aye, okutuuka ku nsanvu emikuzi musanvu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.24"
              },
              "items": [
                {
                  "text": "Mainh 4:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwakyabazinga obw'omu igulu kyebuva bufaananizibwa ku kyabazinga eyayenda okugondhoola n'abagheereza be ebigema ku bintu bye, bye baali nabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.23",
            "verseOrgIds": [
              "MAT.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yatoolera okutereeza embalirira ye, baamuleetera eyali n'eibandha lye lya mutwalo gwa talanta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:24",
              "type": "text"
            },
            {
              "text": "mutwalo gwa talanta:",
              "type": "text"
            },
            {
              "text": "Talanta endala eti nga kumpi eyagayaga n'empeera ey'omupakasi y'akolera okumala emyaka eikumi n'etaanu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye olw'okuba yali nga tasobola kulisasula, musengwa we n'okulagira bamutane, ni mukazi we, n'abaana, n'ebintu bye byonabyona bye yali nabyo, eibandha lisasulwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.25",
            "verseOrgIds": [
              "MAT.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.25",
            "verseOrgIds": [
              "MAT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agho omugheereza yaakuba amakiryaivu yaamweghemba ng'akoba ati, ‘Nguminkiriza, ndidha kukusasula byonabyona.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.26",
            "verseOrgIds": [
              "MAT.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa w'omugheereza oyo yaamugemerwa ekisa yaamuleka, era yaamusonigha n'eibandha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.27",
            "verseOrgIds": [
              "MAT.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.27",
            "verseOrgIds": [
              "MAT.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye omugheereza oyo bwe yali afuluma yaayagaana mugheereza mwine ye yali abandha dinari kikumi. Yaamugema, yaamugwa mu mamiro nga bw'amukoba ati, ‘Nsasula eibandha lyange.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.28",
            "verseOrgIds": [
              "MAT.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugheereza mwine ono yaakuba amakiryaivu yaamweghemba ng'akoba ati, ‘Nguminkiriza ndidha kukusasula.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.29",
            "verseOrgIds": [
              "MAT.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye yaaloba, era yaaja yaamuta mu ikomera okutuusa ng'amusaswire eibandha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.30",
            "verseOrgIds": [
              "MAT.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagheereza baine bwe baabona ebikoleibwa, baanakughala inho, era baaja baakobera musengwa waibwe byonabyona ebyabaagho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.31",
            "verseOrgIds": [
              "MAT.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho musengwa we yaamweta, yaamukoba ati, ‘Mugheereza iwe omubi, nakusoniighe eibandha eryo lyonalyona kuba waneegayiriire ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.32",
            "verseOrgIds": [
              "MAT.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kale iwe weena obaire togwaniire kusaasira mugheereza mwino nga nze zeena bwe nakusaasiire?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.33",
            "verseOrgIds": [
              "MAT.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa yaanakughala inho, era yaamughaayo mu ikomera bamudaazedaaze, okutuusa ng'asaswire eibandha lyonalyona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.34",
            "verseOrgIds": [
              "MAT.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo ni, Lata wange ali mu igulu bw'alibakola, okutoolaku nga buli muntu asonigha muganda we mu mwoyo gwe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.35",
            "verseOrgIds": [
              "MAT.18.35"
            ]
          }
        }
      ]
    }
