        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baasomoka, baatuuka mu kiketezo eky'e Gennesareti. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.34",
            "verseOrgIds": [
              "MAT.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'eyo bwe baamumanha baatuma woonawoona mu nsi eyo baaleeta ye yali abalwaire boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.35",
            "verseOrgIds": [
              "MAT.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamweghemba aganhe kasinga bageme bwa ku lusa olw'ekivaalo kye era boonaboona abaagemaku baawona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.36",
            "verseOrgIds": [
              "MAT.14.36"
            ]
          }
