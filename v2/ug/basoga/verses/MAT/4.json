            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabiri Sitaani yaamutwala ku lusozi oluleeyi einho, yaamulaga obwakyabazinga obw'ensi n'ekitiisa kyabwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.8",
            "verseOrgIds": [
              "MAT.4.8"
