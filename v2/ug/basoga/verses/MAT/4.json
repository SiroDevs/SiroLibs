              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakoba ati: “Munnonereze, ndidha kubafuula abavubi ab'abantu.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.19",
            "verseOrgIds": [
              "MAT.4.19"
            ]
          }
        },
