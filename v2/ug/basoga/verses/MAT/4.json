          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yamala okusiiba enaku amakumi ana (40), omusana n'obwire, endhala yaamuluma. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukemi yaaseeta, yaamukoba ati: “Oba oli Mwana wa Katonda koba amabaale gano gafuuke emigaati.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.3",
            "verseOrgIds": [
              "MAT.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
