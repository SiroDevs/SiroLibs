          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yaamukoba ati: “Ebyo byonabyona ndidha kubikugha bwe weeyala ghansi n'onsinza.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.9",
            "verseOrgIds": [
              "MAT.4.9"
