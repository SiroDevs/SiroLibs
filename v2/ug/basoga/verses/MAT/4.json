            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Sitaani yaatwala Yesu mu kibuga ekitukuvu, yaamuniinia ku kasulya ak'eisinzizo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.5",
            "verseOrgIds": [
              "MAT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaamukoba ati: “Oba oli Mwana wa Katonda, weesuule ghansi kuba kyaghandiikibwa kiti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
