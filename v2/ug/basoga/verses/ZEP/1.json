        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati: “Nja kuleetera abantu ebizibu batuuke n'okutambula nga bamaamanta ng'oti batulu, kuba bakoze ebibi ebinsungughaza. Omusaayi gwaibwe guja kuyuyibwa ku itaka ng'oti maadhi, n'emirambo gyaibwe girekebwe agho ng'oti busa.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.17",
            "verseOrgIds": [
              "ZEP.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
