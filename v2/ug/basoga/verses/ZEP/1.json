            "sid": "ZEP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buno n'obukwenda Musengwa Katonda bwe yatuma Zefania aje akobere abantu, mu biseera bya kyabazinga wa Buyudaaya eyayetebwanga Yosia, eyali mutabane wa Amoni. Zefania oyo yali mutabane wa Kushi, Kushi yali mutabane wa Gedalia, Gedalia yali mutabane wa Amaria, Amaria yali mutabane wa kyabazinga Hezekia.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
