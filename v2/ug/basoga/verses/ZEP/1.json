          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.17",
            "verseOrgIds": [
              "ZEP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEP 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo Musengwa Katonda lw'aliragiraku obusungu bwe ezira kirisobola kubawonia, waire feeza ni zaabu waibwe yeenayeena. Obusungu bwe obuli ng'oti muliro, obuva ku nkikidi y'ali nayo ku lw'abantu be, buja kuzikiriza ensi yoonayoona. Aja kutuusa abantu boonaboona ababa ku nsi, ku nkomerero yaibwe eriba ya mangu inho ng'oti kutemya na kuzibula.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.18",
            "verseOrgIds": [
              "ZEP.1.18"
            ]
          }
        }
      ]
