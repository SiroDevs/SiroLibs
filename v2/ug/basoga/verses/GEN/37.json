              "GEN.37.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo, abasuubuzi baali bamaze okutunda Yosefu mu Misiri, nga bamuguziiza Potifari omukungu wa kyabazinga w'e Misiri, era omukulu w'abaisirukale abaakuumanga ekisaagaati kya kyabazinga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
