              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusota gwali gwa lugezigezi okusinga ensolo edh'omu nsiko edhindi dhoonadhoona Musengwa Katonda dhe yakola. Agho gwabuuza omukazi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "text": " guti: “Obwo bwenebwene Katonda yakoba ati mutalyanga kibala kya ku muti gwa mu nimiro waire omulala guti?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "name": "note",
