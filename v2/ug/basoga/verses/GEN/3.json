          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Musengwa Katonda yaamutoola mu nimiro ey'e Edeni, alimenga eitaka mwe yakolebwa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaamubingira kuliya. Ku luuyi olw'enimiro olw'e buvandhuba yataayo ebitonde ebiri n'amaghagha ebyetebwa kerubi, era n'empiima eyaka, era ng'ekyukira ku ndhuyi dhoonadhoona okukuumanga engira eja ku muti ogw'obulamu.",
          "type": "text",
