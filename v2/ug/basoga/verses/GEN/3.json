          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaakoba ati: “Bona, omuntu afuuse ng'oti niife, okumanhanga obulungi n'obubi. Tutamuganha kunoga kibala ku muti ogw'obulamu, na kukirya, n'aghangaala byanda na byanda.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
