            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho endhala yaagwa mu Kanaani, Aburamu yaaja mu Misiri yaasenga eyo okumala entangama, kuba endhala yali egwire ya maani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
            "verseOrgIds": [
              "GEN.12.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.1+GEN.20.2+GEN.20.3+GEN.20.4+GEN.20.5+GEN.20.6+GEN.20.7+GEN.20.8+GEN.20.9+GEN.20.10+GEN.20.11+GEN.20.12+GEN.20.13+GEN.20.14+GEN.20.15+GEN.20.16+GEN.20.17+GEN.20.18"
              },
              "items": [
                {
                  "text": "Mainh 20:1-18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.7+GEN.26.8+GEN.26.9+GEN.26.10+GEN.26.11"
              },
              "items": [
                {
                  "text": "26:7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
            "verseOrgIds": [
              "GEN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yali ng'ali kumpi okwingira mu Misiri, yaakoba mukazi we Sarai ati: “Bona, ndidhi ng'oli mukazi aboneka obulungi einho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.11",
            "verseOrgIds": [
              "GEN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era Abamisiri bwe banaakubona baidha kukoba bati ono ni mukazi we olwo nze bandhite, aye iwe bakuleke obeegho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.12",
            "verseOrgIds": [
              "GEN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale iwe oidha kubakoba oti oli mwanhinaze, memale olwo mbisibwe bukalamu era mpone okwitibwa ku lulwo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.13",
            "verseOrgIds": [
              "GEN.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu bweyaingira mu Misiri, Abamisiri baabona nga bwenebwene omukazi yali mulungi inho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.14",
            "verseOrgIds": [
              "GEN.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era abakungu aba kyabazinga bwe baamubona, baaghayiraku kyabazinga ku bulungi bwe. Olwo Sarai yaatwalibwa mu kisaagaati kya kyabazinga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.15",
            "verseOrgIds": [
              "GEN.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ku lulwe, kyabazinga yaabisa Aburamu bukalamu yaamugha entaama, n'ente, n'endogoyi enume n'enkazi, n'abairu abasaadha n'abakazi, era n'engamiya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.16",
            "verseOrgIds": [
              "GEN.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
