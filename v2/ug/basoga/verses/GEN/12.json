            }
          ]
        },
        {
          "text": "“Abo abakusabira enkabi, nnaabaghanga enkabi, aye abo abakukolimira zeena ndidhanga kubakolimira. Era mu iwe amaghanga goonagoona mwe galigheerwa enkabi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        },
