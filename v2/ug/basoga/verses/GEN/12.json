              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Aburamu yaaja nga Musengwa Katonda bweyamukoba ni Loti yaaja naye. Aburamu ghe yaviira e Harani yali agheza emyaka nsanvu n'etaanu (75) egy'obukulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.4",
            "verseOrgIds": [
              "GEN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatwala mukazi we Sarai, ni Loti omwana wa muganda we, n'ebintu byaibwe byonabyona bye baali nga bagheziiza, era n'abantu be baali bafuniire e Harani. Kale baatoolera olugendo oluja mu nsi ey'e Kanaani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
