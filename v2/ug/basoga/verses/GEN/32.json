              "type": "text"
            }
          ]
        },
        {
          "text": "Endhuba yaja okuvaayo okumwakaku, ng'ali kuva e Penieli, ng'aghenhera olw'ekisambi kye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
