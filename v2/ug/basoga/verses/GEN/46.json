            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
            "verseOrgIds": [
              "GEN.46.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 46:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yaatuma Yuda okumusookayo, aje eri Yosefu amukobe abaagaane e Gosheni. Baatuuka mu kiketezo eky'e Gosheni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
            "verseOrgIds": [
              "GEN.46.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 46:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu yaategeka ekigaali kye eky'omu lutalo, y'aja e Gosheni okwagaanana ni Isiraeli ise. Bwe baayagaanana, Yosefu yaagwa ise mu kifuba, era yaalira amaziga okumala entangama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.29",
            "verseOrgIds": [
              "GEN.46.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 46:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraeli yaakoba Yosefu ati: “Ni bwe nfa mpegaano tifaayo, kasita nkuboineku naamanha ng'okaali mulamu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
        }
      ]
    },
