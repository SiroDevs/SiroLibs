  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1TI 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otadhuukanga musaadha mukaire, aye mulambenga nga lata wo, ate abaisuka batwalenga nga baganda bo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.1",
            "verseOrgIds": [
              "1TI.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakazi abakaire batwalenga nga bainhoko, ate abaguna batwalenga nga baanhoko. Ebyo bikolenga n'omwoyo omunaabuufu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.2",
            "verseOrgIds": [
              "1TI.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.2",
            "verseOrgIds": [
              "1TI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banamwandu beene liina, batengamu ekinhagansi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.3",
            "verseOrgIds": [
              "1TI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ghabaagho namwandu ali n'abaana oba abaidhukulu, bano basookenga okumanha endhikiriza yaibwe ky'ebakoba okukoleranga amaka ag'ewaibwe, n'okusasulaku abazaire baibwe kuba ekyo Katonda ky'asiima. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.4",
            "verseOrgIds": [
              "1TI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo aba namwandu mwene liina asigaire yenka, eisuubi lye liba mu Katonda. Afuba okweghembanga n'okusaba Katonda omusana n'obwire. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.5",
            "verseOrgIds": [
              "1TI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye namwandu oyo ajiira ku by'amasanhu aba mufu, waire aba ng'akaatambula. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.6",
            "verseOrgIds": [
              "1TI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakobe otyo, balobe kubaaku kibi kye baboogeraku. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.7",
            "verseOrgIds": [
              "1TI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo atafa ku babe, n'okusingira irala ab'omu ndhu ye, aba yeegaine okwikiriza, era aba mubi okusinga ataikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.8",
            "verseOrgIds": [
              "1TI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.8",
            "verseOrgIds": [
              "1TI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwandu okughandiikibwa mu banamwandu, ateekwa okuba ng'agheza emyaka nkaaga egy'obukulu. Era ateekwa okuba nga yabayiraku omusaadha mulala yenka. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.9",
            "verseOrgIds": [
              "1TI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwandu oyo ateekwa okuba nga amanhiibwa olw'ebikolwa ebikalamu: nga yakuza bukalamu abaana be, nga yasangaaliranga abageni, nga yanaazanga ebigere eby'abantu ba Katonda, nga yayambanga abali mu buzibu, era nga yeeghaayo inho okukola obukalamu mu buli nsambo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.10",
            "verseOrgIds": [
              "1TI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye toganhanga kughandiika banamwandu abakaali abato, kuba amairu ag'okubayira bwe gabatanuka, bava ku Kurisito. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.11",
            "verseOrgIds": [
              "1TI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo nga beetaaku omusango ogw'obutatuukiriza ekyo kye baasooka okumusuubiza. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.12",
            "verseOrgIds": [
              "1TI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ekindi beenazaaku omuze ogw'okuba agho nga bazira kye bakola, baayengeeta okubuna amayumba. Ate tibakoma ku kuba agho nga bazira kye bakola, aye bongeraku n'okuba n'olugambo, nga bengiza mu bitabagemaku, baayogera n'ebitagwaniire kwogera. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.13",
            "verseOrgIds": [
              "1TI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyenva nhenda banamwandu abato babayirenga bazaale abaana, era balabirirenga amaka gaibwe. Olwo lwe bataaleetere muzigu kuba na kaghagaanhia ka kutwogeraku bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.14",
            "verseOrgIds": [
              "1TI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba banamwandu abandi baagonhoka ira, baanonereza Sitaani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.15",
            "verseOrgIds": [
              "1TI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye bweghabaagho omukazi yeenayeena Omukurisito ali n'abantu be nga banamwandu, oyo mwene n'abe abalabirirenga, Ekikunsu eky'Abaikiriza mu Kurisito kirobe kuzitooghererwa, kisobole okulabiriranga banamwandu beene liina abaziraku abayamba.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.16",
            "verseOrgIds": [
              "1TI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.16",
            "verseOrgIds": [
              "1TI.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulembeze b'abaikiriza abakola obukalamu, bagwaniire empeera ya mikuzi ebiri, ng'abasinga n'abo abakalabatana okukobera n'okwegeresa abantu ekibono kya Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.17",
            "verseOrgIds": [
              "1TI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba ebyaghandiikibwa bikoba biti: “Tosibanga nte munwa bw'eba ng'emulungula engaano”. Era biti: Omukozi agwana okusasulwa enkemba ye.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.4"
              },
              "items": [
                {
                  "text": "Ma 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.10"
              },
              "items": [
                {
                  "text": "Mat 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.7"
              },
              "items": [
                {
                  "text": "Luk 10:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Towulirisanga bye boogera ku mukulembeze wa baikiriza, okutoolaku nga biriku abadhulizi babiri oba basatu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.19",
            "verseOrgIds": [
              "1TI.5.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.6"
              },
              "items": [
                {
                  "text": "Ma 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.19",
            "verseOrgIds": [
              "1TI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye abo aboonoonanga obakobangaku ng'abantu boonaboona babona, abandi baasobola okutya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.20",
            "verseOrgIds": [
              "1TI.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkusikirira mu maiso ga Katonda, ni Kurisito Yesu, ni bamalaika abatukuvu, ojiirenga ku biragiro bino buliidho, aghazira kwekubira oba okusaliriza. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.21",
            "verseOrgIds": [
              "1TI.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyanguyirizanga kwisa mikono ku muntu yeenayeena. Tiweetabanga mu bibi bya bandi. Weekuumenga ng'oli mwamufu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.22",
            "verseOrgIds": [
              "1TI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otanhwanga maadhi gonka aye onhwangaku ni ku twenge otw'emizabbibu olw'enda yo n'olw'okulwalalwala kwo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
            "verseOrgIds": [
              "1TI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
            "verseOrgIds": [
              "1TI.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibi by'abantu abandi biboneka mangu nga bakaali nakusalirwa musango, aye eby'abandi bizuuka lumaliira. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.24",
            "verseOrgIds": [
              "1TI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ebikolwa ebikalamu bityo biboneka mangu. Ni bwe bitaboneka mangu, birwa eira byaboneka.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.25",
            "verseOrgIds": [
              "1TI.5.25"
            ]
          }
        }
      ]
    }
  ],
