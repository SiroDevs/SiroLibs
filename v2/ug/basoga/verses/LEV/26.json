              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13+GEN.28.14"
              },
              "items": [
                {
                  "text": "28:13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 26:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ensi enaasookanga kulekebwa agho yaazika, beene nga baziramu. Olwo yaawuumula, era ni beene baaganha okubonerezebwa olw'okudheemera ebiragiro byange, n'obutagema mateeka gange. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.43",
            "verseOrgIds": [
              "LEV.26.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 26:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye waire ng'ebyo binaabanga bityo, bwe banaabanga nga bakaali mu nsi y'abazigu baibwe, tiibalekulirenga agho oba okubakyagha obujiiririire, ni mmenhagho ndagaano ye nakola nabo; kuba ninze Musengwa Katonda waibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 26:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kwizangagho buyaaka endagaano ye nakola ni badhaadha baibwe, bwe nayoleka amaghanga goonagoona obuyinza bwange nga mbatoola mu Misiri, nze Musengwa Katonda mbenga Katonda waibwe.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        }
      ]
    },
