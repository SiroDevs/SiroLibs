          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muteekoleranga bifaananie, oba ebiwumbe, oba empango ezimbibwa, oba eibaale eibaadhe, nga bya kusinzibwa. Ninze Musengwa Katonda waimwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
