              },
              "items": [
                {
                  "text": "27:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuzenga olunaku lwa Sabbato, era mutenga ekitiisa mu Kifo kyange Ekitukuvu. Ninze Musengwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwe munaajiiranga ku mateeka gange, era ni mugondera ebiragiro byange,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.3",
            "verseOrgIds": [
              "LEV.26.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.13+DEU.11.14+DEU.11.15"
              },
              "items": [
                {
                  "text": "Ma 11:13-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.1+DEU.28.2+DEU.28.3+DEU.28.4+DEU.28.5+DEU.28.6+DEU.28.7+DEU.28.8+DEU.28.9+DEU.28.10+DEU.28.11+DEU.28.12+DEU.28.13+DEU.28.14"
              },
              "items": [
                {
                  "text": "28:1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.3",
            "verseOrgIds": [
              "LEV.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nnaabaghanga amaadhi mu biseera byago, ensi yaabaza ebirime, n'emiti gyabala ebibala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.4",
            "verseOrgIds": [
              "LEV.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebirime byaimwe binaabalanga inho, mwakuba engaano okutuukiza irala ni mu biseera eby'okunoga emizabbibu, era mwanoga emizabbibu okutuukiza irala ni mu biseera eby'okusigiramu engaano. Munaalyanga emere mwaiguta, era munaabanga n'emiraala mu nsi yaimwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.5",
            "verseOrgIds": [
              "LEV.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.5",
            "verseOrgIds": [
              "LEV.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nnaabaghanga emiraala mu nsi yaimwe, mwatendukanga nga ghazira kibatiisa. Era ndimalagho ensolo edh'akabi mu nsi yaimwe, ensi yaimwe yaaloba kubangamu ntalo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.6",
            "verseOrgIds": [
              "LEV.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwidha kughangulanga abazigu baimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.7",
            "verseOrgIds": [
              "LEV.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abataanu ku imwe baidha kughangulanga ekikumi, n'ekikumi ku imwe baidha kughangulanga omutwalo omulamba. Mu lutalo, abazigu baimwe munaabaitanga mwabamaliriragho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.8",
            "verseOrgIds": [
              "LEV.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe nnaabaghanga enkabi, n'okuzaala abaana kamaala, era nnaakuumanga endagaano ye nakola n'imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.9",
            "verseOrgIds": [
              "LEV.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munaalyanga ku bingi bye mwakungula eira, era munaabifulumyanga ku luya mughange okwingiza ebiyaaka ebikungwirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.10",
            "verseOrgIds": [
              "LEV.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaabanga mu imwe, era tiibakyaghenga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.11",
            "verseOrgIds": [
              "LEV.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaabanga mu imwe, nga ninze Katonda waimwe, mwena munaabanga bantu bange.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.12",
            "verseOrgIds": [
              "LEV.26.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Kor 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.12",
            "verseOrgIds": [
              "LEV.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninze Musengwa Katonda waimwe, eyabatoola mu Misiri, mulekere okuba abairu. Naatoolagho obuyinza obwali bubasibiire ghansi, naabatambuza nga mwesimbye.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yaakoba ati: “Aye bwe mutampulirenga ni mugondera biragiro byange ebyo byonabyona, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.14",
            "verseOrgIds": [
              "LEV.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "era bwe munaalobanga okugema amateeka gange ni mukyagha obukyaghe bye mbakoba, era ni mutagondera biragiro byange byonabyona, mu nsambo eyo ni mumenha endagaano ye nakola n'imwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.15",
            "verseOrgIds": [
              "LEV.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndibabonereza nti: ndireeta entiisa mu imwe. Omusuudha ogw'amaani n'endwaire edhitawonezeka biribatulughaza amaiso, byaleetera obulamu bwaimwe okuja nga buwaagho. Mulisiga ensigo aye tidhiribagasa, kuba abazigu baimwe balibaghangula baalya bye musize. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.16",
            "verseOrgIds": [
              "LEV.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe ndibeefuulaku, mwaghangulwa abazigu baimwe, mwafugibwa abantu abatabenda. Munaabanga n'entiisa, mwalumuka nga ghazira n'ali kubabinga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.17",
            "verseOrgIds": [
              "LEV.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.17",
            "verseOrgIds": [
              "LEV.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ebyo byonabyona bwe binaamalanga okubaagho, era ni musigala nga timukampulira, ekibonerezo kyaimwe ndidha kukyongerangaku emikuzi musanvu olw'ebibi byaimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.18",
            "verseOrgIds": [
              "LEV.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kutoolangagho obuyinza bwaimwe obubaleetera okwekuluntaza. Tighaabenga maadhi gagwa, olwo ensi yaimwe yaakala, yaabbalanguka ng'oti kyuma kya kikomo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.19",
            "verseOrgIds": [
              "LEV.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe munaakolanga emirimo, amaani gaimwe ganaabafanga busa, kuba ensi teebazenga birime, n'emiti tigiibalenga bibala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwe munaayongeranga okukola empwitu n'obutampulira, ndidha kwongeranga kabiri ku kibonerezo kyaimwe emikuzi musanvu, nga njiira ku bungi bw'ebibi byaimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.21",
            "verseOrgIds": [
              "LEV.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kusindikanga ensolo edh'omu nsiko, dhiite abaana baimwe era dhizikirize ebyayo byaimwe. Dhinaabakendeezanga obungi, engira dhaimwe dhaawolongera dhaazika.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ebibonerezo ebyo era bwe binaalemwanga okubaiza ye ndi, ni mwongera okukola empwitu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.23",
            "verseOrgIds": [
              "LEV.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "zeena ndibeefuulaku naababonereza emikuzi musanvu okuwulagho olw'ebibi byaimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.24",
            "verseOrgIds": [
              "LEV.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kubaleeteranga entalo okubabonereza olw'okumenha endagaano yange n'imwe. Era bwe muneesololezanga aghalala mu bibuga byaimwe okwewonia, ndidha kubasindikangamu obulwaire obubi, muwalirizibwenga okweghaayo eri abazigu baimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.25",
            "verseOrgIds": [
              "LEV.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kubasindikiranga endhala, emere yaimwe ekendeere, abakazi eikumi babe nga beetaaga bwa ziiko ndala yonka okufumbiramu emigaati egirigho. Banaagibapimiranga bupimire mwagirya gyonagyona, aye ate mwaloba kwiguta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Era ebyo bwe binaalemwanga okubafuula abawulize, aye ni mwongera okukola empwitu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.27",
            "verseOrgIds": [
              "LEV.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "zeena ndibeefuulaku mu busungu naayongera okubabonereza emikuzi musanvu okusingagho olw'ebibi byaimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.28",
            "verseOrgIds": [
              "LEV.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endhala ey'amaani einho eidha kubalumanga, mutuuke n'okulyanga abaana baimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.29",
            "verseOrgIds": [
              "LEV.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kuzikiriza ebifo byaimwe ebigulumivu bye musinzizaamu emisambwa, era mmenheregho irala alutaari dhe muniokezaaku obubbaani olw'emisambwa egyo, n'emirambo gyaimwe ngisuule ku bifaananie eby'emisambwa egyo gye musinza. Mu busungu obungi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.30",
            "verseOrgIds": [
              "LEV.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndidha kusaaniagho ebibuga byaimwe, n'ebifo mwe musinziza, ndobe na kusiimanga misengo gyaimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.31",
            "verseOrgIds": [
              "LEV.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi yaimwe ndigisaanizaagho irala, n'abazigu baimwe abaliidha okugibaamu balyewuunhia okubona okuzikirira kwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.32",
            "verseOrgIds": [
              "LEV.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kubaleeteranga entalo dhibaite, mbasansaanizenga eyo mu maghanga. Ensi yaimwe esigalenga agho etyo, n'ebibuga byaimwe mbisaaniegho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.33",
            "verseOrgIds": [
              "LEV.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo ensi erisangaala okufuna emyaka egy'okuwuumula, imwe gye mutaagigha nga mukaagirimu. Erirekebwa agho etyo yaawuumula, nga imwe musansaaniire mu nsi y'abazigu baimwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.34+LEV.26.35",
            "verseOrgIds": [
              "LEV.26.34",
              "LEV.26.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.34+LEV.26.35",
            "verseOrgIds": [
              "LEV.26.34",
              "LEV.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abo ku imwe abanaabanga nga batwaliibwa mu bunhage mu nsi y'abazigu baimwe, nnaabaleetangamu okutya, nga n'eikaba obukaba erifuuyibwa empewo bwe baliwulira balumuka. Banaalumukanga ng'oti ni be bali kubingirira mu lutalo, era banaagwanga nga ghazira n'ali kubabinga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.36",
            "verseOrgIds": [
              "LEV.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banaaniinaganangaku beene na beene, nga ghazira ali kubabingirira, era tibaabengaku na muzigu ye basobola kulwanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.37",
            "verseOrgIds": [
              "LEV.26.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 26:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banaafiiranga mu maghanga, baamiribwa ensi y'abazigu baibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.38",
            "verseOrgIds": [
              "LEV.26.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatono ku abo abanaawonangagho mu nsi y'abazigu baibwe, banaasensemukanga baawaagho olw'ebibi byaibwe, n'olw'ebibi bya badhaadha baibwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 26:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye baidhukulu baimwe bwe balyatula ebibi byaibwe n'ebibi bya badhaadha baibwe abaakola empwitu ni bandheemera, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.40",
            "verseOrgIds": [
              "LEV.26.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 26:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni bandeetera okubeefuulaku, ni mbasindika mu bunhage mu nsi y'abazigu baibwe, era baidhukulu baimwe abo bwe balimala okugonda, ni baganha okubonerezebwa olw'ebibi byaibwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.41",
            "verseOrgIds": [
              "LEV.26.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 26:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwo ndituukiriza endagaano ye nakola ni Yakobo, ni Isaaka era ni Aburahamu, era tija kwerabira nsi ye nabasuubiza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
