          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Dhino n'enaku edh'okukolerangaku embaga edh'ebibinuko bya Musengwa Katonda, dhe munaalangiriranga mu biseera byadho ebyalagirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'okubitizibwa kw'Abaisiraeli, lutoolera eigulo ku lunaku olweikumi n'eina, olw'omwezi ogusooka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
