            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akobere Abaisiraeli ati: “Dhino n'enaku edh'okukolerangaku embaga edh'ebibinuko byange nze Musengwa Katonda bye nalagira, dhe munaalangiriranga okwesololezaaku okunsinza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        }
      ]
    },
    {
