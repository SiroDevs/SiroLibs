          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekibinuko eky'Emigaati Egitazimbulukusiibwa kinaatooleranga ku lunaku olweikumi n'eitaanu olw'omwezi gwene ogwo ogusooka. Munaalyanga emigaati egitazimbulukusiibwa okumala enaku musanvu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.6",
            "verseOrgIds": [
              "LEV.23.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Kuv 12:14-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
