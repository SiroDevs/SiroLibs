          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yaalagira Musa ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "aghe Aaroni ni batabane be amateeka aganaafuganga ekigheebwayo olw'ebibi ati: “Mu kifo mwene mwe baitira ekigheebwayo ekyokebwa, mwe banaitiranga n'ekigheebwayo olw'ebibi, agho mu maiso ga Musengwa Katonda. Ekigheebwayo kino kitukuvu inho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabona anaakighangayo n'aidhanga okukirya era kinaaliirwanga mu kifo ekitukuvu, mu luya lw'Eweema ey'Okwagaananirangamu ni Musengwa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
