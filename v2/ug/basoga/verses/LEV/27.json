            "number": "28",
            "style": "v",
            "sid": "LEV 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye tighaabengagho kintu ekimaze okufuukira irala ekya Musengwa Katonda, kinaatundibwanga oba kinaanunulibwanga, k'abe muntu, oba k'ebe nsolo, oba ka kibe kibandha ekisikire. Buli kintu ekinaabanga nga kimaze okufuukira irala ekya Musengwa Katonda kinaasigalanga nga kya Musengwa Katonda oyo enaku dhoonadhoona.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.14"
              },
              "items": [
                {
                  "text": "Kub 18:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni bw'anaabanga omuntu taanunulwenga, kasita anaabanga ng'amaze okufuukira irala owa Musengwa Katonda, anaitibwanga bwitibwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
