          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekitundu ekirala ekirala ku buli bitundu eikumi eby'ebirime ebikungulwa mu nsi, kya Musengwa Katonda, ka kibe kya nsigo oba eky'ebibala eby'emiti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
