            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo bakyabazinga ab'oku nsi, n'abafuzi, n'abakulu b'abaisirukale, n'abakombe, n'ab'amaani, n'abantu boonaboona, abairu n'ab'eidembe, beegisa mu mpuku ni mu gabaale ag'oku nsozi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
          }
        },
