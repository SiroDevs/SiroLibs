          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'emuunienie dhaava ku igulu dhaamagala ku nsi ng'oti n'ebibala ebikaali kwenga eby'omuti omutiini bwe bimagala ghansi, nga kiwunga ow'amaani agutengeesiisa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
