            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eigulu lyazingibwaku ng'enzingo ey'ekitabo bwezingibwaku, lyavaagho kiisi lusozi na kiisi kizinga byatoolebwa mu bifo byabyo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
