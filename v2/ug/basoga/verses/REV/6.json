          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entaama Ento bwe yakakampula akamanhiso akomukaaga, naja okulinga nti nga mbona musisi ow'amaani, n'endhuba ng'eirugala ng'oti kisiriiza, n'omwezi gwonagwona nga gumyuka ng'oti musaayi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
