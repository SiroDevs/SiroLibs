        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho nairamu okuwulira amamiro ge nali mpuliireku nga gava mu igulu. Gankoba gati: “Ja otoole akazingo akatono ak'ekitabo akazingulwirwa, akali mu ngalo dha malaika ayemereire ku nhandha ni ku bukalu.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        },
