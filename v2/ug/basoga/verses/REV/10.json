          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho malaika ye nabona ng'ayemereire ku nhandha ni ku bukalu, yaagololera omukono gwe omusaadha y'eigulu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
        },
