        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe balimala okugha obudhulirwa bwaibwe, ekisolo ekiva mu lwina olutakoma kiribatanulaku olutalo, kyabaghangula, era kyabaita.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.7",
            "verseOrgIds": [
              "REV.11.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
