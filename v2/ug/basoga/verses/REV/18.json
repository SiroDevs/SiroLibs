              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakyabazinga ab'ensi abaayendanga naye era ni beedhalabyanga bwe balibona omwosi ng'ali kuya, balimulirira era baagegenga.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
