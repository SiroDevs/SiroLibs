              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balimukoba bati: “Ebirungi byonabyona bye weegombanga okufuna bizikiriire. Eby'obukombe byonabyona n'eby'ekitiisa bikuwoireku, era tokairayo kubibonaku kabiri!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.14",
            "verseOrgIds": [
              "REV.18.14"
            ]
          }
        }
