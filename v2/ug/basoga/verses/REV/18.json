          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasuubuzi b'ebintu ab'oku nsi balirira era baagegenga kuba ghaliba nga ghazira agula bintu byaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
