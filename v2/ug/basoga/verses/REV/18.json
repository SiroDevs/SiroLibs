              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abakulu ab'amaato, n'abakozi ab'oku maato, n'abantu be bawungula, n'abo boonaboona abakola ku nhandha, balyemerera ghala. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe balibona omwosi ng'ali kuya baliwowoigana bati: “Ghaali ghabaireghooku ekibuga ekikologho ng'oti ni kino.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.18",
            "verseOrgIds": [
              "REV.18.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
