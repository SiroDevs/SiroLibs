              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye iwe obaire olondoola bukalamu bye mbaire nga ndhegeresanga, ensambo ye neebisaamu, ekigendererwa kyange mu bulamu, okwikiriza kwange, okugumira ebizibu kwange, okugonza kwange, okuguminkiriza kwange, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.10",
            "verseOrgIds": [
              "2TI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "okukirigibwa kwange, okudaagadaaga kwange, ebyantuukaku nga ndi mu Antiokia ni mu Ikonio ni mu Lisitura. Nga nakirigibwa inho! Aye byonabyona Musengwa yabimbisaamu bukalamu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.11",
            "verseOrgIds": [
              "2TI.3.11"
            ]
          }
        },
        {
