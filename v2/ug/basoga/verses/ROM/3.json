                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.20"
              },
              "items": [
                {
                  "text": "Gal 3:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.30",
            "verseOrgIds": [
              "ROM.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mperaano okwikiriza kitegeeza kudibya Mateeka? Busa naire, tugagumya bugumye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.31",
            "verseOrgIds": [
              "ROM.3.31"
            ]
          }
        }
      ]
