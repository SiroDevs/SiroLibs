        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timotheo mukozi munange abalamwisa, okwo nga kw'otaire Lukio, Yasoni ni Sosipateri ab'eighanga lyange.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        },
        {
