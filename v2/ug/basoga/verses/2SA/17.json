          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Daudi yaatuuka e Mahanaimu, eno nga Abusalomu bw'asomoka omwiga Yorudani n'Abaisiraeli boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.24",
            "verseOrgIds": [
              "2SA.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu yali nga yalonda Amasa okukulira amagye ng'aira mu kifo kya Yoabu. Amasa oyo yali mutabane w'omusaadha eyayetebwanga Ithura Omuishimaeli, eyali afumbiirwa Abigaili mughala wa Nahashi, era muganda wa Zeruia eyazaala Yoabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.25",
            "verseOrgIds": [
              "2SA.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Abusalomu oyo n'Abaisiraeli, baasimba weema dhaibwe mu kiketezo ky'e Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.26",
            "verseOrgIds": [
              "2SA.17.26"
            ]
          }
        }
      ]
    },
