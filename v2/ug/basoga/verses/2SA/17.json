          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi bwe yaatuuka e Mahanaimu, Shobi mutabane wa Nahashi ow'e Rabba eky'Abammoni, ni Makiri mutabane wa Ammieli ow'e Lodebari, ni Barazillai Omugileadi ow'e Rogelimu, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.27",
            "verseOrgIds": [
              "2SA.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "baaleeta ebyebwiko, ebbakuli, ebibya n'entamu, engaano, sayiri, obuwunga, emere ey'empeke enkalange, ebidhandhaali, empindi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.28",
            "verseOrgIds": [
              "2SA.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "omudheenene ogw'endhuki, amata amasaadhe, entaama, omuzigo omugemu. Ebyo byonabyona baabireetera Daudi n'abantu boonaboona be yali nabo, nga bakoba mule bati: “Abantu buti endhala n'endiwo biri kubaluma, ate nga bakoowu eyo mu irungu ye bali.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.29",
            "verseOrgIds": [
              "2SA.17.29"
            ]
          }
        }
