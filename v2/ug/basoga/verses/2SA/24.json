            "sid": "2SA 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Musengwa Katonda yaabagha bye baasabira ensi era yaalekeza n'ekibamba ekyali kiri kwita abantu mu Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.25",
