          },
          "items": [
            {
              "text": "1 Bus 15:25—16:1",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.2+2SA.6.3+2SA.6.4+2SA.6.5+2SA.6.6+2SA.6.7+2SA.6.8+2SA.6.9+2SA.6.10+2SA.6.11+2SA.6.12+2SA.6.13+2SA.6.14+2SA.6.15+2SA.6.16+2SA.6.17"
