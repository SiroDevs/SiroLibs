        },
        {
          "text": "Omugabe yaareetera Yerusaalemu okugira efeeza n'ezaabu nyingi nk'amabaare, n'ebiti by'emyereezi byaba nk'emisikamoori y'omu mpita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.15",
            "verseOrgIds": [
              "2CH.1.15"
            ]
          }
        },
