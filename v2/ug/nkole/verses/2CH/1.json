          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.27.1"
              },
              "items": [
                {
                  "text": "1 Bus 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sulemaani yaagamba na Israeli yoona, abakuru b'engabo rukumi-rukumi n'aba igana-igana, abaramuzi, n'abeembezi ba Israeli boona, abakuru b'amaju ga baishenkurubo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.2",
            "verseOrgIds": [
              "2CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
