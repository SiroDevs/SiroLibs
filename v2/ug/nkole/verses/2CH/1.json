            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sulemaani mwene Daudi akahamibwa omu bugabe bwe, MUKAMA Ruhanga we yaaguma nawe, yamukuza munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
