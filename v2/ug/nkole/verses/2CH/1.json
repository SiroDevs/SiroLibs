                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (Kwonka eshanduukye ya Ruhanga, Daudi akaba agiinamwire, agiihire Kiryasi-yearimu, agitwaire omu mwanya ogu yaabaire agibonereize; ahakuba akaba agiteereire eihema Yerusaalemu.) ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.4",
            "verseOrgIds": [
              "2CH.1.4"
            ]
          }
        },
        {
