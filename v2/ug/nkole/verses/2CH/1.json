            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi eitambiro ry'emiringa eryakozirwe Bezaleeli mwene Uuri, mwijukuru wa Huuri, niyo ryabaire riri omu maisho g'Obutaaho bwa MUKAMA. Okwo niyo Sulemaani n'omutwe gw'abantu baabaire baza kusherura MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baahikireyo, Sulemaani yaaza aha itambiro ry'emiringa omu maisho ga MUKAMA, eryabaire riri omu maisho g'Eihema ry'okubugaabuganiramu, yaaritambiraho ebitambo rukumi by'okwotsya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        }
      ]
