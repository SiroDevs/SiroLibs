              },
              "items": [
                {
                  "text": "Kut 35:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bwanyima baacwekyereza endembo zoona ezaabaire zeehinguririize Geera, ahabw'okuba Abaesiopia bakaba baitsirwe obwoba obwareetsirwe MUKAMA. Baanyaga ezo ndembo zoona, ahakuba zikaba zirimu eminyago mingi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.14",
            "verseOrgIds": [
              "2CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi baacwekyereza amahema g'abaabaire batungire ente, baanyaga entaama n'engamira nyingi munonga. Bwanyima baagaruka Yerusaalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.15",
            "verseOrgIds": [
              "2CH.14.15"
            ]
          }
        }
