                "loc": "PSA.22.5"
              },
              "items": [
                {
                  "text": "Zab 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Asa yaatakira MUKAMA Ruhanga we, naagira ati: Ai MUKAMA, tihaine orikwingana naiwe omu kuhwera abataine maani baateerwa ab'amaani. MUKAMA Ruhanga waitu, otuhe emikono, ahabw'okuba niiwe turikwesiga, kandi omu iziina ryawe twizire kurwanisa omutwe ogu muhango munonga ogw'engabo. Ai MUKAMA, niiwe Ruhanga waitu, otaikiriza omuntu kukusingura. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.13.15"
              },
              "items": [
                {
                  "text": "2 Bus 13:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.8"
              },
              "items": [
                {
                  "text": "16:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo MUKAMA yaasingura Abaesiopia omu maisho ga Asa n'Abayuda, Abaesiopia baahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa n'abantu abu yaabaire aine baababinga, baabahitsya Geera, Abaesiopia baafa baingi munonga, tibaabaasa kugaruka kweyunga; ahabw'okuba bakacwekyerezibwa omu maisho ga MUKAMA n'eihe rya. Abashaija ba Yuda baatwara eminyago mingi munonga; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.13",
            "verseOrgIds": [
              "2CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
