                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baaherize kweteekateekyera okwo kuheereza, abanyamurwa baayemerera omu mwanya gwabo, n'Abaleevi omu bicweka byabo, nk'oku omugabe yaaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.10",
            "verseOrgIds": [
              "2CH.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 35:11"
          },
          "items": [
