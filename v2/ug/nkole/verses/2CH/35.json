            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.29.22"
              },
              "items": [
                {
                  "text": "2 Bus 29:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.29.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batyo baita omwana gw'entaama gw'Okuhingurwaho, abanyamurwa baamiisiira eshagama ei baahairwe Abaleevi, abaabaire nibabaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.11",
            "verseOrgIds": [
              "2CH.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baihaho ebitambo by'okwotsya, baabibaganisa nk'emitwe y'amaju ga baishenkuru b'abatari Baleevi oku yaabaire eri ngu babone kubihongyera MUKAMA, nk'oku kyahandiikirwe omu kitabo kya Musa. Kandi n'enimi baazitwaza batyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 35:13"
          },
          "items": [
