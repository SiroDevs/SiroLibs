            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.29.11"
              },
              "items": [
                {
                  "text": "2 Bus 29:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagarura abanyamurwa aha murimo gwabo, yaabeezirikisa kukora omurimo gw'obuheereza omu nju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
