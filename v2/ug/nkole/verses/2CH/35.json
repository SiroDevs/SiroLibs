            "sid": "2CH 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endiijo mirimo ya Yosia, n'ebirungi ebi yaakozire naakuratira ebihandiikirwe omu biragiro bya MUKAMA, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ebi yaakozire okwiha aha kutandika okuhitsya aha muheru, reeba, bihandiikirwe omu kitabo ky'Abagabe ba Israeli n'aba Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.27",
            "verseOrgIds": [
              "2CH.35.27"
            ]
          }
        }
      ]
