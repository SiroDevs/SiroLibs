                "loc": "2KI.23.29"
              },
              "items": [
                {
                  "text": "2 Bag 23:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.2"
              },
              "items": [
                {
                  "text": "Yer 46:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'ebyo byona, Yosia ku yaaherize kushemeza hekalu, Neeko omugabe wa Misri yainamuka kuteera Kakemeshi aha mugyera Furaati, na Yosia yaahurura kurwana nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.20",
            "verseOrgIds": [
              "2CH.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Neeko yaamutumaho entumwa, naamugira ati: Mbwenu nyowe naiwe nitufa ki, iwe omugabe wa Yuda? Hati tiiwe nyizire kurwanisa, kureka nyine enju ei ndikurwana nayo; kandi Ruhanga andagiire ngu nyehuute. Ruga Ruhanga omu kaso ori hamwe naanye, atakaakucwekyereza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.21",
            "verseOrgIds": [
              "2CH.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Yosia yaayanga kumurugaho, kureka yaayehindura ngu arwane nawe; tiyaahurira bigambo bya Neeko ebirugire omu kanwa ka Ruhanga, yaaza omu rugamba omu ruhita rwa Megido. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarasi baarasha omugabe Yosia; nawe nikwo kugira abashaija be ati: Muunyiha omu rugamba ahakuba naahutaara munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo abashaija be baamwiha omu kigaari, baamuta omu kigaari kye ekya kabiri, baamutwara Yerusaalemu. Yaafa, yaaziikwa omu bituuro bya baihsenkuru. Abayuda n'aba Yerusaalemu boona baamucurira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.24",
            "verseOrgIds": [
              "2CH.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.4.20"
              },
              "items": [
                {
                  "text": "Tonz 4:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na Yeremia yaamucurira; kandi abeeshongozi boona, abashaija n'abakazi, baaguma nibamugambaho omu kutonzya kwabo n'okuhitsya hati. Baakihindura omugyenzo omuri Israeli; reeba, bihandiikirwe omu kitabo ky'Okutonzya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
