            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yosia yaagaruriraho MUKAMA obugyenyi bw'Okuhingurwaho omuri Yerusaalemu; baita omwana gw'entaama gw'Okuhingurwaho aha kiro kya ikumi na bina eky'okwezi kw'okubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 35:2"
          },
