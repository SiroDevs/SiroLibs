                "loc": "DEU.16.7"
              },
              "items": [
                {
                  "text": "Bir 16:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima baayotsya omwana gw'entaama gw'Okuhingurwaho nk'oku kirikuragiirwa; kandi n'empongano ezirikwera baaziteeka omu nyabya, omu nyungu n'omu safuriya, ahonaaho baabitwara, baagaburira abantu boona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.13",
            "verseOrgIds": [
              "2CH.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima baayeteekateekyera ebyabo ahabwabo n'ahabw'abanyamurwa, ahabw'okuba abanyamurwa beene Arooni bakaba bahugiire omu kutamba ebitambo by'okwotsya n'ebishaju okuhitsya obu bwaizire; batyo Abaleevi baateekateeka ebyabo ahabwabo n'ahabw'abanyamurwa beene Arooni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.14",
            "verseOrgIds": [
              "2CH.35.14"
            ]
          }
        },
