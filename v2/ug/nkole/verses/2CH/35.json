              "items": [
                {
                  "text": "Lev 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaagambira Abaleevi abaabaire beegyesa Abaisraeli, akndi abayereziibwe MUKAMA, ati: Mute eshanduukye erikwera omu nju ei Sulemaani mwene Daudi omugabe wa Israeli yaayombekire; tihaakiriho kirigibaheekyesa obundi. Mbwenu muheereze MUKAMA Ruhanga waanyu, n'abantu be Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.26"
              },
              "items": [
                {
                  "text": "1 Bus 23:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.8.14"
              },
              "items": [
                {
                  "text": "2 Bus 8:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mweteekateekye omu mbu zaanyu, nk'oku amaju ga baashwenkuriimwe gari, nimukuratira ebyaragiirwe Daudi omugabe wa Israeli, na Sulemaani omutabani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.134.1"
              },
              "items": [
                {
                  "text": "Zab 134:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi mwemerere omu mwanya ogurikwera nk'emitwe y'amaju ga baishenkuru ba beene waanyu abatari Baleevi oku eri, buri mutwe gugire ekicweka ky'enju ya baashwenkuriimwe Abaleevi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.5",
            "verseOrgIds": [
              "2CH.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.29.5"
              },
              "items": [
                {
                  "text": "2 Bus 29:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.30.2"
              },
              "items": [
                {
                  "text": "30:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.30.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima mwite omwana gw'entaama gw'Okuhingurwaho, mweyeze, mweteekateekyere beene waanyu, mubone kukora nk'ekigambo kya MUKAMA ekyagambirwe Musa oku kiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        }
      ]
