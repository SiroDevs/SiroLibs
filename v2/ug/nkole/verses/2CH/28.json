              "items": [
                {
                  "text": "Rom 12:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo bakuru, abu amaziina gaabo gaagambwaho, baimuka, baayakiira enkwatwa, boona abaabire bajwaire busha omuribo baabajweka eby'omu minyago; batyo baabajweka, baabaha enkaito, baabaha eby'okurya n'eby'okunywa, baabasiiga amajuta, boona abaabaire bataine maani omuribo baabaheeka aha ndogoya, baabahitsya omuri beene waabo ahari Yeriko, orurembo rw'emikindo. Bwanyima baagaruka Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        }
      ]
