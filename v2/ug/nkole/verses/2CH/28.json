            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka yaakuratira emicwe y'abagabe ba Israeli. Kandi yaaheesha n'ebishushani ebirikuramibwa ahabwa Baabaali; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.2",
            "verseOrgIds": [
              "2CH.28.2"
            ]
          }
