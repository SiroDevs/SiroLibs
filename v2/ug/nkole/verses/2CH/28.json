            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaaguma naayoterera obubaane omu ruhanga rwa mwene Hinoomu, yaarabya abaana be omu muriro, naakuratira emigyenzo erikunugwa ey'abanyamahanga, abu MUKAMA yaabingire omu maisho g'Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaguma naatambira omu myanya mikuru y'okuramizamu, aha bibungo, n'ahansi ya buri kiti ekyetwa omurinzi, kandi naayotererayo obubaane.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.4",
            "verseOrgIds": [
              "2CH.28.4"
            ]
          }
        }
      ]
