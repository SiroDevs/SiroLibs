          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba MUKAMA akabaagarwire Abayuda ahansi, naabatura Ahazi omugabe wa Israeli, ahabw'okuba akakorera omuri Yuda ebitahikire, yaacumura munonga ahari MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
