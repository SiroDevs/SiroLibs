              "items": [
                {
                  "text": "Isa 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo MUKAMA Ruhanga we yaamuheereireyo omu mikono y'omugabe wa Siria, ogwo mugabe akamusingura, akakwata abantu be baingi munonga, akabatwara Damasiko bari enkwatwa. Kandi yaaheebwayo omu mikono y'omugabe wa Israeli, yaita abantu be baingi munonga, yaamusingura. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba Peeka mwene Remalia omu izooba rimwe akaita omuri Yuda abashaija amamanzi akasiriira n'obukumi bubiri, ahabw'okuba bakatsigaho MUKAMA, Ruhanga wa baishenkurubo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Zikuri, omushaija rugambwa owa Efuraimu yaita Maaseya mutabani w'omugabe, na Azurikaamu omukuru w'ekikaari ky'omugabe, na Elukaana enganzi y'omugabe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.7",
            "verseOrgIds": [
              "2CH.28.7"
            ]
          }
        }
      ]
    },
