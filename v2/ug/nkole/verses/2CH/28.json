              "items": [
                {
                  "text": "26:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.5"
              },
              "items": [
                {
                  "text": "Kush 18:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka okwo hakaba hariyo nabi wa MUKAMA owaabaire naayetwa Odedi; nabi ogwo yaashohora kubugana eihe eryabaire niritabaaruka, niriza Samaria; yaabagira ati: Nimumanya ku MUKAMA Ruhanga wa baashwenkuriimwe yaagwereirwe kubi Abayuda, akabahayo omu mikono yaanyu; kwonka imwe murengyesereize, mwabaita mwine ekiniga kingi ekihinguraine munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu nimwenda kugira Abayuda n'aba Yerusaalemu abahuuku n'abazaanz. Imwe timwine ebibi byanyu, ebi mucumwire ahari MUKAMA Ruhanga waanyu? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu mumpurire, mugarureyo aba bantu, abu mukwatsire omuri beene waanyu, ei mubaihire, ahakuba MUKAMA abagiriire ekiniga kingi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'abakuru bamwe b'Abaefuraimu, Azaria, mwene Yohanani, Berekia mwene Meshilemoosi, Mehizikia mwene Shalumu na Amasa mwene Hadulai, baayemerera kukumiirira abaabaire nibaruga aha rugamba, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.12",
            "verseOrgIds": [
              "2CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "baabagira bati: Timurikwija kureeta aha nkwatwa, ahabw'okuba nimwenda kutureetera orubanja rw'okucumura ahari MUKAMA, kwongyera aha bibi n'orubanja ebi twine; haza orubanja oru twine ruri ruhango, kandi ahari Israeli hariho ekiniga kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo abo bashaija abaabaire baine eby'okurwanisa baatsiga enkwatwa n'eminyago omu maisho g'abakuru n'omutwe gwona ogw'abateeraine. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.14",
            "verseOrgIds": [
              "2CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
