            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli baakwata omuri beene waabo abantu obusiriira bubiri, abakazi, abaana b'aboojo n'ab'abaishiki; kandi baabanyaga eminyago mingi, baagitwara Samaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
              "2CH.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 28:9"
          },
          "items": [
