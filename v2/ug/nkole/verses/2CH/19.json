            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo mugume mutiine MUKAMA; kandi mwerinde omu bi murikukora; ahakuba MUKAMA Ruhanga waitu taita manja, tashoroora mu bantu, kandi tarya nguzi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        }
