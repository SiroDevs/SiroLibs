            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka, n'obu kiraabe kiri kityo, omuriiwe harimu n'ebirungi, ahakuba okacwekyereza Ashera omu nsi, kandi omutima gwawe waaguta aha kusherura MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        }
