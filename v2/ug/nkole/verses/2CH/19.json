                  "text": "Ezr 7:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omuri Yerusaalemu Yehoshafaati yaataho Abaleevi bamwe n'abanyamurwa, n'abakuru b'emiryango ya Israeli, kuguma nibacwa emanja ahabwa MUKAMA, kandi n'okumarira abarikujurira emanja zaabo. Abo baramuzi bakaba batuura Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.8",
            "verseOrgIds": [
              "2CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.3"
              },
              "items": [
                {
                  "text": "2 Sam 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.61"
              },
              "items": [
                {
                  "text": "1 Bag 8:61",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaabeehanangiriza ati: Oku nikwo muritwaza omu kutiina MUKAMA, omu bwesigwa, mutaireho emitima yaanyu yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
            "verseOrgIds": [
              "2CH.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.8"
              },
              "items": [
                {
                  "text": "Bir 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Beene waanyu abatwire omu ndembo zaabo, ku bariguma baabareetera emanja, z'obwitsi, ez'ebiragiro, ez'ebyaragiirwe, ez'ebyatairweho nari ez'emigyenzo, muryaguma mubahabure, barekye kugiibwaho orubanja omu maisho ga MUKAMA, naimwe na beene waanyu murekye kuhikwaho ekiniga. Okwo nikwo muritwaza, mukareka kugiibwaho orubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.10",
            "verseOrgIds": [
              "2CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.10"
              },
              "items": [
                {
                  "text": "1 Bus 28:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi reeba, Amaria omunyamurwa omukuru niwe arikubategyeka omu bigambo byona ebya MUKAMA, na Zebedia mwene Ishimaeli omutegyeki w'enju ya Yuda, omu bigambo byona eby'omugabe; kandi Abaleevi baryaguma nibabaheereza nk'abakuru. Mukore n'obumanzi; kandi MUKAMA agume n'abarikukora eby'oburyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        }
