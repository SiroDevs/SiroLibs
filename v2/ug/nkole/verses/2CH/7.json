            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.5"
              },
              "items": [
                {
                  "text": "Bir 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima MUKAMA yaayeyoreka Sulemaani nyekiro, yaamugira ati: Mpuriire okushaba kwawe, kandi nyetooraniire omwanya ogu kuba ogw'enju y'okutambiramu ebitambo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.26"
              },
              "items": [
                {
                  "text": "2 Bus 6:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku ndikinga eiguru, enjura yaabura, nari naaragiira enzigye kukunuura ensi, nari naayohereza orufu omu bantu bangye, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.12.7"
              },
              "items": [
                {
                  "text": "2 Bus 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " abantu bangye abarikwetererwa eiziina ryangye, ku baryecureeza, baashaba, bansherura, baareka emitwarize yaabo emibi, obwo ndyahurira niinyema omu iguru, nsaasire ekibi kyabo, kandi ntambire ensi yaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.40"
              },
              "items": [
                {
                  "text": "2 Bus 6:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga hati niinyija kuguma ninta amaisho gangye, kandi nintega amatu gangye aha kushaba okurishabirwa omu mwanya ogu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.15",
            "verseOrgIds": [
              "2CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabw'okuba hati naatoorana egi nju, kandi naagyeeza, ngu eiziina ryangye ribone kugigumamu ebiro byona; amaisho gangye n'omutima gwangye biryagigumaho obutwire bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.16",
            "verseOrgIds": [
              "2CH.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi iwe ku origyendera omu maisho gangye, nka sho Daudi oku yaatwarize, waakora byona ebi nkuragiire, waayorobera ebiragiro byangye n'ebi naataireho, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.17",
            "verseOrgIds": [
              "2CH.7.17"
            ]
          }
        },
