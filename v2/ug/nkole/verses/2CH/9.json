                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe yaareetera Yerusaalemu kugira efeeza nyingi nk'amabaare, n'ebiti by'emyereezi byaba nk'emisikamoori y'omu mpita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bakaba bareetera Sulemaani embaraasi nibaziiha Misri n'omu nsi ezindi zoona.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
