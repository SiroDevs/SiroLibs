                "loc": "2CH.8.18"
              },
              "items": [
                {
                  "text": "2 Bus 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi abashaija ba Hiraamu n'aba Sulemaani, abaabaire bareeta ezaabu okuruga Ofiri, bakareeta embaaho za alumuugi n'amabaare g'obuguzi bwingi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezo mbaaho za alumuugi omugabe yaazibaijamu amatembero g'enju ya MUKAMA n'ag'enju ye ahabwe, n'endingiri n'enanga ahabw'abeeshongozi; hakaba hatakareebwaga mbaahoza alumuugi ezirikushusha nk'ezo omu nsi ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe Sulemaani yaaha omugabekazi wa Sheeba ebi yaabaire naayenda byona, n'ebi yaamushabire byona, okwohaho ebi yaamureeteire. Bwanyima yaakuba, yaagaruka omu nsi ye n'abagaragwa be.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
