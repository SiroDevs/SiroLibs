          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.14+1KI.10.15+1KI.10.16+1KI.10.17+1KI.10.18+1KI.10.19+1KI.10.20+1KI.10.21+1KI.10.22+1KI.10.23+1KI.10.24+1KI.10.25+1KI.10.26+1KI.10.27+1KI.10.28"
              },
              "items": [
                {
                  "text": "1 Bag 10:14-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ezaabu eyaabaire ereetwa owa Sulemaani buri mwaka ekaba eba etalanta magana mukaaga na makumi mukaaga na mukaaga, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.10"
              },
              "items": [
                {
                  "text": "Zab 72:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " otabariiremu eyaabaire eruga omu bashuubuzi n'omu batunzi; kandi abagabe ba Buharabu boona n'abategyeki b'omu nsi bakaba bareetera Sulemaani ezaabu n'efeeza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe Sulemaani yaaheeshesa engabo z'ezaabu magana abiri, engabo emwe neeheeshwa omu zaabu ya shekeli magana mukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaaheeshesa ezindi ngabo z'ezaabu magana ashatu; engabo emwe neeheeshwa omu zaabu ya shekeli magana ashatu; omugabe yaazita omu nju y'ekibira kya Lebanooni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaabaijesa ekitebe ky'obugabe kihango omu miino y'enjojo, yaakishweka ezaabu eshemeziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.17",
            "verseOrgIds": [
              "2CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kitebe ky'obugabe kikaba kiine amatembero mukaaga, n'akatebe ky'ebigyere k'ezaabu, ebyabaire bikoreirwe hamwe n'ekyo kitebe; aha buri rubaju rw'ekyo kitebe hariho ah'okuta emikono, n'ebishushani bibiri by'entare ezeemereire aha rubaju rw'ah'okuta emikono; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.18",
            "verseOrgIds": [
              "2CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'ebindi bishushani by'entare ikumi na bibiri byemereire bibiri bibiri ahari buri itembero ahari ago matembero mukaaga. Omu bugabe obundi bwona tihariho kitebe ekyabaire nikishushana nakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eby'okunywaisa eby'omugabe Sulemaani byona bikaba biri eby'ezaabu, kandi n'ebintu byona eby'omu nju y'omu kibira kya Lebanooni bikaba biri eby'ezaabu eshemeziibwe; omu biro bya Sulemaani efeeza ekaba etarikuteekateekwaho kuba ekintu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.20",
            "verseOrgIds": [
              "2CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba emeeri z'omugabe zikaba ziza Tarushiishi n'abashaija ba Hiraamu; omurundi gumwe omu myaka eshatu ezo meeri za Tarushiishi zikaba ziija, zireetsire ezaabu, efeeza, emiino y'enjojo, enkobe na zaanyamunyonyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo omugabe Sulemaani yaakirize abagabe boona ab'omu nsi obutungi n'obwengye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.22",
            "verseOrgIds": [
              "2CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagabe boona ab'omu nsi bakaba beetenga kureeba Sulemaani, ngu bahurire obwengye bwe, obu Ruhanga yaamuhaire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
              "2CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi weena owaabaire aija akaba areeta omutoijo, ebintu by'efeeza n'eby'ezaabu, ebijwaro, sumuruna, emigaju, embaraasi n'enyumbu; ebyo byona nikwo byabaire biija buri mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.24",
            "verseOrgIds": [
              "2CH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.14"
              },
              "items": [
                {
                  "text": "2 Bus 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Sulemaani akaba aine emyanya obukumi buna ei embaraasi ze ezirikukurura ebigaari zaabaire ziraaramu, kandi aine abashaija abarikugyendera aha mbaraasi kakumi n'enkumi ibiri, abu yaataire omu ndembo z'ebigaari bye, n'omuri Yerusaalemu owa omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
            "verseOrgIds": [
              "2CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
