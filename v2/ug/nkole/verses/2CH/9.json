              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemaani yaamara aha ngoma emyaka makumi ana naategyekyera Israeli yoona omuri Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
