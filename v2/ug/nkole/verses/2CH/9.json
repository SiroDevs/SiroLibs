                "loc": "2CH.1.15"
              },
              "items": [
                {
                  "text": "2 Bus 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
