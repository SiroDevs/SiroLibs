                "loc": "PSA.72.8"
              },
              "items": [
                {
                  "text": "Zab 72:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaategyeka abagabe boona okuruga aha mugyera Furaati okuhika omu nsi y'Abafilistia n'aha mwatano gwa Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
