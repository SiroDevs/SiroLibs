              },
              "items": [
                {
                  "text": "1 Bag 10:1-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabekazi wa Sheeba ku yaahuriire okurangaanwa kwa Sulemaani, yaija Yerusaalemu kumubuuza ebibuuzo bigumire naamugyeza; yaija ashendekyereziibwe abantu baingi munonga, n'engamira zeekoreire emigaju, n'ezaabu nyingi munonga, kandi n'amabaare ag'obuguzi bwingi. Ku yaahikire ahari Sulemaani, yaamugambira kyona ekyabaire kimuri aha mutima.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.1",
            "verseOrgIds": [
              "2CH.9.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.42"
              },
              "items": [
                {
                  "text": "Mat 12:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.31"
              },
              "items": [
                {
                  "text": "Luk 11:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.1",
            "verseOrgIds": [
              "2CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemaani yaagarukamu ebi yaamubuurize byona; tihariho kigambo na kimwe ekyayeshobire Sulemaani, eki ataramushobororeire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.2",
            "verseOrgIds": [
              "2CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabekazi wa Sheeba ku yaareebire obwengye bwa Sulemaani, enju ei yaayombekire, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.3",
            "verseOrgIds": [
              "2CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "eby'okurya by'aha meeza ye, emishutamire y'abagaragwa be, n'emiheerereze y'abaheereza be, n'ebijwaro byabo, n'abagabuzi be ba viinyo n'ebijwaro byabo, n'ebitambo by'okwotsya ebi yaabaire naahongyera aha nju ya MUKAMA, omutima gwamuhwa omunda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagira omugabe ati: Ebigambo ebi naahuriire ndi omu nsi yangye ebirikugamba aha by'emitwarize yaawe n'obwengye bwawe bikaba biri eby'amazima, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.5",
            "verseOrgIds": [
              "2CH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka tindabiikiriize okuhitsya obu nyeiziire, eriisho ryangye rikabyereebera; nkashanga batarangambiire n'obu kyakuba ekicweka kimwe kya kabiri ky'obwingi bw'obwengye bwawe; nookirira kimwe ebi naahuriire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.6",
            "verseOrgIds": [
              "2CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashaija baawe bahiiriirwe! N'abaheereza baawe, abeemerera obutoosha omu maisho gaawe, bakahurira obwengye bwawe, nabo bahiiriirwe! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.7",
            "verseOrgIds": [
              "2CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.23"
              },
              "items": [
                {
                  "text": "1 Bus 29:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.2.11"
              },
              "items": [
                {
                  "text": "2 Bus 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA Ruhanga waawe ahimbisibwe, owaakusiimire, akakuta aha kitebe ky'obugabe bwe, kuba omugabe ahabwa MUKAMA Ruhanga waawe! Ruhanga waawe ogwo ahabw'okukunda Abaisraeli n'okwenda kubahamya ebiro byona, nikyo yaakuteereireho kuba omugabe w'okubategyeka, ngu obone kucwa emanja z'oburyo omu kuhikiirira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaaha omugabe etalanta z'ezaabu igana na makumi abiri, emigaju mingi munonga, n'amabaare g'obuguzi bwingi; tihakabahoga migaju nk'ei omugabekazi wa Sheeba yaahaire omugabe Sulemaani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        }
      ]
    },
    {
