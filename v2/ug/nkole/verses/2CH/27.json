              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.7+2KI.16.8+2KI.16.9+2KI.16.10"
              },
              "items": [
                {
                  "text": "16:7-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yosamu akaba aine emyaka makumi abiri n'etaano, obu yaatandika kutegyeka; yaategyekyera Yerusaalemu emyaka ikumi na mukaaga. Nyina akaba naayetwa Yerusha muhara wa Zadoki. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.1",
            "verseOrgIds": [
              "2CH.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.16"
              },
              "items": [
                {
                  "text": "2 Bus 26:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaakora ebirikusiimwa MUKAMA, nk'ebi Uziya ishe yaakozire byona, okwihaho eky'okutaahisa amaani omuri hekalu ya MUKAMA. Kwonka abantu baagumizamu nibakora ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaayombeka eirembo rya ruguru ery'enju ya MUKAMA, kandi yaayombeka ebyombeko bingi aha rugo rw'amabaare rwa Ofeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.3",
            "verseOrgIds": [
              "2CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaayombeka endembo omu nsi y'ebibungo eya Yuda, hamwe n'ebigo n'eminaara aha bubungo bw'ebibira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaarwanisa abagabe b'Abaamoni, yaabasingura. Omu mwka ogwo Abaamoni baamutoijera etalanta z'efeeza igana, n'ebitenga by'engano kakumi, n'ebya sayiri kakumi. Kandi omu mwaka gwa kabiri n'ogwa kashatu Abaamoni baamutoijera batyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Yosamu yaahinduka ow'amaani, ahabw'okushemeza emitwarize ye omu maisho ga MUKAMA Ruhanga we.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
            "verseOrgIds": [
              "2CH.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
