                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'ekiragiro kya Daudi ishe oku kyabaire kiri, yaataho abanyamurwa b'okukora omurimo gw'obuheereza omu mbu, n'Abaleevi ahabw'omurimo gwabo ogw'okuhimbisa, n'ogw'okuheereza omu maisho g'abanyamurwa, nk'omurimo gwa buri izooba oku gwabaire nigwetengwa, kandi n'abakumiirizi b'amarembo ab'okurinda amarembo goona omu mbu; ahabw'okuba okwo nikwo Daudi omushaija wa Ruhanga yaabaire aragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi tibaateishuka kureka ebi omugabe yaaragiire abanyamurwa n'Abaleevi ebirikukwata aha kintu kyona n'aha by'amabiikiro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
