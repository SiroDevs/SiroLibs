        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemaani yaiha muhara wa Faraho omu rurembo rwa Daudi, yaamuta omu nju ei yaamwombekyeire; ahakuba akagira ati: Omukazi wangye tashemereire kuguma omu nju ya Daudi omugabe wa Israeli, ahabw'okuba emyanya ei eshanduukye ya MUKAMA eiziremu n'erikwera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
