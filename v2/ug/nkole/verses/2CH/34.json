            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.3"
              },
              "items": [
                {
                  "text": "2 Bus 28:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.2"
              },
              "items": [
                {
                  "text": "33:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Yosia yaihaho ebirikunugwa byona omu nsi yoona ey'Abaisraeli, n'abaabaire bari omuri Israeli boona yaabagyema kuheereza MUKAMA Ruhanga waabo. Omu busingye bwe bwona tibararekire kukuratira MUKAMA Ruhanga wa baishenkurubo.",
          "type": "text",
          "attrs": {
