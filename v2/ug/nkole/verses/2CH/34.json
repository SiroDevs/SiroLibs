                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.12"
              },
              "items": [
                {
                  "text": "15:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe yaayemerera omu mwanya gwe, yaaragaana endagaano omu maisho ga MUKAMA, okumukuratira n'okworebera ebiragiro bye n'ebi yaahamize kandi n'ebi yaataireho, n'omutima gwe gwona n'amagara ge goona, n'okuhikiiriza ebigambo by'egyo ndagaano ehandiikirwe omuri ekyo kitabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaareetera abaabaire bari Yerusaalemu na Benyamiini boona kwemera egyo ndagaano. N'ahabw'ekyo abatuuzi ba Yerusaalemu baakora nk'endagaano ya Ruhanga, Ruhanga wa baishenkurubo, oku eri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
