                "loc": "2KI.22.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yosia akaba aine emyaka munaana obu yaatandika kutegyeka, yaategyekyera Yerusaalemu emyaka makumi ashatu na gumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakora ebirikusiimwa MUKAMA, yaatwaza nka Daudi ishenkuru, tiyaateishuka kutoora aha rubaju rwa buryo nari orwa bumosho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.3"
              },
              "items": [
                {
                  "text": "2 Bus 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba omu mwaka gwe gwa munaana ari aha ngoma, akiri muto, akatandika kusherura Ruhanga wa Daudi ishenkuru; kandi omu mwaka gwe gwa ikumi n'ebiri yaatandika kushemeza Yuda na Yerusaalemu, yaamaramu emyanya mukuru y'okuramizamu, na Ashera, n'ebishushani ebibaizire n'ebiheesire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.6"
              },
              "items": [
                {
                  "text": "2 Bag 23:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baasheenyera omu maisho ge amatambiro ga Baabaali, yaatema ebishushani by'eizooba ebyabaire biri ahaiguru yaago, byagwa ahansi; yaasheenyagura Ashera, n'ebishushani ebibaizire n'ebiheesire, yaabicwa esingo, egyo singo yaagishuka aha bituuro by'abaabaire babitambira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.20"
              },
              "items": [
                {
                  "text": "2 Bag 23:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.2"
              },
              "items": [
                {
                  "text": "1 Bag 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagaruka yaayokyeza amafuga g'abanyamurwa aha matambiro gaabyo; yaashemeza atyo Yuda na Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaatwaza atyo n'omu ndembo za Manaase, Efuraimu na Simeoni ezaabaire zaabaire amatongo, nangwa n'okuhika Nafutaali, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.21"
              },
              "items": [
                {
                  "text": "Bir 9:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaasheenya amatambiro, yaahondahonda Ashera, n'ebishushani yaabicwa esingo, yaatemagura ebishushani by'eizooba byona, ebyabaire biri omu nsi ya Israeli yoona, yaabinaga ahansi. Bwanyima yaagaruka Yerusaalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
