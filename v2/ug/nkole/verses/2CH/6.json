              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ohurire okushaba n'okweshengyereza kwabo, nooyema omu iguru, obarwanirire.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
