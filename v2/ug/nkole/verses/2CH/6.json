          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi enjara ku eriteera ensi, nari orufu, okututa, nari okusya-nyamwenga, nari enzigye, nari kanyaananga; nari abazigu okubagotera omuri ibara rurembo rwabo; nari ku haribaho kahumpuri nari endiijo ndwara yoona; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuntu weena nari eihanga ryona ery'Abaisraeli baakushaba nibakweshengyereza, buri muntu naamanya endwara y'omu mutima gwe, n'obusaasi bwe, kandi aimukize emikono ye naagyorekyeza, ei egi nju eri, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ohurire nooyema omu iguru omu mwanya gwawe ogu otuuramu, osaasire, oihure buri muntu, ou orikumanya omutima, nk'oku emitwarize ye eri; (niiwe wenka orikumanya emitima y'abaana b'abantu;) ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "babone kukutiina ebiro byona ebi barimara omu nsi ei waahaire baatatenkuriitwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
    },
