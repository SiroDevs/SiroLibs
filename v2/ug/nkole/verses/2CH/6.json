                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi eiguru ku ririkingwa, enjura yaabura ahabw'abantu baawe kukucumuraho, bwanyima baashaba nibareeba omu mwanya ogu, baikiriza eiziina ryawe, baahinduka, baareka ekicumuro kyabo ahabw'okuhana kwawe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ohurire ori omu iguru, osaasire abairu baawe, eihanga ryawe Israeli, ekibi kyabo, obeegyese emitwarize mirungi ei bashemereire kugyenderamu; kandi ogwisize ensi yaawe enjura, ei waahaire abantu baawe kuba obuhunguzi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
