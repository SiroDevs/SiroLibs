          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ku arisiisira mutaahi we, baamurahiza, nawe yaija kyaarahira omu maisho g'eitambiro ryawe omu nju egi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ohurire nooyema omu iguru, ogire eki waakora, ocwere abairu baawe orubanja, rusingye okozire kubi, aturwe okutahikiirira kwe, oihe orubanja ahari ohikiriire, omuzimuurire nk'okuhikiirira kwe oku kuri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        }
      ]
    },
