          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abantu baawe Abaisraeli ku baribingwa abazigu baabo ahabw'okukucumuraho, bwanyima baakugarukira, baikiriza eiziina ryawe, baakushaba nibeeshengyerereza omu nju egi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ohurire nooyema omu iguru, osaasire abantu baawe Israeli ekibi kyabo, obagarure omu nsi ei waabahaire na baishenkurubo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
