          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "baakugarukira n'omutima gwabo gwona n'amagara gaabo goona, bakiri omu nsi y'abaabanyagire, baakushaba nibaareeba ei enis ei waahaire baishenkurubo eri, n'orurembo oru waatooraine, n'egi nju ei nyombekyeire eiziina ryawe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ohurire okushaba n'okweshengyereza kwabo nooyema omu iguru omu mwanya gwawe ogu otuuramu, obamarire ebyabo, osaasire abantu baawe abakucumwireho.",
          "type": "text",
