              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ogum e ohurire okweshengyereza kw'omwiru waawe n'okw'abantu baawe Israeli, baaba nibakushaba nibareeba omwanya ogu; ogume ohurire nooyema omu iguru, omu mwanya gwawe ogu otuuramu; kandi ku oraahurire, osaasire.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        }
      ]
    },
