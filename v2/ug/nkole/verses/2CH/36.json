            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima baayotsya enju ya Ruhanga, baasheenya orugo rw'amabaare rwa Yerusaalemu, baayotsya zaanyaruju zaayo zoona, baacwekyereza n'ebintu byayo ebirungi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        },
