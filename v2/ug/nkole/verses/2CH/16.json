            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebi Asa yaakozire, okwiha aha kutandika okuhitsya aha muheru, bihandiikirwe omu kitabo ky'abagabe ba Yuda na Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.11",
            "verseOrgIds": [
              "2CH.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima omu mwanka gwa makumi ashatu na mwenda ogw'omu busingye bwe, Asa yaarwara ebigyere, egyo ndwara yaaba ey'amaani munonga; hoona n'obu yaarwaire, tarasherwire buhwezi ahari MUKAMA, kureka akabusherura aha bafumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Asa yaafa omu mwaka gwa makumi ana na gumwe ogw'omu busingye bwe, yaagwejegyera, yaashanga baishenkuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.13",
            "verseOrgIds": [
              "2CH.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
