              "items": [
                {
                  "text": "Yer 34:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baamuziika omu kituuro, eki yaayetimbiire omu rurembo rwa Daudi. Baarambika omutumbi gwe aha kitanda, ekiijwire emigaju ey'emiringo etari emwe, ejwangiibwe abanyamyoga, kandi baacumika omuriro mwingi kumuhaisa ekitiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.14",
            "verseOrgIds": [
              "2CH.16.14"
            ]
