              "items": [
                {
                  "text": "Zek 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba amaisho ga MUKAMA gairuka oku n'oku nigabuga ensi yoona, okweyoreka ku ari ow'amaani kuhwera abaine emitima eshugaine ahariwe. Omuri eki okozire eby'obushema; n'ahabw'ekyo okuruga hati noija kuguma noogira obweme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.9",
            "verseOrgIds": [
              "2CH.16.9"
            ]
          }
        },
        {
