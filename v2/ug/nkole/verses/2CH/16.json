            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho Asa yaagirira omuhanuuzi ekiniga, yaamuta omu nkomo, yaamutwara omu kihome; ahabw'okuba akamugwerwa kubi munonga ahabw'ekyo. Kandi omu bunaku obwo Asa yaabonabonesa abantu bamwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
