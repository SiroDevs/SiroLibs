                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.5"
              },
              "items": [
                {
                  "text": "20:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi akata emyanya mikuru y'okuramizamu omu nsi y'ebibungo eya Yuda, yaareetera abatuuzi ba Yerusaalemu okuruga ahari MUKAMA, kandi yaahabisa n'Abayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.11",
            "verseOrgIds": [
              "2CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.2+2CH.14.3+2CH.14.4+2CH.14.5"
              },
              "items": [
                {
                  "text": "2 Bus 14:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.17.3"
              },
              "items": [
                {
                  "text": "17:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yaatunga ebaruha erikuruga ahari nabi Eliya, neegira eti: Oku nikwo MUKAMA Ruhanga wa Daudi shwenkuru arikugamba naagira ati: Ahabw'okuba togyendeire mu mihanda ya sho Yehoshafaati, n'obu yaakuba eya Asa omugabe wa Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.6"
              },
              "items": [
                {
                  "text": "2 Bus 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogyendeire omu mihanda y'abagabe ba Israeli, waareetera Abayuda n'abatuuzi ba Yerusaalemu okuruga ahari Ruhanga, kandi waataho n'okwita barumuna baawe, ab'enju ya sho, abaabaire nibakuhita, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.13",
            "verseOrgIds": [
              "2CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "reeba, MUKAMA naija kureeta ekibonaboneso kihango aha bantu baawe, aha baana baawe, aha bakazi baawe n'aha bintu byawe byona, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.14",
            "verseOrgIds": [
              "2CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi naiwe wenka noija kurwara endwara mbi munonga omu mara, okuhitsya obu oraagume nooreeta omwoyo buri izooba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.15",
            "verseOrgIds": [
              "2CH.21.15"
            ]
          }
        }
      ]
    },
