              },
              "items": [
                {
                  "text": "26:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima MUKAMA yaareetera Abafilistia n'Abaharabu, abahereraine na Abaesiopia kugirira Yehoraamu ekiniga; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.16",
            "verseOrgIds": [
              "2CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "baija kurwanisa Yuda, baagiteera, baanyagayo ebintu byona ebi baashangire omu nju y'omugabe, kandi n'abatabani n'abakazi be, tiyaatsigaza mwana weena ow'omwojo kureka Yehoahazi omwana we wa bucuranda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima y'ebyo byona, MUKAMA yaamurwaza endwara etarikukira omu mara. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
              "2CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
