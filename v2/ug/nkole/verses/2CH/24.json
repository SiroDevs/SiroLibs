              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka baamugirira enaama, baamuteerera amabaare omu kikaari ky'enju ya MUKAMA ahabw'ekiragiro ky'omugabe. ",
          "type": "text",
          "attrs": {
