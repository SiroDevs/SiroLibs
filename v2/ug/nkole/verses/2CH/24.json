              "2CH.24.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        2 Bag 11:21—12:5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoasi akaba aine emyaka mushanju, obu yaatandika kutegyeka; yaategyekyera Yerusaalemu emyaka makumi ana; nyina akaba naayetwa Zibia owa Beeri-sheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.1",
            "verseOrgIds": [
              "2CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro byona ebya Yehoyaada omunyamurwa Yoasi akakora ebirikusiimwa MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyaada yaamushwererera abakazi babiri, yaazaara abaana b'aboojo n'ab'abaishiki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima y'ekyo Yoasi yaamariirira kuhunduuza enju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaateerana abanyamurwa n'Abaleevi, yaabagira ati: Mwirooko muze omu ndembo za Yuda, muteerane omu Baisraeli boona empiiha z'okuhunduuza enju ya Ruhanga waanyu buri mwaka; kandi mukirahutsye. Kwonka Abaleevi tibaakirahutsya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.5",
            "verseOrgIds": [
              "2CH.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.12+EXO.30.13+EXO.30.14+EXO.30.15+EXO.30.16"
              },
              "items": [
                {
                  "text": "Kur 30:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe nikwo kweta Yehoyaada omukuru, akamugira ati: Ahabw'enki toragiire Baleevi kwiha omu Bayuda n'aba Yerusaalemu emitoijo, ei Musa omugaragwa wa MUKAMA yaaragiire eihanga ryona erya Israeli kuha, ngw ebi ey'Eihema ry'Eby'okuhamya? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.15"
              },
              "items": [
                {
                  "text": "1 Bag 15:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba batabani ba Atalia, ogwo mukazi mubi, bakataaha omu nju ya Ruhanga, kandi ebintu byona eby'omu nju ya MUKAMA ebyashoroirwe, baabikoresa ahabwa Baabaali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo omugabe yaaragiira, baabaija eshanduukye, baagita aheeru y'eirembo ry'enju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.8",
            "verseOrgIds": [
              "2CH.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaranga omuri Yuda n'omuri Yerusaalemu yoona, ku baareetera MUKAMA emitoijo ei Musa omugaragwa wa Ruhanga yaaragiire Abaisraeli bari omu ihamba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyiginya boona n'abantu boona baashemererwa, baareeta emitoijo yaabo, baagita omuri egyo shanduukye okuhitsya obu baaherize. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.10",
            "verseOrgIds": [
              "2CH.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaleevi ku baabaire bareetera abatware b'omugabe egyo shanduukye, baareeba erimu empiiha nyingi, omuhandiiki w'omugabe n'omutware w'omunyamurwa mukuru baija, baihamu ebirimu byona, bagitwara, bagigarura omu mwanya gwayo. Okwo nikwo baabaire bakora buri izooba, bakateerana empiiha nyingi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.11",
            "verseOrgIds": [
              "2CH.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe na Yehoyaada baziha abarikureeberera omurimo gw'enju ya MUKAMA, bagurira abombeki n'ababaizi kuhunduuza egyo nju, hamwe n'abaheesi b'ebyoma n'ab'emiringa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo abaakwatsiibwe omurimo baakora n'amaani, baaguhereza kimwe, enju ya Ruhanga baagihunduuza, baagigarura omu buteeka, baagihamya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.13",
            "verseOrgIds": [
              "2CH.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baagiherize, baareetera omugabe na Yehoyaada empiiha ezashaagireho, baazikoramu ebintu by'enju ya MUKAMA, eby'okuheerezesa, eby'ebitambo by'okwotsya, eshohaani z'obubaane, n'ebintu by'efeeza n'ezaabu. Kandi omu biro bya Yehoyaada byona bakaguma nibatambira ebitambo by'okwotsya omu nju ya MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Yehoyaada yaakura, yaahika omu ngingo zaabukuru, yaafa; kandi akafa ahikize emyaka igana na makumi ashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.15",
            "verseOrgIds": [
              "2CH.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamuziika omu bagabe omu rurembo rwa Daudi, ahabw'okuba akakora gye omuri Israeli ahari Ruhanga n'aha b'enju ye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.16",
            "verseOrgIds": [
              "2CH.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyaada ku yaaherize kufa, abanyiginya ba Yuda baija, baatangirira omugabe. Okuruga aho omugabe yaaguma naahurira ebi barikumugambira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.17",
            "verseOrgIds": [
              "2CH.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
