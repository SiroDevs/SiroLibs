              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.34"
              },
              "items": [
                {
                  "text": "Mat 23:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.49"
              },
              "items": [
                {
                  "text": "Luk 11:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baareka enju ya MUKAMA, Ruhanga wa baishenkurubo, baaheereza Ashera n'ebishushani ebirikuramibwa. Ahabw'eikyo kicumuro kyabo, ekiniga kya Ruhanga kyaija aha Bayuda n'aba Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoona, n'obu kiraabe kyabaire kityo, akaguma naabatumaho baanabi kubagarura ahari MUKAMA; baanabi abo baaboomesereza, kwonka baayanga kuhurira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        }
      ]
    },
