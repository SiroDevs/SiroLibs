            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwo nikwo Yoasi omugabe yaayebirwe embabazi, ezi Yehoyaada, ishe wa Zekaria, yaamugiriire, akamwitira omwana. Zekaria ku yaabaire naafa, yaagira ati: MUKAMA akireebe, kandi ahoore!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
