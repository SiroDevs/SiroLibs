                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.12"
              },
              "items": [
                {
                  "text": "Bir 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA Ruhanga ku ariheza kubabinga, baakuruga omu maisho, otarigira omu mutima gwawe oti: MUKAMA andeetsire omu nsi egi kugikubuura ahabw'okuhikiirira kwangye; haza kunu MUKAMA abingire ago mahanga omu maisho gaanyu ahab'wobubi bwago. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.4",
            "verseOrgIds": [
              "DEU.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
