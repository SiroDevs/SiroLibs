              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi weena oryanga kuhurira ebigambo byangye ebi arigamba omu iziina ryangye, ndyakimutura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.19",
            "verseOrgIds": [
              "DEU.18.19"
            ]
          }
        },
        {
