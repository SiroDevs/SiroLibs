          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku muryebuuza omu mitima yaanyu muti: Nitubaasa tuta kumanya ekigambo eki MUKAMA atagambire? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.21",
            "verseOrgIds": [
              "DEU.18.21"
            ]
          }
        },
