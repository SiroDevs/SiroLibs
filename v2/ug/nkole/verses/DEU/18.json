              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka nabi oryetuma kugamba ekigambo omu iziina ryangye eki ntamuragiire kugamba, nari shi origamba omu iziina rya baaruhanga abandi, nabi ogwo aryafa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.20",
            "verseOrgIds": [
              "DEU.18.20"
            ]
          }
        },
        {
