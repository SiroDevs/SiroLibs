            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA Ruhanga waanyu aryabaimukiza nabi nkaanye, arugye omuriimwe omuri beene waanyu; ogwo niwe murihurira; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.15",
            "verseOrgIds": [
              "DEU.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "buzima kiryaba nk'ebi mwashabire MUKAMA Ruhanga waanyu byona, muri ahari Horebu aha izooba riri eri mwabaire muteeraine, nimugira muti: Nitukweshengyereza tutagaruka kuhurira eiraka rya MUKAMA Ruhanga waitu, n'obu kwakuba okureeba ogu muriro mwingi obundi, tutakaafa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.16",
            "verseOrgIds": [
              "DEU.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yangira ati: Ebi bagambire byona, bihikire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.17",
            "verseOrgIds": [
              "DEU.18.17"
            ]
          }
        },
        {
