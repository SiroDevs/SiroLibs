        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.27"
              },
              "items": [
                {
                  "text": "Lev 18:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku murihika omu nsi ei MUKAMA Ruhanga waanyu arikubaha, mutaritooreza emicwe y'amahanga ago erikwangwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.9",
            "verseOrgIds": [
              "DEU.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatarigira omuntu weena omuriimwe owaarabya mutabani we nari muhara we omu muriro, nari owaaba omufumu, nari orikuragura ebiribaho, nari omuteezi w'ebyatsi, nari omucecezi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.10",
            "verseOrgIds": [
              "DEU.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nari omuhi w'engisha, nari orikubandwa emizimu, nari omurogi, nari orikubuuza abafu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.11",
            "verseOrgIds": [
              "DEU.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.24"
              },
              "items": [
                {
                  "text": "Lev 18:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba orikukora ebyo weena n'ekirikunugwa ahari MUKAMA, kandi ahabw'ebirikunugwa ebyo MUKAMA Ruhanga waanyu nikyo arikubingira amahanga ago omu maisho gaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.12",
            "verseOrgIds": [
              "DEU.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.18.32"
              },
              "items": [
                {
                  "text": "Zab 18:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.48"
              },
              "items": [
                {
                  "text": "Mat 5:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mube abahikire omu maisho ga MUKAMA Ruhanga waanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.13",
            "verseOrgIds": [
              "DEU.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.6"
              },
              "items": [
                {
                  "text": "2 Bag 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba amahanga ago, agu murikubuura, gata omutima aha barikuragura ebiribaho n'aha bafumu; kwonka imwe MUKAMA Ruhanga waanyu takabaikirizaga kukora mutyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.14",
            "verseOrgIds": [
              "DEU.18.14"
            ]
          }
        }
      ]
    },
