          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.28"
              },
              "items": [
                {
                  "text": "Ezk 18:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.17"
              },
              "items": [
                {
                  "text": "Luk 15:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo byona ku biriheza kubabaho, eby'emigisha n'eby'emikyeeno, ebi naataire omu maisho gaanyu, mwabiijukira omu mahanga goona, agu MUKAMA Ruhanga waanyu ariba ababingiiremu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwagaruka ahari MUKAMA Ruhanga waanyu, mwahurira eiraka rye, mwakora ebyo byona ebi ndikubaragiira eri izooba, imwe n'abaana baanyu, mwabikora n'omutima gwanyu gwona n'amagara gaanyu goona; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.14"
              },
              "items": [
                {
                  "text": "Yer 29:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obwo MUKAMA Ruhanga waanyu aryagarura abantu baanyu abaanyagirwe, abagirire esaasi, agarukye abateeranire hamwe, abaihe omu mahanga goona, agu MUKAMA Ruhanga waanyu yaabataataanisiizemu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baanyu ababingirwe, n'obu bariba bari aha muheru gw'ensi, MUKAMA Ruhanga waanyu aryabataruura, abaiheyo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi aryabagarura omu nsi eyaabaire eri eya baashwenkuriimwe, mugizemu ebe eyaanyu; abagirire gye, abakanyise mukire baashwenkuriimwe obwingi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.5",
            "verseOrgIds": [
              "DEU.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.19"
              },
              "items": [
                {
                  "text": "Ezk 11:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi MUKAMA Ruhanga waanyu aryashara ekishushu ky'aha mitima yaanyu n'ey'oruzaaro rwanyu, mukunde MUKAMA Ruhanga waanyu n'omutima gwanyu gwona n'amagara gaanyu goona, mubone kugumaho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA Ruhanga waanyu aryata egyo mikyeeno yoona aha bazigu baanyu n'aha barikubanga boona bakabahiiga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muryagaruka muhurire eiraka rya MUKAMA Ruhanga waanyu, mworobere ebiragiro bye byona ebi ndikubaragiira eri izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.27"
              },
              "items": [
                {
                  "text": "Ezk 34:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.41"
