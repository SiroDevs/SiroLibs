            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nimbagambirira kimwe eri izooba, muryahwerekyerera, timurihangaarira mu nsi, ei murikuza kwambuka Yorudani kuza kukubuura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.18",
            "verseOrgIds": [
              "DEU.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri izooba niinyeta eiguru n'ensi kubashinja, ku naata omu maisho gaanyu amagara n'okufa, omugisha n'omukyeeno; n'ahabw'ekyo mutoorane amagara, mubone kugumaho, imwe n'oruzaaro rwanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.19",
            "verseOrgIds": [
              "DEU.30.19"
            ]
          }
        },
