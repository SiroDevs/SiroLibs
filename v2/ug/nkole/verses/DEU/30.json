              "items": [
                {
                  "text": "Mak 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, eri izooba naata omu maisho gaawe amagara n'ebirungi, kandi okufa n'ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku oryorobera ebiragiro bya MUKAMA Ruhanga waawe, ebi ndikukuragiira eri izooba, okukunda MUKAMA Ruhanga waawe, okugyendera omu mihanda ye, n'okukwata ebiragiro bye n'ebi yaataireho n'ebi yaaragiire, obwo oryagumaho, okanye, kandi MUKAMA Ruhanga waawe aryakuheera omugisha omu nsi ei orikuza kukubuura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omutima gwawe ku guriteishuka, waayanga kuhurira, waabeihwabeihwa, waaramya baaruhanga abandi, waabaheereza, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.17",
            "verseOrgIds": [
              "DEU.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 30:18"
          },
          "items": [
