          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Musa yaagamba ebigambo by'ekyeshongoro eki, Abaisraeli boona babihuriire, okuhitsya obu yaabiherize.",
          "type": "text",
          "attrs": {
