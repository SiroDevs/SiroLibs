      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagyenda, yaagambira Abaisraeli boona ebigambo ebi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.1",
            "verseOrgIds": [
              "DEU.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.7"
              },
              "items": [
                {
                  "text": "Kur 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.12"
              },
              "items": [
                {
                  "text": "Kub 20:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaabagira ati: Eri izooba naahitsya emyaka igana na makumi abiri; tinkibaasa kushohora n'okutaaha; kandi MUKAMA akangira ati: Toryambuka Yorudani egi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.2",
            "verseOrgIds": [
              "DEU.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.3"
              },
              "items": [
                {
                  "text": "Bir 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA Ruhanga waanyu niwe aribeebembera kwambuka, kandi niwe arihwerekyereza amahanga ago omu maisho gaanyu, mukagakubuura; kandi Yoshua niwe aribeebembera kwambuka, nk'oku MUKAMA yaagambire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.3",
            "verseOrgIds": [
              "DEU.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.24"
              },
              "items": [
                {
                  "text": "Kub 21:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA aryagagira, nk'oku yaagizire Sihooni na Ogi, abagabe b'Abaamori, abu yaacwekyereize, n'ensi yaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.4",
            "verseOrgIds": [
              "DEU.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA aryagahayo omu maisho gaanyu, mugagire nk'ebiragiro byona ebi naabaragiire oku biri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.5",
            "verseOrgIds": [
              "DEU.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.6"
              },
              "items": [
                {
                  "text": "Zab 118:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.5"
              },
              "items": [
                {
                  "text": "Yos 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.5"
              },
              "items": [
                {
                  "text": "Heb 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mube ab'amaani, mugume omutima; mutagira obwoba, kandi mutabatiina; ahabw'okuba MUKAMA Ruhanga waanyu niwe arikubeebembera; taribahemukaho, kandi taribatsigaho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.7",
            "verseOrgIds": [
              "DEU.31.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.38"
              },
              "items": [
                {
                  "text": "Bir 1:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaayeta Yoshua, yaamugambirira omu maisho g'Abaisraeli boona ati: Ba ow'amaani, ogume omutima, ahakuba oryagyenda n'abantu aba omu nsi ei MUKAMA yaarahiire kuha baishenkurubo; kandi niiwe origibahunguza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.7",
            "verseOrgIds": [
              "DEU.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.31"
              },
              "items": [
                {
                  "text": "Rom 8:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA niwe arikukwebembera; aryaguma naiwe, tarikuhemukaho, kandi tarikutsigaho; otatiina, n'obu kwakuba okuhahaaza omutima.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.8",
            "verseOrgIds": [
              "DEU.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.8",
            "verseOrgIds": [
              "DEU.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaahandiika ebyo biragiro, yaabiha abanyamurwa beene Leevi, abaabaire baheeka eshanduukye y'endagaano ya MUKAMA, n'abakuru b'Abaisraeli boona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.9",
            "verseOrgIds": [
              "DEU.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaabaragiira naagira ati: Aha muheru gwa buri myaka mushanju, omu bunaku obwatairweho omu mwaka gw'okuha obusingye, aha bugyenyi bw'Ensiisira, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.10",
            "verseOrgIds": [
              "DEU.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.2"
              },
              "items": [
                {
                  "text": "2 Bag 23:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.1"
              },
              "items": [
                {
                  "text": "Neh 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli boona ku bariba baizire kumurikwa omu maisho ga MUKAMA Ruhanga waanyu omu mwanya ogu aritoorana, oryaguma oshomere ebiragiro ebi omu maisho g'Abaisraeli boona, nibabihurira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.11",
            "verseOrgIds": [
              "DEU.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryateerana abantu, abashaija n'abakazi n'abaana n'abashuhuuki abariba batwire naimwe, babihurire, beegye kutiina MUKAMA Ruhanga waanyu, bateho omutima kworobera ebigambo byona eby'ebi biragiro, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.12",
            "verseOrgIds": [
              "DEU.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.2"
              },
              "items": [
                {
                  "text": "Bir 11:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.6"
              },
              "items": [
                {
                  "text": "Zab 78:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi n'abaana baabo, abatakabimanyaga, babihurire, beegye kutiina MUKAMA Ruhanga waanyu ebiro byona ebi murimara omu nsi, ei murikwambuka Yorudani kuza kukubuura.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        }
      ]
    },
    {
