            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: Reeba, obunaku bw'okufa kwawe buri haihi; yeta Yoshua, mwije mweyorekye omu Ihema ry'okubugaabuganiramu, mbone kumukwatsa omurimo. Musa na Yoshua baagyenda, baayemurika omu Ihema ry'okubugaabuganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.14",
            "verseOrgIds": [
              "DEU.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaayeyoreka omuri eryo Ihema, ari omu nyomyo y'ekicu, kandi egyo nyomyo y'ekicu yaayemerera ahaiguru y'omuryango gwaryo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.15",
            "verseOrgIds": [
              "DEU.31.15"
            ]
          }
        }
      ]
    },
