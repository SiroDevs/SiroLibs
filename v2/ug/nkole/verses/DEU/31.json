                  "text": "Bar 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obwo bunaku ekiniga kyangye kiryabaakaho nk'omuriro, mbarugyeho, mbaime amaisho, bamarweho, bahikweho ebibi bingi n'eminyangararo; n'ahabw'ebyo omu bunaku obwo baryagira bati: Ekitureeteire kuhikwaho ebibi ebi, t'ahabw'okuba Ruhanga tari muriitwe? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.17",
            "verseOrgIds": [
              "DEU.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buzimazima omu bunaku obwo ndyabaima amaisho, mbature ebibi byona ebi bariba bakozire, omu kwehongyera baaruhanga abandi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.18",
            "verseOrgIds": [
              "DEU.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo muhandiikye ekyeshongoro eki, iwe okyegyese Abaisraeli, kandi okibeeshongoze, kimbeere obujurizi bw'okushinja Abaisraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.19",
            "verseOrgIds": [
              "DEU.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.26"
              },
              "items": [
                {
                  "text": "Neh 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.6"
              },
              "items": [
                {
                  "text": "Hos 13:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba ku ndiheza kubahitsya omu nsi ei naarahiire kuha baishenkurubo, ensi y'amate n'obwoki, baaheza kurya n'okuhaaga, baagomoka, baryayehongyera baaruhanga abandi, babakorere, bangaye, baite endagaano yangye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.20",
            "verseOrgIds": [
              "DEU.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.24"
              },
              "items": [
                {
                  "text": "Yoh 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.25"
              },
              "items": [
                {
                  "text": "Amo 5:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ku barihikwaho ebibi bingi n'eminyangararo, ekyeshongoro eki kiryaba mushinja w'okuhamya omu maisho gaabo, ahabw'okuba tikiryeba, kiryaguma nikyeshongorwa oruzaaro rwabo. Ahakuba nimmanya ebiteekateeko byabo, ebi baine na hati, ntakabahikize mu nsi ei naarahiire kubaha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.21",
            "verseOrgIds": [
              "DEU.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.21",
            "verseOrgIds": [
              "DEU.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Musa yaahandiika ekyeshongoro ekyo ahari eryo izooba, yaakyegyesa Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.22",
            "verseOrgIds": [
              "DEU.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.6"
              },
              "items": [
                {
                  "text": "Yos 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi MUKAMA yaayehanangiriza Yoshua mwene Nuuni, naagira ati: Ba ow'amaani, ogume omutima, ahakuba niiwe orihitsya Abaisraeli omu nsi ei naarahiire kubaha; kandi ndyaguma naiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ku yaaherize kuhandiika ebigambo by'ebyo biragiro omu kitabo, yaabimariramu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.24",
            "verseOrgIds": [
              "DEU.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaaragiira Abaleevi abaabaire baheeka eshanduukye y'endagaano ya MUKAMA, naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.9"
              },
              "items": [
                {
                  "text": "1 Bag 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.8"
              },
              "items": [
                {
                  "text": "2 Bag 22:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwakiire eki kitabo ky'ebiragiro, mukite aha rubaju rw'eshanduukye y'endagaano ya MUKAMA Ruhanga waanyu, kigume kiri omujurizi w'okubashinja. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.26",
            "verseOrgIds": [
              "DEU.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.24"
              },
              "items": [
                {
                  "text": "Bir 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba nimmanya obugomi bwanyu n'ebitsya byanyu ebigangaire. Reeba, eri izooba mwagomera MUKAMA nkibaine; kaashwa ku ndiba naafiire, muryashura ki? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.19"
              },
              "items": [
                {
                  "text": "Bir 30:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Munteeranire abakuru b'enganda zaanyu boona n'abategyeki baanyu, mbone kugamba ebigambo ebi, babihurire, n'okweta eiguru n'ensi kubashinja. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.28",
            "verseOrgIds": [
              "DEU.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.19"
              },
              "items": [
                {
                  "text": "Bar 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.9"
              },
              "items": [
                {
                  "text": "Hos 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba nimmanya ngu, ku ndiheza kufa, muryayesiisira kimwe, muteishukye omuhanda ogu naabaragiire; kandi omu biro ebirikurataho muryahikwaho ebibi bingi, ahabw'okuba muryakora ebirikwangwa MUKAMA, kumugwisa kubi n'ebi murikora n'emikono yaanyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        }
      ]
    },
