              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.19"
              },
              "items": [
                {
                  "text": "Bar 11:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Onyikirize, ndabe omu nsi yaawe; niinyija kutoora omuhanda rugyendwa, tindikwija kukiikama aha rubaju rwa buryo nari orwa bumosho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.27",
            "verseOrgIds": [
              "DEU.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eby'okurya oryabinguza nkuhe empiiha, mbone kurya; n'amaizi oganguze nkuhe empiiha, mbone kunywa; kwonka ondekye, ndabemu n'ebigyere, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.28",
            "verseOrgIds": [
              "DEU.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nk'aba Esau abatwire Seiri, n'Abamoabu abatwire Aari, oku bangiriire, okuhitsya obu ndyambuka Yorudani, nkahika omu nsi ei MUKAMA Ruhanga waitu arikutuha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
