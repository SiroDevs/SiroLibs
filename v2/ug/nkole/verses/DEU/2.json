              "items": [
                {
                  "text": "Zab 44:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga Aroeri eri aha rubaju rw'oruhanga rwa Arunooni, n'okuruga aha rurembo oruri omuri orwo ruhanga, okuhika Gileadi, tihaagira rurembo rwaturema ahabw'oburaingwa bwarwo. MUKAMA Ruhanga waitu yaazihayo zoona omu maisho gaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.36",
            "verseOrgIds": [
              "DEU.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka tiwaahika haihi n'ensi y'Abaamoni, n'obu haakuba aha nkungu z'omugyera Yaboki, nari endembo z'omu nsi y'ebibungo, n'ahandi hoona ahu MUKAMA Ruhanga waitu yaatuzibiire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.37",
            "verseOrgIds": [
              "DEU.2.37"
            ]
