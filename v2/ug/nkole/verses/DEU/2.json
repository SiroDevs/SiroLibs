              "attrs": {
                "loc": "JOS.11.19"
              },
              "items": [
                {
                  "text": "Yos 11:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
