                "loc": "DEU.29.7"
              },
              "items": [
                {
                  "text": "Bir 29:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA Ruhanga waitu yaamuhayo omu maisho gaitu, twamwita n'abatabani n'abantu be boona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.33",
            "verseOrgIds": [
              "DEU.2.33"
            ]
          }
        },
