                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu bunaku obwo twakwata endembo ze zoona, twazicwekyerereza kimwe, abashaija, n'abakazi n'abaana; titwatsigamu na wa kizira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.34",
            "verseOrgIds": [
              "DEU.2.34"
            ]
          }
        },
        {
