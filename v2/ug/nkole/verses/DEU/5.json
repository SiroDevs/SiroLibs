          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mwangambiire ebigambo byanyu, MUKAMA yaabihurira; yangira ati: Mpuriire ebigambo ebi abantu abo bakugambiire; ebi bagambire byona, babigambire gye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.28",
            "verseOrgIds": [
              "DEU.5.28"
            ]
          }
        },
