                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nangwa ku baakugira omutima nk'ogwo gukabareetera kuntiina obutoosha n'okworobera ebiragiro byangye byona, bakaaba gye, n'oruzaaro rwabo ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.29",
            "verseOrgIds": [
              "DEU.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irooko obagire oti: Mugarukye omu mahema gaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.30",
            "verseOrgIds": [
              "DEU.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka iwe, ogume aha, ahu ndi, naanye nkugambire eki ndikuragiira kyona n'ebiragiro ebyatairweho n'ebyaragiirwe, ebi oshemereire kubeegyesa, babone kubyoroberera omu nsi ei ndikubaha kuba eyaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.31",
            "verseOrgIds": [
              "DEU.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.7"
              },
              "items": [
                {
                  "text": "Yos 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo muteho omutima, mukore, nk'oku MUKAMA Ruhanga waanyu abaragiire; mutariteishukira aha mukono gwa buryo nari ogwa bumosho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.12"
              },
              "items": [
                {
                  "text": "Bir 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.23"
              },
              "items": [
                {
                  "text": "Yer 7:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mugume mugyendere omu muhanda gwona ogu MUKAMA Ruhanga waanyu abahabwire, mubone kugumaho muri gye, muhangaarire omu nsi ei murikubuura.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
