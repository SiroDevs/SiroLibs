          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijuka okweza ekiro kya sabato; nk'oku MUKAMA Ruhanga waawe yaakuragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro mukaaga ogume okore; obe nimwo waakorera emirimo yaawe yoona; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka ekiro kya mushanju niyo sabato ahari MUKAMA Ruhanga waawe; otarikoreraho omurimo gwona, iwe nari mutabani waawe, nari muhara waawe, nari omuhuuku waawe, nari omuzaana waawe, nari ente yaawe, nari endogoya yaawe, nari eki otungire kyona omu matungo gaawe, nari omunyaihanga ori omu ka yaawe; omuhuuku waawe n'omuzaana waawe bahuumure nkaiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryaguma oijukye ku waabaire ori omuhuuku omu nsi ya Misri, MUKAMA Ruhanga waawe akakwihayo n'omukono gw'amaani kandi ogubangire. Nikyo MUKAMA Ruhanga waawe yaakuragiriire kurinda sabato.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
