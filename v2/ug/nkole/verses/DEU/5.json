                "loc": "EXO.20.2+EXO.20.3+EXO.20.4+EXO.20.5+EXO.20.6+EXO.20.7+EXO.20.8+EXO.20.9+EXO.20.10+EXO.20.11+EXO.20.12+EXO.20.13+EXO.20.14+EXO.20.15+EXO.20.16+EXO.20.17"
