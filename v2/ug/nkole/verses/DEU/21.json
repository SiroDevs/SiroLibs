        },
        {
          "text": " Omuntu ku ariba aine omwana w'omwojo empiga kandi omugomi, otarikuhurira ishe nari nyina, n'obu baakumuhana bata, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.18",
            "verseOrgIds": [
              "DEU.21.18"
            ]
          }
        },
        {
