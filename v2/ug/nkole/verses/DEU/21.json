                "loc": "GEN.29.33"
              },
              "items": [
                {
                  "text": "Kut 29:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omushaija, ku ariba aine abakazi babiri, omwe ari enkundwakazi, n'ondi ari enyangwakazi, kandi bombi bamuzaariire abaana, enkundwakazi n'enyangwakazi; kandi omwana w'omwojo ow'okubanza ku ariba ari ow'enyangwakazi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.15",
            "verseOrgIds": [
              "DEU.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.3"
              },
              "items": [
                {
                  "text": "2 Bus 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " aha izooba eri ariragiraho abaana be ebi atungire, tariikirizibwa kuhindura omwana w'enkundwakazi kuba omwana we mukuru okukira ogwo ow'enyangwakazi owaabandize kuzaarwa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.16",
            "verseOrgIds": [
              "DEU.21.16"
            ]
          }
        },
        {
