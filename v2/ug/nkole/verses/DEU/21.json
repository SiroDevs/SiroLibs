          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ishe na nyina baryamukwata, bamutwarire abakuru b'orurembo rwabo aha irembo ryarwo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.19",
            "verseOrgIds": [
              "DEU.21.19"
            ]
          }
        },
        {
