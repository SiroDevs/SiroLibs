                "loc": "1CH.5.1"
              },
              "items": [
                {
                  "text": "1 Bus 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka aryaikiriza omwana w'enyangwakazi owaabandize kuzaarwa, ahabw'okumuraga emigabo ebiri y'ebi atungire; ahabw'okuba niwe maani ge ag'okuzaara gaatandikiireho; n'ebishemereire omwana w'okubanza n'ebye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.17",
            "verseOrgIds": [
              "DEU.21.17"
            ]
          }
