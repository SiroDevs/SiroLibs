              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "bagambire abakuru b'orwo rurembo bati: Ogu mwana waitu aba empiga kandi omugomi, tatuhurira; n'omunyamururu kandi omusinzi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.20",
            "verseOrgIds": [
              "DEU.21.20"
            ]
          }
        },
        {
