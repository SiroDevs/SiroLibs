                {
                  "text": "Yos 8:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi MUKAMA Ruhanga waanyu ku aribahitsya omu nsi, ei murikuza kukubuura, muryata omugisha aha rushozi Gerizimu n'omukyeeno aha rushozi Ebali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enshozi ezo tiziri seeri ya Yorudani, oburengyerwa-izooba bw'omuhanda omu nsi y'Abanyakanaani, abatwire omuri Araba, ahashungaine na Gilugaali, aha rubaju rw'emyela ya Moore? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba nimwija kwambuka Yorudani kuza omu nsi ei MUKAMA Ruhanga waanyu arikubaha kukubuura, kandi kwo muryagikubuura, mugituuremu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muryaguma mute omutima aha biragiro ebyatairweho n'ebyaragiirwe byona, ebi ndikuta omu maisho gaanyu eri izooba, mubyorobere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.32",
            "verseOrgIds": [
              "DEU.11.32"
            ]
          }
