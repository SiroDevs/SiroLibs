    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo oryaguma okunde MUKAMA Ruhanga waawe, orinde obutoosha ebi yaakukwatsize, n'ebyatairweho, n'ebyaragiirwe, n'ebiragiro bye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.1",
            "verseOrgIds": [
              "DEU.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri izooba mumanye ebi, (ahakuba tindikugambira baana baanyu, abatakabimanyire n'obu kwakuba okubireeba), muteekateekye aha kuhana kwa MUKAMA Ruhanga waanyu, obukuru bwe, omukono gwe gw'amaani kandi ogubangire, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.2",
            "verseOrgIds": [
              "DEU.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "obumanyiso bwe n'ebi yaakozire Faraho omugabe wa Misri n'ensi ye yoona omu nsi ya Misri; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.3",
            "verseOrgIds": [
              "DEU.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ebi yaakozire eihe rya Misri n'embaraasi zaabo n'ebigaari byabo; oku yaagarwire amaizi g'Enyanja erikutukura, gakabashweka babakuratiire, MUKAMA akabacwekyerereza kimwe, batagarukye kwimutsya omutwe n'okuhitsya hati; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.4",
            "verseOrgIds": [
              "DEU.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ebi yaabakozire muri omu ihamba, okuhitsya obu mwahikire aha; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.5",
            "verseOrgIds": [
              "DEU.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.1"
              },
              "items": [
                {
                  "text": "Kub 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.17"
              },
              "items": [
                {
                  "text": "Zab 106:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'ebi yaakozire Dasani na Abiraamu beene Eliabu, mutabani wa Reubeeni, oku eitaka ryayashamire, rikabamira n'ab'omu maka gaabo n'amahema gaabo n'ebintu byona ebihuriire ebi baabaire nibagyenda nabyo, bikacwekyererera ahagati y'Abaisraeli boona; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.6",
            "verseOrgIds": [
              "DEU.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba amaisho gaanyu gakeereebera ebikuru byona ebi MUKAMA yaakozire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo mushemerereire kukwata ebiragiro byona ebi ndikubaragiira eri izooba, mubone kuba ab'amaani, muze omu nsi ei murikuza kwambukamu kukubuura, ku eba eyaanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.8",
            "verseOrgIds": [
              "DEU.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mubone kuhangaarira omu nsi ei MUKAMA yaarahiire kuha baashwenkuriimwe n'oruzaaro rwabo, ensi ey'amate n'obwoki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.9",
            "verseOrgIds": [
              "DEU.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba ensi ei murikuzamu kukubuura ti nk'eya Misri ei mwarugiremu, ei mwabaire mubiba embibo, mukareetamu amaizi n'ebigyere byanyu, nk'oku bagira omusiri gw'emboga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.10",
            "verseOrgIds": [
              "DEU.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.7"
              },
              "items": [
                {
                  "text": "Bir 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka ensi, ei murikuzamu kukubuura, n'ensi y'ebibungo n'empanga erikuguubwamu amaizi g'enjura erikuruga omu iguru, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.11",
            "verseOrgIds": [
              "DEU.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ensi ei MUKAMA Ruhanga waanyu arikutaho omutima; kandi MUKAMA Ruhanga waanyu atuura agitaireho amaisho, okwiha aha kutandika kw'omwaka okuhitsya aha muheru gwagwo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku muryezirika kworobera ebiragiro byangye, ebi ndikubaragiira eri izooba, okukunda MUKAMA Ruhanga waanyu, n'okumuheereza n'omutima gwanyu gwona n'amagara gaanyu goona, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.13",
            "verseOrgIds": [
              "DEU.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.12"
              },
              "items": [
                {
                  "text": "Bir 28:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.23"
              },
              "items": [
                {
                  "text": "Yoel 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naanye ndyagwisiza ensi yaanyu enjura omu bunaku bwayo, ey'eibiba n'eya katumba, mubone kushaaruura engano zaanyu, na viinyo yaanyu n'amajuta gaanyu g'emizeituuni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.14",
            "verseOrgIds": [
              "DEU.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.104.14"
              },
              "items": [
                {
                  "text": "Zab 104:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndyameza obunyaatsi omu mariisizo gaanyu ahabw'amatungo gaanyu, murye, mwigute. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.15",
            "verseOrgIds": [
              "DEU.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwerinde, emitima yaanyu etaribeihwa-beihwa, mukateishuka, mukaheereza baaruhanga abandi, mukabaramya, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.16",
            "verseOrgIds": [
              "DEU.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.26"
              },
              "items": [
                {
                  "text": "2 Bus 6:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.7.13"
              },
              "items": [
                {
                  "text": "7:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA akabagirira ekiniga kingi, akakinga eiguru, enjura ekabura, ensi ekareka kweza emyaka yaayo, mukarahuka kuhwerekyerera, mukahwa omu nsi enungi ei MUKAMA arikubaha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo mute ebigambo byangye ebi aha mitima yaanyu n'omu magara gaanyu, mubikome aha mikono yaanyu, bibe akamanyiso, mubite aha buso bwanyu ahagati y'amaisho gaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.18",
            "verseOrgIds": [
              "DEU.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.22.6"
              },
              "items": [
                {
                  "text": "Enf 22:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mugume mubyegyese abaana baanyu, mubigaaniireho mushutami omu maka gaanyu, nimugyenda omu muhanda, nimuza kubyama, kandi nimwimuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.19",
            "verseOrgIds": [
              "DEU.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muryabihandiika aha biti by'emiryango y'amaju gaanyu n'aha nyigi z'amarembo gaanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.20",
            "verseOrgIds": [
              "DEU.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.2"
              },
              "items": [
                {
                  "text": "Enf 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.10"
              },
              "items": [
                {
                  "text": "4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ebiro byanyu n'eby'abaana baanyu bibone kukanya omu nsi ei MUKAMA yaarahiire kuha baashwenkuriimwe omwanya gwona ogu eiguru ririmara riri ahaiguru y'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba ku muryezirika kukwata ebiragiro ebi byona ebi ndikubaragiira, mwabyorobera, okukunda MUKAMA Ruhanga waanyu, n'okugyendera omu mihanda ye yoona, n'okumuhamiraho, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.22",
            "verseOrgIds": [
              "DEU.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.38"
              },
              "items": [
                {
                  "text": "Bir 4:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obwo MUKAMA aryabinga amahanga ago goona omu maisho gaanyu, kandi muryakubuura amahanga agarikubakira obukuru n'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.23",
            "verseOrgIds": [
