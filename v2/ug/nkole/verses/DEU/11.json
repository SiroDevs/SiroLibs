                {
                  "text": "Bir 28:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " omugisha ku muryorobera ebiragiro bya MUKAMA Ruhanga waanyu, ebi ndikubaragiira eri izooba, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
