            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, eri izooba ninta omu maisho gaanyu omugisha n'omukyeeno; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
