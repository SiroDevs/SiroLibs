                  "text": "Bir 28:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'omukyeeno ku muryanga kworobera ebiragiro bya MUKAMA Ruhanga waanyu, mwateishuka omuhanda ogu ndikubaragiira eri izooba, mwakuratira baaruhanga abandi, abu mutakamanyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        },
