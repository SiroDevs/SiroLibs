                {
                  "text": "Bir 7:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tihaine muntu weena oribaasa kubaza omu kaso; MUKAMA Ruhanga waanyu aryaitsa obwoba ensi yoona ei muriribatamu, kandi agireetere okutiina ahabwanyu, nk'oku yaabaraganiise.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        }
