                {
                  "text": "Yos 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwanya gwona ogu muriribatamu n'ebigyere byanyu guryaba ogwanyu; omwatano gwanyu guryatandikira aha ihamba na Lebanooni, n'aha mugyera Furaati, guhikye aha Nyanja y'oburengyerwa-izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.24",
            "verseOrgIds": [
              "DEU.11.24"
            ]
          }
        },
        {
