            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuamoni nari Omumoabu atariza omu kuteerana kw'abantu ba MUKAMA; hatarigira ow'omu ruzaaro rwabo owaaza omu kuteerana kw'abantu ba MUKAMA ebiro byona okuhitsya aha ruzaaro rwabo rw'omwijukuru wa ikumi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.3",
            "verseOrgIds": [
              "DEU.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
