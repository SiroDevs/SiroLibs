          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu by'okurwanisa byanyu muryagiramu ekihosho; omuntu ku arishohora kuza aha ishaazi, akitimbise ekiina; yaaza kurugaho, ashwekye ahi yaaruga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.13",
            "verseOrgIds": [
              "DEU.23.13"
            ]
          }
        },
        {
