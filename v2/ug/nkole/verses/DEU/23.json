                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba MUKAMA Ruhanga waawe agyendagyenda omu rusiisira rwanyu, okubajuna n'okuhayo abazigu baanyu omu maisho gaanyu; n'ahabw'ekyo orusiisira rwanyu rushemereire kuba orurikwera; MUKAMA arekye kureeba omuriimwe ekintu kyona ekitashemeire, akahinduka akabarugaho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.14",
            "verseOrgIds": [
              "DEU.23.14"
            ]
          }
        }
      ]
    },
