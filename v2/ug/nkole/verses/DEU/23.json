              "items": [
                {
                  "text": "Bir 10:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutaryangira kimwe Abanyaedomu, ahabw'okuba ni beene waanyu; mutaryangira kimwe Abanyamisri, ahabw'okuba mukaba muri abanyaihanga omu nsi yaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.7",
            "verseOrgIds": [
              "DEU.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oruzaaro rwabo orw'abaana ba baijukuru baabo baryaikirizibwa kuza omu kuteerana kw'abantu ba MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.8",
            "verseOrgIds": [
              "DEU.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
