          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muryagira omwanya aheeru y'orusiisira ahu muriguma nimushohorera; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.12",
            "verseOrgIds": [
              "DEU.23.12"
            ]
          }
        },
