                "loc": "PSA.105.41"
              },
              "items": [
                {
                  "text": "41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.3"
              },
              "items": [
                {
                  "text": "1 Kor 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.4"
              },
              "items": [
                {
                  "text": "Mat 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaakucureeza, yaakureka waagira enjara, yaakugaburira emaanu, ei waabaire otakamanyaga, n'obu baakuba baashwenkuru, ngu akumanyise ku omuntu atatungwa by'okurya byonka, kureka ku atungwa ekigambo kyona ekiruga omu kanwa ka Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.5"
              },
              "items": [
                {
                  "text": "Bir 29:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebijwaro byawe tibirakukuriireho, n'ekigyere kyawe tikirazimbire, emyaka egyo yoona makumi ana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
              "DEU.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.5"
              },
              "items": [
                {
                  "text": "Neh 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.19"
              },
              "items": [
                {
                  "text": "Kush 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omanye omu mutima gwawe, ku MUKAMA Ruhanga waawe akuhana, nk'oku omuntu ahana omwana we. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryakwata ebiragiro bya MUKAMA Ruhanga waawe noogyendera omu mihanda ye, noomutiina; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba MUKAMA Ruhanga waawe naakutwara omu nsi enungi, erimu otugyera tw'amaizi, n'enshuro n'ebiyanja by'amaizi maraingwa, agarikuhimintika nigaruga omu mpanga n'omu bibungo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ensi ey'engano na sayiri n'emizaabibu n'emitiini kandi n'amakomamahanga; ensi y'amajuta g'emizeituuni n'obwoki; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.8",
            "verseOrgIds": [
              "DEU.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ensi ei oriryamu eby'okurya bitatuube, kandi ei otarikyeneramu kintu kyona; ei amabaare gaayo gari obutare, kandi ei oritimba emiringa omu bibungo byayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.9",
            "verseOrgIds": [
              "DEU.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.103.2"
              },
              "items": [
                {
                  "text": "Zab 103:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.18"
              },
              "items": [
                {
                  "text": "1 Tes 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oryarya, oigute, osiime MUKAMA Ruhanga waawe ahabw'ensi nungi ei akuhaire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        }
      ]
