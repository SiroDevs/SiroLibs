          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryaguriira omu ka yaawe; abatashemeire n'abashemeire boona nibaikirizibwa kuguryaho, nk'oku barya esirabo n'empara. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.22",
            "verseOrgIds": [
              "DEU.15.22"
            ]
          }
