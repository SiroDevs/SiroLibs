        },
        {
          "text": "Kureka iwe n'ab'omu ka yaawe muryaguriira omu maisho ga MUKAMA Ruhanga waawe buri mwaka omu mwanya ogu MUKAMA aritoorana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
