          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku guriba gwine akamogo, oburema nari obuhumi, nari akandi kamogo koona akabi, otarigutambira MUKAMA Ruhanga waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
          "name": "verse",
