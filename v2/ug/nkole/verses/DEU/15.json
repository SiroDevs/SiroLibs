            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.14"
              },
              "items": [
                {
                  "text": "Yer 34:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha muheru gwa buri myaka mushanju oryaha abantu obusingye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.1",
            "verseOrgIds": [
              "DEU.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu nigwo muringo ogu murihamu obusingye; buri muntu weena oriba aine ou arikwihuza, aryareka ekyo eki yaagurize mutaahi we; atarikiihuza mutaahi we nari mwene ishe; ahabw'okuba okuha obusingye, okuragiirwe MUKAMA, kuherize kurangwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.20"
              },
              "items": [
                {
                  "text": "Bir 23:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Noikirizibwa kwihuza omunyaihanga; kwonka ekintu kyawe kyona ekiinwe mwene waanyu, oryakimurekyera. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.8"
              },
              "items": [
                {
                  "text": "Bir 28:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku orihurira eiraka rya MUKAMA Ruhanga waawe, waataho omutima kworobera ebiragiro ebyo byona ebi ndikukuragiira eri izooba, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiharibaho booro omuriimwe; ahakuba MUKAMA taribura kukuha omugisha omu nsi ei MUKAMA arikukuha kukubuura kuba obuhunguzi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba MUKAMA Ruhanga waawe aryakuha omugisha, nk'oku yaakuraganiise; oryaguza amahanga maingi, kwonka iwe torigeeguzaho; oryategyeka amahanga maingi, kwonka go tigarikutegyeka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
      ]
    },
