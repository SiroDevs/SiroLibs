          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi atarijwara kishaija; kandi n'omushaija atarijwara kikazi; ahakuba weena orikukora ebyo, n'ekihagaro ahari MUKAMA Ruhanga waawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.5",
            "verseOrgIds": [
              "DEU.22.5"
            ]
          }
        }
      ]
    },
