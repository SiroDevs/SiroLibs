            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otaribiba omu musiri gwawe gw'emizaabibu embibo z'emiringo ebiri, okaakwa ebyeziremu byona, eby'ezo mbibo n'eby'emizaabiru. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
