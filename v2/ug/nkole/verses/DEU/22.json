              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku hariba hariho omwishiki, orikugambwa obugyenyi, omushaija yaamushanga omu rurembo, yaabyama nawe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "bombi muryabashohoza aha irembo ry'orwo rurembo, mubaitse amabaare; omwishiki mumwite ahabw'okutateera nduuru, haza ari omu rurembo; n'omushaija mumwite ahabw'okushiisha omukazi wa mutaahi we; ku muritwaza mutyo, muryaiha ekyo kibi omuri Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omushaija ku arishanga omwishiki orikugambwa obugyenyi omu ishwa, yaamuhamba, yaabyama nawe, obwo ogwo mushaija obyamire nawe niwe ariitwa wenka; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka omwishiki mutarigira eki mwamukora; aryaba ataine rubanja orushemereire kumwitsa; nimumanya ngu orubanja orwo ni nk'orw'omuntu ogurukaine mutaahi we, akamwita; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba omushaija aryaba amushangire omu ishwa; ogwo mwishiki orikugambwa obugyenyi, n'obu yaakuteire enduuru, tihaine waakumujunire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 22:28"
