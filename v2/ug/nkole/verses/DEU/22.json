          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "bamuhongyese shekeli z'efeeza igana, bazihe ishe w'omwishiki, nibamutura okushiisha eiziina ry'omwishiki Omwisraeli, agarukye abe omukazi we; atarimushenda ebiro byona ebi arimara omu nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.19",
            "verseOrgIds": [
