            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omushaija ku arishanga omwishiki otakagambirwe bugyenyi, yaamuhamba, yaabyama nawe, kandi baakwatwa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
