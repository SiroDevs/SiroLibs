              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku oryombeka enju nsya, ote aha mutwe gwayo eky'okuzibira abantu kugwa, kigyehinguririze, orekye kureetera enju yaawe orubanja rw'eshagama ahabw'omuntu kugihanukaho, akagwa ahansi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.8",
            "verseOrgIds": [
              "DEU.22.8"
            ]
          }
        }
