              "type": "text"
            }
          ]
        },
        {
          "text": " Ku origwa aha kyashuri ky'enyonyi omu muti nari ahansi, kirimu ebyana nari amahuri, nyinabyo ebibumbatiire, otarigitwara nabyo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.6",
            "verseOrgIds": [
              "DEU.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "oryareka nyinabyo egyende, reero ebyana obitware, obone kuba gye, ohangaare.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.7",
            "verseOrgIds": [
              "DEU.22.7"
            ]
          }
        }
