              "type": "text"
            }
          ]
        },
        {
          "text": " Abakuru b'orwo rurembo bakwate ogwo mushaija, bamuteere; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.18",
            "verseOrgIds": [
