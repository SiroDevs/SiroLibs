          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatarigira owaakwatirizibwa orubengo nari eseiso, ahakuba naaba akwatiriziibwe amagara ga mukama waabyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
