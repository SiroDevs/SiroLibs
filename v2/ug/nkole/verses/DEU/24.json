              "type": "text"
            }
          ]
        },
        {
          "text": "Ku origuza mutaahi waawe, nari waamutiiza ekintu kyona, otariza omu nju ye kwihamu eky'okukukwatiriza; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
            "verseOrgIds": [
              "DEU.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
