          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kureka oryayemerera aheeru; ou ogurize abe niwe yaakureetera eky'okukukwatiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.11",
            "verseOrgIds": [
              "DEU.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
