            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku oriba waakwatsirwe ebibembe, oyerinde, oteho omutima okore ebi abanyamurwa Abaleevi barikuhabura byona; nk'oku naabaragiire, naimwe mube nikwo mwakora. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
