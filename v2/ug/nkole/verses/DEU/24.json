              },
              "items": [
                {
                  "text": "Kub 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwijukye oku MUKAMA Ruhanga waanyu yaagizire Miriamu, muri omu rugyendo nimuruga Misri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
