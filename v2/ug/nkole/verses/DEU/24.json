              "items": [
                {
                  "text": "Enf 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omushaija ku arishwera omukazi, atarihurura n'abandi aha rugamba, n'obu kwakuba okukoresibwa omurimo gwona; kureka aryamara omwaka gwona ari omuka, naashemererwa n'omukazi we, ou ashweire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
