              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA Ruhanga waawe ku arihwerekyereza amahanga omu maisho gaawe omu nsi ei orikuza kukubuura, waagikubuura, waagituuramu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "verse",
