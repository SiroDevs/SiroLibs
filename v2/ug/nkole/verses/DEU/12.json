          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyerinde otaritegwa kugakuratira, gaherize kuhwerekyerezibwa omu maisho gaawe, okabuuririza ebya baaruhanga baabo noogira oti: Amahanga aga gakaba gaheereza gata baaruhanga baago? naanye nkabona kutwaza ntyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.30",
            "verseOrgIds": [
              "DEU.12.30"
            ]
          }
        },
