          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hariho n'eby'okureeberaho ebindi bingi, ebi Yesu yaakoreire omu maisho g'abeegi be, ebitahandiikirwe omu kitabo eki; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
            "verseOrgIds": [
              "JHN.20.30"
            ]
          }
        },
