                  "text": "1 Yoh 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka ebi bihandiikirwe ngu mwikirize ku Yesu ari Kristo Omwana wa Ruhanga, kandi ngu, ku muraikirize, mugire amagara omu iziina rye.",
          "type": "text",
