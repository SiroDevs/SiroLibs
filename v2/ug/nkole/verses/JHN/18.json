              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.54+LUK.22.55+LUK.22.56+LUK.22.57+LUK.22.58+LUK.22.59+LUK.22.60+LUK.22.61+LUK.22.62+LUK.22.63+LUK.22.64+LUK.22.65+LUK.22.66+LUK.22.67+LUK.22.68+LUK.22.69+LUK.22.70+LUK.22.71"
              },
              "items": [
                {
                  "text": "Luk 22:54-71",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga aho omutwe gw'abaserukare n'omukuru waabo n'abambari b'Abayudaaya baakwata Yesu, baamuboha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.12",
            "verseOrgIds": [
              "JHN.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baabanza kumutwara ahari Aana; ahakuba akaba ari ishe-zaara wa Kayaafa, owaabaire ari omunyamurwa omukuru omu mwaka ogwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.13",
            "verseOrgIds": [
              "JHN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.49"
              },
              "items": [
                {
                  "text": "Yoh 11:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.50"
              },
              "items": [
                {
                  "text": "50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Kayaafa ogwo niwe yaahaire Abayudaaya obwengye ati, Ni kirungi omuntu omwe kufeera abantu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.14",
            "verseOrgIds": [
              "JHN.18.14"
            ]
          }
        }
      ]
    },
    {
