            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.18",
            "verseOrgIds": [
              "JHN.13.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.41.9"
              },
              "items": [
                {
                  "text": "Zab 41:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tindikubagambaho mwena; nimmanya abu naatooraine; kwonka Ekyahandiikirwe kihikiirire ngu, Owaarya aha by'okurya byangye, niwe ambangiire omugyere. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.18",
            "verseOrgIds": [
              "JHN.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbagambira eki hati, kitakabaireho, ngu ku kiriba kyabaireho, mwikirize ngu ndi Ogwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.19",
            "verseOrgIds": [
              "JHN.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buzimazima nimbagambira nti: Oyakiira omuntu weena ou ntuma, biri niinye ayakiire; kandi onyakiira, biri ayakiire Ogwo owantumire.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.20",
            "verseOrgIds": [
              "JHN.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
