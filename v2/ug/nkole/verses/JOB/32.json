                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Elihu mwene Barakeeli, Omubuuzi ow'omu muryango gwa Raamu, yaagira ekiniga. Yaagirira Yobu ekiniga ahabw'okweyeta ohikiriire okukira Ruhanga; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.2",
            "verseOrgIds": [
              "JOB.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.22.5"
              },
              "items": [
                {
                  "text": "Yob 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi yaakigirira na bagyenzi ba Yobu abo bonshatu, ahabw'okubura eky'okumugarukamu, n'ou baraabe bahamize ku ari omusiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.3",
            "verseOrgIds": [
              "JOB.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Elihu akaba ategyereize kugamba na Yobu, ahabw'okuba abo bakaba nibamukira obukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.4",
            "verseOrgIds": [
              "JOB.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihu ku yaareebire abo bonshatu baabura eky'okugarukamu, yaagira ekiniga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.5",
            "verseOrgIds": [
              "JOB.32.5"
            ]
          }
