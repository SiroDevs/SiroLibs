              "type": "text"
            }
          ]
        },
        {
          "text": " Batyo abo bantu bonshatu baarekyera aho kugarukamu Yobu, ahabw'okuba akaba naayemanya ku ahikiriire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.1",
