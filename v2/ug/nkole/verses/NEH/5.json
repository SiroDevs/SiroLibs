              },
              "items": [
                {
                  "text": "Bir 15:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima bamwe aha Bayudaaya n'abakazi baabo baayetomboitera beene waabo Abayudaaya; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.1",
            "verseOrgIds": [
              "NEH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba abamwe bakagira bati: Itwe na batabani baitu na bahara baitu turi baingi; ka tuze kushaka eby'okututunga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abandi baagira bati: Nitukwatiriza emisiri yaitu, n'emizaabibu yaitu, n'amaju gaitu, ahabw'enjara, ngu tubone eby'okurya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.4.13"
              },
              "items": [
                {
                  "text": "Ezr 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'abandi baagira bati: Tugurize empiiha, twakwatiriza emisiri yaitu n'emizaabibu yaitu kuha omushoro gw'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
              "NEH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.7"
              },
              "items": [
                {
                  "text": "Kur 21:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.39"
              },
              "items": [
                {
                  "text": "Lev 25:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.1"
              },
              "items": [
                {
                  "text": "2 Bag 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Haza itwe na beene waitu turi omubiri gumwe, n'abaana baitu nikyo kimwe n'abaabo; mbwenu batabani baitu na bahara baitu nitubagyema kuba abahuuku n'abazaana; nangwa n'abamwe ahari bahara baitu babeereire kimwe abazaana, kandi titwine ky'okukora, ngu tubacungure, ahabw'okuba emisiri yaitu n'emizaabibu yaitu biinwe abandi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku naahuriire okwetomboita kwabo n'ebigambo ebyo, naagira ekiniga kingi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.6",
            "verseOrgIds": [
              "NEH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.25"
              },
              "items": [
                {
                  "text": "Kur 22:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.36"
              },
              "items": [
                {
                  "text": "Lev 25:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.15.5"
              },
              "items": [
                {
                  "text": "Zab 15:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.22.12"
              },
              "items": [
                {
                  "text": "Ezk 22:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naagira enaama n'omutima gwangye, bwanyima naatonganisa abakungu n'abatware, naabagira nti: Nimwiha hari beene waanyu ekiteebwamu, buri muntu ahari mwene waabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.7",
            "verseOrgIds": [
              "NEH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.48"
              },
              "items": [
                {
                  "text": "Lev 25:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.49"
              },
              "items": [
                {
                  "text": "49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naateerana omutwe gw'abantu baingi kukibeemeza, naabagira nti: Itwe tukakora eki turikubaasa, twacungura beene waitu Abayudaaya, abaabaire baguzirwe abanyamahanga; mbwenu imwe nimwenda kutunda beene waanyu; nimugira ngu, kihikire itwe kubagura? Baahunama, baabura eky'okugarukamu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.36"
              },
              "items": [
                {
                  "text": "Lev 25:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.4.4"
              },
              "items": [
                {
                  "text": "Neh 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.24"
              },
              "items": [
                {
                  "text": "Rom 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naagaruka naagira nti: Eki murikukora ti kirungi. Ekirungi t'okugyendera omu kutiina Ruhanga waitu, mukareka kwejumisa omu banyamahanga abazigu baitu? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.9",
            "verseOrgIds": [
              "NEH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nyowe na beene waitu n'abashaija bangye nitubaguza empiiha n'eby'okurya; kwonka ka turekye kubashaba ekiteebwamu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.10",
            "verseOrgIds": [
              "NEH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbwenu eri izooba mubagarurire emisiri yaabo, emizaabibu yaabo, emizeituuni yaabo, n'amaju gaabo, kandi tubagarurire na kimwe kya igana eky'empiiha, engano, viinyo n'eky'amajuta, ebi mubaire nimubahaisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.10.31"
              },
              "items": [
                {
                  "text": "Neh 10:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.8"
              },
              "items": [
                {
                  "text": "Yer 34:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baagarukamu nibagira bati: Twaza kubibagarurira, kandi titurikwija kugira ki twabahaisa. Nitwija kukora nk'oku waagamba. Ntyo naayeta abanyamurwa, naabarahiriza omu maisho g'abo bantu kuguma nibakora nk'oku baarahira. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.6"
              },
              "items": [
                {
                  "text": "Neh 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.48"
              },
              "items": [
                {
                  "text": "Zab 106:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.6"
              },
              "items": [
                {
                  "text": "Byak 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.36"
              },
              "items": [
                {
                  "text": "1 Bus 16:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naakunkumura omunagiro ogu naabaire nnagiire, naagira nti: Omuntu weena, oraabe atahikiriize egi ndagaano, Ruhanga amukunkumure atyo, amwihe omu nju ye n'omu murimo gwe. Abe nikwo yaakunkumurwa atyo, akahwaho. Omutwe gw'abantu abaabaire bateeraine baagira bati: Amiina, baahimbisa MUKAMA. Bwanyima abantu baakora nk'oku baaraganisa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
