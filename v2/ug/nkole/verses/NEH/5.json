                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.8"
              },
              "items": [
                {
                  "text": "2 Tes 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi okuruga omu bunaku obu naatandikiiremu kuba omutegyeki w'abantu omuri Yuda, okwiha aha mwaka gwa makumi abiri okuhitsya aha gwa makumi ashatu n'ebiri ogw'omu busingye bw'omugabe Aruta-gizakiseesi, omuri egyo myaka ikumi n'ebiri, nyowe na gbeene tata titurariire ha by'okurya by'emitoijo y'obutegyeki. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.14",
            "verseOrgIds": [
              "NEH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka abategyeki abambandiize bakaita kubi abantu, nibabatoijesa eby'okurya na viinyo, otabariireho shekeli z'efeeza makumi ana. Nangwa n'abagaragwa baabo bakaba batwaza abantu eikama. Kwonka nyowe tindatwarize ntyo ahabw'okutiina Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kureka nkaba nyezirika kukora hari orwo rugo, kandi tihariho itaka ryona eri naatwaire; n'abashaija bangye boona bakaba bateeranirayo, bareetsirwe ogwo murimo. ",
