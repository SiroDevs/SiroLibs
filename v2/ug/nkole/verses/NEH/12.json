            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima naatembya abakuru ba Yuda aha mutwe gw'orwo rugo, naabaganisa abantu omu mitwe ebiri mihango okugyenda aha mutwe gw'orugo bakurataine nibahimbisa. Omutwe gumwe gwatoora aha rubaju rwa buryo, gugyemire ow'Eirembo ry'orubungo; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "baakuratwa Hoshaaya n'ekicweka ky'abakuru ba Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Azaria, Ezera, Meshulaamu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33",
            "verseOrgIds": [
              "NEH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda, Benyamiini, Shemaaya, Yeremia, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.34",
            "verseOrgIds": [
              "NEH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na batabani b'abanyamurwa abamwe baine amakondere, Zekaria, mwene Yonasaani, mwijukuru wa Shemaaya, Shemaaya ya Matania, Matania ya Mikaaya, Mikaaya ya Zikuri, mwene Asafu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.5"
              },
              "items": [
                {
                  "text": "1 Bus 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " na beene waabo Shemaaya, Azareeli, Yuda na Hanani, baine ebirikugamba bya Daudi omushaija wa Ruhanga, beebembeirwe Ezera omuhandiiki. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.15"
              },
              "items": [
                {
                  "text": "Neh 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baahikire aha Irembo ry'enshuro, bainamuka bagyemire omu maihso gaabo, baatembera aha matembero agarikuza omu rurembo rwa Daudi, ahu orugo rwabiare nirwinamukira aharuguru y'enju ya Daudi, baahika aha Irembo ry'amaizi ery'oburugwa-izooba.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        }
      ]
