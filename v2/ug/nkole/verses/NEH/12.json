                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Abaleevi n'aba: Yeshua, Binui, Kadimieli, Sherebia, Yuda, na Matania, owaabaire naakwatanisa na beene ishe kwebembera ebyeshongoro by'okuhimbisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.8",
            "verseOrgIds": [
              "NEH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Bakibukia na Uuno beene waabo bakaba beemerera nibareebana omu kushaba. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.9",
            "verseOrgIds": [
              "NEH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeshua akazaara Yoyakimu, Yoyakimu yaazaara Eliashibu, Eliashibu yaazaara Yoyada, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoyada yaazaara Yonasaani, na Yona saani yaazaara Yadua.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamurwa b'omu biro bya Yoyakimu abaabaire bari bakuru b'amaju ga baishenkurubo, n'aba: ow'enju ya Seraaya akaba ari Meraaya, ow'eya Yeremia, ari Hanania, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12",
            "verseOrgIds": [
              "NEH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'eya Ezera, ari Meshulaamu, ow'eya Amaria ari Yehohanani, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.13",
            "verseOrgIds": [
              "NEH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'eya Maluki ari Yonasaani, ow'eya Shebania ari Yosefu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.14",
            "verseOrgIds": [
              "NEH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'eya Harimu ari Aduna, ow'eya Merayosi ari Helekai, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.15",
            "verseOrgIds": [
              "NEH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'eya Ido ari Zekaria, ow'eya Ginesooni ari Meshulaamu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.16",
            "verseOrgIds": [
              "NEH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'eya Biya ari Zikiri, ow'eya Minyamiini owa Moadia, ari Pilutai, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.17",
            "verseOrgIds": [
              "NEH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'eya Biliga ari Shamua, ow'eya Shemaaya ari Yehonasani, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.18",
            "verseOrgIds": [
              "NEH.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'eya Yoyaribu ari Matenai, ow'eya Yedaaya ari Uuzi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.19",
            "verseOrgIds": [
              "NEH.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'eya Salai ari Kalai, ow'eya Amoki ari Eberi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.20",
            "verseOrgIds": [
              "NEH.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'eya Hilukia ari Hashabia, n'ow'eya Yedaaya ari Netaneeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro bya Eliashibu, Yoyada, Yohanaani na Yadua, Abaleevi n'abanyamurwa bakaba bahandiikwa omu kitabo ky'amaziina g'abakuru ba'maju ga baishenkurubo, okuhitsya omu busingye bwa Dario Omuperisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.14+1CH.9.15+1CH.9.16"
              },
              "items": [
                {
                  "text": "1 Bus 9:14-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.25.1"
              },
              "items": [
                {
                  "text": "1 Bus 25:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na beene Leevi, abakuru b'amaju ga baishenkurubo bakaba bahandiikwa omu kitabo ky'eb'omu busingye okuhitsya omu biro bya Yohanaani mwene Eliashibu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.25.1"
              },
              "items": [
                {
                  "text": "1 Bus 25:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.3.11"
              },
              "items": [
                {
                  "text": "Ezr 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi abakuru b'Abaleevi bakaba abari Hashabia, Sherebia, na Yeshua mwene Kadimieli, abaabaire bakwatanisa na beene waabo abaabaire beemerera nibareebana, kuhimbisa n'okusiima, nk'ekiragiro kya Daudi omushaija wa Ruhanga oku kyabaire kiri, nibakikora omu mbu zaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Matania, Bakibukia, Obadia, Mehsulaamu, Talumooni na Akubu bakaba bari abakumiirizi, abaabaire barinda amaju g'amabiikiro g'aha marembo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
