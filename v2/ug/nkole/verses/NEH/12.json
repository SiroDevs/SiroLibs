              "items": [
                {
                  "text": "Neh 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo nibo baabaire bariho omu biryo bya Yoyakimu mwene Yeshua, mwijukuru wa Yozadaaki, n'omu biro bya Nehemia omutegyeki na Ezera omunyamurwa, kandi omuhandiiki.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
