            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi abanyamurwa n'Abaleevi baayeyeza, baayeza na'bantu n'amarembo n'orwo rugo rw'amabaare.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
