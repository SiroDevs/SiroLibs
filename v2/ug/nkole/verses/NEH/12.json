                {
                  "text": "1 Bus 15:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baabaire nibenda kweza orugo rw'amabaare rwa Yerusaalemu, bakasherura Abaleevi ahu baabaire batwire hoona, kubareeta Yerusaalemu aha bugyenyi bw'okurweza baine okushemererwa, nibahimbisa n'ebyenshongoro, baine ebitaasa n'endingiri n'enanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.27",
            "verseOrgIds": [
              "NEH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abaana b'abeeshongozi baateeranira hamwe nibaruga omu mpita ezeehinguririize Yerusaalemu n'omu birorero by'Abanetofa, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.28",
            "verseOrgIds": [
              "NEH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Besi-gilugaali n'omu byaro bya Geeba na Azimavesi; ahabw'okuba abeeshongozi bakaba beeyombekyeire ebirorero embaju zoona eza Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.29",
            "verseOrgIds": [
              "NEH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
