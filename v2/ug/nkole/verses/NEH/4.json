        },
        {
          "text": " Ei muraahurire eiraka ry'enzamba yoona, mube niyo mwairukira, mutushangye. Ruhanga waitu naija kuturwanirira. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.20",
            "verseOrgIds": [
