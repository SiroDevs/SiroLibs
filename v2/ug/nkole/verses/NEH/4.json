        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 4:7"
          },
          "items": [
