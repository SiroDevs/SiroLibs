              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.14",
            "verseOrgIds": [
              "NEH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.15",
            "verseOrgIds": [
              "NEH.4.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.12"
              },
              "items": [
                {
                  "text": "Yob 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abazigu baitu ku baahuriire ngu tukimanyire, kandi ngu Ruhanga acwire busha enaama yaabo, twena twagaruka aha rugo, buri muntu aha murimo gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.15",
            "verseOrgIds": [
              "NEH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga ahari eryo izooba, ekicweka kime kya kabiri ky'abashaija bangye kyaguma aha murimo gw'okwombeka, kimwe kya kabiri ekindi kyakwata amacumu, engabo, amata n'ebijwaro by'ebyoma eby'okurwanisa; kandi abeebembezi baayemerera enyima y'ab'enju ya Yuda boona. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.16",
            "verseOrgIds": [
              "NEH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaabaire nibombeka orugo, n'abaabaire nibeekorera ebintu, buri muntu akaba akoresa omukono gumwe, ogundi guguma gukwaitse eby'okurwanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.17",
            "verseOrgIds": [
              "NEH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buri mwombeki weena akaba ayombeka, ahagatiire rurara ye; kandi ow'okuteera eikondere anguma aha rubaju. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.18",
            "verseOrgIds": [
              "NEH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi naagmbira abakungu n'abatware n'abandi boona nti: Omurimo ni muhango, guhikire hare, kandi itwe twenaganagire aha rugo, buri muntu ari hare na mugyenzi we. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.19",
