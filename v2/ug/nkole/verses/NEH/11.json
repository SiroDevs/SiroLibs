              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.8"
              },
              "items": [
                {
                  "text": "Yos 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Zanoa, Adulaamu n'omu birorero byayo, Lakishi n'emisiri yaayo, na Azaka n'omu birorero byayo. Nikwo bateire batyo ensiisira okuruga Beeri-sheba okuhika omu ruhanga rwa Hinoomu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababenyamiini bakatuura okuruga Geeba n'okweyongyera omumaihso, Mikimaashi, Aiya, Beseeli n'omu birorero byayo, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
