          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazarishuali, Beeri-sheba n'omu birorero byayo, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.27",
            "verseOrgIds": [
              "NEH.11.27"
            ]
          }
        },
        {
          "name": "verse",
