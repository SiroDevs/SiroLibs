            "sid": "NEH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omureeberezi w'Abaleevi omuri Yerusaalemu akaba ari Uuzi mwene Baani, mwijukuru wa Hashabia, Hashabia ya Matania, Matania ya Miika ow'omuri beene Asafu, abeeshongozi, abaabaire bareeberera omurimo gw'enju ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.22",
            "verseOrgIds": [
              "NEH.11.22"
            ]
          }
        },
