            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro ebyo abeebembezi b'eihanga bakaguma batwire omuri Yerusaalemu, kwonka abandi bantu baateera enteenyu okwiha omuntu omwe ahari buri ikumi kutuura omuri Yerusaalemu orurembo orurikwera, kandi abandi boona abaatsigaireho baaza omu zindi ndembo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
