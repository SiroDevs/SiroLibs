          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loodi, na Ono, oruhanga rw'abanyamyoga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.35",
            "verseOrgIds": [
              "NEH.11.35"
            ]
          }
        },
