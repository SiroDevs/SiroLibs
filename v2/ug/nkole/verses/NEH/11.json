          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ebicweka bimwe by'Abaleevi omuri Yuda bakateeranwa na Benyamiini.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.36",
            "verseOrgIds": [
