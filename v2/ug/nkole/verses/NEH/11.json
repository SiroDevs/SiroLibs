                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka abaheereza b'omuri hekalu bakaba batwire Ofeli, nibareebererwa Ziiha na Gishupa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
