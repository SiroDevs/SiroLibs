            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba omugabe akaba aragiire ebyabo, kandi agyereire abeeshongozi egabo ya buri izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
