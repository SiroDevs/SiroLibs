          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeshua, Molada, Besi-peleti, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.26",
            "verseOrgIds": [
              "NEH.11.26"
            ]
          }
        },
