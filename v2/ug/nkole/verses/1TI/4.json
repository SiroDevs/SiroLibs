                "loc": "2TI.3.1"
              },
              "items": [
                {
                  "text": "2 Tim 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.18"
              },
              "items": [
                {
                  "text": "Yud 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Omwoyo naagamba butunu ati: Omu biro ebya bwanyima bamwe baryareka okwikiriza ahabw'okuhurira emyoyo erikuhabya n'okwegyesa kwa baadaimoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.1",
            "verseOrgIds": [
              "1TI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bahabisibwe oburyarya bw'abantu abarikubeiha ebishuba, abaine emitima etakihuriira, nk'esiriiziibwe ekyoma ekirukwotsya, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.2",
            "verseOrgIds": [
              "1TI.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.31"
              },
              "items": [
                {
                  "text": "1 Kor 10:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " abaziza okushwera, kandi eby'okurya ebi Ruhanga yaahangiire abarikwikiriza bakamanya amazima ngu babyakiire n'okusiima. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.3",
            "verseOrgIds": [
              "1TI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.15"
              },
              "items": [
                {
                  "text": "Byak 10:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba eki Ruhanga yaahangire kyona ni kirungi; kandi tihariho kirikuzira, ku kiba kyakiirwe n'okusiima; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.4",
            "verseOrgIds": [
              "1TI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba nikiba kyeziibwe ekigambo kya Ruhanga n'okushaba.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.5",
            "verseOrgIds": [
              "1TI.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.5",
            "verseOrgIds": [
              "1TI.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku orishobororera ab'eishe-emwe ebigambo ebyo, oryaguma ori omuheereza murungi wa Kristo Yesu, orikutungwa ebigambo by'okwikiriza n'eby'enyegyesa nungi ei waakuratiire. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.6",
            "verseOrgIds": [
              "1TI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.14"
              },
              "items": [
                {
                  "text": "Tit 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.3.9"
              },
              "items": [
                {
                  "text": "3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebiteekyerezo by'ebigunjano eby'abakaikuru, ebitari bya Ruhanga, otaribiikiriza. Yemanyiize okutiina Ruhanga; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.7",
            "verseOrgIds": [
              "1TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.6"
              },
              "items": [
                {
                  "text": "1 Tim 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba okwemanyiiza eby'omubiri nikugasha kakye, kwonka okwemanyiiza okutiina Ruhanga nikugasha omu muringo gwona, ahakuba kwine eki kuturaganisa aha magara g'ebiro ebi n'ag'ebiro ebiriija. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.8",
            "verseOrgIds": [
              "1TI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo ekyo n'eky'okwesigwa, kandi kishemereire kwikiririzibwa kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.9",
            "verseOrgIds": [
              "1TI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.3"
              },
              "items": [
                {
                  "text": "1 Tim 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo tufeera kubi, kandi nikyo twezirikira, ahakuba twesiga Ruhanga ohuriire, Omujuni w'abantu boona, na buzima ow'abarikwikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.10",
            "verseOrgIds": [
              "1TI.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.10",
            "verseOrgIds": [
              "1TI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo obiragiire kandi obyegyese. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.11",
            "verseOrgIds": [
              "1TI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatagira owaagaya obutsigazi bwawe, kureka obe eky'okureeberaho aha barikwikiriza omu kugamba n'omu mitwarize, omu kukunda, omu kwikiriza n'omu kugira omutima ogushemeire. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.12",
            "verseOrgIds": [
              "1TI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyezirikye kushomera abantu Ebyahandiikirwe, n'okubuurira, n'okwegyesa, okuhitsya obu ndiija. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.13",
            "verseOrgIds": [
              "1TI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.22"
              },
              "items": [
                {
                  "text": "1 Tim 5:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otarireka kukoresa ekiconco eki oine, eki waahairwe ahabw'ebi waagambirweho baanabi, obu abakuru baakutaho engaro. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.14",
            "verseOrgIds": [
              "1TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo obyezirikire, obe nibyo waataho omutima, boona bareebe oku orikweyongyera kugyenda omumaisho. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.15",
            "verseOrgIds": [
              "1TI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyerinde iwe wenka, kandi n'omu bi orikwegyesa. Ogumizemu n'ebyo; ahakuba omu kukora otyo, noija kwejuna, kandi ojune n'abarikukuhurira.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.16",
            "verseOrgIds": [
              "1TI.4.16"
            ]
          }
        }
      ]
    }
  ],
