              "items": [
                {
                  "text": "Yoh 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.2"
              },
              "items": [
                {
                  "text": "12:2",
                  "type": "text"
