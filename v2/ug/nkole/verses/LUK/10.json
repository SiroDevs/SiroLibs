                "loc": "EXO.32.32"
              },
              "items": [
                {
                  "text": "Kur 32:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.5"
              },
              "items": [
                {
                  "text": "Kush 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka eki mutakishemerererwa baadaimoni okuboorobera; kureka mushemererwe ahabw'amaziina gaanyu kuhandiikwa omu iguru. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.20",
            "verseOrgIds": [
              "LUK.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.25+MAT.11.26+MAT.11.27"
              },
              "items": [
                {
                  "text": "Mat 11:25-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu shaaha egyo yaashemerererwa omu Mwoyo Orikwera, naagira ati: Ninkusiima, Taata, Mukama w'eiguru n'ensi, ahabw'okuba ebyo okabishereka abanyabwengye n'abarikwetegyereza, waabishuuruurira abaana bato. Eego, Taata, ahakuba ekyo nikyo waasiimire. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.21",
            "verseOrgIds": [
              "LUK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu byona nkabiheebwa Tata; kandi tihariho orikumanya Omwana oku ari kureka Ishe, n'obu yaakuba orikumanya Ishe oku ari kureka Omwana, n'omuntu weena ou Omwana aikiriza kumumushuuruurira. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.22",
            "verseOrgIds": [
              "LUK.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.16"
              },
              "items": [
                {
                  "text": "Mat 13:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaahindukira abeegi be, yaabagambira omu mubonano ati: Amaisho agarikureeba ebi murikureeba gaine omugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.23",
            "verseOrgIds": [
              "LUK.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbagambira nti: Baanabi n'abagabe baingi bakeetenga kureeba ebi murikureeba, tibaabireeba, kandi n'okuhurira ebi murikuhurira, tibaabihurira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.24",
            "verseOrgIds": [
              "LUK.10.24"
            ]
          }
        }
      ]
