            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Yesu yaagaruka Galilaaya aine amaani g'Omwoyo, okurangaanwa kwe kwabuga omu byanga byona ebiri haihi nayo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
            ]
          }
        },
        {
