            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na baadaimoni baaruga omuri baingi, nibaamuza nibagira bati: Ori Omwana wa Ruhanga! Kwonka yaabagambira kubi, tiyaabaikiriza kugamba, ahabw'okuba bakamumanya ku ari Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
