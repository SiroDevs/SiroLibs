              "items": [
                {
                  "text": "Heb 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Omwohi Sitaane, ku yaaherize byona ebi yaabaire naamwohesa, yaamurugaho, okuhitsya obu aribona ogundi mwanya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.13",
            "verseOrgIds": [
              "LUK.4.13"
            ]
