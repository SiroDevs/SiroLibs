                "loc": "MRK.1.29+MRK.1.30+MRK.1.31+MRK.1.32+MRK.1.33+MRK.1.34+MRK.1.35+MRK.1.36+MRK.1.37+MRK.1.38+MRK.1.39"
              },
              "items": [
                {
                  "text": "Mak 1:29-39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaimuka yaaruga omuri sinagogi, yaataaha omwa Simooni. Kandi nyinazaara Simooni akaba arwaire omushwija mwingi; baamweshengyereza kumukiza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.38",
            "verseOrgIds": [
              "LUK.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamwemerera aha rubaju, yaakabukira omushwija, gwamurugaho; ahonaaho yaimuka, yaabaheereza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizooba ku ryabaire nirirengarenga, boona abaabaire barwarize abarwaire endwara zitari zimwe, baabamureetera; yaabataho engaro boona, yaabakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.40",
            "verseOrgIds": [
              "LUK.4.40"
            ]
          }
        },
