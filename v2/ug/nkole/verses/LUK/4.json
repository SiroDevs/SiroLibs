          "items": [
            {
              "text": "4:16",
              "type": "text"
            },
            {
              "text": "Sinagogi n'ekanisa y'ekiyudaaya.",
              "type": "text"
            }
          ]
        },
        {
          "text": "sinagogi, nk'omucwe gwe oku gwabaire guri. Yaimuka kushoma. ",
          "type": "text",
          "attrs": {
