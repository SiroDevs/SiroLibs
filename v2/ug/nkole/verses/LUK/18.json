                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Yesu yaayekiikana bari ikumi na babiri, yaabagira ati: Reeba, nitwinamuka Yerusaalemu, byona ebyahandiikirwe baanabi aha Mwana w'omuntu nibiija kuhikiirizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
