              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.9+MAT.9.10+MAT.9.11+MAT.9.12+MAT.9.13"
              },
              "items": [
                {
                  "text": "Mat 9:9-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.2.13+MRK.2.14+MRK.2.15+MRK.2.16+MRK.2.17"
              },
              "items": [
                {
                  "text": "Mak 2:13-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'ebyo, ku yaashohoire, yaareeba omuhooza orikwetwa Leevi, ashutami omu ihoorezo; yaamugira ati: Nkuratira! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaatsigaho byona, yaimuka, yaamukuratira. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.28",
            "verseOrgIds": [
              "LUK.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leevi ogwo yaamuteekyera obugyenyi bwingi omu nju ye; kandi hakaba hariho omutwe mwingi gw'abahooza n'abandi bashutami nabo aha by'okurya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.29",
            "verseOrgIds": [
              "LUK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisaayo n'abahandiiki baabo baayetomboitera abeegi be nibagira bati: Ahabw'enki nimurya kandi nimunywa n'abahooza n'abasiisi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.30",
            "verseOrgIds": [
              "LUK.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaabagarukamu ati: Abahuriire tibeetenga mufumu, kureka abarwaire. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.31",
            "verseOrgIds": [
              "LUK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tindaizire kweta bahikiriire kureka abasiisi ngu beeteise. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.32",
            "verseOrgIds": [
              "LUK.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.14+MAT.9.15+MAT.9.16+MAT.9.17"
              },
              "items": [
                {
                  "text": "Mat 9:14-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.2.18+MRK.2.19+MRK.2.20+MRK.2.21+MRK.2.22"
              },
              "items": [
                {
                  "text": "Mak 2:18-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baamugambira bati: Abeegi ba Yohaana kaingi beesiibyakwo, kandi bashaba; n'Abafarisaayo nabo nikwo bakora; kwonka abaawe barya kandi banywa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.33",
            "verseOrgIds": [
              "LUK.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaababuuza ati: Nimubaasa muta kusiibyakwo abakwe, bakiine kishwera? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.34",
            "verseOrgIds": [
              "LUK.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunaku buryahika, kishwera abaihweho; omu biro ebyo baryayesiibyakwo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.35",
            "verseOrgIds": [
              "LUK.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaabacwera enfumu, ati: Tihariho muntu otaagura ekiremu aha kijwaro kisya, akakiteera aha kujwaro kikuru; ku yaakukora atyo, akaataagura ekyo kijwaro kisya, kandi ekiremu eki yaataagura aha kisya tikikaashushana n'ekijwaro ekikuru. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.36",
            "verseOrgIds": [
              "LUK.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi tihariho muntu oshuka viinyo nsya omu furebe z'empu nkuru; ku yaakukora atyo, viinyo ekaabarura efurebe, viinyo egyo eyatika, n'efurebe zisiisikara. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.37",
            "verseOrgIds": [
              "LUK.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kureka viinyo nsya eshemereire kushukwa omu furebe nsya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.38",
            "verseOrgIds": [
              "LUK.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi tihariho muntu owaanyweire ahari viinyo nkuru, akakunda ensya; ahakuba naagira ati: Enkuru niyo nungi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.39",
            "verseOrgIds": [
              "LUK.5.39"
            ]
          }
        }
      ]
    }
