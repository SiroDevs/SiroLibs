            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.11",
            "verseOrgIds": [
              "LUK.19.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.14+MAT.25.15+MAT.25.16+MAT.25.17+MAT.25.18+MAT.25.19+MAT.25.20+MAT.25.21+MAT.25.22+MAT.25.23+MAT.25.24+MAT.25.25+MAT.25.26+MAT.25.27+MAT.25.28+MAT.25.29+MAT.25.30"
              },
              "items": [
                {
                  "text": "Mat 25:14-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baahuriire ebyo, yaagaruka yaacwa enfumu, ahabw'okuba akaba ari haihi na Yerusaalemu, kandi bakateekateeka ngu obukama bwa Ruhanga bwaza kureebwa omu bunaku obwo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.11",
            "verseOrgIds": [
              "LUK.19.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.21"
              },
              "items": [
                {
                  "text": "Luk 24:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.6"
              },
              "items": [
                {
                  "text": "Byak 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.11",
            "verseOrgIds": [
              "LUK.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo yaagiriire ati: Omunyiginya omwe akagyenda omu nsi ya hare kuheebwa obugabe ngu bwanyima agarukye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.12",
            "verseOrgIds": [
              "LUK.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaayeta ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.13",
            "verseOrgIds": [
              "LUK.19.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:13",
              "type": "text"
            },
            {
              "text": "Omu Rugriika n'omuhuuku.",
              "type": "text"
            }
          ]
        },
        {
          "text": "abambari be ikumi, ati: Muzishuuuze, okuhitsya obu ndigaruka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.13",
            "verseOrgIds": [
              "LUK.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.11"
              },
              "items": [
                {
                  "text": "Yoh 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka abantu be bakaba nibamwanga; baamukuratsa entumwa, nibagira bati: Titurikwenda muntu ogwo ku atutegyeka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.14",
            "verseOrgIds": [
              "LUK.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaagarukire, aheirwe obugabe, yaaragiira kumwetera abambari abo abu yaahaire empiiha, ngu amanye enshaagi ezi baihire omu kushuubura kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.15",
            "verseOrgIds": [
              "LUK.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ow'okubanza yaija omu maisho ge, yaagira ati: Mukama wangye, miina yaawe eshaagizemu ezindi miina ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.16",
            "verseOrgIds": [
              "LUK.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.10"
              },
              "items": [
                {
                  "text": "Luk 16:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaamugira ati: Okozire gye, mwambari wangye omurungi! Ahakuba oyesigirwe ahari bikye munonga, obe omutegyeki w'endembo ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.17",
            "verseOrgIds": [
              "LUK.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'owa kabiri yaija, yaagira ati: Mukama wangye, miina yaawe eshaagizemu ezindi miina itaano. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.18",
            "verseOrgIds": [
              "LUK.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamugira ati: Naiwe otegyekye endembo itaano. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.19",
            "verseOrgIds": [
              "LUK.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ondiijo yaija, yaagira ati: Mukama wangye, miina yaawe ngigi! Nkagibiika omu kiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.20",
            "verseOrgIds": [
              "LUK.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba nkakutiina, ahabw'okuba oba omuntu ogumire; oyaanura ebi otaanikire; ogyesha ebi otabibire. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.21",
            "verseOrgIds": [
              "LUK.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamugira ati: Iwe mwambari 'we omubi, ninkucwera orubanja, niinyiha aha bi waagamba. Okamanya ku ndi omuntu ogumire, ku nyanura ebi ntaanikire, nkagyesha ebi ntabibire. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.22",
            "verseOrgIds": [
              "LUK.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu n'enki ekyakuzibiire kuha empiiha zangye abazibiika kuzishuubuza, naanye ku naakugarukire, nkaaziihireyo n'enshaagi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.23",
            "verseOrgIds": [
              "LUK.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagambira abaabaire beemereire aho ati: Mumwakye miina egyo, mugihe oine miina ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.24",
            "verseOrgIds": [
              "LUK.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamugira bati: Mukama waitu, ka aine ezindi kumi! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.25",
            "verseOrgIds": [
              "LUK.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.12"
              },
              "items": [
                {
                  "text": "Mat 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimbagambira nti: Oine niwe aryongyerwa; kwonka otaine aryayakwa n'eki aine. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.26",
            "verseOrgIds": [
              "LUK.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abo bazigu bangye abatarenzire ku mbategyeka, mubareete aha, mubaitire omu maisho gangye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
            "verseOrgIds": [
              "LUK.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
            "verseOrgIds": [
              "LUK.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaaherize kugamba ebyo, yaagumizamu kwinamuka Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.28",
            "verseOrgIds": [
              "LUK.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.1+MAT.21.2+MAT.21.3+MAT.21.4+MAT.21.5+MAT.21.6+MAT.21.7+MAT.21.8+MAT.21.9"
              },
              "items": [
                {
                  "text": "Mat 21:1-9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.1+MRK.11.2+MRK.11.3+MRK.11.4+MRK.11.5+MRK.11.6+MRK.11.7+MRK.11.8+MRK.11.9+MRK.11.10"
              },
              "items": [
                {
                  "text": "Mak 11:1-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.12+JHN.12.13+JHN.12.14+JHN.12.15+JHN.12.16"
              },
              "items": [
                {
                  "text": "Yoh 12:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaahikire haihi na Besifaage na Besania aha kibungo ekirikwetwa Zeituuni, yaatuma babiri aha beegi be, yaagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.29",
            "verseOrgIds": [
              "LUK.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugyende omu kirorero ekibari omumaisho; ku muraabe nimutaahamu, nimwija kushanga omwana gw'endogoya gutisbikire, ogutakatembwahoga muntu; mugutsibure, mugureete aha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.30",
            "verseOrgIds": [
              "LUK.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu weena, ku araababuuze ati: Nimugutsiburira ki? Mugarukyemu muti: Mukama waitu naagwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.31",
            "verseOrgIds": [
              "LUK.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abatumirwe baagyenda, baashanga kiri nk'oku yaabagambira. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.32",
            "verseOrgIds": [
              "LUK.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baabaire nibatsibura omwana gw'endogoya, bakama baagwo baababuuza bati: Nimutsiburira ki omwana gw'endogoya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.33",
            "verseOrgIds": [
              "LUK.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baabagarukamu bati: Mukama waitu naagwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.34",
            "verseOrgIds": [
              "LUK.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagureetera Yesu, baagutaho ebijwaro byabo, baagumushutamyaho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.35",
            "verseOrgIds": [
              "LUK.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaabaire naagyenda, baayara ebijwaro byabo omu nguuto. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.36",
            "verseOrgIds": [
              "LUK.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "KU yairiire haihi, yaahika aha kashuumo k'ekibungo kya Zituuni, omutwe gwona gw'abeegi be gwatandika kushemererwa n'okuhimbisa Ruhang n'eiraka rihango ahabw'eby'okutangaaza ebi baareebire, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.37",
            "verseOrgIds": [
              "LUK.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Zab 118:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nibagira bati: Omugabe orikwija omu iziina rya Mukama asiimwe! Obusingye bube omu iguru, n'ekitiinisa kibe ahaiguru ya byona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.38",
            "verseOrgIds": [
              "LUK.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwe aha Bafarisaayo abaabaire bari omu mutwe ogwo, baamugira bati: Mwegyesa, hana abeegi baawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.39",
            "verseOrgIds": [
              "LUK.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabagarukamu ati: Nimbagambira nti: Aba ku baakuhunama, amabaare gakaagamba munonga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.40",
            "verseOrgIds": [
              "LUK.19.40"
            ]
          }
        }
      ]
    },
