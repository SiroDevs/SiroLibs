          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.29"
              },
              "items": [
                {
                  "text": "Bir 32:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naagira ati: Eri izooba, kuri noomanya ebyakukureetera obusingye! Kwonka shi hati bisherekirwe amaisho gaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.42",
            "verseOrgIds": [
              "LUK.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba ebiro biryakwizira, abazigu baawe bakuzitireho orugo, bakwehinguririze, bakutangatangye embaju zoona; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.43",
            "verseOrgIds": [
              "LUK.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
