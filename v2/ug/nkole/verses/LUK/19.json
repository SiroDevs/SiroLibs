        "sid": "LUK 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaataaha omuri Yeriko, yaagumizamu naahingura. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.1",
            "verseOrgIds": [
              "LUK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hakaba hariho omushaija orikwetwa Zakaayo omuhooza mukuru, kandi omutungi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.2",
            "verseOrgIds": [
              "LUK.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaayenda kureeba oku Yesu arikushusha; kwonka tiyaabaasa ahabw'omutwe gw'abantu, kandi n'ahabw'okuba mugufu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.3",
            "verseOrgIds": [
              "LUK.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo yairuka, yaaza omumaisho, yaatemba omuri gw'omusikamoori, ngu amureebe; ahakuba akaba naija kuraba aho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.4",
            "verseOrgIds": [
              "LUK.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ku yaahikire omu mwanya ogwo, yaareeba ahaigur, yaamugira ati: Zakaayo, rahuka, temburuka; ahabw'okuba erizooba nshemereire kusiiba omu nju yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.5",
            "verseOrgIds": [
              "LUK.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaarahuka kutemburuka, yaamutaasya owe ashemereirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.6",
            "verseOrgIds": [
              "LUK.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.2"
              },
              "items": [
                {
                  "text": "Luk 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu boona ku baakireebire, baayetomboita, nibagira bati: Yaaza kuraarira omuntu omusiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.7",
            "verseOrgIds": [
              "LUK.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.1"
              },
              "items": [
                {
                  "text": "Kur 22:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.5.6"
              },
              "items": [
                {
                  "text": "Kub 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.5.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Zakaayo yaayemerera, yaagambira Mukama ati: Reeba, Mukama wangye, ekicweka ky'ebintu byangye naaza kukigabira abooro; kandi ou naagobeize weena, nimmuriha kana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.8",
            "verseOrgIds": [
              "LUK.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.31"
              },
              "items": [
                {
                  "text": "Byak 16:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu yaamugira ati: Eri izooba okujunwa kwataaha omu nju egi, ahakuba ogu nawe n'omwana wa Abrahamu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.9",
            "verseOrgIds": [
              "LUK.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.16"
              },
              "items": [
                {
                  "text": "Ezk 34:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.15"
              },
              "items": [
                {
                  "text": "1 Tim 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi Omwana w'omuntu akaija kusherura n'okujuna ekyabuzire.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
