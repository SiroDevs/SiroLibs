                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yairiire haihi, yaareeba orurembo, yaaruririra, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.41",
            "verseOrgIds": [
