              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.6"
              },
              "items": [
                {
                  "text": "Luk 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bakuteere ahansi n'abaana baawe abakutwiremu; tibarikutsigamu ibaare eriri aha rindi, ahabw'okuba toramanyire biro eby'okutaayaayirwa kwawe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
