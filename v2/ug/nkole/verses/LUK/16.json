                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebiragiro na Baanabi bikaba biriho okuhitysa omu biro bya Yohaana; okuruga obwo enkuru nungi ey'obukama bwa Ruhanga ebuurirwa, kandi omuntu weena abutaahamu n'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikirahuka eiguru n'ensi okuhwaho okukira akatoonyezi kamwe k'omu Biragiro okuhwaho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        }
      ]
    },
