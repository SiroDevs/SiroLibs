            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.9"
              },
              "items": [
                {
                  "text": "Mat 19:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu weena orikushenda omukazi we akashwera ondiijo, naaba ashambaine; kandi orikushwera omukazi obingirwe iba, nawe naaba ashambaine.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
