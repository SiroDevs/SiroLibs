              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwe aha bahandiiki baagarukamu bati: Mwegyesa, waagamba gye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.39",
            "verseOrgIds": [
              "LUK.20.39"
            ]
          }
        },
        {
