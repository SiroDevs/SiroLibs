            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaababuuza ati: Nibabaasa bata kuhamya ngu Kristo n'Omwana wa Daudi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
            "verseOrgIds": [
              "LUK.20.41"
            ]
          }
        },
