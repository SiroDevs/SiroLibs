              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaabacwera enfumu ati: Mwetegyereze omutiini n'emiti endiijo yoona; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku etooka amababi, mwagareeba, mumanya ku obunaku bw'okugyesha buri haihi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.30",
            "verseOrgIds": [
              "LUK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo naimwe ku murireeba ebyo nibibaho, mumanye ngu obukama bwa Ruhanga buri haihi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.31",
            "verseOrgIds": [
              "LUK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buzimazima nimbagambira nti: Obusingye obu tiburihwaho, ebyo byona bitakabaireho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.32",
            "verseOrgIds": [
              "LUK.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
