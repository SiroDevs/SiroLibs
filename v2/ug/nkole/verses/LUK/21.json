          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ebi ku biritandika kubaho, mureebe ahaiguru, mwimutsye emitwe yaanyu, ahakuba okucungurwa kwanyu kuryaba kuri haihi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        },
