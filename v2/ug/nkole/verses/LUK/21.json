                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.1+MRK.13.2+MRK.13.3+MRK.13.4+MRK.13.5+MRK.13.6+MRK.13.7+MRK.13.8+MRK.13.9+MRK.13.10+MRK.13.11+MRK.13.12+MRK.13.13+MRK.13.14+MRK.13.15+MRK.13.16+MRK.13.17+MRK.13.18+MRK.13.19"
              },
              "items": [
                {
                  "text": "Mak 13:1-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bamwe, ku baabaire nibagamba ahari hekalu, oku ecumirwe n'amabaare ag'obuguzi bwingi n'ebihairweyo, yaagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.5",
            "verseOrgIds": [
              "LUK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.44"
              },
              "items": [
                {
                  "text": "Luk 19:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebi byona ebi murikureeba, ebiro biryaija, tihariho ibaare eriritsigara riri aha rindi eritarinagwa hansi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.6",
            "verseOrgIds": [
              "LUK.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamubuuza bati: Mwegyesa, beitu ebyo biryabaho ryari? Kandi ni kamanyiso ki akaryoreka obunaku obu ebyo byona biribeeraho? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.7",
            "verseOrgIds": [
              "LUK.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagira ati: Mwerinde, mutarihabisibwa; ahabw'okuba baingi baryaija omu iziina ryangye, nibagira bati: Niinye Kristo! Kandi bati: Obunaku buri haihi! Mutaribakuratira. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku murihurira engamba n'okujagarara, mutaritiina; ahabw'okuba ebyo bishemereire kubanza kubaho; kwonka emperu terihika ahonaaho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.9",
            "verseOrgIds": [
              "LUK.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.9",
            "verseOrgIds": [
              "LUK.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaabagira ati: Eihanga riryateera erindi ihanga n'obugabe buryateera obundi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "haryabaho emitsitsa y'amaani, n'enjara n'orufu omu myanya mingi; haryabaho ebirikutiinisa n'obumanyiso bukuru oburikuruga omu iguru. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.11",
            "verseOrgIds": [
              "LUK.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.11"
              },
              "items": [
                {
                  "text": "Luk 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ebyo byona ku biriba bitakabaireho, baryabakwata, babahiigye, babaheyo omuri sinagogi n'omu bihome, babatware omu maisho g'abagabe n'abategyeki, nibabatura eiziina ryangye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.12",
            "verseOrgIds": [
              "LUK.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo buryaba obunaku bwanyu bw'okuba abajurizi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.13",
            "verseOrgIds": [
              "LUK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.19"
              },
              "items": [
                {
                  "text": "Mat 10:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo eki mukuhamye omu mitima yaanyu, ku mutariteekateeka by'okwetonganira, obunaku butakahikire; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.14",
            "verseOrgIds": [
              "LUK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.10"
              },
              "items": [
                {
                  "text": "Byak 6:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba ndyabaha orurimi n'obwengye, ebi abazigu baanyu bataribaasa kurwanisa n'obu kwakuba okuhakanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.15",
            "verseOrgIds": [
              "LUK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muryaheebwayo abazaire baanyu, na beene shoimwe, n'abanyaruganda, n'abanywani baanyu; baryabaitisa bamwe ahariimwe; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.16",
            "verseOrgIds": [
              "LUK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "muryayangwa abantu boona ahabw'eiziina ryangye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.17",
            "verseOrgIds": [
              "LUK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.7"
              },
              "items": [
                {
                  "text": "Luk 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka n'akashokye k'aha mitwe yaanyu tikaribura. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.18",
            "verseOrgIds": [
              "LUK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.36"
              },
              "items": [
                {
                  "text": "Heb 10:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omukwehangaana nimwo murijunira amagara gaanyu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.19",
            "verseOrgIds": [
              "LUK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.19",
            "verseOrgIds": [
              "LUK.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku murireeba Yerusaalemu eyehinguririziibwe engabo, obwo muryamanya ngu okuhwerekyerera kwayo kuri haihi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.20",
            "verseOrgIds": [
              "LUK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo abari Buyudaaya bahungire aha nshozi, n'abariba bari omu rurembo bashohore; n'abariba bari omu byaro batarirutaahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.21",
            "verseOrgIds": [
              "LUK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.29"
              },
              "items": [
                {
                  "text": "Yer 5:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba ebiro ebyo nibyo biriba eby'okuhooreramu enzigu, ngu Ebyahandiikirwe byona bihikiirire. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.22",
            "verseOrgIds": [
