            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.41+MRK.12.42+MRK.12.43+MRK.12.44"
              },
              "items": [
                {
                  "text": "Mak 12:41-44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yainamura amaisho, yaareeba abatungi abaabaire nibata ebiconco byabo omu ibiikiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.1",
            "verseOrgIds": [
              "LUK.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaareba n'omufaakazi omworo naatamu obusente bubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.2",
            "verseOrgIds": [
              "LUK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.12"
              },
              "items": [
                {
                  "text": "2 Kor 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagira ati: Buzimazima nimbagambira nti: Omufaakazi oriya omworo yaatamu bingi okukira bariya boona; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba bo baatamu aha bibashaagire; kwonka omufaakazi oriya omu bworo bwe yaatamu ebi aine byona, kandi niryo itungo rye heza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.4",
            "verseOrgIds": [
              "LUK.21.4"
            ]
          }
        }
      ]
    },
    {
