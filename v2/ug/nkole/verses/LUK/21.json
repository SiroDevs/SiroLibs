            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eiguru n'ensi biryahwaho, kwonka ebigambo byangye tibirihwaho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.33",
            "verseOrgIds": [
              "LUK.21.33"
            ]
