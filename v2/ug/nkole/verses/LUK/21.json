                "loc": "MAT.24.1+MAT.24.2+MAT.24.3+MAT.24.4+MAT.24.5+MAT.24.6+MAT.24.7+MAT.24.8+MAT.24.9+MAT.24.10+MAT.24.11+MAT.24.12+MAT.24.13+MAT.24.14+MAT.24.15+MAT.24.16+MAT.24.17+MAT.24.18+MAT.24.19+MAT.24.20+MAT.24.21"
              },
              "items": [
                {
                  "text": "Mat 24:1-21",
