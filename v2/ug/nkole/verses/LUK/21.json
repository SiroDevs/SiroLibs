                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'ebyo baryareeba Omwana w'omuntu naizira omu kicu aine obushoboorozi n'ekitiinisa kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
