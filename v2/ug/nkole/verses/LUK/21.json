                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " abantu bahahaaze emitima ahabw'obwoba n'okutegyereza ekirikwenda kwija aha nsi; ahabw'okuba eby'amaani eby'omu iguru biryatengyetsibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
