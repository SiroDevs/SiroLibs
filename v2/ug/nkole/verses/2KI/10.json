                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " baashohoza enyomyo ezaabaire ziri omuri nyaruju ya Baali, baazootsya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.26",
            "verseOrgIds": [
              "2KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baayatagura ekishushani kya Baali, baasheenyagura nyaruju ye, baagihindura orubungo n'okuhitsya hati. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.27",
            "verseOrgIds": [
              "2KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo Yehu yaamazireho Baali, akamwiha omuri Israeli",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.28",
            "verseOrgIds": [
              "2KI.10.28"
            ]
