              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yehu yaateeranira hamwe abantu boona, yaabagira ati: Ahabu akaheereza Baali mpora, kwonka Yehu naija kumuheereza munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.18",
            "verseOrgIds": [
