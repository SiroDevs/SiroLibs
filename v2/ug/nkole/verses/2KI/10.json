            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro ebyo MUKAMA yaatandika kutuubya ensi ya Israeli. Hazaeli yaabasingura omu myatano ya Israeli yoona, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        },
        {
