                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima MUKAMA yaagira Yehu ati: Ahabw'okukora gye, okahikiiriza ebirikusiimwa omu maisho gangye, okagira enju ya Ahabu nk'oku naabaire ninteekateeka omu mutima gwangye kugigira, abaana baawe baryashutama aha kitebe ky'obugabe bwa Israeli okuhitsya aha busingye bwa kana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.30",
            "verseOrgIds": [
              "2KI.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Yehu tiyaayeta aha kugyendera omu biragiro bya MUKAMA Ruhanga wa Israeli n'omutima gwe gwona; tiyaaruga mu bibi ebi Yeroboamu yaakoreise Abaisraeli, bakacumura.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
