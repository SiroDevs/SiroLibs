                {
                  "text": "22:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo hati muunyetere baanabi ba Baali boona, boona abarikumuramya, n'abanyamurwa be boona, hatagira n'omwe owaaburaho; ahabw'okuba nyine ekitambo kihango ky'okutambira Baali; weena oraabureho tarikwija kugumaho. Kwoha Yehu ekyo akakikoresa obwengye oburimu obugobya, ngu abone kucwekyereza abarikuramya Baali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.19",
            "verseOrgIds": [
              "2KI.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehu yaaragiira ati: Murangye, habeho okuteerana okurikwera ahabwa Baali. Batyo baakuranga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.20",
            "verseOrgIds": [
              "2KI.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.32"
              },
              "items": [
                {
                  "text": "1 Bag 16:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yehu yaatuma omuri Israeli yoona; abaabaire nibaramya Baali boona baija, tihaagira muntu n'omwe owaatsigarayo ataizire. Baataaha omuri nyaruju ya Baali, yaijura n'aha bunwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.21",
            "verseOrgIds": [
              "2KI.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehu yaagambira orikutegyeka enju erikubikwamu ebijwaro, ati: Reetera abaramya Baali boona ebijwaro. Atyo yaabibareetera. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.22",
            "verseOrgIds": [
              "2KI.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Yehu yaataaha omuri nyaruju ya Baali na Yehonadabu mwene Rekabu, yaagambira abarikuramya Baali ati: Mwetegyereze, muhamye ngu omuriimwe tiharimu mwiru wa MUKAMA, kureka abarikuramya Baali bonka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.23",
            "verseOrgIds": [
              "2KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo yaataahamu kuhayo ebitambo n'okutamba ebitambo by'okwotsya. Kwonka Yehu akaba ataire aheeru abashaija makumi munaana, yaabagira ati: Omuntu oraikirize omwe ahari aba, abu naata omu mikono yaanyu, kubura, naamuzira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.24",
            "verseOrgIds": [
              "2KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.40"
              },
              "items": [
                {
                  "text": "1 Bag 18:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaaherize ati kutamba ekitambo ky'okwotsya, yaagira abarinzi n'abakuru b'engabo ati; Mutaahemu, mubaite, hatagira n'omwe owaacwa. Batyo baabaitsa rurara; bwanyima abarinzi n'abakuru b'engabo baabanaga aheeru, baataaha omu kishengye ky'omunda omuri nyaruju ya Baali, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.25",
            "verseOrgIds": [
              "2KI.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
