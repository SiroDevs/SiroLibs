                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.3"
              },
              "items": [
                {
                  "text": "Ezk 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elisa yaagira omugabe wa Israeli ati: Nyine kakwate ki naiwe? Irooko oyehanuuze ahari baanabi ba sho n'aha ba nyoko. Omugabe wa Israeli yaagira ati: Ngaaha! MUKAMA niwe atuhurwize twenshatu, ngu atuheyo omu mikono y'Abamoabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.13",
            "verseOrgIds": [
              "2KI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Bag 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.16"
              },
              "items": [
                {
                  "text": "2 Bag 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elisa yaagira ati: Nindahira MUKAMA ow'amahe, ou mpeereza, kuri ntaagirira Yehoshafaati omugabe wa Yuda eshoni, tinkukucwire ryera, n'obu kwakuba okukureeba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.14",
            "verseOrgIds": [
              "2KI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.46"
              },
              "items": [
                {
                  "text": "1 Bag 18:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.3"
              },
              "items": [
                {
                  "text": "Ezk 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.14"
              },
              "items": [
                {
                  "text": "3:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka mbwenu mundeetere omuteezi w'enanga. Omuteezi w'enanga ku yaagiteire, amaani ga MUKAMA gaamwijaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.15",
            "verseOrgIds": [
              "2KI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagira ati: Oku nikwo MUKAMA arikugamba naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.16",
            "verseOrgIds": [
              "2KI.3.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:16",
              "type": "text"
            },
            {
              "text": "nari: Niinyija kwijuza omukura ogu ogwomire amaizi.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwijuze oru ruhanga emikura; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.16",
            "verseOrgIds": [
              "2KI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba oku nikwo MUKAMA arikugamba naagira ati: Timurikwija kureeba muyaga n'obu yaakuba enjura, kwonka oru ruhanga nirwija kwijura amaizi, mubone kunywa, n'ente zaanyu n'enyamaishwa zaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.17",
            "verseOrgIds": [
              "2KI.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo n'ekigambo kikye ahari MUKAMA; kandi naija kuhayo n'Abamoabu omu mikono yaanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.18",
            "verseOrgIds": [
              "2KI.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nimwija kucwekyereza orurembo rwona oruriho orugo orwehinguririziibwe orugo rw'amabaare, n'orurembo rwona orurungi, kandi muteme omuti gwona omurungi, mwigare enshuro zoona ez'amaizi, mushiishe omusiri gwona omurungi n'amabaare. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.19",
            "verseOrgIds": [
              "2KI.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.39+EXO.29.40+EXO.29.41+EXO.29.42"
              },
              "items": [
                {
                  "text": "Kur 29:39-42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku bwaseesire, omu bunaku bw'okuhayo ekitambo, ahonaaho amaizi gaija nigaruga Edomu, ensi yaijura amaizi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
            "verseOrgIds": [
              "2KI.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
            "verseOrgIds": [
              "2KI.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamoabu boona ku baahuriire ngu abo bagabe baizire kurwana nabo, baahuruza boona abaabaire nibabaasa kujwara eby'okurwanisa, okwiha aha muto okuhika aha mukuru, baayemerera aha mwatano. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.21",
            "verseOrgIds": [
              "2KI.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baimukire kare omu kasheeshe, eizooba ryarasha aha maizi, Abamoabu baareeba amaizi omu maisho gaabo nigatukura nk'eshagama. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.22",
            "verseOrgIds": [
              "2KI.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagira bati: Eriya n'eshagama; buzimazima abo bagabe barwaine, baitana. Mbwenu imwe Abamoabu, murahukye tuze kunyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.23",
            "verseOrgIds": [
              "2KI.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku baahikire omu rusiisira rw'Abaisraeli, Abaisraeli baimuka baabarwanisa, okuhitsya obu baabahungire; bakagyenda nibabaita, bakarugaho bakahika n'omu nsi yaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.24",
            "verseOrgIds": [
              "2KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasheenya endembo, kandi omusiri gwona omurungi buri muntu yaagunagamu eibaare rye, okuhitsya obu baagishwekire yoona; baigara buri nshuro y'amaizi, baatema emiti yoona emirungi, okuhitsya obu aha ndembo z'amabaare haatsigare Kiruhareseesi yonka; bwanyima ab'enjungu baagigota, baagicwekyereza. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.25",
            "verseOrgIds": [
              "2KI.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe wa Moabu ku yaareebire orugamba nirumugyendera kubi, yaatwara abashaija magana mushanju abarikurwanisa zaarurara, ngu baataguze bahikye omugabe wa Edomu; kwonka tibaabaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.26",
            "verseOrgIds": [
              "2KI.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 3:27"
          },
          "items": [
