                "loc": "1KI.18.19"
              },
              "items": [
                {
                  "text": "1 Bag 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.6"
              },
              "items": [
                {
                  "text": "22:6",
