                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwaka gwa ikumi na munaana gw'omu busingye bwa Yehoshafaati omugabe wa Yuda, Yehoraamu mwene Ahabu akaba omugabe wa Israeli omuri Samaria, yaamara aha ngoma emyaka ikumi n'ebiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.1",
            "verseOrgIds": [
              "2KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakora ebirikwangwa MUKAMA, n'obu araabe atarabaire mubi nka ishe na nyina; ahakuba akihaho enyomyo ya Baali, ei ishe yaakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.2",
            "verseOrgIds": [
              "2KI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28+1KI.12.29+1KI.12.30+1KI.12.31+1KI.12.32"
              },
              "items": [
                {
                  "text": "1 Bag 12:28-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.16"
              },
              "items": [
                {
                  "text": "14:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka yaagumira omu kibi kya Yeroboamu mwene Nebati, eki yaasiisiise Abaisraeli; tiyaakireka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.3",
            "verseOrgIds": [
              "2KI.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.3",
            "verseOrgIds": [
              "2KI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesha omugabe wa Moabu akaba ari omworozi w'entaama. Buri mwaka akaba aragiirwe kuha omugabe wa Israeli abaana b'entaama akasiriira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.4",
            "verseOrgIds": [
              "2KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.1"
              },
              "items": [
                {
                  "text": "2 Bag 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Ahabu ku yaafiire, omugabe wa Moabu yaagomera omugabe wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.5",
            "verseOrgIds": [
              "2KI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo omugabe Yehoraamu yaaruga Samaria omu bunaku obwo, yaateerana Abaisraeli boona kuhurura. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.6",
            "verseOrgIds": [
              "2KI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.4"
              },
              "items": [
                {
                  "text": "1 Bag 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagyenda, yaatuma ahari Yehoshafaati omugabe wa Yuda, naamugira ati: Omugabe wa Moabu angomeire; noikiriza kuhurura naanye, tukateera Moabu? Onu yaamugarukamu ati: Eego, niinyija kuhurura; nyowe naiwe turi bamwe; abantu bangye nibo baawe, n'embaraasi zangye nizo zaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.7",
            "verseOrgIds": [
              "2KI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaagira ati: Tutoore guuha nituhurura? Yehoraamu yaamugarukamu ati: Tutoore ogw'eihamba rya Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.8",
            "verseOrgIds": [
              "2KI.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.8",
            "verseOrgIds": [
              "2KI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo omugabe wa Israeli yaahurura n'omugabe wa Yuda n'owa Edomu. Ku baaherize orugyendo rw'ebiro mushanju nibeekiikuura, haabura amaizi g'eihe n'obu gaakuba ag'enyamaishwa ezi baagyenzire nazo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.9",
            "verseOrgIds": [
              "2KI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe wa Israeli nikwo kugira ati: Ai bambe! MUKAMA atureetsire twenshatu kutuhayo omu mikono y'Abamoabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
            "verseOrgIds": [
              "2KI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.21"
              },
              "items": [
                {
                  "text": "1 Bag 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.7"
              },
              "items": [
                {
                  "text": "22:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yehoshafaati yaamubuuza ati: Aha tihariho nabi wa MUKAMA, ou twakwehanuuzaho ahari MUKAMA. Omwe aha bagaragwa b'omugabe wa Israeli yaagarukamu ati: Aha hariho Elisa mwene Shafati, owaabaire anaabisa Eliya engaro. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafaati yaagira ati: Ekigambo kya MUKAMA kiri omuriwe. Atyo omugabe wa Israeli yaashuuma ahari Elisa hamwe na Yehoshafaati n'omgabe wa Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.12",
            "verseOrgIds": [
              "2KI.3.12"
            ]
          }
        }
      ]
    },
    {
