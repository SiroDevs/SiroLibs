        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.12"
              },
              "items": [
                {
                  "text": "2 Bag 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yehoashi omugabe wa Israeli, ku yaabaire akiri aha ngoma, Elisa yaakwatwa endwara eyaamwitsire; omugabe yaashuuma kumwinamira, yaamuririra, naagira ati: Ai bambe Taata! Taata! Ebigaari bya Israeli n'ab'aha mbaraasi baayo! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa yaamugira ati: Kwata obuta n'emyambi. Atyo yaabikwata. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaamugira ati: Nanuura obuta! Yaabunanuura; Elisa yaata engaro aha z'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaagira ati: Igura edirisa erikureeba oburugwa-izooba. Onu yaagiigura. Elisa yaamugira ati: Rasha. Onu yaarasha. Yaagaruka yaagira ati: Ogwo n'omwambi gwa MUKAMA gw'obusinguzi ogw'okusingura Siria! Ahakuba noija kuranira omuri Afeki n'Abasiria, okuhitsya obu oraabaite okabamaraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaagira omugabe wa Israeli ati: Kwata emyambi. Onu yaagikwata. Yaagaruka yaamugira ati: Giteere ahansi. Yaagiteera ahansi kashatu, yaarereera. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwo mushaija wa Ruhanga yaamugwerwa kubi, yaamugira ati: Waaba oshemereire kugiteera ahansi emirundi etaano nari mukaaga; haza obwo obona kusingura Abaisiria, obamariraho kimwe; kwonka hati noija kubasingura emirundi eshatu yonka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        }
      ]
    },
