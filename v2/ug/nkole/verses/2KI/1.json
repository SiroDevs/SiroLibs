            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe yaagaruka yaamutumaho ondiijo mukuru w'engabo makumi ataano hamwe n'engabo ze. Yainamuka, yaamugira ati: Iwe mushaija wa Ruhanga 'we, ekiragiro ky'omugabe nikigira kiti: Shuuma ahonaaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.16"
              },
              "items": [
                {
                  "text": "Yob 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eliya yaabagarukamu ati: Ku ndaabe ndi omushaija wa Ruhanga, omuriro gurugye omu iguru, gukumareho n'engabo zaawe makumi ataano. Ahonaaho omuriro gwa Ruhanga gwaruga omu iguru, gwamumaraho n'engabo ze makumi ataano.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
