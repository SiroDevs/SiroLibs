            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo omugabe yaafa, nk'ekigambo kya MUKAMA eki Eliya yaagambire oku kyabaire kiri. Omu mwaka gwa kabiri ogw'omu busingye bwa Yehoraamu mwene Yehoshafaati omugabe wa Yuda, Yehoraamu omurumuna yaaba omugabe omu mwanya gwe, ahabw'okuba Ahazia ogwo akaba ataine mutabani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu endiijo mirimo ei Ahazia yaakozire tehandiikirwe omu kitabo ky'eby'omu busingye bw'abagabe ba Israeli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.18",
            "verseOrgIds": [
              "2KI.1.18"
            ]
          }
        }
      ]
    }
