              "items": [
                {
                  "text": "Bir 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.23"
              },
              "items": [
                {
                  "text": "1 Bag 14:23",
