              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka gwa ikumi na mushanju ogw'omu busingye bwa Peeka mwene Remalia, Ahazi mwene Yosamu omugabe wa Yuda akatandika kutegyeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
              "2KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.1+2CH.28.2+2CH.28.3+2CH.28.4"
              },
              "items": [
                {
                  "text": "2 Bus 28:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akaba ahikize emyaka makumi abiri, obu yaatandika kutegyeka; yaategyekyera emyaka ikumi na mukaaga omuri Yerusaalemu. Tiyaakora birikusiimwa MUKAMA Ruhanga we, nk'oku ishenkuru Daudi yaakozire, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
        {
