            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka yaagyendera omu mitwarize y'abagabe ba Israeli; kandi yaarabya n'omutabani omu muriro, naakuratira ebirikunugwa eby'abanyamahanga, abu MUKAMA yaabingire omu maisho g'Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 16:4"
          },
