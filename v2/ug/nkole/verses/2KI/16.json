                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.4"
              },
              "items": [
                {
                  "text": "2 Bag 14:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaaguma naatambira ebitambo, naayoterera obubaane omu myanya mikuru ey'okuramizamu n'aha bibungo kandi n'ahansi ya buri kiti ekyetwa omurinzi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        }
      ]
