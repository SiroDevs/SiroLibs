              "items": [
                {
                  "text": "2 Bag 8:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo Yehu mwene Yehoshafaati mwijukuru wa Nimushi, yaagomeire Yoramu. (Omu bunaku obwo Yoramu n'Abaisraeli boona bakaba nibarinda Ramosi-gileadi Hazaeli omugabe wa Siria; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.14",
            "verseOrgIds": [
              "2KI.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.29"
              },
              "items": [
                {
                  "text": "2 Bag 8:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka omugabe Yoramu akaba agarukire Yezereeli kurwarizibwayo obuhuta obu Abasiria baamuhutaize, obu yaarwana na Hazaeli omugabe wa Siria.) Atyo Yehu yaagira ati: Eki ku muraabe nikyo murikwenda, hatagira omuntu weena owairuka kuruga omu rurembo, kutwara enkuru omuri Yezereeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.15",
            "verseOrgIds": [
              "2KI.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Yehu yaatemba ekigaari, yaaza Yezereeli, ahakuba Yoramu niyo yaabaire arwariire; kandi obwo Ahazia omugabe wa Yuda akaba ashuumireyo kureeba Yoramu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.16",
            "verseOrgIds": [
              "2KI.9.16"
            ]
          }
        }
      ]
    },
