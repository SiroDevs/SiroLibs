                {
                  "text": "2 Bus 22:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoramu yaagira ati: Muboneze ekigaari kyangye. Baakiboneza. Yoramu omugabe wa Israeli na Ahazia omugabe wa Yuda baashohora, buri omwe omu kigaari kye, baaza kubugana Yehu, baamubugana aha kibanja kya Nabosi owa Yezereeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.21",
            "verseOrgIds": [
              "2KI.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 9:22"
          },
          "items": [
