          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.23"
              },
              "items": [
                {
                  "text": "1 Bag 21:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.35"
              },
              "items": [
                {
                  "text": "2 Bag 9:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Embwa ziryariira Yezebeeli omu kibanja kya Yezereeli, abure owaamuziika. Ahonaaho yaigura orwigi, yairuka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.10",
            "verseOrgIds": [
              "2KI.9.10"
            ]
          }
        }
      ]
    },
