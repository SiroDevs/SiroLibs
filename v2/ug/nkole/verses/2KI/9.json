                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ndyahindura enju ya Ahabu nk'eya Yeroboamu mwene Nebati, kandi nk'eya Baasha mwene Ahiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.9",
            "verseOrgIds": [
              "2KI.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 9:10"
