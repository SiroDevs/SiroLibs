                  "text": "1 Bag 19:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Elisa nabi yaayeta omwe aha batabani ba baanabi, yaamugira ati: Yezirikye, otware eri ihembe ry'amajuta, oze Ramosi-gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.1",
            "verseOrgIds": [
              "2KI.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku oraahikyeyo, osherure Yehu mwene Yehoshafaati, mwijukuru wa Nimushi; ku oraamanye omu ati, otaahemu, omwimutsye omuri beene ishe, omutware omu kishengye ky'omunda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.2",
            "verseOrgIds": [
              "2KI.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima okwate eri ihembe ry'amajuta, ogamushukye aha mutwe, ogire oti: Oku nikwo MUKAMA arikugamba naagira ati: Naakushukaho amajuta kuba omugabe wa Israeli. Ku oraaheze, oigure orwigi, ohungye, oteeziringa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.3",
            "verseOrgIds": [
              "2KI.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.3",
            "verseOrgIds": [
              "2KI.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo ogwo mutsigazi nabi yaagyenda, yaaza Ramosi-gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.4",
            "verseOrgIds": [
              "2KI.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaahikireyo, yaashanga abakuru b'eihe nibahanuura; yaagira ati: Nyine obutumwa ahariiwe, Omukuru w'engabo. Yehu yaamubuuza ati: Ahari oha omuriitwe twena? Yaamugarukamu ati: Ahariiwe, Omukuru w'engabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.5",
            "verseOrgIds": [
              "2KI.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.22.7"
              },
              "items": [
                {
                  "text": "2 Bus 22:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Yehu yaimuka, baataaha omu nju; ogwo mutsigazi yaamushuka amajuta aha mutwe, naamugira ati: Oku nikwo MUKAMA, Ruhanga wa Israeli arikugamba naagira ati: Naakushukaho amajuta kuba omugabe w'eihanga rya MUKAMA Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.6",
            "verseOrgIds": [
              "2KI.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.4"
              },
              "items": [
                {
                  "text": "1 Bag 18:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.5+1KI.21.6+1KI.21.7+1KI.21.8+1KI.21.9+1KI.21.10+1KI.21.11+1KI.21.12+1KI.21.13+1KI.21.14+1KI.21.15"
              },
              "items": [
