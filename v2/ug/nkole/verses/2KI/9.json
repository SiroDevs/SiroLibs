                  "text": "21:5-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oryaita ab'enju ya Ahabu mukama waawe, mbone kuhoora Yezebeeli enzigu y'eshagama y'abairu bangye baanabi, kandi n'eshagama y'abandi bairu ba MUKAMA boona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.7",
            "verseOrgIds": [
              "2KI.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.21"
              },
              "items": [
                {
                  "text": "1 Bag 21:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.17"
              },
              "items": [
                {
                  "text": "2 Bag 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba ab'enju ya Ahabu boona nibaija kuhwerekyerera, mmare ahari Ahabu oyetwa omushaija weena, omuhuuku nari ow'obusingye, omuri Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.8",
            "verseOrgIds": [
              "2KI.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.10"
              },
              "items": [
                {
                  "text": "1 Bag 14:10",
