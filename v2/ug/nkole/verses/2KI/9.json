              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.13"
              },
              "items": [
                {
                  "text": "2 Bus 21:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoramu ku yaareebire Yehu, yaamubuuza ati: Ni buhooro, Yehu? Onu yamugarukau ati: Ni buhooro ki, obushambani bwa nyoko Yezebeeli, n'oburugo bwe bikiri bingi biti? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.22",
            "verseOrgIds": [
              "2KI.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoramu yaahinduza embaraasi orukoba, yaahunga, naagira Ahazia ati: Ahazia, hariho okureebyana! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.23",
            "verseOrgIds": [
              "2KI.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehu yaananuura obuta bwe n'amaani ge goona, yaateeera Yoramu omwambi omu buteeraniro bw'amabega, gwamwata omutima, gwayogamu, yaagwa omu kigaari kye ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.24",
            "verseOrgIds": [
              "2KI.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.19"
              },
              "items": [
                {
                  "text": "1 Bag 21:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.29"
              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yehu yaagira Bidukaari omukuru w'engabo ze, ati: Mukirize, omunagye omu musiri gw'ekibanja kya Nabosi owa Yezereeli; ahakuba noijuka, obu nyowe naiwe twakurata Ahabu ishe, turi aha mbaraasi, MUKAMA akamuraguraho ekigambo eki ati: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.25",
            "verseOrgIds": [
              "2KI.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buzimazima, nk'oku nyomwabazyo ndeebire eshagama ya Nabosi n'abatabani, naanye ndyakuhoorera omuri ogu musiri; nikwo MUKAMA arikugira. N'ahabw'ekyo mukirize, omunagye omuri ogwo musiri, nk'oku MUKAMA yaagambire.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.26",
            "verseOrgIds": [
              "2KI.9.26"
            ]
          }
        }
      ]
