          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.11.21"
              },
              "items": [
                {
                  "text": "2 Bag 11:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.1"
              },
              "items": [
                {
                  "text": "12:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Yehosheba muhara w'omugabe Yehoraamu, munyaanya wa Ahazia, yaatwara Yoasi mutabani wa Ahazia, yaamwiha omuri batabani b'omugabe, abu baabaire nibenda kwita, yaamucwisa n'omurezi we, yaabata omu kishengye ky'okuraaramu. Atyo yaamushereka Atalia, tiyaitwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaaguma nawe asherekirwe omu nju ya MUKAMA okumara emyaka mukaaga; obwo Atalia naategyeka ensi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        }
      ]
    },
    {
