                {
                  "text": "Bir 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.21"
              },
              "items": [
                {
                  "text": "2 Bag 10:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga aho abantu boona ab'omuri egyo nsi baaza ahari nyaruju ya Baali, baagisheenya; amatambiro ge n'ebishushani bye baabisheenyagurira kimwe, baitira Mataani omunyamurwa wa Baali omu maisho g'ago matambiro. Kandi omunyamurwa yaata abarinzi aha nju ya MUKAMA. ",
          "type": "text",
