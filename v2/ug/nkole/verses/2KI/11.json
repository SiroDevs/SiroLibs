            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atalia nyina wa Ahazia ku yaareebire omutabani yaafa, yaimuka, yaacwekyereza abanyiginya boona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
