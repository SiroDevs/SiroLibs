              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.3"
              },
              "items": [
                {
                  "text": "2 Sam 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwayima Yehoyaada yaaragaanisa omugabe n'abantu endagaano na MUKAMA kuba abantu be; kandi yaagaruka yaaragaanisa omugabe n'abantu endiijo ndagaano. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.17",
            "verseOrgIds": [
              "2KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
