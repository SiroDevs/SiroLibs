              "items": [
                {
                  "text": "40:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho yaaragiira Hilukia omunyamurwa, Ahikaamu mwene Shafani, Akiboora mwene Mikaaya, Shafani omuhandiiki na Asaaya omugaragwa w'omugabe, naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.12",
            "verseOrgIds": [
              "2KI.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.27"
              },
              "items": [
                {
                  "text": "Bir 29:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwirooko muhanuuze ahari MUKAMA ahabwangye n'abantu bangye kandi na Yuda yoona eby'ebigambo by'ekitabo eki ekizoirwe; ahakuba ekiniga kya Ruhanga ekituriho ni kingi munonga, ahabw'okuba baatatenkuriitwe tibaroorobeire bigambo by'eki kitabo, okukora ebyahandiikirwe byona ebirikutukwataho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.13",
            "verseOrgIds": [
              "2KI.22.13"
            ]
          }
        }
      ]
    },
