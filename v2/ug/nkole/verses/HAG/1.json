        },
        {
          "text": " Nikyo eiguru ahaiguru yaanyu riimiire orume ahabwanyu, n'ensi ekanga kweza, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.10",
            "verseOrgIds": [
              "HAG.1.10"
            ]
