              "items": [
                {
                  "text": "Hag 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nkabateeza okubabuka, okusya-nyamwenga n'orubaare, kwonka nabwo timurangarukiire; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.17",
            "verseOrgIds": [
              "HAG.2.17"
            ]
          }
        },
