              "type": "text"
            }
          ]
        },
        {
          "text": "naitwe tube nk'amahanga goona; omugabe waitu agume atucwere emanja, kandi atwebembere aturwanirire omu ngamba zaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.20",
