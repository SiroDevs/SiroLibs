            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.13"
              },
              "items": [
                {
                  "text": "1 Sam 16:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.15"
              },
              "items": [
                {
                  "text": "28:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Saulo yaatiina Daudi, ahakuba MUKAMA akaba ari hamwe nawe, arugire ahari Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.2"
              },
              "items": [
                {
                  "text": "2 Sam 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo Saulo yaamweihiireho, akamugira omukuru w'omutwe gw'engabo rukumi, Daudi akaguma naazeebembera omu kuhurura, kandi naatabaaruka nazo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.13",
            "verseOrgIds": [
              "1SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.39.2"
              },
              "items": [
                {
                  "text": "Kut 39:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.6.27"
              },
              "items": [
                {
                  "text": "Yos 6:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Daudi yaaguma naakoresa obwengye omu mitwarize ye yoona; MUKAMA yaaguma nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo ku yaareebire aine obwengye bwingi omu mitwarize ye, yaamutiina. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.15",
            "verseOrgIds": [
              "1SA.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Abaisraeli n'Abayuda boona baamukunda, ahakuba akaba abeebembera omu kuhurura, kandi n'omu kutabaaruka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.16",
            "verseOrgIds": [
              "1SA.18.16"
            ]
          }
        }
      ]
    },
