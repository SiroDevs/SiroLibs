                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.15.33"
              },
              "items": [
                {
                  "text": "Enf 15:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaagira Saulo ati: Mbwenu nyowe niinye oha, n'abaitu nibo baahi, n'omuryango gwa taata omuri Israeli nigwo guuha, nyowe okuba mukwe w'omugabe? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.18",
            "verseOrgIds": [
              "1SA.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.21.8"
              },
              "items": [
                {
                  "text": "2 Sam 21:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka obunaku ku bwahikire, Merabu muhara wa Saulo, owaabaire ari ow'okuhingirwa Daudi, baamuhingira Adurieli owa Mehola.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.19",
            "verseOrgIds": [
              "1SA.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.19",
            "verseOrgIds": [
              "1SA.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Mikaali muhara wa Saulo yaarigira Daudi; ku baakigambiire Saulo, kyamushemeza; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.20",
            "verseOrgIds": [
              "1SA.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.26.24+PRO.26.25+PRO.26.26"
              },
              "items": [
                {
                  "text": "Enf 26:24-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaagira ati: Niinyija kumumuha, amubeere omutego, Abafilistia bamurwanise. Nikyo Saulo yaagiriire Daudi obwa kabiri, ati: Mbwenu hati noija kuba mukwe wangye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.21",
            "verseOrgIds": [
              "1SA.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nikwo kugambira abagaragwa be ati: Mugaaniire na Daudi omu mubonano, mumugire muti: Manya, omugabe naakusiima munonga, n'abagaragwa be boona nibakukunda; n'ahabw'ekyo ikiriza obe mukwe w'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.22",
            "verseOrgIds": [
              "1SA.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagaragwa ba Saulo baagambira Daudi ebyo bigambo. Daudi yaagira ati: Imwe nimukyeta ekintu kikye okuba mukwe w'omugabe; haza ndi omwana w'omworo, kandi otaine kitiinisa? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.23",
            "verseOrgIds": [
              "1SA.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima abagaragwa ba Saulo baamugambira oku Daudi agizire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.24",
            "verseOrgIds": [
              "1SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo yaagira ati: Oku mube nikwo mwagira Daudi muti: Omugabe tarikwenda njugano, kureka ebishushu igana ebishazirwe aha Bafilistia, abone kuhoora abazigu be. Kwonka Saulo akateekateeka atyo, ngu amwitse Abafilistia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.25",
            "verseOrgIds": [
              "1SA.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagaragwa be ku baaherize kugambira Daudi ebyo bigambo, Daudi yaasiima munonga kuba mukwe w'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.26",
            "verseOrgIds": [
              "1SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.14"
              },
              "items": [
                {
                  "text": "2 Sam 3:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebiro ku byabaire bitakahingwireho, Daudi yaimuka n'engabo ze, baahurura, baita Abafilistia magana abiri; Daudi yaatabaaruka n'ebyo bishushu byabo, baabitwarira omugabe byona, ngu abone kuba mukwe w'omugabe. Atyo Saulo yaamuhingira muhara we Mikaali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.27",
            "verseOrgIds": [
              "1SA.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Saulo ku yaabireebire, yaamanya ku MUKAMA ari hamwe na Daudi, kandi ku Abaisraeli boona barikumukunda, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.37.12"
              },
              "items": [
                {
                  "text": "Zab 37:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.37.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.4.4"
              },
              "items": [
                {
                  "text": "Mub 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaayeyongyera kumutiina. Okuruga aho Saulo yaaguma ari omuzigu wa Daudi ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima abategyeki b'Abafilistia baahurura kubarwanisa; ku baabaire bahurura, Daudi arwana gye okukira abagaragwa ba Saulo boona; n'ahabw'ekyo eiziina rye ryarangaanwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.30",
            "verseOrgIds": [
              "1SA.18.30"
            ]
          }
        }
      ]
    }
