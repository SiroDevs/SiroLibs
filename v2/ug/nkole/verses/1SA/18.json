              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.34"
              },
              "items": [
                {
                  "text": "Bar 11:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baabaire nibatabaaruka, Daudi aherize kwita ogwo Mufilistia, abakazi baaruga omu ndembo za Israeli zoona, baija kubugana Saulo nibeeshongora, nibaguruka, baine ebitaasa n'enanga z'emirya eshatu, nibashemererwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.6",
            "verseOrgIds": [
              "1SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kweshongora, abo bakazi baikirizana nibagira bati:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
