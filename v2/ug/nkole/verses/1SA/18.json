            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.18.24"
              },
              "items": [
                {
                  "text": "Enf 18:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi ku yaaherize kugamba na Saulo, omutima gwa Yonasaani gwanywana n'ogwa Daudi; Yonasaani yaamukunda nk'oku ayekunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.1",
            "verseOrgIds": [
              "1SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.15"
              },
              "items": [
                {
                  "text": "1 Sam 17:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eryo izooba Saulo yaatwara Daudi owe, tiyaamwikiriza bundi kugaruka owa ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.2",
            "verseOrgIds": [
              "1SA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Yonasaani yaaragaana na Daudi endagaano, ahakuba akamukunda nk'oku ayekunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.3",
            "verseOrgIds": [
              "1SA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonasaani yaayejuura omunagiro ogu yaabaire ajwaire, yaaguha Daudi, n'eby'okurwanisa bye, nangwa na rurara ye n'obuta bwe n'orukoba rwe nabyo yaabimuha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.4",
            "verseOrgIds": [
              "1SA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akaba aza ei Saulo yaabaire amutuma yoona; kandi akoresa obwengye. N'ahabw'ekyo Saulo yaamugira omukuru w'engabo ze, abantu boona baakisiima, nangwa n'abagaragwa ba Saulo baakisiima.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.5",
            "verseOrgIds": [
              "1SA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
