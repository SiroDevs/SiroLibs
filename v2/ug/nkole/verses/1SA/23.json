              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima baagambira Daudi bati: Reeba Abafilistia nibarwanisa Keila, kandi banyaga engano z'aha mbuga zaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.1",
            "verseOrgIds": [
              "1SA.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
