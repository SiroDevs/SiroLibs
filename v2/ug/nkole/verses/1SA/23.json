                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.10.23"
              },
              "items": [
                {
                  "text": "Yer 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi nikwo kwehanuuza ahari MUKAMA, naabuuza ati: Mbwenu nze kuteera abo Bafilistia? MUKAMA yaagarukamu Daudi ati: Irooko, obateere, ojune aba Keila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka abantu ba Daudi baamubuuza bati: Mbwenu obu twatiina tukiri aha omuri Yuda, ku turiza Keila kurwana n'amahe g'Abafilistia turyaba tuta? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.3",
            "verseOrgIds": [
              "1SA.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaagaruka yaayehanuuza ahari MUKAMA; MUKAMA yaamugarukamu ati: Imuka oshuume Keila; ahakuba niinyija kuhayo Abafilistia omu mikono yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaimuka n'engabo ze, baaza Keila, baarwana n'Abafilistia, baanyaga ente zaabo, baabaitamu abantu baingi munonga. Okwo nikwo Daudi yaajunire aba Keila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
