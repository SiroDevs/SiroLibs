            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Samueli yaashobororera abantu emitwarize y'obugabe, yaagihandika omu kitabo, yaakibiika omu maisho ga MUKAMA. Samueli yaaraga abantu boona, buri omwe yaagaruka omu ka ye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.25",
            "verseOrgIds": [
