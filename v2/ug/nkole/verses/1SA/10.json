                "loc": "1SA.11.15"
              },
              "items": [
                {
                  "text": "1 Sam 11:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Samueli yaayeta abantu kuteeranira Mizipa omu maisho ga MUKAMA; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.17",
            "verseOrgIds": [
              "1SA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.8"
              },
              "items": [
                {
                  "text": "Bar 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaagambira Abaisraeli ati: Oku nikwo MUKAMA Ruhanga wa Israeli arikugamba naagira ati: Nkaiha Abaisraeli Misri, naabajuna naabaiha omu mikono y'abanyamisri, n'omu mikono y'abagabe boona abaabaire nibabaita kubi; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.18",
            "verseOrgIds": [
              "1SA.10.18"
            ]
          }
        },
        {
