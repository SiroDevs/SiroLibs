                  "text": "Yos 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Samueli yairiza haihi enganda za Israeli zoona, oruganda rwa Benyamiini rwatooranwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.20",
            "verseOrgIds": [
              "1SA.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yairiza haihi oruganda rwa Benyamiini bari omu miryango yaabo, omuryango gwa Matiri gwatooranwa; na Saulo mwene Kiishi yaatooranwa. Kwonka ku baamusherwire, tiyaaboneka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.21",
            "verseOrgIds": [
              "1SA.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo baayongyera kwehanuuza ahari MUKAMA, nibamubuuza bati: Ogwo mushaija aizire aha? MUKAMA yaabagarukamu ati: Reeba, ayesherekire omu bintu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.22",
            "verseOrgIds": [
              "1SA.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagyenda nibairuka, baamwihayo; ku yaayemereire ahagati yaabo, yaakira abantu boona aha mutwe, baamugarukira aha ibega. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.23",
            "verseOrgIds": [
              "1SA.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueli yaagira abantu boona ati: Nimureeba ou MUKAMA atooraine? Tihariho ori nkawe omu bantu boona. Abantu boona baateera akaari, nibagira bati: Omugabe nakaramaare!",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.24",
            "verseOrgIds": [
              "1SA.10.24"
            ]
          }
        }
      ]
    },
