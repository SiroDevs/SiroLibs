                {
                  "text": "Bir 13:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.19.22"
              },
              "items": [
                {
                  "text": "Bar 19:22",
