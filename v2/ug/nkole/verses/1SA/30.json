          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaabitwekyera abaabaire bari Beseeli, na Ramoosi omuri Negebu, na Yatiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
