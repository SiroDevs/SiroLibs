          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ku yaahikire Zikulaagi, yaatwekyera banywani be abakuru b'Abayuda ahari egyo minyago, naagira ati: Ekiconco kyanyu nkikyo, ekirugire aha minyago y'abazigu ba MUKAMA; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
        {
