              "items": [
                {
                  "text": "21:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaamuhikizeyo, baashanga bajanjaire aho hoona, nibarya nibanywa nibazina, ahabw'eminyago egyo yoona emingi ei banyagire omu nsi y'Abafilistia n'omu nsi ya Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.16",
            "verseOrgIds": [
              "1SA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.20.5"
              },
              "items": [
                {
                  "text": "Yob 20:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaabaita okwiha omu rwita-waabo okuhitsya omu mwabazyo gw'erindi izooba; tihaahonokaho n'omwe omuribo, kureka abatsigazi magana ana, abaatembire engamira bakahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.17",
            "verseOrgIds": [
              "1SA.30.17"
            ]
          }
        },
        {
