                "loc": "AMO.8.11"
              },
              "items": [
                {
                  "text": "Amo 8:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwana Samueli akaba aheereza MUKAMA naategyekwa Eli. Kandi ekigambo kya MUKAMA kikaba kiri eky'eicweka omu biro ebyo, hatariho kworekwa kwa butunu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        }
      ]
