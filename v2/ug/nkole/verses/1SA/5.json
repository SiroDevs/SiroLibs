            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abashaija abaatsigaireho batafiire, baarwara ebizimba; n'okuborooga kw'orwo rurembo kwahika omu iguru.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.12",
            "verseOrgIds": [
              "1SA.5.12"
