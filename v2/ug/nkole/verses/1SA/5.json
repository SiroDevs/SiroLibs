              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafilistia ku baaherize kunyaga eshanduukye ya Ruhanga, baagiha Ebenezeeri, baagitwara Ashidoodi; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
              "1SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "baagitaasya omu ndaaro ya Dagoni, baagita aha rubaju rwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
