                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.24+1CH.16.25+1CH.16.26"
              },
              "items": [
                {
                  "text": "1 Bus 16:24-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.1.14"
              },
              "items": [
                {
                  "text": "Nah 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu kasheeshe abantu ba Ashidoodi ku baimukire kare, baashanga Dagoni agwire ajuumaire ahansi omu maisho g'eshanduukye ya MUKAMA. Baamujuumuura, baamugarura aha mwanya gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.2"
              },
              "items": [
                {
                  "text": "Yer 50:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.6"
              },
              "items": [
                {
                  "text": "Ezk 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ku baimukire kare omu kasheeshe kaakuratsireho, baashanga Dagoni agwire ajuumaire ahansi omu maisho g'eshanduukye ya MUKAMA, kandi omutwe gwe n'engaro ze bicwirweho, biri omu muryango; haatsigaire ekihinju kya ifo kyonka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki nikyo abagirwa ba Dagoni n'abataaha omu ndaaro ya Dagoni boona omuri Ashidoodi bataribatira mu kisasi ky'omuryango n'okuhitsya hati.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        }
      ]
    },
    {
