              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Saulo yaagira ati: Ncumwire; kwonka hati ninkweshengyereza mpa ekitiinisa omu maisho g'abakuru b'abantu bangye n'omu maisho ga Israeli yoona, ogyende naanye, mbone kuramya MUKAMA Ruhanga waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.30",
            "verseOrgIds": [
              "1SA.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Samueli yaahinduka, yaakurata Saulo; Saulo yaaramya MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        }
