        },
        {
          "text": " Saulo yaagira Samueli ati: Ncumwire; ahabw'okuba nsiisire ekiragiro kya MUKAMA n'ebigambo byawe ahabw'okutiina abantu n'okuboorobera. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.24",
            "verseOrgIds": [
              "1SA.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
