              "items": [
                {
                  "text": "Tit 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Maani ga Israeli tabeiha, n'obu kwakuba okwegarukamu; ahabw'okuba ti muntu ngu ayegarukyemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
