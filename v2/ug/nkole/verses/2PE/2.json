                {
                  "text": "Luk 12:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumanye ngu ekyakubaire gye aharibo, kuri bataramanyire muhanda gw'okuhikiirira, okukira obu baherize kugumanya, bakateishuka, bakareka ekiragiro ekirikwera eki baahairwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.21",
            "verseOrgIds": [
              "2PE.2.21"
            ]
          }
        },
