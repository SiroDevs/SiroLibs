        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.1",
            "verseOrgIds": [
              "2PE.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.4"
              },
              "items": [
                {
                  "text": "Yud 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka hakaba haimuka na baanabi ab'ebishuba omu ihanga (rya israeli), nk'oku omuriimwe haribamu abeegyesa ab'ebishuba, abaritaasya omu mubonano enyegyesa erikuhabisa, ekahwerekyereza, nangwa bakeehakana Mukama waabo owaabacungwire, bakeereetaho okucwekyerera kw'ahonaaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.1",
            "verseOrgIds": [
              "2PE.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi baingi baryakuratira emicwe yaabo ey'obushambani; abo baryajumisa omuhanda gw'amazima. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.2",
            "verseOrgIds": [
              "2PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.18"
              },
              "items": [
                {
                  "text": "Rom 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu kwetenga kwabo baryabaihamu enshaagi, nibababihabeiha n'ebigambo by'ebishuba; kwonka orubanja oru baacwereirwe ira tiruriikarayo, n'okucwekyerera kwabo tikurihungira. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.3",
            "verseOrgIds": [
              "2PE.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.6"
              },
              "items": [
                {
                  "text": "Yud 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba Ruhanga ku araabe atarasaasiire baamaraika obu baashiisha, akabanaga okuzimu, akabata omu biina eby'omwirima okurindirwayo okuhitsya aha kiro ky'orubanja; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.4",
            "verseOrgIds": [
              "2PE.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.8.18"
              },
              "items": [
                {
                  "text": "Kut 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ku araabe atarasaasiire nsi eya ira, akakiza Noa omurangi w'okuhikiirira n'abandi mushanju, obu yaareeta omwegyemure gw'amaizi aha nsi ey'abatarikumutiina; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.5",
            "verseOrgIds": [
              "2PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Kut 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ku araabe yaacwereire endembo za Sodoma na Gomora orubanja, akazihindura eiju, kazigira eky'okureeberaho aha barikugyendera omu kutamutiina; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.6",
            "verseOrgIds": [
              "2PE.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akakiza looti ohikiriire, owaabaire ashobeirwe ahabw'emicwe mibi y'abashambani; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.7",
            "verseOrgIds": [
              "2PE.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ezk 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (ahakuba omushaija ogwo ohikiriire akaba atwire nabo, naareeba kandi naahurira ebi baabaire bakora, kwonka agira enaku ebiro byona omu mutima gwe oguhikiriire ahabw'eby'obugomi ebi baabaire nibakora) ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.8",
            "verseOrgIds": [
              "2PE.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.13"
              },
              "items": [
                {
                  "text": "1 Kor 10:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'ahabw'ekyo Mukama naamanya kukiza abarikumutiina omu kugyezibwa, kandi n'okugumya abatahikiriire omu kifubiro okuhitsya aha kiro ky'orubanja, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.9",
            "verseOrgIds": [
              "2PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.7+JUD.1.8+JUD.1.9+JUD.1.10+JUD.1.11+JUD.1.12"
              },
              "items": [
                {
                  "text": "Yud 1:7-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " okukira abo abatwarwa omubiri n'okwetenga kwagwo okurikubashiisha, n'abarikugaya obutegyeki.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.10",
            "verseOrgIds": [
              "2PE.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abantu abatagira ki batiina, ebyegyengye abatatiina kujuma b'ekitiinisa, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.10",
            "verseOrgIds": [
              "2PE.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunu baamaraika, n'obu baraabe babakiza amaani n'obushoboorozi, tibacwera b'ekitiinisa abo rubanja omu maisho ga Mukama, nibabajuma. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.11",
            "verseOrgIds": [
              "2PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka abo bashusha nk'enyamaishwa ezitaine bwengye, ezaahangiirwe kutegwa n'okwitwa, kandi basheka ebi batarikumanya; aha muheru okuherekyerera kwabo nabo kuryabahwerekyereza, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.12",
            "verseOrgIds": [
              "2PE.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakorwe kubi, nibaihurwa ebihembo by'okukora kubi kwabo. Beesiimira ebinoomo nyomushana; n'abantu b'amabara mabi n'obumogo, bazaana kubi omu magyenyi gaabo, nibariira hamwe naimwe; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.13",
            "verseOrgIds": [
              "2PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "baine amaisho agaijwire obushambani, kandi agataruha kushiisha; niboosya ab'emitima etahamire, baine omutima ogumanyiire okwetenga okubi; n'abaana bakyeenirwe; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.14",
            "verseOrgIds": [
              "2PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.7"
              },
              "items": [
                {
                  "text": "Kub 22:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.14"
              },
              "items": [
                {
                  "text": "Kush 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " abaateishukire omuhanda oguhikire, bakahaba, bakatoora omuhanda gwa Balamu mutabani wa Beori, owaakunzire ebihembo by'okutahikiirira; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.15",
            "verseOrgIds": [
              "2PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka akahanwa ahabw'okushiisha kwe, obu endogoya etagamba yaagamba nk'omuntu, ekazibira eiraro rya nabi ogwo.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.16",
            "verseOrgIds": [
              "2PE.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
