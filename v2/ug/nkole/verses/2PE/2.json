              "2PE.2.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.12+JUD.1.13+JUD.1.14+JUD.1.15+JUD.1.16"
              },
              "items": [
                {
                  "text": "Yud 1:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo ni nk'amaziba agatarimu maizi, kandi ebicu ebitwarwa omuyaga; barindiirwe okunagwa omu mwirima ndindindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.17",
            "verseOrgIds": [
              "2PE.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "bagamba ebigambo ebikuru eby'okwetunguura ebitaine mugasho; boosya abantu ababa bahungire abatuura omu buhabe, nibababeihabeihesa okwetenga okubi okw'omubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.18",
            "verseOrgIds": [
              "2PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.34"
              },
              "items": [
                {
                  "text": "Yoh 8:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Babaraganisa obusingye, haza bo bari abahuuku b'okujunda; ahakuba ekisingura omuntu, nikyo aba omuhuuku waakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.19",
            "verseOrgIds": [
              "2PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.45"
              },
              "items": [
                {
                  "text": "Mat 12:45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba abaaherize kukira ebihagaro eby'ensi ahabw'okumanya Mukama n'Omujuni waitu Yesu Kristo, ku baagaruka kubyetaasyamu, byabasingura, ebya bwanyima byabo biba bibi okukira eby'okubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.20",
            "verseOrgIds": [
              "2PE.2.20"
            ]
          }
        },
