              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka obutungi obu tubwine omu nyabya z'eibumba, okworeka ngu amaani agarikukirira kimwe n'aga Ruhanga, ti gaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.7",
            "verseOrgIds": [
              "2CO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.5"
              },
              "items": [
                {
                  "text": "2 Kor 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tukubirwe embaju zoona, kwonka titufunziibwe; nitushoberwa, kwonka titurikuhwa matsiko; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.8",
            "verseOrgIds": [
              "2CO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nituhiigwa, kwonka titurikutsigwaho; twikarirwa, kwonka titugwaho; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.9",
            "verseOrgIds": [
              "2CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "obutoosha tugyenda twine okufa kwa Yesu omu mibiri yaitu, ngu amagara ge gareebekyere omu mibiri yaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.10",
            "verseOrgIds": [
              "2CO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.36"
              },
              "items": [
                {
                  "text": "Rom 8:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba itwe abahuriire tuheebwayo obutoosha okufa ahabwa Yesu, ngu amagara ga Yesu goorekwe omu mibiri yaitu erikufa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.11",
            "verseOrgIds": [
              "2CO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo okufa kukorera omuriitwe, kwonka amagara gakorera omuriimwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.12",
            "verseOrgIds": [
              "2CO.4.12"
            ]
          }
        }
      ]
