                "loc": "1CO.6.14"
              },
              "items": [
                {
                  "text": "1 Kor 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba nitumanya ngu Owaazoire Mukama waitu Yesu aryatuzoora hamwe nawe, atuhitsye omu maisho ge hamwe naimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.14",
            "verseOrgIds": [
              "2CO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba byona biri ahabwanyu, ngu, nk'oku emababazi zibugire omu bantu abarikweyongyera kuba baingi, zibe nikwo zaakanyisa okusiima, Ruhanga abone kuhimbisibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        }
      ]
