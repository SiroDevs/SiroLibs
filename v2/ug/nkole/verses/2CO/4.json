            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo titurikuhwa matsiko. N'obu omuntu waitu w'aharuguru ahwaho, kwonka omuntu waitu ow'omunda ahindurwa musya obutoosha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.16",
            "verseOrgIds": [
