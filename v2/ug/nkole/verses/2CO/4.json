                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumanye ngu obusaasi bwaitu bukye, obw'omwanya mukye ogu, bweyongyera obutoohsa kututeekateekyera ekitiinisa kingi munonga ekitahwaho, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.17",
            "verseOrgIds": [
              "2CO.4.17"
            ]
          }
        },
