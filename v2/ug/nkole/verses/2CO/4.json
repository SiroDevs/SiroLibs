            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku twine omwoyo gw'okwikiriza nk'ogw'ogwo owaahandiikire ati: Nkaikiriza, nikyo naagambiire, naitwe nitwikiriza, nikyo turikugambira; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.13",
            "verseOrgIds": [
              "2CO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
