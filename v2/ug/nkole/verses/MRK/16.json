                "loc": "ACT.16.18"
              },
              "items": [
                {
                  "text": "Byak 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obumanyiso oburiguma nibureebwa omu barikwikiriza n'obu: omu iziina ryangye baryabinga baadaimoni, baryagamba endimi nsya; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.17",
            "verseOrgIds": [
              "MRK.16.17"
            ]
          }
        },
