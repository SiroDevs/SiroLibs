              "items": [
                {
                  "text": "Yoh 20:19-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yaayeyoreka ahari ikumi n'omwe, bari bonka nibarya, yaabahana ahabw'okutaikiriza kwabo n'obugangaazi bw'emitima yaabo, ahakuba tibariakiriize bi baagambiirwe abaamureebire yaaheza kuzooka.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
