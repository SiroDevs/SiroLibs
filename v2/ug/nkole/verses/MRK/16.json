              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
