                "loc": "LUK.5.27+LUK.5.28+LUK.5.29+LUK.5.30+LUK.5.31+LUK.5.32"
              },
              "items": [
                {
                  "text": "Luk 5:27-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.9+MAT.9.10+MAT.9.11+MAT.9.12+MAT.9.13"
              },
              "items": [
                {
                  "text": "Mat 9:9-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagaruka yaagyenda aha rubaju rw'enyanja; omutwe gw'abantu gwamuteeraniraho, yaabeegyesa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.13",
            "verseOrgIds": [
              "MRK.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaagumizamu, yaareeba Leevi mwene Alifaayo, ashutami omu ihoorezo, yaamugira ati: Nkuratira! Yaimuka, yaamukuratira.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yesu ku yaabaire ashutami omwa Leevi naarya, abahooza baingi n'abasiisi baashutama hamwe nawe n'abeegi be; ahakuba abaabaire bamukuratiire bakaba bari baingi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.15",
            "verseOrgIds": [
              "MRK.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahandiiki b'Abafarisaayo, ku baareebire naarya n'abahooza n'abasiisi, baabuuza abeegi be bati: Ahabw'enki naarya kandi naanywa n'abahooza n'abasiisi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.16",
            "verseOrgIds": [
              "MRK.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ku yaabihuriire, yaabagarukamu ati: Abahuriire tibeetenga mufumu, kureka abarwaire; tindaizire kweta bahikiriire, kureka abasiisi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.17",
            "verseOrgIds": [
              "MRK.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
