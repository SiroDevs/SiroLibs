                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaatemba ekibungo, yaayeta abu yaayenzire, baija ahu yaabaire ari. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.13",
            "verseOrgIds": [
              "MRK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaihamu ikumi na babiri kuguma nawe, ngu agume abatume kubuurira engiri, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.14",
            "verseOrgIds": [
              "MRK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ngu abahe obushoboorozi bw'okubinga baadaimoni; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.15",
            "verseOrgIds": [
              "MRK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simooni yaamweta eiziina Petero, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.16",
            "verseOrgIds": [
              "MRK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yakobo mwene Zebedaayo na Yohaana murumuna wa Yakobo, yaabeeta Boanerege, amakuru gaaryo ngu Abaana b'okuhinda; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.17",
            "verseOrgIds": [
              "MRK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Anderea, Filipo Batolomaayo na Matayo, Tomasi, Yakobo mwene Alifaayo, Tadaayo, Simooni Omukananaayo, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yuda Iskaryota owaamureebize.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
        }
      ]
    },
