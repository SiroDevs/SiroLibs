              ]
            },
            {
              "text": "Mak 8:27—9:1",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.13+MAT.16.14+MAT.16.15+MAT.16.16+MAT.16.17+MAT.16.18+MAT.16.19+MAT.16.20+MAT.16.21+MAT.16.22+MAT.16.23+MAT.16.24+MAT.16.25+MAT.16.26+MAT.16.27+MAT.16.28"
              },
              "items": [
                {
                  "text": "Mat 16:13-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaamwohereza kutaaha owe, naamugira ati: Nangwa otagaruka n'omu kirorero.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.26",
            "verseOrgIds": [
              "MRK.8.26"
            ]
          }
        }
