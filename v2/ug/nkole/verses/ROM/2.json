            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu otashazirwe, ku araabe naahitsya ebi Ebiragiro biragiira, okutasharwa kwe tikuribarwa nk'okusharwa? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.26",
            "verseOrgIds": [
              "ROM.2.26"
            ]
          }
        },
        {
