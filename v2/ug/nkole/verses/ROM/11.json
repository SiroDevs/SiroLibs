              "ROM.11.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.24"
              },
              "items": [
                {
                  "text": "Luk 21:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.16"
              },
              "items": [
                {
                  "text": "Yoh 10:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " B'eishe-emwe, niinyenda ngu mushoborokyerwe enaama egi, murekye kweyeta abanyabwengye. Mumanye ku ekicweka ky'Abaisraeli kyagizire obugangaazi, okuhitsya obu Abanyamahanga baritaaha omu kanisa, bakahika omubaro oguhikire; ",
          "type": "text",
          "attrs": {
