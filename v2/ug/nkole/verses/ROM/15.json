        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.11"
              },
              "items": [
                {
                  "text": "2 Kor 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu nimbeeshengyereza, B'eishe-emwe, ahabwa Mukama waitu Yesu Kristo n'ahabw'okukunda kw'Omwoyo, ku mwezirikira hamwe naanye kunshabira ahari Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.30",
            "verseOrgIds": [
              "ROM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbone kukira ab'omu Bayudaaya abatarikwikiriza, kandi n'eby'obuhwezi ebi ndikutwara Yerusaalemu bisiimwe abarikwera; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntyo naanye Ruhanga ku araasiime, mbone kwija owaanyu nshemereirwe, turuhuukire hamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
              "ROM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga mukama w'obusingye agume naimwe mwena. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.33",
            "verseOrgIds": [
              "ROM.15.33"
            ]
          }
        }
      ]
