          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo, entumwa ya Kriso Yesu, nk'oku Ruhanga yaayenzire, eyaatumirwe kugamba eby'amagara agaraganisiibwe omuri Kristo Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "naakuhandiikira, Timoseo omwana wangye orikukundwa; ninkwendeza embabazi n'okusaasirwa n'obusingye ebirikuruga ahari Ruhanga Isheboona, na Kristo Yesu Mukama waitu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        }
      ]
    },
    {
