        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.16"
              },
              "items": [
                {
                  "text": "Rom 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo otarikwatwa enshoni z'okuhamya ebya Mukama waitu, nari okuzigira ahabwangye embohe ye; kureka okwatanise naanye omu kubonabonesibwa ahabw'engiri omu maani ga Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.8",
            "verseOrgIds": [
              "2TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.3.5"
              },
              "items": [
                {
                  "text": "Tit 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " owaatujunire akatwetesa okweta okurikwera, ti habw'emirimo yaitu, kureka ahabw'eki yaagyendereire, n'ahabw'embabazi ezi yaatuhaire ira ryona omuri Kristo Yesu; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.9",
            "verseOrgIds": [
              "2TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.14"
              },
              "items": [
                {
                  "text": "Heb 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi hati ebyo abyorekyeire omu kwija kw'omujuni waitu Kristo Yesu, owaahindwire okufa akakucwa busha, akooreka amagara n'okutafa omu mushana gw'engiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.10",
            "verseOrgIds": [
              "2TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engiri egyo niyo naateereirweho kuba omubuurizi waayo, n'okuba entumwa kandi omwegyesa; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.11",
            "verseOrgIds": [
              "2TI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ahabwayo ninshaasha, nk'oku ndikushaasha hati; kwonka tindikwitwa nshoni; ahabw'okuba nimmanya ou naikiriize, kandi nimpamiza kimwe ngu naabaasa kurinda ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.12",
            "verseOrgIds": [
              "2TI.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:12",
              "type": "text"
            },
            {
              "text": "Nari: eki naamubiikize.",
              "type": "text"
            }
          ]
        },
        {
          "text": "meki yankwatsize okuhitsya aha kiro ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.12",
            "verseOrgIds": [
              "2TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eky'okureeberaho ky'ebigambo by'amazima ebi waahuriire ningamba, okikuratire omu kwikiriza n'okukunda ebiri omuri Kristo Yesu; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.13",
            "verseOrgIds": [
              "2TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "orinde ekyo kirungi eki waakwatsiibwe Omwoyo Orikwera otuura omuriitwe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.14",
            "verseOrgIds": [
              "2TI.1.14"
            ]
          }
        }
      ]
    },
