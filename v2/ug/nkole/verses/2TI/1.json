            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.16"
              },
              "items": [
                {
                  "text": "2 Tim 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Noomanya ku ab'omuri Asia boona bampemukireho; abamwe ahari abo ni Figelo na Herumogene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.15",
            "verseOrgIds": [
              "2TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama agirire embabazi ab'omuka ya Onesifooro, ahabw'okuba kaingi akaba angarura omutima omunda; kandi taraitsirwe nshoni ahabw'enjegyere zangye. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.16",
            "verseOrgIds": [
              "2TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaahikire Rooma, yaataho omutima kunsherura, yambona. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.17",
            "verseOrgIds": [
              "2TI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama amuhe okusaasirwa omu maisho ge aha kiro ekyo. Kandi noomanya gye ebi yankoreire byona omuri Efeso.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.18",
            "verseOrgIds": [
              "2TI.1.18"
            ]
          }
        }
      ]
