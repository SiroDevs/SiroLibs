              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "B'eshe-emwe, nimbeeshengyereza, mwikirize ekigambo eki naabahabura, ahakuba naabahandiikira nincwera hagufu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.22",
            "verseOrgIds": [
