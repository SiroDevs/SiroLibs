                "loc": "2PE.1.7"
              },
              "items": [
                {
                  "text": "2 Pet 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okukundana kugumeho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.1",
            "verseOrgIds": [
              "HEB.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.13"
              },
              "items": [
                {
                  "text": "Rom 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.9"
              },
              "items": [
                {
                  "text": "1 Pet 4:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.3"
              },
              "items": [
                {
                  "text": "Kut 18:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutarireka kukunira abagyenyi; ahakuba omu muringo nk'ogwo hariho abaakuniire baamaraika batakimanyire. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.2",
            "verseOrgIds": [
              "HEB.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.36"
              },
              "items": [
                {
                  "text": "Mat 25:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwijukye abari omu bihome, nk'ababohirwe nabo; kandi mwijukye n'abarikwitwa kubi, ahakuba naimwe mwine emibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.3",
            "verseOrgIds": [
              "HEB.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obushwere mwena mubuhe ekitiinisa; kandi ekitabo ky'obushwere kirekye kushiishwa, ahakuba abashambani Ruhanga aryabacwera orubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.4",
            "verseOrgIds": [
              "HEB.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.6"
              },
              "items": [
                {
                  "text": "Bir 31:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutarigira omutima ogurikukunda empiiha, ebi mwine bibe nibyo byabamara; ahakuba We akagira ati: Tindikutsigaho, kandi tindikuhemukaho na kakye. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.5",
            "verseOrgIds": [
              "HEB.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.6"
              },
              "items": [
                {
                  "text": "Zab 118:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo turikugambira, tutarikubanganisa, tuti:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.6",
            "verseOrgIds": [
              "HEB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.6",
            "verseOrgIds": [
              "HEB.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwijukye abeebembezi baanyu, abaabagambiire ekigambo kya Ruhanga; mwetegyereze omuheru gw'amagara gaabo, mutooreze okwikiriza kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.7",
            "verseOrgIds": [
              "HEB.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.17"
              },
              "items": [
                {
                  "text": "Kush 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu Kristo tahinduka; oku abaire ari nyomwabazyo, n'eri izooba nikwo ari, kandi nikwo ariguma ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.8",
            "verseOrgIds": [
              "HEB.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.14"
              },
              "items": [
                {
                  "text": "Efe 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutahabisibwa enyegyesa ezihangire ez'emiringo mingi; ahakuba ni kirungi omutima kuhamibwa embabazi za Ruhanga, kunu ti migyenzo y'eby'okurya etaragasiire baagiikiriize. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.9",
            "verseOrgIds": [
              "HEB.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twine eitambiro eri abaheereza b'omu Ihema bataikirizibwa kurya ebiritambiirweho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.10",
            "verseOrgIds": [
              "HEB.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.27"
              },
              "items": [
                {
                  "text": "Lev 16:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba enyamaishwa, ezi omunyamurwa omukuru atwara eshagama yaazo omu Mwanya ogurikwera okuba ebitambo by'ebibi, emitumbi yaazo bagyokyeza aheeru y'orusiisira. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.11",
            "verseOrgIds": [
              "HEB.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo na Yesu yaabonaboneire aheeru y'eirembo, ngu abone kweza abantu n'eshagama ye. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.12",
            "verseOrgIds": [
              "HEB.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.2"
              },
              "items": [
                {
                  "text": "Heb 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo naitwe ka tushohore, tumushangye aheeru y'orusiisira, twekoreire ekijumo ahabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.13",
            "verseOrgIds": [
              "HEB.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.10"
              },
              "items": [
                {
                  "text": "Heb 11:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba aha titwineho rurembo orurikugumaho, kureka nitusherura orundi oruriija. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.14",
            "verseOrgIds": [
              "HEB.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.14.2"
              },
              "items": [
                {
                  "text": "Hos 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu ahabw'Ogwo ka tugume tutambe ekitambo ky'okusiima Ruhanga, nikyo kyana ky'eminwa erikuhimbisa eiziina rye. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.15",
            "verseOrgIds": [
              "HEB.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.18"
              },
              "items": [
                {
                  "text": "Fil 4:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutarireka kukorera abantu ebirungi, n'okukwatanisa omu bi mwine; ahakuba ebhitambo nk'ebyo nibyo bishemeza Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.16",
            "verseOrgIds": [
              "HEB.13.16"
            ]
          }
        }
      ]
    },
    {
