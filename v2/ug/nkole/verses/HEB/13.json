          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundamukize abeebembezi baanyu boona n'abarikwera boona. Aba Italia baabaramutsya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.24",
            "verseOrgIds": [
              "HEB.13.24"
            ]
