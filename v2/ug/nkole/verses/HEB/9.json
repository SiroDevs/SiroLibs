            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu eshangama y'embuzi n'ente n'eiju ry'enyana y'eruutsi ebimiisiirwa aha bantu abasiisikaire ku biraabe nibyeza emibiri ekashemera, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
