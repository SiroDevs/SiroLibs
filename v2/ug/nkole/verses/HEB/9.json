        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Kristo ku yaizire kuba omunyamurwa omukuru ow'ebirungi ebyabaire nibyenda kwija, yaaraba omu Ihema eririkukira obukuru n'okuhikiirira, (eritakozirwe bantu, amakuru ngu eritari ry'ebihangirwe by'omu nsi); ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.11",
            "verseOrgIds": [
              "HEB.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "tarataahire mu Mwanya ogurikwera, aine eshagama y'embuzi nari ey'ente, kureka akataahayo rimwe yaaheza, aine eye; atyo yaatutungira okucungurwa okutahwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.12",
            "verseOrgIds": [
              "HEB.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
