            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.18"
              },
              "items": [
                {
                  "text": "1 Pet 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.7"
              },
              "items": [
                {
                  "text": "1 Yoh 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " eshagama ya Kristo, owaayehaireyo ahari Ruhanga ahabw'Omwoyo Orikwera kuba ekitambo ekitaine kamogo, terikira munonga kushemeza emitima yaanyu kureka emirimo efiire, mukabona kuheereza Ruhanga ohuriire?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        }
      ]
