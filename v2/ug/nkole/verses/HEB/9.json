            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba hakaba hariho Eihema eryakozirwe; omu mwanya gw'okubandizaho omuriryo hakaba harimu etabaaza n'emeeza n'emigaati y'okumurikwe; aho niho haabaire heetwa Aharikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.33"
              },
              "items": [
                {
                  "text": "Kur 26:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omunda y'omukingo ogwa kabiri hakaba heebwa Aharikwera munonga, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.33"
              },
              "items": [
                {
                  "text": "Kur 16:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.21"
              },
              "items": [
                {
                  "text": "25:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " harimu eky'okwotereraho obubaane ekiheesirwe omu zaabu, n'eshanduukye y'endagaano eshwekirwe ezaabu embaju zoona, eyaabaire erimu orwabya rw'ezaabu orwabiare rubiikirwemu emaanu, n'enkoni ya Arooni eyaatookire, kandi n'ebishate by'amabaare g'endagaano; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahaiguru yaayo hakaba hariho Baakerubi b'ekitiinisa basangiire ekitebe ky'okusaasira. Ebyo titurikubaasa kubitondoora buri kimwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baaherize kutebeekanisa ebyo byona, okuruga aho abanyamurwa baguma nibataaha omu mwanya ogw'okubanza kuhikiiriza emirimo y'okuheereza; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.2"
              },
              "items": [
                {
                  "text": "Lev 16:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka omu mwanya ogwa kabiri hakaba hazamu omunyamurwa omukuru wenka rimwe omu mwaka, akaba atazayo ataine shagama y'okwetambirira n'okutambirira ebibi by'abantu ebi baakoreire omu butamanya, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.19"
              },
              "items": [
                {
                  "text": "Heb 10:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwoyo Orikwera naamanyisa atyo, ngu omuhanda gw'okutaaha omu mwanya ogurikwera munonga tigurkabonekire, eihema ery'okubanza rikiriho, (eririkutushobororera eby'obusingye obu.) ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.1"
              },
              "items": [
                {
                  "text": "Heb 10:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'omu biro ebyo bakaba bahonga empongano, batamba n'ebitambo ebitarikubaasa kushemeza buzima mutima gw'ogwo orikuramya Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
            "verseOrgIds": [
              "HEB.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kureka bikwata aha by'okurya n'eby'okunywa n'eby'okwoga okw'emiringo etari emwe, niyo migyenzo eyaatairweho ahabw'omubiri okuhitsya aha biro by'okuhindurwa obusya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        }
      ]
    },
    {
