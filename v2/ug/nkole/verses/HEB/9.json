          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.5"
              },
              "items": [
                {
                  "text": "1 Tim 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo Kristo n'omuteerani w'endagaano ensya, ngu abaayetsirwe baheebwe obuhuunguzi obutahwaho obwaraganisiibwe ahabw'okufa kw'Ogwo owaafiire kucungura abaasiisire, abarikutegyekwa endagaano ey'okubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimumanya ngu, ahi endagaano ey'okuraga eri, hashemereire kubaho ekirikuhamya okufa kwa nyakuraga; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba endagaano ey'okuraga ehama, nyakuraga yaaheza kufa; ahabw'okuba tekora nyakuraga akiriho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo n'endagaano ey'okubanza terahamiibwe ahatari shagama. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.18",
            "verseOrgIds": [
              "HEB.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 9:19"
          },
