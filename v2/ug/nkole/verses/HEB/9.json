              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimumanya ngu endagaano ey'okubanza ekaba eine emigyenzo eyaaragiirwe ey'okuramya Ruhanga, n'omwanya ogurikwera ogw'omu nsi egi; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
