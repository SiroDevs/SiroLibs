              "items": [
                {
                  "text": "Kol 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka Kristo akaba ari omwesigwa orikutegyeka enju ya Ruhanga nk'omwana we. Kandi enju ye niitwe, ku turaabe nitugumiza kimwe obumanzi bwaitu n'okwesiimira ebi twineho amatsiko tuhamire okuhitsya aha muheru.",
          "type": "text",
          "attrs": {
