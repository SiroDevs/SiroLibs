        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.7.19"
              },
              "items": [
                {
                  "text": "Heb 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebiragiro ahabw'okushusha ebirungi ebyabaire nibyenda kwija, bitari byo buzima, tibibaasa kuhikiiriza abantu abarikwirira haihi ahabw'ebitambo ebyo ebyabaire biheebwayo obutoosha buri mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri kyabaire nikibaasika, tibyakurekirwe kutambwa? Ahakuba abarikuramya, ku baakuherize kushemezibwa rimwe buzima, tibaakugarukire kwemanyaho bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ebitambo ebyo bikaba bibaijutsya ebibi byabo buri mwaka; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.3",
            "verseOrgIds": [
              "HEB.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba eshagama y'enimi n'ey'embuzi tebaasa kwihaho bibi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
