              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu ku agomera ekiragiro kya Musa, yaashinjwa abantu bashatu nari babiri, tasaasirwa, aitwa. ",
          "type": "text",
          "attrs": {
