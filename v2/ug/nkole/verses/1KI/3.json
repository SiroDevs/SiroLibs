                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sulemaani yaakunda MUKAMA, yaagyendera omu biragiro bya Daudi ishe; kwonka yaaguma naatambira ebitambo omu myanya mikuru ey'okuramizamu, kandi naayotererayo obubaane.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.3",
            "verseOrgIds": [
              "1KI.3.3"
            ]
