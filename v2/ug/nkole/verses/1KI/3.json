            }
          ]
        },
        {
          "text": " Kwonka abantu bakaba bahongyera empongano zaabo omu myanya mikuru y'okuramizamu, ahakuba hakaba hatakombekirwe nju ahabw'eiziina rya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.2",
            "verseOrgIds": [
              "1KI.3.2"
            ]
          }
        },
        {
