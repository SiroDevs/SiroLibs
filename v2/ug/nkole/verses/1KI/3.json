            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu hati, MUKAMA Ruhanga wangye, ogizire omwiru waawe omugabe omu mwanya gwa tata Daudi, n'obu ndaabe ndi omwana muto, ntarikumanya oku ndaashohore, n'oku ndaataahe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.7",
            "verseOrgIds": [
              "1KI.3.7"
            ]
          }
        },
        {
