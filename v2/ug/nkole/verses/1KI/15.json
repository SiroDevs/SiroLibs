            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaakora ebirikwangwa MUKAMA, yaagyendera omu muhanda gwa ishe, n'omu kibi kye eki yaasiisiise Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
