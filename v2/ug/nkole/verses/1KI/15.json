              "items": [
                {
                  "text": "1 Bag 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.26"
              },
              "items": [
                {
