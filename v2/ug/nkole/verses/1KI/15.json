                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Baasha mwene Ahiya ow'omu ruganda rwa Isakaari yaamugiira omu naama, yaamwitira Gibesooni, ey'Abafilistia; ahakuba Nadabu na Israeli yoona bakaba bagotsire Gibesooni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.27",
            "verseOrgIds": [
              "1KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka gwa kashatu ogw'omu busingye bwa Asa omugabe wa Yuda nibwo yaamwita, akategyeka omu mwanya gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
            "verseOrgIds": [
              "1KI.15.28"
            ]
          }
        },
