            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaaherize ati kuza aha ngoma, yaita ab'enju ya Yeroboamu muntu weena orikwitsya, okuhitsya obu yaagicwekyereize, nk'ekigambo kya MUKAMA eki yaarabize omu mwiru we Ahiya owa Shiilo oku kyabaire kiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'ebibi ebi Yeroboamu yaakozire, n'ebi yaasiisiise Abaisraeli, n'ahabw'okwitsa ekiniga MUKAMA, Ruhanga wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
