                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.18"
              },
              "items": [
                {
                  "text": "2 Bag 12:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Asa yaatwara efeeza n'ezaabu zoona, ezaabaire zitsigaire omu bintu by'obuguzi bwingi ebibiikirwe omu nju ya MUKAMA, n'ebindi ebibiikirwe omu nju y'omugabe, yaabiha abagaragwa be; yaabatuma ahari Benihadadi mwene Taburimooni, mwijukuru wa Hezioni, omugabe wa Siria, owaabaire atwire Damasiko, naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.7"
              },
              "items": [
                {
                  "text": "2 Bus 16:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka tukore endagaano y'okukwatanisa nyowe naiwe, nk'oku tata na sho baabaire bagiine. Kandi reeba naakutwekyera ekiconco ky'efeeza n'ezaabu; irooko oite endagaano yaawe na Baasha omugabe wa Israeli, abone kundugaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.19",
            "verseOrgIds": [
              "1KI.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benihadadi yaikiriza eki omugabe Asa yaamushaba, yaayohereza abakuru b'amahe ge kuteera endembo za Israeli, yaakubuura Iyooni, Daani, Abeeli-besimaaka, na Kineroosi yoona hamwe n'ensi yoona eya Nafutaali. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.20",
            "verseOrgIds": [
              "1KI.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasha ku yaakihuriire, yaarekyera aho kwombeka Raama, yaaguma Tiruza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.21",
            "verseOrgIds": [
              "1KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima omugabe Asa yaarangirira omu Bayuda boona, tiyaagira u yaatsiga, baaza Raama, baihayo amabaare n'ebiti ebi Baasha yaabaire ayombekyeise; omugabe Asa yaabyombekyesa Geeba ya Benyamiini na Mizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.22",
            "verseOrgIds": [
              "1KI.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.11+2CH.15.12+2CH.15.13+2CH.15.14"
              },
              "items": [
                {
                  "text": "2 Bus 15:11-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu endiijo mirimo yoona eya Asa, amaani ge goona, ebi yaakozire byona, n'endembo ezi yaayombekire, tibihandiikirwe omu kitabo ky'eby'omu binsigye bw'abagabe ba Yuda? Kwonka omu bugurusi bwe ebigyere bye bikarwara. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.23",
            "verseOrgIds": [
              "1KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.17.1"
              },
              "items": [
                {
                  "text": "2 Bus 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Asa yaagwejegyera, yaashanga baishenkuru, yaaziikwa hamwe nabo omu rurembo rwa Daudi ishenkuru; Yehoshafaati omutabani yaategyeka omu mwanya gwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.24",
