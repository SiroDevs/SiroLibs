              "items": [
                {
                  "text": "14:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ekya buzima emyanya mikuru ey'okuramizamu teraihirweho. Kwonka omutima gwa Asa gwaguma guri ogw'amazima ahari MUKAMA ebiro bye byona. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.14",
            "verseOrgIds": [
              "1KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.51"
              },
              "items": [
                {
                  "text": "1 Bag 7:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaareeta omu nju ya MUKAMA ebintu ebi ishe yaashoroire, n'ebindi ebi yaashoroire ahabwe, efeeza, ezaabu n'ebintu by'okukoresa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        }
      ]
    },
