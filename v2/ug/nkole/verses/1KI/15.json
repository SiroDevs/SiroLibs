              },
              "items": [
                {
                  "text": "2 Bus 13:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwaka gwa ikumi na munaana ogw'omu busingye bw'omugabe Yeroboamu mwene Nebati, Abiyamu akatandika kutegyeka Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.1",
            "verseOrgIds": [
              "1KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaategyekyera emyaka eshatu omuri Yerusaalemu. Nyina akaba naayetwa Maaka, muhara wa Abishalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.2",
            "verseOrgIds": [
              "1KI.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.61"
              },
              "items": [
                {
                  "text": "1 Bag 8:61",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.4"
              },
              "items": [
                {
                  "text": "11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abiyamu ogwo yaaguma naagyendera omu bibi byona ebi ishe owaamubandiize yaakozire; ahabw'okuba omutima gwe gwona gukaba gutari gw'amazima ahari MUKAMA Ruhanga we, nk'ogwa ishenkuru. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.3",
            "verseOrgIds": [
              "1KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.36"
              },
              "items": [
                {
                  "text": "1 Bag 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ahabwa Daudi, MUKAMA Ruhanga we yaamuha etabaaza omuri Yerusaalemu, yaataho omwana we owaamuhunguiire, kandi yaahamya Yerusaalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.4",
            "verseOrgIds": [
              "1KI.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.11.14"
              },
              "items": [
                {
                  "text": "2 Sam 11:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.11.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.9"
              },
              "items": [
                {
                  "text": "12:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.4"
              },
              "items": [
                {
                  "text": "1 Bag 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.8"
              },
              "items": [
                {
                  "text": "14:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba Daudi akakora ebirikusiimwa MUKAMA, tiyaateshuka kyona eki yaamuragiire ebiro byona eby'amagara ge, okwihaho ebya Uriya Omuhiiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi haaguma nihabaho obweme ahagati ya Rehoboamu na Yeroboamau ebiro byona eby'amagara ge. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.6",
            "verseOrgIds": [
              "1KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.13.2+2CH.13.3+2CH.13.4+2CH.13.5+2CH.13.6+2CH.13.7+2CH.13.8+2CH.13.9+2CH.13.10+2CH.13.11+2CH.13.12+2CH.13.13+2CH.13.14+2CH.13.15+2CH.13.16+2CH.13.17+2CH.13.18+2CH.13.19+2CH.13.20"
              },
              "items": [
                {
                  "text": "2 Bus 13:2-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.13.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Endiijo mirimo ya Abiyamu n'ebi yaakozire byona, tibihandiikirwe omu kitabo ky'eby'omu busingye bw'abagabe ba Yuda? Kandi haaguma nihabaho obweme ahagati ya Abiyamu na Yeroboamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.7",
            "verseOrgIds": [
              "1KI.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.1"
              },
              "items": [
                {
                  "text": "2 Bus 14:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Abiyamu yaagwejegyera, yaashanga baishenkuru, baamuziika omu rurembo rwa Daudi. Omutabani Asa yaategyeka omu mwanya gwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.8",
            "verseOrgIds": [
              "1KI.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.8",
            "verseOrgIds": [
              "1KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka gwa makumi abiri gw'omu busingye bwa Yeroboamu omugabe wa Israeli, Asa akatandika kutegyeka Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.9",
            "verseOrgIds": [
              "1KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaategyekyera emyaka makumi ana na gumwe omuri Yerusaalemu. Kandi nyina akaba naayetwa Maaka, muhara wa Abishalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.10",
            "verseOrgIds": [
              "1KI.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.2"
              },
              "items": [
                {
                  "text": "2 Bus 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Asa ogwo akakora ebirikusiimwa MUKAMA nk'oku Daudi ishenkuru yaakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.11",
            "verseOrgIds": [
              "1KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.24"
              },
              "items": [
                {
                  "text": "1 Bag 14:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.8"
              },
              "items": [
                {
                  "text": "2 Bus 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaabinga ebitingwa omu nsi, kandi yaihaho ebishushani byona ebi baishenkuru baakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.12",
            "verseOrgIds": [
              "1KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.16+2CH.15.17+2CH.15.18"
              },
              "items": [
                {
                  "text": "2 Bus 15:16-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaabinga na nyima Maaka, yaamwiha aha bwanyin'omugabe, naamutura ekishushani ky'ekihagaro eki yaakoreire Ashera; ekyo kishushani Asa yaakitema, yaakyokyeza aha kagyera Kidirooni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.13",
            "verseOrgIds": [
              "1KI.15.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.20"
              },
              "items": [
                {
                  "text": "Kur 32:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.13",
            "verseOrgIds": [
              "1KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
