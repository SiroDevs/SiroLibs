            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu endiijo mirimo ya Nadabu n'ebi yaakozire byona, tibihandiikirwe omu kitabo ky'eby'omu busingye bw'abagabe ba Israeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
