          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.12.5"
              },
              "items": [
                {
                  "text": "2 Bus 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
