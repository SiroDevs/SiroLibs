              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.12.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ekigambo kya Ruhanga kyaija ahari Shemaaya, omushaija wa Ruhanga, nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.22",
            "verseOrgIds": [
              "1KI.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gambira Rehoboamu mwene Sulemaani omugabe wa Yuda kandi n'abantu boona ab'enju ya Yuda n'eya Benyamiini, n'abandi boona, oti: ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.23",
            "verseOrgIds": [
              "1KI.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nikwo MUKAMA arikugamba naagira ati: Mutahurura, n'obu kwakuba okurwanisa beene waanyu Abaisraeli. Buri muntu agarukye omu ka ye, ahakuba ekintu eki niinye kirugireho. Batyo baahurira ekigambo kya MUKAMA, baagaruka omuka, nk'ekigambo kya MUKAMA oku kyabaire kiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.24",
            "verseOrgIds": [
              "1KI.12.24"
            ]
          }
        }
      ]
    },
