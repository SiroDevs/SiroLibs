              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Abaisraeli boona ku baahuriire ngu Yeroboamu agarukire, baamutumaho ab'okumweta ngu aije omu ishengyero, bamwemekye kuba omugabe wa Israeli yoona. Tihaabaho n'omwe owaagaruka kukuratira enju ya Daudi, kureka oruganda rwa Yuda rwonka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.20",
            "verseOrgIds": [
              "1KI.12.20"
            ]
          }
        }
      ]
