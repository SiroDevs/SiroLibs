            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.1+2CH.11.2+2CH.11.3+2CH.11.4"
              },
              "items": [
                {
                  "text": "2 Bus 11:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rehoboamu ku yaahikire Yerusaalemu, yaateeranira hamwe enju ya Yuda yoona n'oruganda rwa Benyamiini, n'abashaija emanzi abatoorainwe akasiriira n'obukumi munaana ab'okurwanisa enju ya Israeli, ngu bagarurire Rehoboamu mwene Sulemaani obugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.21",
            "verseOrgIds": [
              "1KI.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
