          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Yeroboamu yaagira omu mutima gwe ati: Nimmanya ngu hati obugabe nibwija kugaruka omu nju ya Daudi; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.26",
