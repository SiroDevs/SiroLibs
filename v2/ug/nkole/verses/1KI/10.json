          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boona ab'omu nsi bakaba beetenga kureeba Sulemaani, ngu bahurire obwengye bwe, obu Ruhanga yaamuhaire. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi weena owaabaire aija akaba areeta omutoijo, ebintu by'efeeza nari eby'ezaabu, ebijwaro, eby'okurwanisa, emigaju, embaraasi n'enyumbu; ebyo byona nikwo byabaire biija buri mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
