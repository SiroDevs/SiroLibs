                  "text": "Bir 17:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Embaraasi ezi Sulemaani yaabaire aine bakaba baziiha omuri Misri; abashuubuzi b'omugabe bakaba bazigura omu busyo, buri busyo bwine obuguzi bwabwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ekigaari kikaba kiihwa Misri ahabwa shekeli z'efeeza magana mukaaga, n'embaraasi ahari igana na makumi ataano; kandi abashuubuzi ku baabaire bazireeta, baziguza abagabe boona ab'Abahiiti n'ab'Abasiria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
