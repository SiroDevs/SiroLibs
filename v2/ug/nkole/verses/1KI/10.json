          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.27"
              },
              "items": [
                {
                  "text": "1 Bag 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi n'eigana rye'emeeri za Hiraamu, ezaabaire zireeta ezaabu za Ofira, zikareeta n'embaaho z'alumuugi nyingi munonga, n'amabaare g'obuguzi bwingi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.11",
            "verseOrgIds": [
              "1KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezo mbaaho z'alumuugi omugabe yaazibaijamu enyomyo z'enju ya MUKAMA n'eye, kandi yaazibaijamu endongo n'enanga ahabw'abeeshongozi; tihariho biti by'alumuugi ebyagarukire kureetwa nari okureebwa ebiri nk'ebyo n'okuhitsya hati.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe Sulemaani yaaha omugabekazi wa Sheeba ebi yaabaire naayenda byona, n'ebi yaashabire byona, otabariiremu bi Sulemaani yaamuhaisize obufura nk'omugabe. Bwanyima yaakuba, yaagaruka omu nsi ye n'abagaragwa be.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.14",
            "verseOrgIds": [
              "1KI.10.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.13+2CH.9.14+2CH.9.15+2CH.9.16+2CH.9.17+2CH.9.18+2CH.9.19+2CH.9.20+2CH.9.21+2CH.9.22+2CH.9.23+2CH.9.24+2CH.9.25+2CH.9.26+2CH.9.27+2CH.9.28"
              },
              "items": [
                {
                  "text": "2 Bus 9:13-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ezaabu eyaabaire ereetwa owa Sulemaani buri mwaka ekaba eba etalanta magana mukaaga na makumi mukaaga na mukaaga, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.14",
            "verseOrgIds": [
              "1KI.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "otabariiremu eyaabaire eruga omu bashuubuzi n'enshaagi ezaabaire ziruga omu batungi n'abagabe boona ba Buharabu, n'abategyeki b'omu nsi egyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe Sulemaani yaaheeshesa engabo z'ezaabu magana abiri, engabo emwe neeheeshwa omu zaabu ya shekeli magana mukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.16",
            "verseOrgIds": [
              "1KI.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.2"
              },
              "items": [
                {
                  "text": "1 Bag 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.26"
              },
              "items": [
                {
                  "text": "14:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaaheeshesa engabo nkye magana ashatu z'ezaabu; miina ishatu z'ezaabu niziheeshwamu engabo emwe; omugabe yaazita omu nu y'ekibira kya Lebanooni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaabaijesa ekibebe kihango ky'obugabe omu miino y'enjojo, yaakishweka ezaabu eshemeziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.18",
            "verseOrgIds": [
              "1KI.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kitebe ky'omugabe kikaba kiine amatembero mukaaga; kandi enyima yaakyo hariyo ekishushani ky'omutwe gw'enyana; ahari buri rubaju rw'ekyo kitebe hariho ah'okuta emikono, n'ebishushani bibiri by'entare, kimwe aha rubaju rumwe, n'ekindi aha rundi rubaju; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.19",
            "verseOrgIds": [
              "1KI.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'ebindi bishushani by'entare ikumi na bibiri byemereire bibiri bibiri ahari buri itembero ahari ago matembero mukaaga, kimwe aha rubaju rumwe rwaryo, n'ekindi aha rundi. Omu bugabe obundi bwona tihariho kitebe ekyabaire nikishushana nakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.20",
            "verseOrgIds": [
              "1KI.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
