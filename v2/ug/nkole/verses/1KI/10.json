            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwo nikwo omugabe Sulemaani yaakirize abagabe boona ab'omu nsi obutungi n'obwengye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
