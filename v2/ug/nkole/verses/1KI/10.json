            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Sulemaani akateeranira hamwe ebigaari n'abarikugyendera aha mbaraasi; ebigaari bye byaba rukumi na magana ana, n'abarikugyendera aha mbaraasi kakumi n'enkumi ibiri; yaabata omu ndembo z'ebigaari n'omuri Yerusaalemu ahu yaabaire ari. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
