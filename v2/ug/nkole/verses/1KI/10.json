          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe yaareetera Yerusaalemu okugira efeeza nyingi nk'amabaare, n'ebiti by'emyereezi byaba nk'emisikamoori y'omu mpita. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
