            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu kwezi kwa Ziivu okw'omwaka gwa kana nibwo baatandika kwombeka enju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
