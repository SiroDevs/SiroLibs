          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aharikutaaha omuri hekalu yaataho ebiti by'emiryango eby'emizeituuni eby'embaju ina ezirikwingana; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "orwigi rwaho yaarukora omu miberooshi, rwine embari ibiri; buri mbari erimu ebishate bibiri ebirikukubwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahari ezo mbari yaasharuraho ebishushani bya baakerubi, n'eby'emikindo, n'eby'ebirabyo bijanjamwire, yaazisiiga ezaabu naagiinganisa omuri ebyo bicweka bisharwire. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi orugo rw'ekibuga ky'omunda yaarwombekyesa amabaare gabaizire omu mishorongo eshatu, kandi omushorongo, gumwe guri ogw'emitambiko y'emyereezi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
      ]
