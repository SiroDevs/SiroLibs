          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi egyo nju omu kwombekwa, ekombekwa amabaare agaagyereirwe omu iteerero ryago kare; n'ahabw'ekyo hekalu ku yaabaire neeyombekwa, hakaba hatahurirwa kirikugamba kyona, enyondo nari empango n'obu kyakuba ekintu kyona ekyetwa ekyoma ky'okukoresa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
