              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo Sulemaani yaayombekire egyo nju, akagiheza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
