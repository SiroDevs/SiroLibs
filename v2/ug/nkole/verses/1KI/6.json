          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima omunda ebisiika yaabishweka embaaho z'emyereezi, okuruga ahansi okuhika aha miraba y'etandaruha; kandi ahansi yaayariraho embaaho z'emiberooshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
