            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi aha busiika by'egyo nju yaayombekyeraho ekindi kyombeko okwehinguririza ebisiika by'egyo nju, niyo hekalu n'ekishengye kyayo eky'Aharikwera munonga. Omuri ekyo kyombeko yaakoramu ebishengye okugyehinguririza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.5",
            "verseOrgIds": [
              "1KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebishengye by'ahansi obuhango bwabyo bikaba biri mikono etaano, ebya kaanyina-ibiri mikono mukaaga, n'ebya kaanyina-ishatu mikono mushanju; ahakuba okwehinguririrza emyanya y'emiraba kuhikiraho, ngu erekye kwoga omu bisiika by'enju.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        }
      ]
    },
