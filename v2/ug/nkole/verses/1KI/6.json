                "loc": "EXO.25.20"
              },
              "items": [
                {
                  "text": "Kur 25:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.37.9"
              },
              "items": [
                {
                  "text": "37:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.7"
              },
              "items": [
                {
                  "text": "1 Bag 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo bishushani yaabita omu Mwanya gurikwera ogw'omunda aha muheru. Amapapa gaabyo gakaba gashashaanwire, eipapa rya kimwe nirihika aha kisiika ky'orubaju rumwe rw'enju, n'ery'ekindi nirihika aha rundi; agandi mapapa gaabyo nigabugaabuganira ahagati. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo bishushani bya baakerubi byombi yaabishweka ezaabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
