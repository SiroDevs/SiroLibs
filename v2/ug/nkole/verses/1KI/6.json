            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eby'enju ei orikwombeka, ku origuma noogyendera omu biragiro ebi naataireho, waahikiiriza emigyenzo yangye, waayorobera ebi naaragiire byona, waabigyenderamu, obwo ndyahamya ekigambo kyangye, eki naagambiire sho Daudi; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        },
