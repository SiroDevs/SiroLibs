              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Enju ei omugabe Sulemaani yaayombekyeire MUKAMA, oburaingwa bwayo bukaba buri mikono makumi mukaaga, obukiika bwayo mikono makumi abiri, n'obwemi bwayo mikono makumi ashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekisasi eky'omu maisho ga hekali kikaba kiri mikono makumi abiri oburaingwa, nibwingana n'obukiika bwa hekalu, n'obuhango bwakyo omu maisho ga hekalu bukaba buri mikono ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egyo nju yaagibaizira amadirisa g'embaaho zirabainemu ezitarikubaasa kwihwamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.4",
            "verseOrgIds": [
              "1KI.6.4"
            ]
          }
        },
