          "type": "text",
          "attrs": {
            "verseId": "1KI.21.7",
            "verseOrgIds": [
              "1KI.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
