            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.14",
            "verseOrgIds": [
              "1KI.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yezebeeli, ku yaahuriire ngu Nabosi baamuteera amabaare, yaafa, yaagira Ahabu ati: Imuka, otware omusiri gw'emizaabibu ogu Nabosi owa Yezereeli abaire ayangire kukuguza; ahabw'okuba Nabosi yaafa, takiriho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.15",
            "verseOrgIds": [
              "1KI.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho Ahabu ku yaahuriire ngu Nabosi yaafa, yaimuka, yaashuuma omuri ogwo musiri gw'emizaabibu ogwa Nabosi owa Yezereeli kugutwara.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.16",
            "verseOrgIds": [
              "1KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
