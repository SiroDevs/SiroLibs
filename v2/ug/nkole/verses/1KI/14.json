          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.13.2+2CH.13.3+2CH.13.4+2CH.13.5+2CH.13.6+2CH.13.7+2CH.13.8+2CH.13.9+2CH.13.10+2CH.13.11+2CH.13.12+2CH.13.13+2CH.13.14+2CH.13.15+2CH.13.16+2CH.13.17+2CH.13.18+2CH.13.19+2CH.13.20"
              },
              "items": [
                {
                  "text": "2 Bus 13:2-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ebindi byona ebi Yeroboamu yaakozire, oku yaarwaine engamba, n'oku yaategyekire, reeba bihandiikirwe omu kitabo ky'eby'omu busingye bw'abagabe ba Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.19",
            "verseOrgIds": [
              "1KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka ei Yeroboamu yaamazire aha ngoma ekaba makumi abiri n'ebiri; yaagwejegyera, yaashanga baishenkuru, omutabani Nadabu yaategyeka omu mwanya gwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.20",
            "verseOrgIds": [
              "1KI.14.20"
            ]
          }
        }
