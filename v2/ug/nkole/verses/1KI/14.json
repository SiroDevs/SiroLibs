          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima omugabe Rehoboamu yaaheesesa engabo omu miringa omu mwanya gwa ziri, yaazibiitsya abakuru b'abarinzi, abaabaire nibakumiirira aha rwigi rw'enju y'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
