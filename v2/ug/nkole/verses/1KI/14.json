          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omugabe ku yaabaire ataaha omu nju ya MUKAMA, abo barinzi bakaba bazihagatira, bwanyima bazigarura omu nju y'abarinzi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
