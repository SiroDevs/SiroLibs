              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo muka Yeroboamu yaimuka, yaagyenda, yaagaruka Tiruza. Ku yaahikire ati aha muryango gw'enju, omwana yaakaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.17",
            "verseOrgIds": [
