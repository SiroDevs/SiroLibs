            "sid": "1KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli boona baamuziika, baamucurira nk'ekigambo kya MUKAMA eki yaarabize omu mwiru we nabi Ahiya oku kyabaire kiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.18",
            "verseOrgIds": [
              "1KI.14.18"
            ]
          }
        },
