              "type": "text"
            }
          ]
        },
        {
          "text": " Ekyabaire kiriho iranaire, eki twahuriire, eki twareebire n'amaisho gaitu, eki twayetegyereize kandi tukakwataho n'engaro zaitu, ekya kigambo ow'amagara ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
