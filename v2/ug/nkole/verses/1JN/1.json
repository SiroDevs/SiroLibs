            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi nitubahandiikira ebyo ngu okushemererwa kwaitu kube okuhikire.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
