              },
              "items": [
                {
                  "text": "Yoh 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (kandi amagara ago gakoorekwa, twagareeba, twagahamua, kandi nitubagambira amagara ago agatahwaho agaabaire gari na Isheboona gakatworekwa) ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "eki twareebire kandi eki twahuriire, nikyo turikubagambira ngu naimwe mukwatainse naitwe; kandi naitwe tukwataniise na isheboona n'Omwana we Yesu Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.3",
            "verseOrgIds": [
              "1JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
