                "loc": "JHN.1.12"
              },
              "items": [
                {
                  "text": "Yoh 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mureebe okukunda oku Isheboona yaatukunzire oku kuri, itwe okwetwa abaana ba Ruhanga; kandi nikwo turi. Nikyo ensi etatumanyira, ahakuba teramumanyire. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.1",
            "verseOrgIds": [
              "1JN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.21"
              },
              "items": [
                {
                  "text": "Fil 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abarikukundwa, hati turi abaana ba Ruhanga; oku turiba, tikukamanyirwe; kwonka nitumanya, ngu ku arishuuruurwa, turyashushana nawe, ahabw'okuba turyamureeba nk'oku ari. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.2",
            "verseOrgIds": [
              "1JN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omuntu weena omwineho amatsiko ago, ayeshemeze nka We oku ari oshemeire.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.3",
            "verseOrgIds": [
              "1JN.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.3",
            "verseOrgIds": [
              "1JN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu weena okora ekibi akora eby'obugomi; kandi ekibi nibwo bugomi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.4",
            "verseOrgIds": [
              "1JN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.24"
              },
              "items": [
                {
                  "text": "1 Pet 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimumanya ngu Ogwo akoorekwa kwihaho ebibi, kandi omuriwe tiharimu kibi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.5",
            "verseOrgIds": [
              "1JN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.14"
              },
              "items": [
                {
                  "text": "Rom 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Weena oguma omuriwe tashiisha; weena oshiishs takamureebaga, n'obu kwakuba okumumanya. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.6",
            "verseOrgIds": [
              "1JN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe abaana bato, hatagira omuntu weena owaabahabya. Okora eby'okuhikiirira niwe ahikiriire, nka We oku ahikiriire. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.7",
            "verseOrgIds": [
              "1JN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.44"
              },
              "items": [
                {
                  "text": "Yoh 8:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okora ekibi n'owa Sitaane; ahakuba okwiha iranaira Sitaane ashiisha. Nikyo Omwana wa Ruhanga yaayorekyeirwe kuhwerekyereza emirimo ya Sitaane. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.8",
            "verseOrgIds": [
              "1JN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.18"
              },
              "items": [
                {
                  "text": "1 Yoh 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Weena ozairwe Ruhanga takora kibi; ahabw'okuba embibo ye eguma omuriwe; kandi tabaasa kukora kibi, ahakuba akazaarwa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.9",
            "verseOrgIds": [
              "1JN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo nikyo kimanyisa abaana ba Ruhanga n'abaana ba Sitaane; weena otakora eby'okuhikiirira ti wa Ruhanga, n'obu yaakuba otakunda mwene ishe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.10",
            "verseOrgIds": [
              "1JN.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.10",
            "verseOrgIds": [
              "1JN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1JN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.11",
            "verseOrgIds": [
              "1JN.3.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.34"
              },
              "items": [
                {
                  "text": "Yoh 13:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba obu nibwo butumwa obu mwahuriire okwiha iranaira, ngu tukundane, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.11",
            "verseOrgIds": [
              "1JN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.8"
              },
              "items": [
                {
                  "text": "Kut 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " turekye kuba nka Kaini owaabaire ari ow'Omubi, akaita omurumuna. Mbwenu akamwitira ki? ahabw'okuba emicwe ye ekaba eri mibi, kandi ey'omurumuna ekaba eri ey'ohikiriire. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.12",
            "verseOrgIds": [
              "1JN.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.18"
              },
              "items": [
                {
                  "text": "Yoh 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " B'eishe-emwe, mutatangaara ngu ensi neebanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.13",
            "verseOrgIds": [
              "1JN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.24"
              },
              "items": [
                {
                  "text": "Yoh 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Itwe nitumanya ngu tukaruga omu kufa, twataaha omu magara, ahabw'okuba tukunda ab'eishe-emwe. Otaine rukundo aguma omu kufa. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.14",
            "verseOrgIds": [
              "1JN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.21"
              },
              "items": [
                {
                  "text": "Mat 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Weeana orikwanga mwene ishe n'omwitsi; kandi nimumanya ngu tihariho mwitsi oine amagara agatahwaho omuriwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.15",
            "verseOrgIds": [
              "1JN.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.13"
              },
              "items": [
                {
                  "text": "Yoh 15:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha niho tumanyira rukundo, ahakuba Yesu akahayo amagara ge ahabwaitu; naitwe tushemereire kuhayo amagara gatu ahabwa beene waitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.16",
            "verseOrgIds": [
              "1JN.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.7"
              },
              "items": [
                {
                  "text": "Bir 15:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu omuntu weena otungire ebintu by'ensi egi, ku yaakureeba mugyenzi we abikyenire, yaamwehuzya, okukunda kwa Ruhanga kukaaguma kuta omuriwe? ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.17",
            "verseOrgIds": [
              "1JN.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.15"
              },
              "items": [
                {
                  "text": "Yak 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baana bato, turekye kukundana omu bigambo nari aha rurimi, kureka tukundane omu bi turikukora n'omu mazima.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.18",
            "verseOrgIds": [
              "1JN.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
