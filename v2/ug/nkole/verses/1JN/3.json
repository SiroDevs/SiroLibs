          ]
        },
        {
          "text": " kandi eki tushaba kyona akituha, ahakuba tworobera ebiragiro bye, kandi tukora ebishemeire omu maisho ge. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.22",
