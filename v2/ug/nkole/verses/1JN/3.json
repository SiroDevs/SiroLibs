          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarikukundwa, emitima yaitu ku eraabe etarikutushinja, twine obumanzi omu maisho ga Ruhanga; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.21",
            "verseOrgIds": [
              "1JN.3.21"
            ]
          }
