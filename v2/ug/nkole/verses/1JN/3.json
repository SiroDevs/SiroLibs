              "type": "text"
            }
          ]
        },
        {
          "text": "Aha niho turikumanyira ko turi ab'amazima, tukagarukwamu emitima omu maisho ge, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.19",
            "verseOrgIds": [
              "1JN.3.19"
            ]
          }
        },
