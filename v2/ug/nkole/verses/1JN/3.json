          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuri byona ebi etushinja; ahakuba Ruhanga ni mukuru okukira emitima yaitu, kandi naamanya byona. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.20",
            "verseOrgIds": [
              "1JN.3.20"
            ]
          }
        },
