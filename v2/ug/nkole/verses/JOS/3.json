      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.13",
            "verseOrgIds": [
              "JOS.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo abantu baaruga omu mahema gaabo kwambuka Yorudani, beebembeirwe abanyamurwa abaheekire eshanduukye y'endagaano; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.14",
            "verseOrgIds": [
              "JOS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.12.15"
              },
              "items": [
                {
                  "text": "1 Bus 12:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ababaire bagiheekire, ku baahikire ahari Yorudani, baahitsya ebigyere byabo omu maizi, (omu igyesha amaizi ga Yorudani gaijura, garengyera aha nkungu zaayo zoona) ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.15",
            "verseOrgIds": [
              "JOS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "amaizi agaabaire nigashuuma, nigaruga eruguru, gaayemerera, gaayerunda hamwe hare munonga aha rurembo orurikwetwa Adamu aha rubaju rwa Zaretaani, n'agaabaire nigashuuma omu nyanja ya Araba, niyo Nyanja y'omwonyo, gaahweraho kimwe; abantu baayambuka bagyemire Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.16",
            "verseOrgIds": [
              "JOS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.29"
              },
              "items": [
                {
                  "text": "Kur 14:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abanyamurwa, abaabaire baheekire eshanduukye y'endagaano eya MUKAMA, baayemerera ahoomire batarikuterera ahagati ya Yorudani; n'Abaisraeli boona baayambukira ahoomire, okuhitsya obu eihanga ryona ryaherize kwambuka Yorudani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.17",
            "verseOrgIds": [
              "JOS.3.17"
            ]
          }
        }
      ]
