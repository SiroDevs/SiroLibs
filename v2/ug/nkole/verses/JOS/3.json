                "loc": "1CH.29.25"
              },
              "items": [
                {
                  "text": "1 Bus 29:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagambira Yoshua ati: Eri izooba niinyija kutandika kukuha ekitiinisa omu maisho g'Abaisraeli boona, bamanye ngu nk'oku naabaire ndi na Musa, nikwo ndikwija kuba naiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.7",
            "verseOrgIds": [
              "JOS.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noija kuragiira abanyamurwa abaheekire eshanduukye y'endagaano oti: Ku muraahikye aha nkungu y'amaizi ga Yorudani, muragaremu, mwemerere. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.8",
            "verseOrgIds": [
              "JOS.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua yaagambira Abaisraeli ati: Muhikye aha, muhurire ebigambo bya MUKAMA Ruhanga waanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.9",
            "verseOrgIds": [
              "JOS.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.1.10"
              },
              "items": [
                {
                  "text": "Hos 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.1.9"
              },
              "items": [
                {
                  "text": "1 Tes 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.2"
              },
              "items": [
                {
                  "text": "Kur 33:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoshua yaagira ati: Eki nikyo muraamanyireho ku Ruhanga otahwaho ari omuriimwe kandi ku atariremwa kubinga Abanyakanaani omu maisho ganyu, Abahiiti, Abahiivi, Abaperizi, Abagirugashi, Abaamori n'Abayebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.10",
            "verseOrgIds": [
              "JOS.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.24.1"
              },
              "items": [
                {
                  "text": "Zab 24:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.13"
              },
              "items": [
                {
                  "text": "Mik 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, eshanduukye y'endagaano ya MUKAMA ow'ensi yoona neija kubabandiza kuza omuri Yorudani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.11",
            "verseOrgIds": [
              "JOS.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu mutoorane abantu ikumi na babiri omu nganda za Israeli, omuri buri ruganda mwihemu omuntu omwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.12",
            "verseOrgIds": [
              "JOS.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.8"
              },
              "items": [
                {
                  "text": "Kur 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.114.3"
              },
              "items": [
                {
                  "text": "Zab 114:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebigyere by'abanyamurwa abaheekire eshanduukye y'endagaano ya MUKAMA, Mukama ow'ensi yoona, ku biraahikye omu maizi ga Yorudani, amaizi ago agarikushuuma nigaruga eruguru nigaija kuzibirwa kugyenda, geemerere geerunzire hamwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.13",
            "verseOrgIds": [
              "JOS.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
