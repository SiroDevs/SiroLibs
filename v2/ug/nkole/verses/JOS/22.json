            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehaasi omunyamurwa n'abakuru b'eihanga, nibo bakuru b'emiryango y'Abaisraeli abu yaabaire aine, ku baahuriire ebigambo by'Abareubeeni n'Abagaadi n'Abamanaase, baashemererwa munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.14.25"
              },
              "items": [
                {
                  "text": "1 Kor 14:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Finehaasi mwene Eleazaari omunyamurwa yaagambira Abareubeeni n'Abagaadi n'Abamanaase ati: Mbwenu eri izooba nibwo twamanya ku MUKAMA ari omuriitwe, ahakuba timurakozire kicumuro eki ahari MUKAMA; mbwenu mwakiza Abaisraeli okutaitwa mukono gwa MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Finehaasi mwene Eleazaari omunyamurwa n'abakuru baaruga omu nsi ya Gileadi; ei baashangire Abareubeeni n'Abagaadi, baagaruka omu nsi ya Kanaani aha Baisraeli, baabagambira ebyabaireho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kyashemeza Abaisraeli, baahimbisa Ruhanga, tibaagaruka kugamba by'okurwanisa Abareubeeni n'Abagaadi, n'okucwekyereza ensi ei batwiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.27"
              },
              "items": [
                {
                  "text": "Yos 24:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi eryo itambiro Abareubeeni n'Abagaadi baaryeta Edi; amakuru gaakyo, ngu eky'okuhamya ahagati yaitu naimwe ku MUKAMA ari Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
          }
        }
      ]
