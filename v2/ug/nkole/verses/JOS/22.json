              },
              "items": [
                {
                  "text": "Heb 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA Ruhanga Nyamuhanga! MUKAMA Ruhanga Nyamuhanga niwe arikukimanya, kandi n'Abaisraeli baryakimanya. Ku turaabe twakikozire ahabw'obugomi nari ahabw'okucumura ahari MUKAMA, eri izooba tutakira! ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.7.3"
              },
              "items": [
                {
                  "text": "Zab 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.7.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku turaabe twayekoreire eitambiro ngu tuteishukye, turekye kukuratira MUKAMA, nari ngu tutambireho ebitambo ebyokize, nari empongano z'eby'okurya, nari ez'okusiima ahabw'obusingye, MUKAMA wenka abe niwe yaabitutura; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kureka tukikozire twine eki tukikoreire, ngu omu biro ebiriija abaana baanyu bataribuuza abaitu bati: Mwine kakwate ki na MUKAMA Ruhanga wa Israeli? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.24",
            "verseOrgIds": [
              "JOS.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timurikumanya ngu MUKAMA akataho Yorudani kuba omwatano gwaitu naimwe, imwe Abareubeeni n'Abagaadi? Timwine mugabo ahari MUKAMA. N'ahabw'ekyo abaana baanyu baryazibira abaitu kutiina MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo kyatureeteire kugira tuti: Ka twekorere eitambiro, eritari ry'okutambiraho ebitambo ebyokize nari ebindi bitambo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.26",
            "verseOrgIds": [
              "JOS.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.31.48"
              },
              "items": [
                {
                  "text": "Kut 31:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.27"
              },
              "items": [
                {
                  "text": "Yos 24:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka ribe eky'okuhamya ahagati yaitu naimwe, na baijukuru baitu abaritukurata, ku turi abantu abakora omurimo gwa MUKAMA nitutambira ebitambo ebyokize omu maisho ge n'ebindi bitambo n'empongano z'okusiima ahabw'obusingye, abaana baanyu nyentsya batarigira abaitu omu biro ebiriija bati: Timwine mugabo ahari MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo twagiriire tuti: Ku baritugira batyo, nari baagira kwo baijukuru baitu omu biro ebiriija, itwe turyabagarukamu tuti: Reeba eitambiro eri tukozire, eririkushushana n'eitambiro eri baatatenkuriitwe baakozire, eritari ry'ebitambo ebyokize nari ebindi bitambo, kureka ery'okuhamya ahagati yaitu naimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.28",
            "verseOrgIds": [
              "JOS.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.13"
              },
              "items": [
                {
                  "text": "Bir 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikikabure itwe okugomera MUKAMA eri izooba, tukateishuka, tukareka kumukuratira, tukeekorera eitambiro ry'okwokyezaho ebitambo, nari ery'okuhongyeraho empongano z'eby'okurya, nari ebindi bitambo, ritari itambiro rya MUKAMA Ruhanga waitu eriri omu maisho g'eihema rye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
