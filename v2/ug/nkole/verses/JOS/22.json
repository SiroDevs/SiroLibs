                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.47"
              },
              "items": [
                {
                  "text": "Dan 2:47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.39"
              },
              "items": [
                {
                  "text": "1 Bag 8:39",
