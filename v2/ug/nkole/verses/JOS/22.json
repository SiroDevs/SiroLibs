          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abareubeeni n'Abagaadi n'ekicweka ky'oruganda rwa Manaase baagarukamu nibagambira abakuru b'enganda za Israeli bati: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.21",
            "verseOrgIds": [
              "JOS.22.21"
            ]
          }
        },
        {
