            "sid": "JOS 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Yoshua yaayeta Abareubeeni n'Abagaadi n'ekicweka ky'oruganda rwa Manaase, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.1",
            "verseOrgIds": [
              "JOS.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.20"
              },
              "items": [
                {
                  "text": "Kub 32:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaabagira ati: Mukozire byona ebi Musa omugaragwa wa MUKAMA yaabaragiire; kandi omuri byona ebi naabaragiire, mukanyorobera. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro ebi ebingi ebi mumazire, timukahemukaga ahari beene waanyu n'okuhitsya hati, kureka mworobeire ekiragiro eki MUKAMA Ruhanga waanyu yaabaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Kub 32:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.8"
              },
              "items": [
                {
                  "text": "Bir 29:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu hati MUKAMA Ruhanga waanyu ahuumwize beene waanyu, nk'oku yaabaraganiise; n'ahabw'ekyo mugarukyeyo, muze omu maka gaanyu omu nsi y'obutaka bwanyu ei Musa omugaragwa wa MUKAMA yaabahaire seeri ya Yorudani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.22"
              },
              "items": [
                {
                  "text": "Bir 11:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.36"
              },
              "items": [
                {
                  "text": "Mat 22:36",
