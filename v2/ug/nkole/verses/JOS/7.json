                "loc": "NUM.14.5"
              },
              "items": [
                {
                  "text": "Kub 14:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.9.3+EZR.9.4+EZR.9.5"
              },
              "items": [
                {
                  "text": "Ezr 9:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.12"
              },
              "items": [
                {
                  "text": "1 Sam 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoshua ku yaakihuriire, yaataagura eby'okujwara bye, yaagwa ahansi, yaajuumara omu maisho ge'shanduukye ya MUKAMA okuhitsya omu mwabazyo, we n'abakuru b'Abaisraeli; baayeshuka eiju omu mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.6",
            "verseOrgIds": [
              "JOS.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.5.22"
              },
              "items": [
                {
                  "text": "Kur 5:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoshua nikwo kugira ati: Ai bambe, MUKAMA Ruhanga! aba bantu okabambukiza ki Yorudani okutuhayo omu mikono y'Abaamori kutuhwerekyereza? Haakiri kuri twagumire seeri ya Yorudani! ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.7",
            "verseOrgIds": [
              "JOS.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai MUKAMA, mbwenu ngambe ki, obu Abaisraeli baateire abazigu baabo amabega! ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.8",
            "verseOrgIds": [
              "JOS.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.4"
              },
              "items": [
                {
                  "text": "Zab 83:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.13"
              },
              "items": [
                {
                  "text": "Kub 14:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba Abanyakanaani n'abatwire omu nsi egi nibaija kukihurira, batukubire ahagati, bamare eiziina ryaitu omu nsi. Mbwenu oryakora ki ahabw'eiziina ryawe erikuru?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.9",
            "verseOrgIds": [
              "JOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.9",
            "verseOrgIds": [
              "JOS.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Yoshua ati: Imuka! N'enki ekikujuumaize ahansi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.10",
            "verseOrgIds": [
              "JOS.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli bacumwire, baita endagaano yangye, ei naabahaire; baatwara aha bibiikirwe, baiba, kandi baaryaraya, baabita omu bintu byabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.11",
            "verseOrgIds": [
              "JOS.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.45"
              },
              "items": [
                {
                  "text": "Kub 14:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.14"
              },
              "items": [
                {
                  "text": "Bar 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo Abaisraeli batarikubaasiza kusyamirana n'abazigu baabo; nibabahunga ahabw'okuba bahindukire abakyeenirwe. Kandi tindiguma naimwe bundi, kureka biri mwahwerekyereza ebibiikiirwe MUKAMA ebiri omuriimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.12",
            "verseOrgIds": [
              "JOS.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.3.5"
              },
              "items": [
                {
                  "text": "Yos 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imuka, oyeze abantu, kandi obagire oti; Mweyeze ahabw'eizooba rya nyencakare; ahakuba MUKAMA Ruhanga wa Israeli naagira ati: Imwe Baisraeli 'mwe, omuriimwe harimu ebibiikiirwe MUKAMA; timurikubaasa kusyamirana n'abazigu baanyu, okuhitsya obu muraihe omuriimwe ebibiikirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.13",
            "verseOrgIds": [
              "JOS.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.19+1SA.10.20+1SA.10.21"
              },
              "items": [
                {
                  "text": "1 Sam 10:19-21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.33"
              },
              "items": [
                {
                  "text": "Enf 16:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.24+ACT.1.25+ACT.1.26"
              },
              "items": [
                {
                  "text": "Byak 1:24-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo omu kasheeshe nimwija kureetwa haihi omu nganda zaanyu; kandi oruganda oru MUKAMA araatoorane nirwija kwija nk'emiryango yaarwo oku eri; kandi omuryango ogu MUKAMA araatoorane nigwija kwija nk'amaju gaagwo oku gari; kandi enju ei MUKAMA araatoorane hagume nihaija omuntu omwe-omwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.7"
              },
              "items": [
                {
                  "text": "Kut 34:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oraakwatwe aine ebintu ebibiikirwe naija kwokibwa n'ebi aine byona; ahakuba aitsire endagaano ya MUKAMA, yaakora ekirikuhemura omu Baisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.15",
            "verseOrgIds": [
              "JOS.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.15",
            "verseOrgIds": [
              "JOS.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua yaaguruka kare omu kasheeshe, yaateeranira hamwe Abaisraeli omu nganda zaabo; oruganda rwa Yuda rwatooranwa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.16",
            "verseOrgIds": [
              "JOS.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "yairiza haihi emiryango ya Yuda, haatooranwamu omuryango gwa Zeera; yairiza haihi ab'enju ya Zeera omwe-omwe, Zabudi yaatooranwa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.17",
            "verseOrgIds": [
              "JOS.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
