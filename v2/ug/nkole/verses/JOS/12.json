      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nibo bagabe b'ensi, abu Abaisraeli baitsire, bakakubuura ensi yaabo seeri ya Yorudani aha rubaju rw'oburugwa-izooba, okuruga omu ruhanga rwa Arunooni, okuhika aha rushozi Herumooni, na Araba yoona ey'oburugwa-izooba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.1",
            "verseOrgIds": [
              "JOS.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihooni omugabe w'Abaamori, owaabaire atwire Heshibooni, naategyeka okuruga Aroeri aha rubaju rw'oruhanga rwa Arunooni n'ahagati omu ruhita, n'ekicweka kya Gileadi okuhitsya aha mugyera Yaboki, omu mwatano gw'Abaamoni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.2",
            "verseOrgIds": [
              "JOS.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi okuruga Araba okuhitsya aha rubaju rw'oburugwa-izooba bw'enyanja Kineroosi n'aha muhanda ogurikuza Besi-yeshimoosi oburugwa-izooba bw'enyanja ya Araba, Enyanja y'omwonyo; kandi aha bukiizi-bwa-buryo okuhika ahansi y'akashuumo k'orushozi Pisiga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.3",
            "verseOrgIds": [
              "JOS.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi na Ogi omugabe wa Bashani, omwe aha baatsigaireho omu Bareefa, owaabaire atwire Ashitaroosi na Edurei, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.4",
            "verseOrgIds": [
              "JOS.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "naategyeka orushozi Herumooni, na Saleka, na Bashani yoona okuhika aha mwatano gw'aba Geshuri n'aba Maaka, n'ekicweka kya Gileadi okuhika aha mwatano gwa Sihooni omugabe wa Heshibooni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.5",
            "verseOrgIds": [
              "JOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nibo Musa omugaragwa wa MUKAMA n'Abaisraeli baitsire; kandi ensi yaabo Musa akagiha Abareubeeni n'Abagaadi n'ekicweka ky'oruganda rwa Manaase kuba eyaabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
