                "loc": "1TI.5.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " baabagambirira Shiilo omu nsi ya Kanaani, bati: MUKAMA akaragiira Musa ku tuheebwa endembo z'okutuuramu n'amariisizo gaazo ahabw'amatungo gaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.2",
            "verseOrgIds": [
              "JOS.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli nikwo kuha Abaleevi endembo n'amariisizo gaazo ahari ezo ezi baahungwire, nk'oku MUKAMA yaaragiire.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.3",
            "verseOrgIds": [
              "JOS.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.3",
            "verseOrgIds": [
              "JOS.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enteenyu yaakwata ab'emiryango y'aba Kohasi; Abaleevi baijukuru ba Arooni omunyamurwa bo baakwatwa enteenyu, baaheebwa endembo ikumi na ishatu omu ruganda rwa Yuda, n'omu rwa Simeoni n'omu rwa Benyamiini. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.4",
            "verseOrgIds": [
              "JOS.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru ba Kohasi abaatsigaire batahairwe, enteenyu yaabakwata, baaheebwa endembo ikumi omu ruganda rwa Efuraimu n'omu rwa Daani n'omu kicweka ky'orwa Manaase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.5",
            "verseOrgIds": [
              "JOS.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enteenyu yaakwata baijukuru ba Gereshoni, baaheebwa endembo ikumi na ishatu omu miryango y'oruganda rwa Isakaari, n'omu rwa Asheri, n'omu rwa Nafutaali, n'omu kicweka ky'orwa Manaase omuri Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.6",
            "verseOrgIds": [
              "JOS.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi na baijukuru ba Merari, nk'oku emiryango yaabo yaabaire eri, baheebwa endembo ikumi na ibiri omu ruganda rwa Reubeeni, n'omu rwa Gaadi, n'omu rwa Zebuluuni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.7",
            "verseOrgIds": [
              "JOS.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo Abaisraeli baahaire Abaleevi ezo ndembo n'amariisizo gaazo nibateera enteenyu, nk'oku MUKAMA yaaragiire Musa ku baziheebwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.8",
            "verseOrgIds": [
              "JOS.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
