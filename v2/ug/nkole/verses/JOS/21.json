              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima abakuru b'emiryango y'oruganda rwa Leevi baija ahari Eleazaari omunyamurwa na Yoshua mwene Nuuni n'abakuru b'emiryango y'enganda za Israeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.1",
            "verseOrgIds": [
              "JOS.21.1"
            ]
          }
        },
        {
