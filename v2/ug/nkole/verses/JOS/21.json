            "sid": "JOS 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.8",
            "verseOrgIds": [
              "JOS.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu ndembo z'oruganda rwa Yuda n'orwa Simeoni baabaha endembo ezi, ezi amaziina gaazo garikugambwaho ahaifo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.9",
            "verseOrgIds": [
              "JOS.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haabanza beene Arooni, ow'omu miryango y'aba Kohasi, ab'omuri baijukuru ba Leevi; ahabw'okuba omugabo gw'okubanza gukaba guri ogwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.10",
            "verseOrgIds": [
              "JOS.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.2"
              },
              "items": [
                {
                  "text": "Kut 23:2",
