              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo MUKAMA yaahaire Abaisraeli ensi yoona ei yaarahiire kuha baishenkurubo; batyo baagikubuura, baagituuramu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
