    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyanga eki oruganda rw'Abayuda baabagaine, nk'oku emiryango yaabo yaabaire eri, kikaba nikihika aha mwatano gwa Edomu, omu ihamba rya Ziini aha bukiizi-bwa-buryo, okuhikira kimwe aha muheru gw'orubaju orwo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.1",
            "verseOrgIds": [
              "JOS.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi omwatano gwabo ogw'aha bukiizi-bwa-buryo gukaba niguruga aha muheru gw'Enyanja y'omwonyo, aha mukono gw'enyanja ogurikureeba aha bukiizi-bwa-buryo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.2",
            "verseOrgIds": [
              "JOS.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "gwogamu guhika aha bukizi-bwa-buryo aharikwinamuka Akarabiimu, gugumizamu guhika Ziini, gwinamuka aha bukiizi-bwa-buryo bwa Kadeshi-barunea, guraba haihi na Hezirooni, gwinamuka guhika Adari, gukiikama guhika Karaka; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.3",
            "verseOrgIds": [
              "JOS.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuruga aho gugumizamu guhika Azimooni, gwogamu, gushuuma n'akagyera ka Misri, gugarukira aha nyanja; ogwo nigwo guriba omwatano gwanyu aha bukiizi-bwa-buryo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.4",
            "verseOrgIds": [
              "JOS.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omwatano gwabo ogw'oburugwa-izooba gukaba guri Enyanja y'omwonyo okuhika ahu Yorudani egishukiramu. Kandi omwatano ogw'orubaju rw'obukiizi-bwa-bumosho guruga aha mukono gw'enyanja ahu Yorudani erikugishukiramu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "omwatano ogwo gwinamuka guhika Besi-hogola, guraba aha bukiizi-bwa-bumosho bwa Besaraba; gugumizamu guhika aha ibaare rya Bohani mwene Reubeeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.6",
            "verseOrgIds": [
              "JOS.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi gugumizamu niguruga omu ruhanga rwa Akori, guhika Debira, gutyo gutoora aha bukiizi-bwa-bumosho, nigureeba Gilugaali ahateegaine n'aharikwinamuka Adumimu, eri aha bukiizi-bwa-buryo obw'oruhanga; ogwo mwatano gugumizamu guraba aha maizi ga Enishemeshi, gugarukira Eni-rogeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.7",
            "verseOrgIds": [
              "JOS.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuruga aho omwatano gwinamuka, guraba omu ruhanga rwa mwene Hinoomu oruri aha bukiizi-bwa-buryo bw'ensi y'Abayebusi, (niyo Yerusaalemu); gwinamuka guhika aha mutwe gw'ekibungo ekiri omu maisho g'oruhanga rwa Hinoomu orubaju rw'oburengyerwa-izooba, kandi ekiri aha muheru gw'oruhanga rw'Abareefa aha bukiizi-bwa-bumosho; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.8",
            "verseOrgIds": [
              "JOS.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima omwatano guruga aha mutwe gw'ekyo kibungo okuhika aha nshuro y'amaizi ga Nefutoa, gwogamu guhika aha ndembo z'aha kibungo kya Efurooni; guhika Baala, niyo Kiryasi-yearimu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.9",
            "verseOrgIds": [
              "JOS.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuruga Baala omwatano gukiikama gutoora oburengyerwa-izooba, guhika aha kibungo Seiri, guraba aha rubaju rw'ekibungo Yearimu aha bukiizi-bwa-bumosho, niyo Kesalooni; gushuuma guhika Beti-shemeshi, gwogamu guraba aha rubaju rwa Timuna; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.10",
            "verseOrgIds": [
              "JOS.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "gugumizamu guhika aha rubaju rwa Ekurooni aha bukiizi-bwa-bumosho; guhika Shikerooni, gwogamu guhika aha kibungo Baala, gugumizamu guhika Yabuneeli; gugarukira aha nyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.11",
            "verseOrgIds": [
              "JOS.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'omwatano ogw'oburengyerwa-izooba gukaba guri Enyanja empango. Ogwo nigwo mwatano gw'Abayuda nk'oku emiryango yaabo yaabaire eri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.12",
            "verseOrgIds": [
              "JOS.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
