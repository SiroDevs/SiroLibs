              "items": [
                {
                  "text": "Luk 21:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku mwatungire ebirungi byona ebi MUKAMA Ruhanga waanyu yaabagambiire, nikwo MUKAMA aribareetaho ebibi byona, okuhitsya obu aribahwerekyerereza omu nsi egi enungi ei MUKAMA Ruhanga waanyu yaabahaire, akabamaraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku muricumura, mwaita endagaano ei MUKAMA Ruhanga waanyu yaabahaire, mwagyenda, mwaheereza baaruhanga abandi, mwabaramya, MUKAMA aryabagirira ekiniga kingi, muhwerekyererere juba omu nsi enungi ei MUKAMA Ruhanga waanyu yaabahaire, muhweho.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        }
