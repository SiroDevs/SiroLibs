          "attrs": {
            "verseId": "JOS.19.1",
            "verseOrgIds": [
              "JOS.19.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.7"
              },
              "items": [
                {
                  "text": "Kut 49:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabo gwa kabiri gwaija guri ogwa Simeoni, nirwo ruganda rw'Abasimeoni nk'oku emiryango yaabo yaabaire eri; ekyanga ky'obuhunguzi bwabo kikaba kiri ahagati y'eky'obuhunguzi bw'Abayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.1",
            "verseOrgIds": [
              "JOS.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endembo ezi baahairwe kuba obuhunguzi bwabo nizo ezi; Beeri-sheba nari Sheba, Molada, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.2",
            "verseOrgIds": [
              "JOS.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazari-shuali, Baala, Ezeemu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.3",
            "verseOrgIds": [
              "JOS.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elitolaadi, Besuula, Horuma, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.4",
            "verseOrgIds": [
              "JOS.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikulaagi, Besi-marikaboosi, Hazaari-suusa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.5",
            "verseOrgIds": [
              "JOS.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besi-lebaosi, na Sharuheni; endembo ikumi na ishatu n'ebirorero byazo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.6",
            "verseOrgIds": [
              "JOS.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aini, Rimona, Eteeri, na Ashani; endembo ina n'ebirorero byazo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.7",
            "verseOrgIds": [
              "JOS.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ebirorero byona ebyahinguririize ezo ndembo okuhika Baalasibeero, niyo Raama y'obukiizi-bwa-buryo. Obwo nibwo buhunguzi bw'oruganda rwa Simeoni, nk'oku emiryango yaabo yaabaire eri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.8",
            "verseOrgIds": [
              "JOS.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuhunguzi bw'Abasimeoni bukaihwa omu bw'Abayuda, ahakuba ekyanga ky'Abayuda kikaba kiri kihango munonga, nikibakira; nikyo kyareeteire oruganda rwa Simeoni kuheebwa obuhunguzi ahagati y'obw'Abayuda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.9",
            "verseOrgIds": [
              "JOS.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.9",
            "verseOrgIds": [
              "JOS.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabo gwa kashatu gwaija, guri ogw'oruganda rwa Zebuluuni, nk'oku emiryango yaabo yaabaire eri. Omwatano gw'obuhunguzi bwabo gukaba guhika Sarida; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.10",
            "verseOrgIds": [
              "JOS.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "gwinamuka gutoora oburengyerwa-izooba, guhika Marala na Dabesheesi; gugumizamu guhika aha kagyera akari omu maisho ga Yokineamu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.11",
            "verseOrgIds": [
              "JOS.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuruga Sarida gukiikama gutoora oburugwa-izooba, guhika aha mwatano gwa Kisiloosi-tabora; guruga aho, guhika Daberaasi, gwinamuka guhika Yafia; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.12",
            "verseOrgIds": [
              "JOS.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "guruga aho guraba aha rubaju rw'oburugwa-izooba, guhika Gaasi-heferi na Eti-kaziini, gwogamu guhika Rimoni, gutoora Nea; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.13",
            "verseOrgIds": [
              "JOS.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "aha bukiizi-bwa-bumosho gukiikama gutoora Hanatooni, gugarukira omu ruhanga rwa Ifusaheeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.14",
            "verseOrgIds": [
              "JOS.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi baheebwa Kataasi, Nahalaali, Shimirooni, Idala na Betelehemu; endembo ikumi na ibiri n'ebirorero byazo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.15",
            "verseOrgIds": [
              "JOS.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo nibwo buhunguzi bw'Abazebuluuni, nizo ndembo n'ebirorero byazo, nk'oku emiryango yaabo yaabaire eri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.16",
            "verseOrgIds": [
              "JOS.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.16",
            "verseOrgIds": [
              "JOS.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabo gwa kana gwaija guri ogwa Isakaari, nirwo ruganda rw'Abaisakaari, nk'oku emiryango yaabo yaabaire eri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.17",
            "verseOrgIds": [
              "JOS.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyanga kyabo kikaba kirimu endembo ezi; Yezereeli, Kesuloosi, Shuneemu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.18",
            "verseOrgIds": [
              "JOS.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafaraimu, Shioni, Anaharaasi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.19",
            "verseOrgIds": [
              "JOS.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabisi, Kishioni, Ebeza, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.20",
            "verseOrgIds": [
              "JOS.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remesi, Eni-ganimu, Eni-haada, na Besi-pazezi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.21",
            "verseOrgIds": [
              "JOS.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi omwatano guhika Tabora, Shahazuma, na Beti-shemeshi, gugarukira Yorudani; endembo ikumi na mukaaga n'ebirorero byazo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.22",
            "verseOrgIds": [
              "JOS.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo nibwo buhunguzi bw'oruganda rwa Isakaari, n'endembo zaabo n'ebirorero byazo, nk'oku emiryango yaabo yaabaire eri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.23",
            "verseOrgIds": [
              "JOS.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.23",
            "verseOrgIds": [
              "JOS.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabo gwa kataano gwaija guri ogw'oruganda rwa Asheri, nk'oku emiryango yaabo yaabaire eri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.24",
            "verseOrgIds": [
              "JOS.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyanga kyabo kikaba kirimu endembo ezi; Helukaasi, Haali, Beeteni, Akisaafu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.25",
            "verseOrgIds": [
              "JOS.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alameleki, Amadi, na Mishaali; kandi aha burengyerwa-izooba, omwatano guhika Karumeeli na Shihori-libunaasi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.26",
            "verseOrgIds": [
              "JOS.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "gukiikama gutoora oburugwa-izooba, guhika Besi-dagoni, gugumizamu guhika Zebuluuni, n'omu ruhanga rwa Ifusaheeli aha rubaju rw'obukiizi-bwa-bumosho, guhika Besi-emeki, na Neyeli; gugarukira Kaabuli aha rubaju rwa bumosho, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.27",
            "verseOrgIds": [
              "JOS.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Eburooni, Rehobu, Hamoni na Kaana, n'okuhika Sidoni empango; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.28",
            "verseOrgIds": [
              "JOS.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima gukiikama gutoora Raama, guhika aha rurembo rw'orugo orugumire Turo; okuruga aho gukiikama gutoora Hoosa; gugarukira aha nyanja haihi na Akiziibu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.29",
            "verseOrgIds": [
              "JOS.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi baheebwa Umma na Afeki na Rehobu; endembo makumi abiri na ibiri n'ebirorero byazo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo nibwo buhunguzi bw'oruganda rwa Asheri, n'endembo zaabo n'ebirorero byazo, nk'oku emiryango yaabo yaabaire eri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.31",
            "verseOrgIds": [
              "JOS.19.31"
            ]
