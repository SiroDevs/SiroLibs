          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyanga ky'obuhunguzi bwabo kikaba kirimu endembo ezi, Zoora, Eshitaoli, Irishemeshi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
