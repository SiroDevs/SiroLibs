              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eloni, Timuna, Ekurooni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.43",
            "verseOrgIds": [
              "JOS.19.43"
            ]
          }
        },
