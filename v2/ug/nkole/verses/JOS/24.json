          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga aho Yoshua yaayohereza abantu, buri muntu okugaruka omu buhunguzi bwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.28",
            "verseOrgIds": [
              "JOS.24.28"
            ]
