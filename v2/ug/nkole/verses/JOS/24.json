                  "text": "Bar 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Abaisraeli bakaheereza MUKAMA omu biro byona ebya Yoshua, n'omu biro byona eby'abakuru abaatsigaireho yaafiire, abaabaire nibamanya ebi MUKAMA yaakoreire Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
