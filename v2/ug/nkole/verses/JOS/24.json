            "number": "21",
            "style": "v",
            "sid": "JOS 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baagarukamu Yoshua bati: Ngaaha! kureka itwe turyaguma nituheereza MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.21",
            "verseOrgIds": [
              "JOS.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua yaabagira ati: Muri baakareebi abarikwehamiza ku mutooraine MUKAMA kuba niwe mwaheereza. Baagarukamu bati: Turi baakareebi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
              "JOS.24.22"
            ]
          }
        },
        {
          "name": "verse",
