          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima mwayambuka Yorudani, mwahika Yeriko; abaayo baabarwanisa, nangwa n'Abaamori n'Abaperizi n'Abanyakanaani n'Abahiiti n'Abagirugashi n'Abahiivi n'Abayebusi; naabahayo omu mikono yaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.11",
            "verseOrgIds": [
              "JOS.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 24:12"
          },
          "items": [
