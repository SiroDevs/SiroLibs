              "type": "text"
            }
          ]
        },
        {
          "text": " Ku muriimuura MUKAMA, mwayehongyera baaruhanga b'abanyamahanga, aryabahindukana, abakore kubi, abamareho, bwanyima y'okubakora gye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.20",
            "verseOrgIds": [
