                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yoshua yaaragaana n'abantu eryo izooba, yaabateeraho ebiragiro n'ebyaragiirwe, bari Shekemu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.25",
