              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima y'ebyo Yoshua mwene Nuuni omugaragwa wa MUKAMA yaafa, ahikize emyaka igana na ikumi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "baamuziika omu kyanga ky'obuhunguzi bwe Timunaati-seera, omu nsi y'ebibungo eya Efuraimu aha bukiizi-bwa-bumosho bw'ekibungo kya Gaashi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        },
        {
          "name": "verse",
