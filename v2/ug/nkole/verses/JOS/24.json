              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.3"
              },
              "items": [
                {
                  "text": "1 Sam 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoshua yaagira ati: Mbwenu nu nimwiheho baaruhanga b'abanyamahanga abari omuriimwe, mute emitima yaanyu ahari MUKAMA Ruhanga wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baagambira Yoshua bati: MUKAMA Ruhanga waitu niwe turiguma nituheereza, kandi n'eiraka rye niryo turihurira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.24",
            "verseOrgIds": [
              "JOS.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
