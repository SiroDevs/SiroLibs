              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.28"
              },
              "items": [
                {
                  "text": "Kur 23:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.3"
              },
              "items": [
                {
                  "text": "Zab 44:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naayohereza enwa kubeebembera, zaababinga omu maisho gaanyu, nangwa n'abagabe babiri b'Abaamori, tibarabingirwe zaarurara zaanyu n'amata gaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.12",
            "verseOrgIds": [
              "JOS.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.10"
              },
              "items": [
                {
                  "text": "Bir 6:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naabaha ensi ei mutarahendekyeire, n'endembo ezi mutarombekire, mwazituuramu; kandi na hati nimurya aha mizaabibu n'emizeituuni ei mutarabyaire.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        }
      ]
    },
