              "JOS.4.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.3.7"
              },
              "items": [
                {
                  "text": "Yos 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha izooba eryo MUKAMA yaaha Yoshua ekitiinisa omu maisho g'Abaisraeli boona; baaguma nibamutiina ebiro byona eby'amagara ge, nk'oku baabaire batiina Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA yaagambira Yoshua ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.15",
            "verseOrgIds": [
              "JOS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ragiira abanyamurwa abaheekire eshanduukye y'endagaano, bainamukye barugye omuri Yorudani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.16",
            "verseOrgIds": [
              "JOS.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua nikwo kuragiira abanyamurwa ati: Mwinamukye murugye omuri Yorudani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.17",
            "verseOrgIds": [
              "JOS.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abanyamurwa abaabaire baheekire eshanduukye y'endagaano ya MUKAMA ku baarugire omuri Yorudani, ebigyere byabo byahika aha nkungu, amaizi ga Yorudani gaagaruka omu mwanya gwago, gaarengyera aha nkungu zaayo zoona, nk'oku gaabaire gari.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baaruga omuri Yorudani aha kiro kya ikumi ky'okwezi kw'okubanza, baasiisira Gilugaali aha mwatano gwa Yeriko ogw'oburugwa-izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.19",
            "verseOrgIds": [
              "JOS.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi amabaare gari ikumi n'abiri agu baihire omuri Yorudani, Yoshua yaagabyara Gilugaali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.20",
            "verseOrgIds": [
              "JOS.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaagambira Abaisraeli ati: Abaana baanyu ku baribuuza baishebo omu biro ebiriija bati: Amabaare aga nigamanyisa ki? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.21",
            "verseOrgIds": [
              "JOS.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "obwo muryabashobororera muti: Abaisraeli bakambuka Yorudani egi eyomire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.22",
            "verseOrgIds": [
              "JOS.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
