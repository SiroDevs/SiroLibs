                "loc": "PSA.44.3"
              },
              "items": [
                {
                  "text": "Zab 44:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima MUKAMA yaagambira Yoshua ati: Otatiina, n'obu kwakuba okuhahaaza omutima; twara abarwani boona, oimukye oinamukye oteere Ai; reeba, ntaire omugabe waayo n'abantu be n'orurembo rwe n'ensi ye omu mikono yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.1",
            "verseOrgIds": [
              "JOS.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.6.21"
              },
              "items": [
                {
                  "text": "Yos 6:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.14"
              },
              "items": [
                {
                  "text": "Bir 20:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Noija kugira Ai n'omugabe waayo nk'oku waagizire Yeriko n'omugabe waayo; kwonka eminyago yaayo n'ente zaayo mubyetwarire, bibe eminyago yaanyu; mugwere enyima y'orurembo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.2",
            "verseOrgIds": [
              "JOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.2",
            "verseOrgIds": [
              "JOS.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua nikwo kwimuka n'engabo ze zoona kuza kuteera Ai; akatoorana abashaija b'amaani amamanzi obukumi bushatu, akaboohereza nyekiro; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.3",
            "verseOrgIds": [
              "JOS.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.29"
              },
              "items": [
                {
                  "text": "Bar 20:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.13.13"
              },
              "items": [
                {
                  "text": "2 Bus 13:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi akabaragiira ati: Reeba, nimwija kugwera enyima y'orurembo; mutaruza hare munonga, kureka mugume mweteekateekire; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.4",
            "verseOrgIds": [
              "JOS.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyowe n'abantu abu nyine nitwija kwirira haihi n'orurembo; ku baraije kuturwanisa nk'okubanza, nitwija kubahunga; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.5",
            "verseOrgIds": [
              "JOS.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo nibaija kwija batubingire, okuhitsya obu turaababeihabeihe tukabaiha omu rurembo; ahakuba nibaija kugira bati: Baatuhunga nk'okubanza; itwe nitwija kugumizamu kubahunga; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.6",
            "verseOrgIds": [
              "JOS.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "haza imwe abaaba babagwereire mwimukye mukwate orurembo; ahakuba MUKAMA Ruhanga waanyu naija kuruhayo omu mikono yaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.7",
            "verseOrgIds": [
              "JOS.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku muraaheze kurukwata, murutwekyemu omuriro; mutwaze nk'oku MUKAMA yaabaragiire; ekyo nikyo naabaragiira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.8",
            "verseOrgIds": [
              "JOS.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua yaaboohereza, baaza ahu barikuza kugwera, baaraara ahagati ya Beseeli na Ai aha rubaju rw'oburengyerwa-izooba bwa Ai; kwonka ekyo kiro Yoshua we yaaraara n'abatsigaireyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.9",
            "verseOrgIds": [
              "JOS.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaimuka kare omu kasheeshe, yaateerana abantu, yainamuka n'abakuru b'Abaisraeli, beebembeire abantu nibaza Ai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.10",
            "verseOrgIds": [
              "JOS.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boona abarwani abu yaabaire aine bainamuka, baahika haihi omu maisho g'orurembo, baasiisira aha rubaju rwa bumosho orwa Ai; aho hakaba hariho oruhanga ahagati yaabo na Ai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.11",
            "verseOrgIds": [
              "JOS.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaatwara abantu nk'enkumi itaano, yaabaragiira kugwera ahagati ya Beseeli na Ai aha rubaju rw'oburengyerwa-izooba bw'orurembo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.12",
            "verseOrgIds": [
              "JOS.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo baatengire orugamba; eihe ry'amaani bakarita aha rubaju rwa bumosho rw'orurembo, n'abandi ab'okugwera, baabata aha rubaju rw'oburengyerwa-izooba; kwonka Yoshua ekyo kiro yaakiraara omu ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.13",
            "verseOrgIds": [
              "JOS.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe wa Ai ku yaakireebire, we n'abantu be boona ab'omu rurembo baimuka kare n'obwira, baaza kurwanisa Abaisraeli aharikushuuma omu ruhita; kwonka tiyaamanya ku hariho abagwereire enyima y'orurembo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.14",
            "verseOrgIds": [
              "JOS.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.36"
              },
              "items": [
                {
                  "text": "Bar 20:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoshua n'Abaisraeli boona baayehindura nk'abaabingwa omu maisho gaabo, baahunga nibatoora omu ihamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.15",
            "verseOrgIds": [
              "JOS.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.3"
              },
              "items": [
                {
                  "text": "Kur 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.31"
              },
              "items": [
                {
                  "text": "Bar 20:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'abantu boona abaabaire bari omu rurembo baayetwa kuteeranira hamwe kubakurata; ku baayeyongyeire kubinga Yoshua, baayeyongyera kuza hare n'orurembo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.16",
            "verseOrgIds": [
              "JOS.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tihaagira mushaija weena owaatsigara omuri Ai nari omuri Beseeli, otarashohoire kubinga Abaisraeli; baatsiga orurembo rurangaire, baakurata Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.17",
            "verseOrgIds": [
              "JOS.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.17",
            "verseOrgIds": [
              "JOS.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Yoshua ati: Imutsya eicumu ryawe eri okwaitse, oryorekye Ai; ahakuba naaza kugihayo omu mikono yaawe. Yoshua yaimutsya eicumu eri yaabaire akwaitse, yaaryoreka Ai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.18",
            "verseOrgIds": [
              "JOS.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaagoroire omukono gwe, abaabaire bagwereire ahonaaho baimuka ahu baabaire bari, bairuka, baataaha omu rurembo; baarukwata, baarahuka baarutwekamu omuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.19",
            "verseOrgIds": [
              "JOS.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba Ai ku baanagire amaisho enyima, baareeba omwika nigutuumuuka ahaiguru, baabura agahungira oku nari kuriya, ahakuba abaabaire bahungiire omu ihamba bakahindukana abaabaire bababingire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.20",
            "verseOrgIds": [
              "JOS.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua n'ab'Abaisraeli boona ku baareebire abaabaire bagwereire baakwata orurembo, kandi baareeba n'omwika gw'omu rurembo nigutuumuuka ahaiguru, baagaruka, baita abantu ba Ai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.21",
            "verseOrgIds": [
              "JOS.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.20.5"
              },
              "items": [
                {
                  "text": "Yob 20:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'abaakwatsire orurembo baashohora kubarwanisa; aba Ai nikwo kukubirwa ahagati y'Abaisraeli, bakabareetwa oku n'oku, bakabaita, hakabura owaahonoka aha icumu, n'obu kwakuba okuhunga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.22",
            "verseOrgIds": [
              "JOS.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe wa Ai we baamukwata ahuriire, baamureetera Yoshua.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.23",
            "verseOrgIds": [
              "JOS.8.23"
            ]
          }
        }
      ]
    },
    {
