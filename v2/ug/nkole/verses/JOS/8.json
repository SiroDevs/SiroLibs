              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi aho niho yaahandiikiire ahari ago mabaare omu maisho g'Abaisraeli ebiragiro ebi Musa yaahandiikire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
