                  "text": "Bir 13:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoshua yaayotsya Ai, yaagihindura amatongo agatarituurwamu ebiro byona, nk'oku kiri na hati. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.28",
