              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli ku baaherize kwitira kimwe aba Ai boona omu bwerere omu irungu, ei baabaire babakuratiire, n'abandi boona baabaita na rurara, okuhitsya obu baabamariireho kimwe, baagaruka Ai, baagihwerekyereza na rurara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.24",
            "verseOrgIds": [
              "JOS.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boona aba Ai, abaafiire eryo izooba, abashaija n'abakazi, bakaba bari kakumi n'enkumi ibiri; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.25",
            "verseOrgIds": [
              "JOS.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba Yoshua taragwisize mukono gwe, ogwabaire gwimukize eicumu, okuhitsya obu yaaherize kucwekyerereza kimwe aba Ai boona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.26",
            "verseOrgIds": [
              "JOS.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kureka ente n'eminyago eby'omuri orwo rurembo Abaisraeli bakabyetwarira, nk'oku MUKAMA yaagambiire Yoshua. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.27",
            "verseOrgIds": [
              "JOS.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
