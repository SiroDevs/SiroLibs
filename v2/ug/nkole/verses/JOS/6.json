              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Yoshua yaagira abashaija bari ababiri abaatatsire ensi, ati: Mutaahe omu nju ya maraaya, mwihemu ogwo mukazi n'abe boona, nk'oku mwamuraganiise. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.22",
            "verseOrgIds": [
              "JOS.6.22"
            ]
          }
        },
        {
          "name": "verse",
