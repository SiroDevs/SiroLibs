                {
                  "text": "Mat 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Rahabu maraaya, n'enju ya ishe n'abe boona Yoshua yaabarokora; Rahabu ogwo yaatuura omuri Israeli n'okuhitsya eri izooba, ahakuba akashereka entumwa ezi Yoshua yaatumire kutata Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.25",
            "verseOrgIds": [
              "JOS.6.25"
            ]
