                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.41"
              },
              "items": [
                {
                  "text": "Mat 10:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi orurembo n'ebirimu byona nibiija kubiikirwa MUKAMA, kureka Rahabu maraaya na boona abaraashangwe omu nju ye nibo baraakire, ahabw'okuba akashereka entumwa ezi twatumire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.17",
            "verseOrgIds": [
              "JOS.6.17"
            ]
          }
        },
        {
