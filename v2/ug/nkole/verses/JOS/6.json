            "sid": "JOS 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka efeeza yoona n'ezaabu, ebintu eby'emiringa n'ebyoma n'ebirikwera ebitooraniirwe MUKAMA; bize omu ibiikiro rye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
            "verseOrgIds": [
              "JOS.6.19"
            ]
          }
        }
