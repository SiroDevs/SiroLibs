              "items": [
                {
                  "text": "1 Tes 5:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka imwe mwerindire kimwe ekintu kyona ekibiikiirwe MUKAMA; ku muraabe mwabibiikire, hatakaagira owaatwara kimwe aharibyo, akareetera orusiisira rw'Abaisraeli kuhwerekyerera n'okwitwa kubi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.18",
            "verseOrgIds": [
              "JOS.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
