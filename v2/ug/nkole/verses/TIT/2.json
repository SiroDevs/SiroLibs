                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " owaayehaireyo ahabwaitu, kutucungura omu bugomi bwona, n'okutweza ahabwe, ngu tubone kuba eihanga rye eritoorainwe, eririkwezirikira kukora emirimo emirungi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo obe nibyo waagamba, obibahabure, obahane n'obushoboorozi bwingi. Hatagira omuntu weena owaakugaya.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
            "verseOrgIds": [
