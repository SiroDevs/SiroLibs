          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba embabazi za Ruhanga zireebekire nizireetera abantu boona okujunwa, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.11",
            "verseOrgIds": [
              "TIT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nizituhabura kwanga okutatiina Ruhanga n'okwetenga eby'ensi, ngu tubone kugumaho omu busingye obu obwa hati, nitwerinda, turi abahikiriire, abarikutiina Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.12",
            "verseOrgIds": [
              "TIT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.20"
              },
              "items": [
                {
                  "text": "Fil 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " tutegyereize eki twineho amatsiko agarimu omugisha, nikwo kworekwa kw'ekitiinisa okwa Ruhanga waitu, Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.13",
            "verseOrgIds": [
              "TIT.2.13"
            ]
          }
        },
