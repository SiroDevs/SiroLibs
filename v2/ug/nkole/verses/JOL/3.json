                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bakateerera abantu bangye enteenyu, omwana w'omwojo bakamuhingisa maraaya, n'ow'omwishiki bakamuhinga viinyo, ngu babone eby'okunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.3.3"
            ]
