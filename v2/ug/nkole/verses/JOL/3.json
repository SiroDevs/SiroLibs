                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ndyateeranira ahamwe amahanga goona, ngashuumye omu ruhita rwa Yehoshafaati, mbacwerereyo orubanja, nimbatura abantu bangye n'obuhunguzi bwangye Israeli, ahabw'okubataataanisiza omu mahanga, bakabaganisa ensi yangye, ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.3.2"
            ]
          }
        },
        {
