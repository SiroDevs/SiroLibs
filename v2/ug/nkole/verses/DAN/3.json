              "type": "text"
            }
          ]
        },
        {
          "text": " Batyo abo bashaija bonshatu, Seduraaka, Mesaaki na Abedeneego baagwa omu kikoomi ky'omuriro ogurikubuguma babohirwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
