    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe Nebukadeneeza akakora ekishushani ky'ezaabu, oburaingwa bwakyo mikono makumi mukaaga, n'obuhango bwakyo mikono mukaaga. Yaakyemereza omu ruhita rwa Duura omu ishaza rya Babulooni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.1",
            "verseOrgIds": [
              "DAN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima omugabe Nebukadeneeza yaatuma kuteeranira hamwe ab'amashaza, abareeberezi, abakuru b'amahe, abahi b'obwengye, ababiiki, abahi b'ebiragiro, abaramuzi, n'abakungu boona ab'omu mashaza ngu baije kushoroora ekishushani eki omugabe Nebukadeneeza yaayemereize. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.2",
            "verseOrgIds": [
              "DAN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo ab'amashaza, abareeberezi, abakuru b'amahe, abahi b'obwengye, ababiiki, abahi b'ebiragiro, abaramuzi n'abakungu boona ab'omu mashaza, baija, baateeranira hamwe kushoroora ekishushani eki omugabe Nebukadeneeza yaayemereize. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omurangi yaaranga n'eiraka rihango, naagira ati: Imwe abantu b'amahanga, n'enganda, n'ab'endimi ezitari zimwe, nimuragiirwa ngu, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku muraahurire amaraka g'enzamba, esheegu, endingiri, amakondere, enanga, obunyamurera n'emiringo yoona ey'ebirikugamba, mujuumare ahansi, muramye ekishushani ky'ezaabu eki omugabe Nebukadeneeza ayemereize; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.5",
            "verseOrgIds": [
              "DAN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.22"
              },
              "items": [
                {
                  "text": "Yer 29:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.15"
              },
              "items": [
                {
                  "text": "Kush 13:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi omuntu weena oraayangye kujuumara ahansi kukiramaya, naija kunagwa ahonaaho omu kikoomi ky'omuriro ogurikubuguma. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo abantu boona ku bahuriire amaraka g'enzamba, esheegu, endingiri, amakondere, enanga, obunyamurera n'emiringo yoona ey'ebirikugamba, abantu boona ab'amahanga, n'enganda n'ab'endimi ezitari zimwe, baajuumara ahansi, baaramya ekyo kishushani ky'ezaabu, eki omugabe Nebukadeneeza yaayemereize.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
