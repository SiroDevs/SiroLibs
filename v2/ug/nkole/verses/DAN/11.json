            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha bunaku bw'aha muheru omugabe w'aha bukiizi-bwa-buryo aryamuteera; kwonka omugabe w'aha bukiizi-bwa-bumohso aryamusyokyera nk'akasooroora n'ebigaari n'ab'aha mbaraasi n'emeeri nyingi, ateere ensi, azishandaaremu nk'omwegyemure, azoogyemu; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.40",
            "verseOrgIds": [
              "DAN.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
