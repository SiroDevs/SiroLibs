                "loc": "DAN.9.1"
              },
              "items": [
                {
                  "text": "Dan 9:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi nyowe, omu mwaka gw'okubanza ogw'omu busingye bwa Dario Omumeedi, nkaimuka kumugumya n'okumugaruramu amaani.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.1",
            "verseOrgIds": [
              "DAN.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.1",
            "verseOrgIds": [
              "DAN.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 11:2"
          },
          "items": [
