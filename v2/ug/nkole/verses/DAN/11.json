              "items": [
                {
                  "text": "Mak 13:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aryayohereza engabo ze, zihikyeyo, zishiishe hekalu n'ekigo kyayo, ziiheho ekitambo ky'okwotsya eky'obutoohsa, ziteho ekirikuzira ekirikuhwerekyereza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.31",
            "verseOrgIds": [
              "DAN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarikushiisha egyo ndagaano aryababeihabeihesa akarimi karungi; kwonka abantu abarikumanya Ruhanga waabo baryahama, bakore eby'obumanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.32",
            "verseOrgIds": [
              "DAN.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.3"
              },
              "items": [
                {
                  "text": "Dan 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaine obwengye omuri abo bantu, n'obu barimara ebiro bingi nibaitwe rurara n'omuriro, bakatwarwa bari enkwatwa banyagirwe, baryareetera baingi okwetegyereza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.33",
            "verseOrgIds": [
              "DAN.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku barigwa, baryatunga okuhwerwa kukye; baingi baryayeteerana nabo nibamamarika. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.34",
            "verseOrgIds": [
              "DAN.11.34"
            ]
          }
        },
