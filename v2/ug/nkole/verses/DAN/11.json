      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.28",
            "verseOrgIds": [
              "DAN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bunaku obwatairweho aryagaruka omu nsi y'aha bukiizi-bwa-buryo, agiteere, kwonka omu bunaku obwo tikiriba nk'oku kyabaire bweabiso; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.29",
            "verseOrgIds": [
              "DAN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba emeeri za Kitimu ziryaija kumurwanisa; nikyo aritiinira, akagarurayo engabo ze, akagyenda aine ekiniga kingi, akarwansia abarikukunda endagaano erikwera. Omu kugaruka kwe aryata omutima ahari abo abarikureka endagaano erikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.30",
            "verseOrgIds": [
              "DAN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 11:31"
          },
          "items": [
