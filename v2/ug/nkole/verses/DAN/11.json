                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bwanyima ahikye omu nsi y'ekitiinisa. Obukumi n'obukumi baryaitwa, kwonka Abanyedomu, Abamoabu, n'abaini b'omu Baamoni baryarokorwa omu mukono gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.41",
