              "attrs": {
                "loc": "REV.7.14"
              },
              "items": [
                {
                  "text": "Kush 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi bamwe omuri abo banyabwengye baryaitwa, bamarwemu enkamba, bashemezibwe, kandi beezibwe, okuhitsya aha bunaku bw'aha muheru; ahabw'okuba obunaku obwatairweho buryaba butakahikire.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.35",
