                "loc": "EZK.20.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rimwe ahari ago mahembe ryatookwaho akandi kahembe, kaakura, kaaba eihembe rihango munonga, ryatoora aha bukiizi-bwa-buryo, n'aha rubaju rw'oburugwa-izooba, n'omu nsi y'ekitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.9",
            "verseOrgIds": [
              "DAN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13"
              },
              "items": [
                {
                  "text": "Isa 14:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.4"
              },
              "items": [
                {
                  "text": "Kush 12:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ryaba rihango, ryahika n'eihe ry'omu iguru, kandi enyonyoozi zimwe ez'omuri eryo ihe ryazinaga ahansi, ryaziribatiirira. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.10",
            "verseOrgIds": [
              "DAN.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.31"
              },
              "items": [
                {
                  "text": "Dan 11:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rityo ryayetunguura, ryayeinganisa n'Omukuru w'eryo ihe; ryamwihaho ekitambo ky'okwotsya eky'obutoosha, kandi Omwanya ogurikwera gwasheenywa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.11",
            "verseOrgIds": [
              "DAN.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ryaheebwa eryo ihe hamwe n'ekitambo ky'okwotsya eky'obutoosha ekitambwa ahabw'okushiisha. Amazima gaanagwa ahansi; eryo ihembe ryangyenderwa gye omu bi ryabaire nirikora. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.12",
            "verseOrgIds": [
              "DAN.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.13"
              },
              "items": [
                {
                  "text": "Dan 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.24+DAN.9.25+DAN.9.26+DAN.9.27"
              },
              "items": [
                {
                  "text": "9:24-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima naahurira orikwera naagamba; kandi orikwera ondiijo yaamubuuza ati: Ebyo ebyayorekwa eby'ekitambo ky'okwotsya eky'obutoosha, n'eby'eky'okushiisha ekirikuhindura ensi amatongo, n'eby'okurekura Obutaaho oburikwera n'eryo ihe kuribatiirirwa, biryagarukira hi? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.13",
            "verseOrgIds": [
              "DAN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamugarukamu ati: Biryamara ebiro enkumi ibiri na magana ashatu nibusheesha nibwira; bwanyima Obutaaho oburikwera bugarukye aha buteeka bwabwo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.14",
            "verseOrgIds": [
              "DAN.8.14"
            ]
          }
        }
      ]
    },
