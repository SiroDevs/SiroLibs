        },
        {
          "text": "Eby'empaya y'entaama ey'amahembe abiri, ei waareeba, nibo bagabe babiri aba Bumeedi na Buperesi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.20",
