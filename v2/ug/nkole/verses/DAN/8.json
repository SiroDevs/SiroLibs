              "DAN.8.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.21"
              },
              "items": [
                {
                  "text": "Dan 8:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku naabaire ninkyetegyereza, reeba haija empaya y'embuzi neeruga oburengyerwa-izooba, yaacwekanisa ensi yoona etarikuhitsya maguru hansi; kandi egyo mpaya ekaba eine eihembe eririkureebeka munonga ahagati y'amaisho gaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.5",
            "verseOrgIds": [
              "DAN.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.20"
              },
              "items": [
                {
                  "text": "Dan 8:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaahika empaya y'entaama ey'amahembe abiri, ei naareebire eyemereire aha nkungu y'omugyera, yaagisyokyera n'amaani eine ekiniga kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.6",
            "verseOrgIds": [
              "DAN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naareeba neegiiririra, yaagigirira ekiniga, yaagishengura, yaagikooboraho ago mahembe gombi; egyo mpaya y'enttaama yaabura agagigaruka omu kaso, kureka egyo mpaya y'embuzi yaagituura ahansi, yaagiribatiirira; haabura owaabaasa kugigikiza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.7",
            "verseOrgIds": [
              "DAN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.21"
              },
              "items": [
                {
                  "text": "Dan 8:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga aho egyo mpaya y'embuzi yaagirira kimwe eigundu; kwonka ku yaakuzire yaahama, eryo ihembe rihango ryacweka, omu mwanya gwaryo haameramu agandi mahembe ana agarikureeba ei emiyaga y'omu iguru ena eruga.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.8",
            "verseOrgIds": [
              "DAN.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
