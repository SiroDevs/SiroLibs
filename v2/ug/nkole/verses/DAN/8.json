                "loc": "DAN.7.8"
              },
              "items": [
                {
                  "text": "Dan 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.6"
              },
              "items": [
                {
                  "text": "Ezk 20:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
