                "loc": "2CO.1.10"
              },
              "items": [
                {
                  "text": "2 Kor 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo omugabe yaaragiira, baareeta Danieli, baamunaga omu kiina ky'entare. Omugabe yaagira Danieli ati: Nangwa bambe Ruhanga waawwe, ou oheereza obutoosha, takujuna! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.16",
            "verseOrgIds": [
              "DAN.6.16"
            ]
          }
        },
        {
