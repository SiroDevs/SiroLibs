                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naataho ekiragiro nti: Abantu b'omu bugabe bwangye bwona bagume bateteme omu maisho ga Ruhanga wa Danieli, bamutiine,",
          "type": "text",
