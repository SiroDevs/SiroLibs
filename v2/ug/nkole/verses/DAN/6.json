              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.26"
              },
              "items": [
                {
                  "text": "Mak 6:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe ku yaahuriire ebigambo ebyo, yaashaasha munonga, yaata omutima ahari Danieli kumujuna; yaarabanamu okurenzya eizooba naasherura oburyo bw'okumukiza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.14",
            "verseOrgIds": [
              "DAN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bashaija baagaruka baateeranira ow'omugabe, baamugira bati: Nyakusinga, noomanya ku guba omucwe gw'Abameedi n'Abaperesi, ku ekiragiro nari ekitairweho eki omugabe ahamya kitabaasa kuhindurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.15",
            "verseOrgIds": [
              "DAN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
