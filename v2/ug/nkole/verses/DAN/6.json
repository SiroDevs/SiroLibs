                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima omugabe Dario yaahandiikira abantu b'amahanga goona n'ab'enganda z'endimi ezitari zimwe, abatwire omu nsi yoona, naagira ati: Obusingye bukanye omuriimwe! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.25"
            ]
          }
        },
        {
