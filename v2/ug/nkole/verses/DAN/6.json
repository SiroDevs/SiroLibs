              "items": [
                {
                  "text": "2 Tim 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruhanga wangye atumire maraika we, yaigara eminwa y'entare, tiziine ku zingizire, ahabw'okuba mbaire ntaine kamogo omu maisho ge, kandi ntaine ki ncumwire omu maisho gaawe, Nyakusinga. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.22",
            "verseOrgIds": [
              "DAN.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.3.25"
              },
              "items": [
                {
                  "text": "Dan 3:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe yaashemererwa munonga, yaaragiira ku baiha Danieli omu kiina. Batyo baamwihamu, baashanga ataine ku abaire kwona, ahabw'okuba akeesiga Ruhanga we. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.23",
            "verseOrgIds": [
              "DAN.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.19"
              },
              "items": [
                {
                  "text": "Bir 19:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima omugabe yaaragiira, baareeta abo bashaija abaregire Danieli, hamwe n'abaana baabo n'abakazi baabo, baabanaga omuri ekyo kiina ky'entare; entare zaabashamira omu mwanya, zaahendagura amagufa gaabo goona batakahikire hansi omu kiina.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.24",
            "verseOrgIds": [
              "DAN.6.24"
            ]
          }
        }
      ]
