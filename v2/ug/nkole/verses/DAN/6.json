            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima baareeta eibaare, baarita aha munwa gw'ekiina, omugabe yaarihamisa akamanyiso ke n'akamanyiso k'abakungu be, ngu omu bigambo bya Danieli hatagira ekyahindurwaho na kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.17",
            "verseOrgIds": [
              "DAN.6.17"
            ]
