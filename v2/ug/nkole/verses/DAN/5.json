            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Danieli yaagarukiramu omu maisho g'omugabe ati: Ebiconco byawe guma nabyo, n'ebihembo byawe obihe abandi; kwonka nyowe naaza kushomera omugabe eki kihandiiko, kandi mmushobororere n'amakuru gaakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
