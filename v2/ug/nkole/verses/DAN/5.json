              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oku nikwo birikushoboororwa. MENE, Ruhanga abazire ebiro by'obugabe bwawe, yaabugarukiza aho; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
