        },
        {
          "text": " Nyakusinga, Ruhanga orikukira boona akaha sho Nebukadeneeza obugabe, okurangaanwa, ekitiinisa n'obukuru; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.18",
