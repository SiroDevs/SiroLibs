              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ebihandiikirwe nibyo ebi-MENE, MENE, TEKEELI, PARASIINI. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
