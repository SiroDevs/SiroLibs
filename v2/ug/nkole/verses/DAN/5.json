              "DAN.5.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.4"
              },
              "items": [
                {
                  "text": "Dan 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyin'omugabe, ahabw'okuhurira ebigambo by'omugabe n'abakungu be, yaataaha omu nju y'obugyenyi, yaagira ati: Karamaare, Nyakusinga! Reka kwemereza omutima ahabw'ebi orikuteekateeka, n'obu kwakuba okuhinduriza ahamaisho. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.10",
            "verseOrgIds": [
              "DAN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.48"
              },
              "items": [
                {
                  "text": "Dan 2:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.8"
              },
              "items": [
                {
                  "text": "4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, omu bugabe bwawe harimu omushaija oine omwoyo gwa baaruhanga abarikwera. Nangwa n'omu busingye bwa sho, okuhweza okwetegyereza n'obwengye nk'obwa baaruhanga bikaba bimureebekamu, kandi sho, omugabe Nebukadeneeza, akamugira omukuru w'abafumu, abahi b'eobwengye, Abakaludaaya n'abarikuragura eby'enyonyoozi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.11",
            "verseOrgIds": [
              "DAN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.7"
              },
              "items": [
                {
                  "text": "Dan 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba ogwo mushaija Danieli, ou omugabe yaayetsire Beliteeshaza, akareebwamu omwoyo murungi n'okwetegyereza, akaba abaasa kurootorora ebirooto, n'okwita ebishaakuzo, n'okushoboorora ebiremire. Mbwenu nibamukwetere, naija kushoboorora n'eki.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.12",
            "verseOrgIds": [
              "DAN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.12",
            "verseOrgIds": [
              "DAN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima baareeta Danieli omu maisho g'omugabe. Omugabe yaamubuuza ati: Niiwe Danieli ow'omu Bayuda abaanyagirwe, ou tata omugabe yaihire omuri Yuda? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.13",
            "verseOrgIds": [
              "DAN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.20"
              },
              "items": [
                {
                  "text": "Dan 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mpuriire nibakugambaho ku oine omwoyo gwa baaruhanga abarikwera, kandi ngu okwaka, okwetegyereza n'obwengye ebirikukira eby'abandi nibikureebekamu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.14",
            "verseOrgIds": [
              "DAN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baanyetera abanyabwengye n'abafumu kushoma eki kihandiiko, n'okunshobororera amakuru gaakyo, kwonka tibaakibaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.15",
            "verseOrgIds": [
              "DAN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbenu mpuriire ngu iwe noobaasa kumanyisa amakuru g'ebintu n'okushoboorora ebiremire. Hati ku oraabe noobaasa kushoma eki kihandiiko, n'okunshobororera amakuru gaakyo, noija kujwekwa omwenda gwa bujwa, n'omukuufu gw'ezaabu omu bitysa, kandi obe omutegyeki wa kashatu omu bugabe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        }
      ]
    },
