              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaruga Kadeshi, baasiisira aha rushozi Hoori aha mwatano gw'ensi ya Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.37",
