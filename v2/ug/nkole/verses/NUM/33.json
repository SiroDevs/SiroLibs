              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaruga Yotibaasa, baasiisira Abiroona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.34",
            "verseOrgIds": [
              "NUM.33.34"
