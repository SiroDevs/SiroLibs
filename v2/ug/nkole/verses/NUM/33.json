          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaruga Ezioni-geberi, baasiisira omu ihamba rya Ziini, niyo Kadeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.36",
            "verseOrgIds": [
