          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Arooni akaba ahikize emyaka igana na makumi abiri n'eshatu, obu yaagwa aha rushozi Hoori.",
          "type": "text",
          "attrs": {
