          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaruga Obosi, baasiisira Iye-abariimu eri omu mwatano gwa Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.44",
            "verseOrgIds": [
