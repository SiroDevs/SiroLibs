          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima baasiisira haihi na Yorudani okuruga Besi-yeshimooseveni okuhika Abeeli-shitimu omu mpita za Moabu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
            "verseOrgIds": [
              "NUM.33.49"
            ]
          }
