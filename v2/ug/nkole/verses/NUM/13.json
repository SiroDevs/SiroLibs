              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka abantu abaabaire bagyenzire nawe baagira bati: Titurikubaasa kwinamukayo kurwana na bari bantu, ahabw'okuba nibatukiza amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.31",
