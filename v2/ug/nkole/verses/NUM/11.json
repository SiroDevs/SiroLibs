              "items": [
                {
                  "text": "Zab 78:26-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuyaga gwaruga ahari MUKAMA, gwareeta endahi zaaruga aha nyanja, zaagwa haihi n'orusiisira okurwehinguririza, zaahitsya omwanya ogu omuntu arikubaasa kugyenda eizooba ryona buri rubaju, nizigyendera omu mwanya nk'ogwa mikono ebiri okuruga ahansi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.31",
            "verseOrgIds": [
              "NUM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baimuka, baarenzya eryo izooba, baaseesa ekiro, baarenzya erindi izooba nibazikwata; owaakwatsire enkye, yaakwata homeri ikumi, baazeeyanikira embaju zoona ez'orusiisira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.32",
            "verseOrgIds": [
              "NUM.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyama ku yaabaire ekibari omu kanwa, batakagimizire, MUKAMA yaabagirira ekiniga kingi, yaajuumikiza abantu orufu rwingi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.22"
              },
              "items": [
                {
                  "text": "Bir 9:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwanya ogwo gwayetwa Kibiroosi-hatava, ahabw'okuba niho baaziikire abantu abaayetengire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        }
