          ]
        },
        {
          "text": "Kwonka ogwo muntu oitsire ondiijo ku arirenga omwatano gw'orurembo rw'obuhungiro, oru ahungiiremu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.26",
