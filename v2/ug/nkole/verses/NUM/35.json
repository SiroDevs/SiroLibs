              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "orikuhoorera eshagama yaamushanga aheeru y'orwo rurembo rw'obuhungiro, yaamwita, tarigiibwaho rubanja rw'eshagama ye; ",
          "type": "text",
