          "type": "text",
          "attrs": {
            "verseId": "NUM.35.16",
            "verseOrgIds": [
              "NUM.35.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.11"
              },
              "items": [
                {
                  "text": "Bir 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku arimuteeza ekyoma, yaafa, biri n'omwitsi; kandi omwitsi ataribura kwitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.16",
            "verseOrgIds": [
              "NUM.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nari ku arimuteera eibaare, eri aine omu ngaro, eririkubaasa kwita omuntu, yaafa, biri n'omwitsi; kandi omwitsi ataribura kwitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.17",
            "verseOrgIds": [
              "NUM.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nari shi, ku arimuteeza ekiti kibaizire eki akwaitse omu ngaro, ekirikubaasa kwita omuntu, yaafa, biri n'omwitsi; kandi omwitsi ataribura kwitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.18",
            "verseOrgIds": [
              "NUM.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orikuhoorera nyakufa niwe ariyeitira oitsire omuntu; ku arimureeba, amwite. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.19",
            "verseOrgIds": [
              "NUM.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.27"
              },
              "items": [
                {
                  "text": "2 Sam 3:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.10.7+PSA.10.8+PSA.10.9+PSA.10.10"
              },
              "items": [
                {
                  "text": "Zab 10:7-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oitsire omuntu, ku ariba amucumitsire ahabw'okumwanga, nari aine eki yaamurekyeire, akamuteera amugwereire, akafa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.20",
            "verseOrgIds": [
              "NUM.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nari shi amuteire entomi ahabw'okumwanga, yaagwa ahansi, yaafa, owaamuteire ataribura kwitwa; biri n'omwitsi; orikuhoorera nyakufa aite ogwo mwitsi, ku arimureeba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.21",
            "verseOrgIds": [
              "NUM.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku arihikiirirwa, yaacumita omuntu atamwineho rwango, nari yaagira eki yaamuteera, atamugwereire; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.22",
            "verseOrgIds": [
              "NUM.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nari shi ku arimuteera eibaare eririkubaasa kwita omuntu atamureebire, yaarimuteera, yaafa, kandi ashangirwe atari muzigu we, kandi atarikwenda kumukora kubi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.23",
            "verseOrgIds": [
              "NUM.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
