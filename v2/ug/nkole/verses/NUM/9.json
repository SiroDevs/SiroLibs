              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obundi ekicu kikaba kimara ebiro bikye ahaiguru y'Obutaaho; baguma omu rusiisira nk'ekiragiro kya MUKAMA oku kiri; kandi bwanyima nk'ekiragiro kya MUKAMA oku kiri, baimutsya orugyendo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.20",
            "verseOrgIds": [
              "NUM.9.20"
            ]
          }
        },
        {
          "name": "verse",
