              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.1"
              },
              "items": [
                {
                  "text": "1 Kor 10:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli bakaba bagyenda ahabw'ekiragiro kya MUKAMA, kandi basiisira ahabw'ekiragiro kya MUKAMA; omwanya gwona ogu ekicu kyabaire kimara ahaiguru y'Obutaaho, bakaba baguma omu rusiisira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.18",
            "verseOrgIds": [
              "NUM.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
