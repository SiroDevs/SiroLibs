                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha izooba eri baimukiizeho Obutaaho, ekicu kikasangira obwo Butaaho, niryo Ihema ry'Ebirikuhamya; kandi omu mwabazyo kyaguma ahaiguru y'Obutaaho nikishusha nk'omuriro okuhitsya omu kasheeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.15",
            "verseOrgIds": [
              "NUM.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.33"
              },
              "items": [
                {
                  "text": "Bir 1:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwo nikwo byabaire biba obutoosha; ekicu kikaba kibusangira nyomushana, nyekiro kishusha nk'omuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.16",
            "verseOrgIds": [
              "NUM.9.16"
            ]
          }
        },
        {
