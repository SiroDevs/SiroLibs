              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obundi ekicu kigumaho okwiha omu mwabazyo okuhitsya omu kasheeshe; ekicu kikiihwa aha Butaaho omu kasheeshe, baimutsya orugyendo; nari shi ku kyabaire kisiibaho, kyaraaraho, bwanyima kikiihwaho, baimutsya orugyendo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.21",
            "verseOrgIds": [
