              "type": "text"
            }
          ]
        },
        {
          "text": "N'obu ekicu kyabaire kimara ebiro bingi ahaiguru y'obwo Butaaho, nabwo Abaisraeli bakaba boorobera ekiragiro kya MUKAMA, bareka kugyenda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.19",
            "verseOrgIds": [
              "NUM.9.19"
            ]
          }
        },
        {
