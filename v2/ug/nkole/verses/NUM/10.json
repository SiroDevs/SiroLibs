          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orurango rw'orusiisira rw'Abadaani orwabaire ruri enyima y'ezindi nsiisira zoona, rwaimutsya orugyendo, nk'oku amahe gaabo gaabaire gari; omukuru w'eihe ryabo akaba ari Ahiezeeri mwene Ami-shadai; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.25",
            "verseOrgIds": [
              "NUM.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukuru w'eihe ry'oruganda rw'Abaasheri akaba ari Pagieli mwene Okiraane; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.26",
            "verseOrgIds": [
              "NUM.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi omukuru w'eihe ry'oruganda rw'Abanafutaali akaba ari Ahiira mwene Enani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.27",
            "verseOrgIds": [
              "NUM.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo Abaisraeli baakurataine omu ngyendo zaabo, obu baimutsya orugyendo, nk'oku amahe gaabo gaabaire gari.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.28",
