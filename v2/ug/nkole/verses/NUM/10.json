                {
                  "text": "Yob 29:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaamugira ati: Ninkweshengyereza, otatutsigaho; ahabw'okuba noomanya omuringo ogu tushemereire kusiisiramu omu ihamba, niiwe orikwija kuba amaisho gaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.31",
            "verseOrgIds": [
              "NUM.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku oraagyende naitwe, ebirungi byona ebi MUKAMA aritukorera, naitwe turyabikukorera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.32",
            "verseOrgIds": [
              "NUM.10.32"
            ]
          }
