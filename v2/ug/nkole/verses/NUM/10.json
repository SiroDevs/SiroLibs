              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baabaire baimutsya orugyendo kuruga omu rusiisira, ekicu kya MUKAMA kiguma kiri ahaiguru yaabo nyomushana. ",
          "type": "text",
          "attrs": {
