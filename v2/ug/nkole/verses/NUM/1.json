          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'omu ruganda rwa Gaadi abaabazirwe baaba obukumi buna n'enkumi itaano na magana mukaaga na makumi ataano.",
