        },
        {
          "text": "Baahandiika oruzaaro rwa Simeoni nk'oku emiryango yaabo yaabaire eri n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'omu ruganda rwa Simeoni abaabazirwe baaba obukumi butaano n'enkumi mwenda na magana ashatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        }
