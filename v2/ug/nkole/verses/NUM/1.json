              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli baryaguma bateere amahema gaabo, buri muntu omu rusiisira rw'owaabo aha rurango rwabo, nk'oku emitwe yaabo eri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.52",
