          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "eihe rye rikaba ririmu abashaija obukumi buna n'enkumi itaano na magana mukaaga na makumi ataano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
