          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe rye rikaba ririmu abashaija obukumi buna n'enkumi mukaaga na magana ataano, nk'oku baabazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
