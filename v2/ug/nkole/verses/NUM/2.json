          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "eihe rye rikaba ririmu abashaija obukumi butaano n'enkumi mwenda na magana ashatu, nk'oku baabazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
