                "loc": "NUM.24.2+NUM.24.3+NUM.24.4+NUM.24.5+NUM.24.6+NUM.24.7+NUM.24.8+NUM.24.9"
              },
              "items": [
                {
                  "text": "Kub 24:2-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli bagume bateere amahema gaabo, buri muntu aha rurango rw'owaabo, n'aha turango tw'amaju ga baishenkurubo; bagateere nigareeba Eihema ry'okubugaabuganiramu aha mbaju zaaryo zoona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaraateere amahema gaabo aha rubaju rwaryo orw'oburugwa-izooba bagume babe ab'orusiisira rwa Yuda, nk'oku emitwe yaabo eri, baine orurango rw'oruganda rwabo; kandi omwebembezi w'Abayuda abe Nahashooni mwene Abinadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe rye rikaba ririmu abashaija obukumi mushanju n'enkumi ina na magana mukaaga, nk'oku baabazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Isakaari nibo baraateere orusiisira okubahereera; omwebembezi waabo abe Netaneeli mwene Zuari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.5",
            "verseOrgIds": [
              "NUM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe rye rikaba ririmu abashaija obukumi butaano n'enkumi ina na magana ana, nk'oku baabazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.6",
            "verseOrgIds": [
              "NUM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurateho oruganda rwa Zebuluuni, omwebembezi waabo abe Eliabu mwene Heloohi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "eihe rye rikaba ririmu abashaija obukumi butaano n'enkumi mushanju na magana ana, nk'oku baabazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.8",
            "verseOrgIds": [
              "NUM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boona abaabazirwe omu kicweka kya Yuda bakaba bari abashaija akasiriira n'obukumi munaana n'enkumi mukaaga na magana ana, nk'oku amahe gaabo gaabaire gari. Abo babe nibo baaguma nibabanza kwimutsya orugyendo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
            ]
          }
        }
      ]
