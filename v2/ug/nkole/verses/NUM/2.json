          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaraateere orusiisira okubahereera babe ab'oruganda rwa Simeoni; omwebembezi waabo abe Shelumieli mwene Zuri-shadai; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
