            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaaragiira Abaisraeli ati: Egi niyo nsi ei murihungura nimugiteerera enteenyu ei MUKAMA yaaragiire kuha enganda mwenda n'ekicweka; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Kub 32:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba oruganda rwa Reubeeni nk'emiryango ya baishenkurubo oku eri, n'oruganda rwa Gaadi nk'emiryango ya baishenkurubo oku eri, n'ekicweka ky'oruganda rwa Manaase, baherize kuheebwa obuhunguzi bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezo nganda ibiri n'ekicweka ziherize kuheebwa obuhunguzi bwazo seenu ya Yorudani ahashungaine na Yeriko aha rubaju rw'oburugwa-izooba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
