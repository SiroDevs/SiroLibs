                "loc": "NUM.26.59"
              },
              "items": [
                {
                  "text": "Kub 26:59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eihanga ryona ery'Abaisraeli ryahika omu ihamba rya Ziini omu kwezi kw'okubanza; abantu baaguma Kadeshi; Miriamu yaagwa okwo, baaba niyo baamuziika.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.1",
            "verseOrgIds": [
              "NUM.20.1"
            ]
          }
        }
      ]
