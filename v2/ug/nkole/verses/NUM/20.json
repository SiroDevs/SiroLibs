          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihanga ryona ery'Abaisraeli ryaruga Kadeshi, ryahika aha rushozi Hoori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.22",
            "verseOrgIds": [
              "NUM.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambirira Musa na Arooni ahari orwo rushozi Hoori orw'aha mwatano gw'ensi ya Edomu, ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.23",
            "verseOrgIds": [
              "NUM.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni yaaza kukurata abaabo, ahakuba tarihika mu nsi ei naahaire Abaisraeli, ahabw'okuba mukagomera ekiragiro kyangye aha maizi ga Meriba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.24",
            "verseOrgIds": [
              "NUM.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twara Arooni na Eleazaari omutabani obainamure aha rushozi Hoori, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.25",
            "verseOrgIds": [
              "NUM.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ojuure Arooni ebijwaro bye, obijwekye Eleazaari omutabani; bwanyima Arooni naija kufeerayo, akurate abaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.26",
            "verseOrgIds": [
              "NUM.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaakora nk'oku MUKAMA yaaragiira; bainamuka aha rushozi Hoori, eihanga ryona niribareeba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.27",
            "verseOrgIds": [
              "NUM.20.27"
            ]
          }
        },
