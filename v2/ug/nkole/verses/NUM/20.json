                "loc": "OBA.1.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa ku yaabaire ari Kadeshi, yaatuma entumwa aha mugabe wa Edomu, naagira ati: Oku nikwo Israeli mwene sho arikugira. Noomanya enaku zoona ezi twareebire; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.14",
            "verseOrgIds": [
              "NUM.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "baatatenkuriitwe bakashuuma, baaza Misri, twatuurayo omwanya muraingwa; Abanyamisri baatwita kubi na baatatenkuriitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.15",
            "verseOrgIds": [
              "NUM.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku twatakiire MUKAMA, yaahurira okutaka kwaitu, yaatuma maraika, yaatwiha omuri Misri; mbwenu reeba turi Kadeshi, orurembo oruri aha mwatano gw'ensi yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.16",
            "verseOrgIds": [
              "NUM.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.22"
              },
              "items": [
                {
                  "text": "Kub 21:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nitukweshengyereza, reka turabe omu nsi yaawe; titurikwija kuraba omu misiri n'obu kwakuba okuraba omu misiri y'emizaabibu, kandi titurikwija kunywa maizi g'omu maziba; nitwija kuraba omu nguuto y'omugabe, turekye kukiikama aha rubaju rwa buryo nari orwa bumosho, okuhitsya obu turaarugire kimwe omu nsi yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.17",
            "verseOrgIds": [
              "NUM.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omugabe wa Edomu yaamugarukamu ati: Torikwija kuraba mu nsi yangye, ntakaahurura nkakurwanisa na rurara. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.18",
            "verseOrgIds": [
              "NUM.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli baamugira bati: Nitwija kuraba omu nguuto empango; kandi itwe n'amatungo gaitu ku turaanywe aha maizi gaawe, nitwija kugaihurira. Ka turabemu n'ebigyere kwonka, titwine kindi ki turikwija kukora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.19",
            "verseOrgIds": [
              "NUM.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
