            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.1+EXO.17.2+EXO.17.3+EXO.17.4+EXO.17.5+EXO.17.6"
              },
              "items": [
                {
                  "text": "Kur 17:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima eihanga ryona ryabura amaizi; abantu baayeteerana, baayetomboitera Musa na Arooni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.2",
            "verseOrgIds": [
              "NUM.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.2"
              },
              "items": [
                {
                  "text": "Kub 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baatonganisa Musa nibagira bati: Nangwa kuri twafiire obu beene waitu baagwa omu maisho ga MUKAMA! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.3",
            "verseOrgIds": [
              "NUM.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu mukareetera ki eihanga rya MUKAMA omuri eri ihamba kufeeramu n'amatungo gaitu? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.4",
            "verseOrgIds": [
              "NUM.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukatwihira ki Misri kutureeta omu mwanya ogu omubi? Ti mwanya ogurikuhingwamu engano nari emitiini nari emizaabibu n'obu gaakuba amakomamahanga; kandi tiharimu maizi g'okunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.5",
            "verseOrgIds": [
              "NUM.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Arooni baaruga omu maisho g'abo bantu abeeteeraine, baaza aha muryango gw'Eihema ry'okubugaabuganiramu, baajuumara ahansi; ekitiinisa kya MUKAMA kyababonekyera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.6",
            "verseOrgIds": [
              "NUM.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.7",
            "verseOrgIds": [
              "NUM.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twara enkoni eri, oteerane eihanga ryona, iwe na Arooni mukuru waawe, mugambirire orukiri omu maisho gaabo, rureete amaizi gaarwo, obaihire amaizi omuri orwo rukiri; obone kunywaisa eihanga ryona n'amatungo gaaryo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.8",
            "verseOrgIds": [
              "NUM.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.17.10"
              },
              "items": [
                {
                  "text": "Kub 17:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaiha egyo nkoni omu maisho ga MUKAMA, nk'oku yaamuragiira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.9",
            "verseOrgIds": [
              "NUM.20.9"
            ]
          }
        }
      ]
    },
