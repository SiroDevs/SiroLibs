              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwo nikwo Abanyaedomu baayangiire Abaisraeli kuraba omu nsi yaabo; nikyo Abaisraeli baahindukiire bakabarugaho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.21",
