            "sid": "NUM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.1",
            "verseOrgIds": [
              "NUM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gambira Abaisraeli ebigambo byangye ebi ndikugamba ningira nti: Ku murihika omu nsi ei ndikubaha, ei murikuza kutuuramu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.2",
            "verseOrgIds": [
              "NUM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.41"
              },
              "items": [
                {
                  "text": "Ezk 20:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.15"
              },
              "items": [
                {
                  "text": "2 Kor 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.18"
              },
              "items": [
                {
                  "text": "Fil 4:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwayenda kuhongyera MUKAMA empongano z'okwotsya omumuriro, n'obu kiriba kiri ekitambo ky'okwotsya, nari ekitambo ky'okuhikiiriza eki waaraganiise noohiga, nari eky'okuhonga ahabw'okweyendera, nari eky'okuhonga aha magyenyi gaanyu agaatairweho, kuba ekisooroora kirungi ahari MUKAMA, nimukiiha omu masyo g'ente nari ag'entaama, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.3",
            "verseOrgIds": [
              "NUM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.2.1"
              },
              "items": [
                {
                  "text": "Lev 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " orihonga empongano ye ahongyere MUKAMA empongano y'esaano ey'ekicweka kimwe kya ikumi kya eefa y'esaano y'obunono ejwangizemu ekicweka kimwe kya kana kya hiini y'amajuta g'emizeituuni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi, oteekateekye ekicweka kimwe kya kana kya hiini ya viinyo ahabwa buri mwana gw'entaama, kuba empongano ey'eby'okunywa, ehongwe hamwe n'ekitambo ky'okwotsya nari ekindi kitambo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.5",
            "verseOrgIds": [
              "NUM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nari ku eriba eri empaya y'entaama oteekateekye ebicweka bibiri bya ikumi bya eefa y'esaano y'obunono ejwangizemu ekicweka kimwe kya kashatu ekya hiini y'amajuta g'emizeituuni kuba empongano y'esaano y'okuhongwa n'egyo mpaya; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ohongye ekicweka kimwe kya kashatu kya hiini ya viinyo kuba empongano y'eby'okunywa ey'omugaju murungi ahari MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.7",
            "verseOrgIds": [
              "NUM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.11"
              },
              "items": [
                {
                  "text": "Lev 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ku oriteekateeka enimi y'ekimasha kuba ekitambo ky'okwotsya, nari ekindi kitambo eky'okuhikiiriza eki waaraganiise noohiga, nari empongano z'okusiima ahabw'obusingye ez'okuhongyera MUKAMA, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.8",
            "verseOrgIds": [
              "NUM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "oriba naahonga egyo nimi, agihongye n'ebicweka bishatu bya ikumi bya eefa y'esaano y'obunono ejwangizemu ekicweka kimwe kya kabiri kya hiini y'amajuta g'emizeituuni kuba empongano y'esaano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.9",
            "verseOrgIds": [
              "NUM.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryahonga ekicweka kimwe kya kabiri kya hiini ya viinyo kuba empongano y'eby'okunywa, byona bibe empongano ey'okwotsya omu muriro ey'ekisooroora kirungi ekirikushemeza MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.10",
            "verseOrgIds": [
              "NUM.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo bibe nikwo byaguma nibikorwa ahari buri nimi, nari buri mpaya, nari ahari buri mpaya nto y'entaama nari ey'embuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.11",
            "verseOrgIds": [
              "NUM.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'ebitambo ebi muriteekateeka oku birikwingana, mube nikwo mwakora ahabwa buri kimwe nk'omubaro gwabyo oku guri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.12",
            "verseOrgIds": [
              "NUM.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enzaarwa zoona ziryaguma zikore ebyo zityo, ku ziriba nizihonga empongano ez'okwotsya omu muriro ez'ekisooroora kirungi ekirikushemeza MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.13",
            "verseOrgIds": [
              "NUM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omunyaihanga ku ariba abashuhuukiiremu nari omuntu weena oriba atwire naimwe omu busingye bwanyu bwona, yaayenda kuhonga empongano ey'okwotsya omu muriro, ey'ekisooroora kirungi ekirikushemeza MUKAMA, nk'oku mutwaza, abe nikwo yaatwaza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.14",
            "verseOrgIds": [
              "NUM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.28"
              },
              "items": [
                {
                  "text": "Gal 3:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.11"
              },
              "items": [
                {
                  "text": "Kol 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'eihanga haryabaho ekiragiro kimwe ekitairweho ahabwanyu n'ahabw'omunyaihanga obashuhuukiiremu, ekiragiro ekitarihwaho omu busingye bwanyu bwona; nkaimwe oku muri, n'omunyaihanga nikwo ariba omu maisho ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.15",
            "verseOrgIds": [
              "NUM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muryagira ekiragiro kimwe n'omugyenzo gumwe hamwe n'omunyaihanga obashuhuukiiremu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.16",
            "verseOrgIds": [
              "NUM.15.16"
            ]
          }
        }
      ]
    },
