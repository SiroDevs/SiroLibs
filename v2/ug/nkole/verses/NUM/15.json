          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyamurwa arihiirire ogwo oriba ashobize, akakora ekibi omu maisho ga MUKAMA, atakikozire nkana; ku ariheza kumurihiirira, ogwo muntu aryasaasirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.28",
