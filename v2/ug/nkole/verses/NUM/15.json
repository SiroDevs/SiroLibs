          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muryagira ekiragiro kimwe aha bw'omuntu weena okozire ekibi, atakikozire nkana, yaaba nzaarwa y'omu Baisraeli nari omunyaihanga oriba abashuhuukiiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.29",
