            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi MUKAMA aryarwanisa Misri; omu kubarwanisa abaite kandi abatambire, bwanyima bagarukye ahari MUKAMA; kandi aryahurira okweshengyereza kwabo, abatambire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        }
