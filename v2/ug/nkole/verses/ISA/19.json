          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.16+ZEC.14.17+ZEC.14.18"
              },
              "items": [
                {
                  "text": "Zek 14:16-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obwo aryamanywa omuri Misri, n'Abanyamisri baramumanya, bamuramye nibamutambira ebitambo, n'okumuhongyera empongano, kandi bamuraganise, bahikiirize ebi baamuraganiise. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
