          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi obwo Abaisraeli, Abanyamisri na Abaasiria bonshatu baryakwatanisa, bagume nibahaisa ensi omugisha; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.24",
            "verseOrgIds": [
              "ISA.19.24"
            ]
          }
        },
