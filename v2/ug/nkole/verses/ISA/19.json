              "items": [
                {
                  "text": "Oba 21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eryaba akamanyiso n'ekirikuhamya MUKAMA ow'amahe omu nsi ya Misri. Ku baritakira MUKAMA ahabw'abarikubahata, aryabooherereza omujuni w'okubarwanirira, abajune. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
