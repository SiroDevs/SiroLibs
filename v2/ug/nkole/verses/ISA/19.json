            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu bunaku obwo haryabaho omuhanda rugyendwa okuruga Misri okuhika Asiria; Abaasiria baze Asiria, baramye hame nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
