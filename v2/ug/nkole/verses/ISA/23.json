          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutungi n'obushuubuzi bwayo buryayerezibwa MUKAMA; tiburibiikwa, tiburiteebwa hangahari nk'obw'engumya, kureka buryaheebwa abatuura omu maisho ga MUKAMA, ngu babone kurya n'okuhaaga, kandi babone ebijwaro ebirikuterera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
