              },
              "items": [
                {
                  "text": "41:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.29"
              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abakora ebishushani ebirikuramibwa boona ni busha; n'ebintu ebi barikwesiimira tibiine mugasho; abarikubiramya tibarikureeba, tibaine ki barikumanya, kandi aha muheru baryaitwa enshoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.9",
            "verseOrgIds": [
              "ISA.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.18"
              },
              "items": [
                {
                  "text": "Hab 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'oha orabaizire ekishushani kya ruhanga, nari oraheeesire ekishushani ekiyagiibwe ekitaine mugasho? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.10",
            "verseOrgIds": [
              "ISA.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.115.5+PSA.115.6+PSA.115.7+PSA.115.8"
              },
              "items": [
                {
                  "text": "Zab 115:5-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, bagyenzi be boona baryakwatwa enshoni, ahabw'okuba abanyamyoga baabyo n'abantu-buntu; ka boona bateeranire hamwe, beemerere; haza oreebe ku baitwa obwoba, enshoni zikababumbira hamwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuheesi akijugutirira omu makara, bwanyima akiteeza enyondo, akiheeshesa omukono gwe gw'amaani; kwonka ku agira enjara, ahwamu amaani; ku abura amaizi, agwa enshazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.12",
            "verseOrgIds": [
              "ISA.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubaizi areega omugoye, aharaatuzaho ekaraamu akibaija n'embaijo, akigyeresamu ekyoma ekirikugyera, akishushanisa n'omuntu, kigira oburungi nk'obw'omuntu, kiguma omu nju. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.13",
            "verseOrgIds": [
              "ISA.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atema emyereezi, nari atooranamu omuzo nari omwela, agureka gukurira omu miti y'omu kibira; kandi abyara omuberooshi, enjura egwitirira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.14",
            "verseOrgIds": [
              "ISA.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima gurugamu enku z'abantu; omuntu aihaho omuganda, agwota; ahemba omuriro, ateeka eby'okurya; kandi agubaijamu ekishushani kya ruhanga, akiramya, akihindura ekishushani ekirikuramibwa, akijuumara omumaisho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.15",
            "verseOrgIds": [
              "ISA.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empimbi yaagwo agihemba; endiijo agyokyesa enyama, agirya, ahaaga; kandi ogwo muriro agaruka agwota, agira ati: Ayaayaaya, eshi naabona akariro, naahwa embeho! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.16",
            "verseOrgIds": [
              "ISA.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima empimbi eyatsigaraho agibaijamu ruhanga we, nikyo kishushani kye ekibaizirwe, akijuumara omumaisho, akiramya, akishaba ati: Nkiza; ahabw'okuba ori ruhanga wangye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.17",
            "verseOrgIds": [
              "ISA.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.17",
            "verseOrgIds": [
              "ISA.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tibaine ki barikumanya; kandi tibagira ki bateekateeka; ahakuba akabahumya amaisho, tibarikubaasa kureeba, yaabaita omutima, tibarikubaasa kwetegyereza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.18",
            "verseOrgIds": [
              "ISA.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.15"
              },
              "items": [
                {
                  "text": "Bir 27:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tihariho orikuteekateeka, tihariho orikumanya nari orikwetegyereza, akagira ati: Ekicweka kyagwo nkihembire, amakara gaakyo naagateekyesa omugaati, naayootsyaho enyama, naagirya; mbwenu ekitsigaireho nkihindure ekirikuzira, njuumare omu maisho g'empimbi y'ekiti, ngiramye? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.19",
            "verseOrgIds": [
              "ISA.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.13.12"
              },
              "items": [
                {
                  "text": "Yob 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.144.8"
              },
              "items": [
                {
                  "text": "Zab 144:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.25"
              },
              "items": [
                {
                  "text": "Rom 1:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu ogwo arya eiju, ahabisiibwe omutima ogurikwebeiha; tarikubaasa kwejuna nari okugira ati: Eki nyine omu mukono gwangye gwa buryo, ti ky'ebishuba?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.20",
            "verseOrgIds": [
              "ISA.44.20"
            ]
          }
        }
      ]
    }
