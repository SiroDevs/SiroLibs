            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Moabu ku ariija omu mwanya mukuru gw'okuramizamu kweyoreka, n'obu aryerusya akaza omu mwanya gwe ogurikwera kushaba, taine ki ariihamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.12",
            "verseOrgIds": [
              "ISA.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo nikyo kigambo eki MUKAMA yaagambire ira ahari Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka hati MUKAMA naagira ati: Omu myaka eshatu nk'ey'orikukorera ebihembo, ekitiinisa kya Moabu, n'obu araabe aine eihe rihango munonga, kiryagaywa, kandi abarihonokaho baryaba bakye munonga abataine maani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.14",
            "verseOrgIds": [
              "ISA.16.14"
            ]
          }
        }
