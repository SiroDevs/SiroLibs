            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.20"
              },
              "items": [
                {
                  "text": "Rom 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndyata akamanyiso omuribo, abaahonokireho mbatume omu b'amahanga, Tarushiishi, Puuli, Luudi, ab'omu barasi, Tubali, Yavani omu birwa ebiri hare, ei batakahuriraga kurangaanwa kwangye, n'obu kwakuba okureeba ekitiinisa kyangye; baryo baryamanyisa amahanga ekitiinisa kyangye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 66:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.2"
              },
              "items": [
                {
                  "text": "Isa 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.16"
              },
              "items": [
                {
                  "text": "Rom 15:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi baryareeta beene waanyu boona, baheekirwe aha mbaraasi, omu bigaari, omu ngozi, aha nyumbu n'aha ngamira, nibabaiha omu mahanga goona kuba empongano y'okuhongyera MUKAMA, babahitsye Yerusaalemu aha rushozi rwangye orurikwera, babitwaze nk'oku Abaisraeli bashangwa bareeta omu nju ya MUKAMA empongano zaabo z'esaano, omu nyabya zishemeziibwe, nikwo MUKAMA arikugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.20",
            "verseOrgIds": [
              "ISA.66.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 66:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.6"
              },
              "items": [
                {
                  "text": "Kur 19:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ndyaihamu bamwe omuribo, mbagira abanyamurwa n'Abaleevi, nikwo MUKAMA arikugamba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.21",
            "verseOrgIds": [
              "ISA.66.21"
            ]
          }
        }
      ]
