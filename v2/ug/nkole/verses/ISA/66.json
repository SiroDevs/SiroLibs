              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.86.9"
              },
              "items": [
                {
                  "text": "Zab 86:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.16"
              },
              "items": [
                {
                  "text": "Zek 14:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obunaku buryahika, obu abantu boona bariguma nibaija omu maisho gangye kuramya, buri kuboneka kw'okwezi, n'ahari buri sabato, nikwo MUKAMA arikugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.23",
            "verseOrgIds": [
              "ISA.66.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 66:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
