            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarikweyeza, bakeeshemeza, ngu baze omu misiri bakurataine, barye empunu n'ebirikunugwa n'embeba, abo boona baryacwekyererera hamwe, nikwo MUKAMA arikugamba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        }
      ]
