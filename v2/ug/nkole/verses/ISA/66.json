                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku eiguru risya n'ensi nsya ebi ndihanga birigumaho omu maisho gangye, nikwo n'oruzaaro rwanyu n'eiziina ryanyu birigumaho, nikwo MUKAMA arigamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.22",
            "verseOrgIds": [
              "ISA.66.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
