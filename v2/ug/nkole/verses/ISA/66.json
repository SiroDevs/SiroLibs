            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba nimmanya emirimo yaabo n'ebiteekateeko byabo; obunaku nibwija, obu nditeeranira ahamwe amahanga goona n'endimi zoona, bakaija, bakareeba ekitiinisa kyangye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.18",
            "verseOrgIds": [
              "ISA.66.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
