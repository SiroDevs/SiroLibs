                "loc": "2CH.32.31"
              },
              "items": [
                {
                  "text": "2 Bus 32:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.1",
