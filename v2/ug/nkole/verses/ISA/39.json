                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro ebyo Merodaaki-baladaani mwene Baladaani omugabe wa Babulooni, akatuma ahari Hezekia entumwa, zaamutwarira ebaruha n'ekiconco, ahabw'okuba kaba ahuriire ngu arwaire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.1",
            "verseOrgIds": [
              "ISA.39.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
