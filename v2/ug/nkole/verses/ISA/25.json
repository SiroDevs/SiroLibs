            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ahari oru rushozi aryamariraho kimwe ekirikushweka ekishwekire enganda zoona, n'eky'okwetwekyerera ekisangiire amahanga goona. ",
          "type": "text",
