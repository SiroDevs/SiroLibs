                "loc": "1PE.5.3"
              },
              "items": [
                {
                  "text": "1 Pet 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " B'eishe-emwe, mukwatanise mutooreze emitwarize yangye, kandi mwetegyerereze ahari abo abarikugyenda batyo, nk'oku turi eky'okureeberaho ahariimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.17",
            "verseOrgIds": [
              "PHP.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba hariho baingi, abu naabagambiireho kaingi, na mbwenu ningaruka kubagambira nindira, nti, batuura bari abazigu b'omusharaba gwa Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.18",
            "verseOrgIds": [
              "PHP.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "emperu yaabo n'okuhwerekyerera, ruhanga waabo n'enda yaabo, nibeehimbisiza omu birikuhemura, emitima yaabo bagitaire aha by'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.19",
            "verseOrgIds": [
              "PHP.3.19"
            ]
          }
        },
        {
