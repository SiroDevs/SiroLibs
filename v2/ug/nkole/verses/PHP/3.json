              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.11",
            "verseOrgIds": [
              "PHP.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tindikugira ngu mperize kukitunga, nari shi ngu mperize kuhikiirizibwa; kwonka ningumizamu, ngu naanye nkwate ekyo eki Kristo Yesu yankwatiire. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.12",
            "verseOrgIds": [
              "PHP.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "B'eishe-emwe, tindikweteekateekaho ngu naaherize kukikwata; kureka eki ndikukora ni kimwe; niinyebwa eby'enyima, ninkununkirira eby'omumaisho, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.13",
            "verseOrgIds": [
              "PHP.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.24"
              },
              "items": [
                {
                  "text": "1 Kor 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " niinyezirika kuhika aharikuhakanirwa ngu mpeebwe ekihembo eky'okweta kwa Ruhanga omuri Kristo Yesu okw'okuba omu iguru. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.14",
            "verseOrgIds": [
              "PHP.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo itwe abahikiriire twena oku turikwingana, tuteekateekye tutyo; kandi ku muraateekateekye okundi aha kintu kyona, nakyo Ruhanga aryakibashuuruurira. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.15",
            "verseOrgIds": [
              "PHP.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka amazima agu tuhikiremu, tube nigo twagyenderamu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.16",
            "verseOrgIds": [
              "PHP.3.16"
            ]
          }
        }
      ]
    },
