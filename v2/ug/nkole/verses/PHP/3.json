                "loc": "REV.22.15"
              },
              "items": [
                {
                  "text": "Kush 22:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwerinde ezo mbwa, mwerinde ezo nkozi z'ebibi, mwerinde abo abafa okushara kwonka. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.2",
            "verseOrgIds": [
              "PHP.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.29"
              },
              "items": [
                {
                  "text": "Rom 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba abashazirwe omu mazima niitwe, abaramya Ruhanga omu Mwoyo, abeehimbisiza omuri Kristo Yesu, kandi abateesiga mubiri; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.3",
            "verseOrgIds": [
              "PHP.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.18"
              },
              "items": [
                {
                  "text": "2 Kor 11:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nyowe n'obu ndaabe nyine ekirikuunyesigisa omubiri. Omuntu ondiijo ku yaakuteekateeka kwesiga omubiri, nkaaba nimmukira. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.4",
            "verseOrgIds": [
              "PHP.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkasharwa aha kiro kya munaana, ndi ow'omu ihanga rya Israeli, ow'omu ruganda rwa Benyamiini, Omuheburaayo enzaarwa, omu by'Ebiragiro ndi Omufarisaayo; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.5",
            "verseOrgIds": [
              "PHP.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu by'obweziriki nkahiiga ekanisa; omu kuhikiirira okw'okukwata Ebiragiro nkaba ntaine ki ndikugaywaho. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.6",
            "verseOrgIds": [
              "PHP.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.44"
              },
              "items": [
                {
                  "text": "Mat 13:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.46"
              },
              "items": [
                {
                  "text": "46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ebyo ebyabaire biri nk'enshaagi ahariinye, nkabibara nk'ebifiire ahabwa Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.7",
            "verseOrgIds": [
              "PHP.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi buzima byona nimbibara nke'bifiire, ahabw'okuba okumanya Kristo Yesu Mukama wangye nikubikira munonga. Ahabw'Ogwo nkafeerwa byona, naabibara nk'eshaabo, ngu mbone kutunga Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.8",
            "verseOrgIds": [
              "PHP.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.21"
              },
              "items": [
                {
                  "text": "Rom 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ndeebwe ndi omuriwe, ntaine kuhikiirira okwengye ahabwangye okw'okuhitsya Ebiragiro, kureka okuri omu kwikiriza Kristo, nikwo kuhikiirira okuruga ahari Ruhanga ahabw'okwikiriza; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.9",
            "verseOrgIds": [
              "PHP.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.3+ROM.6.4+ROM.6.5"
              },
              "items": [
                {
                  "text": "Rom 6:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ngu mmumanye, kandi mmanye n'amaani ag'okuzooka kwe, nkwatanise nawe omu kubonabonesibwa kwe, nshushane nawe omu kufa kwe, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.10",
            "verseOrgIds": [
              "PHP.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.5"
              },
              "items": [
                {
                  "text": "Kush 20:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naanye, ku kiribaasika, mbone kuhika aha kuzooka omu bafu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.11",
            "verseOrgIds": [
              "PHP.3.11"
            ]
          }
        }
      ]
