              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.11",
            "verseOrgIds": [
              "PHP.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo, abarikukundwa, nk'oku mwabaire mworoba obutoosha, na mbwenu mube nikwo mwahikiiriza okujunwa kwanyu mwine obwoba n'okutetema, t'obu ndiho bwonka, kureka okukira munonga n'obu ntariho; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.12",
            "verseOrgIds": [
              "PHP.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba Ruhanga niwe akorera omuriimwe, akabaha okukunda ebi asiima n'okubikora. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.13",
            "verseOrgIds": [
              "PHP.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukore byona mutarikwetomboita, mutaine mpaka, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.14",
            "verseOrgIds": [
              "PHP.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.16"
              },
              "items": [
                {
                  "text": "Mat 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.8"
              },
              "items": [
                {
                  "text": "Efe 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mubone kuba abataine ky'okuhanwa nari oburyarya, muri abaana ba Ruhanga abataine kamogo, ahagati y'ab'obusingye obu obukiikami, oburikwehabagiza, abu mwakiramu nk'etabaaza omu nsi, nimworeka ekigambo ky'amagara, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.15",
            "verseOrgIds": [
              "PHP.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.2"
              },
              "items": [
                {
                  "text": "Gal 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naanye ngire eki ndyehimbisizaho aha izooba rya Kristo, ku ntarairukiire busha, nari ku ntarakoreire busha. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.16",
            "verseOrgIds": [
              "PHP.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.6"
              },
              "items": [
                {
                  "text": "2 Tim 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi n'obu eshagama yangye yaakuba nk'empongano y'eby'okunywa eshukwa aha kitambo ky'okuheereza Ruhanga ky'okwikiriza kwanyu, nkaananuka, nshemererwa hamwe naimwe mwena. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.17",
            "verseOrgIds": [
              "PHP.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.1"
              },
              "items": [
                {
                  "text": "Fil 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.4"
              },
              "items": [
                {
                  "text": "4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naimwe mukaananuka mutyo, mushemererwa hamwe naanye.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.18",
            "verseOrgIds": [
              "PHP.2.18"
            ]
          }
        }
      ]
    },
