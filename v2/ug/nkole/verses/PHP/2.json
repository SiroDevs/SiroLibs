                "loc": "HEB.1.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo Ruhanga yaamukuriize munonga, akamuha eiziina eririkukira amaziina goona, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.9",
            "verseOrgIds": [
              "PHP.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.13"
              },
              "items": [
                {
                  "text": "Kush 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ngu boona abari omu iguru n'omu nsi n'okuzimu batsimbire amaju eiziina rya Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.10",
            "verseOrgIds": [
              "PHP.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi endimi zoona zaature ku Yesu Kristo ari Mukama, Ruhanga Tataitwe ahimbisibwe.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.11",
            "verseOrgIds": [
              "PHP.2.11"
            ]
          }
        }
      ]
