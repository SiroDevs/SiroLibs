              "items": [
                {
                  "text": "2 Pet 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ni nk'ebingonzi by'enyanja eby'amaani, babira eifuro ry'enshoni zaabo; kandi ni nk'enyonyoozi ezitahamiire hamwe, abarindiirwe omwirima ndindindi ebiro byona.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.13",
