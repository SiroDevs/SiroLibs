                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " oku zaabagambiire, nizigira ziti: Omu biro by'aha mperu haryabaho abashekyerezi, abarikukurata okwetenga kwabo okw'okutatiina Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.18",
            "verseOrgIds": [
              "JUD.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JUD 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nibo bareeta okwetaanisamu, abantu-buntu abataine Mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.19",
            "verseOrgIds": [
              "JUD.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JUD 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
