                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi n'aba Sodoma na Gomora n'ab'omu ndembo ezaabaire zihereraine nazo, abaayehaireyo omu bushambani n'okukoranaho eby'enshoni ebitari by'obuhangwa, bakaheebwa ekifubiro ky'omuriro ogutaraara, baaba eky'okureeberaho.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
            "verseOrgIds": [
              "JUD.1.7"
            ]
          }
        }
