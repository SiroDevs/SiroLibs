          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JUD 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarikukundwa, ku naabaire niinyezirika munonga kubahandiikira eby'okujunwa kwaitu twena, nkagyemwa kubahandiikira nimbeehanangiriza kurwanira munonga okwikiriza oku abarikwera baahairwe rimwe kikahwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.3",
            "verseOrgIds": [
              "JUD.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JUD 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.4"
              },
              "items": [
                {
                  "text": "Gal 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba hariho abantu bamwe abashensheire omuriitwe batamanyirwe, abaarangirwe ira ku baricwerwa orubanja oru; n'abantu abatatiina Ruhanga, abahindura embabazi za Ruhanga orwekwatso ngu bashambane, bakeehakana Omutegyeki waitu omwe wenka kandi Omujuni waitu Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.4",
            "verseOrgIds": [
              "JUD.1.4"
            ]
          }
        }
      ]
    },
