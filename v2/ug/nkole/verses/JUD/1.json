                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.22"
              },
              "items": [
                {
                  "text": "16:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baryakareeba! Ahakuba batoora omuhanda gwa Kaini, boohokyera omu buhabe bwa Balamu ahabw'okutunga enshaagi, kandi bacwekyererera omu bugomi bwa Koora. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.11",
            "verseOrgIds": [
              "JUD.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JUD 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo, ku baba nibarya naimwe, ni nk'amabara agarikushiisha amagyenyi gaanyu ag'okukundana; n'abariisa b'entaama abariisa enda zaabo batarikutiina; n'ebicu ebitarimu njura ebitwarwa omuyaga; n'ebiti ebitariho byana omu bunaku bw'ekyanda ebifiire kabiri, ebirimbwirwe n'emizi; ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.12",
            "verseOrgIds": [
              "JUD.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JUD 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.21"
              },
              "items": [
                {
                  "text": "Isa 57:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.17"
