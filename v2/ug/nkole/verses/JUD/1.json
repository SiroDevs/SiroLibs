                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo n'abeetomboita, abatuura nibatonzya, abakurata okwetenga kwabo okubi, abeehimbisa n'ebigambo ebirengyesereize, kandi abaha abantu ekitiinisa nibabendamu enshaagi. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.16",
            "verseOrgIds": [
              "JUD.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JUD 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka imwe, abarikukundwa, mwijukye ebigambo ebyagambirwe ira entumwa za Mukama waitu Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.17",
            "verseOrgIds": [
              "JUD.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JUD 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
