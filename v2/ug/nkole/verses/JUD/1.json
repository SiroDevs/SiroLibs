                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omu muringo ogwo abashaija abo bashiisha emibiri yaabo omu birooto, bagaya obutegyeki, kandi bajuma ab'ekitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.8",
            "verseOrgIds": [
              "JUD.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JUD 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
