            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi abo nibo Enoka, owa mushanju okuruga ahari Adamu, yaaragwireho ati: Reeba, Mukama akaija n'abarikwera be obukumi n'obukumi, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.14",
            "verseOrgIds": [
              "JUD.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JUD 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "okucwera boona orubanja, n'okurusingisa boona abatatiina Ruhanga ahabw'eby'okutamutiina ebi baakozire bakamucumuraho, kandi n'ebigambo ebigumire byona ebi abasiisi abatatiina Ruhanga baamugambireho nibamurwanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.15",
            "verseOrgIds": [
              "JUD.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JUD 1:16"
          },
          "items": [
            {
              "text": "16",
