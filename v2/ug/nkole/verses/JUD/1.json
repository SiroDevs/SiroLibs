              "items": [
                {
                  "text": "Kol 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka imwe, abarikukundwa, mweyombekye aha musingi gw'okwikiriza kwanyu okurikwera munonga; mushabe omu Mwoyo Orikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.20",
            "verseOrgIds": [
              "JUD.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JUD 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwerindire omu kukunda kwa Ruhanga; mutegyereze okusaasira kwa Mukama waitu Yesu Kristo, okuribahitsya omu maara agatahwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.21",
            "verseOrgIds": [
              "JUD.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JUD 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abamwe abarikubanganisa mubaikiririse; ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.22",
            "verseOrgIds": [
              "JUD.1.22"
            ]
          }
        },
