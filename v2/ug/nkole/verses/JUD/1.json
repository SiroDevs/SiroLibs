                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi na baamaraika, abatararinzire bukuru bwabo, bakaruga omu mwanya gwabo ogu baabaire batuuramu, akibarindiire omu mwirima omu njegyere ezitarugwamu, okuhitsya aha kiro kikuru eky'orubanja; ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.6",
            "verseOrgIds": [
              "JUD.1.6"
            ]
          }
        },
        {
