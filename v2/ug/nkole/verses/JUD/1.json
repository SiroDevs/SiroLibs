              "items": [
                {
                  "text": "Mat 13:55",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyowe Yuda, omuhuuku wa Yesu Kristo, kandi murumuna wa Yakobo, naabahandiikira imwe abaayetsirwe, abarikukundwa omuri Ruhanga Isheboona, kandi abarindiirwe Yesu Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JUD 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "embabazi n'obusingye n'okukunda byeyongyere omuriimwe.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
