                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu n'obu muraabe mwamanyiire kimwe byona, niinyenda kubaijutsya nti, Mukama owaajunire eihanga ry'Israeli okuruga omu nsi ya Misri, bwanyima akahwerekyereza abataraikiriize; ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
