              "type": "text"
            }
          ]
        },
        {
          "text": "Eki nikyo Mukama RUHANGA yaanyorekire; reeba, akaba naakanyisa omuzinga gw'enzigye; obwo oruhiira nirutandika kumera, kandi orwo ruhiira n'orwamezire, obunyaatsi bw'omugabe buherize kutemwa. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
