            "number": "8",
            "style": "v",
            "sid": "AMO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yambuuza ati: Iwe Amosi, nooreeba ki? Naamugarukamu nti: Nindeeba kariisho. MUKAMA nikwo kugira ati: Reeba, ninta kariisho omu bantu bangye Israeli; tindibasaasira bundi; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        },
