                  "text": "Byak 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima naagira nti: Ai bambe, Mukama RUHANGA! Reeba, naaba kubaho tinkeeshiishaga na kintu kyona; ahakuba okwiha omu buto bwangye n'okuhitsya hati tinkaryaga kyefeereire, nari ekitaafura kyona; kandi n'enyama erikuzira tekahikaga mu kanwa kangye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo kungira ati: Reeba, naakwikiriza kuteekyesa amasha g'ente omu mwanya gw'amazi g'abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.15",
            "verseOrgIds": [
              "EZK.4.15"
            ]
          }
        },
