                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ku oriheza ebyo, oryagaruka obyame, kwonka obyamire orubaju rwa buryo, oyekorere ekifubiro ky'enju ya Yuda; ekiro kimwe eki nkuteereireho kingane omwaka gumwe gw'ekifubiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.6",
            "verseOrgIds": [
              "EZK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryagumya amaisho gaawe aha kugotwa kwa Yerusaalemu, omukono gwawe gutaine ki gushwekire, orwo rurembo oruhanuurire ebirirubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.7",
            "verseOrgIds": [
              "EZK.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 4:8"
          },
          "items": [
