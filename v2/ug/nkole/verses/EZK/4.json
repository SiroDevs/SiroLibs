            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi MUKAMA naagira ati: Okwo nikwo Abaisraeli barirya eby'okurya byabo bisiisikaire omu maisho g'amahanga agu ndibabingiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.13",
