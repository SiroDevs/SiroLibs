            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba ndyakutaho omubaro gw'ebiro magana ashatu na makumi mwenda, ogurikwingana n'omubaro gw'emyaka y'ekifubiro kyabo; okwo nikwo orimara omwanya oyekoreire ekifubiro ky'enju ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.5",
            "verseOrgIds": [
              "EZK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.11"
              },
              "items": [
                {
                  "text": "Ezk 23:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
