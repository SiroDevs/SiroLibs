            "number": "9",
            "style": "v",
            "sid": "EZK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ogire engano, sayiri, ebihimba, enkoore, omugusha n'oburo, obite omu nyungu emwe, obigoyemu oburo. Omuri ebyo biro magana ashatu na makumi mwenda, ebi orimara obyamiire orubaju rumwe, nibyo origuma nooryaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.9",
            "verseOrgIds": [
              "EZK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eby'okurya ebi orirya, biryaguma bipimwe, shekeli makumi abiri buri izooba, obirye rimwe buri izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.10",
            "verseOrgIds": [
              "EZK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryaguma onywe amaizi garengirwe; kimwe kya mukaaga kya hiini, oganywe rimwe buri izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.11",
            "verseOrgIds": [
              "EZK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo by'okurya oryaguma obirye nk'embumburi ya sayiri, noobiteekyesa amazi g'abantu nibakureeba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.12",
            "verseOrgIds": [
              "EZK.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 4:13"
          },
          "items": [
            {
