            "sid": "EZK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima obyamire orubaju rwa bumosho, nkuteho ekifubiro ky'enju ya Israeli; kandi oryayekorera ekifubiro kyabo, ekirikwingana n'ebiro byona ebi orimara orubyamiire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.4",
            "verseOrgIds": [
              "EZK.4.4"
            ]
          }
        },
