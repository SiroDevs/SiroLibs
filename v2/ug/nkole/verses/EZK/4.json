                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ogire ekyoma ky'eibaati, okyemereze nk'ekisiika ahagati yaawe n'orurembo; orugumyeho amaisho, rube nk'orugotsirwe, orugotere kimwe. Ekyo kiryaba akamanyiso aha nju ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.3",
            "verseOrgIds": [
              "EZK.4.3"
            ]
          }
        },
        {
