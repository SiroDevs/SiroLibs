            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagaruka yangira ati: Mwana w'omuntu, reeba, ndyahenda eky'okwehimbagiririzaho ky'aba Yerusaalemu, nibyo by'okurya byabo, bagume barye eby'okurya bipimirwe nibatiina, kandi banywe amaizi agu barengyeirwe bahahaize emitima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.16",
            "verseOrgIds": [
              "EZK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.23"
              },
              "items": [
                {
                  "text": "Ezk 24:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
