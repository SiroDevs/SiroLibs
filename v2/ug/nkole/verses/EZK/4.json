                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi reeba, nkutaireho emirunga, ngu otarihindukira orundi rubaju, okuhitsya obu orihikiiriza ebiro byona eby'okugota kwawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.8",
            "verseOrgIds": [
              "EZK.4.8"
            ]
