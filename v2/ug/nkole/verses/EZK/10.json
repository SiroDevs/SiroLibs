            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baakerubi abo baaguruka, baaza ahaiguru. Baakerubi abo nibyo bihangirwe ebiine amagara ebi naareebire aha mugyera Kebari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.15",
            "verseOrgIds": [
              "EZK.10.15"
            ]
          }
        },
