            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA ku yaaherize kuragiira ogwo mushaija owaabaire ajwaire ebijwaro bya kitaani ati: Iha omuriro ahagati y'enziga ezirikwehinguririza, ahagati ya baakerubi, yaazizamu, yaayemerera aha rubaju rw'enziga emwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima kerubi yaagorora omukono gwe, ari ahagati ya baakerubi bagyenzi be, yaakununkirira omuriro oguri ahagati ya baakerubi, yaiha omuriro ahari ogwo, yaaguta omu ngaro z'ogwo mushaija owaabaire ajwaire ebijwaro bya kitaani; nawe yaagutwara, yaashohora. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.8"
              },
              "items": [
                {
                  "text": "Ezk 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi baakerubi abo bakaba baine ekirikushusha engaro y'omuntu ahansi y'amapapa gaabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
