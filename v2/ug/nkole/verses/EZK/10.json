                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku naagiire kugira nti, naareeba, omu mwanya ogw'ahaiguru y'emitwe ya baakerubi, ekirikushusha eibaare rya safiro, ekiri nk'ekitebe ky'obukama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.2"
              },
              "items": [
                {
                  "text": "Ezk 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagambira ogwo mushaija owaabaire ajwaire ebijwaro bya kitaani ati: Irooko oze ahagati y'enziga ezirikwehinguririza, eziri ahansi ya baakerubi; bwanyima oijuze engaro zaawe zombi makara agarikwotsya, agu oraihe ahagati ya baakerubi, oganaganagye ahaiguru y'orurembo. Atyo yaazizamu nindeeba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.16"
              },
              "items": [
                {
                  "text": "Ezk 8:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.10"
              },
              "items": [
                {
                  "text": "1 Bag 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obu ogwo mushaija yaataahamu, baakerubi bakaba beemereire aha rubaju rw'enju orw'obukiizi-bwa-buryo, n'ekicu kiijwire ekikaari ky'omunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.28"
              },
              "items": [
                {
                  "text": "Ezk 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.2"
              },
              "items": [
                {
                  "text": "43:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekitiinisa kya MUKAMA kyaruga ahari baakerubi, kyainamuka, kyayemerera aha muryango gw'enju; egyo nju yaijura ekicu, n'ekikaari kyaijura okumurinkana kw'ekitiinisa kya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.24"
              },
              "items": [
                {
                  "text": "Ezk 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuhoorera kw'amapapa ga baakerubi kwahuririrwa hare, kwahika n'omu kikaari ky'aheeru, kuri nk'eiraka rya Ruhanga Ow'obushoboorozi bwona yaaba naagamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        }
      ]
    },
    {
