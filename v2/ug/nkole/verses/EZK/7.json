            "sid": "EZK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.13",
            "verseOrgIds": [
              "EZK.7.13"
            ]
