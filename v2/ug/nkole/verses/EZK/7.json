                "loc": "ISA.24.2"
              },
              "items": [
                {
                  "text": "Isa 24:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.29"
              },
              "items": [
                {
                  "text": "1 Kor 7:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obunaku bwahika, eizooba niriirira haihi. Omuguzi arekye kushemererwa, n'omutunzi arekye kuganya, ahabw'okuba ekiniga kiri aha ihanga ryabo ryona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.12",
            "verseOrgIds": [
              "EZK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatunzi tibarigarurirwa bi baatunzire, n'obu bariba bakiriho; ahabw'okuba ekiniga kiri aha ihanga ryabo ryona, kandi tikirihinduka; n'ahabw'okutahikiirira kwe tihariho muntu origumya ho amagara ge.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.13",
            "verseOrgIds": [
              "EZK.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
