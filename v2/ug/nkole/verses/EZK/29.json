              "items": [
                {
                  "text": "Yer 46:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi egyo nsi ya Misri ndyagigira amatongo ahagati y'ezindi nsi ezaahindukire amatongo; n'endembo zaayo zimare emyaka makumi ana ziri amatongo omu zaacwekyerereziibwe. Kandi ndyataataanisiza Abanyamisri omu mahanga, mbanaganagye omu nsi zaago.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.12",
            "verseOrgIds": [
              "EZK.29.12"
            ]
          }
        }
