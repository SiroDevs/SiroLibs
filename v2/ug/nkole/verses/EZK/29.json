              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oku nikwo Mukama RUHANGA arikugamba naagira ati: Egyo myaka makumi ana ku erihwaho, ndyataaruura Abanyamisri, mbaihe omu mahanga, ei baataataaniire; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.13",
            "verseOrgIds": [
              "EZK.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.14"
              },
              "items": [
                {
                  "text": "Ezk 17:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ndyagarura Abanyamiri abatwairwe bari enkwatwa, mbareete omu nsi Patiroosi, ensi ei baakomookiremu; okwo niyo barihindukira obugabe obutaine kitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.14",
            "verseOrgIds": [
              "EZK.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi baryakira obundi bugabe bwona okutagira kitiinisa; tiburigaruka kutegyeka gandi mahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.15",
            "verseOrgIds": [
              "EZK.29.15"
            ]
          }
        },
        {
