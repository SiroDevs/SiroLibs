                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'ahabw'ekyo reeba, naaba omuzigu waawe; n'ensi ya Misri ndyagihindurira kimwe amatongo, ngigire eihamaba, okuruga ahari Migidooli okuhika Syene, n'okuhika aha mwatano gwa Esiopia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.10",
            "verseOrgIds": [
              "EZK.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
