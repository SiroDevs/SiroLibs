                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Terirabwamu kigyere ky'omuntu, n'obu kyakuba eky'enyamaishwa; eryamara emyaka makumi ana etatwirwemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.11",
            "verseOrgIds": [
              "EZK.29.11"
            ]
          }
        },
