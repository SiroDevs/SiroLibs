                  "text": "Isa 19:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwana w'omuntu, ta amaisho gaawe ahari Faraho omugabe wa Misri, omuhanuurire ebirimubaho, we na Misri yoona, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.2",
            "verseOrgIds": [
              "EZK.29.2"
            ]
          }
        },
