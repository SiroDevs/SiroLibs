                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima omu mwaka gwa makumi abiri na mushanju, omu kwezi kw'okubanza, aha kiro kyakwo ky'okubanza, ekigambo kya MUKAMA kikanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.17",
            "verseOrgIds": [
              "EZK.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.7"
              },
              "items": [
                {
                  "text": "Ezk 26:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.6"
              },
              "items": [
                {
                  "text": "Yer 27:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwanaw'omuntu, Nebukadeneeza omugabe wa Babulooni akakoresa eihe rye n'amaani kurwanisa Tuuro, omutwe gwa buri muntu gwaba oruhara, n'amabega gaabo gaahonoka; kwonka taine ki iyaihireyo, we n'eihe rye, ahabw'okufa kubi kwe obu yaagiteera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.18",
            "verseOrgIds": [
              "EZK.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.11"
              },
              "items": [
                {
                  "text": "Ezk 32:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo Mukama RUHANGA arikugirira ati: Reeba, ensi ya Misri ndyagiha Nebukadeneeza omugabe wa Babulooni, atware abantu baayo, aginyagye, kandi ebi arinyaga bibe ebihembo by'engabo ze. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.19",
            "verseOrgIds": [
              "EZK.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.9"
              },
              "items": [
                {
                  "text": "Yer 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mmuhaire ensi ya Misri kuba ebihembo by'ebi yaahendekyeire, ahabw'okuba niinye baakoreire; nikwo Mukama RUHANGA arikugira.",
          "type": "text",
