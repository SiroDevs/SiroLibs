            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwaka gwa ikumi, omu kwezi kwa ikumi, aha kiro kyakwo kya ikumi na bibiri, ekigambo kya MUKAMA kikanyijaho nikigira kiti: ",
          "type": "text",
