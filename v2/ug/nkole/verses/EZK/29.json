              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabw'okugira oti: Omugyera Nailo n'ogwangye, niinye naaguhangire, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        },
