              "items": [
                {
                  "text": "Tonz 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tiburigaruka kuba bwesigye bw'enju ya Israeli, okwijutsya ekicumuro kyabo ky'omu bunaku, obu baabaire babahindukira ngu babahe emikono. Haza obwo nibwo barimanya ku ndi Mukama RUHANGA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        }
