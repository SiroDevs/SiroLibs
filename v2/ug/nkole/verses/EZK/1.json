          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ei Omwoyo yaabaire aza yoona, niyo byabaire bitoora, n'ezo nziga ziimuka nabyo; ahabw'okuba Omwoyo w'ebyo bihangirwe ebiine amagara akaba ari n'omuri ezo nziga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
