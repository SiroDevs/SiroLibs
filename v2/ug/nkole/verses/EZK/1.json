              "type": "text"
            }
          ]
        },
        {
          "text": " Ku zaabaire ziba nizigyenda, zigyenda zitarikuhinduka, nizitoora orubaju rwona oru zaayenda ahari ezo ina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
