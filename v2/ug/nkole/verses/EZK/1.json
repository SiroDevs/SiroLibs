          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emisusire y'ezo nziga n'oku zaabaire zikozirwe zikaba nizengyengyeta nka berulo; zoona ina zikaba nizishushana; oku zaabaire zikozirwe, zikaba nizireebeka oti, buri nziga eri omu ndiijo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
