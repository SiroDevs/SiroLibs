            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amaguru gaabyo gagororokire, ahansi y'ebigyere byabo nihashusha nk'ebyara by'enyana, kandi nibyengyengyeta nk'omuringa ogweziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
          }
        },
        {
