              "items": [
                {
                  "text": "Ezk 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwo nikwo aha maisho gaabyo haabaire nihashusha. Amapapa gaabyo gakaba gashashaanwire; buri kimwe kiine amapapa abiri, buri ipapa nirikora ah arya kigyenzi kyakyo, n'agandi abiri gashwekire omubiri gwakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.11",
            "verseOrgIds": [
              "EZK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
