            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku naabaire ninkireeba ebyo bihangirwe bina ebiine amagara, naareeba enziga aha nsi aha rubaju rw'ebyo bihangirwe, enziga emwe ahabwa buri kimwe ahari ebyo ebina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
