              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amapapa gaabyo gakaba nigakoranaho; buri kimwe nikigyenda omumaisho kitarikuhinduka; byona nibigyendera hamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 1:10"
