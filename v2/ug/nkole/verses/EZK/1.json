                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Brui kimwe kikaba nikigyenda omumaisho kitarikuhinduka. Ei Omwoyo yaabaire aza yoona, niyo byabaire bitoora bitarikuhinduka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
