            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri ekyo kicu haarugamu ebihangwirwe bina ebiine emagara. Kandi oku nikwo byabaire nibishusha. Bikaba biine ekyemerero nk'eky'omuntu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
