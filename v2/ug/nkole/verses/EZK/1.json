            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha mbaju zaabyo ina bikaba biine engaro nk'ez'omuntu ahansi y'mapapa gaabyo. Kandi byona bikaba biine obuso n'amapapa ebirikushusha biti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.8",
            "verseOrgIds": [
