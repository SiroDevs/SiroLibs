              "items": [
                {
                  "text": "Kush 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emisusire yaabyo ahamaisho, buri kimwe kikaba kiine aha maisho nk'ah'omuntu; kandi byona bina biine aha maisho nk'ah'entare aha rubaju rwa buryo, biine aha maisho nk'ah'ente aha rubaju rwa bumosho, kandi biine aha maisho nk'ah'eishamba aha nkomo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
