                  "text": "2 Bag 21:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yangira ati: Orubanja rw'enju ya Israeli n'eya Yuda rurengyesereize munonga; ensi eijwire eshagama, n'orurembo rwijwirwemu okwita emanja; ahakuba nibagira bati: MUKAMA atsigireho ensi yaitu, kandi taine ki arikureeba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.9",
            "verseOrgIds": [
              "EZK.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.4"
              },
              "items": [
                {
                  "text": "Ezk 7:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naanye eriisho ryangye tiriribasaasira, kandi tindibagirira mbabazi; kureka ndyabatura ebi baakozire, mbibarunde aha mitwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        }
