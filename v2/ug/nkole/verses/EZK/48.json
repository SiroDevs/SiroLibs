          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaheereraine n'ekyanga kya Isakaari, okuruga oburugwa-izooba okuhika oburengyerwa-izooba, guryaba ekyanga kya Zebuluuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
