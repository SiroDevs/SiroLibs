                  "text": "Kush 21:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo ekicweka kyona, eki muriihaho, kiryaba ekya mikono obukumi bubiri n'enkumi itaano embaju zaakyo zoona ina, nikyo kicweka ky'omugabo ogurikwera yhamwe n'omwanya gwona ogw'orurembo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
