          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaheereraine n'ekyanga kya Zebuluuni, okuruga aha burugwa-izooba okuhika oburengyerwa-izooba, guryaba omugabo gwa Gaadi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
