              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaheereraine n'ekyanga kya Simeoni, okuruga oburugwa-izooba okuhika oburengyerwa-izooba, guryaba omugabo gwa Isakaari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
