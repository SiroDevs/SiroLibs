        {
          "text": "Kandi eby'ezindi nganda, okuruga oburugwa-izooba okuhika oburengyerwa-izooba, guryaba omugabo gwa Benyamiini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
