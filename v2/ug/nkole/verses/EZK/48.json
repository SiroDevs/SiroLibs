            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.15+EZK.47.16+EZK.47.17+EZK.47.18+EZK.47.19+EZK.47.20"
              },
              "items": [
                {
                  "text": "Ezk 47:15-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aga nigo maziina g'enganda. Okutandikira aha mwatano gw'aha bukiizi-bwa-bumosho, okuruga aha Nyanja empango, okuraba Heselooni, okuhika ah'orikutaahira nooza Hamasi, n'okugumizamu okuhika Hazarenooni eri aha mwatano gwa Damasiko ahashingaine na Hamasi, okuruga aha rubaju rw'oburugwa-izooba okuhika oburengyerwa-izooba, guryaba omugabo gwa Daani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaheereraine n'ekyanga kya Daani, okuruga oburugwa-izooba okuhika oburengyerwa-izooba, guryaba omugabo gwa Ashera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaheereraine n'ekyanga kya Ashera, okuruga oburugwa-izooba okuhika oburengyerwa-izooba guryaba omugabo gwa Nafutaali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.13"
              },
              "items": [
                {
                  "text": "Ezk 47:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aheereraine n'ekyanga kya Nafutaali, okuruga oburugwa-izooba okuhika oburengyerwa-izooba guryaba omugabo gwa Manaase. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaheereraine n'ekyanga kya Manaase, okuruga oburugwa-izooba okuhika oburengyerwa-izooba, guryaba omugabo gwa Efuraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaheereraine n'ekyanga kya Efuraimu, okuruga oburugwa-izooba okuhika oburengyerwa-izooba guryaba omugabo gwa Reubeeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaheereraine n'ekyanga kya Reubeeni, okuruga oburugwa-izooba okuhika oburengyerwa-izooba, guryaba omugabo gwa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
