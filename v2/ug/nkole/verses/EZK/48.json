                "loc": "LEV.27.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekyo kicweka ky'ensi ekiriihwaho tibarikitunda n'obu kwakuba okuhingisa ekicweka kyakyo kyona n'ekindi; kandi tikiriba ky'abandi bantu; ahabw'okuba n'ekyereziibwe MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
