              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.7"
              },
              "items": [
                {
                  "text": "Ezk 45:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ekicweka ekiritsigara aha mbaju zombi ez'ekicweka ky'omugabo ogurikwera n'omwanya gw'orurembo kiryaba eky'omugabe. Okuruga ahari ogwo mwanya gw'omugabo ogurikwera gwa mikono obukumi bubiri n'enkumi itaano, okuhika aha mwatano gw'oburugwa-izooba, kandi okutoora oburengyerwa-izooba okuruga ahari ogwo mwanya gw'omugabo ogurikwera gwa mikono obukumi bubiri n'enkumi itaano okuhika aha mwatano gw'oburengyerwa-izooba, ahaheereraine n'emigabo y'enganda, haryaba ah'omugabe. Kandi ogwo mugabo ogurikwera ogurimi Omwanya ogurikwera gwa hekalu ahagati, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
