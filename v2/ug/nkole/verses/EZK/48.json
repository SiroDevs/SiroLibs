          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamwe n'omwanya gw'orurembo, guryaba ahagati y'ekynaga ky'omugabe. Ekyo kyanga kirayaba ahagati y'omugabo gwa Yuda n'ogwa Benyamiini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
