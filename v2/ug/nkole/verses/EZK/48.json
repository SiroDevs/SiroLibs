            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.1+EZK.45.2+EZK.45.3"
              },
              "items": [
                {
                  "text": "Ezk 45:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahaheereraine n'ekyanga kya Yuda, okuruga oburugwa-izooba okuhika oburengyerwa-izooba, guryaba omugabo ogu murishoroora, mikono obukumi bubiri n'enkumi itaano obukiika, kandi oburaingwa bwagwo bwingane n'omugabo gw'oruganda rumwe, okuruga oburugwa-izooba okuhika oburengyerwa-izooba, gwine Omwanya ogurikwera ahagati yaagwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekicweka eki muriihiraho MUKAMA kiryaba mikono obukumi bubiri n'enkumi itaano oburaingwa, n'obukiika mikono obukumi bubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.4"
              },
              "items": [
                {
                  "text": "Ezk 45:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekyo kicweka ekirikwera kiryabaganisibwa omu bicweka ebi-abanyamurwa baryatunga omugabo gw'ekicweka kya mikono obukumi bubiri n'enkumi itaano aha rubaju rw'obukiizi-bwa-bumosho, mikono kakumi aha rubaju rw'oburengyerwa-izooba, mikono kakumi aha rubaju rw'oburugwa-izooba, na mikono oukumi bubiri n'enkumi itaano aha rubaju rw'obukiizi-rwa-buryo, kiine Omwanya ogurikwera gwa MUKAMA ahagati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.10"
              },
              "items": [
                {
                  "text": "Ezk 44:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekyo kiryaba eky'abanyamurwa abashoroirwe, beene Zadoki, abaarinzire ebi naabakwatsize, abatarahabire, obu Abaisraeli baahaba, nk'oku Abaleevi baahabire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guryaba omugabo gwabo ogu bacumiirwe ogwihirwe omuri ekyo kicweka ky'enki ekirikwera, ekiheereraine n'ekicweka ky'Abaleevi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.5"
              },
              "items": [
                {
                  "text": "Ezk 45:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahaheereraine n'ekicweka ky'abanyamurwa, Abaleevi baryaheebwa omugabo gwa mikono obukumi bubiri n'enkumi itaano oburaingwa, n'obukiika mikono kakumi. Oburaingwa bw'ekyo kicweka kyona buryaba mikono obukumi bubiri n'enkumi itaano n'obukiika mikono obukumi bubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
