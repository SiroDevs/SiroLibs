                "loc": "ZEP.2.15"
              },
              "items": [
                {
                  "text": "Zef 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Raaba ndyahagira amariisizo g'engamira, n'endembo z'Abaamoni nzigire eizaagiriro ry'amasyo; haza obwo nibwo murimanya ku ndi MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.5",
            "verseOrgIds": [
              "EZK.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
