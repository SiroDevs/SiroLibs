                "loc": "EZK.21.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwana w'omuntu, ta amaisho aha Baamoni, obahanuurire ebiribabaho, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.2",
            "verseOrgIds": [
              "EZK.25.2"
            ]
          }
        },
