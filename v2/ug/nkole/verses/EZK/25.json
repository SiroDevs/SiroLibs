            "number": "13",
            "style": "v",
            "sid": "EZK 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikyo Mukama RUHANGA arikugirira ati: Ndyabangira Edomu omukono, ngimariremu kimwe abantu n'amatungo, mpagire amatongo, baitwe rurara okuruga Temani okuhika Dedani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.13",
            "verseOrgIds": [
              "EZK.25.13"
            ]
          }
        },
