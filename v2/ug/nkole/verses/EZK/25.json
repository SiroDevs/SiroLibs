              },
              "items": [
                {
                  "text": "26:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obagire oti: Muhurire ekigambo kay Mukama RUHANGA. Oku nikwo Mukama RUHANGA arikugamba naagira ati: Ahabw'okugira oti: Otyo! nooyesiima ahabw'Omwanya gwangye ogurikwera kushiishwa, n'ensi ya Israeli kuhinduka amatongo, n'enju ya Yuda kutwarwa omu bukwatwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.3",
            "verseOrgIds": [
              "EZK.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.3"
              },
              "items": [
                {
                  "text": "Bar 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nikyo ndikwija kubaheerayo omu mikono y'ab'oburugwa-izooba, bakabakubuura; kandi baryabateeramu ensiisira, babombekyemu amaka, barye ebijuma byanyu, banywe n'amate gaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.4",
            "verseOrgIds": [
              "EZK.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
