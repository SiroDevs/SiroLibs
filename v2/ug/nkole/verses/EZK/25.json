            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.12"
              },
              "items": [
                {
                  "text": "Isa 55:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba oku nikwo Mukama RUHANGA arikugamba naagira ati: Ahabw'okuteera omu ngaro nimwesiima, nimwemurika mwine okushemererwa ahabw'eitima ryona eri mwiniire ensi ya Israeli omu mitima yaanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.6",
            "verseOrgIds": [
              "EZK.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ahabw'ekyo reeba, nkubangiire omukono, kandi niinyija kukuhayo omu mikono y'amahanga kuba eminyago yaabo; bwanyima ndyakucwa omu mahanga, nkucwekyereze omu nsi, nkumareho; haza obwo nibwo orimanya ku ndi MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.7",
            "verseOrgIds": [
              "EZK.25.7"
            ]
          }
        }
      ]
