                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo Mukama RUHANGA arikugamba naagira ati: Nyowe ahabwangye ndyaiha eitaagi aha mutwe gw'omwereezi, ndibyare, ncwe akataagi koorobi akarikuhereerukayo aha mutwe gwayo, nkeebyarire nyenka aha mutwe gw'orushozi ruraingwa orutunguukire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
        },
