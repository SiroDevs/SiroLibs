          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.3+NUM.34.4+NUM.34.5+NUM.34.6+NUM.34.7+NUM.34.8+NUM.34.9+NUM.34.10+NUM.34.11+NUM.34.12"
              },
              "items": [
                {
                  "text": "Kub 34:3-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogu nigwo guriba omwatano gw'ensi. Aha rubaju rw'obukiizi-bwa-bumosho guryaruga aha Nyanja empango, gurabe Heselooni okuhika ah'orikutaahira nooza Hamasi, guhikye Zedadi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.15",
            "verseOrgIds": [
              "EZK.47.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Berosa, Siburaimu eri aha mwatano ogurikutaanisa Damasiko na Hamasi, n'okuhika Hazeri-hatikooni aha mwatano gwa Hauraani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.16",
            "verseOrgIds": [
              "EZK.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omwatano guryaruga aha nyanja, guhikye Hazarenooni eri aha mwatano gwa Damasiko ogw'aha bukiizi-bwa-bumosho, gwatane n'ogwa Hamasi aha bukiizi-bwa-bumosho. Ogwo nigwo guriba omwatano ogw'aha rubaju rw'obukiizi-bwa-bumosho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        }
      ]
    },
