              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.8"
              },
              "items": [
                {
                  "text": "Zek 14:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Kush 22:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yangarura aha muryango gwa hekalu, naareeba amaizi nigaruga ahansi y'ekisasi kyayo, nigatoora oburugwa-izooba, (ahabw'okuba hekalu niyo yaabaire neereeba); kandi ago maizi gakaba nigaruga okuzimu, nigashuumira aha rubaju rwa buryo iwa hekalu, nigaraba aha bukiizi-bwa-buryo bw'eitambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.1",
            "verseOrgIds": [
              "EZK.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo yanshohoreza omu irembo ry'aha bukiizi-bwa-bumosho, yanziguurutsya, yampitsya aha iremb ry'aheeru eririkureeba oburugwa-izooba; naashanga ago maizi nigashohorera aha rubaju rwayo rwa buryo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.3"
              },
              "items": [
                {
                  "text": "Ezk 40:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo muntu yaatoora aha rubaju rw'oburugwa-izooba, naagyera aine omu ngaro omugoye gw'okugyeresa, yaagyera mikono rukumi, yaanyambutsya omuri ago maizi, naashanga nigahika aha bugombamburi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaagyera mikono rukumi, yaanyambutsya, naashanga nigahika omu maju. Yaagaruka yaagyera mikono rukumi, aho naashanga nigakwata omunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.4",
            "verseOrgIds": [
              "EZK.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaagyera mikono rukumi; aho gwaba omugyera ogu ntarikubaasa kwambuka; ahabw'okuba maizi gakaba gaijwire, gari ag'okuziha, omugyera ogutarikwambukwa n'amaguru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangira ati: Mwana w'omuntu, ekyo waakireeba?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yangarurayo, yandabya aha nkungu y'omugyera; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Kush 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku naabaire ningarukayo naareeba ebiti bingi aha mbaju zombi z'omugyera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.7",
            "verseOrgIds": [
              "EZK.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.17"
              },
              "items": [
                {
                  "text": "Bir 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yangira ati: Amaizi aga nigahimintika nigatoora oburugwa-izooba, nigashuuma omuri Araba; ku garaahikye omu g'enyanja agatarikugyenda, ago maizi g'enyanja nigaija kuba marungi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ei ogwo mugyera gurihika yoona, ebihuriire byona biryagira amagara; kandi haryabamu eby'enyanja bingi munonga, ahabw'okuba amaizi ago nigaza omu nyanja, ngu ago maizi g'enyanja gabe marungi; n'ahabw'ekyo ei ogwo mugyera gurihika yoona, buri kintu kiryagira amagara. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.9",
            "verseOrgIds": [
              "EZK.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.6"
              },
              "items": [
                {
                  "text": "Kub 34:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abajubi baryayemerera aha rubaju rw'enyanja; okuruga Eni-geedi okuhika Enegulaimu haryabaho okutega obutimba; haryababamu eby'enyanja by'emiringo mingi munonga, nk'eby'omu Nyanja empango. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.10",
            "verseOrgIds": [
              "EZK.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka amaizi g'omu bisharara byayo n'ag'omu myanya yaayo yorutenga tigariba marungi; garyatsigwaho kwihwamu omwonyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.11",
            "verseOrgIds": [
              "EZK.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.1.3"
              },
              "items": [
                {
                  "text": "Zab 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.8"
              },
              "items": [
                {
                  "text": "Yer 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Kush 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi aha nkungu z'aha mbaju zombi z'ogwo mugyera haryamera ebiti by'emiringo yoona eby'ebijuma ebirikuriibwa. Amababi gaabyo tigarihotoka, n'ebijuma byabyo tibirihunduura, kureka ebyo biti biryaguma nibyana buri kwezi; ahabw'okuba amaizi gaabyo nigaruga omu Mwanya ogurikwera. Ebijuma byabyo biryaba eby'okurya, n'amababi gaabyo gabe ag'okutamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
