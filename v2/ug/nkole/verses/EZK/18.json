          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabw'okuteekateeka akahinduka, akareka eby'okushiisha ebi yaakozire, buzimazima aryagumaho, trifa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.28",
