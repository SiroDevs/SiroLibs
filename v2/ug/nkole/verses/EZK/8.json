          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yantwara ah'orikutaahira nooza omu irembo ry'aha bukiizi-bwa-bumosho ery'enju ya MUKAMA; kandi reeba, hakaba hashutamiyo abakazi nibacurira Tamuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangira ati: Mwana w'omuntu 'we, ebyo waabireeba? Noija kureeba ebindi bihagaro ebirikukira ebyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.15",
            "verseOrgIds": [
              "EZK.8.15"
            ]
          }
        }
      ]
    },
