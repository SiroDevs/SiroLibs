                "loc": "2CO.12.2"
              },
              "items": [
                {
                  "text": "2 Kor 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagorora ekirikushusha omukono, yaakwata obutsibo bw'eishokye ryangye, Omwoyo yankiriza, yampitsya ahagati y'ensi n'eiguru, yantwara Yerusaalemu ndi omu kworekwa kwa Ruhanga, yampitsya ah'orikutaahira nooza omu irembo ry'ekikaari ky'omunda, ekirikureeba aha bukiizi-bwa-bumosho, ahu ekitebe kye'kishushani ekirikugwisa kubi Ruhanga kyabaire kir. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.3",
            "verseOrgIds": [
              "EZK.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.23"
              },
              "items": [
                {
                  "text": "Ezk 3:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi reeba, ekitiinisa kya Ruhanga wa Israeli kikaba kiri okwo, nk'oku naakyorekyeirwe omu ruhita.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.4",
            "verseOrgIds": [
              "EZK.8.4"
            ]
          }
        }
      ]
