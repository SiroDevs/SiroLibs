            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwaka gwa mukaaga, omu kwezi kwa mukaaga aha kiro kyakwo kya kataano, nkaba nshutami omu nju yangye, abakuru ba Yuda banshutami omumaisho; omukono gwa Mukama RUHANGA gwampikiraho okwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.1",
            "verseOrgIds": [
              "EZK.8.1"
            ]
          }
        },
