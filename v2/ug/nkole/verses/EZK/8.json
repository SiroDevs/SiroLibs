              },
              "items": [
                {
                  "text": "Dan 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku naagiire kugira nti, naareeeba orikushusha omuntu; okwiha omu bwezirikiro bwe okugarura ahansi gukaba guri omuriro; kandi okwiha omu bwezirikiro bwe okugarura ahaiguru nihengyengyeta nk'omuringa ogweziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.2",
            "verseOrgIds": [
              "EZK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
