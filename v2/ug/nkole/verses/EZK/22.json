            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuriiwe abazaire tibarikweteebwaho, nibagaywa; abashuuhuuki nibaitwa kubi, kandi efuuzi n'abafaakazi nibakorwa kubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.7",
            "verseOrgIds": [
              "EZK.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
