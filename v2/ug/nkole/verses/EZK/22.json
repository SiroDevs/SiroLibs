            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuriiwe harimu abantu abarikubeiherera abandi ngu baitwe; mwine abandi abarikuriira aha nshozi, n'abandi abarikukorera omuriiwe eby'obushambani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.9",
