                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okagaya ebintu byangye ebirikwera, waashiisha sabato zangye. ",
          "type": "text",
          "attrs": {
