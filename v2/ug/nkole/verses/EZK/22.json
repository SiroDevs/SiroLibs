          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo Mukama RUHANGA, arikugirira ati: Ahabw'okuhinduka enkamba mwena, nikyo ndibateeranirira omuri Yerusaalemu ahagati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.19",
            "verseOrgIds": [
              "EZK.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'oku abantu bateeranira efeeza, emiringa, ebyma, rusasi n'eibaati omu iziiko, bakabijugutirira omu muriro kubiyazya, naimwe nikwo ndibateeranira hamwe mbagwereirwe kubi, kandi mbainiire ekiniga, nkabata omu iziiko, nkabayazya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.20",
            "verseOrgIds": [
              "EZK.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eego ndyabateeranira hamwe, mbajugutiririreho omu muriro gw'ekiniga kyangye, muyagire ahagati yaaryo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.21",
            "verseOrgIds": [
              "EZK.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'oku efeeza eyagira ahagati y'eiziiko, naimwe nikwo muriyagira mutyo ahagati yaaryo; kandi muryamanya ku nyowe MUKAMA nshukire ekiniga kyangye ahariimwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.22",
            "verseOrgIds": [
              "EZK.22.22"
            ]
