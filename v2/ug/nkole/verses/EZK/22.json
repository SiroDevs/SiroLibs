              },
              "items": [
                {
                  "text": "Dan 9:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eshagama ei waaseesire ekureeteire kugiibwaho orubanja, n'ebishushani ebi waakozire byakushiisha. Oiriize haihi obunaku bwawe, kandi n'obunaku bw'emyaka yaawe eyaatairweho buhikire. Nikyo nkuhinduriire ekijumo aha mahanga n'eky'okugaaniiza omu nsi zaago zoona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.4",
            "verseOrgIds": [
              "EZK.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuri haihi n'abkuri hare baryakugaaniiza, iwe rurangaanwa oijwire okujagarara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.5",
            "verseOrgIds": [
              "EZK.22.5"
            ]
          }
        }
      ]
