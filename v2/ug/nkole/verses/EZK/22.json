            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuriiwe harimu abarikujweka busha baishebo, kandi omuriiwe harimu abarikuhamba abakazi bari omu kwezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.10",
