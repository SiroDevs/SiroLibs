              "items": [
                {
                  "text": "23:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ogire oti: Oku nikwo Mukama RUHANGA arikugamba naagira ati: Reeba, orurembo orusheesha eshagama ahagati yaarwo ngu obunaku bwarwo buhikye, kandi orwekorera ebishushani ebirikuramibwa kweshiisha! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.3",
            "verseOrgIds": [
              "EZK.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 22:4"
          },
          "items": [
