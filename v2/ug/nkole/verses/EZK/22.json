          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.21.25"
              },
              "items": [
                {
                  "text": "Ezk 21:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
