                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu omutima gwawe guryabaasa kugumisiriza, n'emikono yaawe egire amaani, aha izooba eri ndikutuririaho ebi waakozire? Nyowe MUKAMA niinye naakigamba, kandi ndyakikora. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.14",
            "verseOrgIds": [
              "EZK.22.14"
            ]
          }
        },
        {
