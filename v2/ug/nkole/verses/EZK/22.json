              "type": "text"
            }
          ]
        },
        {
          "text": " Naiwe Mwana w'omuntu, nooyenda kucwa orubanja, kurucwera oruremob orurikusheesha eshagama? Mbwenu nu rumanyise ebihagaro byarwo byona, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.2",
            "verseOrgIds": [
              "EZK.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
