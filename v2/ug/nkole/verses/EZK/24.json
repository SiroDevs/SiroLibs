          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kay MUKAMA kyagaruka kyanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.15",
            "verseOrgIds": [
              "EZK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana w'omuntu, reeba, naaza kukwihaho eki otuuzaho amaisho ahonaaho; kwonka otacura n'obu kwakuba okurira, kandi amarira gatakufukunkuka omumaisho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.16",
            "verseOrgIds": [
              "EZK.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
