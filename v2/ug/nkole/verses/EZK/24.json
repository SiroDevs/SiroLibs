                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naimwe muryatwaza nk'oku ntwarize; timurishweka aha minwa, n'obu kwakuba okurya eby'okurya by'abari omu rufu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.22",
            "verseOrgIds": [
              "EZK.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebitambaara biryabaguma aha mitwe, n'enkaito zibagume omu bigyere; timuricura n'obu kwakuba okurira, kureka muryahwa aha magufa ahabw'eby'okutahikiirira byanyu, buri muntu atonzye na mugyenzi we. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.23",
            "verseOrgIds": [
              "EZK.24.23"
            ]
          }
        },
