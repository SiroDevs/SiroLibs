                {
                  "text": "Yer 39:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwana w'omuntu, handiika eiziina ry'eri izooba ryonka; ahakuba eri izooba omugabe wa Babulooni yaagota Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.2",
            "verseOrgIds": [
              "EZK.24.2"
            ]
          }
        },
