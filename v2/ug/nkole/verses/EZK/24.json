          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanye nikwo kubagira nti: Ekigambo kya MUKAMA kinyizireho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.20",
