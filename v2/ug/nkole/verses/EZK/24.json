              "items": [
                {
                  "text": "Hos 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tsinda, kwonka otahurirwa; otacurira ofiire; yezingirire ekitambaara, ojware enkaito, otashweka aha minwa n'obu kwakuba okurya eby'okurya nk'eby'abari omu rufu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.17",
            "verseOrgIds": [
              "EZK.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntyo omu kasheeshe naagambira abantu, omu mwabazyo omukazi wangye yaafa. Ku bwaseesire, naatwaza nk'oku ndagiirwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.18",
            "verseOrgIds": [
              "EZK.24.18"
            ]
          }
        }
