                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima abantu bambuuza bati: Tokaatugambira ebintu ebi ebyakureetera kutwaza otyo, eki birikutumanyisa? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.19",
