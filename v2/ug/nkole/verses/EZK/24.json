            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omu mwaka gwa mwenda omu kwezi kwa ikumi aha kiro kyakwo kya ikumi, ekigambo kya MUKAMA kikanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
