              "type": "text"
            }
          ]
        },
        {
          "text": " Ku naagiire kugira nti, naareeba omukono gungororoirwe; kandi reeba, gukaba gwine omuzingo gw'ekitabo; ",
          "type": "text",
          "attrs": {
