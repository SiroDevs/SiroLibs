              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yangira ati: Mwana w'omuntu, imuka oyemerere, ngambe naiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.1",
            "verseOrgIds": [
