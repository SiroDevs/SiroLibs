            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi bo, yaaba bahurira, yaaba banga, (ahabw'okuba n'ab'enju engomi,) kwonka nibaija kumanya ku nabi abaire abarimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.5",
            "verseOrgIds": [
              "EZK.2.5"
            ]
