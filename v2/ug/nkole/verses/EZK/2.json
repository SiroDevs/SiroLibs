              },
              "items": [
                {
                  "text": "Yer 3:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nangira ati: Mwana w'omuntu, ninkutuma aha bantu ba Israeli, eihnaga ry'abagomi abangomeire; bo na baishenkurubo bakancumuraho n'okuhitsya eri izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.3",
            "verseOrgIds": [
              "EZK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
