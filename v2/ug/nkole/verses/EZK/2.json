                {
                  "text": "Ezk 3:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ky yangambiire, Omwoyo yantaahamu, yaanyemereza, naahurira ogwo owaabaire naagamba naanye, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.2",
            "verseOrgIds": [
              "EZK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
