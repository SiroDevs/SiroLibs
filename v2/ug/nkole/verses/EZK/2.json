                {
                  "text": "Ezk 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo bantu n'abanyarubwa, baine emitima egangaire. Abo nibo ndikukutumaho; ku oraabahikye, obagire oti: Oku nikwo Mukama RUHANGA arikugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.4",
            "verseOrgIds": [
              "EZK.2.4"
            ]
          }
        },
