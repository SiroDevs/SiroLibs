              "items": [
                {
                  "text": "Kub 18:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yangira ati: Ebyo bishengye by'aha rubaju rw'obukiizi-bwa-bumosho n'orwa buryo ebishungaine n'ekibuga n'ebishengye ebirikwera, omu abanyamurwa abahika MUKAMA baririira empongano ezirikwera munonga; okwo niyo bariguma nibata empongano ezirikwera munonga, empongano z'esaano, empongano y'ekibi, n'empongano y'okwihaho orubanja rw'ekibi, ahabw'okuba ogwo mwanya n'ogurikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.19"
              },
              "items": [
                {
                  "text": "Ezk 44:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.6.11"
              },
              "items": [
                {
                  "text": "Lev 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abanyamurwa ku bariguma baataaha omu Mwanya ogurikwera, tibarishohora kuza omu kibuga ky'aheeru, batabandize kujuura bijwaro ebi bajwara nibaheereza, bakabibiika, ahabw'okuba n'ebirikwera. Kandi ku bariba batakahikire mpongano z'abantu, bajware ebindi bijwaro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        }
      ]
    },
