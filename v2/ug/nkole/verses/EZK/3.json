              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo biro mushanju ku byahweire, ekigambo kya MUKAMA kyanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.16",
            "verseOrgIds": [
              "EZK.3.16"
            ]
          }
        },
        {
          "name": "verse",
