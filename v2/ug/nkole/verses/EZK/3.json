                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwoyo yankiriza, yantwara, naagyenda ngwirwe kubi, nyine ekiniga kingi; kandi omukono gwa MUKAMA gukaba gungumize; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.14",
            "verseOrgIds": [
              "EZK.3.14"
            ]
          }
        },
