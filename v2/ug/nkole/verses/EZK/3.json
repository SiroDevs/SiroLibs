                  "text": "Ezk 33:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwana w'omuntu, nkugizire omurinzi w'enju ya Israeli; ku oraagume waahurira ekigambo ekirikuruga omu kanwa kangye, obanteisize. ",
          "type": "text",
          "attrs": {
