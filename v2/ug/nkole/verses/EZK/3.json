                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nikwo kuhoorera kw'amapapa g'ebyo bihangirwe ebiine amagara nigakoranaho, n'okuhoorera kw'ezo nziga aha rubaju rwabyo okurikushusha okurigita kw'omutsitsa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
