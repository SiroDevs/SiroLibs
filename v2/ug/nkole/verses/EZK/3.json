              "items": [
                {
                  "text": "Zab 137:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naahika Telabiibu, naashanga abaabaire batwairwe omu bukwatwa, batwire aha mugyera Kebari, naamarayo ebiro mushanju nshutami ahagati yaabo nshobeirwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
