              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yangira ati: Mwana w'omuntu, rya ogu muzingo ogu naakuha, ogwojuze omu nda yaawe. Ahonaaho naagurya; omu kanwa gwannurira nk'obwoki.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        }
