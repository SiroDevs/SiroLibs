            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Omwoyo yankiriza; ekitiinisa kya MUKAMA ku kyabaire nikikiimuka omu mwanya gwakyo, naahurira okuhoorera kwingi munonga; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.12",
