              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yangira ati: Mwana w'omuntu, rya eki waaheebwa, orye ogu muzingo, ogyende, ogambire enju ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntyo naayashama, yampa ogwo muzingo kugurya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.2",
            "verseOrgIds": [
              "EZK.3.2"
            ]
          }
        },
