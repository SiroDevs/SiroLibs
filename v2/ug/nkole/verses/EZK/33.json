              "items": [
                {
                  "text": "Ezk 18:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ekindi, n'obu naakugambira omubi nti: Buzimazima oryafa, kwonka ku arihinduka, yaareka ekibi kye, kyaakora eby'ebiragiro kandi ebihikire, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.14",
            "verseOrgIds": [
              "EZK.33.14"
            ]
          }
        },
