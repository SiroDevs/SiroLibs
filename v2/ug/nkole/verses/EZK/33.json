              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ekigambo kya MUKAMA kikanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.1",
            "verseOrgIds": [
              "EZK.33.1"
            ]
