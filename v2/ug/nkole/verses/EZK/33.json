              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka abantu baawe nibagira bati: Emitwarize ya MUKAMA tehikire; haza eyaabo niyo etahikire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.17",
