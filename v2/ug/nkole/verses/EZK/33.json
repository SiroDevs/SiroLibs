                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka nimugira muti: Emitwarize ya MUKAMA tehikire. Imwe nju ya Israeli 'mwe, ndyabacwera orubanja, buri muntu nk'oku emitwarize ye eri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.20",
