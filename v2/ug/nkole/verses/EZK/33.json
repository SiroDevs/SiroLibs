          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.19"
              },
              "items": [
                {
                  "text": "Ezk 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.16"
              },
              "items": [
                {
                  "text": "1 Tim 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku orihana omubi ngu arekye omuhanda gwe omubi, yaayanga kugureka, aryafeera omu by'okushiisha bye, kwonka iwe oryaba okirize amagara gaawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.9",
            "verseOrgIds": [
              "EZK.33.9"
            ]
