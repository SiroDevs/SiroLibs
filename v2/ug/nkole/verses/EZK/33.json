                "loc": "EZK.3.11"
              },
              "items": [
                {
                  "text": "Ezk 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwana w'omuntu, gambira abantu baawe, obagire oti: Ku ndireeta rurara omu nsi, abantu b'egyo nsi baayeihamu omuntu, baamugira omurinzi waabo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.2",
            "verseOrgIds": [
              "EZK.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.3.6"
              },
              "items": [
                {
                  "text": "Amo 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku arireeba rurara neija omu nsi, yaateera enzamba, yaagambira abantu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.3",
            "verseOrgIds": [
              "EZK.33.3"
            ]
          }
        },
        {
          "name": "verse",
