            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batyo bakwijaho nk'oku abantu baija, bashutama omu maisho gaawe nk'abantu bangye, bahurira ebi orikugamba, kwonka batarikwija kubikora; ahabw'okuba booreka okukunda kwingi n'eminwa yaabo, kwonka emitima yaabo eraramiire amagoba gaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.31",
            "verseOrgIds": [
              "EZK.33.31"
            ]
          }
        },
