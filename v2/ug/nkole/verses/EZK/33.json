          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohikiriire ku arihinduka, yaareka okuhikiirira kwe, yaakora eky'okushiisha, aryafa abizire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.18",
            "verseOrgIds": [
              "EZK.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omubi ku arihinduka, yaareka obubi bwe, yaakora eby'ebiragiro kandi ebihikire, biryamubaisaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.19",
            "verseOrgIds": [
              "EZK.33.19"
            ]
          }
        },
        {
