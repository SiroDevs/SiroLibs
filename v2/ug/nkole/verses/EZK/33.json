                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naiwe Mwana w'omuntu, nkutaireho kuba omurinzi w'enju ya Israeli; n'ahabw'ekyo hurira ekigambo ekirikuruga omu kanwa kangye, obampanire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.7",
            "verseOrgIds": [
              "EZK.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ndigira omubi nti: Iwe mubi 'we, buzimazima oryafa, naiwe otaagamba, okahana ogwo mubi ngu arekye omuhanda gwe omubi, omubi ogwo aryafeera omu by'okushiisha bye, kwonka eshagama ye niiwe ndigibuuza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.8",
            "verseOrgIds": [
              "EZK.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
