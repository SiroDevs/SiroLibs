              "items": [
                {
                  "text": "Byak 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obwo omuntu weena ku arihurira eiraka ry'enzamba, ataayeta hari okwo kubuura, rurara yaija, yaamwita, eshagama ye niwe eribarirwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.4",
            "verseOrgIds": [
              "EZK.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba akahurira eiraka ry'enzamba, tiyaaryetaho; eshagama ye eryamubarirwa. Ahabw'okuba kuri yaaryetaireho, akaajunire amagara ge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.5",
            "verseOrgIds": [
              "EZK.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.18"
              },
              "items": [
                {
                  "text": "Ezk 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka omurinzi, ku arireeba rurara neija, ataateera nzamba kugambira abantu, rurara yaija, yaabaitamu omuntu, omuntu ogwo aryaitirwa omu by'okushiisha bye; kwonka eshagama ye ndyagibuuza ogwo murinzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.6",
            "verseOrgIds": [
              "EZK.33.6"
            ]
          }
        }
      ]
    },
