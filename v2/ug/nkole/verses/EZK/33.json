                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.5"
              },
              "items": [
                {
                  "text": "Byak 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwana w'omuntu, abatwire omu myanya y'omu nsi ya Israeli eyaatsigirweho batuura nibagira bati: Abrahamu akaba ari omuntu omwe wenka, kwonka yaakubuura ensi; mbwenu itwe turi baingi; buzimazima egi nsi tugihairwe kuba eyaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.24",
            "verseOrgIds": [
              "EZK.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
