              "attrs": {
                "loc": "JER.44.22"
              },
              "items": [
                {
                  "text": "Yer 44:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ensi ndyagihindura amatongo, ebe eihamba, amaani g'amaryo gaayo gahwereho kimwe; n'ebibungo bya Israeli bibeere kimwe amatongo, harekye kugira owaarabamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.28",
            "verseOrgIds": [
              "EZK.33.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ndi heza kuhindura ensi amatongo, yaaba eihamba nimbatura ebihagaro byabo byona ebi baakozire, nibwo barimanya ku ndi MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.29",
            "verseOrgIds": [
              "EZK.33.29"
            ]
          }
        }
      ]
