          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.13"
              },
              "items": [
                {
                  "text": "Ezk 18:13",
                  "type": "text"
