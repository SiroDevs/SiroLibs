      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JAS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.1",
            "verseOrgIds": [
              "JAS.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.24"
              },
              "items": [
                {
                  "text": "Luk 6:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu naimwe abatungi, murire, muboroogye ahabw'enaku ezi mwaza kureeba. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.1",
            "verseOrgIds": [
              "JAS.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JAS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.19"
              },
              "items": [
                {
                  "text": "Mat 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obutungi bwanyu bujunzire, n'ebijwaro byanyu biriirwe ebiyenje. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.2",
            "verseOrgIds": [
              "JAS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JAS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezaabu zaanyu n'efeeza zikyereenyire, n'omukyereenyo gwazo guryabashinja, kandi gurye emibiri yaanyu nk'omuriro. Mukeebiikira eitungo ahabw'ebiro by'aha muheru. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.3",
            "verseOrgIds": [
              "JAS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.5"
              },
              "items": [
                {
                  "text": "Mal 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, ebihembo byabagyesi b'emisiri yaanyu, ebi mwabaimire ahabw'obugobya, nibibarega; kandi n'okurira kw'abashaaruuzi kuhikire omu matu ga Mukama ow'amahe. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.4",
            "verseOrgIds": [
              "JAS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.19"
              },
              "items": [
                {
                  "text": "Luk 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mukatuura omu nsi omu kwegira gye n'omu kweshemeza; mukahaazya emitima yaanyu aha kiro ky'okwitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.5",
            "verseOrgIds": [
              "JAS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukacwera ohikiriire orubanja, mwamwita, tiyaabangira.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.6",
            "verseOrgIds": [
              "JAS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.6",
            "verseOrgIds": [
              "JAS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.7",
            "verseOrgIds": [
              "JAS.5.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.23"
              },
              "items": [
                {
                  "text": "Yoel 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.36"
              },
              "items": [
                {
                  "text": "Heb 10:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo B'eishe-emwe, mugumisirize okuhitsya ahu Mukama waitu ariizira. Reeba, omuhingi ategyereza emyaka ei yaahingire ey'obuguzi bwingi, agigumisiririza okuhitsya obu etunga enjura ey'eibiba n'eya katumba. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.7",
            "verseOrgIds": [
              "JAS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naimwe mugumisirize. Mugumye emitima yaanyu; ahabw'okuba okwija kwa Mukama wiatu kuru haihi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.8",
            "verseOrgIds": [
              "JAS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "B'eishe-emwe, mutaryetomboiterana, nyentsya mutaricwerwa orubanja; reeba, Omucwi w'emanja ayemereire aha rwigi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.9",
            "verseOrgIds": [
              "JAS.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.12"
              },
              "items": [
                {
                  "text": "Mat 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " B'eishe-emwe, baanabi abaabagambiire omu iziina rya Mukama, mubatware nk'eky'okureeberaho eky'okubonabona n'okugumisiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.10",
            "verseOrgIds": [
              "JAS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.21"
              },
              "items": [
                {
                  "text": "Yob 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.103.8"
              },
              "items": [
                {
                  "text": "Zab 103:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumanye ngu abagumisiriza tubeeta abahiiriirwe. Mukahurira aha kugumisiriza kwa Yobu, kandi mwareeba eki Mukama yaagyendereire, oku aine embabazi nyingi n'okusaasira.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.11",
            "verseOrgIds": [
              "JAS.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.11",
            "verseOrgIds": [
              "JAS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.12",
            "verseOrgIds": [
              "JAS.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.34+MAT.5.35+MAT.5.36+MAT.5.37"
              },
              "items": [
                {
                  "text": "Mat 5:34-37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ekirikukira byona, B'eishe-emwe, mutarirahira eiguru n'obu yaakuba ensi nari okundi kurahira kwona, kureka ekigambo kyanyu kibe Eego, Eego, nari Ngaaha, Ngaaha; mutakaagyibwaho orubanja.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.12",
            "verseOrgIds": [
              "JAS.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.12",
            "verseOrgIds": [
              "JAS.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuriimwe harimu orikushaasha? Ashabe. Harimu oshemereirwe? Ayeshongore eby'okuhimbisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.13",
            "verseOrgIds": [
              "JAS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.13"
              },
              "items": [
                {
                  "text": "Mak 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuriimwe harimu orwaire? Atume aha bakuru b'ekanisa, bamushabire, bamusiigye amajuta omu iziina rya Mukama; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.14",
            "verseOrgIds": [
              "JAS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.18"
              },
              "items": [
                {
                  "text": "Mak 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'okushaba okurimu okwikiriza kuryakiza ogwo orwaire, Mukama amwimutsye; kandi ku araabe aine ebibi ebi akozire, aryabisaasirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.15",
            "verseOrgIds": [
              "JAS.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo mweteisizane ebibi byanyu, kandi mushabirane, mubone kukira. Okushaba kw'ohikiriire kugira amaani maingi omu kukora kwakwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.16",
            "verseOrgIds": [
              "JAS.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.25"
              },
              "items": [
                {
                  "text": "Luk 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Bag 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eliya akaba ari omuntu nkaitwe; yaashaba munonga ngu enjura erekye kugwa; n'enjura yaamara emyaka eshatu n'ameezi mukaaga etarikugwa ha nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.17",
            "verseOrgIds": [
              "JAS.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.42"
              },
              "items": [
                {
                  "text": "1 Bag 18:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagaruka yaashaba, eiguru ryagwisa enjura, eitaka ryameza emyaka yaaryo.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.18",
            "verseOrgIds": [
              "JAS.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
