          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba ekiniga ky'omuntu tikikora by'okuhikiirira kwa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.20",
            "verseOrgIds": [
              "JAS.1.20"
            ]
