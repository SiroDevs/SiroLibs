              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki nimukimanya, B'eishe-emwe abarikukundwa; omuntu weena arahukye kuhurira, kwonka atarahukiiriza kugamba, n'okugira ekiniga; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.19",
            "verseOrgIds": [
