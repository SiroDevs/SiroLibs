              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi mube abarikworobera Ekigambo, beitu ti kukihurira kwonka, mukeebeiha. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.22",
