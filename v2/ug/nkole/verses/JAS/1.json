              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba omuntu weena ku aba omuhurizi w'Ekigambo, ataakyorobera, ashusha nk'omuntu orikwereebera omu ndeeberwamu oku arikushusha ahamaisho; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.23",
            "verseOrgIds": [
