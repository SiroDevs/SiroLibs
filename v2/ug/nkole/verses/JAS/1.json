          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.5"
              },
              "items": [
                {
                  "text": "1 Yoh 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " engabirano yoona enungi n'ekiconco kyona ekihikire biruga omu iguru, nibishuuma okuruga ahari Isheboona, Omuhangi w'ebirikwaka, otahindahinduka na kakye, n'obu kwakuba okugira ekicuucu ekireetwa okuhinduka. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.17",
            "verseOrgIds": [
              "JAS.1.17"
            ]
          }
        },
