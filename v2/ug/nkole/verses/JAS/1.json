            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okukunda kwe akatuzaaza ekigambo ky'amazima, ngu tube nk'emijigaijo y'ebi yaahangire.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.18",
