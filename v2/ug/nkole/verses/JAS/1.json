                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimumanya ngu omu kasheeshe eizooba riija n'omushana gurigwotsya, guhonzya obunyaatsi, orurabyo rwabwo ruragara, n'oburungi bwabwo buhwaho. Nikwo n'omuntungi arihunduuka omu mihanda ye.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
            ]
          }
        }
      ]
    },
    {
