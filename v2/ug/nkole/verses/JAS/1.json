                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yakobo, omuhuuku wa Ruhanga na Mukama waitu Yesu Kristo, naabahandiikira nimbaramutsya, imwe enganda ikumi na ibiri ezaataataine.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
