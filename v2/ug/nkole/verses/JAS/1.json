              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "akiheza kwereeba, yaagyenda, ahonaaho akeebwa oku arikushusha. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.24",
            "verseOrgIds": [
              "JAS.1.24"
            ]
          }
        },
