              "JAS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.18",
            "verseOrgIds": [
              "JAS.2.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.6"
              },
              "items": [
                {
                  "text": "Gal 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Shana omuntu akaagira ati: Iwe oine okwikiriza, nyow enyine okukora. Mbwenu nyoreka okwikiriza kwawe okutaine kukora; naanye nkworekye okwikiriza kwangye okurikureeberwa omu bi ndikukora. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.18",
            "verseOrgIds": [
              "JAS.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JAS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.5.7"
              },
              "items": [
                {
                  "text": "Mak 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iwe oikiriza ngu Ruhanga n'omwe; ekyo ni kirungi. Nangwa na baadaimoni bakiikiriza, nibatetema. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.19",
            "verseOrgIds": [
              "JAS.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe mushema 'we, nooyenda kworekwa okwikiriza okutaine kukora ku kuri okufiire? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.20",
            "verseOrgIds": [
              "JAS.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JAS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.9"
              },
              "items": [
                {
                  "text": "Kut 22:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Torikumanya ngu Abrahamu tatenkuriitwe akaihwaho orubanja ahabw'okukora, obu yaahayo omutabani Isaaka aha itambiro? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.21",
            "verseOrgIds": [
              "JAS.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JAS 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.17"
              },
              "items": [
