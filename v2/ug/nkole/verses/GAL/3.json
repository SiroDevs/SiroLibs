        },
        {
          "text": "Kwonka okwikiriza kutakaizire, tukaba turindirwa omu butegyeki bw'Ebiragiro, tutegyereze okwikiriza okwabaire nikwenda kushuuruurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.23",
            "verseOrgIds": [
