          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka mbwenu, nk'oku okwikiriza kwizire, titwakiri mu butegyeki bw'omurezi; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.25",
