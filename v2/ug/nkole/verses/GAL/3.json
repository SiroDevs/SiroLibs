          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo Ebiragiro bikatubeera omwegyesa w'okutuhitsya ahari Kristo, ngu tubone kwihwaho orubanja ahabw'okwikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.24",
            "verseOrgIds": [
              "GAL.3.24"
            ]
