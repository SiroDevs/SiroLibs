            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.10"
              },
              "items": [
                {
                  "text": "2 Kor 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga hati hatarigira owaagaruka kundusya, ahabw'okuba nyine enkojo za Yesu aha mubiri gwangye.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
        }
      ]
    },
