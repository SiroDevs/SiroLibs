        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.12"
              },
              "items": [
                {
                  "text": "1 Kor 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " B'eshe-emwe, nimwijuka okukora kwaitu n'okufa kubi kwaitu; tukaba tukora nyomushana na nyekiro, ngu tutagira ou twarusya omuriimwe, nitubabuurira engiri ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.9",
            "verseOrgIds": [
              "1TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe muri baakareebi, hamwe na Ruhanga, abarikuhamya emitwarize yaitu ahariimwe abarikwikiriza, ku yaabaire eri erikwera, ey'okuhikiirira, kandi etarikugaywa; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.10",
            "verseOrgIds": [
              "1TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.31"
              },
              "items": [
                {
                  "text": "Byak 20:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba nimumanya oku twabaire twehnangiriza omuntu weena omuriimwe nitubagumya, kandi nitubaragiira, nk'oku omushaija ahana abaana be, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.11",
            "verseOrgIds": [
              "1TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.5"
              },
              "items": [
                {
                  "text": "2 Tes 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ngu mutwaze nk'oku kishemereire aba Ruhanga orikubeeta kutaaha omu bukama bwe n'ekitinisa kye.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.12",
            "verseOrgIds": [
              "1TH.2.12"
            ]
          }
        }
      ]
    },
    {
