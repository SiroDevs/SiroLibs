      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.12",
            "verseOrgIds": [
              "1TH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hoona eki tusiimira Ruhanga obutoosha n'eki; ahakuba, ku mwahuriire ekigambo ky'engiri ya Ruhanga eki twabagambiire, mwakyakiira; kandi timwakyakiira nk'ekigambo ky'abantu, kureka nk'ekigambo kya Ruhanga ekirikukora omuriimwe abarikwikiriza; kandi omu mazima nikwo kiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.13",
            "verseOrgIds": [
              "1TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi, B'eishe-emwe, mukakuratira amakanisa ga Ruhanga aga Buyudaaya agari omuri Kristo Yesu; ahakuba ebi mwabonabonesiibwe beene waanyu bikashusha nk'ebi ab'ago makanisa baabonabonesiibwe Abayudaaya, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.14",
            "verseOrgIds": [
              "1TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.52"
              },
              "items": [
                {
                  "text": "Byak 7:52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " abaitsire Mukama waitu Yesu na baanabi, naitwe bakatubinga, bakagwisa kubi Ruhanga, bakaba abazigu b'abantu boona, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.32"
              },
              "items": [
                {
                  "text": "Mat 23:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nibatuzibira kubuurira Abanyamahanga eby'okujunwa, ngu babone kuhikiiriza batyo obutoosha orugyero rw'ebibi byabo. Kwonka ekiniga kya Ruhanga kiizire kubamariraho kimwe.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
