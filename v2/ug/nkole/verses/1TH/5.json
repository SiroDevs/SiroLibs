          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mubahe ekitiinisa munonga omuri rukundo ahabw'omurimo gwabo. Mugume mwine obusingye, omuntu na mugyenzi we. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.13",
            "verseOrgIds": [
              "1TH.5.13"
            ]
          }
        },
