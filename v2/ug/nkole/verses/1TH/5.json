                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " owaatufeereire ngu tugume nawe, yaaba tuhuriire nari tugwejegyeire. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.10",
            "verseOrgIds": [
              "1TH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo mugumyane, kandi mwombekane, nk'oku murikukora.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
