              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba nitubeeshengyereza, B'eishe-emwe, muteise entahurira, mugumye abahahaire emitima, muramire abataine maani, mugumisiririze boona. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.14",
