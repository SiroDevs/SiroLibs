            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka itwe, nk'oku turi aba nyomushana, twerinde ebirikusinza, tujware okwikiriza na rukundo nk'eky'okwekingiza omu kufuba, kandi n'amatsiko g'okujunwa nk'enkofiira. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.8",
            "verseOrgIds": [
              "1TH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumanye ngu Ruhanga taratuteereireho kiniga kureka okutunga okujunwa ahabwa Mukama waitu Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.9",
            "verseOrgIds": [
              "1TH.5.9"
            ]
          }
        },
        {
