                {
                  "text": "1 Pet 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwerinde hatagira omuntu weena omuriimwe owaihura ondiijo ekibi ahabw'kibi, kureka obutoosha mwezirikire okukorerana gye, n'okukorera gye abandi boona. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.15",
            "verseOrgIds": [
              "1TH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
