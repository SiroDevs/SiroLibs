            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka, nitubeeshengyereza, B'eishe-emwe, ku mumanya abo abarikubakoramu, abarikubategyeka omuri Mukama, bakabahabura, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.12",
            "verseOrgIds": [
              "1TH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
