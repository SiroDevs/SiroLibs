          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro byona tusiima Ruhanga ahabwanyu mwena, nitugamba aha maziina gaanyu omu kushaba kwaitu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.2",
            "verseOrgIds": [
              "1TH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.4"
              },
              "items": [
                {
                  "text": "Kol 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nitwijuka obutoosha omu maisho ga Ruhanga Tataitwe emirimo yaanyu erikuruga omu kwikiriza, n'okukora okurikuruga omu kukunda, n'okugumisiriza okurikuruga omu matsiko agu mwine omuri Mukama waitu Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.3",
            "verseOrgIds": [
              "1TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "B'eishe-emwe abarikukundwa Ruhanga, nitumanya ku yaabatooraine, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.4",
            "verseOrgIds": [
              "1TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.5"
              },
              "items": [
                {
                  "text": "1 Kor 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba engiri yaitu terabaiziire mu bigambo byonka, kureka omu maani n'omu Mwoyo Orikwera n'omu kwikiririza kimwe mutarikubanganisa. Naimwe nimumanya oku twabaire turi omuriimwe ahabw'okubahwera; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.5",
            "verseOrgIds": [
              "1TH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi obu mwayakiira ekigambo omu busaasi bwingi mwine okushemererwa okurikuruga omu Mwoyo Orikwera, mukatooreza emitwarize yaitu n'eya Mukama; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.6",
            "verseOrgIds": [
              "1TH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.3"
              },
              "items": [
                {
                  "text": "1 Pet 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'ahabw'ekyo mukahinduka eky'okureeberaho aha barikwikiriza boona ab'omuri Makedonia na Akaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.7",
            "verseOrgIds": [
              "1TH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba ekigambo kya Mukama nimwo kyarugire nikigambwa, ti muri Makedonia na Akaya zonka, kureka hoonahoona okwikiriza Ruhanga kwanyu kurangainwe; n'ahabw'ekyo titwine kindi eki tushemereire kubigambaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.8",
            "verseOrgIds": [
              "1TH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.2"
              },
              "items": [
                {
                  "text": "1 Kor 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba nabo bonka nibagamba ebyaitu, oku mwatwakiire, n'oku mwarekire ebishushani ebirikuramibwa, mukahindukira Ruhanga, okuheereza Ruhanga ogwo ohuriire, ow'amazima, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.9",
            "verseOrgIds": [
              "1TH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.13"
              },
              "items": [
                {
                  "text": "Tit 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'okutegyereza Omwana we kuruga omu iguru, ou yaazoire omu bafu, Yesu otujuna ekiniga ekirikwenda kwija.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.10",
            "verseOrgIds": [
              "1TH.1.10"
            ]
