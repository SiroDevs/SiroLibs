              "type": "text"
            }
          ]
        },
        {
          "text": " Paulo na Siluwaano na Timoseo twabahandiikira imwe ab'ekanisa y'aba Tesalonika, abari omuri Ruhanga Isheboona na Mukama waitu Yesu Kristo; nitubendeza embabazi n'obusingye.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
