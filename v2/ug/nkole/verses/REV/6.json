          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'eiguru ryaihwaho nk'oku omuzingo gw'ekitabo guzingwa, kandi enshozi zoona n'ebirwa byona byaihwa omu myanya yaabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
