            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaabambwire akamanyiso aka mukaga, naareeba omutsitsa mwingi; eizooba ryairagura nk'ekiguniya ky'obwoya oburikwiragura, n'okwezi kwahinduka nk'eshagama, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
