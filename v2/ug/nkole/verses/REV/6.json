            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nibatakira enshozi n'enkiri, bati: Mutugwere, mutusherekye amaisho g'Ogwo oshutami aha kitebe ky'obukama, n'ekiniga ky'Omwana gw'entaama; ",
          "type": "text",
