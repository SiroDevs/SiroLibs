                "loc": "ISA.34.4"
              },
              "items": [
                {
                  "text": "Isa 34:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'enyonyoozi z'ahaiguru zaagwa aha nsi, nk'oku omutiini guragaza ebijuma byagwo bitakahiisize, gwatengyetsibwa omuyaga mwingi; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
