              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi n'abagabe b'ensi, n'abakungu, n'abakuru b'engabo, n'abatungi, n'ab'obushoboorozi n'abantu boona, abahuuku n'ab'obusingye, baayeshereka omu nyanga n'omu nkiri z'omu nshozi, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
          }
        },
        {
