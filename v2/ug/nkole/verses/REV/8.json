            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.25"
              },
              "items": [
                {
                  "text": "Yer 51:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maraika owa kabiri yaateera eye; ekintu ekirikushusha orushozi ruhango orurikwaka omuriro kyanagwa omu nyanja; ekicweka kya kashatu ky'enyanja kyahinduka eshagama; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ekicweka kya kashatu ky'ebihangirwe eby'omu nyanja ebiine amagara kyafa; kandi n'ekicweka kya kashatu ky'emeeri zoona kyacwekyerezibwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
