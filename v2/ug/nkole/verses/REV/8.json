    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana gw'entaama ku yaabambwire akamanyiso ka mushanju, haabaho akaceceko omu iguru okumara nk'ekicweka ky'eshaaha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.31"
              },
              "items": [
                {
                  "text": "Mat 24:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima naareeba baamaraika mushanju abeemerera omu maisho ga Ruhanga, kandi baaheebwa enzamba mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.8"
              },
              "items": [
                {
                  "text": "Kush 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Haija maraika ondiijo, yaayemerera aha itambiro, aine ekyoterero ky'ezaabu; yaaheebwa obubaane bwingi bw'okwotera eby'okushaba by'abarikwera boona, ngu abyoterere aha itambiro ry'ezaabu omu maisho g'ekitebe ky'obukama; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "omwika gw'obubaane gwainamuka n'eby'okushaba by'abarikwera omu maisho ga Ruhanga, niguruga omu mukono gwa maraika. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.16"
              },
              "items": [
                {
                  "text": "Kur 19:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maraika yaakwata ekyoterero, yaakiijuza omuriro gw'aha itambiro, yaakinaga aha nsi; haabaho okuhinda n'amaraka n'emirabyo n'omutsitsa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
      ]
    },
    {
