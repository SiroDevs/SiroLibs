              "items": [
                {
                  "text": "Yoel 2:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maraika ow'okubanza yaateera enzamba ye: haabaho orubaare n'omuriro birimu eshagama, byagwa aha nsi; ekicweka kya kashatu eky'ensi kyasya, n'ekicweka kya kashatu ky'ebiti kyasya, n'obunyaatsi bwona obubisi bwasya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        }
