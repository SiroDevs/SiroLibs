              },
              "items": [
                {
                  "text": "Kur 19:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'ebyo, ku naimukize amaisho, naareeba orwigi rwigwire omu iguru, kandi naahurira eiraka eri naabandize kuhurira nk'ery'enzamba, nirigira riti: Inamuka oije kunu, nkworekye ebishemereire kubaho bwanyima. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.1"
              },
              "items": [
                {
                  "text": "Isa 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho naashanga ndi omu Mwoyo, naareeba ekitebe ky'obukama kitairwe omu iguru, naareeba n'Owaabaire akishutamiho; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.26+EZK.1.27+EZK.1.28"
              },
              "items": [
                {
                  "text": "Ezk 1:26-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi Ogwo owaabaire ashutami akaba naashusha nk'eibaare rya ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:3",
              "type": "text"
            },
            {
              "text": "yasipi na sarudi na simaragido na kristalo n'amabaare ag'obuguzi bwingi.",
              "type": "text"
            }
          ]
        },
        {
          "text": "yasipi n'erya sarudi, kandi ekyo kitebe ky'obukama kikaba kyehinguririziibwe omuhanganzima, ogwabaire nigushusha simaragido. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kikaba kyehinguririziibwe ebindi bitebe makumi abiri na bina; aha bitebe ebyo hakaba hashutamiho abakuru makumi abiri na bana, bajwaire ebijwaro birikwera n'ebirunga by'ezaabu aha mitwe yaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.16"
              },
              "items": [
                {
                  "text": "Kur 19:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.2"
              },
              "items": [
                {
                  "text": "Zek 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahansi y'ekyo kitebe ky'obukama haarugaho emirabyo n'amaraka n'okuhinda kw'enkuba; kandi omu maisho gaakyo haayakamu amatabaaza g'omuriro mushanju, niyo myoyo mushanju eya Ruhanga; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi omu maisho g'ekyo kitebe hakaba hariho ekirikushusha nk'enyanja y'endeeberwamu, erikushusha kristalo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwehinguririza ekyo kitebe embanju zoona, hakaba hariho ebihangirwe ebiine amagara bina, ebiijwire amaisho omumaisho n'enyima. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.14"
              },
              "items": [
                {
                  "text": "Ezk 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekihangirwe eky'okubanza kikaba nikishusha entare, ekya kabiri nikishusha enimi, ekya kashatu kikaba kiine ahamaisho aharikushusha ah'omuntu, n'ekya kana nikishusha empungu erikuguruka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 4:8"
          },
          "items": [
