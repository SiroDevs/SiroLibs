              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.2"
              },
              "items": [
                {
                  "text": "Isa 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo bihangirwe ebina buri kimwe kiine amapapa mukaaga, biijwire amaisho embaju zoona n'omunda; kandi nibyeshongora obutaremura nyomushana na nyekiro, biti:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
