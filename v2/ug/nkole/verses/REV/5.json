                "loc": "REV.8.3"
              },
              "items": [
                {
                  "text": "Kush 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.4"
