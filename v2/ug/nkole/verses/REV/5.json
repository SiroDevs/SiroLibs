              "items": [
                {
                  "text": "Yoh 1:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ahagati y'ekitebe ky'obukama n'ebihangirwe ebyo ebiine amagara ebina n'abo bakuru, naareebaho Omwana gw'entaama ayemereire, naashusha owaitsirwe, aine amahembe mushanju n'amaisho mushanju, niyo myoyo mushanju ya Ruhanga etumwa omu nsi zoona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaija, yaiha ekitabo omu mikono gwa buryo gw'Ogwo oshutami aha kitebe ky'obukama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
