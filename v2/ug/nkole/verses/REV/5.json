              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaatwaire ekitabo, ebihangirwe ebyo ebina n'abakuru abo makumi abiri na bana baagwa ahansi, baajuumara omu maisho g'Omwana gw'entaama, buri omwe aine enanga n'orwabya rw'ezaabu orwijwire obubaane bw'omugaju, nibyo by'okushaba by'abarikwera; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.8",
            "verseOrgIds": [
              "REV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "baayeshongora ekyeshongoro kisya nibagira bati:",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
