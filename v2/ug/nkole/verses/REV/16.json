            }
          ]
        },
        {
          "text": "Maraika owa mushanju yaashuka orwabya rwe ahaiguru omu mwanya, eiraka rihango ryaruga omuri hekalu aha kitebe ky'obukama, nirigira riti: Kyahwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.17",
            "verseOrgIds": [
              "REV.16.17"
            ]
          }
        },
        {
