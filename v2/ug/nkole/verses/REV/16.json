              "items": [
                {
                  "text": "Kush 19:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " niyo myoyo ya baadaimoni erikukora obumanyiso, erikuza oku n'oku omu bagabe b'ensi zoona, okubateeranira hamwe kuza omu rugamba orw'ekiro kikuru kya Ruhanga ow'obushoboorozi bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 16:15"
          },
          "items": [
