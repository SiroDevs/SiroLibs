                "loc": "1TH.5.2"
              },
              "items": [
                {
                  "text": "1 Tes 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (Reeba, niinyija nk'omushuma! Aine omugisha orikuguma naareeba, akarinda ebijwaro bye, ngu arekye kugyenda ajwaire busha, bakareeba enshoni ze.) ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 16:16"
          },
          "items": [
