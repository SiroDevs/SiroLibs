              "items": [
                {
                  "text": "Zek 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emyoyo egyo yaabateeranira omu mwanya ogurikwetwa Haramagedoni omu Ruheburaayo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
              "REV.16.16"
            ]
          }
        }
