                  "text": "Dan 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Haabaho emirabyo n'amaraka mahango n'okuhinda n'omutsitsa muhango; omutsitsa muhango kandi ogw'amaani gutyo tigukabahoga okwiha obu abantu baabaho omu nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.18",
            "verseOrgIds": [
              "REV.16.18"
            ]
          }
        },
