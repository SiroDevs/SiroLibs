              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naareeba omu kanwa k'ekijoka n'omu kanwa k'enyamaishwa n'omu kanwa ka nabi ow'ebishuba niharugamu emyoyo mibi eshatu erikushusha ebikyere; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
