        },
        {
          "text": "Maraika owa kabiri yaashuka orwabya rwe omu nyanja, enyanja yaahinduka, yaashusha eshagama y'omufu, kandi ekintu kyona ekihuriire ekyabaire kiri omu nyanja kyafa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
