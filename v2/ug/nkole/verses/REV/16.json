          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "baajuma Ruhanga ow'omu iguru ahabw'okuhururwa n'ahabw'ebironda byabo, kandi nabwo tibaayeteisa bi baakozire.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
