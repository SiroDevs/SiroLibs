              "items": [
                {
                  "text": "Kush 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Niinye Alufa na Omega; nikwo Mukama Ruhanga arikugira, oriho, kandi owaabaire ariho, kandi oribaho, Ow'obushoboorozi bwona.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        }
