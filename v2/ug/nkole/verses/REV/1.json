                "loc": "JDG.5.31"
              },
              "items": [
                {
                  "text": "Bar 5:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " omu mukono gwe gwa buryo akwaitsemu enyonyoozi mushanju, omu kanwa ke haarugamu rurara ey'amoogi abiri, kandi ahamaisho ge hakaba ninamurinkana nk'eizooba eririkujwisa amaani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        }
      ]
