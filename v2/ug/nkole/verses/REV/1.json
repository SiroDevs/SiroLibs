                "loc": "DAN.2.29"
              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyashuurwirwe Yesu Kristo, ebi Ruhanga yaamuhaire kworeka abahuuku be ebyabaire nibyenda kubaho juba, nawe akatuma maraika we kubimanyisa omuhuuku we Yohaana, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "owaahamize ebi yaareebire byona eby'ekigambo kya Ruhanga n'eby'okuhamya oku Yesu Kristo yaahamize. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orikushoma ebigambo by'obunabi obu aine omugisha, kandi baine omugisha abarikubihurira, bakata omutima aha bihandiikirwemu; ahabw'okuba obunaku buri haihi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.3",
            "verseOrgIds": [
              "REV.1.3"
            ]
          }
        }
      ]
    },
    {
