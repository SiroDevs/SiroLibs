                "loc": "EZK.26.16"
              },
              "items": [
                {
                  "text": "Ezk 26:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abagabe b'ensi abaashambaine narwo n'abaakunire narwo, ku barireeba okucumbuuka kw'omwika gwarwo nirusya, baryarucurira, baruborogyere; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "baryayemerera hangahari ahabw'okutiina okubonabonesibwa kwarwo nibagira bati: Ai bambe! Ai bambe! Babulooni orurembo orukuru orw'amaani! Okucwerwa orubanja kwawe kwaizira omu shaaha emwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
