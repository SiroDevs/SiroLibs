                  "text": "Ezk 27:27-29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu shaaha emwe obutungi obu bwona bwacwekyerezibwa. Bakama b'emeeri boona, n'abarikuzigyenderamu, abavugi baazo na boona abarikukora omu nyanja, baayemerera hangahari; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        },
        {
