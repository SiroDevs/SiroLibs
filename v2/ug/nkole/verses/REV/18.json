              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashuubuzi b'ensi nibarira nibarucurira, ahabw'okuba tihakiriho b'okugura eby'obushuubuzi byabo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "eby'ezaabu n'efeeza, amabaare ag'obuguzi bwingi n'eruuru, emyenda emirungi ya kitaani n'eya bujwa n'eya riiri n'erikutukura, ebiti eby'emigaju eby'emiringo yoona, ebintu by'emiino, n'ebintu byona ebibaizirwe omu mbaaho z'obuguzi bwingi, n'eby'emiringa n'eby'ebyoma, n'ebibaizirwe omu ibaare eririkwetwa ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:12",
              "type": "text"
            },
            {
              "text": "Maruburo, omu kishwahili ni marimari, n'eibaare ery'obuguzi bwingi eririkwengyengyeta, kandi eri bombekyesa.",
              "type": "text"
            }
          ]
        },
        {
          "text": "maruburo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.13"
              },
              "items": [
                {
                  "text": "Ezk 27:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " omudarasiini n'ebinzaari n'omugaju na ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:13",
              "type": "text"
            },
            {
              "text": "Sumuruna n'omubazi ogurikutuubya obusaasi, ogujwangibwa omu majuta g'okushoroora, ogwomya emitumbi, n'ebindi.",
              "type": "text"
            }
          ]
        },
        {
          "text": "sumuruna n'obubaane, viinyo n'amajuta n'esaano y'obunono n'engano, ente n'entaama, embaraasi n'ebigaari, n'abahuuku, niyo mibiri y'abantu n'emyoyo yaabo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
