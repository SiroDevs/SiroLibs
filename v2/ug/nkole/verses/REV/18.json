            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baayeshuka omucuucu omu mitwe, nibarira nibaborooga, nibagira bati: Ai bambe! Ai bambe! orurembo orukuru, orwatungiise boona abaabaire baine emeeri aha nyanja! Omu shaaha emwe rwacwekyerezibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
