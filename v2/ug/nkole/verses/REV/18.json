          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "baateera enduuru nibareeba omwika gw'okusya kwarwo, nibagira bati: Ebyo harabaireho orurembo orurikwingana n'orurembo oru orukuru! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.18",
            "verseOrgIds": [
              "REV.18.18"
            ]
          }
        },
