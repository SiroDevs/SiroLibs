            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.4"
              },
              "items": [
                {
                  "text": "Yoel 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Enzigye ezo zikaba nizishusha nk'embaraasi eziteekateekyeirwe orugamba; aha mitwe yaazo hakaba hariho ebintu ebirikushusha nk'ebirunga by'ezaabu; kandi ahamaisho gaazo hakaba nihashusha ah'abantu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.7",
            "verseOrgIds": [
              "REV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.1.6"
              },
              "items": [
                {
                  "text": "Yoel 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obwoya bwazo bukaba nibushusha eishokye ry'abakazi, n'amaino gaazo nigashusha ag'entare; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.8",
            "verseOrgIds": [
              "REV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ziine eby'okwekingiza aha kifuba ebigumire nk'ebyoma, n'okuhoorera kw'amababa gaazo kukaba kuri nk'okw'ebigaari ebirikukururwa embaraasi ezaasyoka niziza aha rugamba; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.9",
            "verseOrgIds": [
              "REV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ziine emikira n'emburi ez'obushegu nka skorupio, kandi amaani gaazo g'okubonabonesa abantu ameezi ataano gakaba gari omu mikira yaazo; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.10",
            "verseOrgIds": [
              "REV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ziine omukama waazo maraika w'ekiina ekitaine bugarukiro, eiziina rye omu Ruheburaayo ni Abadooni, kandi n'omu Rugriika naayetwa Apolyoni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibonaboneso eky'okubanza kyahwa; reeba nihaija kukurataho ebindi bibiri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.12",
            "verseOrgIds": [
              "REV.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.12",
            "verseOrgIds": [
              "REV.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maraika owa mukaaga yaateera enzamba, naahurira eiraka niriruga omu mahembe ana g'eitambiro ry'ezaabu eriri omu maisho ga Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.13",
            "verseOrgIds": [
              "REV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.12"
              },
              "items": [
                {
                  "text": "Kush 16:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nirigambira maraika owa mukaaga owaabaire aine enzamba, riti: Komorora baamaraika bana ababoheirwe aha mugyera Furaati. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.14",
            "verseOrgIds": [
              "REV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamaraika abo abana baakomororwa, abaabaire bateekateekyeirwe eshaaha n'ekiro n'okwezi n'omwaka ngu baite ekicweka kya kashatu eky'abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.15",
            "verseOrgIds": [
              "REV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubaro gw'abarikurwanira aha mbaraasi gukaba guri kakumi emirundi kakumi emirundi ebiri; naahurira omubaro gwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.16",
            "verseOrgIds": [
              "REV.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nikwo naareebire omu kworekwa, nkareeba embaraasi n'abaabaire bazishutamiho. Abo abazishutamiho bakaba bajwaire ebyoma eby'okwekingiza aha kifuba ebirikushusha omuriro na ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.17",
            "verseOrgIds": [
              "REV.9.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:17",
              "type": "text"
            },
            {
              "text": "huakinto n'eibaare ery'erangi ya bururu.",
              "type": "text"
            }
          ]
        },
        {
          "text": "huakinto n'ekibiriiti; n'emitwe y'embaraasi neeshusha ey'entare; omu kanwa kaazo haarugamu omuriro n'omwika n'obuganga bw'ekibiriiti. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.17",
            "verseOrgIds": [
              "REV.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekicweka kya kashatu ky'abantu kyaitwa ebibonaboneso ebyo byonshatu, omuriro n'omwika n'obuganga bw'ekibiriiti, ebyaruga omu kanwa kaazo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.18",
            "verseOrgIds": [
              "REV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba amaani g'embaraasi gaba omu kanwa kaazo n'omu mikira yaazo; emikira yaazo ehsusha enjoka, eine emitwe; kandi niyo zirumisa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.19",
            "verseOrgIds": [
              "REV.9.19"
            ]
          }
        }
      ]
    },
