  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "EXO 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaateerana eihanga ryona ery'Abaisraeli, yaabagira ati: Ebi nibyo MUKAMA abaragiire kukora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.3"
              },
              "items": [
                {
                  "text": "Lev 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro mukaaga emirimo ebe nimwo yaakorerwa, kwonka ekiro kya mushanju kiryaba ekiro ekirikwera ahariimwe, sabato ey'okuhuumuririraho kimwe, eyereziibwe MUKAMA; origikoreraho omurimo gwona, aryaitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutarihemba omuriro gwona omu maka gaanyu aha izooba rya sabato.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagambira eihanga ryona ery'Abaisraeli ati: Eki nikyo MUKAMA aragiire kukora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.9.7"
              },
              "items": [
                {
                  "text": "2 Kor 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwihe omuriimwe emitoijo y'okutoijera MUKAMA; omuntu weena oine omutima ogurikukunda kuha, areete omutoijo gwa MUKAMA; ezaabu, efeeza, emiringa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "emyenda ya bururu, eya bujwa, eya karari, eya bafuta, n'obwoya bw'embuzi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.6",
            "verseOrgIds": [
              "EXO.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "empu z'empaya z'entaama ezizigirwe n'erangi erikutukura, empu z'engongi, embaaho z'eminyinya, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.7",
            "verseOrgIds": [
              "EXO.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "amajuta g'etabaaza, eby'emigaju eby'okuta omu majuta ag'okushukaho ahabw'okushoroora, n'eby'okujwanzya n'obubaane oburikutaamirana, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.8",
            "verseOrgIds": [
              "EXO.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "amabaare agarikwetwa shohamu, n'agandi mabaare ag'okuhundisa efodi n'eky'aha kifuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.9",
            "verseOrgIds": [
              "EXO.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu nyamwoga weena omuriimwe aije akore ebi MUKAMA aragiire byona; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.10",
            "verseOrgIds": [
              "EXO.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.2+HEB.9.3+HEB.9.4+HEB.9.5+HEB.9.6+HEB.9.7+HEB.9.8+HEB.9.9+HEB.9.10+HEB.9.11"
              },
              "items": [
                {
                  "text": "Heb 9:2-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.3"
              },
              "items": [
                {
                  "text": "Kush 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obutaaho n'Eihema ryabwo n'eby'okubushweka n'ebikwatsi byabwo n'embaaho zaabwo n'embazi zaabwo n'enyomyo zaabwo n'ebiina byabwo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.11",
            "verseOrgIds": [
              "EXO.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "eshanduukye y'endagaano n'emigamba yaayo, n'ekitebe ky'okusaasira, n'omukingo gw'okukingira Aharikwera munonga; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.12",
            "verseOrgIds": [
              "EXO.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'emeeza n'emigamba yaayo n'ebintu byayo byona, n'emigaati y'okumurika; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.13",
            "verseOrgIds": [
              "EXO.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ekikondo ky'etabaaza y'okuhwezesa n'ebintu byakyo, n'amatabaaza gaakyo n'amajuta g'okuhemba; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.14",
            "verseOrgIds": [
              "EXO.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ekyoterero ky'obubaane n'emigamba yaakyo n'amajuta g'okushukaho ahabw'okushoroora, n'obubaane oburikutaamirana, n'omukingo gw'okukinga aha muryango gw'obwo butaaho; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.15",
            "verseOrgIds": [
              "EXO.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'eitambiro ry'okwokyezaho ebitambo n'ekintu kyaryo ky'emiringa ekishobeekaine nk'ekigoye, n'emigamba yaaryo n'ebintu byaryo byona, n'ekinaabiro n'ekibunu kyakyo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.16",
            "verseOrgIds": [
              "EXO.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'emikingo y'orugo rw'ekibuga n'enyomyo zaarwo n'ebiina byazo n'emikingo y'eirembo ry'ekibuga; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.17",
            "verseOrgIds": [
              "EXO.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'enkondo z'obwo butaaho n'ez'orugo rwabwo n'emigoye yaazo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.18",
            "verseOrgIds": [
              "EXO.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ebijwaro ebibaziirwe gye eby'okukoresa omu Mwanya ogurikwera, nibyo bijwaro ebirikwera eby'okujwarwa Arooni omunyamurwa n'eby'abatabani, nibakora omurimo gw'obunyamurwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
            "verseOrgIds": [
              "EXO.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
            "verseOrgIds": [
              "EXO.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihanga ryona ery'Abaisraeli ryaruga omu maisho ga Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.20",
            "verseOrgIds": [
              "EXO.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.9"
              },
              "items": [
                {
                  "text": "1 Bus 29:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima baagaruka, buri muntu owaagyemirwe omutima gwe, na buri muntu ou omutima gwe gwayekundiire, baareeta emitoijo ya MUKAMA ey'okukoresa Eihema ry'okubugaabuganiramu, n'emirimo yaaryo yoona n'ey'okukoresa ebijwaro ebirikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.21",
            "verseOrgIds": [
              "EXO.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haija abashaija n'abakazi, boona abaabaire baine emitima eyekundiire, baareeta empeta z'aha nyindo n'ez'omu matu, empeta eziriho obumanyiso n'enkwanzi, byona biri eby'ezaabu; buri muntu weena owaatoijiire, MUKAMA yaareeta omutoijo gw'ezaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.22",
            "verseOrgIds": [
              "EXO.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi buri muntu owaashangirwe aine emyenda ya bururu, eya bujwa, eya karari n'eya bafuta, n'obwoya bw'embuzi, n'empu z'empaya z'entaama ezizigirwe n'erangi erikutukura, n'empu z'engongi, yaabireeta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.23",
            "verseOrgIds": [
              "EXO.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buri muntu owaabaasize kureeta omutoijo gw'efeeza nari ogw'emiringa, yaagutoijera MUKAMA; kandi n'omuntu weena owaabaire aine embaaho z'omunyinya ezaakubaasa kukorwamu ekintu kyona omuri ogwo murimo, yaazireeta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.24",
            "verseOrgIds": [
              "EXO.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.31.19+PRO.31.20+PRO.31.21+PRO.31.22+PRO.31.23+PRO.31.24"
              },
              "items": [
                {
                  "text": "Enf 31:19-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi n'abakazi boona abanyamyoga baakaraga n'engaro zaabo, baareeta ebi baakaragire ebya bururu, ebya bujwa, ebya karari n'ebya bafuta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.25",
            "verseOrgIds": [
              "EXO.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abakazi boona abanyamwoga omu kukaraga abaagyemirwe emitima yaabo, baakaraga obwoshe bw'embuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.26",
            "verseOrgIds": [
              "EXO.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abategyeki baareeta amabaare agarikwetwa shohamu n'amabaare ag'okuhundisa efodi n'eky'aha kifuba, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.27",
            "verseOrgIds": [
