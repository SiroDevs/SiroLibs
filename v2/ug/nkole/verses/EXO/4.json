            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oryagambira Faraho to: Oku nikwo MUKAMA arikugamba, naagira ati: Israeli n'omwana wangye w'omujigaijo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.22",
