              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.13"
              },
              "items": [
                {
                  "text": "Ezk 43:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oryakora eitambiro omu munyinya, oburaingwa bwaryo mikono etaano, obuhango bwaryo mikono etaano, embaju zoona zingaingane; obwemi bwaryo bube mikono eshatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.50"
              },
              "items": [
                {
                  "text": "1 Bag 1:50",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.27"
              },
              "items": [
                {
                  "text": "Zab 118:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha nshonda zaaryo ina oribaijeho amahembe ana; ago mahembe gabaiziranwe naryo; orishwekye n'emiringa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.2",
            "verseOrgIds": [
              "EXO.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oriheeshere eby'okuyooreraho eiju ryaryo n'eby'okuriyooresa n'enyabya n'eby'okwihuza enyama n'eby'okuguhisa omuriro; ebyo bintu byaryo byona obiheeshe omu miringa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.3",
            "verseOrgIds": [
              "EXO.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oriheeshere ekintu ekishobeekaine nk'ekigoye, okiheeshe omu muringa; okiheeshere ebifunga by'emiringa bina, obite aha nshonda zaakyo ina; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.4",
            "verseOrgIds": [
              "EXO.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "okite ahansi y'omuguno ogwehinguririize eitambiro, kirugye ahansi, kihikye rwagati y'eitambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.5",
            "verseOrgIds": [
              "EXO.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi obaijere eitambiro emigamba omu munyinya, ogishwekye n'emiringa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.6",
            "verseOrgIds": [
              "EXO.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egyo migamba yaaryo ogite omu bifunga, eze embaju zombi z'eitambiro, ebe ey'okuriheekyesa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.7",
            "verseOrgIds": [
              "EXO.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oribaije omu mbaaho, omunda ribe omurangara; barikore nk'oku oryorekirwe aha rushozi oru.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryakora ekibuga ky'Obutaaho; aha rubaju rw'obukiizi-bwa-buryo orugo rube orw'emikingo ya kitaani, oburaingwa bwayo mikono igana aha rubaju rumwe; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "orwo rugo rugire enyomyo makumi abiri, n'ebiina by'okuzitamu makumi abiri; bibe eby'emiringa; eby'okuhanikaho eby'ahari ezo nyomyo n'obufunga bwabyo bibe eby'efeeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.10",
            "verseOrgIds": [
              "EXO.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'aha rubaju rw'obukiizi-bwa-bumosho orugo rube orw'emikingo, oburaingwa bwayo mikono igana; enyomyo zaarwo makumi abiri n'ebiina byazo makumi abiri bibe eby'emiringa, kandi eby'okuhanikaho eby'aha nyomyo n'obufunga bwabyo bibe eby'efeeza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.11",
            "verseOrgIds": [
              "EXO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.11",
            "verseOrgIds": [
              "EXO.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rubaju rw'oburgengyerwa-izooba narwo habeyo emikingo, obuhango bwayo mikono makumi ataano; enyomyo zaayo zibe ikumi, n'ebiina byazo nabyo ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.12",
            "verseOrgIds": [
              "EXO.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubaju rw'oburugwa-izooba narwo obuhango bwarwo bube mikono etaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.13",
            "verseOrgIds": [
              "EXO.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emikingo y'orugo rw'aha rubaju rumwe rw'eirembo ebe mikono ikumi n'etaano, enyomyo zaayo zibe ishatu, n'ebiina byazo nabyo bibe bishatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.14",
            "verseOrgIds": [
              "EXO.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orundi rubaju rwaryo narwo rugire orugo rw'emikingo ya mikono ikumi n'etaano; enyomyo zaayo zibe ishatu, n'ebiina byazo nabyo bibe bishatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.15",
            "verseOrgIds": [
              "EXO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.15",
            "verseOrgIds": [
              "EXO.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi eirembo ry'orwo rugo rigire omukingo gwa mikono makumi abiri obuhango, ogukozirwe omu myenda ya bururu, eya bujwa, eya karari n'eya kitaani, gutariizemu amabara gacwereraine; enyomyo zaagwo zibe ina, n'ebiina byazo bibe bina. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.16",
            "verseOrgIds": [
              "EXO.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyomyo zoona ez'orwo rugo ziteebweho obufunga bw'efeeza; eby'okuhanikaho byazo bibe eby'efeeza, n'ebiina byazo bibe eby'emiringa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.17",
            "verseOrgIds": [
              "EXO.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburaingwa bw'ekibuga kyona bube mikono igana n'obukiika bwakyo mikono makumi ataano embaju zoona, n'obwemi bw'orugo bube mikono etaano; rube orw'emyenda ya kitaani, kandi ebiina by'enyomyo zaarwo bibe eby'emiringa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu byona eby'Obutaaho n'eby'okubukoresa byona n'enkondo zaabwo zoona n'enkondo z'orugo zoona bibe eby'emiringa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryaragiira Abaisraeli bakureetere amajuta marungi agashekwirwe omu mizeituuni ahabw'okuhemba, gabe ag'okwatsya etabaaza obutoosha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.8"
              },
              "items": [
                {
                  "text": "Kur 30:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.13.11"
              },
              "items": [
                {
                  "text": "2 Bus 13:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu ihema ry'okubugaabuganiramu enyima y'omukingo ogukingiire Ebirikuhamya Arooni n'abatabani babe niho baaguma nibashemereza etabaaza, egume neeyakira omu maisho ga MUKAMA, okuruga omu mwabazyo okuhitsya omu kasheeshe. Kibe ekiragiro ky'ebiro byona eki Abaisraeli bashemereire kworobera omu busingye bwabo bwona.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        }
      ]
    }
  ],
