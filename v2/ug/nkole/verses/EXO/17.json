            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.19"
              },
              "items": [
                {
                  "text": "Bir 25:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagambira Musa ati: Ekyo okihandiikye omu kitabo, kibe ekiijutsyo, okiteekyerereze Yoshua, ku ndimariraho kimwe Amaleki, atagarukye kwijukwa ahansi y'eiguru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Musa yaayombeka eitambiro, yaaryeta ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:15",
              "type": "text"
            },
            {
              "text": "Yehova-niisi amakuru ngu MUKAMA n'orurango rwangye.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova-niisi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaagira ati: MUKAMA yaarahira ku ariguma naarwanisa Abaamaleki, nk'oku obusingye burigyenda nibwihaihana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
