            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli baaza ahagati y'enyanja aha itaka ryomire, amaizi gaaba nk'ekisiika aha rubaju rwabo orwa buryo n'orwa bumosho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.22",
            "verseOrgIds": [
              "EXO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
