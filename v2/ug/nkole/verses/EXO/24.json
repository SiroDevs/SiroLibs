          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Musa yainamuka na Arooni na Nadabu na Abihu n'abakuru b'Abaisraeli makumi mushanju; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.9",
            "verseOrgIds": [
              "EXO.24.9"
            ]
          }
        },
        {
