          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezo mbaaho ozishwekye n'ezaabu, oheeshe empeta z'ezaabu ez'okurabyamu ezo mbazi; nazo ozishewkye n'ezaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.29",
            "verseOrgIds": [
              "EXO.26.29"
            ]
          }
