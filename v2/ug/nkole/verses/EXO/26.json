              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ote ekitebe kiri ky'okusaasira aha shanduukye y'Ebirikuhamya omu Mwanya ogurikwera munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
