              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubazi rw'ahagati y'ezindi rwogyemu, ruhikye oku n'oku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.28",
            "verseOrgIds": [
              "EXO.26.28"
            ]
