          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryayemereza obutaaho bushushane n'eky'okureeberaho eki oyorekirwe aha rushozi oru.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.30",
