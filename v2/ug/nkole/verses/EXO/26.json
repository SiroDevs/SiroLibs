              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oryakora omukingo gwa bururu na bujwa na karari na kitaani, ogutemu ebishushani bya baakerubi ebikozirwe abanyamwoga baabyo. ",
          "type": "text",
          "attrs": {
