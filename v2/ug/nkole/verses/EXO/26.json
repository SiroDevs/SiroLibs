        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.1"
              },
              "items": [
                {
                  "text": "Rom 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi okore embazi itaano omu munyinya ahabw'embaaho z'orubaju rumwe rw'obutaaho, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.26",
            "verseOrgIds": [
              "EXO.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ezindi itaano ahabw'embaaho z'orundi rubaju; n'ezindi itaano ahabw'embaaho z'orubaju rw'obutaaho orw'enyima orurikureeba oburengyerwa-izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.27",
            "verseOrgIds": [
              "EXO.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
