            }
          ]
        },
        {
          "text": "Ogikorere ebizingiti okugyehinguririza, obuhango bwabyo ekita kimwe, nabyo obiteho omuguno gw'ezaabu, gubyehinguririze. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.25",
            "verseOrgIds": [
              "EXO.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogikorere ebifunga bina by'ezaabu, obite aha maguru gaayo, aha nkokora zaayo ina. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.26",
            "verseOrgIds": [
              "EXO.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebifunga ebyo bize haihi n'ebizingiti, bibe eby'okutamu emigamba ey'okuheeka emeeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.27",
            "verseOrgIds": [
              "EXO.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egyo migamba ogibaije omu munyinya, ogishwekye n'ezaabu, ebe ey'okuheekyesa emeeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.28",
            "verseOrgIds": [
              "EXO.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okore enyabya zaayo n'ebikopo byayo, kandi okore emidumo yaayo n'ebakuri zaayo eby'okushukisibwa empongano; obiheeshe omu zaabu eshemeziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.29",
            "verseOrgIds": [
              "EXO.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.5"
              },
              "items": [
                {
                  "text": "Lev 24:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogume ote ahari egyo meeza emigaati ey'okumurika, ebe omu maisho gangye obutoosha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.30",
            "verseOrgIds": [
              "EXO.25.30"
            ]
          }
        }
