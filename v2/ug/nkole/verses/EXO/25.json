          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogishwekye n'ezaabu eshemeziibwe, ogiteho omuguno gw'ezaabu gugyehinguririze. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.24",
