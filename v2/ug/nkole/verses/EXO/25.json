              "EXO.25.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.26"
              },
              "items": [
                {
                  "text": "Bir 31:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omuri egyo shanduukye oryatamu Ebirikuhamya ebi ndikuha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.16",
            "verseOrgIds": [
              "EXO.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.25"
              },
              "items": [
                {
                  "text": "Rom 3:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okore ekitebe ky'okusaasira omu zaabu eshemeziibwe; oburaingwa bwakyo mikono ebiri n'ekicweka, n'obuhango bwakyo mukono gumwe n'ekicweka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.17",
            "verseOrgIds": [
              "EXO.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi okore ebishushani bya baakerubi babiri omu zaabu; omu kubikora obiheeshe aha mitwe yombi ey'ekyo kitebe ky'okusaasira. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.18",
            "verseOrgIds": [
              "EXO.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okore ekya kerubi omwe aha mutwe gumwe, n'eky'ondi aha gundi; mubiheesherane n'ekitebe ky'okusaasira aha mitwe yaakyo yombi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.19",
            "verseOrgIds": [
              "EXO.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baakerubi bashashaanure amapapa gaabo ahaiguru, bagasangize ekitebe ky'okusaasira, boorekyeraine nibareeba ekyo kitebe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.20",
            "verseOrgIds": [
              "EXO.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitebe ky'okusaasira okite aha shanduukye, kandi omu shanduukye otemu Ebirikuhamya ebi ndikuha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.21",
            "verseOrgIds": [
              "EXO.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.17.4"
              },
              "items": [
                {
                  "text": "Kub 17:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.80.1"
              },
              "items": [
                {
                  "text": "Zab 80:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aho niho ndiguma nimbugaabuganira naimwe, nkagamba naiwe ahari byona, ebi ndikugambira kuragiira Abaisraeli, niinyema ahaiguru y'ekitebe ky'okusaasira, ahagati ya baakerubi abari aha shanduukye y'Ebirikuhamya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        }
      ]
    },
