              "items": [
                {
                  "text": "Kush 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oryakora ekikondo ky'etabaaza omu zaabu eshemeziibwe; omu kukikora okiheeshere hamwe; ekibunu kyakyo n'omukono gwakyo n'ebikopo byakyo n'ebintu ebyebumburikire byakyo n'ebirabyo byakyo, biheesheranwe nakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.31",
            "verseOrgIds": [
              "EXO.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigire amataagi mukaaga agarikuruga ahari ogwo mukono, ashatu aha rubaju rumwe, n'ashatu aha rundi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.32",
            "verseOrgIds": [
              "EXO.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "aha itaagi rimwe habeho ebikopo bishatu ebirikushusha nk'ebirabyo by'endozi, hamwe n'ekintu ekyebumburikire n'ekirabyo kyakyo; aha itaagi erindi habeho ebikopo bishatu ebirikushusha nk'ebirabyo by'endozi, hamwe n'ekintu ekyebumburikire n'ekirabyo kyakyo; goona omukaaga nk'oku garikuruga aha mukono gw'etabaaza gabe nikwo gaaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.33",
            "verseOrgIds": [
              "EXO.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwo mukono gw'etabaaza gugire ebikopo bina ebirikushusha nk'ebirabyo by'endozi, n'ebintu ebyebumburikire n'ebirabyo byabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.34",
            "verseOrgIds": [
              "EXO.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekintu ekyebumburikire kiheesheranwe n'omukono gw'etabaaza ahansi ya buri mataagi abiri agarikugurugaho; goona omukaaga gabe nikwo gaaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.35",
            "verseOrgIds": [
              "EXO.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyebumburikire n'amataagi eby'ogwo mukono bibe biheesherainwe nagwo omu zaabu eshemeziibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.36",
            "verseOrgIds": [
              "EXO.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
