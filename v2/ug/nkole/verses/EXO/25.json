            "sid": "EXO 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.1",
            "verseOrgIds": [
              "EXO.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.9.7"
              },
              "items": [
                {
                  "text": "2 Kor 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gambira Abaisareli bandeetere emitoijo; mwakiire omutoijo ogu omuntu weena arantoijere, ayekundiire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.2",
            "verseOrgIds": [
              "EXO.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egi niyo mitoijo yaabo ei muryakiira: ezaabu, efeeza, emiringa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.3",
            "verseOrgIds": [
              "EXO.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "emyenda ya bururu n'eya bujwa n'eya karari n'eya bafuta, obwoya bw'embuzi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.4",
            "verseOrgIds": [
              "EXO.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "empu z'empaya z'entaama zizigirwe n'erangi erikutukura, empu z'engongi, embaaho z'eminyinya, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.5",
            "verseOrgIds": [
              "EXO.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "amajuta g'etabaaza, eby'emigaju eby'okuta omu majuta ag'okushukaho, n'eby'okukoramu obubaane oburikutaamirana, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.6",
            "verseOrgIds": [
              "EXO.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.15"
              },
              "items": [
                {
                  "text": "Kur 28:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " amabaare agarikwetwa shohamu, n'agandi mabaare ag'okuhundisa efodi n'eky'aha kifuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.7",
            "verseOrgIds": [
              "EXO.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.3"
              },
              "items": [
                {
                  "text": "Kush 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi bankorere Omwanya ogurikwera, mbone kutuura ahagati omuribo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.8",
            "verseOrgIds": [
              "EXO.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'ebi ndikwija kukworeka byona oku biri, omuringo gw'eihema n'ogw'ebintu byaryo byona, mube nikwo mwabikora.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baryakora eshanduukye omu munyinya; oburaingwa bwayo mikono eibiri n'ekicweka, obuhango bwayo mukono gumwe n'ekicweka, n'obwemi bwayo mukono gumwe n'ekicweka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.10",
            "verseOrgIds": [
              "EXO.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogishekye n'ezaabu eshemeziibwe, ogishwekye omunda n'enyima, kandi ogyehinguririze omuguno gw'ezaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.11",
            "verseOrgIds": [
              "EXO.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyazye ezaabu, ogikoremu ebifunga bina, obite aha maguru gaayo ana, bibiri aha rubaju rumwe, kandi bibiri aha rundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.12",
            "verseOrgIds": [
              "EXO.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okore n'emigamba omu munyinya, ogishwekye n'ezaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.13",
            "verseOrgIds": [
              "EXO.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ote egyo migamba omu bifunga by'omu mbaju z'eshanduukye, bagume bagiheekyese. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.14",
            "verseOrgIds": [
              "EXO.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.8"
              },
              "items": [
                {
                  "text": "1 Bag 8:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emigamba egyo egume omu bifunga by'eshanduukye, etariihwamu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.15",
            "verseOrgIds": [
              "EXO.25.15"
            ]
          }
        }
      ]
    },
    {
