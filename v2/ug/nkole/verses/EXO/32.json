                "loc": "EXO.33.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa ku yaareebire abantu bagomire, (ahakuba Arooni akabaikiriza kugoma, baahinduka eky'okugaaniiza omu bazigu baabo), ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.25",
            "verseOrgIds": [
              "EXO.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaayemerera omu irembo ry'orusiisira, yaagira ati: Weena ori aha rubaju rwa MUKAMA, aije ahi ndi. Abaleevi boona bateeranira ah'ari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.26",
            "verseOrgIds": [
              "EXO.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.33.9"
              },
              "items": [
                {
                  "text": "Bir 33:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.11"
              },
              "items": [
                {
                  "text": "Kub 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaabagira ati: Oku nikwo MUKAMA Ruhanga wa Israeli arikugamba, naagira ati: Buri muntu ahagatire rurara ye, mugyendagyende hoonahoona omu rusiisira nimuruga aha irembo nimuza aha rindi, buri muntu aite mwene ishe, na mugyenzi we, na mutaahi we. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.27",
            "verseOrgIds": [
              "EXO.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaleevi baakora nk'oku Musa yaabaragiira; aha izooba eryo omu Baisraeli haafa abashaija nk'enkumi ishatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.28",
            "verseOrgIds": [
              "EXO.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagira ati: Eri izooba mweyeze ahari MUKAMA, ahakuba buri muntu arwaniise omutabani na mwene ishe, MUKAMA abone kubaha omugisha eri izooba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        }
      ]
    },
