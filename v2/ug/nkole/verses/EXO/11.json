          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.17"
              },
              "items": [
                {
                  "text": "Amo 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi haryabaho okucura kwingi omu nsi ya Misri yoona, okutakabahoga, kandi okutarigaruka kubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.23"
              },
              "items": [
                {
                  "text": "Yob 5:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka omu Baisraeli embwa terikankamira muntu weena, n'obu ryakuba rimwe aha matungo gaabo, mubone kumanya ku MUKAMA arikworeka omutaano ahagati y'Abanyamisri n'Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abaheereza baawe aba boona nibaija kushuuma, baije, banyinamire, nibagira bati: Irooko, n'abantu boona abarikukukuratira, bwanyima ngyende. Yaaruga omu maisho ga Faraho, aine ekiniga kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: Faraho tarikwija kubahurira, eby'okutangaaza byangye bibone kukanya omu nsi ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Arooni baakora eby'okutangaaza ebyo byona omu maisho ga Faraho; MUKAMA yaagangaaza omutima gwa Faraho, tiyaareka Abaisraeli kuruga omu nsi ye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        }
      ]
    }
