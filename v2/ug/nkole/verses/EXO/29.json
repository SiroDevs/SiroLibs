        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nikwo oritwaza noobeeza kunkorera omurimo gw'obunyamura. Oryatwara enimi nto, empaya z'entaama ibiri ezitaine kamogo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.1",
            "verseOrgIds": [
              "EXO.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.6.20+LEV.6.21+LEV.6.22"
              },
              "items": [
                {
                  "text": "Lev 6:20-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " emigaati etatumbisiibwe, otugaati twa keeki otutatumbisiibwe oturimu amajuta g'emizeituuni, na capati ezitatumbisiibwe ezisiigirweho amajuta; obikore omu saano y'engano ey'obunono; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.2",
            "verseOrgIds": [
              "EXO.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "obite omu kiibo kimwe, obireete hamwe n'egyo nimi n'ezo mpaya ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.3",
            "verseOrgIds": [
              "EXO.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.40.12"
              },
              "items": [
                {
                  "text": "Kur 40:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.22"
              },
              "items": [
                {
                  "text": "Heb 10:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Arooni n'abatabani obareete aha muryango gw'eihema ry'okubugaabuganiramu, oboozye n'amaizi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.4",
            "verseOrgIds": [
              "EXO.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima oiheyo ebijwaro, ojwekye Arooni ekooti n'ekanzu ya efodi, na efodi, n'eky'aha kifuba; omuzirikye n'eky'okwezirikisa ekirukirwe abanyamwoga eky'ahari efodi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.5",
            "verseOrgIds": [
              "EXO.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "omujwekye ekikwemba omu mutwe; aha kikwemba oteho ekirunga kirikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.6",
            "verseOrgIds": [
              "EXO.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.1"
              },
              "items": [
                {
                  "text": "Isa 61:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima oiheyo amajuta ag'okushukaho, ogamushukye aha mutwe, ogamushoroorese. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.7",
            "verseOrgIds": [
              "EXO.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oreete n'abatabani, obajwekye ekooti; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.8",
            "verseOrgIds": [
              "EXO.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni n'abatabani obazirikye n'eby'okwezirikisa, kandi obajwekye enkofiira, obunyamurwa bube obwabo, buhamibwe ekiragiro ekitarihwaho. Okwo nikwo orishoroora Arooni n'abatabani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.9",
            "verseOrgIds": [
              "EXO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
