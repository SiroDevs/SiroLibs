          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku harigira enyama nari omugaati ebyatsigara aha by'okushoroora okuhitsya omu kasheeshe, oryabyotsya omu muriro; tibiririibwa, ahakuba n'ebirikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.34",
            "verseOrgIds": [
