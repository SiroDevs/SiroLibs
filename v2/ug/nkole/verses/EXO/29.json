        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryatwara ebishaju by'egyo mpaya n'omukira gwayo ogw'ebishaju, n'ebishaju byayo ebishwekire eby'omunda, n'ekishaabo ky'ekitugu kyayo, n'entsigo zombi n'ebishaju ebiziriho, n'ekivune ky'okuguru kwa buryo; ahakuba egyo n'empaya y'entaama ey'okushoroorwa kw'abanyamurwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.22",
            "verseOrgIds": [
              "EXO.29.22"
            ]
          }
