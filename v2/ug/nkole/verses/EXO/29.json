                  "text": "Mat 12:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arooni n'abatabani barye egyo nyama y'empaya y'entaama n'omugaati oguri omu kiibo, babiriire aha muryango gw'eihema ry'okubugaabuganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.32",
            "verseOrgIds": [
              "EXO.29.32"
            ]
          }
        },
        {
