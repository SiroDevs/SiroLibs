          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo oritwaza Arooni n'abatabani nka byona ebi nkuragiire oku biri; oryamara ebiro mushanju noobeeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.35",
            "verseOrgIds": [
              "EXO.29.35"
            ]
          }
        },
        {
