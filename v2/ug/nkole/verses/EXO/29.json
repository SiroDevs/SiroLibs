            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:40",
              "type": "text"
            },
            {
              "text": "Hiini n'endengo erikwingana galloni emwe.",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiini y'amajuta g'emizeituuni agashekwirwe, kandi ekicweka kimwe kya kana kya hiini ya viinyo, kuba empongano y'eky'okunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "name": "verse",
