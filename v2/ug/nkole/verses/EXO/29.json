            "sid": "EXO 29:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu busingye bwanyu bwona kiryaguma kibe ekitambo ky'okwotsya, nikitambirwa aha muryango gw'eihema ry'okubugaabuganiramu omu maisho ga MUKAMA, ahu ndibugaabuganira naimwe, nkagamba naiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.42",
            "verseOrgIds": [
              "EXO.29.42"
            ]
          }
        },
