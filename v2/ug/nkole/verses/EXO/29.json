                  "text": "Bir 18:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oyeze egyo nkoro y'empongano ezongazongiibwe, n'ekivune ky'empongano erikwihwaho ahari egyo mpaya y'entaama ey'okushoroorwa, kibe ekya Arooni n'abatabani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.27",
            "verseOrgIds": [
              "EXO.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekivune ekyo kiryaguma kibe ekya Arooni n'abatabani eki Abaisraeli bashemereire kubaha ebiro byona, ahakuba n'empongano erikwihwa omu mpongano z'Abaisraeli ez'okusiima ahabw'obusingye; niyo mpongano yaabo ei baihaho ahabwa MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        }
      ]
    },
