                  "text": "Zab 141:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogundi mwana gw'entaama oryaguhonga omu mwabazyo, nagwo oguhongye n'empongano y'esaano n'ey'eky'okunywa, nk'eby'omu kasheeshe, kuba ekisooroora ekirungi, empongano eyokiibwe omu muriro, ehongyeirwe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.41",
            "verseOrgIds": [
              "EXO.29.41"
            ]
          }
        },
