          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ebijwaro ebirikwera ebya Arooni biryaba eby'abatabani abarimukurata, babe nibyo baashukirwamu amajuta, kandi babe nibyo baashoroorerwamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.29",
            "verseOrgIds": [
