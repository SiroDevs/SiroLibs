          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "otware n'omugaati gumwe, n'akagaati kamwe ka keeki akarimu amajuta na capati emwe, obiihe omu kiibo ky'emigaati etatumbisiibwe etuura omu maisho ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.23",
            "verseOrgIds": [
              "EXO.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo byona obite omu ngaro za Arooni n'abatabani, babizongazongye, ebe empongano ezongazongiibwe omu maisho ga MUKAMA; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.24",
            "verseOrgIds": [
              "EXO.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima obiihe omu ngaro zaabo, obyotsye n'ekitambo ekirikwokibwa aha itambiro, kibe ekisooroora kirungi omu maisho ga MUKAMA; egyo n'empongano eyokiibwe omu muriro ehongyeirwe MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        }
      ]
