              "type": "text"
            }
          ]
        },
        {
          "text": " Ebi nibyo origuma noohongyera aha itambiro; buri izooba oryaguma nootamba abaana b'entaama babiri abahikize omwaka; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.38",
