                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Buri izooba oryahayo enimi ey'okuhonga ahabw'ekibi, ebe empongano; kandi oryayeza eitambiro, ku oriba noorihongyerera; kandi orishukyeho amajuta ahabw'okuryeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.36",
