          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.9",
            "verseOrgIds": [
              "EXO.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.10",
            "verseOrgIds": [
              "EXO.29.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.14"
              },
              "items": [
                {
                  "text": "Lev 8:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima oryareeta enimi omu maisho g'eihema ry'okubugaabuganiramu, Arooni n'abatabani bate engaro zaabo aha mutwe gwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.10",
            "verseOrgIds": [
              "EXO.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oitire enimi omu maisho ga MUKAMA aha muryango gw'eihema ry'okubugaabuganiramu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.11",
            "verseOrgIds": [
              "EXO.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "otware aha shagama y'enimi, ogisiigye aha mahembe g'eitambiro n'orukumu rwawe; eshagama eraatsigareho ogishukye ahansi aha kibunu ky'eitambiro; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.12",
            "verseOrgIds": [
              "EXO.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.3.3"
              },
              "items": [
                {
                  "text": "Lev 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " otware ebishaju byona ebishwekire amara, ekishaabo ky'aha kitugu, entsigo zombi n'ebishaju ebiziriho, obyokyeze aha itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.13",
            "verseOrgIds": [
              "EXO.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.11"
              },
              "items": [
                {
                  "text": "Heb 13:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka enyama z'egyo nimi, oruhu rwayo n'efa yaayo, obyokyeze kimwe aheeru y'orusiisira; ekyo n'ekitambo ky'ekibi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.14",
            "verseOrgIds": [
              "EXO.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.6"
              },
              "items": [
                {
                  "text": "Isa 53:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oryareeta emwe ahari ezo mpaya z'entaama; Arooni n'abatabani bate engaro zaabo aha mutwe gwayo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.15",
            "verseOrgIds": [
              "EXO.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima ogiite, otware eshagama yaayo, ogishukyere embaju zoona ez'eitambiro; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.16",
            "verseOrgIds": [
              "EXO.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "omutumbi gwayo ogucwemu ebicweka, oyozye amara gaayo n'amaguru gaayo, obiteerane n'ebindi bicweka byayo n'omutwe gwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.17",
            "verseOrgIds": [
              "EXO.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.8.21"
              },
              "items": [
                {
                  "text": "Kut 8:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Egyo mpaya yoona ogyokyeze kimwe aha itambiro; ekyo n'ekitambo ekyokize ahari MUKAMA; kandi n'empongano eyokiibwe omu muriro, ehongyeirwe MUKAMA, ey'ekisooroora kirungi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.18",
            "verseOrgIds": [
              "EXO.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
