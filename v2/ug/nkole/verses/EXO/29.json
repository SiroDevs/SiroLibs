            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutabani oriba omunyamurwa omu mwanya gwe, aryamara ebiro mushanju naabijwara, yaaba naaza omu ihema ry'okubugaabuganiramu, okuheereza omu Mwanya ogurikwera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.30",
            "verseOrgIds": [
              "EXO.29.30"
            ]
          }
        }
      ]
    },
