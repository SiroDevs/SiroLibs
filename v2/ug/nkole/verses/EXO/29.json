          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu kasheeshe ohongye omwana gw'entaama gumwe, n'omu mwabazyo ohongye ogundi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.39",
