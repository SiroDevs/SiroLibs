          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryatwara empaya y'entaama ey'okushoroorwa kw'omunyamurwa, oteekyere enyama yaayo omu mwanya gwona ogurikwera; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.31",
            "verseOrgIds": [
