          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi hamwe n'ogwo mwana gw'entaama ohe ekicweka kimwe kya ikumi ekya eefa y'esaano y'obunono ejwangize n'ekicweka kimwe kya kana kya ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
