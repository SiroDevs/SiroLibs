          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "eky'okushweka ky'empu z'empaya z'entaama ezizigirwe n'erangi erikutukura, eky'okushweka ky'empu z'engongi, omukingo gw'okukingira Aharikwera munonga, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
