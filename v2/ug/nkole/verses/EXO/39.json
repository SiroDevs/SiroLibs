            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baareetera Musa obutaaho n'Eihema n'ebintu byaryo byona, ebikwatsi byaryo, embaaho zaaryo, embazi zaaryo, enyomyo zaaryo, ebiina byaryo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
