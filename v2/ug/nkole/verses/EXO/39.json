            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.16"
              },
              "items": [
                {
                  "text": "Isa 49:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.17"
              },
              "items": [
                {
                  "text": "Kush 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baashemeza amabaare agarikwetwa shohamu, baagahamisa ezaabu ekwegire, baagasharuraho amaziina g'abaana ba Israeli, nk'oku basharura akamanyiso aha ibaare. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.6",
            "verseOrgIds": [
              "EXO.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagata aha biremu bya efodi eby'aha mabega kuba amabaare g'okwijukiraho abaana ba Israeli, nk'oku MUKAMA yaaragiire Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.7",
            "verseOrgIds": [
              "EXO.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
