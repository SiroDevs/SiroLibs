              "items": [
                {
                  "text": "Kur 23:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.103.3"
              },
              "items": [
                {
                  "text": "Zab 103:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naagira ati: Ku oryezirika kuhurira eiraka rya MUKAMA Ruhanga waawe, waakora ebihikire omu maisho ge, waatega amatu ebiragiro bye, waarinda byona ebi yaataireho, tindikureetaho ndwara n'emwe ahari ezo ezi naareetsire aha Banyamisri; ahakuba niinye MUKAMA orikukutambira endwara. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima baahika Elimu, ahu enshuro z'amaizi ikumi na ibiri n'emikindo makumi mushanju byabaire biri; baateera amahema aha rubaju rw'ago maizi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.27",
            "verseOrgIds": [
              "EXO.15.27"
            ]
          }
