          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baayetomboitera Musa, nibagira bati: Tunywe ki? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.24",
            "verseOrgIds": [
              "EXO.15.24"
            ]
          }
        },
