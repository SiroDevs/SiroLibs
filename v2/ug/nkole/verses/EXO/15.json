              },
              "items": [
                {
                  "text": "Rus 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baahikire Maara, tibaabaasa kunywa maizi gaayo, ahakuba gakaba nigashaarira; nikyo haayeteirwe Maara. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
          }
        },
        {
