          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho niho MUKAMA yaabaheereire ekiragiro n'omugyenzo ogu yaataireho; kandi niho yaabagyereize, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
