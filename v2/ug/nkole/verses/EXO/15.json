            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaatakira MUKAMA; MUKAMA yaamworeka ekiti, yaakinaga omuri ago maizi, amaizi gaanura.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        }
