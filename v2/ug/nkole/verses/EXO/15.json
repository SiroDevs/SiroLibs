          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaayebembera Abaisraeli okuruga aha Nyanja erikutukura, baagyenda, baahika omu ihamba rya Shuuri, baarimaramu ebiro bishatu nibagyenda, babuzire amaizi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.22",
            "verseOrgIds": [
              "EXO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 15:23"
          },
          "items": [
