                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.10"
              },
              "items": [
                {
                  "text": "Heb 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaabaija eitambiro ry'okwokyezaho ebitambo omu munyinya, oburaingwa bwaryo mikono etaano, obuhango bwaryo mikono etaano, ryaingaingana embaju zoona, n'obwemi bwaryo mikono eshatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.1",
            "verseOrgIds": [
              "EXO.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha nshonda zaaryo ina yaabaijaho amahembe ana; ago mahembe gaabaijeranwa naryo; yaarishweka n'emiringa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.2",
            "verseOrgIds": [
              "EXO.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaariheeshera ebintu byaryo byona, eby'okuyooreraho eiju, n'eby'okuriyooresa, n'enyabya, n'eby'okwihuza enyama, n'eby'okuguhisa omuriro; ebintu byaryo byona yaabikora omu miringa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.3",
            "verseOrgIds": [
              "EXO.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaariheeshera ekintu ekishobeekaine nk'ekigoye omu miringa, yaakita ahansi y'omuguno ogwehinguririize eitambiro, kyaruga ahansi, kyahika rwagati y'eitambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.4",
            "verseOrgIds": [
              "EXO.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaheesha ebifunga bina, yaabita aha nshonda ina z'ekyo kintu ky'emiringa ekishobeekaine kuba eby'okutamu emigamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.5",
            "verseOrgIds": [
              "EXO.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabaija emigamba omu munyinya, yaagishweka n'emiringa; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.6",
            "verseOrgIds": [
              "EXO.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "egyo migamba yaagita omu bifunga aha mbaju z'eitambiro kuba ey'okuriheekyesa. Yaaribaija omu mbaaho, omunda ryaba omurangara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.7",
            "verseOrgIds": [
              "EXO.38.7"
            ]
          }
        }
      ]
    },
