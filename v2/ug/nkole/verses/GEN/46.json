            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.7",
            "verseOrgIds": [
              "GEN.46.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.8",
            "verseOrgIds": [
              "GEN.46.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.1"
              },
              "items": [
                {
                  "text": "Kur 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aga nigo maziina g'abaana ba Israeli abaagiire Misri, Yakobo n'abatabani; Reubeeni omujigaijo gwe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.8",
            "verseOrgIds": [
              "GEN.46.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "batabani ba Reubeeni, Hanoki, Palu, Hezirooni na Karumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.9",
            "verseOrgIds": [
              "GEN.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Simeoni ni Yemueli, Yamini, Ohadi, Yakini, Zohari, na Shauli omutabani, w'Omunyakanaanikazi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.10",
            "verseOrgIds": [
              "GEN.46.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Leevi ni Gereshoni, Kohasi na Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.11",
            "verseOrgIds": [
              "GEN.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Yuda ni Eeri, Onani, Sheela, Pereezi na Zeera; kwonka Eeri na Onani bakafeera omu nsi ya Kanaani; batabani ba Pereezi ni Hezirooni na Hamuli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.12",
            "verseOrgIds": [
              "GEN.46.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Isakaari ni Toola, Puuva, Yobu na Shimirooni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.13",
            "verseOrgIds": [
              "GEN.46.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Zebuluuni ni Seredi, Eloni na Yahaleeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.14",
            "verseOrgIds": [
              "GEN.46.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nibo batabani ba Lea, abu yaazaariire Yakobo omuri Padanaramu hamwe na muhara we Dina; abaana be b'aboojo n'ab'abaishiki boona bakaba bari makumi ashatu na bashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.15",
            "verseOrgIds": [
              "GEN.46.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Gaadi ni Zifioni, Haagi, Shuuni, Ezibooni, Eeri, Arodi na Areeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.16",
            "verseOrgIds": [
              "GEN.46.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Asheri ni Imuna, Ishiva, Ishivi na Beeria na munyaanyabo Seera; batabani ba Beria ni Heberi na Malikieli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
              "GEN.46.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nibo baana ba Zilupa ou Labaani yaahaire Lea muhara we, kandi abo nibo yaazaariire Yakobo, abantu ikumi na mukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.18",
            "verseOrgIds": [
              "GEN.46.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Rakeeli muka Yakobo ni Yosefu na Benyamiini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.19",
            "verseOrgIds": [
              "GEN.46.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yosefu yaazaarira Manaase na Efuraimu omu nsi ya Misri, abu Asenaasi muhara wa Potifeera omunyamurwa wa Oni yaamuzaariire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.20",
            "verseOrgIds": [
              "GEN.46.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Benyamiini ni Beela, Bekeri, Ashubeeli, Geera, Naamani, ehi, Roshi, Mupimu, Hupimu na Aridi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.21",
            "verseOrgIds": [
              "GEN.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nibo batabani ba Rakeeli abu yaazaariire Yakobo; boona bakaba bari ikumi na bana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.22",
            "verseOrgIds": [
              "GEN.46.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Daani ni Hushimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.23",
            "verseOrgIds": [
              "GEN.46.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Nafutaali ni Yahazeeli, Guuni, Yezeri na Shileemu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.24",
            "verseOrgIds": [
              "GEN.46.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 46:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nibo batabani ba Biliha ou Labaani yaahaire Rakeeli muhara we, abu yaazaariire Yakobo; boona bakaba bari mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.25",
            "verseOrgIds": [
              "GEN.46.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.5"
              },
              "items": [
                {
                  "text": "Kur 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu boona ab'omu nda ya Yakobo abaagyenzire nawe Misri, otabariiremu bakaamwana be, bakaba bari makumi mukaaga na mukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.26",
            "verseOrgIds": [
              "GEN.46.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.22"
              },
              "items": [
                {
                  "text": "Bir 10:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.14"
              },
              "items": [
                {
                  "text": "Byak 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batabani ba Yosefu abu yaazaariire Misri bakaba bari babiri; abantu boona ab'omu ka ya Yakobo abaagiire Misri bakaba bari makumi mushanju.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
            "verseOrgIds": [
              "GEN.46.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
            "verseOrgIds": [
              "GEN.46.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 46:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yaatuma Yuda ahari Yosefu ku amushanga Gosheni; batyo baahika omu kyanga kya Gosheni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
            "verseOrgIds": [
              "GEN.46.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 46:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu yaaboneza ekigaari kye, yainamuka, yaaza kubugana Israeli ishe omuri Gosheni; yaamwetondera, yaamugwa omu bitsya, yaamara omwanya naarira akimuri omu bitsya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.29",
            "verseOrgIds": [
              "GEN.46.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 46:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.29"
              },
              "items": [
                {
                  "text": "Luk 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Israeli yaagira Yosefu ati: N'obu naakufa nka hati, niho naakureeba, nkamanya ku obaho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 46:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu yaagambira beene ishe n'ab'omu ka ya ishe ati: Ka ngyende ngambire Faraho, mmugira nti: Beene taata n'ab'omu ka ye abaabaire batwire omu nsi ya Kanaani naatsiga baija; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 46:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "nti, kandi abo bashaija n'abariisa, ahakuba omurimo gwabo n'okuriisa; na mbwenu baareeta amasyo gaabo ag'entaama n'ag'ente, n'ebindi byona ebi baatungire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 46:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraho ku araabeete, yaababuuza ati: Mukora murimo ki? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.33",
            "verseOrgIds": [
              "GEN.46.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 46:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.8.26"
              },
              "items": [
                {
                  "text": "Kur 8:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumugire muti: Abairu baawe turi abariisa okwiha omu buto bwaitu n'okuhitsya hati, itwe na baatatenkuriitwe; mubone kutuura omu kyaro kya Gosheni; ahakuba omuriisa weena n'ekihagaro aha Banyamisri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.34",
