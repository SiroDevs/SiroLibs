            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.2"
              },
              "items": [
                {
                  "text": "Mik 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Rakeeli yaafa, yaaziikwa aha muhanda ogurikuza Efuraata, niyo Betelehemu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.19",
            "verseOrgIds": [
              "GEN.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
