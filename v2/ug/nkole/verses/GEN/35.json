                "loc": "1SA.10.2"
              },
              "items": [
                {
                  "text": "1 Sam 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yakobo yaabyara enyomyo aha kituuro kye; niyo nyomyo y'aha kituuro kya Rakeeli; kandi ekiriho n'okuhitsya eri izooba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.20",
            "verseOrgIds": [
              "GEN.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
