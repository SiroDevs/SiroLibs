              "GEN.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.26.10"
              },
              "items": [
                {
                  "text": "Yob 26:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.95.5"
              },
              "items": [
                {
                  "text": "Zab 95:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruhanga yaagira ati: Amaizi g'ahansi y'eiguru gaateeranire omu mwanya gumwe, eitaka rireebekye. Kyaba nikwo kyaba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.9",
            "verseOrgIds": [
              "GEN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga yaayeta eryo itaka Ensi, n'eiteeraniro ry'amaizi yaaryeta Enyanja. Ruhanga yaareeba kiri kirungi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.10",
            "verseOrgIds": [
              "GEN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.6.7"
              },
              "items": [
                {
                  "text": "Heb 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruhanga yaagira ati: Ensi emere ebirikumera, ebirikwera enjuma, kandi n'ebiti ebirikwana ebijuma, ebirimu embibo, buri kimwe omu muringo gwakyo. Kyaba nikwo kyaba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.11",
            "verseOrgIds": [
              "GEN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi yaamera ebirikumera, ebirikwera enjuma omu miringo yaabyo, n'ebiti ebirikwana ebijuma ebirimu embibo, buri kimwe omu muringo gwakyo. Ruhanga yaareeba kiri kirungi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.12",
            "verseOrgIds": [
              "GEN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwaira, bwasheesha, kyaba ekiro kya kashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.13",
            "verseOrgIds": [
              "GEN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.74.16"
              },
              "items": [
                {
                  "text": "Zab 74:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruhanga yaagira ati: Habeho ebirikwaka omu mwanya omu iguru, bitaanise nyomushana na nyekiro; kandi bibe eby'okumanyisa obunaku n'ebiro n'emyaka; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.14",
            "verseOrgIds": [
              "GEN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "bigume byakye omu mwanya omu iguru, bibone kwakira ensi. Kyaba nikwo kyaba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.15",
            "verseOrgIds": [
              "GEN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga yaakora ebirikwaka bihango bibiri, ekirikwaka ekihango okutegyeka nyomushana, kandi ekikye okutegyeka nyekiro; kandi yaakora n'enyonyoozi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.16",
            "verseOrgIds": [
              "GEN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.8.3"
              },
              "items": [
                {
                  "text": "Zab 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga yaabita omu mwanya omu iguru okujwera ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.17",
            "verseOrgIds": [
              "GEN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okutegyeka nyomushana na nyekiro, kandi n'okutaanisa omushana n'omwirima. Ruhanga yaareeba kiri kirungi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.18",
            "verseOrgIds": [
              "GEN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwaira, bwasheesha, kyaba ekiro kya kana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.19",
            "verseOrgIds": [
              "GEN.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.19",
            "verseOrgIds": [
              "GEN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga yaagira ati: Amaizi gaijure ebirikwegyendesa ebiine amagara, kandi n'ebirikuguruka bigurukye ahaiguru omu kaabunga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.20",
            "verseOrgIds": [
              "GEN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga yaahanga ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.21",
            "verseOrgIds": [
              "GEN.1.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:21",
              "type": "text"
            },
            {
              "text": "emigoye n'eby'enyanja ebirikukira byona obuhango.",
              "type": "text"
            }
          ]
        },
        {
          "text": "emigoye mihango, n'ebirikwegyendesa byona ebiine amagara, ebi amaizi gaazaire omu miringo yaabyo, n'ebirikuguruka byona ebiine amapapa omu miringo yaabyo. Ruhanga yaareeba kiri kirungi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.21",
            "verseOrgIds": [
              "GEN.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga yaabiha omugisha, naagira ati: Muzaare, mukanye, mwijure omu maizi g'omu nyanja, kandi n'ebirikuguruka bikanye omu nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.22",
            "verseOrgIds": [
              "GEN.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwaira, bwasheesha, kyaba ekiro kya kataano.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.23",
            "verseOrgIds": [
              "GEN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
