                "loc": "JHN.10.17"
              },
              "items": [
                {
                  "text": "Yoh 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baahikire omu mwanya ogu Ruhanga amugambiire, Abrahamu yaayombekayo eitambiro, yaariteekyeraho enku, yaaboha Isaaka omwana we, yaamugarika aha itambiro aha nku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.9",
            "verseOrgIds": [
              "GEN.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.6+ISA.53.7+ISA.53.8+ISA.53.9+ISA.53.10+ISA.53.11+ISA.53.12"
              },
              "items": [
                {
                  "text": "Isa 53:6-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abrahamu yaakununkirira omusyo kurezya omutabani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.10",
            "verseOrgIds": [
              "GEN.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maraika wa MUKAMA yaayema omu iguru, yaamweta ati: Abrahamu! Abrahamu! Yaayetaba ati: Nyamuhanga! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.32"
              },
              "items": [
                {
                  "text": "Rom 8:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.22"
              },
              "items": [
                {
                  "text": "Yak 2:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaamugira ati: Otakora ahari ogwo mwana, nari kugira eki waamwitsa; ahabw'okuba hati naamanya ku orikutiina Ruhanga ahabw'okutaanyima mwana waawe omwe nyamunegyere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.12",
            "verseOrgIds": [
              "GEN.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu yaimutsya amaisho, yaamagamaga, yaareeba enyima ye empaya y'entaama ekwatsirwe ebikamba omu mahembe; Abrahamu yaagyenda, yaihayo egyo mpaya, yaagitamba kuba ekitambo ekyokize omu mwanya gw'omwana we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.13",
            "verseOrgIds": [
              "GEN.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu yaayeta ogwo mwanya Yehovayire, nk'oku kirikugambwa na hati ngu, Aha kibungo kya MUKAMA kiryaheebwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        }
      ]
    },
    {
