          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaaherize kuzaara Seezi, yaamara emyaka magana munaana ei yaazaariiremu abaana b'aboojo n'ab'abaishiki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
