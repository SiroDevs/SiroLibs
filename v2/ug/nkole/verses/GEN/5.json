        },
        {
          "text": "Adamu ku yaamazire emyaka igana na makumi ashatu, yaazaara omwana w'omwojo orikumushusha omu muringo gwe, yaamweta Seezi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
