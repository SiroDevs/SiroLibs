        },
        {
          "text": "Eki n'ekitabo ky'oruzaaro rwa Adamu. Aha izooba eri Ruhanga yaahangiireho omuntu, akamuhanga naashushana nawe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaahanga omushaija n'omukazi, yaabaha omugisha, yaabeeta Omuntu, aha izooba eri baahangiirweho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        }
      ]
    },
