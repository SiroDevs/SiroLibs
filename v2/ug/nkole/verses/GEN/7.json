                "loc": "2PE.2.5"
              },
              "items": [
                {
                  "text": "2 Pet 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagambira Noa ati: Ija n'eka yaawe yoona, mutaahe omu meeri; ahakuba omu b'obusingye obu niiwe ndeebire ohikiriire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.1",
            "verseOrgIds": [
              "GEN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.11.1+LEV.11.2+LEV.11.3+LEV.11.4+LEV.11.5+LEV.11.6+LEV.11.7+LEV.11.8+LEV.11.9+LEV.11.10+LEV.11.11+LEV.11.12+LEV.11.13+LEV.11.14+LEV.11.15+LEV.11.16+LEV.11.17+LEV.11.18+LEV.11.19+LEV.11.20+LEV.11.21+LEV.11.22+LEV.11.23+LEV.11.24+LEV.11.25+LEV.11.26+LEV.11.27+LEV.11.28+LEV.11.29+LEV.11.30+LEV.11.31"
              },
              "items": [
                {
                  "text": "Lev 11:1-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha nyamaishwa ezitarikuzira otwareho mushanju mushanju, ekishaija n'ekikazi; aha zirikuzira ibiri ibiri, enshaija n'enkazi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.2",
            "verseOrgIds": [
              "GEN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'aha birikuguruka nabyo mushanju mushanju, ekishaija n'ekikazi, oruzaaro rwabyo rubone kugumaho omu nsi yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.3",
            "verseOrgIds": [
              "GEN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba ebiro mushanju ku biraahwe, niinyija kugwisa enjura aha nsi okumara ebiro makumi ana, nyomushana na nyekiro; kandi buri kintu kyona ekihuriire eki naahangire, ndyakimariraho kimwe aha nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.4",
            "verseOrgIds": [
              "GEN.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa yaakora byona nk'oku MUKAMA yaamuragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu omwegyemure gw'amaizi gwaija aha nsi, Noa akaba ahikize emyaka magana mukaaga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.6",
            "verseOrgIds": [
              "GEN.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.6",
            "verseOrgIds": [
              "GEN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa yaataaha omuri egyo meeri n'abatabani n'omukazi we na bakaamwana, ahabw'omwegyemure gw'amaizi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.7",
            "verseOrgIds": [
              "GEN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha nyamaishwa ezitarikuzira n'ezirikuzira n'aha birikuguruka, n'aha birikugyendesa enda byona, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.8",
            "verseOrgIds": [
              "GEN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "haataaha bibiri bibiri, byashanga Noa omu meeri, ekishaija n'ekikazi, nk'oku Ruhanga yaaragiire Noa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.9",
            "verseOrgIds": [
              "GEN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro mushanju ku byahingwire, omwegyemure gw'amaizi gwashandaara aha nsi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.10",
            "verseOrgIds": [
              "GEN.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
