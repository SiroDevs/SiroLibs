                "loc": "GEN.15.7"
              },
              "items": [
                {
                  "text": "Kut 15:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagambira Abramu ati: Ruga omu nsi yaanyu, n'omu ruganda rwanyu n'omu nju ya sho, oze omu nsi ei ndikworeka; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.1",
            "verseOrgIds": [
              "GEN.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.6"
              },
              "items": [
                {
                  "text": "Kut 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.18"
              },
              "items": [
                {
                  "text": "18:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.3"
              },
              "items": [
                {
                  "text": "46:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.8"
              },
              "items": [
                {
                  "text": "1 Bag 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ndyakuhindura eihanga rihango; kandi ndyakuha omugisha, ndangaanise eiziina ryawe; naiwe oryahaisa abandi omugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.2",
            "verseOrgIds": [
              "GEN.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.35"
              },
              "items": [
                {
                  "text": "Kut 24:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.4"
              },
              "items": [
                {
                  "text": "26:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.14"
              },
              "items": [
                {
                  "text": "28:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.8"
              },
              "items": [
                {
                  "text": "Gal 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndyaha omugisha abarikushabira omugisha, n'orikukyeena ndyamukyeena; kandi omuriiwe enganda zoona ez'omu nsi nimwo ziriheerwa omugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Abramu yaagyenda, nk'oku MUKAMA yaamugambiire, na Looti yaagyenda nawe; kandi Abramu akaba ahikize emyaka makumi mushanju n'etaano, obu yaaruga Harani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.4",
            "verseOrgIds": [
              "GEN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.8"
              },
              "items": [
                {
                  "text": "Heb 11:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abramu yaagyenda na Sarai omukazi we, na Looti omwana w'omurumuna, n'ebi baabaire batungire byona, n'abantu abu baatungiire Haraani; baarugayo kuza omu nsi ya Kanaani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baahikire omu nsi ya Kanaani, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu yaaraba omu nsi egyo, yaahika omu mwanya ogurikwetwa Shekemu aha mwela gwa Moore. Omu bunaku obwo aba Kanaani bakaba bari omuri egyo nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.6",
            "verseOrgIds": [
              "GEN.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.1"
              },
              "items": [
                {
                  "text": "Kut 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.34.4"
              },
              "items": [
                {
                  "text": "Bir 34:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.4"
              },
              "items": [
                {
                  "text": "Kut 13:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaayeyoreka Abramu, yaamugira ati: Ensi egi ndyagiha oruzaaro rwawe. Aho yaayombekyeraho MUKAMA, owaamweyorekire, eitambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.7",
            "verseOrgIds": [
              "GEN.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaarugayo, yaaza omu kibungo aha rubaju rw'oburugwa-izooba bwa Beseeli, emuri oburengyerwa-izooba na Ai oburugwa-izooba; okwo nayo yaayombekyerayo MUKAMA eitambiro, yaatakira eiziina rye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.8",
            "verseOrgIds": [
              "GEN.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu yaagumizamu, naatoora omu nsi ya Negebu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
            "verseOrgIds": [
              "GEN.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
            "verseOrgIds": [
              "GEN.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
            "verseOrgIds": [
              "GEN.12.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.1"
              },
              "items": [
                {
                  "text": "Kut 26:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima haabaho enjara omuri egyo nsi; Abramu yaashuuma Misri kushuhuukirayo; ahakuba enjara ekaba eri nyingi omu nsi egyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
            "verseOrgIds": [
              "GEN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaabaire ari haihi kuhika Misri, yaagambira omukazi we Sarai ati: Reeba nimmanya ku ori omukazi murungi orikureebwa; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.11",
            "verseOrgIds": [
              "GEN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.5+GEN.20.6+GEN.20.7+GEN.20.8+GEN.20.9+GEN.20.10+GEN.20.11+GEN.20.12+GEN.20.13+GEN.20.14+GEN.20.15+GEN.20.16+GEN.20.17+GEN.20.18"
              },
              "items": [
                {
                  "text": "Kut 20:5-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi aba Misri ku barikureeba, baryagira bati: Ogu n'omukazi we; baanyite, haza iwe bakurekye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.12",
            "verseOrgIds": [
              "GEN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.25"
              },
              "items": [
                {
                  "text": "Efe 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu ninkweshengyereza, ogume ogire oti: Ni munyaanyazi mbone kutunga omugisha ahabwawe, ndekye kufa, nkaba niiwe naazira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.13",
            "verseOrgIds": [
              "GEN.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu ku yaahikire Misri, aba Misri baareeba omukazi ari murungi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.14",
            "verseOrgIds": [
              "GEN.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyiginya ba Faraho baamureeba, baamusiimira Faraho; bwanyima baamutwara omu nju ya Faraho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.15",
            "verseOrgIds": [
              "GEN.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraho yaatwaza gye Abramu ahabwa Sarai; kandi Abramu akaba aine entaama n'ente n'enimi z'endogoya n'abahuuku n'abazaana, ebuguma z'endogoya n'engamira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.16",
            "verseOrgIds": [
              "GEN.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.14"
              },
              "items": [
                {
                  "text": "Zab 105:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaareetera Faraho n'eka ye ebibonaboneso bingi ahabwa Sarai muka Abramu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.17",
            "verseOrgIds": [
              "GEN.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.10"
              },
              "items": [
                {
                  "text": "Kut 26:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Faraho yaatuma Abramu, yaamugira ati: Beitu shi, ontuzire ki? Ahabw'enki tongambiire ku ari omukazi waawe? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.18",
            "verseOrgIds": [
              "GEN.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongiriire ki oti: Ni munyaanazi? Naanye nikyo mmutwariire kuba omukazi wangye. Mbwenu omukazi waawe ngugwo, omutware, oyegyendere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.19",
            "verseOrgIds": [
              "GEN.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraho nikwo kuragiira abashaija be oku baraamutwaze; batyo bakamushendekyereza n'omukazi we n'ebi yaabaire aine byona.",
          "type": "text",
