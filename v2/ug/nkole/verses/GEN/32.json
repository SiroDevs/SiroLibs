              "items": [
                {
                  "text": "Isa 6:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yakobo yaayeta ogwo mwanya Penueli, naagira ati: Nyereebaniire na Ruhanga amaisho n'amaisho, tinaafa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizooba ryarasha naarengyera Penueli, naagyenda omunyugu aha bw'eigufa ry'eitako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli nikyo bazirira enyama y'aha mutsi gw'eitako ry'ekibero n'okuhitsya hati; ahabw'okuba ogwo mushaija akakora aha mutsi gw'eitako ry'ekibero kya Yakobo.",
          "type": "text",
