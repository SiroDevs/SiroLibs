              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau ku yaahikize emyaka makumi ana, yaashwera Yudeesi muhara wa Beeri Omuhiiti, na Basemaasi muhara wa Eloni Omuhiiti; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
