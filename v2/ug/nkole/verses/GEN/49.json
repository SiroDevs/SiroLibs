            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yakobo yaayeta abatabani, yaagira ati: Mweteerane hamwe, mbahanuurire ebiribabaho omu biro by'omumaisho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
            ]
          }
