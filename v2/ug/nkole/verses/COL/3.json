              "COL.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.5",
            "verseOrgIds": [
              "COL.3.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.13"
              },
              "items": [
                {
                  "text": "Rom 8:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo mwite eby'ensi ebiri omu ngingo zaanyu, obushambani, ebihagaro, okurigira okubi, okwetenga okubi, kandi n'okwetenga, nikwo kuramya ebishushani. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.5",
            "verseOrgIds": [
              "COL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.6"
              },
              "items": [
                {
                  "text": "Efe 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo nibyo bireeta ekiniga kya Ruhanga aha batarikuhurira, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.6",
            "verseOrgIds": [
              "COL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi naimwe mukaba mubigyenderamu, obu mwabaire mukibirimu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.7",
            "verseOrgIds": [
              "COL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.25+EPH.4.26+EPH.4.27+EPH.4.28+EPH.4.29+EPH.4.30+EPH.4.31"
              },
              "items": [
                {
                  "text": "Efe 4:25-31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.4"
              },
              "items": [
                {
                  "text": "5:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka hati mbwenu murekye n'ebi byona, okuguubwa kubi, ekiniga, eitima, n'okujumiirana, kandi omu kanwa kaanyu hatarirugamu ebigambo ebirikwitsa enshoni. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.8",
            "verseOrgIds": [
              "COL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaribeihana, ahakuba mukajuura omuntu owa ira n'emitwarize ye, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.9",
            "verseOrgIds": [
              "COL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.24"
              },
              "items": [
                {
                  "text": "Efe 4:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwajwara omuntu omusya, ohindurwa musya obutoosha omu bwengye kushushanisibwa n'Owamuhangire. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.10",
            "verseOrgIds": [
              "COL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.28"
              },
              "items": [
                {
                  "text": "Gal 3:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aho tihariho Mugiriika n'obuyaakuba n'Omuyudaaya, oshazirwe n'otashazirwe, omunyamahanga, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.11",
            "verseOrgIds": [
              "COL.3.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:11",
              "type": "text"
            },
            {
              "text": "N'eiziina ry'amahanga mabisi.",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'Omusikuusi, omuhuuku n'ow'obusingye, kureka Kristo ni byona, kandi ari omuri boona. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.11",
            "verseOrgIds": [
              "COL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.2"
              },
              "items": [
                {
                  "text": "Efe 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo nk'oku muri abaatoorainwe Ruhanga, abarikwera kandi abarikukundwa, mujware omutima gw'esaasi, embabazi, okutwaza gye, obucureezi, n'okugumisiriza, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.12",
            "verseOrgIds": [
              "COL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimugumisiririzana; kandi ku haraabe hariho oine eki arikufa na mugyenzi we, musaasirane; nk'oku Mukama yaabasaasiire, mube nikwo mwatwaza. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.13",
            "verseOrgIds": [
              "COL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.13.8"
              },
              "items": [
                {
                  "text": "Rom 13:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.13.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi okwongyera ahari ebyo byona mujware okukunda, nikwo kukomerana byona bikakwatanisiza kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.14",
            "verseOrgIds": [
              "COL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.7"
              },
              "items": [
                {
                  "text": "Fil 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi obusingye bwa Kristo obu mwayeteirwe nk'engingo z'omubiri gumwe, butegyekye omu mitima yaanyu. Kandi mube abarikusiima. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.15",
            "verseOrgIds": [
              "COL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya Kristo kigume omuriimwe kikanye, mwegyesane, muhanane omu bwengye burungi bwona, nimweshongorera Ruhanga zaaburi n'ebyeshongoro n'eibyevugo by'Omwoyo, nimumuhimbisa omu mitima yaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.16",
            "verseOrgIds": [
              "COL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi eki muraagambe kyona, n'eki muraakore kyona, byona mubikore omu iziina rya Mukama waitu Yesu, nimusiima Ruhanga Isheboona omuriwe.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.17",
            "verseOrgIds": [
              "COL.3.17"
            ]
          }
        }
      ]
    },
    {
