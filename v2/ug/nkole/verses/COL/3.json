              "COL.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.12"
              },
              "items": [
                {
                  "text": "Kol 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu nu ku muraabe mwazoirwe na Kristo, musherure ebiri omu iguru, ei Kristo atuura, ashutami aha rubaju rwa buryo rwa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.1",
            "verseOrgIds": [
              "COL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.33"
              },
              "items": [
                {
                  "text": "Mat 6:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mute omutima aha by'omu iguru, murekye eby'omu nsi; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.2",
            "verseOrgIds": [
              "COL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba mukafa, kandi amagara gaanyu gasherekirwe na Kristo omuri Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.3",
            "verseOrgIds": [
              "COL.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.1.21"
              },
              "items": [
                {
                  "text": "Fil 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kristo amagara gaitu ku ariboneka, naimwe muryareebwa muri hamwe nawe omu kitiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.4",
            "verseOrgIds": [
              "COL.3.4"
            ]
          }
        }
      ]
    },
    {
