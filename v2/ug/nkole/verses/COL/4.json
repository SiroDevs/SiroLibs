                "loc": "1PE.3.15"
              },
              "items": [
                {
                  "text": "1 Pet 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebigambo byanyu bigume biri eby'embabazi, nk'ebirimu omwonyo, mubone kumanya oku mushemereire kugarukamu omuntu weena.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
