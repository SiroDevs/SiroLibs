            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwezirikire okushaba; omu kushaba kwanyu mugume nimureeba hamwe n'okusiima; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.2",
            "verseOrgIds": [
              "COL.4.2"
