                "loc": "EPH.5.15"
              },
              "items": [
                {
                  "text": "Efe 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ab'aheeru mubagyendemu n'obwengye, murekye kufiisa busha omwanya. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.5",
            "verseOrgIds": [
              "COL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
