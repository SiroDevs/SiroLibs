              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aristariiko ou mbohirwe nawe yaabaramutysa, na Mako mwihwa wa Barunaba, (ou mwaragiirwe, ngu ku ariija, mumwakiire); ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yesu orikwetwa Yusto yaabaramutsya. Omu bakozi bagyenzi bangye abu nkora nabo omurimo gw'obukama bwa Ruhanga, abo nibo bonka abaarugire omu bashazirwe, kandi bakampuumuza. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epafura, mwene waanyu, yaabaramutsya; nawe n'omuhuuku wa Kristo Yesu, oyezirika obutoosha kubaijuka omu kushaba kwe, ngu mugume muri abahikire, kandi abarikumanyira kimwe byona ebi Ruhanga akunda. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba nimmuhamya ku akozire omurimo muhango munonga ahabwanyu n'ahabw'aba Laodikea, n'aba Hierapooli. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
              "COL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.10"
              },
              "items": [
                {
                  "text": "2 Tim 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Luka omufumu orikukundwa na Deema baabaramutsya. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundamukize ab'eishe-emwe ab'omuri Laodikea, kandi muramutsye na Numfa n'ekanisa y'omu nju ye.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.15",
            "verseOrgIds": [
              "COL.4.15"
            ]
          }
        }
      ]
    },
    {
