                  "text": "Rom 15:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi naitwe mutushabire Ruhanga atwigurire orwigi, tubone kugamba ekigambo ky'okumanyisa enaama ya Kristo, eki mboheirwe, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.3",
            "verseOrgIds": [
              "COL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkimanyise nk'oku nshemereire kugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.4",
            "verseOrgIds": [
              "COL.4.4"
            ]
          }
        },
        {
