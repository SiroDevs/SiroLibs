            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba kwo turi abahuuku; kwonka Ruhanga tatutsigireho mubuhuuku bwaitu, kureka atworekire embabazi ze omu maisho g'abagabe b'Abaperisi; yaatugaruramu otugara, ngu tubone agombeka enju ya Ruhanga waitu, okuhunduuza ahasiisikaire, n'okutubeera orugo rw'okuturinda omuri Yuda na Yerusaalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.9",
            "verseOrgIds": [
              "EZR.9.9"
            ]
