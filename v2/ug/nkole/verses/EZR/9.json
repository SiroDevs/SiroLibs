          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.6"
              },
              "items": [
                {
                  "text": "Bir 23:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo mutarihingira bahara baanyu batabani baabo, nari kushwererera batabani baanyu bahara baabo, n'obu kwakuba okubendeza obusingye nari okuba gye, mubone kuba ab'amaani, n'okurya ebirungi by'ensi, kandi n'okugitsigira abaana baanyu, ekaba obuhunguzi bwabo obw'ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.12",
            "verseOrgIds": [
              "EZR.9.12"
            ]
          }
        },
