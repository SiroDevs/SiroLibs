              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku naahuriire ebyo, naataagura ebijwaro n'omunagiro gwangye, naayemaanyura eishokye omu mutwe, kandi n'obureju, naashutama ahansi nshobeirwe munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.3",
            "verseOrgIds": [
              "EZR.9.3"
            ]
          }
        },
