            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.24+LEV.18.25+LEV.18.26+LEV.18.27+LEV.18.28+LEV.18.29+LEV.18.30"
              },
              "items": [
                {
                  "text": "Lev 18:24-30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.1"
              },
              "items": [
                {
                  "text": "Bir 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ebi waaragiira nooraba omu bairu baawe baanabi, noogira oti: Ensi ei murikuzamu kukubuura n'ensi esiisikaire ahaba'ebihagaro by'abantu baamwo, n'ebirikunugwa byabo ebigiijwize, okutashemera kukshaagaana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.11",
            "verseOrgIds": [
              "EZR.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 9:12"
          },
          "items": [
