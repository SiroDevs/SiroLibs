                {
                  "text": "1 Bag 8:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obunaku bw'ekitambo ky'omu mwabazyo ku bwahikire, naimuka ahu naabaire nyecureereize, ebijwaro byange n'omunagiro gwangye bitaagukire, naatsimba amaju, naateega MUKAMA Ruhanga wangye emikono, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.5",
            "verseOrgIds": [
              "EZR.9.5"
            ]
          }
        },
