              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Ezera yaaruga ahu yaabaire ari omu maisho g'enju ya Ruhanga, yaataaha omu kishengye kya Yehohanani mwene Eliashibu, yaaraaramu atariire n'obu kwakuba okunywa amaizi; ahakuba akaba naasaasibwa okucumura kw'abaarugire omu bukwatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.6",
            "verseOrgIds": [
              "EZR.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima baaranga omuri Yuda yoona na Yerusaalemu, ngu abantu boona abaarugire omu bukwatwa bateeranire Yerusaalemu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.7",
            "verseOrgIds": [
              "EZR.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ngu omuntu weena ku araabe atahikireyo omu biro bishatu, ebintu bye byona binyagwe, kandi nawe acuubwe omu mutwe gw'abaarugire omu bukwatwa, nk'oku abategyeki n'abakuru baaragiire.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.8",
            "verseOrgIds": [
              "EZR.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.8",
            "verseOrgIds": [
              "EZR.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima abashaija ba Yuda na Benyamiini boona baateeranira Yerusaalemu, ebyo biro bishatu bitakahweire; obwo kukaba kuri okwezi kwa mwenda, aha kiro kyakwo kya makumi abiri. Abantu boona baashutama omu kibuga ky'omu maisho g'enju ya Ruhanga, nibatetema ahabw'ekyo kigambo, n'ahabw'enjura nyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.9",
            "verseOrgIds": [
              "EZR.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezera omunyamurwa yaayemerera, yaabagira ati: Mukacumura, mwashwera abakazi b'abanyamahanga, mwayongyerera Israeli orubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.10",
            "verseOrgIds": [
              "EZR.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.19"
              },
              "items": [
                {
                  "text": "Yos 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo hati mwaturire MUKAMA Ruhanga wa baashwenkuriimwe ekibi kyanyu, mukore eki arikwenda; mwetaanise n'abantu b'omuri egi nsi kandi n'abanyamahangakazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.11",
            "verseOrgIds": [
              "EZR.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho abantu boona abaabaire bateeraniireyo baagarukamu n'eiraka rihango bati: Nikwo kiri; tushemereire kukora, nk'oku waagamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.12",
            "verseOrgIds": [
              "EZR.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka abantu ni baingi; kandi n'obunaku bw'enjura nyingi; titurikubaasa kwemerera aheeru. Kandi omurimo ogu ti gw'ekiro kimwe nari bibiri; ahakuba tukacumura munonga omu kigambo eki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.13",
            "verseOrgIds": [
              "EZR.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.4"
              },
              "items": [
                {
                  "text": "Kub 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.30.8"
              },
              "items": [
                {
                  "text": "2 Bus 30:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abakuru baitu ka beemerere omu iziina ry'eihanga ryona; bwanyima ab'omu ndembo zaitu boona, abaashweire abanyamahangakazi, baije omu bunaku obu bateereirweho, hamwe n'abakuru n'abaramuzi aba buri rurembo, okuhitsya obu ekiniga kya Ruhanga waitu ekingi, eki atugiriire ahabw'ekigambo eki, kiraaturugyeho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.14",
            "verseOrgIds": [
              "EZR.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Yonasaani mwene Asaheeli na Yahazeya mwene Tikuva baayanga egyo naama, kandi Meshulaamu na Shabesai Omuleevi baikirizana nabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.15",
            "verseOrgIds": [
              "EZR.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.15",
            "verseOrgIds": [
              "EZR.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo abaarugire omu bukwatwa baaba nikwo baatwaza. Ezera omunyamurwa yaatoorana abashaija, abakuru b'amaju ga baishenkurubo, nk'oku ago maju gaabaire gari, kuba abajwekyerwa nk'oku amaziina gaabo gaabaire gari. Aha kiro ky'okubanza ky'okwezi kwa ikumi baashutama kwetegyereza ebyo bigambo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.16",
            "verseOrgIds": [
              "EZR.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi aha kiro ky'okubanza eky'okwezi kw'okubanza baashangwa baaherize ebigambo by'abashaija boona abaabaire bashweire abanyamahangakazi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.17",
            "verseOrgIds": [
              "EZR.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
