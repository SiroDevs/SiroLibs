              },
              "items": [
                {
                  "text": "13:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho Ezera yaimuka, yaarahiza abakuru b'omu banyamurwa, n'Abaleevi, n'Abaisraeli boona, ku bakora nk'oku kigambirwe. Batyo baarahira.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.5",
            "verseOrgIds": [
              "EZR.10.5"
            ]
          }
        }
