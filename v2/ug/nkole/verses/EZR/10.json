            "sid": "EZR 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.5.12"
              },
              "items": [
                {
                  "text": "Neh 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
