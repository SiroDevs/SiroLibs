                "loc": "EZR.7.24"
              },
              "items": [
                {
                  "text": "Ezr 7:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.21"
              },
              "items": [
                {
                  "text": "1 Bag 4:21",
