            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " baija ahari Zerubabeeli n'abakuru b'amaju ga baishenkurubo, baabagira bati: Ka twombekye hamwe naimwe; ahakuba naitwe turamya Ruhanga waanyu, nk'oku mumuranya, kandi tutuura nitumutambira ebitambo, okuruga omu busingye bwa Esari-hadoni, omugabe wa Asiria owaatureetsire aha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        },
        {
