              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima abantu b'omuri egyo nsi baateera Abayuda aha mutwe, baabatiinisa kwombeka, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "baaguriirira abahi b'obwengye kubazibira kuhikiiriza eki barikwenda kukora; byaguma bityo omu busingye bwa Kuuro omugabe wa Perisi bwona okuhitsya omu busingye bwa Dario omugabe wa Perisi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        }
      ]
    },
