                "loc": "PSA.72.8"
              },
              "items": [
                {
                  "text": "Zab 72:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ngu rukaba rubamu abagabe b'amaani abaabaire bategyeka Yerusaalemu n'ebyanga byona ebya seeri y'Omugyera, kandi bakaba baheebwa emitoijo n'omushoro n'empooza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.20",
            "verseOrgIds": [
              "EZR.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo muteho ekiragiro abo bashaija barekyere aho, orwo rurembo rurekye kwombekwa, okuhitsya obu ndibaragiira ekindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.21",
            "verseOrgIds": [
              "EZR.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mwerinde, muteeganda ahari ekyo, akabai katakaakura, kakareetera abagabe kufeerwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        }
      ]
