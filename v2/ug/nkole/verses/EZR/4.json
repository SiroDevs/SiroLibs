                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.9"
              },
              "items": [
                {
                  "text": "Yoh 4:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Zerubabeeli na Yeshua n'abandi bakuru b'amaju ga baishenkuru b'Abaisraeli baabagarukamu bati: Timwine kakwate naitwe kwombekyera Ruhanga waitu enju; kureka itwe twenka nitwija kwombekyera MUKAMA, Ruhanga wa Israeli, nk'oku Nyakusinga Kuuro omugabe wa Perisi yaaturagiire.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        }
      ]
    },
    {
