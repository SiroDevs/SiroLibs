              "items": [
                {
                  "text": "Est 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omu busingye bwa Ahasuero, ku yaabaire naakitandika, baahandiika ebaruha nibarega abatuuzi ba Yuda na Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.26"
              },
              "items": [
                {
                  "text": "2 Bag 18:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima omu busingye bwa Aruta-gizakiseeski, Bishulaamu, Mesiredaasi, abeeli na bagyenzi baabo abandi baahandiikira Aruta-gizakiseesi omugabe wa Perisi; egyo baruha baagihandiika omu rurimi rwa Siria, kandi baagihindura. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehumu omutegyeki na Shimushai omuhandiiki nabo baahandiikira Aruta-gizakiseesi ebaruha nibarega Yerusaalemu ni bagira bati:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        }
      ]
    },
