            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi otware efeeza n'ezaabu, ebi nyowe omugabe n'abahi b'obwengye bangye tutoijeire Ruhanga, otuura Yerusaalemu, ahabwaitu, ",
          "type": "text",
