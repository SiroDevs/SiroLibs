                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi n'abani omu Baisraeli bainamuka hamwe nawe n'abamwe aha banyamurwa, Abaleevi, abeeshongozi, abakumiirizi n'abaheereza b'omuri hekalu, baaza Yerusaalemu omu mwaka gwa mushanju ogw'omu busingye bw'omugabe Aruta-gizakiseesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezera yaahika Yerusaalemu omu kwezi kwa kataano omu mwaka gwa mushanju ogw'omu busingye bw'ogwo mugabe; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba aha kiro ky'okubanza eky'okwezi kw'okubanza akatandika kuruga Babulooni, kandi aha kiro ky'okubanza omu kwezi kwa kataano yaahika Yerusaalemu, ahabw'okuba omukono gwa Ruhanga we omurungi gukaba gumuriho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
