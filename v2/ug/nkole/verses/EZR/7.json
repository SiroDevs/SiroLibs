            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.26"
              },
              "items": [
                {
                  "text": "12:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ezera ogwo akaruga Babulooni, yainamuka kuza Yerusaalemu; kandi akaba ari omuhandiiki w'obwengye omu by'ebiragiro bya Musa, ebyahairwe MUKAMA Ruhanga wa Israeli. Omugabe yaamuha ebi yaashabire byona, ahabw'okuba omukono gwa MUKAMA Ruhanga we gukaba gumuriho.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        }
      ]
    },
