            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Ezera ogwo akaba ataire omutima gwe aha kwega ebiragiro bya MUKAMA, n'okubyorobera, kandi n'okwegyesa Abaisraeli ebyo biragiro n'emigyenzo eyaatairweho.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
