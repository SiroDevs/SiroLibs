          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi weena otariikiriza kworobera biragiro bya Ruhanga waawe n'eby'omugabe, aheebwe ekifubiro, atarikusaasirwa, eky'okwitwa, nari okubingwa, nari okunyagwa ebintu bye, nari okuteebwa omu kihome. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.26",
            "verseOrgIds": [
              "EZR.7.26"
            ]
          }
        },
