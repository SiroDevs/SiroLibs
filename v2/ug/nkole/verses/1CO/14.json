                {
                  "text": "1 Yoh 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu weena orikweteekateekaho ngu ni nabi, nari ow'Omwoyo, amanye ngu eki mbahandiikiire n'ekiragiro kya Mukama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi weena otarikukiikiriza tarikwikirizibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo, Beene Tata, mwetengye munonga okubuurira, kandi mutazibira okugamba “endimi”; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.39",
            "verseOrgIds": [
              "1CO.14.39"
            ]
          }
        },
        {
