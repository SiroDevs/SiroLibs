              "items": [
                {
                  "text": "1 Tim 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku biri omu makanisa goona ag'abarikwera, abakazi bahuname omu makanisa; ahakuba tibarikwikirizibwa kugamba, kureka okworoba, nk'oku Ebiragiro nabyo biragiira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi baaba nibenda kushoborokyerwa ekigambo, bakibuurize abashaija baabo omuka, ahabw'okuba n'eky'enshoni omukazi kugamba omu kanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu, nimugira ngu niimwe ekigambo kya Ruhanga kyakomookiremu? Nari niimwe mwenka abu kyaiziire?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        }
      ]
    },
