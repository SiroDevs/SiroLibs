            "sid": "1CO 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka mute omutima aha kusherura ebiconco ebirikukira oburungi. Kandi niinyija kubooreka omuhanda ogurikukira oburungi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
