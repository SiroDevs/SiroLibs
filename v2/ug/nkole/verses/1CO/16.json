              "items": [
                {
                  "text": "Fil 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimbeehanangiriza kworobera abari nk'abo, n'ondiijo weena orikukwatanisa n'abandi omu mirimo n'obweziriki. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nyine okushemererwa ahabw'okwija kwa Stefana na Forutunaato na Akaiko; ahabw'okuba bammazire orushusho oru naabaire mbainiire; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.17",
            "verseOrgIds": [
              "1CO.16.17"
            ]
          }
        },
