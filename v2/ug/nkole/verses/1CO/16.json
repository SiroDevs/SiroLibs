        },
        {
          "text": " ahakuba bakaruhuura omwoyo gwangye n'ogwanyu. N'ahabw'ekyo abari nk'abo mubamanye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.18",
