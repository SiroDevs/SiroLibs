              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakanisa g'omuri Asia gabaramutsya. Akula na Pruskila n'ekanisa eteeranira omu ka yaabo baabaramutsya munonga omuri Mukama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.19",
            "verseOrgIds": [
              "1CO.16.19"
            ]
          }
        },
        {
          "name": "verse",
