            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "Byak 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ndyabataayaayira ninduga Makedeonia; ahabw'okuba ndyarabayo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi shana ndyaguma naimwe, obundi nkaamarirayo n'ebiro by'embeho, mubone kunshendekyereza ahi ndiza hoona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba tindikwenda kubarabyaho amaguru hati; ahabw'okuba nyine amatsiko g'okumara naimwe ebiro, Mukama ku arikunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ndyaguma omuri Efeso okuhitysa aha kiro kya Pentekoote; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.8",
            "verseOrgIds": [
              "1CO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.12"
              },
              "items": [
                {
                  "text": "2 Kor 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.8"
              },
              "items": [
                {
                  "text": "Kush 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba nyiguriirwe orwigi ruhango kuza omu mirimo ey'omugasho; kwonka abarikundwanisa ni baingi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
              "1CO.16.9"
            ]
          }
        }
      ]
