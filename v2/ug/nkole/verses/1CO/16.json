                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eby'ow'eishe-emwe Apolo nkamweshengyereza munonga kubataayaayira n'ab'eishe-emwe; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.12",
            "verseOrgIds": [
              "1CO.16.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:12",
              "type": "text"
            },
            {
              "text": "Nari: kwonka tiyaayendera kimwe kwija hati.",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka Ruhanga tasiimire ku aija hati; kureka aryaija yaabona omwanya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.12",
            "verseOrgIds": [
              "1CO.16.12"
            ]
          }
        }
      ]
