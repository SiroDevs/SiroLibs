                "loc": "LEV.18.7"
              },
              "items": [
                {
                  "text": "Lev 18:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Enkuru ebugire hoona ngu omuriimwe harimu obushambani, kandi obushambani obutarikushangwa n'omu Banyamahanga, omuntu okuraara na muka ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.1",
            "verseOrgIds": [
              "1CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nimwehimbisa! Timushemereire kushaasha, mukaiha omuriimwe ogwo okozire ekyo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.2",
            "verseOrgIds": [
              "1CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.5"
              },
              "items": [
                {
                  "text": "Kol 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'obu ndaabe ntari naimwe omu mubiri, kwonka ndi naimwe omu mwoyo; nk'ori naimwe buzima, omu iziina rya Mukama waitu Yesu mperize kucwa orubanja rw'omuntu ogwo okozire ekibi ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.3",
            "verseOrgIds": [
              "1CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.18"
              },
              "items": [
                {
                  "text": "Mat 18:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.10"
              },
              "items": [
                {
                  "text": "2 Kor 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku muriba muteeraine, naanye ndi hamwe naimwe omu mwoyo n'amaani ga Mukama waitu Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.4",
            "verseOrgIds": [
              "1CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.20"
              },
              "items": [
                {
                  "text": "1 Tim 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mushemereire kuhayo omuntu ogwo ahari Sitaane, ahwerekyerere omu mubiri, omwoyo gwe gubone kujunwa aha kiro kya Mukama waitu Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.5",
            "verseOrgIds": [
              "1CO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.5",
            "verseOrgIds": [
              "1CO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwehimbisa kwanyu ti kurungi. Timurikumanya ngu akatumbisa kakye katumbisa ekiihuro kyona? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.6",
            "verseOrgIds": [
              "1CO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.19"
              },
              "items": [
                {
                  "text": "1 Pet 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwihemu ekitumbisa ekya ira, mubone kuba ekiihuro kisya, mutarimu kitumbisa. Ahakuba Kristo Omwana gw'entaama ogw'Okuhingurwaho kwaitu akatambwa ahabwaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.7",
            "verseOrgIds": [
              "1CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13+EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Kur 12:3-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo ka tugume turinde ekiro ky'Obugyenyi obwo, tutaine kitumbisa ekya ira n'obu kyakuba eky'eitima n'obubi, kureka omugaati ogutarimu kitumbisa ogushemeire, kandi ogw'amazima.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.8",
            "verseOrgIds": [
              "1CO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.8",
            "verseOrgIds": [
              "1CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu baruha ei naabahandiikiire nkabaragiira kutakwatanisa na bashambani; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.9",
            "verseOrgIds": [
              "1CO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka tindagambire kutaanira kimwe n'abashambani b'ensi egi, nari abeetengi, nari abambuzi, nari abarikuramya ebishushani; ahabw'okuba ku kyakubaire kityo, mukaabaire mushemereire kuruga omu nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.10",
            "verseOrgIds": [
              "1CO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.6"
              },
              "items": [
                {
                  "text": "2 Tes 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2JN.1.10"
              },
              "items": [
                {
                  "text": "2 Yoh 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka eki naabahandiikiire, n'okutakwatanisa na muntu orikwetwa ow'eishe-emwe, ku araabe ari omushambani, nari omwetengi, nari orikuramya ebishushani, nari omujumi, nari omusinzi, nari omwambuzi; orikushusha atyo, n'okurya mutarirya nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.11",
            "verseOrgIds": [
              "1CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyowe ninfa ki okucwera ab'aheeru orubanja? Ab'omu kanisa ti bo mushemereire kucwera orubanja? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.12",
            "verseOrgIds": [
              "1CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ab'aheeru Ruhanga niwe arirubacwera. Mwihe omuriimwe omuntu ogwo omubi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.13",
            "verseOrgIds": [
              "1CO.5.13"
            ]
          }
        }
      ]
    }
  ],
