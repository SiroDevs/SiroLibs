                "loc": "JHN.16.12"
              },
              "items": [
                {
                  "text": "Yoh 16:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka, B'eishe-emwe, tindabaasize kubagambira nk'ab'Omwoyo, kureka nk'ab'omubiri, nk'abeereere omuri Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.1",
            "verseOrgIds": [
              "1CO.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.12"
              },
              "items": [
                {
                  "text": "Heb 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nkabagaburira amate, tindabahaire by'okurya bigumire; ahabw'okuba mukaba mutakabibaasize. Kandi na hati hoona timukabibaasize, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.2",
            "verseOrgIds": [
              "1CO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.10+1CO.1.11+1CO.1.12"
              },
              "items": [
                {
                  "text": "1 Kor 1:10-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.18"
              },
              "items": [
                {
                  "text": "11:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba mukiri ab'omu mubiri kwonka. Omuriimwe ku haraabe harimu eihari n'empaka, timuri omu buryo bw'omubiri, abarikutwaza nk'abantu-buntu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.3",
            "verseOrgIds": [
              "1CO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwe ku araabe naagira ati, Nyowe ndi owa Paulo; n'ondiijo ati, Nyowe ndi owa Apolo, obwo nimuba mutari abantu-buntu?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.4",
            "verseOrgIds": [
              "1CO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.4",
            "verseOrgIds": [
              "1CO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu Apolo n'enki? Nari Paulo n'enki? N'abakozi abaabaikiririise, nka buri omwe oku Mukama yaamuhaire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.5",
            "verseOrgIds": [
              "1CO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.11"
              },
              "items": [
                {
                  "text": "Byak 18:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyowe nkabyara, Apolo yaitirira amaizi, kwonka Ruhanga niwe yaabikurize. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.6",
            "verseOrgIds": [
              "1CO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo orikubyara ti kintu, n'obu yaakuba orikwitirira amaizi, kureka Ruhanga okuza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.7",
            "verseOrgIds": [
              "1CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orikubyara n'orikwitirira amaizi nibaingana, kandi buri omwe aryaheebwa ebihembo nk'omurimo gwe oku guriba guri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.8",
            "verseOrgIds": [
              "1CO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.3+MAT.13.4+MAT.13.5+MAT.13.6+MAT.13.7+MAT.13.8+MAT.13.9"
              },
              "items": [
                {
                  "text": "Mat 13:3-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba turi abakozi abakora kumwe, nitukorera Ruhanga; imwe muri omusiri gwa Ruhanga, n'enju erikwombekwa Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.9",
            "verseOrgIds": [
              "1CO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
