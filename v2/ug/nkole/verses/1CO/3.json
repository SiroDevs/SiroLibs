                "loc": "REV.3.17"
              },
              "items": [
                {
                  "text": "Kush 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu weena arekye kwebeiha. Omuriimwe ku haraabe harimu orikweteekateeka kuba ow'obwengye bw'obusingye obu, ahindukye omushema, abone kuba ow'obwengye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.18",
            "verseOrgIds": [
              "1CO.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 3:19"
          },
