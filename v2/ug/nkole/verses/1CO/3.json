          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.19"
              },
              "items": [
                {
                  "text": "1 Kor 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Kor 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Timurikumanya ku muri hekalu ya Ruhanga, kandi n'Omwoyo wa Ruhanga ku atuura omuriimwe? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.16",
            "verseOrgIds": [
              "1CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu weena ku arihwerekyereza hekalu ya Ruhanga, nawe Ruhanga aryamuhwerekyereza, ahakuba hekalu ya Ruhanga n'erikwera, kandi hekalu egyo niimwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.17",
            "verseOrgIds": [
              "1CO.3.17"
            ]
          }
        }
      ]
    },
    {
