              "items": [
                {
                  "text": "Rom 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omukazi akwatwa iba, yaaba akiriho; kwonka iba ku afa, aba aine obusingye okushwerwa ou arikwenda, kwonka omuri Mukama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku yaakuguma aho nk'oku ari, obwo nibwo yaakukiraho kuba gye, nyowe nikwo ndikuteekateeka; kandi ningira ngu nyine Omwoyo wa Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
