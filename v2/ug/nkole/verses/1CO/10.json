            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba ensi n'ebirimu byona n'ebya Mukama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.26",
            "verseOrgIds": [
              "1CO.10.26"
            ]
          }
