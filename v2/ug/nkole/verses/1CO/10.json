            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Byona nibiikirizibwa, kwonka ti byona ebiine omugasho. Byona nibiikirizibwa, kwonka ti byona ebirikwombeka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
