                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku harigira omuntu owaabagambira ati: Eki kitambiirwe baadaimoni, murekye kukirya ahabw'ogwo owaabamanyisa, n'ahabw'eiraka ry'omwoyo eriri omuriimwe; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.28",
            "verseOrgIds": [
              "1CO.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "(eiraka eri ndikugamba ti ryawe, n'ery'omuntu ogwo). Ahabw'enki obusingye bwangye nibucwerwa orubanja eiraka ry'omwoyo gw'ondiijo muntu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.29",
            "verseOrgIds": [
              "1CO.10.29"
            ]
          }
        },
        {
