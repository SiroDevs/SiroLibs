            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwe aha batarikwikiriza ku ariba yaabeetsire aha bugyenyi, mwasiima kuzayo, murye ebi babata omumaisho, mutaine ki mubuurize ahabw'okwiha okubanganisa omu mutima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.27",
            "verseOrgIds": [
              "1CO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 10:28"
          },
          "items": [
