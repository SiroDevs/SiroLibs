                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo ku muraabe nimurya nari nimunywa nari nimukora ekintu kyona, mukore byona okuhimbisisa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.31",
