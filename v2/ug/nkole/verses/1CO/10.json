        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.1",
            "verseOrgIds": [
              "1CO.10.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.22"
              },
              "items": [
                {
                  "text": "Kur 14:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " B'eishe-emwe, tindikwenda ngu mutamanya oku baatatenkuriitwe boona baabaire ahansi y'Ekicu, kandi boona ku baarabire omu Nyanja; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.1",
            "verseOrgIds": [
              "1CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi boona ku baabatiziibwe omu Kicu n'omu Nyanja okukwatanisa na Musa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.2",
            "verseOrgIds": [
              "1CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.35"
              },
              "items": [
                {
                  "text": "Kur 16:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi boona ku baariire eky'okurya kimwe eky'Omwoyo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.3",
            "verseOrgIds": [
              "1CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.6"
              },
              "items": [
                {
                  "text": "Kur 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " boona bakanywa eky'okunyw akimwe eky'Omwoyo; ahakuba bakaba banywa aha rukiri orw'Omwoyo orwabaire rubakurata. Orukiri orwo akaba ari Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.4",
            "verseOrgIds": [
              "1CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka abarikukira obwingi omuribo Ruhanga tarabasiimire, ahakuba bakahwerekyererezibwa omu ihamba.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.6",
            "verseOrgIds": [
              "1CO.10.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.4"
              },
              "items": [
                {
                  "text": "Kub 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo bikaba eby'okutuhabura, ngu turekye kwetenga ebibi nk'oku baabyetengire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.6",
            "verseOrgIds": [
              "1CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.6"
              },
              "items": [
                {
                  "text": "Kur 32:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi murekye kuba abarikuramya ebishushani, nka bamwe omuribo oku baabaire bari, nk'oku kyahandiikirwe ngu: Abantu bakashutama ahansi kurya n'okunywa, baimuka kuzina. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.7",
            "verseOrgIds": [
              "1CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1"
              },
              "items": [
                {
                  "text": "Kub 25:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi tutashambana, nka bamwe omuribo oku baashambaine, hakafa abantu obukumi bubiri n'enkumi ishatu eizooba rimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.8",
            "verseOrgIds": [
              "1CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.5"
              },
              "items": [
                {
                  "text": "Kub 21:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Turekye kugyeza Mukama, nka bamwe omuribo oku baamugyerize, bakamarwaho enjoka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.9",
            "verseOrgIds": [
              "1CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.2"
              },
              "items": [
                {
                  "text": "Kub 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi muteetomboita nka bamwe omuribo oku baayetomboitsire, bakamarwaho Omuhwerekyerezi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.10",
            "verseOrgIds": [
              "1CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo bikabahikaho kuba eby'okureeberaho, kandi bikahandiikwa kutuhuguura, itwe abariho omu biro by'aha muheru gw'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.11",
            "verseOrgIds": [
              "1CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo orikuteekateeka ngu ayemereire ayerinde atagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.12",
            "verseOrgIds": [
              "1CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tihariho kigyezo ekirababaireho ekitari kya bantu boona. Kwonka Ruhanga n'ow'okwesigwa; taribaikiriza kugyezibwa kigyezo eki mutarikubaasa; kureka omu kigyezo ekyo aryabateeraho oburyo bw'okuhunga, ngu mubaase kukigumisiririza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo, abarikukundwa, mwetantare, okuramya ebishushani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.14",
            "verseOrgIds": [
              "1CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbagambira nk'abantu abaine obwengye; mwetegyereze eki ndikugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.15",
            "verseOrgIds": [
              "1CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.27"
              },
              "items": [
                {
                  "text": "Mat 26:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okukwatana ekikopo ky'omugisha, eki tushabira omugisha, tikwo kukwatanisa omu shagama ya Kristo? Okubagana omugaati ogu tucwamu, tikwo kukwatanisa omu mubiri gwa Kristo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.16",
            "verseOrgIds": [
              "1CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.27"
              },
              "items": [
                {
                  "text": "1 Kor 12:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku omugaati guri gumwe, nikwo naitwe, n'obu turi baingi, turi omubiri gumwe, ahabw'okuba twena tubagana omugaati gumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.17",
            "verseOrgIds": [
              "1CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mureebe Abaisraeli omu buzaare bw'omubiri, abarya aha bitambo tibateeranwa eitambiro? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.18",
            "verseOrgIds": [
              "1CO.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu ngambe ki? Nti: Ekihongyeirwe ekishushani n'ekintu? Nari ekishushani kyo n'ekintu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.19",
            "verseOrgIds": [
              "1CO.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.37"
              },
              "items": [
                {
                  "text": "Zab 106:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka eki ndikugamba n'eki nti: Abanyamahanga ebi batamba, babitambira baadaimoni, ti Ruhanga; kandi tindikwenda imwe kukwatanisa na baadaimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.20",
            "verseOrgIds": [
              "1CO.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.15"
              },
              "items": [
                {
                  "text": "2 Kor 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.12"
              },
              "items": [
                {
                  "text": "Mal 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Timurikubaasa kunywa ha kikopo kya Mukama, kandi n'aha kya baadaimoni. Timurikubaasa kuriira ha meeza ya Mukama waitu n'aha ya baadaimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.21",
            "verseOrgIds": [
              "1CO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu nitukwatwa Mukama waitu eihari? Nari shi nitumukiza amaani?",
