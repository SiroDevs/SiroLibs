              },
              "items": [
                {
                  "text": "Rom 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo nk'oku Kristo yaabonabonesiibwe omu mubiri, naimwe muhagatire eby'okurwanisa, nigwo mutima nk'ogwe; ahakuba oherize kubonabonesibwa omu mubiri, biri aherize kureka ebibi, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.1",
            "verseOrgIds": [
              "1PE.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.16"
              },
              "items": [
                {
                  "text": "1 Yoh 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mubone kumara ebiro ebi mutsigaize omu magara g'omubiri, mutarikukora by'okurigira okubi kw'abantu, kureka ebi Ruhanga akunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
            "verseOrgIds": [
              "1PE.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.2"
              },
              "items": [
                {
                  "text": "Efe 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Murekye ebiro ebyahingwire bimare, ebi mwakoreiremu ebi Abanyamahanga bakunda, okugyendera omu micwe mibi ey'obushambani, n'okwetenga okubi, n'obusinzi, n'okuraara enkyera, n'okunywa amaarwa maingi, n'emizizo mibi ey'okuramya ebishushani. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.3",
            "verseOrgIds": [
              "1PE.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekirikubatangaaza n'okureeba mutarikurahuka kukwatanisa nabo omu burare obuhinguraine; nikyo barikubajumira. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.4",
            "verseOrgIds": [
              "1PE.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.42"
              },
              "items": [
                {
                  "text": "Byak 10:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka baryatonganisibwa Ogwo oyeteekateekire kucwa orubanja rw'abahuriire n'abafiire. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.5",
            "verseOrgIds": [
              "1PE.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.19"
              },
              "items": [
                {
                  "text": "1 Pet 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo engiri yaagambiriirwe n'abaafiire, ngu bacwerwe orubanja nk'abantu oku barucwerwa, babone kugira amagara omu mwoyo nka Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emperu ya byona eri haihi; n'ahabw'ekyo mwerinde, muhuguukye, mwezirikire kushaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.7",
            "verseOrgIds": [
              "1PE.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.22"
              },
              "items": [
                {
                  "text": "1 Pet 1:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.7"
              },
              "items": [
                {
                  "text": "1 Kor 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okukira byona mukundane munonga; ahabw'okuba okukunda kushweka ebibi bingi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.8",
            "verseOrgIds": [
              "1PE.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukunirane mutarikunyomwa; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.9",
            "verseOrgIds": [
              "1PE.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.42"
              },
              "items": [
                {
                  "text": "Luk 12:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nk'oku omuntu weena yaahairwe ekiconco, mube nikwo mwabihweresana, nk'ababiiki barungi ab'embabazi za Ruhanga ez'emiringo yoona; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.10",
            "verseOrgIds": [
              "1PE.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.7"
              },
              "items": [
                {
                  "text": "Rom 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " orikugamba agambe nk'orikugamba ebi ashuururiirwe Ruhanga; orikuheereza aheereze n'amani agu Ruhanga amuhaire, Ruhanga abone kuhimbisibwa omuri byona ahabwa Yesu Kristo; aheebwe ekitiinisa n'obutegyeki ebiro byona Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
            "verseOrgIds": [
              "1PE.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
            "verseOrgIds": [
              "1PE.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarikukundwa, mutatangaazibwa omuriro ogwizire kubagyeza, nk'abahikwaho eihano; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.12",
            "verseOrgIds": [
              "1PE.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.41"
              },
              "items": [
                {
                  "text": "Byak 5:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka mushemererwe ahabw'okukwatanisa na Kristo omu busaasi bwe; kandi ekitiinisa kye ku kirishuuruurwa, nabwo mushemererwe n'okwesiima kwingi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.13",
            "verseOrgIds": [
              "1PE.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.20"
              },
              "items": [
                {
                  "text": "1 Pet 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.51"
              },
              "items": [
                {
                  "text": "Zab 89:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku muraabe nimujumwa ahabw'okuturwa eiziina rya Kristo, muhiiriirwe, ahabw'okuba Omwoyo ow'ekitiinisa kandi owa Ruhanga atuura ahariimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.14",
            "verseOrgIds": [
              "1PE.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka hatarigira omuntu omuriimwe owaabonabonesibwa ahabw'okwita, nari okwiba, nari okukora kubi, nari okweta omu by'abandi; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.15",
            "verseOrgIds": [
              "1PE.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.26"
              },
              "items": [
                {
                  "text": "Byak 11:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka omuntu ku araabonabonesibwe nk'omukristaayo, arekye kukwatwa enshoni, kureka ahimbise Ruhanga ahabw'eiziina eryo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.16",
            "verseOrgIds": [
              "1PE.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.6"
              },
              "items": [
                {
                  "text": "Ezk 9:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba obunaku buhikire orubanja okutandikira aha b'omu nju ya Ruhanga; mbwenu ku ruraabe nirubandiza ahariitwe, omuheru gw'abatoorobera ngiri ya Ruhanga guryaba guta? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.17",
            "verseOrgIds": [
              "1PE.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kqandi abahikiriire ku baraagumirwe okujunwa, abatatiina Ruhanga n'abasiisi baryaba bata? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo abarikubonabona nk'oku Ruhanga akunda, bagume nibakora gye, kandi bakwatse amagara gaabo Omuhangi orikwesigwa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.19",
            "verseOrgIds": [
              "1PE.4.19"
            ]
          }
        }
      ]
    }
  ],
