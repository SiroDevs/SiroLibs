              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi nikyo mwayeteirwe, ahakuba na Kristo akabonabonesibwa ahabwanyu, yaabatsigira eky'okureeberaho, ngu mutoore omuhanda ogu yaarabiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.21",
            "verseOrgIds": [
