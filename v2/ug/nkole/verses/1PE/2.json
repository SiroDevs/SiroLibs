            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku muraabe mwarorize aha mbabazi za Mukama waitu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.3",
            "verseOrgIds": [
              "1PE.2.3"
            ]
