                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abarikukundwa, nimbeeshengyereza nk'abagyenyi kandi abagyenzi, mwerinde okwetenga okubi okw'omubiri okutuura nikurwanisa amagara gaanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.11",
            "verseOrgIds": [
              "1PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
