            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " We tarakozire kibi; n'omu kanwa ke tihararugiremu bugobya. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
              "1PE.2.22"
            ]
          }
