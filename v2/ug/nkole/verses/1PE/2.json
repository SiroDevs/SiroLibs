            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imwe abahuuku, mworobere bakama baanyu nimubaha ekitiinisa kyona, ti barungi n'abarikutwaza gye bonka, kureka n'abanyamwaga nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.18",
            "verseOrgIds": [
              "1PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba omuntu asiimwe, yaagumisiririza obusaasi naaturwa busha, ahabw'okugira omutima murungi ahari Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.19",
            "verseOrgIds": [
              "1PE.2.19"
            ]
          }
        },
