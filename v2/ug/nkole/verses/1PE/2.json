          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaajumirwe, tiyaabagarurira; ku yaabonabonesiibwe, tiyaabahayira, kureka kaeehayo ahari Ogwo ocwa emanja z'amazima. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.23",
