            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.17"
              },
              "items": [
                {
                  "text": "Rom 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu niinyehanangiriza abakuru omuriimwe, nk'omukuru mugyenzi waanyu, kareebi w'okubonabona kwa Kristo, kandi okwataniise naimwe ekitiinisa ekirishuuruurwa; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.1",
            "verseOrgIds": [
              "1PE.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.28"
              },
              "items": [
                {
                  "text": "Byak 20:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muriise gye obusyo bwa Ruhanga, obu mwakwatsiibwe, mutaburiisa nk'abagyemirwe, kureka muburiise mweyendeire nk'oku Ruhanga arikukunda; ti habw'omururu mubi gw'okutunga ebintu, jureka mwine omutima ogurikukunda, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.2",
            "verseOrgIds": [
              "1PE.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.7"
              },
              "items": [
                {
                  "text": "Tit 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " murekye kutegyekyesa eikama obusyo obu mwakwatsiibwe, kureka mube eky'okureeberaho aharibwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.3",
            "verseOrgIds": [
              "1PE.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Omuriisa omukuru ku aryorekwa, muryaheebwa ekirunga ky'ekitiinisa ekitarikuhunduuka. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.4",
            "verseOrgIds": [
              "1PE.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.21"
              },
              "items": [
                {
                  "text": "Efe 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.4"
              },
              "items": [
                {
                  "text": "Yoh 13:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikwo naimwe abato mworobere abakuru. Mwena mwezirikye obucureezi, mubone kuheerezana; ahakuba Ruhanga arwanisa ab'amaryo, kwonka abacureezi abaha omugisha.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.5",
            "verseOrgIds": [
              "1PE.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
