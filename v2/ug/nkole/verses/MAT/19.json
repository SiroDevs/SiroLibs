              "MAT.19.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.31"
              },
              "items": [
                {
                  "text": "Mat 5:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abafarisaayo baija ah'ari, baamutega nibagira bati: Beitu Ebiragiro biikiriza omushaija kushenda omukazi we, yaaba aine eki arikumutura kyona? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.3",
            "verseOrgIds": [
              "MAT.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabagarukamu ati: Timukashomaga ngu, Owaabahangire bwa mbere na mbere, akahanga omushaija n'omukazi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.4",
            "verseOrgIds": [
              "MAT.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.31"
              },
              "items": [
                {
                  "text": "Efe 5:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagira ati: Omushaija nikyo atsigiraho ishe na nyina, akaguma n'omukazi we; nabo bombi bakahinduka omuntu omwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.5",
            "verseOrgIds": [
              "MAT.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.10"
              },
              "items": [
                {
                  "text": "1 Kor 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baba batakiri babiri kureka omwe. N'ahabw'ekyo eki Ruhanga yaateeraine hamwe, omuntu atarikitaanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.6",
            "verseOrgIds": [
              "MAT.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.1"
              },
              "items": [
                {
                  "text": "Bir 24:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baagaruka baamubuuza bati: Ku kiraabe kiri kityo, ahabw'enki Musa akaragiira omuntu kuha ebaruha y'okutaana, ngu abone kushenda omukazi we? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.7",
            "verseOrgIds": [
              "MAT.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabagarukamu ati: Ahabw'obugangaazi bw'emitima yaanyu Musa nikyo yaikiririize ku mutaana n'abakazi baanyu, kwonka bwa mbere na mbere kikaba kitari kityo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.8",
            "verseOrgIds": [
              "MAT.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.18"
              },
              "items": [
                {
                  "text": "Luk 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naanye nimbagambira nti: Omuntu weena orishenda omukazi we atamutuzire bushambani, akashwera ondiijo, aryaba ashambaine; kandi n'orishwera oshenzirwe nawe aryaba ashambaine.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.9",
            "verseOrgIds": [
              "MAT.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.9",
            "verseOrgIds": [
              "MAT.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeegi be baamugira bati: Eby'omushaija n'omukazi ku biraabe nikwo biri, ti kirungi kushwera. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.10",
            "verseOrgIds": [
              "MAT.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.7"
              },
              "items": [
                {
                  "text": "1 Kor 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaabagarukamu ati: Abantu abarikubaasa kwemera ekigambo ekyo ti boona, kureka abo abakihairwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.11",
            "verseOrgIds": [
              "MAT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimumanya ngu hariho abakonwa abaazairwe batyo okuruga omu nda za baanyinabo; hariho n'abakonwa abaakonirwe abantu; kandi hariho abakonwa abaayekonire ahabw'obukama bw'omu iguru. Orikubaasa kwemera ekyo, akyemere.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.12",
            "verseOrgIds": [
              "MAT.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
