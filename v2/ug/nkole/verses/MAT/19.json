                "loc": "MRK.10.1+MRK.10.2+MRK.10.3+MRK.10.4+MRK.10.5+MRK.10.6+MRK.10.7+MRK.10.8+MRK.10.9+MRK.10.10+MRK.10.11+MRK.10.12"
              },
              "items": [
                {
                  "text": "Mak 10:1-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu ku yaaherize kugamba ebyo byona, yaaruga Galilaaya, yaataaha omu ishaza rya Buyudaaya seeri ya Yorudani; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.1",
            "verseOrgIds": [
              "MAT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "emitwe y'abantu baingi yaamukuratira, yaabakirizayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.2",
            "verseOrgIds": [
              "MAT.19.2"
            ]
          }
        }
      ]
    },
    {
