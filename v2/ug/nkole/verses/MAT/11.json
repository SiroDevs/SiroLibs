              "items": [
                {
                  "text": "Fil 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebintu byona nkabiheebwa Tata, kandi tihariho omanya Omwana wa Ruhanga kureka Ishe, kandi tihariho omanya Ishe, kureka Omwana we n'omuntu weena ou Omwana aikiriza kumushuuruurira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.27",
            "verseOrgIds": [
