          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwekorere omugamba gwangye, muunyegyereho; ahabw'okuba nintwaza gye, kandi ndi omucureezi omu mutima; naimwe muryatunga okuhuumura omu mitima yaanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        },
