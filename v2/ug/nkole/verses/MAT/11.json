              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eego, Taata, ahabw'okuba ekyo nikyo waasiimire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.26",
            "verseOrgIds": [
              "MAT.11.26"
            ]
