                  "text": "Yoh 2:14-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu yaataaha omuri hekalu ya Ruhanga, yaagibingamu boona abaabaire nibatunda, n'abaabaire nibagura, yaajumika emeeza z'abarikuhingisa empiiha, n'ebitebe by'abaabaire nibatunda enkombe; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.7"
              },
              "items": [
                {
                  "text": "Isa 56:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.11"
              },
              "items": [
                {
                  "text": "Yer 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaabagira ati: Kikahandiikwa ngu, Enju yangye eryayetwa enju y'okushabiramu; mbwenu imwe mugihindwire nk'enyanga y'abambuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi empumi n'abarikucumbagira baija baamushanga omuri hekalu, yaabakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.14",
            "verseOrgIds": [
              "MAT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamurwa abakuru n'abahandiiki ku baareebire eby'okutangaaza ebi yaakozire, baahurira n'abaana nibeeshongorera omuri hekalu bati: Hosana aha Mwana wa Daudi, baaguubw akubi munonga; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.15",
            "verseOrgIds": [
              "MAT.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.8.2"
              },
              "items": [
                {
                  "text": "Zab 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " baamugira bati: Beitu ohuriire ebi aba barikugamba? Yesu yaabagarukamu ati: Eego! Imwe timukashomaga ngu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasheeshe ku yaabaire naagaruka omu rurembo, yaagira enjara. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.18",
            "verseOrgIds": [
              "MAT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.6"
              },
              "items": [
                {
                  "text": "Luk 13:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaareebire omutiini aha rubaju rw'omuhanda, yaaguhikaho, tiyaagushangaho kantu kureka omubengyeyo gw'amababi. Yaagugira ati: Otaryana ebyana ebiro byona. Ahonaaho omutiini gwayoma. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.19",
            "verseOrgIds": [
              "MAT.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeegi ku baakireebire, baatangaara nibagira bati: Omutiini gwarahuka guta kwoma? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.20",
            "verseOrgIds": [
              "MAT.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.20"
              },
              "items": [
                {
                  "text": "Mat 17:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu yaabagarukamu ati: Buzimazima nimbagambira nti: KU murigira okwikiriza, mutarikubanganisa, timurikora eki ekyakorwa aha mutiini ogwo kyonka; nangwa n'obu muriragiira orushozi oru muti, Tsinduka onagwe omu nyanja, nikwo kiriba kityo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.21",
            "verseOrgIds": [
              "MAT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Byona ebi muryenda omu kashaba kwanyu, mwabishaba mwine okwikiriza, muryabiheebwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        }
      ]
    },
    {
