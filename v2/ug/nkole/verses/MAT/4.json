        {
          "text": " Kandi Yesu, ku yaahuriire ngu Yohaana abohirwe, yaakuba yaagaruka Galilaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
