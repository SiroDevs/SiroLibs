            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaamugira ati: Ku oraabe ori Omwana wa Ruhanga, guruka oyetsimbe ahansi; ahakuba kikahandiikwa ngu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
          }
