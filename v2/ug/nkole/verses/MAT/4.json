              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho baatsigaho obwato na ishebo, baamukuratira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
