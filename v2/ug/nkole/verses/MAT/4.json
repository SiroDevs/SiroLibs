            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho baatsigaho obutimba bwabo, baamukuratira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.20",
            "verseOrgIds": [
              "MAT.4.20"
