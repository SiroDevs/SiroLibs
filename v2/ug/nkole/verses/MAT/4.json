              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Sitaane yaamurugaho; reeba baamaraika baija, baamuheereza.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.11",
            "verseOrgIds": [
              "MAT.4.11"
