            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaamazire ebiro makumi ana atarikurya nyomushana na nyekiro, yaagira enjara. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
