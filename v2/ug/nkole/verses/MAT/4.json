          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaruga Nazareesi, yaataaha Kaperenaumu ey'aha nyanja, yaaguma omu mashaza ga Zebuluuni na Nafutaali, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
