                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu yaamugarukamu ati: Rugaho, Sitaane, ahabw'okub akikahandiikwa ngu: Oramye Mukama Ruhanga waawe; obe niwe waaheereza wenka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.10",
            "verseOrgIds": [
              "MAT.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
