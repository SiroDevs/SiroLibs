              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaamuhitsya omu rurembo orurikwera, yaamuta aha itungu rya hekalu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.5",
            "verseOrgIds": [
              "MAT.4.5"
            ]
          }
