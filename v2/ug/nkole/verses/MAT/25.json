                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwana w'omuntu ku ariizira omu kitiinisa kye hamwe na baamaraika be boona, aryashutama aha kitebe kye eky'ekitiinisa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
