              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima aryagira ab'aha rubaju rwa bumosho ati: Mundugyeho, imwe abakyeenirwe, muze omu muriro ogutaraara, ogwateekateekyeirwe Sitaane na baamaraika be; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
