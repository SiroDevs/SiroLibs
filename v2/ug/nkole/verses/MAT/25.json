                "loc": "MAT.13.12"
              },
              "items": [
                {
                  "text": "Mat 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba oine niwe ariheebwa, akagira bingi; kwonka otaine aryayakwa n'eki aine. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'omwambari ogwo otaine mugasho, mumunagye aheeru omu mwirima; okwo niyo abantu bariririra, bakanena enshaya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
              "MAT.25.30"
            ]
          }
        }
      ]
