              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baataahire Kaperenaumu, abantu abarikushooza ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.24",
            "verseOrgIds": [
              "MAT.17.24"
