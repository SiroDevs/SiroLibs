                {
                  "text": "Byak 14:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka eirembo eririkutaasya omu magara rifunzire, n'akahanda kaaryo kagumire, n'abakazoora baba bakye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.14",
            "verseOrgIds": [
