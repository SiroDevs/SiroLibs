            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutaahire omu irembo erifunzire; ahakuba eirembo eririkutaasya omu kucwekyerera rigarami, n'omuhanda gwaryo guba muhango, kandi n'abagutooramu baba baingi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.13",
            "verseOrgIds": [
              "MAT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
