              "items": [
                {
                  "text": "Byak 20:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwerinde baanabi b'ebishuba ababaizira nibeeshushanisa nk'entaama, haza omunda bari emishega esheegire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.15",
            "verseOrgIds": [
              "MAT.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.19+GAL.5.20+GAL.5.21+GAL.5.22"
              },
              "items": [
                {
                  "text": "Gal 5:19-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muryabamanyira aha byana byabo. Hariho abaakushoroma emizaabibu aha munyinya, nari shi emitiini aha matojo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.16",
            "verseOrgIds": [
              "MAT.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'omuti gwona omurungi gwana ebyana birungi, kandi omuti omubi gwana ebyana bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.17",
            "verseOrgIds": [
              "MAT.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuti murungi tigubaasa kwana byana bibi, kandi omuti mubi tigubaasa kwana byana birungi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.18",
            "verseOrgIds": [
              "MAT.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
