              },
              "items": [
                {
                  "text": "Mat 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu kiryagasira ki omuntu kutunga ensi yoona, haza akafeerwa amagara ge? Nari shi, omuntu aryahayo ki kucungura amagara ge? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        },
