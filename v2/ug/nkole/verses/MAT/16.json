            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumanye ngu Omwana w'omuntu aryaija na baamaraika be omu kitiinisa kya Ishe; kandi obwo nibwo ariihura omuntu weena ebishemereire ebi yaakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
