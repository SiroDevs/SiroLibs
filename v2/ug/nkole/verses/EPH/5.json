    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo mukuratire Ruhanga nk'abaana abarikukundwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.1",
            "verseOrgIds": [
              "EPH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.18"
              },
              "items": [
                {
                  "text": "Kur 29:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi mugyendere omu kukunda nk'oku Kristo yaatukunzire, akeehayo ahabwaitu okuba empongano n'ekitambo ahari Ruhanga, omugaju ogurikutaamirana. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.2",
            "verseOrgIds": [
              "EPH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka obushambani n'ekihagaro kyona n'okwetenga kwona bitarigambwaho omuriimwe, mube nk'oku abarikwera bashemereire kuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.3",
            "verseOrgIds": [
              "EPH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.8"
              },
              "items": [
                {
                  "text": "Kol 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu kugamba kwanyu murekye kugamba ebirikwitsa enshoni n'eby'obushema n'eby'okushetsya ebitahikire; kureka musiima Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.4",
            "verseOrgIds": [
              "EPH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.9"
              },
              "items": [
                {
                  "text": "1 Kor 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka eki mukumanyire kimwe, ngu tihariho mushambani n'obu yaakuba okora ebihagaro n'obu yaakuba omwetengi, niwe oramya ebishushani, oriheebwa omugabo omu bukama bwa Kristo na Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.5",
            "verseOrgIds": [
              "EPH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatagira omuntu owaababeihabeihesa ebigambo ebitaine mugahso; ahabw'okuba ebibi ebyo nibyo bireeta ekiniga kya Ruhanga aha batarikuhurira. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.6",
            "verseOrgIds": [
              "EPH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo mutarikwatanisa nabo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.7",
            "verseOrgIds": [
              "EPH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.36"
              },
              "items": [
                {
                  "text": "Yoh 12:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba ira mukaba muri omwirima, kwonka hati muri omushana omuri Mukama; mugume mugyende nk'abaana b'omushana; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.8",
            "verseOrgIds": [
              "EPH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba ebyana by'omushana bireeberwa omu burungi bwona n'omu kuhikiirira n'omu mazima; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.9",
            "verseOrgIds": [
              "EPH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.2"
              },
              "items": [
                {
                  "text": "Rom 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi mwetegyereze ebirikusiimwa Mukama. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.10",
            "verseOrgIds": [
              "EPH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutarikwatanisa n'emirimo y'omwirima etarikwana; kureka mugihane. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.11",
            "verseOrgIds": [
              "EPH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.24"
              },
              "items": [
                {
                  "text": "Rom 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba ebi abo bakorera omu mubonano, nangwa n'okubigambaho kwonka, n'eky'enshoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.12",
            "verseOrgIds": [
              "EPH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.20"
              },
              "items": [
                {
                  "text": "Yoh 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka byona, ku byakirwa omushana, bireebwa; ahakuba kyona ekyakirwa omushana kikareebwa, kiba omushana; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.13",
            "verseOrgIds": [
              "EPH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikyo kirikugambirwa ngu:",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.14",
            "verseOrgIds": [
              "EPH.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 5:21"
          },
          "items": [
            {
              "text": "21",
