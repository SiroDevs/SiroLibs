              "items": [
                {
                  "text": "Yer 18:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka omuntu weena n'enyamaishwa yoona bihumbikwe ebiguniya, kandi abantu batakire munonga Ruhanga, buri muntu arekye omuhanda gwe omubi, n'obubisha oburi omu ngaro ze. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.8",
            "verseOrgIds": [
              "JON.3.8"
            ]
          }
        },
        {
