            "sid": "JON 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ekigambo kya MUKAMA kyagaruka kyaija ahari Yona obwa kabiri, nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.1",
            "verseOrgIds": [
              "JON.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imuka, oze Nineeve, orurembo orwo oruhango, orugambire obutumwa obu ndikukutuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.2",
            "verseOrgIds": [
              "JON.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Yona yaimuka, yaaza Nineeve, nk'oku MUKAMA yaamugambira. Kandi Nineeve rukaba ruri orurembo ruhango munonga, oru obuhango bwarwo burikugyenderwa ebiro bishatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.3",
            "verseOrgIds": [
              "JON.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona yaatandika kugyendagyenda omu rurembo, naagyenda orugyendo rw'eizooba rimwe; naagamba n'eiraka rihango ati: Hatsigaire ebiro makumi ana, Nineeve ecwekyerezibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.4",
            "verseOrgIds": [
              "JON.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.3"
              },
              "items": [
                {
                  "text": "2 Bus 20:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.41"
              },
              "items": [
                {
                  "text": "Mat 12:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu ba Nineeve baikiriza Ruhanga; baaranga okwesiibyakwo, baajwara ebiguniya, okuruga aha mukuru okuhika aha muto.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.5",
            "verseOrgIds": [
              "JON.3.5"
            ]
          }
        }
      ]
    },
