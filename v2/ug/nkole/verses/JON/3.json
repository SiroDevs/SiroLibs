              "items": [
                {
                  "text": "Yoel 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'oha orikumanya ngu, obundi Ruhanga takaayegarukamu, akareka ekiniga kye kingi, tukareka kuhwerekyerera?",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.9",
            "verseOrgIds": [
              "JON.3.9"
            ]
