            "number": "10",
            "style": "v",
            "sid": "JON 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga ku yaareebire eki baakora, n'oku baahinduka kureka emihanda yaabo emibi, yaayegarukamu, yaareka akabi aku yaagambire kubareetaho; tiyaakabareetaho.",
          "type": "text",
