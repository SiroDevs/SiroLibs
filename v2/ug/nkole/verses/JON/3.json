            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaaragiira kubuzya ekiragiro omuri Nineeve, ekirikugira kiti: Ahabw'ekiragiro ky'omugabe n'abakungu be, hatagira ekyatamira eky'okurya kyona, yaaba muntu, yaaba busyo bw'ente nari obw'emtaama, bitarya n'obu kwakuba okunywa; ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
