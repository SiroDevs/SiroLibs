            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima egyo nkuru yaahika aha mugabe wa Nineeve, yaimuka omu kitebe kye, yaajuura bushuuti ye, yaayehumbika ebiguniya, yaashutama omu iju. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.6",
            "verseOrgIds": [
              "JON.3.6"
            ]
          }
        },
