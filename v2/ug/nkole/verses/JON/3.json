              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.6"
              },
              "items": [
                {
                  "text": "Isa 59:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
