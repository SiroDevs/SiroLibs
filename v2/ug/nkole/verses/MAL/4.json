        },
        {
          "text": " Kwonka imwe abarikutiina eiziina ryangye, eizooba ry'okuhikiirira riryaturuka ahabwanyu, riine okutamba omu mapapa gaaryo. Muryashohora nimukina nk'enyana zirikuruga omu kihongore. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.4.2"
            ]
          }
        },
        {
          "name": "verse",
