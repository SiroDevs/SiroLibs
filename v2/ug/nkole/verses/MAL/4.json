            "number": "3",
            "style": "v",
            "sid": "MAL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha izooba eri ndikoreraho, muryaribatiirira ababi, babe eiju ahansi y'ebigyere byanyu; nikwo MUKAMA ow'amahe arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
          }
        }
