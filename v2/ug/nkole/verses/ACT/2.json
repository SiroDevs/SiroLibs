    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizooba rya Pentekoote obu ryahika, boona bakaba bateeraniire omu mwanya gumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.1",
            "verseOrgIds": [
              "ACT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.31"
              },
              "items": [
                {
                  "text": "Byak 4:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho okuhoorera kwaruga omu iguru, nk'omuyaga oku guhoorera n'amaani, kwaijuriza kimwe enju omu baabaire bashutami. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.2",
            "verseOrgIds": [
              "ACT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.11"
              },
              "items": [
                {
                  "text": "Mat 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Haareebeka endimi nk'ez'omuriro, zeebaganiisemu, nizaakira ahari buri omwe omuribo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.3",
            "verseOrgIds": [
              "ACT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.44+ACT.10.45+ACT.10.46"
              },
              "items": [
                {
                  "text": "Byak 10:44-46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Boona baijura Omwoyo Orikwera, baatandika kugamba endimi ezindi, nk'oku Omwoyo yaabahaire kuzigamba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebyo omuri Yerusaalemu hakaba harimu Abayudaaya, abashaija abanyadiini abaarugire omu mahanga goona agari ahansi y'eiguru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.5",
            "verseOrgIds": [
              "ACT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutwe muhango gw'abantu, ku baahuriire okuhoorera okwo, baateeranira hamwe bashobeirwe ahabw'okuba buri muntu akahurira entumwa nizigamba omu rurimi rw'owaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.6",
            "verseOrgIds": [
              "ACT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boona baatangaara nibagira bati: Beitu aba boona abarikugamba t'Abagalilaaya? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.7",
            "verseOrgIds": [
              "ACT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu kyaruga hi itwe twena okuhurira nibagamba endimi z'owaitu ei twazaariirwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.8",
            "verseOrgIds": [
              "ACT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza turi Abapaazi, Abameedi, Abelamiti n'abatuura Mesopotamia, omuri Buyudaaya, omuri Kapadokia, omuri Ponto, omuri Asia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.9",
            "verseOrgIds": [
              "ACT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuri Furugia na Pamfulia, omuri Misri n'omu mashaza ga Libya agahereraine na Kureene, n'abagyenyi abarugire Rooma, by'Abayudaaya n'abahindukire bakataaha omu diini yaabo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.10",
            "verseOrgIds": [
              "ACT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'Abakureete n'Abaharabu; nitubahurira nibagamba omu ndimi ziatu eby'amaani ebikozirwe Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.11",
            "verseOrgIds": [
              "ACT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boona baatangaara nibabanganisa, nibabuuzana bati: Eki n'enki? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.12",
            "verseOrgIds": [
              "ACT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka abandi baabashekyerera, nibagira bati: Basinzire viinyo y'omutahe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Petero yaayemerera hamwe na bari ikumi n'omwe, yaagamba n'eiraka rihango naabagira ati: Imwe bashaija ba Buyudaaya 'mwe n'abari Yerusaalemu mwena, mumanye eki, kandi mutegye amatu, muhurire ebigambo byangye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.14",
            "verseOrgIds": [
              "ACT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumanye ku aba batasinzire, nk'oku murikuteekateeka, ahakuba hati n'eshaaha ishatu za nyomushana; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.15",
            "verseOrgIds": [
              "ACT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.28+JOL.2.29+JOL.2.30+JOL.2.31+JOL.2.32"
              },
              "items": [
                {
                  "text": "Yoel 2:28-32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka eki nikyo kyaragwirwe nabi Yoeli ati:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.16",
            "verseOrgIds": [
              "ACT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.36",
            "verseOrgIds": [
              "ACT.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.37",
            "verseOrgIds": [
              "ACT.2.37"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.30"
              },
              "items": [
                {
                  "text": "Byak 16:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu abo ku baakihuriire, baacumitwa omu mitima, baabuuza Petero n'ezindi ntumwa bati: B'eishe-emwe, tugire tuta? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.37",
            "verseOrgIds": [
              "ACT.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero yaabagarukamu ati: Mweteise, mwena mubatizibwe omu iziina rya Yesu Kristo, mubone kusaasirwa ebibi byanyu; kandi nimwija kuheebwa ekiconco ky'Omwoyo Orikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.38",
            "verseOrgIds": [
              "ACT.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba okuraganisibwa oku n'okwanyu n'okw'abaana baanyu, n'okwa boona abari hare, omuntu weena oryetwa Mukama Ruhanga waitu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.39",
            "verseOrgIds": [
              "ACT.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.15"
              },
              "items": [
                {
                  "text": "Fil 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagaruka yaabamanyisa ebigambo ebindi bingi, naabeehanangiriza ati: Mujunwe, murugye omu bantu b'obusingye obu obutegami. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.40",
            "verseOrgIds": [
              "ACT.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.4"
              },
              "items": [
                {
                  "text": "Byak 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi abaikiriize ekigambo kye baabatizibwa; eryo izooba haayongyerwaho abantu nk'enkumi ishatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.41",
            "verseOrgIds": [
              "ACT.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaguma nibeezirikira okwegyesa kw'entumwa, n'okukwatanisa nazo omu kubega omugaati n'omu kushaba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.42",
            "verseOrgIds": [
              "ACT.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boona baagira obwoba; eby'okutangaaza n'obumanyiso bingi byakorwa entumwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.43",
            "verseOrgIds": [
              "ACT.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.32"
              },
              "items": [
                {
                  "text": "Byak 4:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi abaikiriize boona bakaguma hamwe, nibakwatanisa omu bintu byabo byona; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.44",
            "verseOrgIds": [
              "ACT.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibatunda amatungo gaabo n'ebintu byabo, nibabigabira boona nk'okukyena kw'omuntu oku kwabaire kuri. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.45",
            "verseOrgIds": [
              "ACT.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 2:46"
          },
          "items": [
            {
