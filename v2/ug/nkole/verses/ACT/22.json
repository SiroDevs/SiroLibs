          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bwaseesire, yaayenda kumanya amazima g'ekigambo eki Abayudaaya bamutabaaririize, yaamubohoorora, yaaragiira abanyamurwa abakuru n'ab'eishengyero boona kuteeranira hamwe, yaashuumya Paulo, yaamuta omu maisho gaabo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.30",
            "verseOrgIds": [
              "ACT.22.30"
            ]
          }
        }
      ]
