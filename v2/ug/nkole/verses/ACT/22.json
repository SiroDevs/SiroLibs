              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naagaruka Yerusaalemu; ku naabaire ndi omuri hekalu ninshaba, naashusha nk'orikuroota, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.17",
            "verseOrgIds": [
              "ACT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "naamureeba yangira ati: Otakyerererwa; rahuka orugye Yerusaalemu, ahabw'okuba tibarikwija kwikiriza okuhamya oku orikumpamya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.18",
            "verseOrgIds": [
              "ACT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanye naagira nti: Mukama wangye, bo bonka nibamanya ngu nkaba nkwata abarikukwikiriza, mbata omu bihome, kandi mbateerera omuri sinagogi zoona; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.19",
            "verseOrgIds": [
              "ACT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.58"
              },
              "items": [
                {
                  "text": "Byak 7:58",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.1"
              },
              "items": [
                {
                  "text": "8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi obu baajwisa eshagama ya Stefano kareebi waawe, nkaba nyemereireho nimbisiima, ndinzire n'ebijwaro byabo abaamwitsire. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.20",
            "verseOrgIds": [
              "ACT.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.15"
              },
              "items": [
                {
                  "text": "Byak 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yangambira ati: Irooko, ahakuba niinyija kukutuma hare omu Banyamahanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaguma bamuhurikiize okuhitsya obu yaagambire ekigambo ekyo; okuruga aho baayomba munonga nibagira bati: Mwihe omu nsi ekishaija ekyo; tikishemereire kugumaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.22",
            "verseOrgIds": [
              "ACT.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baabaire nibayomba munonga, nibatambika emyenda yaabo, kandi nibanaga n'omucuucu ahaiguru, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.23",
            "verseOrgIds": [
              "ACT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukuru w'engabo yaaragiira kumutaasya omu kigo, n'okumwasha nibamutatsya, ngu abone kwetegyereza eki baamuteererera enduuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.24",
            "verseOrgIds": [
              "ACT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
