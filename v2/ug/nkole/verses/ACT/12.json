          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.1",
            "verseOrgIds": [
              "ACT.12.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.3"
              },
              "items": [
                {
                  "text": "Byak 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro ebyo omugabe Heroode akakwata bamwe aha b'omu kanisa okubakora kubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.1",
            "verseOrgIds": [
              "ACT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo mukuru wa Yohaana yaamwitsa rurara. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.2",
            "verseOrgIds": [
              "ACT.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaareebire Abayudaaya baakisiima, yaagaruka yaakwata na Petero. (Ebiro ebyo bikaba biri eby'Emigaati etatumbisiibwe.) ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.3",
            "verseOrgIds": [
              "ACT.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaaherize kumukwata, yaamuta omu kihome, yaamutaho abaserukare ikumi na mukaaga kumurinda bana-bana, amaririire kumureeta omu maisho g'abantu bwanyima y'Okuhingurwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.4",
            "verseOrgIds": [
              "ACT.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.16"
              },
              "items": [
                {
                  "text": "Yak 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Petero nikwo yaarinzirwe atyo omu kihome. Kwonka ekanisa yaayezirika kumushabira ahari Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.5",
            "verseOrgIds": [
              "ACT.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.5",
            "verseOrgIds": [
              "ACT.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heroode ku yaabaire naayenda kumubareetera omu kasheeshe, ekiro ekyo Petero akaba agwejegyeire ari ahagati y'abaserukare babiri, n'abarinzi bari aha rwigi barinzire ekihome. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.6",
            "verseOrgIds": [
              "ACT.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.19"
              },
              "items": [
                {
                  "text": "Byak 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maraika wa Mukama yaamwemerera aha rubaju, omushana gwajwa omu kishengye; yaateerateera Petero omu mbaju, yaamusisiimura, yaagira ati: Rahuka kwimuka. Enjegyere zaamuruga aha mikono. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.7",
            "verseOrgIds": [
              "ACT.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maraika yaamugira ati: Yezirikye, ojware enkaito zaawe. Yaakora atyo. Kandi ati: Jwara omunagiro gwawe, onkurate. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.8",
            "verseOrgIds": [
              "ACT.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaashohora, yaamukuratira; kwonka tiyaamanya ekyakorwa maraika yaaba kiri eky'amazima, kureka yaateekateeka ngu n'okworekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.9",
            "verseOrgIds": [
              "ACT.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baahingwire aha barinzi b'okubanza n'aba kabiri, baahika aha rwigi rw'ekyoma, orurikuza omu irembo. Orwigi orwo rwabaigukira rwonka; baashohora, baahingura omu muhanda gumwe; ahonaaho maraika yaamutsigaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.10",
            "verseOrgIds": [
              "ACT.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero ku yaagarukirwe omutima omunda, yaagira ati: Mbwenu naamanyira kimwe ku Mukama yaatuma maraika we kunjuna omu mikono ya Heroode, n'okunkiza omuri byona ebi Abayudaaya baabaire baineho amatsiko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.11",
            "verseOrgIds": [
              "ACT.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.11",
            "verseOrgIds": [
              "ACT.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.12",
            "verseOrgIds": [
              "ACT.12.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.37"
              },
              "items": [
                {
                  "text": "Byak 15:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaabyetegyereize, yaaza owa Mariamu nyina wa Yohaana orikwetwa Mako; okwo niyo baabaire bateeraniire baingi nibashaba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.12",
            "verseOrgIds": [
              "ACT.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaakongootsire aha rwigi rw'eirembo, omwishiki orikwetwa Rooda yaija kwetaba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.13",
            "verseOrgIds": [
              "ACT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaamanyire eiraka rya petero, okushemererwa kwamuzibira kwiguraho orwigi, yaagaruka omu nju nairuka, yaabagira ati: Petero ayemereire aha irembo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.14",
            "verseOrgIds": [
              "ACT.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.37"
              },
              "items": [
                {
                  "text": "Luk 24:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baamugira bati: Ogwire eiraro. Omwihsiki yaahamiza kimwe ku nikwo kiri. Baagira bati: Ni maraika we. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.15",
            "verseOrgIds": [
              "ACT.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Petero yaagumizamu naakongoota; ku baigwireho, baamureeba, baatangaara munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.16",
            "verseOrgIds": [
              "ACT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabacureeza n'omukono, yaabateekyerereza oku Mukama yaamwiha omu kihome. Kandi yaagira ati: Mubigambire Yakobo n'ab'eishe-emwe. Atyo yaarugayo, yaaza ahandi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.17",
            "verseOrgIds": [
              "ACT.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bwaseesire, haabaho okujagarara kwingi omu baserukare ahabw'okushoberwa oku Petero abaire. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.18",
            "verseOrgIds": [
              "ACT.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heroode ku yaatumire kumweta, yaashanga abuzire, yaabuuza munonga abarinzi; atyo yaaragiira ku babaita. Bwanyima yaaruga Buyudaaya, yaaza Kaisarea, yaagumayo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.19",
            "verseOrgIds": [
              "ACT.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.19",
            "verseOrgIds": [
              "ACT.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heroose akaba agwereirwe kubi munonga aba Tuuro na Sidoni. Nabo baija ah'ari n'omutima gumwe; ku baaherize kunywana na Bulasto omukuru w'abambari b'omugabe, baashaba obusingye, ahakuba ensi yaabo ekaba neeshaka omu nsi y'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.20",
            "verseOrgIds": [
              "ACT.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro eki yaataireho, Heroode yaajwara ebijwaro by'obugabe, yaashutama aha kitebe kye, yaabagambira ebigambo bye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.21",
            "verseOrgIds": [
              "ACT.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Ezk 28:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu baagamba n'eiraka rihango bati: Eiraka eri n'erya ruhanga, ti ry'omuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.22",
            "verseOrgIds": [
              "ACT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.20"
              },
              "items": [
                {
                  "text": "Dan 5:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho maraika wa Mukama yaamuteera, ahakuba tarahaire Ruhanga kitiinisa; yaariibwa enyogori, yaafa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.23",
            "verseOrgIds": [
              "ACT.12.23"
            ]
          }
        }
      ]
    },
