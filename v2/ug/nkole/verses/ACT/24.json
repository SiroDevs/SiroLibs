          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi akaba aine amatsiko ngu Paulo aryamuha enguzi. Nikyo yaabaire amwetera kaingi kugaaniira nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.26",
            "verseOrgIds": [
              "ACT.24.26"
            ]
