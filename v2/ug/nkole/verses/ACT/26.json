          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.44+LUK.24.45+LUK.24.46+LUK.24.47"
              },
              "items": [
                {
                  "text": "Luk 24:44-47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ahabw'okuhwera kwa Ruhanga nkyemereire n'okuhitsya eri izooba, nimpamiza abato n'abakuru, ntaine kindi eki ndikugamba kureka ebi baanabi na Musa baaragwire ku biribaho; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.22",
            "verseOrgIds": [
              "ACT.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "bati: Kristo ashemereire kubonabonesibwa; kandi ahabw'okuba ow'okubanza kuzooka omu bafu, amanyise eihanga eri n'Abanyamahanga eby'omushana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
