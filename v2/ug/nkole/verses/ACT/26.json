                "loc": "ISA.42.7"
              },
              "items": [
                {
                  "text": "Isa 42:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.13"
              },
              "items": [
                {
                  "text": "Kol 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " okuhumuura amaisho gaabo, ngu bahindukye barugye omu mwirima, baze omu mushana, barugye omu bushoboorozi bwa Sitaane, bahindukire Ruhanga; babone kwihwaho ebibi, n'okuheebwa obuhunguzi hamwe n'abarikwezibwa ahabw'okuunyikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        }
      ]
    },
