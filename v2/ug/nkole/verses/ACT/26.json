              "attrs": {
                "loc": "GAL.1.16"
              },
              "items": [
                {
                  "text": "Gal 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo, Nyakusinga Aguripa, tindagomeire kworekwa okwo okw'omu iguru; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.19",
            "verseOrgIds": [
              "ACT.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "naatandikira aho kugambira aba Damasiko, bwanyima aba Yerusaalemu n'ab'omu ishaza ryona erya Buyudaaya, kandi n'Abanyamahanga, ngu beeteise, bahindukire Ruhanga, bakore ebishemereire okweteisa kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.20",
            "verseOrgIds": [
              "ACT.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo Abayudaaya bankwatiire ndi omuri hekalu, bakenda kuunyita. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
            "verseOrgIds": [
              "ACT.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 26:22"
          },
          "items": [
            {
