          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.11"
              },
              "items": [
                {
                  "text": "Byak 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro ebyo obumanyiso n'eby'okutangaaza bingi bikakorwa emikono y'entumwa omu bantu; kandi boona bakaba bateeranira omu kisasi kya Sulemaani n'omutima gumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.12",
            "verseOrgIds": [
              "ACT.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha bandi tihariho n'omwe owaayehangire kuteerana nabo; kwonka abantu boona bakaba babahimbisa munonga; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.13",
            "verseOrgIds": [
              "ACT.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abaikiriize baingi, abashaija n'abakazi, baayeyongyera munonga kukanya, nibeehongyera Mukama; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.14",
            "verseOrgIds": [
              "ACT.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.11"
              },
              "items": [
                {
                  "text": "Byak 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.56"
              },
              "items": [
                {
                  "text": "Mak 6:56",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'okutwara batwara abarwaire baabo, babarambika omu nguuto aha bitanda n'omu ngozi, ngu abamwe aharibo bakaahikwaho ekinyimanyimi kya Petero yaaba naahingura. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.15",
            "verseOrgIds": [
              "ACT.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abantu baaruga omuri tauni eziri haihi na Yerusaalemu, baateeranira aho, bareetsire abarwaire n'abariho baadaimoni; boona baatambirwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.16",
            "verseOrgIds": [
              "ACT.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.16",
            "verseOrgIds": [
              "ACT.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima omunyamurwa omukuru yaimuka n'abo abu yaabaire aine, ab'omu kicweka ky'Abasadukaayo, baijwire eihari; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.17",
            "verseOrgIds": [
              "ACT.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "baakwata entumwa, baazita omu kihome zoona. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.18",
            "verseOrgIds": [
              "ACT.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.7"
              },
              "items": [
                {
                  "text": "Byak 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka nyekiro, maraika wa Mukama yaigura enyigi z'ekihome, yaabashohoza aheeru, yaagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.19",
            "verseOrgIds": [
              "ACT.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugyende mwemerere omuri hekalu, mugambire abantu ebigambo byona eby'Amagara aga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.20",
            "verseOrgIds": [
              "ACT.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baakihuriire, baataaha omuri hekalu omu kasheeshe, baayegyesa. Ku baabaire bakiriyo, omunyamurwa omukuru yaija hamwe n'abo abu yaabaire aine, yaateerana eishengyero n'abakuru boona b'Abaisraeli, yaatuma omu kihome kubareeta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.21",
            "verseOrgIds": [
              "ACT.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru b'abaserukare ku baahikireyo, tibaabashangamu, baagaruka, baabamanyisa, bati: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.22",
            "verseOrgIds": [
              "ACT.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekihome twashanga kikingirwe gye buzima, n'abarinzi beemereire aha nyigi; kwonka ku twaiguraho, titwashangamu muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.23",
            "verseOrgIds": [
              "ACT.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omurinzi wa hekalu n'abanyamurwa abakuru ku baahuriire ebigambo ebyo, baashoberwa munonga, baayebuuza ahu biraagarukire. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.24",
            "verseOrgIds": [
              "ACT.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwanya ogwo haija omuntu yaabagambira ati: Reeba, abashaija abo abu mutaire omu kihome, beemereire omuri hekalu nibeegyesa abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.25",
            "verseOrgIds": [
              "ACT.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omurinzi ogwo hamwe n'abakuru b'abaserukare nikwo kugyenda bakabareeta, batarikubaita kubi, ahakuba bakaba nibatiina abantu ngu batabateera amabaare.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.26",
            "verseOrgIds": [
              "ACT.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.26",
            "verseOrgIds": [
              "ACT.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baabahikize aho, baabeemereza omu maisho g'eishengyero, omunyamurwa omukuru yaababuuza ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.27",
            "verseOrgIds": [
              "ACT.5.27"
            ]
          }
        },
        {
          "name": "verse",
