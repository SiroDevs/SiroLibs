              },
              "items": [
                {
                  "text": "Mat 27:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Titurabeehanangiririize kimwe kutagaruka kwegyesa omu iziina eryo? Mbwenu reeba mwijwize Yerusaalemu okwegyesa kwanyu. Nimwenda ngu eshagama y'ogwo mushaija etutukurire? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.28",
            "verseOrgIds": [
              "ACT.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.3.18"
              },
              "items": [
                {
                  "text": "Dan 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Petero n'ezindi ntumwa baagarukamu bati: Tushemereire kworobera Ruhanga okukira abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.29",
            "verseOrgIds": [
              "ACT.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga wa baatatenkuriitwe akazoora Yesu ou mwaitsire muhanikire aha muti. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.30",
            "verseOrgIds": [
              "ACT.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.2"
              },
              "items": [
                {
                  "text": "Heb 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo Ruhanga akamutembya, yaamuta aha rubaju rwe rwa buryo, ngu abe Omwebembezi mukuru kandi Omujuni, okuhaisa Abaisraeli okweteisa n'okusaasirwa ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.31",
            "verseOrgIds": [
              "ACT.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.26"
              },
              "items": [
                {
                  "text": "Yoh 15:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Itwe turi baakareebi b'ebyo hamwe n'Omwoyo Orikwera ou Ruhanga yaahaire abarikumworobera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.32",
            "verseOrgIds": [
              "ACT.5.32"
            ]
          }
        }
      ]
