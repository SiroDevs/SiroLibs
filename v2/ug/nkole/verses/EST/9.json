          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba ahari ebyo biro nibwo Abayudaaya baahuumura abazigu baabo, kandi okwo kwezi nikwo kwababeereire okw'okushemererwa omu mwanya gw'obusaasi, kukaba okw'okuhuumuriramu omu mwanya gw'okuganya; kandi yaabaragiira ku babigira ebiro by'okuriira hamwe n'okushemererwa, n'eby'okutwekyereraniraho eby'okurya, n'okuha abooro ebiconco.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        }
