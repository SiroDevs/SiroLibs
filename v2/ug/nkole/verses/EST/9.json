            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.10"
              },
              "items": [
                {
                  "text": "Neh 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo Abayudaaya ab'omu byaro, abatuura omuri tauni ezitaine ngo z'amabaare, baijukira ekiro kya ikumi na bina ky'okwezi Adari, bakakigira eizooba ry'okushemerererwaho n'okuriira hamwe, n'eizooba rirungi ry'okutwekyereraniraho eby'okurya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Morodekai yaahandiika ebyo byona, kandi yaahandiika n'ebaruha, yaazitwekyera Abayudaaya boona, abaabaire bari omu mashaza g'omugabe Ahasuero goona, aba haihi n'aba hare, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.20",
            "verseOrgIds": [
              "EST.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "naabeehangiriza kwijuka ekiro kya ikumi na bina n'ekya ikumi na bitaano eby'okwezi Adari, kubigira ebiro bikuru buri mwaka; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.21",
            "verseOrgIds": [
