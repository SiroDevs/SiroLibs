                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu busingye bwa Ahasuero, Ahasuero owaategyekire amashaza igana na makumi abiri na mushanju, okuruga Buhindi okuhika Esiopia, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.1"
              },
              "items": [
                {
                  "text": "Neh 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " omu biro by'ogwo mugabe Ahasuero, ku yaabaire ari aha ngoma omuri Shushani orurembo orukuru, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.40.20"
              },
              "items": [
                {
                  "text": "Kut 40:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.18"
              },
              "items": [
                {
                  "text": "Est 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.21"
              },
              "items": [
                {
                  "text": "Mak 6:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " omu mwaka gwe ogwa kashatu, akateeka obugyenyi, yaayeta abanyiginya be boona, abagaragwa be, abakuru b'amahe aba Buperisi na Bumeedi, abakungu hamwe n'abategyeki b'ago mashaza, baateeranira omu maisho ge, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaamara ebiro igana na makumi munaana naayoreka eitungo ry'obugabe bwe, n'ekitiinisa ky'obukuru bwe ekyabaire kihinguraine. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro ebyo ku byahweire, yaateekyera abantu boona obugyenyi, abakuru n'abato abaabaire bari omuri orwo rurembo rukuru Shushani, bwamara ebiro mushanju omu kibuga ky'aha musiri gw'omu kikaarai ky'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho hakaba hakingireho emikingo y'emyenda erikwera, n'eya bururu, ehanikirwe aha bugoye bwa bafuta n'obwa bujwa buhamiibwe empeta z'efeeza aha nyomyo z'amabaare agarikwetwa maburo; kandi aha mabaare agaariire agarikutukura, agarikwera, aga kinekye n'agarikwiragura, baataho ebitanda by'ezaabu n'eby'efeeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baabanywaisiza viinyo y'omugabe omu bintu by'ezaabu ebitarikushushana, yaatereka nyingi munonga, nk'obufura bw'omugabe oku bwabaire buri. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baanywa nk'oku ebiragiro byabaire biri, tihaabaho muntu owaagyemwa; ahabw'okuba omugabe akaba aragiire abatware b'ekikaari kye boona kuheereza omuntu weena, nk'oku arikwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'omwigarire Vasita yaateekyera abakazi obugyenyi omu kikaari ky'omugabe Ahusuero.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        }
      ]
    },
