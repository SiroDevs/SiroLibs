                "loc": "2KI.25.19"
              },
              "items": [
                {
                  "text": "2 Bag 25:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.14"
              },
              "items": [
                {
                  "text": "Ezr 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi abashaija abaabaire nibakurata omugabe omu kitiinisa, bakaba bari Karisheena, Shesaari, Adimaasa, Tarushiishi, Meresi, Mariseena na Memukaani, abanyiginya mushanju aba Buperisi na Bumeedi, abaabaire bari empika-mugabe, baine emyanya mikuru erikukira ey'abandi omu ihanga.) ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe yaababuuza ati: Omu biragiro, tugire tuta omwigarire Vasita, oyangire kukora eki omugabe amutumireho abakonwa? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memukaani yaagarukamu ari omu maisho g'omugabe n'abanyiginya ati: Omwigarire Vasita tacumwire ha mugabe wenka, kureka ashobize n'aha banyiginya boona n'amahanga goona agari omu mashaza g'omugabe Ahasuero goona. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabw'okuba eki, eki omwigarire akozire, nikiija kumanywa abakazi boona, kibareetere kugaya baibabo, ahkuba nibaija kugira bati: Omugabe Ahasuero ka yaatumire omwigarire Vasita kwija mu maisho ge, akanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi eri izooba abanyiginyakzi ba Buperisi na Bumeedi, abaahurira eki omwigarire akozire, nibaija kukigambira abanyiginya b'omugabe boona; ekiraarugyemu habeho okugayana kwingi n'okugirirana ekiniga. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
