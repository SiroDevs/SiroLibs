            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha izooba rya mushanju, omugabe Ahusuero ku yaagizire ebyera, yaaragiira Mahumaani, Bizisa, Harabona, Bigusa, na Abaguta, Zesaari na Karakaasi, abakonwa mushanju, abaabire bamuheereza, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.17"
              },
              "items": [
                {
                  "text": "Est 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureeta omwigarire Vasita omu maisho ge, ajwaire ekirunga ky'obugabe, kworeka abantu n'abanyiginya oburungi bwe; ahabw'okuba akba ari murungi w'okureebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omwigarire Vasita yaayanga kuhurira ekiragiro eki omugabe yaamutumireho abakonwa be ngu aije. Ekyo kyareetera omugabe ekiniga kingi, kyayenda kumubarura.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        }
      ]
    },
