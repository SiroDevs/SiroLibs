            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.1"
              },
              "items": [
                {
                  "text": "2 Bag 19:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Morodekai ku yaamanyire ebibaireho byona, yaataagura ebijwaro bye, yaajwara ebiguniya, yaayeshukyera eiju, yaashohora, yaaza omu rurembo ahagati, yaayamuza naataka n'eiraka rihango ry'obusaasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaaza aha irembo ry'omugabe, ahabw'okuba tihariho waabaire naikirizibwa kutaaha omu kikaari ajwaire ebiguniya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.2",
            "verseOrgIds": [
              "EST.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.4.16"
              },
              "items": [
                {
                  "text": "Est 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.9.31"
              },
              "items": [
                {
                  "text": "9:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.58.5"
              },
              "items": [
                {
                  "text": "Isa 58:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.3"
              },
              "items": [
                {
                  "text": "Dan 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omu mashaza goona, ei ekiragiro ky'omugabe kyabaire kihika, Abayudaaya bagira amaganya maingi, beesiibyakwo, barira nibaborooga, kandi abaingi omuribo babyama ahansi aha biguniya n'omu iju.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima abazaana ba'omwigarire Esteeri, n'abakonwa be, baija, baabimugambira; yaagira obusaasi bwingi; yaayoherereza Morodekai ebijwaro by'okujwara, ngu ajure ebiguniya; kwonak we yaabyanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.4",
            "verseOrgIds": [
              "EST.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Esteeri yaatuma kweta Hasaki, omwe aha bakonwa b'omugabe, ou omugabe yaabaire ataireho kumuheereza, yaamuragiira kuza ahari Morodekai kumubuuza ebibaireho n'ekibireetsire. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.5",
            "verseOrgIds": [
              "EST.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Hasaki yaagyenda, yaashanga Morodekai omu kibuga ky'orurembo, omu kangara-teete omu maisho g'eirembo ry'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.6",
            "verseOrgIds": [
              "EST.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.9"
              },
              "items": [
                {
                  "text": "Est 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Morodekai yaamuteekyerereza ebimubaireho byona, n'omubaro gw'empiiha zoona ezi Hamani araganiise kuta omu ibiikiro ry'omugabe, ahabw'okucwekyereza Abayudaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.14"
              },
              "items": [
                {
                  "text": "Est 3:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaamuha ebigambo ebihandiikirwe omu kiragiro ekibugiibwe omuri Shushani, eky'okubacwekyereza, ngu abyorekye Esteeri, abimushobororere, amwehanangirize kuza aha mugabe kumweshengyereza n'okumushaba kukiza eihanga rye. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.8",
            "verseOrgIds": [
              "EST.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasaki yaagaruka ahari Esteeri, yaamugambira obutumwa bwa Morodekai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.9",
            "verseOrgIds": [
              "EST.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Esteeri yaagaruka yaatuma Hasaki ahari Morodekai naamugira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.10",
            "verseOrgIds": [
              "EST.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.6.4"
              },
              "items": [
                {
                  "text": "Est 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaheereza b'omugabe boona, n'abantu b'omu mashaza ge nibamanya ngu omuntu weena, yaaba mushaija nari omukazi, orikuza ow'omugabe omu kikaari ky'omunda ateetsirewe, hariho ekiragiro kimwe aha muntu nk'ogwo, nikwo kwitwa, kureka ou omugabe yaimukiza enkoni ye ey'ezaabu, ngu arekye kufa. Kandi naanye hahingwire ebiro makumi ashatu nteetsirwe kushanga omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.11",
            "verseOrgIds": [
              "EST.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagambira Morodekai ebigambo bya Esteeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.12",
            "verseOrgIds": [
              "EST.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Morodekai yaabagambira kugarukamu Esteeri bati: Otateekateeka ngu noija kuhonoka aha bandi Bayudaaya boona, ngu ahabw'okuba ori omuri nyaruju y'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.13",
            "verseOrgIds": [
              "EST.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.45.7"
              },
              "items": [
                {
                  "text": "Kut 45:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.50.20"
              },
              "items": [
                {
                  "text": "50:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omanye ngu, ku oraahuname omu biro ebi, eky'okuhuumuriza n'okukiza Abayudaaya nikiija kureetwa ahandi, kwonak iwe n'enju ya sho muryacwekyerera. N'oha orikumanya ekyakutaire aha ngoma, ku kutari kuhwera omu bunaku bw'akabi nk'obu? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.14",
            "verseOrgIds": [
              "EST.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esteeri nawe yaabaragiira kugarukamu Morodekai ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.15",
            "verseOrgIds": [
              "EST.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gyenda oteeranire hamwe Abayudaaya boona abari omu rurembo Shushani, mwesiibyekwo ahabwangye, mumare ebiro bishatu nyomushana na nyekiro, mutarikurya n'obu kwakuba okunywa. Naanye n'abazaana bangye twaza kwesiibyakwo nkaimwe. Bwanyima y'ebyo niinyija kuza ow'omugabe, n'obu kirabe kitari ky'ebiragiro; ku ndaabe ningwayo, ngweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Morodekai yaayegyendera, yaakora ebi Esteeri yaamuragiira byona.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.17",
            "verseOrgIds": [
              "EST.4.17"
            ]
          }
        }
      ]
    }
  ],
