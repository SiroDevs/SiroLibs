          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oru nirwo ruzaaro rwa Pereezi; Pereezi akazaara Hezirooni, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.18",
            "verseOrgIds": [
              "RUT.4.18"
            ]
          }
        },
        {
          "name": "verse",
