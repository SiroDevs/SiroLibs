              "items": [
                {
                  "text": "Lev 25:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mbwenu nteekateekire kukikugambira, nti: Okigurire omu maisho g'aba abari aha n'omu maisho g'abakuru b'oruganda rwaitu. Ku oraabe nooyenda kukicungura, okucungure; nari ku oraabe otarikwenda, nabwo ongambire, nkimanye; ahabw'okuba tihariho ondiijo ow'okukicungura kureka iwe, naanye orikukukurata. Onu yaagira ati: Niinyija kukicungura. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.4",
            "verseOrgIds": [
              "RUT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
