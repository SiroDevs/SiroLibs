            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Boazi yaareeta abashaija ikumi aha bakuru b'orwo rurembo, yaabagira ati: Mushutame aha! Baashutama. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.2",
            "verseOrgIds": [
              "RUT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagambira ogwo ow'obuzaare bwa haihi ati: Naomi ogarukire naaruga omu nsi ya Moabu, naatunda ekibanja ekyabaire kiri ekya mwene waitu Elimeleki; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.3",
            "verseOrgIds": [
              "RUT.4.3"
            ]
          }
        },
        {
