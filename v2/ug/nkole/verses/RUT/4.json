                  "text": "Rom 12:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abakazi baagira Naomi bati: MUKAMA asiimwe ahabw'okutakureka otaine w'obuzaare bwa haihi; kandi eiziina rye rirangaanwe omuri Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.14",
