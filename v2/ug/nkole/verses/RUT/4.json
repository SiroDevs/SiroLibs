          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezirooni yaazaara Raamu; Raamu yaazaara Aminadabu; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.19",
            "verseOrgIds": [
              "RUT.4.19"
            ]
          }
        },
