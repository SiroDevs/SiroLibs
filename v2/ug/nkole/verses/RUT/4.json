          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aminadabu yaazaara Nahashooni; Nahashooni yaazaara Salumooni; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.20",
            "verseOrgIds": [
              "RUT.4.20"
            ]
          }
        },
