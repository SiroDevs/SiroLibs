              "attrs": {
                "loc": "GEN.35.16"
              },
              "items": [
                {
                  "text": "Kut 35:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu boona abaabaire bari omu irembo n'abakuru baagira bati: Turi baakareebi. Ogu mukazi owaaza omu nju yaawe MUKAMA amugire nka Rakeeli na Lea oku baakwataniise bombi kwimutsya enju ya Israeli; naiwe okore ebishemeire omuri Efuraata, kandi orangaanwe omuri Betelehemu, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.20"
              },
              "items": [
                {
                  "text": "Kut 38:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.4"
              },
              "items": [
                {
                  "text": "1 Bus 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi enju yaawe ebe nk'eya Pereezi, ou Tamari yaazaariire Yuda, ahabw'abaana abu MUKAMA arikuha omuri ogwo mukazi muto.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        }
