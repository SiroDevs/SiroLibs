              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Boazi yaatwara Ruusi, yaaba omukazi we; yaamuta aha mukono, MUKAMA yaamuha enda, yaazaara omwana w'omwojo. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.13",
            "verseOrgIds": [
              "RUT.4.13"
            ]
          }
        },
