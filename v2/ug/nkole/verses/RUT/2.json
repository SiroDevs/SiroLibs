                "loc": "RUT.3.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Naomi akaba aine omunyabuzaare ow'oruganda rwa iba, omushaija omutungi rugambwa, ow'omuryango gwa Elimeleki, eiziina rye Boazi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.1",
            "verseOrgIds": [
              "RUT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.22"
              },
              "items": [
                {
                  "text": "Lev 23:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruusi Omumoabukazi yaagira Naomi ati: Ka nze omu misiri, mpumbe engano ninkuratira orangirire embabazi. Yaamugira ati: Irooko, mwana wangye. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.2",
            "verseOrgIds": [
              "RUT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagyenda, yaahika omu misiri, yaahumba akuratiire abarikugyesha; yaahika aha kicweka ky'emisiri ekyabaire kiri ekya Boazi, ow'omuryango gwa Elimeleki, kwonka atakimanyire. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.3",
            "verseOrgIds": [
              "RUT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.129.7"
              },
              "items": [
                {
                  "text": "Zab 129:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.129.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.16"
              },
              "items": [
                {
                  "text": "2 Tes 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi reeba, Boazi yaija naaruga Betelehemu, yaaramutsya abagyesi ati: MUKAMA agume naimwe. Nabo baamugarukamu bati: MUKAMA akuhe omugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Boazi yaabuuza omunyampara w'abagyesi ati: Omwishiki ogu n'ow'oha? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.5",
            "verseOrgIds": [
              "RUT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyampara ogwo yaagarukamu ati: N'omwishiki w'Omumoabu owaagarukire na Naomi okuruga omu nsi ya Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.6",
            "verseOrgIds": [
              "RUT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaija, yangira ati: Ninkweshengyereza, nyikiriza mpumbe ninshanguruza nkuratiire abagyesi ahagati y'ebiba. Atyo yaija, yaiha omu kasheeshe naahumba n'okuhitsya hati, kureka akaanya kakye, aku yaahuumuraho omu nju.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.7",
            "verseOrgIds": [
              "RUT.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.7",
            "verseOrgIds": [
              "RUT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Boazi yaagira Ruusi ati: Hurira, mwana wangye! Otaza kuhumba omu gundi musiri, kandi otaruga omuri ogu, kureka ogume haihi n'abazaana bangye. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.8",
            "verseOrgIds": [
              "RUT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogume otaire amaisho aha musiri ogu barikugyesha, kandi obakuratire. Tiwaahurira ku naayehanangiriza abatsigazi, ngu hatagira owaakukoraho? Kandi ku oraagire eiriho, oze aha nyungu, onywe aha maizi agu abatsigazi baataha. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.9",
            "verseOrgIds": [
              "RUT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruusi yaajuumara ahansi, yaamugira ati: N'enki ekyakureetera kungirira embabazi n'okuunyetaho, haza ndi omunyaihanga? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.10",
            "verseOrgIds": [
              "RUT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.29"
              },
              "items": [
                {
                  "text": "Luk 18:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.24+HEB.11.25+HEB.11.26"
              },
              "items": [
                {
                  "text": "Heb 11:24-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Boazi yaamugarukamu ati: Banshobororeire gye byona ebi waakoreire nyokozaara okwiha obu baro yaafa, kandi n'oku waatsigireho sho na nyoko n'ensi yaanyu, okaija omu bantu abu waabaire otakamanyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.11",
            "verseOrgIds": [
              "RUT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.19.11"
              },
              "items": [
                {
                  "text": "Zab 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.36.7"
              },
              "items": [
                {
                  "text": "36:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.12"
              },
              "items": [
                {
                  "text": "Mat 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.1"
              },
              "items": [
                {
                  "text": "6:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.35"
              },
              "items": [
                {
                  "text": "Luk 6:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA akuzimuurire ahabw'ebi waakozire; MUKAMA Ruhanga wa Israeli; ou waahungiire omu mapapa ge, akuhe ebihembo byawe byona bitacwirweho. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.12",
            "verseOrgIds": [
              "RUT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.3"
              },
              "items": [
                {
                  "text": "Fil 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruusi yaagira ati: Mukama wangye, wangirira embabazi nyingi, ahabw'okuba wampuumuriza, kandi waagamba gye n'omuzaana waawe, n'obu ndaabe ntari nk'omwe aha bazaana baawe.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.13",
            "verseOrgIds": [
              "RUT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.13",
            "verseOrgIds": [
              "RUT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunaku bw'okurya ku bwahikire, Boazi yaamugira ati: Ija aha, orye eby'okurya, okoze ekitongye kyawe omuri viinyo. Ruusi yaashutama aha rubaju rw'abagyesi; baamuha sayiri ekarangire, yaarya, yaahaaga, yaagitsigaho. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.14",
            "verseOrgIds": [
              "RUT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku yaimukire kugaruka kuhumba, Boazi yaaragiira abatsigazi be ati: Mumurekye ahumbe n'omu biba, mutamujuma. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.15",
            "verseOrgIds": [
              "RUT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mumwihire ezindi omu biba, muzitsigye aho, azihumbe, mutamugambaho.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.16",
            "verseOrgIds": [
              "RUT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.16",
            "verseOrgIds": [
              "RUT.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo yaahumba omuri ogwo musiri okuhitsya omu mwabazyo; bwanyima yaahuura ebi yaahumba, haarugamu ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.17",
            "verseOrgIds": [
              "RUT.2.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:17",
              "type": "text"
            },
            {
              "text": "eefa neingana galloni munaana.",
              "type": "text"
            }
          ]
        },
        {
          "text": "eefa ya sayiri. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.17",
            "verseOrgIds": [
              "RUT.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagyekorera, yaaza omu rurembo, nyinazaara yaareeba ei yaahumba; Ruusi yaiha omu kikondooro ebi yaatsigaza yaaheza kurya, yaabimuha. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.18",
            "verseOrgIds": [
              "RUT.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyinazaara yaamubuuza ati: Waahumba hi eri izooba? Kandi waakora hi? Owaakwetaho aheebwe omugisha. Yaagambira nyinazaara mukama w'omusiri, ogu yaakoramu, yaamugira ati: Mukama w'omusiri ogu naakoramu eri izooba naayetwa Boazi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.3.10"
              },
              "items": [
                {
                  "text": "Rus 3:10",
                  "type": "text"
                }
              ]
            },
            {
