                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.1"
              },
              "items": [
                {
                  "text": "Kur 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.18.1"
              },
              "items": [
                {
                  "text": "18:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.29"
              },
              "items": [
                {
                  "text": "Kub 10:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obwo Heberi Omukeeni akaba ataine n'Abakeeni, nibo baijukuru ba Hobabu ishezaara wa Musa; kandi ateire eihema rye ahansi y'omwela oguri omuri Zaananimu, haihi na Kedeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.11",
            "verseOrgIds": [
              "JDG.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baagambiire Sisera ku Baraki mwene Abinoamu yainamuka omu kibungo Tabora, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.12",
            "verseOrgIds": [
              "JDG.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisera yaahuruza ebigaari bye byona, ebigaari by'ebyoma magana mwenda, n'engabo ze zoona ezaarugire Harosheesi ey'Abanyamahanga, yaabateeranira aha mugyera Kishoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.13",
            "verseOrgIds": [
              "JDG.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.3"
              },
              "items": [
                {
                  "text": "Bir 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.24"
              },
              "items": [
                {
                  "text": "2 Sam 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Debora yaagambira Baraki ati: Imuka, ahakuba eri niryo izooba eri MUKAMA yaaheerayo Sisera omu mikono yaawe. Noogira ngu MUKAMA takwebembeire? Atyo Baraki yaaruga aha kibungo Tabora, yaashuuma n'engabo ze kakumi zimukuratiire. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.14",
            "verseOrgIds": [
              "JDG.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.9"
              },
              "items": [
                {
                  "text": "Zab 83:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaaburanzya Sisera n'ebigaari bye byona n'engabo ze zoona na rurara, baahunga omu maisho ga Baraki; na Sisera yaasyoka omu kigaari kye, yairuka, yaahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.15",
            "verseOrgIds": [
              "JDG.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraki yaagyenda abingire ebyo bigaari n'ezo ngabo, okuhika Harosheesi ey'Abanyamahanga; engabo zoona eza Sisera zaahwera ahari rurara, tihaagira waahonokaho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.16",
            "verseOrgIds": [
              "JDG.4.16"
            ]
          }
        }
      ]
    },
