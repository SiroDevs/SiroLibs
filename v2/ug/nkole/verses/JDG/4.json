              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayeli yaashohora kubugana Sisera, yaamugira ati: Kiikama, mukama wangye, otaahe omwangye; otatiina. Yaataaha omu ihema rye, yaamushweka burangiti. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.18",
            "verseOrgIds": [
              "JDG.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
