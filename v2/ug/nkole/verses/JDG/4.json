            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Sisera yairuka, yaahunga, yaahika aha ihema rya Yayeli muka Heberi Omukeeni; ahabw'okuba Yabini omugabe wa Hazori n'ab'enju ya Heberi Omukeeni bakaba nibataahirana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.17",
            "verseOrgIds": [
