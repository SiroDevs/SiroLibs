            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yayeli muka Heberi yaihayo enkondo y'eihema n'enyondo, yaamwizira naashooba, yaamuteera egyo nkondo omu kanenero agwejegyeire munonga ahabw'okuruha, enkondo yaayogamu, yaahika omu itaka. Atyo Sisera yaafa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.21",
            "verseOrgIds": [
              "JDG.4.21"
            ]
          }
        },
        {
          "name": "verse",
