                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Onu yaamugira ati: Ninkweshengyereza mpa otwizi tw'okunywa, ahakuba nyine eiriho. Yayeli yaafunduura ecupa y'amate, yaamuha, yaanywa, yaagaruka yaamushweka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.19",
            "verseOrgIds": [
              "JDG.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
