              },
              "items": [
                {
                  "text": "1 Sam 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaataahire omu nju ye, yaihayo omusyo, yaakwata omutumbi gw'omukazi we, yaagutemaatemera omu ngingo, yaagucwamu ebicweka ikumi na bibiri, yaabyohereza omu mashaza goona aga Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.29",
            "verseOrgIds": [
              "JDG.19.29"
            ]
