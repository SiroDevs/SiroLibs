        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.27",
            "verseOrgIds": [
              "JDG.18.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
