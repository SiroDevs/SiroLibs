          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.33.22"
              },
              "items": [
                {
                  "text": "Bir 33:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.47"
              },
              "items": [
                {
                  "text": "Yos 19:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baatwara ebi Miika yaabaire akozire, n'omunyamurwa ou yaabaire aine, baaza Laishi, baahika omu bantu bari abatuurize, abataine ki beetaireho; baabaitsa rurara, baayotsya orurembo rwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.27",
            "verseOrgIds": [
              "JDG.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bantu baabura kijuna, ahabw'okuba orurembo rwabo rukaba ruri hare na Sidoni, kandi bakaba batarikukwatanisa n'abandi; kandi orurembo rwabo ruri omu ruhanga oruri haihi na Besirehobu. Bwanyima Abadaani baayombekayo orundi rurembo, baarutuuramu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.28",
            "verseOrgIds": [
              "JDG.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo rurembo baarweta Daani, nibarweterera ishenkurubo Daani, owaazairwe Israeli; kwonka eiziina ry'orwo rurembo ery'okubanza rikaba riri Laishi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.29",
            "verseOrgIds": [
              "JDG.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadaani baayeteeraho ekyo kishushani; kandi Yonasaani mwene Gereshoni, mutabani wa Musa, we n'abatabani baaguma bari abanyamurwa b'oruganda rwa Daani okuhitsya aha izooba eri ensi yaanyagiirweho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.30",
            "verseOrgIds": [
              "JDG.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo baataho ekyo kishushani kisharwire, eki Miika yaakozire, kyagumaho ebiro byona ebi enju ya Ruhanga yaamazire omuri Shiilo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.31",
            "verseOrgIds": [
              "JDG.18.31"
            ]
          }
        }
      ]
    }
