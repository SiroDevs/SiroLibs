                "loc": "ROM.16.4"
              },
              "items": [
                {
                  "text": "Rom 16:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaefuraimu baahuruzibwa kurwana, baayambuka, baahika Zafoni, baayetomboitera Yefusa, nibagira bati: Ahabw'enki oyambukire kurwanisa Abaamoni, otatwete kuhurura naiwe? Nitwija kukwokyeza omu nju. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.1",
            "verseOrgIds": [
              "JDG.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefusa yaabagarukamu ati: Nyowe n'abantu bangye tukaba twine empaka nyingi n'Abaamoni; kandi ku twabeetsire, timwabatujuna. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.2",
            "verseOrgIds": [
              "JDG.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku naareebire mutaatujuna, naayoga amagara, naayambuka kurwanisa Abaamoni, kandi MUKAMA yaabahayo omu mikono yangye. Mbwenu ahabw'enki mwaija eri izooba kundwanisa? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.3",
            "verseOrgIds": [
              "JDG.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.9"
              },
              "items": [
                {
                  "text": "Zab 78:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga aho Yefusa yaahuruza Abagileadi boona, yaabarwanisiza Efuraimu; Abagileadi baasingura Abaefuraimu; ahakuba bakabatsyorera bati: Imwe Abagileadi, muri Abaefuraimu abaacwire omu nsi ya Efuraimu n'eya Manaase. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.4",
            "verseOrgIds": [
              "JDG.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.28"
              },
              "items": [
                {
                  "text": "Bar 3:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abagileadi baakwata enyambukiro za Yorudani kutangaho Abaefuraimu ngu batambuka. Omuefuraimu weena ku yaabaire aba naahunga, yaahika aha nyambukiro, yaashaba kwambuka, Abagileadi bamubuuza bati: Ori Omuefuraimu? Ku yaabaire agira ati: Ngaaha, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.5",
            "verseOrgIds": [
              "JDG.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bamugira bati: Gira oti, Shiboleesi, nawe agira Siboleesi, ahabw'okutabaasa kukigamba gye, bamukwata, bamwitira ahari ezo nyambukiro za Yorudani. Omu bunaku obwo haafa Abaefuraimu obukumi buna n'enkumi ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.6",
            "verseOrgIds": [
              "JDG.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefusa yaamara emyaka mukaaga naacwera Abaisraeli emanja. Bwanyima Yefusa Omugileadi yaafa, yaaziikwa omu rurembo rumwe aha ndembo z'omuri Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.7",
            "verseOrgIds": [
              "JDG.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.7",
            "verseOrgIds": [
              "JDG.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ye Ibuzaani owa Betelehemu yaaba omuramuzi w'Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.8",
            "verseOrgIds": [
              "JDG.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaba aine abatabani makumi ashatu na bahara be makumi ashatu abu yaahingiire omu zindi nganda; kandi akashwerererayo abatabani abakazi makumi ashatu. Yaamara emyaka mushanju naacwera Abaisraeli emanja. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.9",
            "verseOrgIds": [
              "JDG.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Ibuzaani yaafa, yaaziikwa Betelehemu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.10",
            "verseOrgIds": [
              "JDG.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.10",
            "verseOrgIds": [
              "JDG.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ye haazaho Elooni Omuzebuluuni, yaaba omuramuzi w'Abaisraeli; yaamara emyaka ikumi naabacwera emanja. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.11",
            "verseOrgIds": [
              "JDG.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Elooni Omuzebuluuni yaafa, yaaziikwa Ayalooni omu ishaza rya Zebuluuni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.12",
            "verseOrgIds": [
              "JDG.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.12",
            "verseOrgIds": [
              "JDG.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ye haazaho Abudooni mwene Hileeli owa Piratooni, yaaba omuramuzi w'Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.13",
            "verseOrgIds": [
              "JDG.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaba aine abatabani makumi ana n'abaijukuru b'aboojo makumi ashatu; boona makumi mushanju bakaba bagyendera aha ndogoya nto makumi mushanju. Yaamara emyaka munaana naacwera Abaisraeli emanja. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.14",
            "verseOrgIds": [
              "JDG.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Abudooni mwene Hileeli owa Piratooni yaafa, yaaziikwa Piratooni omu ishaza rya Efuraimu omu nsi y'ebibungo ey'Abaamaleki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.15",
            "verseOrgIds": [
              "JDG.12.15"
            ]
          }
        }
      ]
    }
