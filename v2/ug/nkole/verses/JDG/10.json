                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.33"
              },
              "items": [
                {
                  "text": "1 Bag 11:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli baagaruka baakora ebirikwangwa MUKAMA, baaheereza Baabaali n'Ashitaroosi, na baaruhanga ba Siria, na Sidoni, na Moabu n'Abaamoni n'Abafilistia, baimuura MUKAMA, tibaamuheereza. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.6",
            "verseOrgIds": [
              "JDG.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagirira Israeli ekiniga kingi, yaabahayo omu mikono y'Abafilistia n'ey'Abaamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.7",
            "verseOrgIds": [
              "JDG.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka ogwo baaburabuza Abaisraeli, baabaita kubi; baamara emyaka ikumi na munaana nibaita kubi Abaisraeli boona abaabaire batwire seeri ya Yorudani omu nsi y'Abaamori ey'omuri Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.8",
            "verseOrgIds": [
              "JDG.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Abaamoni baayambuka Yorudani kurwanisa Abayuda n'Ababenyamiini n'ab'oruganda rwa Efuraimu; n'ahabw'ekyo Abaisraeli baatuntuzibwa munonga.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.9",
            "verseOrgIds": [
              "JDG.10.9"
            ]
          }
        }
      ]
    },
