                "loc": "NUM.21.29"
              },
              "items": [
                {
                  "text": "Kub 21:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.7"
              },
              "items": [
                {
                  "text": "Yer 48:7",
