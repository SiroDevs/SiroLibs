              "JDG.11.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.20"
              },
              "items": [
                {
                  "text": "Kur 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.6"
              },
              "items": [
                {
                  "text": "1 Sam 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yefusa yaatabaaruka, yaagaruka omu ka ye Mizipa; reeba, muhara we yaashohora kumubugana, naateera ebitaasa naazina; niwe yaabaire ari omwana we nyamunegyere; akaba ataine mwanda ondiijo weena, yaaba w'omwojo nari w'omwishiki, okwihaho ogwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.34",
            "verseOrgIds": [
              "JDG.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.36+GEN.42.37+GEN.42.38"
              },
              "items": [
                {
                  "text": "Kut 42:36-38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.18.33"
              },
              "items": [
                {
                  "text": "2 Sam 18:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.5.2+ECC.5.3+ECC.5.4+ECC.5.5"
              },
              "items": [
                {
                  "text": "Mub 5:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yefusa ku yaamureebire, yaataagura ebijwaro bye, yaagira ati: Ai bambe, mwana wangye! ka wangwisiza akagwe, okandeetera amaganya maingi; ahakuba nkaashamya akanwa kangye ahari MUKAMA; tinkibaasa kukireka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.35",
            "verseOrgIds": [
              "JDG.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.30.2"
              },
              "items": [
                {
                  "text": "Kub 30:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muhara we yaamugarukamu ati: Taata, ku oraabe waayashamize akanwa kaawe ahari MUKAMA, ongire nk'ekyarugire omu kanwa kaawe oku kiri, nk'oku MUKAMA akuhooreire Abaamoni abazigu baawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.36",
            "verseOrgIds": [
              "JDG.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaagira ishe ati: Ninkushaba onyikirize eki; ondekye ameezi abiri, nze omu bibungo, ngyendagyende na bagyenzi bangye, ncurire obuhangare bwangye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.37",
            "verseOrgIds": [
              "JDG.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamugira ati: Irooko. Yaamwohereza okumara ameezi abiri; yaagyenda na bagyenzi be, yaacurira obuhangare bwe omu bibungo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.38",
            "verseOrgIds": [
              "JDG.11.38"
            ]
          }
        },
        {
          "name": "verse",
