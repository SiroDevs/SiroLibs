                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.1+DEU.3.2+DEU.3.3+DEU.3.4+DEU.3.5+DEU.3.6+DEU.3.7+DEU.3.8+DEU.3.9+DEU.3.10+DEU.3.11+DEU.3.12+DEU.3.13+DEU.3.14+DEU.3.15+DEU.3.16+DEU.3.17"
              },
              "items": [
                {
                  "text": "3:1-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Israeli yaatuma entumwa ahari Sihooni omugabe w'Abaamori, omugabe wa Heshibooni, naamugira ati: Twakweshengyereza, reka turabe omu nsi yaawe, tuze owaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.19",
            "verseOrgIds": [
              "JDG.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Sihooni tiyaayesiga Baisraeli kurenga omwatano gwe, kureka yaateerana abantu be boona, yaateera orusiisira Yahazi, yaarwanisa Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.20",
            "verseOrgIds": [
              "JDG.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.24"
              },
              "items": [
                {
                  "text": "Kub 21:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.33"
              },
              "items": [
                {
                  "text": "Bir 2:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA Ruhanga wa Israeli yaahayo Sihooni n'abantu be boona omu mikono y'Abaisraeli, baabasingura. Batyo Abaisraeli baakubuura ensi yoona ey'Abaamori abaabaire batwiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.21",
            "verseOrgIds": [
              "JDG.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baakubuura ensi yoona ey'Abaamori okuruga Arunooni okuhika Yaboki, kandi okuruga aha ihamba n'okuhika Yorudani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.22",
            "verseOrgIds": [
              "JDG.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo MUKAMA Ruhanga w'Abaisraeli yaabinga Abaamori omu maisho g'abantu be Abaisraeli. Mbwenu niimwe mwakushemereire kugikubuura? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.23",
            "verseOrgIds": [
              "JDG.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
