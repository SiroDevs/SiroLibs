                "loc": "PSA.44.2"
              },
              "items": [
                {
                  "text": "Zab 44:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Torikubuura ensi ei Kemoshi ruhanga waawe arikuha? Naitwe abantu boona abu MUKAMA Ruhanga waitu yaabingire omu maisho gaitu, nibo turaakubuure ensi yaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.24",
            "verseOrgIds": [
              "JDG.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.2"
              },
              "items": [
                {
                  "text": "Kub 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.3"
              },
              "items": [
                {
                  "text": "Bir 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oine eki orikukiza Balaki mwene Zipori omugabe wa Moabu? Akaba arahakaniiseho Abaisraeli, nari akaba arabarwaniiseho? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.25",
            "verseOrgIds": [
              "JDG.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli ka baamazire emyaka magana ashatu, batwire omuri Heshibooni n'omuri tauni zaayo, n'omuri Aroeri na tauni zaayo, n'omu ndembo zoona eziri aha mbaju za Arunooni! Ahabw'enki omuri egyo myaka yoona ezo ndembo timurazigarukaine? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.26",
            "verseOrgIds": [
              "JDG.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.25"
              },
              "items": [
                {
                  "text": "Kut 18:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.9.15"
              },
              "items": [
                {
                  "text": "Yob 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo tiinye nkukozire kubi, kureka niiwe onkozire kubi kundwanisa. MUKAMA Omucwi w'emanja abe niwe yaaramura Abaisraeli n'Abaamoni eri izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.27",
            "verseOrgIds": [
              "JDG.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omugabe w'Abaamoni tiyaata mutima ha bigambo ebi Yefusa yaamutumireho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.28",
            "verseOrgIds": [
              "JDG.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.28",
            "verseOrgIds": [
              "JDG.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoyo wa MUKAMA yaija ahari Yefusa; Yefusa yaaraba omuri Gileadi na Manaase, yaahika Mizipa eya Gileadi; yaarugayo yaahika omu Baamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.29",
            "verseOrgIds": [
              "JDG.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.20"
              },
              "items": [
                {
                  "text": "Kut 28:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.1.11"
              },
              "items": [
                {
                  "text": "1 Sam 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yefusa yaahiga ahari MUKAMA naagira ati: Buzimazima ku oraaheyo Abaamoni omu mikono yangye, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.30",
            "verseOrgIds": [
              "JDG.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.2"
              },
              "items": [
                {
                  "text": "Lev 27:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.1.11"
              },
              "items": [
                {
                  "text": "1 Sam 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku nditabaaruka gye ninduga kurwanisa Abaamoni, ekiribanza kushohora omu muryango gw'enju yangye kumbugana, kiryaba ekya MUKAMA, kandi ndyakihonga, kibe ekitambo ky'okwotsya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.31",
            "verseOrgIds": [
              "JDG.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Yefusa yaayambuka aha Baamoni kubarwanisa; MUKAMA yaabahayo omu mikono ye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.32",
            "verseOrgIds": [
              "JDG.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabateera okuruga Aroeri okuhika Miniisi, yaabaitamu abantu baingi munonga, yaakwata endembo makumi abiri okuhika ahari Abeeli-keramimu. Okwo nikwo Abaamoni baasingwirwe Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.33",
            "verseOrgIds": [
              "JDG.11.33"
            ]
          }
        }
      ]
    },
    {
