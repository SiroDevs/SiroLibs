                "loc": "MAT.2.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.2.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi hakaba hariho omutsigazi owa Betelehemu-yuda, ow'omu ruganda rwa Yuda, Omuleevi, owaabaire ashuhuukiireyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.7",
            "verseOrgIds": [
              "JDG.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija ogwo yaaruga omu rurembo rwa Betelehemu-yuda, yaaza kusherura ah'okutuura. Ku yaabaire naakigyenda, yaahika aha nju ya Miika omu nsi y'ebibungo eya Efuraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.8",
            "verseOrgIds": [
              "JDG.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miika yaamubuuza ati: Nooruga hi? Onu ati: Ndi Omuleevi owa Betelehemu-yuda, ninza kusherura ah'okutuura. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.9",
            "verseOrgIds": [
              "JDG.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.19"
              },
              "items": [
                {
                  "text": "Bar 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Miika yaamugira ati: Tuura naanye, ombeere omuzaire kandi omunyamurwa; naanye ngume nkuhe ebicweka by'efeeza ikumi buri mwaka, nkujwekye kandi nkugaburire. Atyo ogwo Muleevi yaataahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.10",
            "verseOrgIds": [
              "JDG.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaasiima kuguma n'ogwo mushaija; ogwo mutsigazi yaamubeera nk'omwe aha batabani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.11",
            "verseOrgIds": [
              "JDG.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miika yaashoroora ogwo Muleevi, yaaba omunyamurwa we, yaaguma omu nju ye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.12",
            "verseOrgIds": [
              "JDG.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Miika yaagira ati: Mbwenu nimmanya ngu MUKAMA naija kumpa omugisha, obu ngizire Omuleevi omunyamurwa wangye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.13",
            "verseOrgIds": [
              "JDG.17.13"
            ]
          }
        }
      ]
