        },
        {
          "text": "Yeruba-baali mwene Yoashi yaagyenda, yaatuura omu nju ye ey'obutaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.29",
            "verseOrgIds": [
