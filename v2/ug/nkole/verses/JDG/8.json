            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gideoni akaba aine abaana b'aboojo makumi mushanju, abu yaayezaariire; ahabw'okuba akaba aine abakazi baingi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.30",
            "verseOrgIds": [
