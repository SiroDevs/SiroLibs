          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi akaba aine omukazi w'ekinyanshunju omuri Shekemu; nawe yaamuzaarira omwana w'omwojo, yaamweta Abimeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.31",
            "verseOrgIds": [
              "JDG.8.31"
            ]
          }
        },
