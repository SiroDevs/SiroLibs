                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gideoni yaabagarukamu ati: Tindibategyeka, na mutabani wangye taribategyeka; kureka MUKAMA niwe aribategyeka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.23",
