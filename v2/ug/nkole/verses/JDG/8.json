        },
        {
          "text": "Bwanyima Abaisraeli baagambira Gideoni bati: Otutegyekye, iwe na mutabani waawe, na mwijukuru waawe; ahabw'okuba otukirize Abamidiani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.22",
            "verseOrgIds": [
              "JDG.8.22"
            ]
          }
        },
