              "JDG.8.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.12"
              },
              "items": [
                {
                  "text": "Bar 7:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obwo Zeeba na Zalumuuna bakaba bari Karikoori n'engabo zaabo akakumi kamwe n'enkumi itaano, abaahonokire aha ngabo zoona ez'eihe ry'ab'oburugwa-izooba; ahabw'okuba hakafa abantu akasiriira kamwe n'obukumi bubiri, enkwata-rurara. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.10",
            "verseOrgIds": [
              "JDG.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.27"
              },
              "items": [
                {
                  "text": "Bar 18:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.3"
              },
              "items": [
                {
                  "text": "1 Tes 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gideoni yainamuka, yaatoora omuhanda ogurikuraba omu bantu abaabaire batuura omu mahema aha rubaju rw'oburugwa-izooba bwa Nooba na Yogibeha, yaasingura eryo ihe; ahakuba rikaba ryehugiireho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.11",
            "verseOrgIds": [
              "JDG.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.11"
              },
              "items": [
                {
                  "text": "Zab 83:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Zeeba na Zalumuuna abagabe bombi ba Midiani baahunga, yaababinga, yaabakwata, kandi engabo zaabo zoona yaazihahaaza emitima, zaataataana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.12",
            "verseOrgIds": [
              "JDG.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.12",
            "verseOrgIds": [
              "JDG.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Gideoni mwene Yoashi yaatabaaruka omu rugamba, yaaraba aharikwinamuka Heresi; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.13",
            "verseOrgIds": [
              "JDG.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaakwata omutsigazi wa Sukoosi, yaamubuuza abategyeki n'abakuru ba Sukoosi, onu yaamuhandiikira amaziina gaabo, abashaija makumi mushanju na mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.14",
            "verseOrgIds": [
              "JDG.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo yaija aha ba Sukoosi, yaagira ati: Mureebe Zeeba na Zalumuuna, abu munteerereireho enaku, nimugira muti, Zeeba na Zalumuuna waabakwatsire, tukabona kuha engabo zaawe ezirikugwa enshazi eby'okurya? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.15",
            "verseOrgIds": [
              "JDG.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaatwara abakuru b'orurembo, n'amahwa g'omu ihamba n'ag'emikwatangwe, yaageegyesesa aba Sukoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.16",
            "verseOrgIds": [
              "JDG.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaasheenya omunaara gwa Penueli, yaita abashaija b'omuri orwo rurembo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.17",
            "verseOrgIds": [
              "JDG.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.17",
            "verseOrgIds": [
              "JDG.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaabuuza Zeeba na Zalumuuna ati: Abashaija abu mwaitiire Tabora bakaba nibashusha ki? Baamugarukamu bati: Nk'oku orikushusha, nabo nikwo baabaire nibashusha. Buri omwe akaba naashusha omwana w'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.18",
            "verseOrgIds": [
              "JDG.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagira ati: Abo bakaba bari bakuru bangye, abaana ba maawe. Nindahira MUKAMA ahuriire, kuri noogira ngu mukabakiza, naanye tinkubaitsire. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.19",
            "verseOrgIds": [
              "JDG.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagambira Yeseri omujigaijo gwe, ati: Imuka, obaite. Kwonka omutsigazi ogwo tiyaihayo rurara ye; yaatiina, ahabw'okuba akaba akiri omutsigazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.20",
            "verseOrgIds": [
              "JDG.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Zeeba na Zalumuuna nikwo kumugira bati: Imuka, obe niiwe waatwita, ahakuba nk'oku omuntu arikwingana, n'amaani ge nikwo gaingana. Atyo Gideoni yaimuka, yaita Zeeba na Zalumuuna, yaajuura engamira zaabo ebirezi ebi zaabaire zijwaire omu bitsya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.21",
            "verseOrgIds": [
              "JDG.8.21"
            ]
          }
        }
      ]
    },
    {
