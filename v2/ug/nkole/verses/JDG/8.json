          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Gideoni mwene Yoashi yaafa yaahikire omu ngingo zaabukuru, yaaziikwa Ofura ey'aba Abiezeeri omu kituuro kya Yoashi ishe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.32",
            "verseOrgIds": [
              "JDG.8.32"
            ]
          }
