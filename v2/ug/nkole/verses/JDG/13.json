            "number": "19",
            "style": "v",
            "sid": "JDG 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa nikwo kureeta omwana gw'embuzi n'empongano y'esaano, akabihongyera MUKAMA aha rukiri; maraika akakora eby'okutangaaza, Manoa n'omukazi we nibamureeba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.19",
            "verseOrgIds": [
              "JDG.13.19"
            ]
          }
        },
        {
