              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maraika wa MUKAMA yaamugira ati: Nombuuriza ki eiziina? Ka n'ery'okutangaaza! ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.18",
            "verseOrgIds": [
              "JDG.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
