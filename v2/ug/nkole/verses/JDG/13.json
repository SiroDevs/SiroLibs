        },
        {
          "text": " Maraika wa MUKAMA yaayeyoreka ogwo mukazi, yaamugira ati: Reeba mbwenu ori engumba, torikuzaara; kwonka noija kugira enda, ozaare omwana w'omwojo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.3",
            "verseOrgIds": [
              "JDG.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.2+NUM.6.3+NUM.6.4+NUM.6.5"
              },
              "items": [
                {
                  "text": "Kub 6:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo oyerinde, otarinywa viinyo nari ekirikusinza, kandi otarirya ekintu kyona ekirikuzira; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.4",
            "verseOrgIds": [
              "JDG.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
