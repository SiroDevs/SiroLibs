              "items": [
                {
                  "text": "2 Sam 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba reeba, noija kugira enda, ozaare omwana w'omwojo; kandi orumweiso tirurimuraba ha mutwe; ahakuba ogwo mwana aryaba ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:5",
              "type": "text"
            },
            {
              "text": "Omunaziiri reeba Okubara 6.2 amakuru ngu, omuntu oshoroirwe kukorera Ruhanga omu muringo ogutari gw'obutoosha.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunaziiri ahari Ruhanga okuruga omu nda ya nyina; kandi niwe aritandika kujuna Abaisraeli omu mikono y'Abafilistia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.3"
              },
              "items": [
                {
                  "text": "Mat 28:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.29"
              },
              "items": [
                {
                  "text": "Luk 9:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ogwo mukazi yaija, yaagambira iba ati: Omushaija wa Ruhanga yaanyijaho, enshusha ye yaaba eri nk'eya maraika wa Ruhanga orikutiinisa munonga; tinaamubuuza i yaaba naaruga, kandi tiyangambira iziina rye; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.6",
            "verseOrgIds": [
              "JDG.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka yaangira ati: Reeba noija kugira enda, ozaare omwana w'omwojo; kandi ati: otarinywa viinyo nari ekirikusinza, n'obu kwakuba okurya ekintu kyona ekirikuzira; ahabw'okuba ogwo mwana aryaba Omunaziiri ahari Ruhanga okuruga omu nda ya nyina okuhitsya aha izooba eri arifeeraho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.7",
            "verseOrgIds": [
              "JDG.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
