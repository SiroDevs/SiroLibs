                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.18+JDG.6.19+JDG.6.20"
              },
              "items": [
                {
                  "text": "Bar 6:18-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Manoa yaagira maraika wa MUKAMA ati: Reka tukukyerereze tukubaagire omwana gw'embuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.15",
            "verseOrgIds": [
              "JDG.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maraika wa MUKAMA yaagira Manoa ati: N'obu orankyerereze, tindikwija kurya by'okurya byawe; kandi ku oraayende kugira ekitambo ky'okwotsya, oshemereire kukihongyera MUKAMA; ahakuba Manoa taramanyire ku yaabaire ari maraika wa MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa yaabuuza maraika wa MUKAMA ati: Eiziina ryawe ori oha, ebigambo byawe ku biriba byabaire kwo, tubone kukuha ekitiinisa? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
