              "items": [
                {
                  "text": "Bar 6:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwoyo wa MUKAMA yaamwijaho, yaaba omuramuzi w'Abaisraeli, yaarwana engamba, MUKAMA yaahayo Kushani-rishataimu omugabe wa Mesopotamia omu mikono ye, yaamusingura. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.10",
            "verseOrgIds": [
              "JDG.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga obwo ensi yaahuumura engamba okumara emyaka makumi ana. Bwanyima Otinyeli mwene Kenazi yaafa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.11",
            "verseOrgIds": [
              "JDG.3.11"
            ]
          }
        }
      ]
