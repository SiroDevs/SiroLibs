            "number": "21",
            "style": "v",
            "sid": "JDG 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehudi yaatayo omukono gwe gwa bumosho, yaasyorayo rurara aha kibero kye kya buryo, yaagimutimbura aha nda, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.21",
            "verseOrgIds": [
              "JDG.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ekirindi kyayo kyahwerayo; ebishanju byagishweka, ahakuba taragikwireyo; n'efa yaareetwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.22",
            "verseOrgIds": [
              "JDG.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Ehudi yaashohora; ku yaahikire omu kisasi, yaakinga enyigi z'ekyo kishengye ky'ahaiguru, yaazikingisa ekishumuruzo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
            "verseOrgIds": [
              "JDG.3.23"
            ]
          }
        }
      ]
    },
