          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo baita omu Bamoabu abantu nka kakumi, abashaija boona ab'amaani kandi amamanzi; tihaahonokaho n'omwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo Abamoabu baasingwirwe Abaisraeli ahari eryo izooba. Bwanyima ensi yaamara emyaka makumi munaana, ehumwire engamba.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
            "verseOrgIds": [
              "JDG.3.30"
            ]
          }
        }
