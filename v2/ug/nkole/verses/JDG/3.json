            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli bakakora ebirikwanga MUKAMA, baayebwa MUKAMA Ruhanga waabo, baaheereza Baabaali na Asheroosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.7",
            "verseOrgIds": [
              "JDG.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyareetera MUKAMA kugirira Abaisraeli ekiniga ekirikwaka nk'omuriro, yaabahayo omu mikono ya Kushani-rishataimu, omugabe wa Mesopotamia; baamuheereza okumara emyaka munaana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.8",
            "verseOrgIds": [
              "JDG.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.10"
              },
              "items": [
                {
                  "text": "1 Sam 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.27"
              },
              "items": [
                {
                  "text": "Neh 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Abaisraeli ku baatakiire MUKAMA, yaabateeraho ow'okubajuna, niwe Otinyeli mwene Kenazi, murumuna wa Kalebu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.9",
            "verseOrgIds": [
              "JDG.3.9"
            ]
          }
        },
        {
