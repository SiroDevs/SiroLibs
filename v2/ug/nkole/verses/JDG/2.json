              "items": [
                {
                  "text": "Yos 7:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo MUKAMA yaabagirira ekiniga kingi, yaabahayo omu mikono y'abanyagi, baabanyaga; yaabarekurira abazigu baabo ababeehinguririize; tibaagaruka kugira garwanisa abazigu baabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.14",
            "verseOrgIds": [
              "JDG.2.14"
            ]
          }
        },
