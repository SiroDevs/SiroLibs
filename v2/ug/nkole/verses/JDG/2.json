            }
          ]
        },
        {
          "text": " baimuura MUKAMA Ruhanga wa baishenkurubo, owaabaihire omu nsi ya Misri; baakuratira baaruhanga abandi b'abanyamahanga abaabaire babeehinguririize, baabaramya, baagwisa kubi MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.12",
            "verseOrgIds": [
              "JDG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baimuura MUKAMA, baaheereza Baabaali n'aba Ashitaroosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.13",
            "verseOrgIds": [
              "JDG.2.13"
            ]
          }
        },
