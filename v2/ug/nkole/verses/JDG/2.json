              "items": [
                {
                  "text": "Gal 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ab'obusingye obwo boona nabo baafa baakurata baishenkurubo, baakuratwa ab'obusingye obundi abaabaire batarikumanya MUKAMA n'ebi yaakoreire Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.10",
            "verseOrgIds": [
              "JDG.2.10"
            ]
          }
        }
