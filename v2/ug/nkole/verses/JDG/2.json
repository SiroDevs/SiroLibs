                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima maraika wa MUKAMA yaaruga Gilugaali, yaaza ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.1",
            "verseOrgIds": [
              "JDG.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:1",
              "type": "text"
            },
            {
              "text": "Bokimu amakuru ngu okurira.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokimu; yaagira ati: Nkabaiha Misri, naabareeta omu nsi ei naarahiire kuha baashwenkuriimwe, ningira nti: Tindiita ndagaano yangye ei naaragaine naimwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.1",
            "verseOrgIds": [
              "JDG.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi naimwe mutariragaana endagaano n'abatwire omu nsi egi; kureka muryasheenya amatambiro gaabo. Kwonka timuroorobeire kiragiro kyangye. N'enki ekyabareeteire kukora mutyo? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.2",
            "verseOrgIds": [
              "JDG.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.23.13"
              },
              "items": [
                {
                  "text": "Yos 23:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.6"
              },
              "items": [
                {
                  "text": "Bar 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.36"
              },
              "items": [
                {
                  "text": "Zab 106:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naanye nikyo ndikugirira nti, Tindibabinga mu maisho gaanyu; kureka baryaba nk'amahwa omu mbaju zaanyu, na baaruhanga baabo bababeere emitego. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.3",
            "verseOrgIds": [
              "JDG.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maraika wa MUKAMA ku yaagambiire Abaisraeli boona ebigambo ebyo, abantu baimutsya amaraka gaabo, baarira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.4",
            "verseOrgIds": [
              "JDG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwanya ogwo baagweta Bokimu; baatambirirayo MUKAMA ebitambo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua ku yaaherize kwohereza abantu, Abaisraeli baagyenda, buri muntu yaaza omu nsi y'obuhunguzi bwe kugikubuura. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.6",
            "verseOrgIds": [
              "JDG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baaheereza MUKAMA omu biro byona ebya Yoshua, kandi n'omu biro byona eby'abakuru abaatsigaireho yaafiire, abaareebire ebikuru ebi MUKAMA yaakoreire Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.7",
            "verseOrgIds": [
              "JDG.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Yoshua mutabani wa Nuuni, omugaragwa wa MUKAMA, yaafa, ahikize emyaka igana na ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.8",
            "verseOrgIds": [
              "JDG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamuziika omu kyanga ky'obuhunguzi bwe Timunaati-seera omu nsi y'ebibungo eya Efuraimu aha bukiizi-bwa-bumosho bw'ekibungo kya Gaashi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
            "verseOrgIds": [
              "JDG.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
