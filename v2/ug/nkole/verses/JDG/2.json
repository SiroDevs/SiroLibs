              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima MUKAMA yaimutsya abaramuzi abaatwire nibabajuna omu mikono y'abarikubanyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.16",
            "verseOrgIds": [
