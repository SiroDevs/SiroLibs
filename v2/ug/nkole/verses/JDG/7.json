                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.3.6"
              },
              "items": [
                {
                  "text": "Amo 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaabaganisa abo bashaija magana ashatu omu mitwe eshatu, boona yaabakwatsa enzamba n'enyungu zirimu busha, n'emuri omuri ezo nyungu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.16",
            "verseOrgIds": [
              "JDG.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabagira ati: Mundeebereho; oku ndaagire, mube nikwo mwagira. Ku ndaahikye ahu orusiisira rurikutandikira, mukore eki ndaakore. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.17",
            "verseOrgIds": [
              "JDG.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ndaateere enzamba, n'abandi boona abari hamwe naanye, naimwe muteerere enzamba aha mbaju zoona ez'orusiisira rwona, nimugira muti: Ahabwa MUKAMA n'ahabwa Gideoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.18",
            "verseOrgIds": [
              "JDG.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
