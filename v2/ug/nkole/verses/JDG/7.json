                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.9"
              },
              "items": [
                {
                  "text": "Efe 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Gideoni ati: Abantu abu oine bahinguraine obwingi; n'ahabw'ekyo tindikwija kuhayo Abamidiani omu mikono yaabo, Abaisraeli batakaanyehimbisaho nibagira bati: Emikono yaitu niyo etujunire. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.2",
            "verseOrgIds": [
              "JDG.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.8"
              },
              "items": [
                {
                  "text": "Bir 20:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu nu gyenda ogambire abantu oti: Orikutiina weena, kandi orikutetema, agarukye omuka. Haagarukayo abantu obukumi bubiri n'enkumi ibiri; haatsigara kakumi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.3",
            "verseOrgIds": [
              "JDG.7.3"
            ]
          }
        }
      ]
    },
