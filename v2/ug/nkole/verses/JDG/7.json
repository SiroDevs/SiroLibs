                {
                  "text": "1 Sam 14:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.2"
              },
              "items": [
                {
                  "text": "Isa 19:2",
