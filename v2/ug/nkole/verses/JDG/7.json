              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.14",
            "verseOrgIds": [
              "JDG.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni ku yaahuriire ekyo kirooto n'oku baakishoboorora, yaaramya Ruhanga, yaagaruka omu rusiisira rw'Abaisraeli, yaagira ati: Mwimukye, ahabw'okuba MUKAMA ahaireyo eihe rya Midiani omu mikono yaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.15",
            "verseOrgIds": [
              "JDG.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.9"
              },
              "items": [
                {
                  "text": "Kub 10:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.6.4"
              },
              "items": [
                {
                  "text": "Yos 6:4",
