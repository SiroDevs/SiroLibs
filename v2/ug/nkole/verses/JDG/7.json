            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Buri muntu yaayemerera omu mwanya gwe, beehinguriririize orusiisira; engabo zoona ez'Abamidiani zairuka niziyogoorekana, zaahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.21",
            "verseOrgIds": [
              "JDG.7.21"
