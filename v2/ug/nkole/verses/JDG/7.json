          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashaija ba Israeli baahurura nibaruga Nafutaali na Ashera na Manaase yoona, baakurata Abamidiani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.23",
            "verseOrgIds": [
              "JDG.7.23"
            ]
          }
        }
