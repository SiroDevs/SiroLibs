              "items": [
                {
                  "text": "2 Bus 20:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu abo magana ashatu baagumizamu nibateera enzamba, MUKAMA yaitanisa Abamidiani na rurara, buri muntu yaita mugyenzi we, eihe ryona ryaitana, ryahunga, ryahika Besi-shiita ehereraine na Zerera, baahika aha mwatano gwa Abeli-mehola haihi na Tabasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
