            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.6"
              },
              "items": [
                {
                  "text": "1 Sam 16:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
