          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Yeruba-baali niwe Gideoni, n'abantu boona abu yaabaire aine, baimuka kare omu kasheeshe, baasiisira aha rubaju rw'eiziba rya Harodi; kandi orusiisira rw'Abamidiani rukaba ruri aha bukiizi bwabo obwa-bumosho, omu ruhanga haihi n'ekibungo kya Moore. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.1",
            "verseOrgIds": [
              "JDG.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 7:2"
          },
          "items": [
