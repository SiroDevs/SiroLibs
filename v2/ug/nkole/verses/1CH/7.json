            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muhara we akaba naayetwa Sheera owaayombekire Besi-horoni zombi, eya ifo n'eya uguru, na Uzene-sheera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
            "verseOrgIds": [
              "1CH.7.24"
            ]
          }
        },
        {
