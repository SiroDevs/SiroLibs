            "sid": "1CH 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani we ni Reefa, mwene Reefa ni Reshefu, mwene Reshefu ni Teela, mwene Teela ni Tahani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
