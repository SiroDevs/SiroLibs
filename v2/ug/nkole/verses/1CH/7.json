            }
          ]
        },
        {
          "text": " Batabani ba Nafutaali: Yahazieli, Guuni, Yezeri na Shalumu, ab'oruzaaro rwa Biluha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
