              },
              "items": [
                {
                  "text": "Kub 26:29-33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batabani ba Manaase: Asirieli owaazairwe ekinyanshunju Omunyaaramu; kandi niwe yaazaire Makiri ishe wa Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
