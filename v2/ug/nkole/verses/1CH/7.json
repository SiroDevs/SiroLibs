                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batabani ba Toola: Uuzi, Refaaya, Yerieli, Yahumai, Ibusaamu na Shemueli, abakuru b'amaju ga baishenkurubo, nibo beene Toola, abaabaire bari abarwani b'amaani omu biro byabo; omu busingye bwa Daudi omubaro gwabo bakaba bari obukumi bubiri n'enkumi ibiri na magana mukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Uuzi: Izurahia. Batabani ba Izurahia: Mikaeli, Obadia, Yoeli na Ishia, boona bataano bakaba bari abantu bakuru; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi omuribo, nk'okukuratana kw'oruzaaro rw'amaju ga baishenkurubo oku kwabaire kuri, hakaba harimu emitwe y'engabo z'okuza aha rugamba obukumi bushantu n'enkumi mukaaga, ahabw'okuba bakaba baine abakazi baingi n'abaana b'aboojo baingi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.4",
            "verseOrgIds": [
              "1CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi beene waabo ab'omu miryango yoona y'Abaisakaari bakaba bari abarwani obukumi munaana n'enkumi mushanju, nk'oku baahandiikirwe omu kitabo ky'okuzaarwa kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.5",
            "verseOrgIds": [
              "1CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
