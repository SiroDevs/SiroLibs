              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batabani ba Benyamiini: Beela, Bekeri na Yedieli, bashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Beela: Ezibooni, Uuzi, Uzieli, Yerimoosi na Iiri, bataano, abakuru b'amaju ga baishenkurubo, kandi abarwani b'amaani; bakaba bari obukumi bubiri n'enkumi ibiri na makumi mukaaga na bana, nk'oku baahandiikirwe omu kukuratana kw'oruzaaro rwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.60"
              },
              "items": [
                {
                  "text": "1 Bus 6:60",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batabani ba Bekeri; Zemira, Yoasi, Eliezeeri, Elio-enai, Omuri, Yeremoosi, Abiya, Anatoosi na Alemeesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boona bakaba bari beene Bekeeri; omu kubarwa kw'okukuratana kw'oruzaaro rw'abakuru b'amaju ga baishenkurubo nk'oku kwabaire kuri, bakaba bari abarwani b'amaani obukumi bubiri na magana abiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.9",
            "verseOrgIds": [
              "1CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Yedieli: Biluhaani: Yeushi, Benyamiini, Ehudi, Kenaana, Zesaani, Tarushiishi na Ahishahaari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boona bakaba bari beene Yedieli; omu kubarwa kw'abakuru b'amaju ga baishenkurubo abashaija abarwani b'amaani baaba kakumi n'enkumi mushanju na magana abiri, abeeteekateekire kuza aha rugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.11",
            "verseOrgIds": [
              "1CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shupimu na Hupimu beene Iiri, Hushimu mwene Aheri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        }
      ]
    },
