            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.1"
              },
              "items": [
                {
                  "text": "1 Bus 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batyo baataasya enshanduukye ya Ruhanga, baagita omu ihema eri Daudi agiteereireho; baatamba ebitambo by'okwotsya n'empongano z'okusiima ahabw'obusingye omu maisho ga Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ku yaaherize kutamba ebyo bitambo by'okwotsya n'empngano z'okusiima ahabw'obusingye, yaashabira abantu omugisha omu iziina rya MUKAMA, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.2",
            "verseOrgIds": [
              "1CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaagaburira Abaisraeli boona, abashaija n'abakazi, buri muntu omugaati gumwe, entongo y'enyama kandi n'omwate gw'emizaabibu eyomire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaataho Abaleevi bamwe kukora omurimo gw'obuheereza omu maisho g'eshanduukye ya MUKAMA, okuguma nibaijutsya, okusiima n'okuhimbisa MUKAMA, Ruhanga wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.4",
            "verseOrgIds": [
              "1CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.39"
              },
              "items": [
                {
                  "text": "1 Bus 6:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omukuru waabo yaaba Asafu, yaakuratwa Zekaria, Yeyeli, Shemiramoosi, Yehieli, Matisiya, Eliabu, Benaaya, Obededomu na Yeyeli, abaatairweho kuteera enanga n'endingiri; Asafu we yaaba ow'okuteera ebitaasa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.5",
            "verseOrgIds": [
              "1CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaaya na Yahazieli abanyamurwa baaba ab'okuguma nibateerera amkondere omu maisho g'eshanduukye y'endagaano ya Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
