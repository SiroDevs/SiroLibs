          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima abantu boona baagira bati: Amiina; baahimbisa MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Daudi yaatsiga Asafu na beene ishe omu maisho g'eshanduukye y'endagaano ya MUKAMA kuguma nibakora omurimo gw'obuheereza omu maisho gaayo, nk'oku kyabaire nikyetengwa buri izooba; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
