          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Abishai mukuru wa Yoabu niwe yaabaire ari mukuru omu mamanzi makumi ashatu. Akakwata eicumu rye, yaarwana n'abashaija magana ashatu, yaabaita, yaarangaanwa nk'abo abashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.20",
            "verseOrgIds": [
              "1CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuri abo makumi ashatu niwe yaakizire kurangaanwa, akahinduka mukuru waabo; kwonka tiyaahika hari abo abashatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.21",
            "verseOrgIds": [
              "1CH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
