                  "text": "2 Sam 5:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.6+2SA.5.7+2SA.5.8+2SA.5.9+2SA.5.10"
              },
              "items": [
                {
                  "text": "6-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Abaisraeli boona baateeranira ahari Daudi omuri Heburooni, baamugira bati: Reeba turi eigufa ryawe kandi omubiri gwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.1",
            "verseOrgIds": [
              "1CH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebyahingwire, Saulo akiri omugabe, niiwe waabaire oyebembera Abaisraeli nibahurura kandi MUKAMA Ruhanga waawe akakugira ati: Niiwe oriba omuriisa w'abantu bangye Israeli, kandi niiwe oriba mugabe waabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.2",
            "verseOrgIds": [
              "1CH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.1"
              },
              "items": [
                {
                  "text": "1 Sam 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
