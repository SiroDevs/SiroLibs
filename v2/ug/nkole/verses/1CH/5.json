              "items": [
                {
                  "text": "Yos 13:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " na Beela, mwene Azazi mwijukuru wa Sheema mwene Yoeli owaabaire atwire Aroeri okuhika Neebo na Baali-meoni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.9"
              },
              "items": [
                {
                  "text": "Yos 22:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi akatuura aha bukiizi bw'oburugwa-izooba, ahu orikutaahira nooza omu ihamba seenu y'omugyera Furaati, ahakuba amatungo gaabo gakaba gakanyire omu nsi ya Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima omu busingye bwa Saulo baarwana n'aba Hagari, baabaita; batyo baatuura omu mahema gaabo omu byanga byona eby'aha burugwa-izooba bwa Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        }
