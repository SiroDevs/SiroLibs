                "loc": "1CH.27.29"
              },
              "items": [
                {
                  "text": "1 Bus 27:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " abo bakaba batwire Gileadi n'omuri Bashani n'omu ndembo zaayo, kandi n'omu mariisizo goona ag'omuri Sharooni okuhika ahu garikugarukira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.16",
            "verseOrgIds": [
              "1CH.5.16"
            ]
          }
        },
