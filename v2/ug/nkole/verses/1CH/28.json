              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.23"
              },
              "items": [
                {
                  "text": "1 Sam 17:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.13"
              },
              "items": [
                {
                  "text": "22:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku arigumizamu kworobera ebiragiro byangye n'ebi naataireho, nk'oku ari hati, ndyahamya obugabe bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.7",
            "verseOrgIds": [
              "1CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo hati omu maisho ga Israeli yoona, nigwo mutwe gw'abantu ba MUKAMA abateeraine, kandi omu maisho ga Ruhanga waitu orikutuhurira, mute omutima aha biragiro bya MUKAMA Ruhanga waanyu byona, mubiijukye, mubone kukubuura ensi egi enungi, nyentsya mugitsigire abaana baanyu abaribakurata, ebe obuhunguzi bwabo ebiro byona.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.8",
            "verseOrgIds": [
              "1CH.28.8"
            ]
          }
        }
      ]
