                  "text": "Hag 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo mbwenu oyerinda; ahabw'okuba MUKAMA akutooraine kwombekyera Obutaaho bwe enju: ba ow'amaani, ogikore.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.10",
