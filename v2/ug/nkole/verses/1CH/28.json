            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'obu kiraabe kyabaire kiri kityo, MUKAMA Ruhanga wa Israeli akantoorana omu ruganda rwa baatatenkuru rwona kuba omugabe wa Israeli ebiro byona; ahabw'okuba akatoorana Yuda kuba omwebembezi, omu ruganda rwa Yuda yaatoorana enju ya tata, kandi omuri beene tata yaaba niinye yaihamu, yanshemerererwa, yangira omugabe wa Israeli yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.4",
            "verseOrgIds": [
              "1CH.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 28:5"
