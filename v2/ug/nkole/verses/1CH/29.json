                "loc": "LUK.1.68"
              },
              "items": [
                {
                  "text": "Luk 1:68",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo Daudi yaasiimire MUKAMA omu maisho g'omutwe gwona ogw'abantu abaabaire bateeraine, naagira ati: MUKAMA, Ruhanga wa Israeli tatenkuriitwe, osiimwe ebiro n'ebiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.10",
            "verseOrgIds": [
              "1CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.17"
              },
              "items": [
                {
                  "text": "1 Tim 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.13"
              },
              "items": [
                {
                  "text": "Kush 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ai MUKAMA, obukuru, obushoboorozi, ekitiinisa, obusinguzi n'okutiinwa n'ebyawe; ahakuba ebiri omu iguru n'eby'omu nsi byona n'ebyawe; obukam n'obwawe, ai MUKAMA, kandi ohimbisibwa ahabw'okuba Omutwe gwa byona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.11",
            "verseOrgIds": [
              "1CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
