              "items": [
                {
                  "text": "Yos 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaakuza Sulemaani munonga omu maisho ga Israeli yoona, yaamuha ekitiinisa ky'obugabe ekitakabaga ha mugabe weena owaamubandiize omuri Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
