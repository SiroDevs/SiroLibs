              },
              "items": [
                {
                  "text": "28:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima abakuru b'amaju ga baishenkurubo, n'abeebembezi b'enganda za Israeli, n'abakuru b'engabo rukumi-rukumi, n'aba igana-igana, n'abategyeki b'emirimo y'omugabe, baahayo ebintu byabo n'omutima gwekundiire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.6",
            "verseOrgIds": [
              "1CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.2.69"
              },
              "items": [
                {
                  "text": "Ezr 2:69",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.7.70+NEH.7.71+NEH.7.72"
              },
              "items": [
                {
                  "text": "Neh 7:70-72",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baahayo etalanta z'ezaabu enkumi itaano na dariki kakumi, etalanta z'efeeza kakumi, ez'emiringa kakumi n'enkumi munaana, n'etalanta z'ebyoma akasiriira, ahabw'omurimo gw'enju ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.8"
              },
              "items": [
                {
                  "text": "1 Bus 23:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omuntu weena owaabaire aine amabaare g'obuguzi bwingi, yaagahayo, baagata omu ibikiro ry'enju ya MUKAMA kurindwa Yehieli owa Gereshoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.8",
            "verseOrgIds": [
              "1CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.4"
              },
              "items": [
                {
                  "text": "2 Bag 12:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.9.7"
              },
              "items": [
                {
                  "text": "2 Kor 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima abantu baashemererwa, ahabw'okuba abo bantu bakahayo n'omutima ogwekundiire; ahakuba bakahongyera MUKAMA n'omutima gwabo gwona batarikugyemwa; kandi n'omugabe Daudi yaashemererwa munonga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        }
      ]
