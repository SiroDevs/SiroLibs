          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeebembezi boona n'abashaija amamanzi, kandi na batabani b'omugabe Daudi boona baahiga omu maisho g'omugabe Sulemaani, ku barikwija kuba abashaija be. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
            "verseOrgIds": [
              "1CH.29.24"
            ]
          }
        },
