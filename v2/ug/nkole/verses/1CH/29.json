            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruhanga wangye, nimmanya ngu ocaaka emitima, kandi oshemerererwa amazima; naanye ahabwangye naahonga ebintu ebi byona n'omutima gw'amazima ntarikugyemwa; kandi hati naareeba abantu baawe abari aha nibakuhongyera n'okushemererwa kwingi batarikugyemwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.17",
            "verseOrgIds": [
              "1CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
