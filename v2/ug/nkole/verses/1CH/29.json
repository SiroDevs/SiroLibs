          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bwaseesire, baatambira MUKAMA ebitambo, kandi baamuhongyera empongano z'ebitambo by'okwotsya, enimi rukumi, empaya z'entaama rukumi, n'abaana b'entaama rukumi, hamwe n'empongano zaabyo z'eby'okunywa n'ebindi bitambo bingi munonga ahabwa Israeli yoona; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        },
