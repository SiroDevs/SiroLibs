              "items": [
                {
                  "text": "2 Bus 9:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Sulemaani yaaza aha kitebe ky'obugabe ekya MUKAMA, yaaba omugabe omu mwanya gwa Daudi ishe; yaaba gye, Abaisraeli boona baamutiina. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
