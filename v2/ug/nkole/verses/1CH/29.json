                "loc": "2CH.1.12"
              },
              "items": [
                {
                  "text": "2 Bus 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.6"
              },
              "items": [
                {
                  "text": "20:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.36"
              },
              "items": [
                {
                  "text": "Rom 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obutungi n'ekitiinisa niiwe bikomookaho, kandi otegyeka byona. Omu mukono gwawe harimu obushoboorozi n'amaani, kandi niiwe orikubaasa kukuza, n'okuha boona amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.12",
            "verseOrgIds": [
              "1CH.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenu hati, Ruhanga waitu, nitukusiima, kandi nitusingiza eiziina ryawe ery'ekitiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        }
      ]
    },
