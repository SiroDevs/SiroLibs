          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'Abaefuraimu, Hoshea mwene Azazia; ow'ekicweka ky'oruganda rwa Manaase, Yoeli mwene Pedaya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
