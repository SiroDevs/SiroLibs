          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abategyeki b'enganda za Israeli nibo aba; omukuru w'Abareubeeni akaba ari Eliezeeri mwene Zikuri; ow'Abasimeoni, Shefatia mwwene Maaka; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        },
        {
          "name": "verse",
