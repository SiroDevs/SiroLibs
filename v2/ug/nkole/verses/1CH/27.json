          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'engamira, Ebili owa Ishimaeli; ow'endogoya, Yehedeeya owa Meranoosi; kandi ow'obusyo bw'entaama, Yazizi owa Hagiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        },
