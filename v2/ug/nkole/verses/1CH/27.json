              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'Abazebuluuni, Ishimaaya, mwene Obadia; ow'Abanafutaali, Yeremoosi mwene Azurieli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
