              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ow'Abadaani, Azareeli mwene Yerohaamu. Abo nibo baabaire bari abakuru b'enganda za Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.22",
