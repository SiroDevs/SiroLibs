          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'emisiri y'emizaabibu Shimei owa Raama; ow'ebirikuruga omu mizaabibu eby'okubiikwa omu mabiikiro ga viinyo, Zabudi owa Shiifu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
