          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'amasyo agaabaire gagisiire Sharooni, Shiturai owa Sharooni; ow'amasyo agaabaire gagisiire omu mpita, Shafati mwene Adulai; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        },
