                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.30"
              },
              "items": [
                {
                  "text": "26:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ow'Abaleevi, Hashabia mwene Kemueli; ow'aba Arooni, Zadoki; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.17",
            "verseOrgIds": [
              "1CH.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'Abayuda, Elihu omwe ahari bakuru ba Daudi; ow'Abaisakaari, Omuri mwene Mikaeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
