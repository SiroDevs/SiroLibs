          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ow'ekicweka ky'oruganda rwa Manaase eky'omuri Gileadi, Ido mwene Zekaria; ow'Ababenyamiini, Yaasieli mwene Abuneeri; ",
          "type": "text",
          "attrs": {
