              "type": "text"
            }
          ]
        },
        {
          "text": " ow'emiti y'emizeituuni n'emisikamoori ey'omu ruhita, Baali-hanani owa Gederi; ow'amabiikiro g'amajuta, Yoashi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
