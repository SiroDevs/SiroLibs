                "loc": "2SA.5.5"
              },
              "items": [
                {
                  "text": "5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " abo mukaaga bakamuzaarirwa ari Heburooni, ahu yaategyekyeire emyaka mushanju n'ameezi mukaaga. Kandi yaamara endiijo myaka makumi ashatu n'eshatu, naategyekyera Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        },
        {
