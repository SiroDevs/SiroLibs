                {
                  "text": "2 Sam 3:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aba nibo batabani ba Daudi abaamuzaariirwe ari Heburooni: omujigaijo gwe akaba ari Amunoni, ou yaazaire ahari Ahinoamu owa Yezereeli; owa kabiri ni Danieli ou yaazaire ahari Abigaili owa Karumeeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa kashatu ni Abusalomu, owaazairwe Maaka, muhara wa Talumai omugabe wa Geshuri: owa kana ni Adoniya, owaazairwe Hagisi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa kataano Shefatia owaazairwe Abitaali, owa mukaaga Itereamu owaazairwe omukazi we Egula; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
