                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " baacwekyereza ekicweka ky'Abaameleki ekyabaire kihonokireho, baatuurayo okuruga obwo n'okuhitsya hati.",
          "type": "text",
