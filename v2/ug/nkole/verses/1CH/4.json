            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.8"
              },
              "items": [
                {
                  "text": "1 Sam 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.17"
