              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ishubi-benobu, mwijukuru w'ebikaaka biri, ou eicumu rye ryabaire riine oburemeezi bwa shekeli z'emiringa magana ashatu, ahagatiire rurara nsya, yaayenda kwita Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
