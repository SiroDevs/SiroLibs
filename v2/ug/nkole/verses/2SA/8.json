              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'ebyo Daudi yaasingura Abafilistia, yaabamara eishaija, yaiha Mesegama omu mikono yaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.1",
