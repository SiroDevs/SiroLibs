                "loc": "NUM.24.18"
              },
              "items": [
                {
                  "text": "Kub 24:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaata emitwe y'abarinzi omuri Edomu; yaababuzya Edomu yoona; Abanyaedomu boona baahinduka abahuuku be. MUKAMA yaaguma naaha Daudi obusinguzi ahu yaabaire aza goona.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        }
      ]
    },
    {
