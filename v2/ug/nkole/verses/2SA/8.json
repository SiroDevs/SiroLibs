              "2SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toi omugabe wa Hamasi ku yaahuriire ngu Daudi asingwire eihe ryaona erya Hadadezeeri, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaatuma Yoramu omutabani aha mugabe Daudi kumuramutsya n'okumutabaarutsya ahabw'okurwana na Hadadezeeri n'okumusingura; ahabw'okuba Hadadezeeri akaba atuura naarwana na Toi. Yoramu ogwo yaijana ebintu by'efeeza, eby'ezaabu n'eby'emiringa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.10",
            "verseOrgIds": [
              "2SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.51"
              },
              "items": [
                {
                  "text": "1 Bag 7:51",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.26"
              },
              "items": [
                {
                  "text": "1 Bus 26:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo nabyo omugabe Daudi yaabishoroorera MUKAMA hamwe n'efeeza n'ezaabu ebi yaabaire ashorore, abaihire omu mahanga goona agu yaabaire asingwire, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.30"
              },
              "items": [
                {
                  "text": "2 Sam 12:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ebya Siria, ebya Moabu, eby'Abaamoni, eby'Abafilistia, ebya Amaleki, n'eby'eminyago ya Hadadezeeri mwene Rehobu omugabe wa Zooba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaayetungira atyo eiziina.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
