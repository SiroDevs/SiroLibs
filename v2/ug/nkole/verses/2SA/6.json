          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        1 Bus 15:25—16:3",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.1"
              },
              "items": [
                {
                  "text": "1 Bag 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima baagambira omugabe Daudi bati: MUKAMA ahaire eka ya Obededamu omugisha n'ebi aine byona ahabw'eshanduukye ya Ruhanga. N'ahabw'ekyo Daudi yaagyenda, yaiha eshanduukye ya Ruhanga omu nju ya Obededamu, yaagiinamura omu rurembo rwa Daudi n'okushemererwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 6:13"
          },
          "items": [
