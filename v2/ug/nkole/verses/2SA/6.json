                "loc": "1CH.13.1+1CH.13.2+1CH.13.3+1CH.13.4+1CH.13.5+1CH.13.6+1CH.13.7+1CH.13.8+1CH.13.9+1CH.13.10+1CH.13.11+1CH.13.12+1CH.13.13+1CH.13.14"
              },
              "items": [
                {
                  "text": "1 Bus 13:1-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaagaruka yaateerana engabo zoona ezitoorainwe omuri Israeli, abantu obukumi bushatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.1",
            "verseOrgIds": [
              "2SA.6.1"
            ]
          }
        },
        {
