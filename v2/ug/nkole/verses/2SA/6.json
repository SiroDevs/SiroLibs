          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga aho Mikaali muhara wa Saulo tiyaagira bu azaara okuhitsya aha izooba eri yaafeereireho.",
          "type": "text",
          "attrs": {
