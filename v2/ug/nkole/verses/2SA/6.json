              "type": "tag",
              "attrs": {
                "loc": "PSA.132.8"
              },
              "items": [
                {
                  "text": "Zab 132:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baataasya eshanduukye ya MUKAMA, baagita omu mwanya gwayo omu ihema eri Daudi agiteereireho; Daudi yaatamba ebitambo by'okwotsya n'empongano z'okusiima ahabw'obusingye omu maisho ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku yaaherize kutamba ebyo bitambo by'okwotsya n'ezo mpongano z'okusiima ahabw'obusingye, yaashabira abantu omugisha omu iziina rya MUKAMA ow'amahe, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaagaburira abantu boona, ab'eihanga ryona erya Israeli, abashaija n'abakazi, buri muntu omugaati, entongo y'enyama n'omwate gw'emizaabibu eyomire. Okuruga aho abantu boona baarugayo, buri muntu yaataaha owe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.19",
            "verseOrgIds": [
              "2SA.6.19"
            ]
          }
        }
      ]
