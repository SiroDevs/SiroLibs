            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaagarukamu Mikaali ati: Ekyo naakikorera omu maisho ga MUKAMA owantooraine akanyeshumbya sho n'ab'omu ka ye boona, akangira omugabe w'abantu be Israeli; nikyo ndigumira niinyemurikira omu maisho ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
