          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi niinyija kwongyera kwehindura orikugaywa okukira aho, n'okwegarura ahansi omu maisho gaawe; kwonka abo bazaana abu waagambaho, bo baryampa ekitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.22",
            "verseOrgIds": [
              "2SA.6.22"
            ]
          }
        },
        {
