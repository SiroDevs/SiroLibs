            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.4",
            "verseOrgIds": [
              "2SA.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.5",
            "verseOrgIds": [
              "2SA.17.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.16+2SA.16.17+2SA.16.18"
              },
              "items": [
                {
                  "text": "2 Sam 16:16-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Abusalomu yaagira ati: Mwete Hushai mwene Aruki, nawe tuhurire eki arikugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.5",
            "verseOrgIds": [
              "2SA.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushai ku yaahikire ahari Abusalomu, Abusalomu yaamugira ati: Ahisofeeli yaatugambira ati n'ati; mbwenu tukore nk'oku yaagamba? Ku oraabe otarikukisiima, naiiwe otugambire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.6",
            "verseOrgIds": [
              "2SA.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushai yaagarukamu Abusalomu ati: Obwengye obu Ahisofeeli yaaha eri izooba ti burungi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.7",
            "verseOrgIds": [
              "2SA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaagaruka yaagira ati: noomanya sho n'engabo ze ku bari amamanzi; kandi hati bashaariire nk'edubu eyaayakwa ebyana byayo omu ihamba; kandi sho aba rugambwa omu kurwana, tarikwenda kuraara mu bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.8",
            "verseOrgIds": [
              "2SA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu ayesherekire omu kiina nari ahandi. N'ahabw'ekyo ku haraagire abaafa nibakitandika kurwana, oraakihurire weena naija kugira ati: Hafiire abantu baingi omu ba Abusalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.9",
            "verseOrgIds": [
              "2SA.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo nikyija kureetera omuntu weena kuhahaara, n'obu yaakuba ari emanzi aine omutima nk'ogw'entare, ahabw'okuba Abaisraeli boona nibamanya sho ku ari emanzi, kandi n'abu aine boona ku bari amamanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.10",
            "verseOrgIds": [
              "2SA.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.10"
              },
              "items": [
                {
                  "text": "2 Sam 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.17"
              },
              "items": [
                {
                  "text": "Kut 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kureka nyowe obwengye obu ndikukuha n'obu. Teeranira hamwe Abaisraeli boona, okutandikira Daani okuhika Beeri-sheba, bangane n'omusheenyi gw'aha rubaju rw'enyanja obwingi, kandi naiwe wenka ohurure nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.11",
            "verseOrgIds": [
              "2SA.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tutyo nitwija kumugwaho ahu turaamushangye hoona, tumutondeho nk'oku orume rutonda ahansi; we n'abantu abu aine boona, titurikwija kutsigaho n'omwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.12",
            "verseOrgIds": [
              "2SA.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku araahungire omu rurembo, nabwo Abaisraeli boona nibaija kureeta emirunga, turukumbagaze omu ruhanga, okuhitsya obu ruraahweho, hatatsigareho kabaare na kamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.13",
            "verseOrgIds": [
              "2SA.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.31"
              },
              "items": [
                {
                  "text": "2 Sam 15:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abusalomu n'Abaisraeli boona baagira bati: obwengye bwa Hushai mwene Aruki bwakira obwa Ahisofeeli. Ahabw'okuba MUKAMA akaba ataireho enaama y'okushiisha obwengye burungi bwa Ahisofeeli, ngu abone kureetera Abusalomu akabi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.14",
            "verseOrgIds": [
              "2SA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
