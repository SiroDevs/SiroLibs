              "2SA.17.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.35"
              },
              "items": [
                {
                  "text": "2 Sam 15:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Hushai yaagira Zadoki na Abiasaari abanyamurwa ati: Obwengye obu Ahisofeeli ahaire Abusalomu n'abakuru ba israeli n'obu; kwonka nyowe obu mmuhaire ni buti na buti. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.15",
            "verseOrgIds": [
              "2SA.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.28"
              },
              "items": [
                {
                  "text": "2 Sam 15:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo mutume juba ahari Daudi muti: Eki kiro otaraara aha nyambukiro y'eihamba; oyambukye, hatagira ekyakuzibira, omugabe atakaamirwa n'abantu abu aine boona. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.16",
            "verseOrgIds": [
              "2SA.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.27"
              },
              "items": [
                {
                  "text": "2 Sam 15:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Yonasaani na Ahimaazi bakaba bari Eni-rogeli bategyereize; omuzaana yaaguma naija naabibagambira, nabo nibaza kubigambira omugabe Daudi; ahakuba bakaba batarikwikirizibwa kutaaha omu rurembo nibareebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.17",
            "verseOrgIds": [
              "2SA.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka haagira omwojo owaabareeba, yaagambira Abusalomu. Abo batsigazi bombi baagyenda nibeehuta, baahika Bahurimu, baataaha omu nju y'omushaija owaabaire aine eiziba omu kibuga kye; baarizamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.18",
            "verseOrgIds": [
              "2SA.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.6"
              },
              "items": [
                {
                  "text": "Yos 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omukazi yaagira ekifundikizo, yaakita aha munwa gwaryo, yaakyanikaho omushekure gw'engano; tikyamanywa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.19",
            "verseOrgIds": [
              "2SA.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abambari ba Abusalomu baahika aha nju, baabuuza omukazi bati: Ahimaazi na Yonasaani barahi? Omukazi yaabagarukamu ati: Baayambuka akagyera. Ku baabasherwire, baabura, baagaruka Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.20",
            "verseOrgIds": [
              "2SA.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
