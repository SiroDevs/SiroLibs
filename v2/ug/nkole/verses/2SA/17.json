            "sid": "2SA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ahisofeeli yaagaruka yaagira Abusalomu ati: Ka ntoorane engabo kakumi n'enkumi ibiri, nyimukye, nkurate Daudi eki kiro; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.1",
            "verseOrgIds": [
              "2SA.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.14"
              },
              "items": [
                {
                  "text": "2 Sam 16:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " niinyija kumugwaho aruhire, atakiine maani, mmutiinise, abantu boona abu aine bahungye, nyite omugabe wenka; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.2",
            "verseOrgIds": [
              "2SA.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "haza abantu boona mbakugarurire. Manya eki orikwenda n'okwita omuntu omwe, reero abantu boona bakagira obusingye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.3",
            "verseOrgIds": [
              "2SA.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enaama egyo yaasiimwa Abusalomu n'abakuru ba Israeli boona.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.4",
            "verseOrgIds": [
              "2SA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
