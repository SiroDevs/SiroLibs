                "loc": "1SA.25.4"
              },
              "items": [
                {
                  "text": "1 Sam 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku haahingwireho emyaka ebiri eijwire, Abusalomu yaatwara abakyemuzi b'okumukyemurira ebyoya by'entaama ze Baali-hazori haihi na Efuraimu; Abusalomu yaayeta batabani b'omugabe boona. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.23",
            "verseOrgIds": [
              "2SA.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaija aha mugabe, yaamugira ati: Reeba, omwiru waawe aine abakyemuzi b'entaama; ninshaba omugabe n'abairu be, bagyende n'omwiru waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.24",
            "verseOrgIds": [
              "2SA.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omugabe yaagira Abusalomu ati: Ngaaha, mwana wangye, ka turekye kugyenda twena, tutakaakurusya. Abusalomu yaamugyemesereza kwonka onu yaayanga, yaamushabira omugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.25",
            "verseOrgIds": [
              "2SA.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Abusalomu yaamugira ati: Ku oraabe otarikwija, reka tugyende na Amunooni mukuru wangye. Omugabe yaamugira ati: Ahabw'enki ashemereire kugyenda naiwe? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.26",
            "verseOrgIds": [
              "2SA.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu yaamugyemesereza, okuhitsya obu yaikiriize Amunooni na batabani b'omugabe boona kugyenda nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.27",
            "verseOrgIds": [
              "2SA.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Abusalomu yaaragiira abaheereza be ati: Mugume mutaire eriisho ahari Amunooni; ku murareebe yaasinda viinyo, nkabagira nti: Muteere Amunooni, mumwite mutatiina. Tiinye naabaragiira? Mugume omutima, mube emanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.28",
            "verseOrgIds": [
              "2SA.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo abaheereza ba Abusalomu baagira Amunooni, nk'oku Abusalomu yaabaragiira. Ahonaaho batabani b'omugabe boona baimuka, buri omwe yaayenaga aha nyumbu ye, baahunga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.29",
            "verseOrgIds": [
              "2SA.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.29",
            "verseOrgIds": [
              "2SA.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baabaire bakirii omu muhanda, enkuru yaahika Daudi ngu Abusalomu aitsire batabani b'omugabe boona, tihaatsigaraho na wa kizira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.30",
            "verseOrgIds": [
              "2SA.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.1.11"
              },
              "items": [
                {
                  "text": "2 Sam 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.16"
              },
              "items": [
                {
                  "text": "12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe yaimuka, yaataagura ebijwaro bye, yaabyama ahansi; n'abagaragwa be boona abaabaire beemereireho nabo baataagura ebijwaro byabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.31",
            "verseOrgIds": [
              "2SA.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.3"
              },
              "items": [
                {
                  "text": "2 Sam 13:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Yonadabu, mwene Shimea mukuru w'omugabe, yaagira ati: Mukama wangye atagira ngu baitsire abatsigazi boona, batabani b'omugae; kureka ofiire ni Amunooni wenka, ahabw'okuba okwiha obu yaahamba munyaanya Tamari, Abusalomu akamariirira kukora ekyo, kandi niwe akiragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.32",
            "verseOrgIds": [
              "2SA.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo mukama wangye omugabe arekye kukitaho omutima, akagira ngu batabi b'omugabe boona bafiire; kureka Amunooni wenka niwe afiire.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.33",
            "verseOrgIds": [
              "2SA.13.33"
            ]
          }
        }
      ]
    },
