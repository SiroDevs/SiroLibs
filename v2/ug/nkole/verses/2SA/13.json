              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.33",
            "verseOrgIds": [
              "2SA.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga aho Abusalomu yaahunga. Bwanyima omutsigazi owaabaire naarinda, ku yaanagire amaisho, yaareeba abantu baingi nibareetwa omuhanda ogurikuruga Horonaimu aha rubaju rw'ekibungo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonadabu yaagira omugabe ati: Reeba, batabani b'omugabe baija, nk'oku omwiru waawe yaagira, nikwo byaba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.35",
            "verseOrgIds": [
              "2SA.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaabaire yaaheza ati kugamba, reeba batabani b'omugabe baija, baimutsya amaraka gaabo, baaborooga; omugabe nawe n'abagaragwa be boona baarira munonga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.36",
            "verseOrgIds": [
              "2SA.13.36"
            ]
          }
        }
      ]
    },
