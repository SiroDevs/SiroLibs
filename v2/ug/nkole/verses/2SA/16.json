              "2SA.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu n'Abaisraeli boona baahika Yerusaalemu hamwe na Ahisofeeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.15",
            "verseOrgIds": [
              "2SA.16.15"
            ]
          }
        },
