                  "text": "2 Sam 15:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ekindi, n'oha ou nshemereire kuheereza? T'omutabani? Nk'oku naabaire mpeereza sho, naiwe nikwo ndikuheereza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
            "verseOrgIds": [
              "2SA.16.19"
            ]
          }
