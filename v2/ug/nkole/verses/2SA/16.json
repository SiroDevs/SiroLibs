                  "text": "2 Bag 11:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Hushai mwene Aruki, munywani wa Daudi, yaija owa Abusalomu, yaamugira ati: Omugabe nakaramaare! Omugabe nakaramaare! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.16",
            "verseOrgIds": [
              "2SA.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu yaabuuza Hushai ati: Obwo nibwo bwesigwa obu oine ahari munywani waawe? Ekikuzibiire kugyenda nawe n'enki? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.17",
            "verseOrgIds": [
              "2SA.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushai yaagira Abusalomu ati: Ngaaha! kureka omuntu otoorainwe MUKAMA n'aba bantu n'Abaisraeli boona, niwe ndiba owe, kandi niwe ndiguma nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.18",
            "verseOrgIds": [
