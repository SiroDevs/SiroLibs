              "items": [
                {
                  "text": "1 Bus 27:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Owaabaire naamukurata omuri ago mamanzi ashatu ni Eleazaari mwene Dodo, mwijukuru wa Ahohi. Akaba ari hamwe na Daudi, obu baahiga Abafilistia abaabaire beeteeraniireyo kurwana, Abaisraeli bakabahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.9",
            "verseOrgIds": [
              "2SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaimuka, yaita Abafilistia okuhitsya obu omukono gwe gwaruhire, engaro ye ekaramatana na rurara; eryo izooba MUKAMA yaabaha okusingura kuhango, abandi baamugarukira ahabw'okucwijura abaitsirwe kwonka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
