                "loc": "1SA.30.17"
              },
              "items": [
                {
                  "text": "1 Sam 30:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'okufa kwa Saulo, Daudi akatabaaruka naaruga kwita Abaamaleki; ku yaahikire Zikulaagi, yaamarayo ebiro bibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.1",
            "verseOrgIds": [
              "2SA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.4.10"
              },
              "items": [
                {
                  "text": "2 Sam 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.12"
              },
              "items": [
                {
                  "text": "1 Sam 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha kiro kya kashatu haija omushaija naaruga omu rusiisira rwa Saulo, emyenda ye etaagukire, aine eitaka omu mutwe; ku yaahikire ahari Daudi, yaajuumara ahansi, yaamutangirira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.2",
            "verseOrgIds": [
              "2SA.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaamubuuza ati: Nooruga hi? Onu yaamugarukamu ati: Naacwa omu rusiisira rw'Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.3",
            "verseOrgIds": [
              "2SA.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaamubuuza ati: Bibaire bita? Ninkweshengyereza, ngambira. Onu yaamugarukamu ati: Abantu bahungire aha rugamba, baingi omuribo bagwire, baafa, kandi Saulo n'omutabani Yonasaani nabo bafiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.4",
            "verseOrgIds": [
              "2SA.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaabuuza ogwo mutsigazi owaamubikira ati: Beitu shi omanyisiibwe ki Saulo n'omutabani Yonasaani ku bafiire? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.5",
            "verseOrgIds": [
              "2SA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.10.1+1CH.10.2+1CH.10.3"
              },
              "items": [
                {
                  "text": "1 Bus 10:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo mutsigazi owaabaire naamubikira yaagira ati: Ku mbaire niinyegyendera, naahika aha kibungo Giliboa, naareeba Saulo ayegamiire eicumu rye; kandi naareeba ab'ebigaari n'ab'embaraasi bamubingire bamuhambize. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.6",
            "verseOrgIds": [
              "2SA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku agarwire amaisho enyima, yandeeba, yaanyeta, naanye naamwetaba nti: Ndi aha, Nyakusinga! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.7",
            "verseOrgIds": [
              "2SA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yambuuza ati: Ori oha? Naamugarukamu nti: Ndi Omuamaleki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.8",
            "verseOrgIds": [
              "2SA.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangira ati: Mpika haihi, onyite; ahakuba nyine obusaasi bwingi, kandi tinkakabire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.9",
            "verseOrgIds": [
              "2SA.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.9.54"
              },
              "items": [
                {
                  "text": "Bar 9:54",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ntyo naamuhika haihi, naamwita, ahakuba mmanyiire kimwe ku atari w'okukira yaagwire; bwanyima naamucwijura ekirunga ky'aha mutwe gwe n'engoro ebaire emuri aha mukono; mbwenu mbibi, mbikureeteire, mukama wangye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.10",
            "verseOrgIds": [
              "2SA.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.31"
              },
              "items": [
                {
                  "text": "2 Sam 3:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.31"
              },
              "items": [
                {
                  "text": "13:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaataagura emyenda ye, n'abashaija boona abu yaabaire aine baakora batyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.11",
            "verseOrgIds": [
              "2SA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baacura nibaborooga, baayesiibyakwo okuhitsya omu mwabazyo, ahabwa Saulo n'omutabani Yonasaani, n'ahabw'abantu ba MUKAMA n'enju ya Israeli okumarwa rurara.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaabuuza omutsigazi owaamubikira ati: Nooruga hi? Onu ati: Ndi omwana w'omunyaihanga, Omuamaleki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.24.6"
              },
              "items": [
                {
                  "text": "1 Sam 24:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi ati: Kirugire hi iwe okutatiina kubanga omukono kwita ou MUKAMA yaashukireho amajuta? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.14",
            "verseOrgIds": [
              "2SA.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.17"
              },
              "items": [
                {
                  "text": "1 Sam 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.4.10"
              },
              "items": [
                {
                  "text": "2 Sam 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaayeta omwe aha batsigazi, yaamugira ati: Irooko omuhikye haihi, omugurukire. Yaamucumita, yaafa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.15",
            "verseOrgIds": [
              "2SA.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaamugira ati: Orubanja rw'eshagama yaawe rube niiwe rwabaho, ahabw'okuba akanwa kaawe niko mushinja ku waahamya noogira oti: Nyitsire ou MUKAMA yaashukireho amajuta.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.16",
            "verseOrgIds": [
              "2SA.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.16",
            "verseOrgIds": [
              "2SA.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Daudi yaacurira Saulo n'omutabani Yonasaani n'ekyoshongoro eki, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.17",
            "verseOrgIds": [
              "2SA.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.13"
              },
              "items": [
                {
                  "text": "Yos 10:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (kandi yaaragiira kukyegyesa Abayuda; reeba kihandiikirwe omu kitabo kya Yashari.) naagira ati:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.18",
            "verseOrgIds": [
              "2SA.1.18"
            ]
          }
        }
      ]
    }
