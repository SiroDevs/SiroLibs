            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.28.4"
              },
              "items": [
                {
                  "text": "Zab 28:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi nyowe, n'obu ndaabe ndi omugabe oshukirweho amajuta, kwonka ndi busha; n'abashaija aba, batabani ba Zeruiya, bagumire, tindikubabaasa. MUKAMA azimuurire enkozi y'ebibi nk'obubi bwayo oku buri.",
          "type": "text",
