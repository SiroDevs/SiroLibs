            }
          ]
        },
        {
          "text": "Bwanyima haabaho obweme buhango ahagati y'enju ya Saulo n'eya Daudi; kwonka Daudi yaaguma naayeyongyera amaani, enju ya Daulo yo yaagyenda neehwa amaani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
