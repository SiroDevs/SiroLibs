                "loc": "2SA.13.37"
              },
              "items": [
                {
                  "text": "2 Sam 13:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " owa kabiri Kileaba owa Abigaili, owaabaire ari muka Nabali owa Karumeeli; owa kashatu Abusalomu ou yaazaire ahari Maaka omuhara wa Talumai, omugabe wa Geshuri; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        },
        {
