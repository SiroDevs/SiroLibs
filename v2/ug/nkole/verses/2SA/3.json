            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Daudi yaazaarira Heburooni abaana b'aboojo; ow'omujigaijo akaba ari Amunooni, ou yaazaire ahari Ahinoamu owa Yezereeli; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.2",
            "verseOrgIds": [
              "2SA.3.2"
            ]
          }
        },
        {
