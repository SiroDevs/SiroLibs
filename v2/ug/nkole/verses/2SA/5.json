                "loc": "2SA.19.12"
              },
              "items": [
                {
                  "text": "2 Sam 19:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima enganda zoona eza Israeli zaashanga Daudi Heburooni; zaamugira ziti: Reeba, turi abaanyu ab'aha mara. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.1",
            "verseOrgIds": [
              "2SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.13"
              },
              "items": [
                {
                  "text": "1 Sam 18:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.71"
              },
              "items": [
                {
                  "text": "Zab 78:71",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro ebyahingwire, obu Saulo yaabaire ari omugabe waitu, niiwe waabaire oyebembera Abaisraeli nibahurura kandi nibatabaaruka; kandi MUKAMA akakugira ati: Niiwe oririisa abantu bangye Israeli, kandi niiwe oriba omugabe waabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.2",
            "verseOrgIds": [
              "2SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.11.3"
              },
              "items": [
                {
                  "text": "1 Bus 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.11.17"
              },
              "items": [
                {
                  "text": "2 Bag 11:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batyo abakuru ba Israeli boona baashanga omugabe Daudi Heburooni; kandi okwo niyo yaaraganiire nabo endagaano omu maisho ga MUKAMA, bakamushukaho amajuta kuba omugabe wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.3",
            "verseOrgIds": [
              "2SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Daudi, obu yaaza aha ngoma, akaba ahikize emyaka makumi ashatu, yaamara emyaka makumi ana ari aha ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
              "2SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuri Heburooni akamaramu emyaka mushanju n'ameezi mukaaga naategyeka Yuda; kandi omuri Yerusaalemu yaamaramu emyaka makumi ashatu n'eshatu, naategyeka Israeli yoona na Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.6",
            "verseOrgIds": [
              "2SA.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.21"
              },
              "items": [
                {
                  "text": "Bar 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima omugabe yaimuka n'engabo ze, baaza Yerusaalemu, baarwanisa aba Yebusi, abatuuzi b'omuri egyo nsi, abaagizire Daudi bati: Ku oriba otamazireho mpumi n'ebirema, torihika aha; ahabw'okuba bakaba niba teekateeka ngu Daudi tarikubaasa kuhikayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.6",
            "verseOrgIds": [
              "2SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'obu kiraabe kyabaire kityo, Daudi akakwata ekigo kya Saayuuni, nirwo rurembo rwa Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.7",
            "verseOrgIds": [
              "2SA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ahari eryo izooba Daudi akaba agizire ati: Orikwenda kuteera aba Yebusi, atembe ahu amaizi garikwerekyerera, abone kwita biri birema n'empumi, ebi Daudi arikwanga. Nikyo bagirira bati: Empumi n'ebirema bitaritaaha omu nju. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.8",
            "verseOrgIds": [
              "2SA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.5"
              },
              "items": [
                {
                  "text": "2 Bus 32:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Daudi yaatuura omuri ekyo kigo, yaakyeta orurembo rwa Daudi. Yaakyombekaho amaju okukyehinguririza, okuruga Miilo n'okugaruka omunda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.9",
            "verseOrgIds": [
              "2SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaaguma naayeyongyera kugira ekitiinisa; ahakuba MUKAMA Ruhanga ow'amahe akaba ari hamwe nawe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.10",
            "verseOrgIds": [
              "2SA.5.10"
            ]
          }
        }
      ]
    },
    {
