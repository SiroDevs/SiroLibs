          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.13",
            "verseOrgIds": [
              "2SA.5.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.17"
              },
              "items": [
                {
                  "text": "Bir 17:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi ku yaarugire Heburooni, yaahika Yerusaalemu, yaashwererayo ebindi binyanshunju n'abandi bakazi; kandi baamuzaarira abandi baana b'aboojo n'ab'abaishiki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.13",
            "verseOrgIds": [
              "2SA.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga nigo maziina g'abaana abu baamuzaariire ari Yerusaalemu– Shamua, Shobabu, Nasani, Sulemaani, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.14",
            "verseOrgIds": [
              "2SA.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibuhaari, Elishua, Nefegi, Yafia, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.15",
            "verseOrgIds": [
              "2SA.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishaama, Eliada na Elifeleti.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.16",
            "verseOrgIds": [
              "2SA.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.16",
            "verseOrgIds": [
              "2SA.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafilistia ku baahuriire ngu Daudi ashukirweho amajuta kuba omugabe w'Abaisraeli, boona baimuka, baaza kusherura Daudi. Daudi ku yaabihuriire, yaashuuma, yaaza omu kigo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.17",
            "verseOrgIds": [
              "2SA.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bunaku obwo Abafilistia bakaba baizire, bajanjaire oruhita rw'Abareefa rwona. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.18",
            "verseOrgIds": [
              "2SA.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.21"
              },
              "items": [
                {
                  "text": "Kub 27:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.1"
              },
              "items": [
                {
                  "text": "2 Sam 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaayehanuuza ahari MUKAMA naabuuza ati: Nyinamukye, ndwane n'Abafilistia? Noija kubahayo omu mikono yangye? MUKAMA yaagarukamu Daudi ati: Inamuka, ahakuba buzimazima niinyija kuhayo Abafilistia omu mikono yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Daudi yaaza Baali-peraziimu, yaabaitirayo. Bwanyima yaagira ati: MUKAMA ahigwire abazigu bangye omu maisho gangye, nk'oku amizi gahigura omucungiro. Nikyo yaayeteire ogwo mwanya Baali-peraziimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafilistia baatsigayo ebishushani byabo ebirikuramibwa, Daudi n'abashaija be baabitwara.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.21",
            "verseOrgIds": [
              "2SA.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.21",
            "verseOrgIds": [
              "2SA.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku haahingwire ebiro, Abafilistia baagaruka bainamuka, baajanjaara oruhita rw'Abareefa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.22",
            "verseOrgIds": [
              "2SA.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ku yaayehanwize ahari MUKAMA, MUKAMA yaamugarukamu ati: Otainamukayo; kureka obakiikuukye, obareetwe enyima ahashungaine n'akabira k'emitugunda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.23",
            "verseOrgIds": [
              "2SA.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ku oraahurire enshwagara aha mitwe y'emitugunda, ahonaaho oyehuute, ahabw'okuba obwo MUKAMA naaba akwebembeire kuteera engabo z'Abafilistia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.24",
            "verseOrgIds": [
              "2SA.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaatwaza nk'oku MUKAMA yaamuragiira, yaagyenda naita Abafilistia okuruga Geeba, okuhika Gezeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.25",
            "verseOrgIds": [
              "2SA.5.25"
            ]
          }
        }
      ]
