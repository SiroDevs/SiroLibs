                  "text": "Yer 43:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku muraagire muti: Titurikwija kuguma omuri egi nsi, mwagomera eiraka rya MUKAMA Ruhanga waanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.13",
            "verseOrgIds": [
              "JER.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
