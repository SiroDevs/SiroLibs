              },
              "items": [
                {
                  "text": "Neh 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndyabaha okugirirwa embabazi, nawe abone kuzibagirira, kandi abarekye mugume omu nsi yaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.12",
            "verseOrgIds": [
              "JER.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 42:13"
          },
          "items": [
