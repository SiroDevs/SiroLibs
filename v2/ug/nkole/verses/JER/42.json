            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima abakuru b'engabo boona na Yohanaani mwene Karea, na Azaria mwene Hoshaaya, n'abantu boona okuruga aha muto okuhika aha mukuru, bairira haihi nabi Yeremia, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.1",
            "verseOrgIds": [
              "JER.42.1"
            ]
          }
        },
        {
