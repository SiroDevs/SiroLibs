                  "text": "Ezk 11:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mumanye ngu rurara ei murikutiina neija kubahambiza omu nsi ya Misri, kandi n'enjara ei murikutiina neija kugyenda ebeezingiriire, okuhitsya obu murihikayo; kandi okwo niyo murigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.16",
            "verseOrgIds": [
              "JER.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
