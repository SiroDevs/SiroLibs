                {
                  "text": "Ezk 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ku haahingwireho ebiro ikumi, ekigambo kya MUKAMA kyaija ahari Yeremia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.7",
            "verseOrgIds": [
              "JER.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaayeta Yohanaani mwene Karea n'abakuru b'amahe boona abu yaabaire aine, n'abantu boona okuruga aha muto okuhika aha mukuru, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.8",
            "verseOrgIds": [
              "JER.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaabagira ati: Oku nikwo MUKAMA, Ruhanga wa Israeli, ou mwantumireho kumuhitsyaho okweshengyereza kwanyu, arikugamba naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.9",
            "verseOrgIds": [
              "JER.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.8"
              },
              "items": [
                {
                  "text": "Yer 18:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.6"
              },
              "items": [
                {
                  "text": "24:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.6"
              },
              "items": [
                {
                  "text": "Kut 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku muraagume omuri egi nsi, niinyija kubombeka, tindikwija kubasheenya; niinyija kubabyara, tindikwija kubakuura; ahabw'okuba nyefuurize ahabw'akabi aku naabareetsireho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.10",
            "verseOrgIds": [
              "JER.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
