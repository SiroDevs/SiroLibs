                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu boona abataire amaisho aha kuza Misri kutuurayo nibaija kwitirwayo rurara n'enjara n'orufu; kandi tihariho n'omwe omuribo orihonokaho nari oritsigaraho, akakira akabi aku ndibareetaho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.17",
            "verseOrgIds": [
              "JER.42.17"
            ]
          }
        }
