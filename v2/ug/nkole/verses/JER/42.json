              "items": [
                {
                  "text": "37:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nimugira muti: Ngaaha, nitwija kwegiira omu nsi ya Misri, ei tutarireeba ngamba, n'obu kwakuba okuhurira eiraka ry'enzamba, nari okubura eby'okurya, kandi okwo niyo turituura, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.14",
            "verseOrgIds": [
              "JER.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
