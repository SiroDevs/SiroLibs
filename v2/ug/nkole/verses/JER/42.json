              "items": [
                {
                  "text": "3:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima baagira Yeremia bati: Ku turaabe tutakozire ebi MUKAMA Ruhanga waawe araakutume kutugambira, MUKAMA abe niwe yaaba mushinja waitu ow'amazima kandi omwesigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.5",
            "verseOrgIds": [
              "JER.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.23"
              },
              "items": [
                {
                  "text": "Yer 7:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaaba biba birungi nari bibi, nitwija kworobera eiraka rya MUKAMA Ruhanga waitu ou turikukutumaho, tubone kuba gye, ku tubaabe twayorobeire eiraka rya MUKAMA Ruhanga waitu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.6",
            "verseOrgIds": [
              "JER.42.6"
            ]
          }
        }
      ]
