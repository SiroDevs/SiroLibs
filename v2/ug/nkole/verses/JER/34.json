                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.7"
              },
              "items": [
                {
                  "text": "Gal 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.13"
              },
              "items": [
                {
                  "text": "Yak 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo MUKAMA arikugirira ati: Timumpuriire, buri muntu kurangira mugyenzi we na mutaahi we eby'okurekurwa. Reeba, nyowe nimbarangira okurekurwa, nikwo kurekurirwa rurara, n'orufu n'enjara, mbahindura eky'okutiinisa aha mahanga goona ag'omu nsi; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.17",
            "verseOrgIds": [
              "JER.34.17"
            ]
          }
        },
        {
