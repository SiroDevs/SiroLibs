              },
              "items": [
                {
                  "text": "2 Bag 25:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eki n'ekigambo ekyarugire ahari MUKAMA, kikaija ahari Yeremia, obu Nebukadeneeza n'eihe rye ryona n'abantu b'abagabe boona ab'endi z'omu butegyeki bwe n'ab'amahanga goona baarwanisa Yerusaalmu n'endembo zaayo zoona, nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.1",
            "verseOrgIds": [
              "JER.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.10"
              },
              "items": [
                {
                  "text": "Yer 21:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA, Ruhanga wa Israeli, arikugamba naagira ati: Irooko ogambe na Zedekia omugabe wa Yuda, omugire oti: Oku nikwo MUKAMA arikugamba naagira ati: Reeba, oru rurembo ninduhayo omu mikono y'omugabe wa Babulooni, kandi aryarwotsya n'omuriro; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.2",
            "verseOrgIds": [
              "JER.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi naiwe torimukira, kureka buzimazima oryakwatwa, oheebweyo omu mikono ye; ogwo mugabe wa Babulooni muryagamba hamw enimureebana, bwanyima otwarwe Babulooni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.3",
            "verseOrgIds": [
              "JER.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.17"
              },
              "items": [
                {
                  "text": "Yer 38:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka iwe Zedekia omugabe wa Yuda, hurira ekigambo kya MUKAMA! Oku nikwo MUKAMA arikukugambaho naagira ati: Yoriitwa rurara, kureka oryafa gye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.4",
            "verseOrgIds": [
              "JER.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.18"
              },
              "items": [
                {
                  "text": "Yer 22:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.12"
              },
              "items": [
                {
                  "text": "1 Sam 31:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.14"
              },
              "items": [
                {
                  "text": "2 Bus 16:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi nk'oku baayoterire baashwenkuru abagabe abaakubandiize obubaane, nikwo naiwe barikwoterera obubaane, bakakucurira nibagira bati: Ai bambe, mukama wangye! Ahakuba niinye naagamba ekyo kigambo; nikwo MUKAMA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.5",
            "verseOrgIds": [
              "JER.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
