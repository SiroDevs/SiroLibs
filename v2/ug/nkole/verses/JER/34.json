          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo nabi Yeremia yaagambira Zedekia omugabe wa Yuda ebigambo ebyo byona bari Yerusaalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.6",
            "verseOrgIds": [
              "JER.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.5"
              },
              "items": [
                {
                  "text": "Yer 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obu eihe ry'omugabe wa Babulooni ryabaire nirirwanisa Yerusaalemu n'endembo za Yuda, Lakishi na Azeeka, ezaabaire zitsigaireho; ahabw'okuba ezo zombi nizo ndembo ezeehinguririziibwe engo z'amabaare ezaabaire zitsigaireho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.7",
            "verseOrgIds": [
              "JER.34.7"
            ]
          }
        }
      ]
    },
    {
