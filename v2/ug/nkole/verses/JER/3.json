                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naateekateeka nti: Bwanyima y'okukora ebyo byona, naija kungarukira. Kwonka tiyaagaruka; kandi omurumuna Yuda endeebya yaakireeba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.7",
            "verseOrgIds": [
              "JER.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
