            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.16.46"
              },
              "items": [
                {
                  "text": "Ezk 16:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
