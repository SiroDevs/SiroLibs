              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kutandika kw'obutegyeki bwa Zedekia mwene Yosia omugabe wa Yuda, ekigambo eki kikaija ahari Yeremia nikiruga ahari MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "verse",
