            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo murekye kuhurira baanabi baanyu, abafumu baanyu, nari abarogi baanyu, abarikubagira bati: Timuriheereza omugabe wa Babulooni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba ebi barikubahanuurira n'ebishuba ebirikwija kubareetera okutwarwa hare n'ensi yaanyu; kandi naanye ndyabgibabingamu, muhwerekyerere. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka eihanga ryona eririikiriza kwinika ebitsya kutegyekwa omugabe wa Babulooni n'okumuheereza, eryo niryo ndireka omu nsi yaaryo kugihinga n'okugituuramu; nikwo MUKAMA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        }
