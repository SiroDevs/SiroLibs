                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima naagambira Zedekia omugabe wa Yuda omu muringo nk'ogwo, ningira nti: Mwinikye ebitsya byanyu, mutegyekwe omugabe wa Babulooni, mumuheereze, we n'abantu be, mubone kugumaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.31"
              },
              "items": [
                {
                  "text": "Ezk 18:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu iwe n'abantu baawe ku mwakwitwa rurara n'enjara n'orufu, nk'oku MUKAMA agambire aha ihanga ryona eririkwanga kuheereza omugabe wa Babulooni, mukaazira ki? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutahurira ebigambo bya baanabi abarikubagira bati: Timuriheereza omugabe wa Babulooni; ahabw'okuba ebi barikubahanuurira n'ebishuba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiinye mbatumire, kureka nibahanuura ebishuba omu iziina ryangye; ekiraarugyemu ndyababinga omuri egi nsi, muhwerekyerere, imwe na baanabi abarikubahanuurira; nikwo MUKAMA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        }
      ]
    },
