              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ozitume ahari bakama baazo oti: Oku nikwo MUKAMA ow'amahe, Ruhanga wa Israeli arikugamba naagira ati: Oku nikwo muraagambire bakama baanyu muti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
