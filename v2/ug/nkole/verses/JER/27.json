            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yeremia yaagira ati: Oku nikwo MUKAMA angambiire naagira ati: Yesharire enkoba, oyebaijere emigamba, obite omu bitysa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima otume aha mugabe wa Edomu, owa Moabu, ow'Abaamoni, owa Tuuro n'owa Sidoni, obatumeho entumwa eziizire Yerusaalemu ahari Zedekia omugabe wa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
