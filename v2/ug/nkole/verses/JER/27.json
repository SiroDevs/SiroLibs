            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka eihanga ryona nari obugabe bwona, oburyanga kuheereza Nebukadeneeza ogwo, omugabe wa Babulooni, n'okwikiriza kwinika ebitsya kutegyekwa ogwo mugabe, ndyafubira eryo ihanga na rurara n'enjara n'orufu, okuhitsya obu ndirimarisaho oukono gwe; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
