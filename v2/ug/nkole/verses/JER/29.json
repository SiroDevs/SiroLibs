            }
          ]
        },
        {
          "text": "Ahabw'okuba mugizire muti: MUKAMA atwimukiize baanabi omuri Babulooni- ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
