                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muryansherura, mumbone, ku murinsherura n'omutima gwanyu gwona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buzimazima muryambona, kandi ndyabaiha omu bukwatwa, mbataaruure omu mahanga goona n'omu myanya yoona, ei naababingiiremu, mbagarure omu mwanya ogu naabaihiremu nimbatwara omu bukwatwa; nikwo MUKAMA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
