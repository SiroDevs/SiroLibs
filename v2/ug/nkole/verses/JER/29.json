                  "text": "Yer 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " oku nikwo MUKAMA ow'amahe arikugamba aha mugabe ori aha ngoma ya Daudi, n'aha bantu boona abatwire omuri orwo rurembo, beene waanyu abataratwairwe naimwe mu bukwatwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
