                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tuma aha nkwatwa zoona, ozigire oti: Oku nikwo MUKAMA arikugamba ahari Shemaaya owa Nehelaamu, naagira ati: Ahabwa Shemaaya kubahanuurira ntamutumire, akabeesigisa ebishuba, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.31",
            "verseOrgIds": [
              "JER.29.31"
            ]
