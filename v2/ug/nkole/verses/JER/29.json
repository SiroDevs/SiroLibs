              "JER.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kureka oku nikwo MUKAMA arikugamba naagira ati: Emyaka makumi mushanju eyaahanwirwe ahari Babulooni ku erihwa, ndyabaayaayira, mpikiirize eki naabaraganiise, mbagarure omu mwanya ogu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
