            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndyabakuratsa rurara, enjara n'orufu, mbagire ekirikutiinisa aha mahanga goona ag'omu nsi, babe eky'okukyeenwa, eky'okutiinisa, eky'okweshaanya, n'ekijumo omu mahanga goona agu ndiba mbabingiiremu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
