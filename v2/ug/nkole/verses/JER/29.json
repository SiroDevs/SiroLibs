              "type": "text"
            }
          ]
        },
        {
          "text": " Zefania omunyamurwa, ku yaareebire egyo baruha, yaagishomera nabi Yeremia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
