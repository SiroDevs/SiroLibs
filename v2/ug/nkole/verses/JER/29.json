                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okutata mutima aha bigambo byangye, ebi naabaire ntuura nimbatumaho abairu bangye baanabi, kwonka mukanga kuhurira; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        },
        {
