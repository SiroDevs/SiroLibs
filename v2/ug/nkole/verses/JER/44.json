                  "text": "21:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Beitu obubaane obu mwayotereire omu ndembo za Yuda n'omu nguuto za Yerusaalemu, imwe na baashwenkuriimwe, abagabe baanyu n'abanyiginya baanyu, n'abantu b'omuri egyo nsi, MUKAMA tarabiijukire, bikamuhika aha mutima? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.21",
            "verseOrgIds": [
              "JER.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
