            "verseId": "JER.44.11",
            "verseOrgIds": [
              "JER.44.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.10"
              },
              "items": [
                {
                  "text": "Yer 21:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo MUKAMA ow'amahe, Ruhanga wa Israeli, arikugirira ati: Reeba, niinyija kubata omu kaso, mbakore kubi, mmareho Abayuda boona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.11",
            "verseOrgIds": [
              "JER.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.16"
              },
              "items": [
                {
                  "text": "Yer 18:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.42.15"
              },
              "items": [
                {
                  "text": "42:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.42.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Abayuda abaatsigaireho abamaririire kwija omuri Misri kutuuramu, ndyabatwara, bamarweho; omuri egi nsi ya Misri nimwo barigwa, bakamarwaho rurara n'enjara; okuruga aha muto okuhika aha mukuru baryaitwa rurara n'enjara, kandi baryaba ekirikwamaganwa, ekirikutiinisa, eky'okukyeenwa n'eky'okushekyererwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.12",
            "verseOrgIds": [
              "JER.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndyafubira abatwire omu nsi ya Misri, nk'oku naafubiire Yerusaalemu, mbaitwe rurara n'enjara n'orufu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.13",
            "verseOrgIds": [
              "JER.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.27"
              },
              "items": [
                {
                  "text": "Yer 22:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.42.17"
              },
              "items": [
                {
                  "text": "42:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.2"
              },
              "items": [
                {
                  "text": "44:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " habure n'omwe omu Bayuda abaatsigaireho abagiire omu nsi ya Misri kutuurayo owaahonokaho nari owaatsigaraho, nari owaagaruka omu nsi ya Yuda ei barikwetenga kugaruka kutuuramu; ahabw'okuba tihaine barigarukayo, kureka bakye abaacwire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.14",
            "verseOrgIds": [
              "JER.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.14",
            "verseOrgIds": [
              "JER.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima abashaija boona, abaabaire nibamanya ngu abakazi baabo nibooterera baaruhanga abandi obubaane, kandi n'abakazi boona abaabaire beemereire aho, bari omutwe muhango munonga, n'abantu boona abaabaire batwire Pasiroosi omu nsi ya Misri, baagarukamu Yeremia nibagira bati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.15",
            "verseOrgIds": [
              "JER.44.15"
            ]
          }
        },
