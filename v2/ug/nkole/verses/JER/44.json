              "items": [
                {
                  "text": "Ezk 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'abarihonoka ahari rurara baryaruga omu nsi ya Misri, bagarukye omu nsi ya Yuda bari mbarwa; kandi Abayuda boona abatsigaireho abaizire omu nsi ya Misri kutuuramu baryamanya ou ekigambo kye krigumaho, yaaba kyangye nari kyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.28",
            "verseOrgIds": [
              "JER.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
