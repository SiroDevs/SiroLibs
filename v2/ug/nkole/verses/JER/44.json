            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yeremia yaabuuza abantu boona, abashaija n'abakazi abaamugarukiremu batyo ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.20",
