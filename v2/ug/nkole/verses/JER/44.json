            "number": "18",
            "style": "v",
            "sid": "JER 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka okwiha obu twarereera kwoterera omugabekazi w'omu iguru obubaane n'okumushukira empongano z'eby'okunywa, tukabura byona, twamarwaho rurara n'enjara. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.18",
            "verseOrgIds": [
              "JER.44.18"
            ]
          }
        },
