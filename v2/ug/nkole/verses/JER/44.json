          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.28"
              },
              "items": [
                {
                  "text": "Yer 31:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.42.16"
              },
              "items": [
                {
                  "text": "42:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, mbataireho abiri kubakora kubi, ti kubakora gye. Abayuda boona abari omu nsi ya Misri baryamarwaho rurara n'enjara, okuhitsya obu barihweraho kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.27",
            "verseOrgIds": [
              "JER.44.27"
            ]
          }
        },
        {
