                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA akaba atakibaasa kugumisiririza bibi byanyu n'ebihagaro ebi mwabaire nimukora; nikyo ensi yaanyu yaahindukiire amatongo n'eihamba n'eky'okukyeenwa, etagire owaagituuramu, nk'oku kiri na hati. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.22",
            "verseOrgIds": [
              "JER.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
