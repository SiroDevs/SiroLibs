                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.14"
              },
              "items": [
                {
                  "text": "46:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ekigambo kikaija ahari Yeremia nikigamba aha Bayudaaya boona abaabaire batwire omuri Misri, Migidooli, Tahapenesi, Noofu n'omu nsi ya Pasiroosi, nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.1",
            "verseOrgIds": [
              "JER.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nikwo MUKAMA ow'amahe, Ruhanga wa Israeli, arikugamba naagira ati: Mukareeba akabi koona aku naareetsire ahari Yerusaalemu n'aha ndembo zaoona eza Yuda. Hati n'amatongo; tihaine ozitwiremu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.2",
            "verseOrgIds": [
              "JER.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.16"
              },
              "items": [
                {
                  "text": "Yer 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.18"
              },
              "items": [
                {
                  "text": "7:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.14"
              },
              "items": [
                {
                  "text": "Bir 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'obubi bw'ebi baakozire nibangwisa kubi, obu baaza kwotera obubaane, bakaheereza baaruhanga abandi abu batakamanyaga, bo naimwe na baashwenkuriimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.3",
            "verseOrgIds": [
              "JER.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.15"
              },
              "items": [
                {
                  "text": "2 Bus 36:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka nkaguma nimbatumaho abaheereza bangye baanabi boona, ningira nti: Nyaabura 'mwe, murekye kukora ebirikunugwa ebyo ebi ndikwanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.4",
            "verseOrgIds": [
              "JER.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka tibaahurira n'obu kwakuba okutega amatu, kuhinduka kureka obubi bwabo, n'okutooterera baaruhanga abandi obubaane. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.5",
            "verseOrgIds": [
              "JER.44.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.11"
              },
              "items": [
                {
                  "text": "Yer 9:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo okuguubwa kubi kwangye n'ekiniga kyangye byashukiirwe, bikabuguma omu ndembo za Yuda n'omu nguuto za Yerusaalemu, zikahinduka amatongo eihamba, nk'oku ziri hati. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.6",
            "verseOrgIds": [
              "JER.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.38"
              },
              "items": [
                {
                  "text": "Kub 16:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.2.11"
              },
              "items": [
                {
                  "text": "Tonz 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu oku nikwo MUKAMA ow'amahe, Ruhanga wa Israeli, arikugamba naagira ati: Ahabw'enki nimukora akabi kahango kati aha magara gaanyu, mukeemaraho omushaija n'omukazi, omwana muto n'omwereere ou mwatsigaza? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.7",
            "verseOrgIds": [
              "JER.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.16"
              },
              "items": [
                {
                  "text": "Yer 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.42.18"
              },
              "items": [
                {
                  "text": "42:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'enki nimuunyitsa ekiniga n'ebi murikukora n'emikono yaanyu, mukooterera baaruhanga abandi obubaane omu nsi ya Misri, ei mwaizire kutuuramu, ngu mucuubwe, mube eky'okukyeenwa n'eky'okushekyererwa omu mahanga goona ag'omu nsi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.8",
            "verseOrgIds": [
              "JER.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.15"
              },
              "items": [
                {
                  "text": "Yer 44:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.1"
              },
              "items": [
                {
                  "text": "1 Bag 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.13"
              },
              "items": [
                {
                  "text": "15:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwebirwe obubi bwa baashwenkuriimwe n'obw'abagabe ba Yuda, obw'abakazi baabo, obwanyu n'obw'abakazi baanyu, obw'ebi baakoreire omu ndembo za Yuda n'omu nguuto za Yerusaalemu? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.9",
            "verseOrgIds": [
              "JER.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.28.14"
              },
              "items": [
                {
                  "text": "Enf 28:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nangwa n'okuhitsya hati tibakeecureize, n'obu kwakuba okutiina, kandi tibakagyendeire mu biragiro byangye n'omu byatairweho, ebi naataire omu maisho gaanyu n'aga baanshwenkuriimwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.10",
            "verseOrgIds": [
              "JER.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
