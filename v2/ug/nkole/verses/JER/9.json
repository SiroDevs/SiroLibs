        {
          "text": " Oku nikwo MUKAMA arikugamba naagira ati: Omunyabwengye arekye kwehimbisa ahabw'obwengye bwe, n'ow'amaani arekye kwehimbisa ahabw'amaani ge, n'omutungi arekye kwehimbisa ahabw'eitungo rye; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        },
