                  "text": "Hos 14:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ni muntu ki oine obwengye bwingi orikubaasa kumanya ebyo? N'oha oyegambiriirwe MUKAMA, ngu abone kubimanyisa? Ahabw'enki ensi ehwerekyereziibwe, ekahinduka amatongo, ekaba nk'eihamba, ekabura owaagirabamu? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.30+PSA.89.31+PSA.89.32"
              },
              "items": [
                {
                  "text": "Zab 89:30-32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi MUKAMA naagira ati: Ahabw'okureka ebiragiro byangye ebi naabahaire, batoorobere iraka ryangye, nari okutwaza nk'oku ririkubaragiira, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.13",
            "verseOrgIds": [
              "JER.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.17"
              },
              "items": [
                {
                  "text": "Yer 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka bakakuratira ebi emitima yaabo egangaire erikwenda, hamwe na Baabaali, nk'oku baishenkurubo baabeegyeise. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.14",
            "verseOrgIds": [
              "JER.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.14"
              },
              "items": [
                {
                  "text": "Yer 8:14",
                  "type": "text"
