              "items": [
                {
                  "text": "Zab 80:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo MUKAMA ow'amahe, Ruhanga wa Israeli, arikugirira ati: Reeba, eri ihanga ndyarigaburira apusinto, ndinywaise amaizi agarikwita; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.15",
            "verseOrgIds": [
              "JER.9.15"
            ]
          }
        },
