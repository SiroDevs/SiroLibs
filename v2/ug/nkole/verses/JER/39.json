            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yeremia, obu yaabaire akikingirainwe omu kibuga ky'abarinzi, ekigambo kya MUKAMA kikamwijaho nikigira kiti: ",
          "type": "text",
