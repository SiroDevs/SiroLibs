            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.4"
              },
              "items": [
                {
                  "text": "Yer 40:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutware, omurinde gye, otagira eki waamwitsa, kureka eki araakugambire, obe nikyo waamukorera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.12",
            "verseOrgIds": [
              "JER.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Nebuzaradaani omukuru w'abarinzi, Nebushazibaani Rabusarisi, Nerugaali-sharezaari Rabumaagi, n'abandi bategyeki b'omugabe wa Babulooni boona ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.13",
            "verseOrgIds": [
              "JER.39.13"
            ]
