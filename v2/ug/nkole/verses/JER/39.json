        },
        {
          "text": "Kandi Nebukadeneeza omugabe wa Babulooni yaaragiira Nebuzaradaani omukuru w'abarinzi ebya Yeremia, naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.11",
            "verseOrgIds": [
              "JER.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 39:12"
          },
          "items": [
