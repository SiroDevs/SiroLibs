              "items": [
                {
                  "text": "2 Bag 25:1-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwaka gwa mwenda ogw'omu busingye bwa Zedekia omugabe wa Yuda, omu kwezi kwa ikumi, Nebukadeneeza omugabe wa Babulooni kaija n'eihe rye ryona, yaateera Yerusaalemu, yaagigota. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.1",
            "verseOrgIds": [
              "JER.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka gwa ikumi na gumwe ogw'omu busingye bwa Zedekia, omu kwezi kwa kana, aha kiro kyakwo kya mwenda, bakasheenya aha'okutaahira omu rurembo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.2",
            "verseOrgIds": [
              "JER.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.15"
              },
              "items": [
                {
                  "text": "Yer 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.13"
              },
              "items": [
                {
                  "text": "39:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.17"
              },
              "items": [
                {
                  "text": "2 Bag 18:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baaherize kurukwata, abategyeki b'omugabe wa Babulooni boona baarutaahamu, baashutama omu irembo ry'ahagati; amaziina gaabo ni Nerigali-sharezeeri, Samugaari-neebo, Sarusekimu, Rabusarisi, na Nerugaali-sherezeeri Rabumaagi, hamwe n'abandi bategyeki b'omugabe wa Babulooni boona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.3",
            "verseOrgIds": [
              "JER.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.1"
              },
              "items": [
                {
                  "text": "Bir 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Zedekia omugabe wa Yuda n'abaserukare be boona ku baabareebire, baahunga, baacwa omu rurembo nyekiro nibatoora omuhanda ogurikuraba omu musiri gw'omugabe omu irembo ry'ahagati y'engo zombi, baatoora ogurikuza Araba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.4",
            "verseOrgIds": [
              "JER.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.5.10"
              },
              "items": [
                {
                  "text": "Yos 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.33"
              },
              "items": [
                {
                  "text": "2 Bag 23:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.15"
              },
              "items": [
                {
                  "text": "Ezk 17:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka eihe ry'Abakaludaaya ryabakurata, ryakwatira Zedekia omu ruhita rwa Yeriko. Ku baaherize kumukwata, baamutwarira Nebukadeneeza omugabe wa Babulooni Ribula omu nsi ya Hamasi, yaamucwera orubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.5",
            "verseOrgIds": [
              "JER.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe wa Babulooni yaitirayo batabani ba Zedekia omu maisho ga ishebo, kandi yaita n'abakungu ba Yuda boona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.6",
            "verseOrgIds": [
              "JER.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.4"
              },
              "items": [
                {
                  "text": "Yer 32:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.13"
              },
              "items": [
                {
                  "text": "Ezk 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yaihamu Zedekia amaisho, yaamubohesa emihama, yaamutwara Babulooni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.7",
            "verseOrgIds": [
              "JER.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.3"
              },
              "items": [
                {
                  "text": "Neh 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.5"
              },
              "items": [
                {
                  "text": "Isa 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Abakaludaaya baayotsya nyaruju y'omugabe n'amaju g'abantu, baasheenya n'orugo rw'amabaare rwa Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.8",
            "verseOrgIds": [
              "JER.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.1"
              },
              "items": [
                {
                  "text": "Yer 40:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.36"
              },
              "items": [
                {
                  "text": "Kut 37:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Nebuzaradaani omukuru w'abarinzi yaatwara abantu abaatsigaire omu rurembo, abaabaire bamwehongyeire hamwe n'abaabaire batsigaire omu rurembo, yaabatwara Babulooni bari enkwatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.9",
            "verseOrgIds": [
              "JER.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.7"
              },
              "items": [
                {
                  "text": "Yer 40:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Nebuzaradaani omukuru w'abarinzi yaatsiga omuri Yuda abooro bamwe abataine kantu, yaabaha emisiri y'emizaabibu n'eshambu omuri obwo bunaku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.10",
            "verseOrgIds": [
              "JER.39.10"
            ]
          }
        }
      ]
