            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo ekyarugire ahari MUKAMA kikaija ahari Yeremia nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.19.1"
              },
              "items": [
                {
                  "text": "Yer 19:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imuka oshuume, oze ow'omubumbi, kandi okwo niyo ndaakugambirire ebigambo byangye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.2",
            "verseOrgIds": [
              "JER.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntyo naashuuma, naaza ow'omubumbi, naashanga naabumbisa enziga ye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.3",
            "verseOrgIds": [
              "JER.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.13.7"
              },
              "items": [
                {
                  "text": "Yer 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.20+ROM.9.21+ROM.9.22+ROM.9.23+ROM.9.24"
              },
              "items": [
                {
                  "text": "Rom 9:20-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki yaabaire naabumba omu ibumba kyasiisikarira omu ngaro ze; yaagaruka yaaribumbamu ekindi, nk'oku yaabaire naayenda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.4",
            "verseOrgIds": [
              "JER.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ekigambo kya MUKAMA kyanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.10.9"
              },
              "items": [
                {
                  "text": "Yob 10:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.45.9"
              },
              "items": [
                {
                  "text": "Isa 45:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.64.8"
              },
              "items": [
                {
                  "text": "64:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imwe b'enju ya Israeli 'mwe, nimugira ngu tinkaabaasa kubagira nk'oku ogwo mubumbi yaagira eibumba? Reeba, nk'oku eibumba riri omu ngaro z'omubumbi, naimwe nikwo muri omu ngaro zangye, imwe nju ya Israeli 'mwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.6"
              },
              "items": [
                {
                  "text": "Yer 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.42.10"
              },
              "items": [
                {
                  "text": "42:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu bunaku bwona obu ndigambiramu aha ihanga nari aha bugabe kurirandura, kurisheenya n'okuricwekyereza, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.7",
            "verseOrgIds": [
              "JER.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
