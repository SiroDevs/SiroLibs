              "items": [
                {
                  "text": "2 Bag 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu irooko ogambire abantu ba Yuda n'abatuuzi ba Yerusaalemu oti: Oku niwko MUKAMA arikugamba naagira ati: Reeba, ninteekateeka kubareetaho akabi, nkandi ncumire n'enaama y'okubarwanisa. Nyaabura 'mwe, nimugarukye, buri muntu arugye omu muhanda gwe omubi, mushemeze emitwarize yaanyu n'ebi murikukora.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        }
