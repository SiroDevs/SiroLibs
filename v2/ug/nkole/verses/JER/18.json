              "items": [
                {
                  "text": "Yon 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " eryo ihanga eri ndiba naagambireho, ku ririhinduka, ryareka ebibi byaryo, naanye ndyayegarukamu, ndekye akabi aku mbaire niinyenda kurireetaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omu bunaku obu ndigambiramu aha ihanga nari aha bugabe kuryombeka n'okuribyara, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.9",
            "verseOrgIds": [
              "JER.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "eryo ihanga kuririkora ebirikwangwa omu maisho gangye, ryayanga kuhurira eiraka ryangye, obwo ndyayefuuza, ndekye kukora ebirungi ebi mbaire niinyenda kurikorera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.10",
            "verseOrgIds": [
              "JER.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
