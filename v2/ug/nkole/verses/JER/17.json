              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naiwe wenka toriguma mu buhunguzi bwawe obu naakuhaire, kureka oryaheerereza abazigu baawe omu nsi ei otarikumanya; ahabw'okuba omuriro ogwakiibwe ekiniga kyangye guryaguma nigwaka ebiro byona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
