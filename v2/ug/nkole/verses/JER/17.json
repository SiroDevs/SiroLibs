                  "text": "Isa 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'aha nshozi omu nsi z'obwerere. Obutungi bwawe n'ebintu byawe byona ebirungi ndyabihayo kuba eminyago omu nsi yaawe yoona nooturwa ekibi kyawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        },
        {
