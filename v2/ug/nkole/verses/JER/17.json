                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'abaana baabo nibakiijuka amatambiro gaabo n'ebishushani byabo bya Ashera ebyabaire biba haihi na buri kiti kibisi ekyetwa omurinzi aha bibungo biraingwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        },
        {
