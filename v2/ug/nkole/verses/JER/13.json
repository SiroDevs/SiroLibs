                "loc": "JER.48.12"
              },
              "items": [
                {
                  "text": "Yer 48:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo oraabagambirire eki kigambo noogira oti: Oku nikwo MUKAMA Ruhanga wa Israeli arikugamba naagira ati: Buri njoga neija kwijuzibwa viinyo; kandi nabo nibaija kukugira bati: Noogira ngu itwe titurikumanya ku buri njoga erikwija kwijuzibwa viinyo? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.12",
            "verseOrgIds": [
              "JER.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 13:13"
          },
          "items": [
            {
              "text": "13",
