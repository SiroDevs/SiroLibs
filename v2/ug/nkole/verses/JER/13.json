              },
              "items": [
                {
                  "text": "Ezk 23:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naiwe obagire oti: Oku nikwo MUKAMA arikugamba naagira ati: Reeba, niinyija kusindiza kiwme abatwire omu nsi egi boona, abagabe abashutami aha kitebe kya Daudi, abanyamurwa, baanabi n'abatuuzi b'omuri Yerusaalemu boona, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.13",
            "verseOrgIds": [
              "JER.13.13"
            ]
          }
        },
