        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.12"
              },
              "items": [
                {
                  "text": "Yer 32:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Yeremia yaayeta Baruki mwene Neria, Baruki ogwo yaahandiika omu muzingo gw'ekitabo ebigambo byona ebirikuruga omu kanwa ka Yeremia, ebi MUKAMA yaabaire amugambira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.2"
              },
              "items": [
                {
                  "text": "Yer 32:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yeremia yaagira Baruki ati: Banzibiire kuza omu nju ya MUKAMA; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.36.9"
              },
              "items": [
                {
                  "text": "Yer 36:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'ahabw'ekyo obe niiwe waagyenda, kandi oshome ebigambo bya MUKAMA ebihandiikirwe omu muzingo gw'ekitabo ogu ohandiikiremu ebigambo ebi nkugambiire; obishomere abantu boona abateeraniire omu nju ya MUKAMA aha izooba ry'okwesiibyakwo. Kandi obishomere n'Abayuda boona abarugire omu ndembo zaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obundi okweshengyereza kwabo kukaahika ahari MUKAMA, buri muntu ahinduka areka emitwarize ye emibi, ahabw'okuba okuguubwa kubi kwa MUKAMA n'ekiniga kye, ebi agambire kugirira abo bantu, ni bingi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Baruki mwene Neria yaakora byona ebi nabi Yeremia yaamuragiira, yaashoma ebigambo bya MUKAMA ebihandiikirwe omuri ogwo muzingo gw'ekitabo, naabishomera omu nju ya MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        }
      ]
    },
    {
