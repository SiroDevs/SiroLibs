              "items": [
                {
                  "text": "49:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi aryatweka omuriro omuri hekalu za baaruhanga ba Misri, abootsye, abatware bari enkwatwa, ashemeze ensi ya Misri, nk'oku omuriisa ashemeza ekijwaro kye, akakimaramu enda. Bwanyima arugyeyo n'obusingye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.12",
            "verseOrgIds": [
              "JER.43.12"
            ]
          }
        },
