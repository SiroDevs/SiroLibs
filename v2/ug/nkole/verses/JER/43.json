              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.7",
            "verseOrgIds": [
              "JER.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ekigambo kya MUKAMA kyaija ahari Yeremia ari Tahapenesi, nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.8",
            "verseOrgIds": [
              "JER.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twara amabaare mahango omu ngaro, ogasherekye omu budongo ahansi y'amabaare agaariire aha irembo ry'ekikaari kya Faraho omuri Tahapenesi, Abayuda boona nibakureeba; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.9",
            "verseOrgIds": [
              "JER.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.15"
              },
              "items": [
                {
                  "text": "Yer 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.9"
              },
              "items": [
                {
                  "text": "25:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obagire oti: Oku nikwo MUKAMA ow'amahe, Ruhanga wa Israeli, arikugamba naagira ati: Reeba, ndyayohereza omwiru wangye Nebukadeneeza omugabe wa Babulooni, ate ekitebe kye ky'obugabe ahari aga mabaare agu naashereka, kandi ateere eihema rye ry'obugabe ahaiguru yaago. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.10",
            "verseOrgIds": [
              "JER.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "Yer 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
