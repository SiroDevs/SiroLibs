              "attrs": {
                "loc": "JER.44.13"
              },
              "items": [
                {
                  "text": "44:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.13"
              },
              "items": [
                {
                  "text": "46:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aryaija ateere ensi ya Misri, aheyo ab'okwitwa rufu ebaite, ab'okutwarwa omu bukwatwa batwarwe, n'ab'okwitwa rurara ebaite. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.11",
            "verseOrgIds": [
              "JER.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
