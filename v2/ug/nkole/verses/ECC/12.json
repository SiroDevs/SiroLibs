                {
                  "text": "Mik 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " enyigi ezirikureeba omu nguuto zikakingwa, okugamba kw'emengo kukaba kukye, omuntu akasisiimurwa eiraka ry'enyonyi, kandi n'abaishiki boona abeeshongozi bakagarurwa ahansi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        },
