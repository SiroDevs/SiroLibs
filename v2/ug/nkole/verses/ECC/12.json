                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " omucuucu gukagaruka omu itaka, nk'oku gwabaire guri, n'amagara gakagaruka ahari Ruhanga owaagahaire. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
