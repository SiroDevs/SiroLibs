            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " baryatiina ekiri ahaiguru, kandi ebirikutiinisa biryaba biri omu muhanda; omurozi guryarabya, eseeneene ziryarusya, n'ebirikwetengwa biryahwaho, ahabw'okuba omuntu aryaba naaza omu ka y'entuura, n'abarikucura nibazengyerera omu nguuto; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        },
