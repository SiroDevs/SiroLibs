              "items": [
                {
                  "text": "2 Sam 19:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ogume oijukye Omuhangi waawe omu biro by'obutsigazi bwawe, ebiro bibi bitakaizire, n'emyaka etakahikire ei origiriramu oti: Tinkigishemerererwamu, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "eizooba n'omushana n'okwezi n'enyonyoozi bitakashwekirwe mwirima, kandi n'ebicu bitakagarukire enjura yaatsya; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.1"
              },
              "items": [
                {
                  "text": "Kut 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obunaku obu abarizni b'enju baritetema, n'emanzi zikabundabunda, abasi bakarereera ahabw'okuba bakye, n'abarikuringuririza omu dirisa amaisho gakagiibwaho oruho; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        },
        {
