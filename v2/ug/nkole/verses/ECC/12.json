              "items": [
                {
                  "text": "Mub 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Omubuurizi yaagaruka yaagira ati: Ni busha bwa busha; byona ni busha!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
