                "loc": "2CO.7.1"
              },
              "items": [
                {
                  "text": "2 Kor 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo iha amaganya omu mutima gwawe, kandi omubiri gwawe ogutaanisa n'ebibi; ahabw'okuba obuto n'obutsigazi ni busha.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
