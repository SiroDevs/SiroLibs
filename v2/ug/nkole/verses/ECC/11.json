              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku otarikumanya muhanda gw'omuyaga, nari oku amagufa gakurira omu nda y'oine enda, nikwo otarikumanya murimo gwa Ruhanga okora byona. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasheeshe ogume obibe embibo, kandi n'omu mwabazyo orekye kugwisa omukono; ahabw'okuba torikumanya ekiryera, yaaba eki nari kiriya, nari shi yaaba byombi biriba birungi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
