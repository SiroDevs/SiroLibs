                "loc": "ECC.2.23"
              },
              "items": [
                {
                  "text": "Mub 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu ku araahangaare emyaka mingi, agishemerererwemu yoona; kwonka amanye ngu ebiro by'omwirima biryaba bingi. Ebiribaho byona ni busha.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
