              "items": [
                {
                  "text": "Kub 15:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iwe mutsigazi 'we, shemerererwa obutsigazi bwawe, kandi omutima gwawe gugume gunanukye omu biro by'okunyeeta kwawe. Gyendera omu mihanda ei omutima gwawe gurikukunda, nk'oku amaisho gaawe garikureeba. Kwonka omanye ngu ahabw'ebyo byona Ruhanga aryakucwera orubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
