              },
              "items": [
                {
                  "text": "Mub 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Buri kintu kiine ebiro byakyo, kandi ekyatairweho ahansi y'eiguru kyona kiine obunaku bwakyo:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.1",
            "verseOrgIds": [
              "ECC.3.1"
            ]
          }
        }
      ]
    },
