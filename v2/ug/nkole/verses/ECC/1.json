            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naata omutima aha kwetegyereza obwengye n'obugwa-iraro n'obushema; naashanga nabyo kuri okwitanira omuyaga.",
          "type": "text",
          "attrs": {
