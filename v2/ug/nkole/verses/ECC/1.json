        },
        {
          "text": "Ebigambo by'Omubuurizi, mwene Daudi, omugabe ow'omuri Yerusaalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
    },
