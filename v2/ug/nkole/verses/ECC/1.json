                "loc": "ECC.3.10"
              },
              "items": [
                {
                  "text": "Mub 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.19"
              },
              "items": [
                {
                  "text": "Kut 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nkata omutima aha kusherura n'okucondooza obwengye, ngu mbone kumanya ebirikukorwa ahansi y'eiguru byona; naashanga kuri okufa kubi okw'obusaasi oku Ruhanga yaahaire abantu kubarusya. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
