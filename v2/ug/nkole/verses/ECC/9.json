              "items": [
                {
                  "text": "2 Sam 20:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu rurembo rukye hakaba harimu abantu bakye; bwanyima omugabe rugambwa yaija, yaarugota, yaarwombekaho ebigo bihango. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.14",
            "verseOrgIds": [
              "ECC.9.14"
            ]
          }
        },
