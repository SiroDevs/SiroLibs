            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.8.15"
              },
              "items": [
                {
                  "text": "Mub 8:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Irooko oyeriire eby'okurya byawe n'okushemererwa, kandi oyenywere viinyo yaawe n'okweruhuura; ahabw'okuba Ruhanga aherize kusiima ebi orikukora. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.7",
            "verseOrgIds": [
              "ECC.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebijwaro byawe bigume nibyera, kandi omutwe gwawe gurrekye kuburamu amajuta.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.8",
            "verseOrgIds": [
              "ECC.9.8"
            ]
          }
        }
      ]
    },
