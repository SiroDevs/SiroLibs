                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naagaruka naareeba ahansi y'eizooba ngu abairuki rugambwa tibo basinga omu mpaka z'okwiruka, n'ab'amaani tibo basingura omu rugamba, n'ab'obwengye tibo batunga eby'okurya, n'abarikwegyereza tibo bagira eitungo, n'abahangu tibo bashongoka; kureka boona bahikwaho obunaku n'ebihikiirizi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.8.7"
              },
              "items": [
                {
                  "text": "Mub 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.7.23"
              },
              "items": [
                {
                  "text": "Enf 7:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.34+LUK.21.35"
              },
              "items": [
                {
                  "text": "Luk 21:34-35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.3"
              },
              "items": [
                {
                  "text": "1 Tes 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba tihariho muntu omanya obunaku bwe; nk'oku eby'enyanja bikwatwa akatimba kabi, n'enyonyi zikakwatwa omutego, nikwo n'abantu bakwatwa omutego omu bunaku bubi, ku bubagwaho kitaraariire. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi naareeba ahansi y'eizooba eky'okureeberaho eki eky'obwengye ekyansusiire kikuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.13",
            "verseOrgIds": [
              "ECC.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 9:14"
          },
          "items": [
