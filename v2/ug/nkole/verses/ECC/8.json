                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tihariho muntu oine obushoboorozi bw'okutegyeka omuyaga, n'obu kwakuba okwemereza eizooba rya rufu; omuri orwo rugamba tihabaho kuraga, kandi owaayehaireyo kukora ebibi, tibirimujuna. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.13"
              },
              "items": [
                {
                  "text": "Mub 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo byona nkabireeba, obu naata omutima gwangye aha kumanya ebirikukorwa ahansi y'eizooba, omuntu naayekuriza ahari mugyenzi we kumukora kubi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.9",
            "verseOrgIds": [
              "ECC.8.9"
            ]
          }
        }
