              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima nkareeba ababi nibaziikwa, nibaza okuzimu; kwonka abaakozire gye baaruga omu Mwanya ogurikwera, baayeba omu rurembo. Ekyo nakyo ni busha. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.10",
            "verseOrgIds": [
              "ECC.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 8:11"
