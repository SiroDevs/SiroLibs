                "loc": "ECC.2.24"
              },
              "items": [
                {
                  "text": "Mub 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ntyo naasiima okweruhuura; ahabw'okuba tihariho ekirikukirira omuntu okurya n'okunywa n'okweruhuura; ahakuba ebyo nibyo ariguma nabyo omu kufa kubi kwe ebiro byona ebi Ruhanga amuhaire kumara ahansi y'eizooba.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.15",
            "verseOrgIds": [
