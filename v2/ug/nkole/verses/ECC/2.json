            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.15"
              },
              "items": [
                {
                  "text": "10:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.3"
              },
              "items": [
                {
                  "text": "11:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.35.25"
              },
              "items": [
                {
                  "text": "2 Bus 35:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naayerundaanira efeeza n'ezaabu, n'eby'eitungo eby'abagabe n'eby'amashaza; naayetungira abeeshongozi abashaija n'abakazi, n'ebinyanshunju bingi ebirikushemeza abantu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        }
      ]
    },
    {
