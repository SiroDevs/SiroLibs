                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu shi, omuntu aiha ki omu kufa kubi kwe kwona, n'omu bi omutima gwe gwayezirikiire kukora hansi y'eizooba? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.22",
            "verseOrgIds": [
              "ECC.2.22"
            ]
          }
        },
