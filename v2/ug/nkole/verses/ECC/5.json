                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku orireeba omu ishaza abooro nibahatwa, emanja zaabo niziitwa, kandi nibaakwa n'amaani ebi bashemereire, otaritangaara; ahakuba orikukiza abakuru obukuru aryaba naabireeba; kandi hariho orikubakirira kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.8",
            "verseOrgIds": [
              "ECC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omweru gw'ensi guba ogwa boona; n'omugabe atungwa ebi ahingiirwe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
