              "items": [
                {
                  "text": "Mub 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Manya, ebirooto ku bikanya, n'ebigambo bitaine muhoho bikanya; kwonka iwe ogume otiine Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.7",
            "verseOrgIds": [
              "ECC.5.7"
            ]
