                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.4"
              },
              "items": [
                {
                  "text": "Byak 5:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuraganisa otahikiirize nikikirwa okutaraganisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.5",
            "verseOrgIds": [
              "ECC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otariikiriza akanwa kaawe kukucumuza, kandi otarigamba omu maisho ga maraika oti: Kikaba kiri ekishobyo. Nooyendera ki ku Ruhanga agirira eiraka ryawe ekiniga, akacwekyereza emirimo y'emikono yaawe?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.6",
            "verseOrgIds": [
              "ECC.5.6"
            ]
          }
        }
      ]
    },
