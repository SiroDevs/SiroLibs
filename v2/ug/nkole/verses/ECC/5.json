              },
              "items": [
                {
                  "text": "Enf 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku oriba nooza omu nju ya Ruhanga, ogume orinde ekigyere kyawe; okwirira haihi kuhurira nikukira okutamba ebitambo by'abashema, ahabw'okuba bo tibamanya ku barikukora kubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.7"
              },
              "items": [
                {
                  "text": "Mat 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otarirahukwa aha rurimi, kandi otariikiriza omutima gwawe kurahukiriza kurahira omu maisho ga Ruhanga; ahabw'okuba Ruhanga ari omu iguru, naiwe ori aha nsi; n'ahabw'ekyo ebigambo byawe bibe bikye. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabw'okuba ebirooto bireetwa emirabanamu mingi, kandi eiraka ry'omushema rimanyirwa aha bigambo bingi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        }
      ]
    },
