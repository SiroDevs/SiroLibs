              "type": "text"
            }
          ]
        },
        {
          "text": " Ku orirahira nooraganisa ahari Ruhanga, otarikyerererwa kukihikiirirza; ahabw'okuba tashemerererwa bashema. Ogume ohikiirize eki oraganiise. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.4",
            "verseOrgIds": [
              "ECC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
