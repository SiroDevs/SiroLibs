        },
        {
          "text": "Kandi hariho ekibi eki naareebire ahansi y'eizooba, nikwo kushobaya kw'omutegyeki. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.5",
            "verseOrgIds": [
