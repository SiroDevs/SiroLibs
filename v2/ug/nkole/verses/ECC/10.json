          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obushema buteebwa omu myanya mingi y'ekitiinisa, n'abatungi bashutama omu myanya erikugaywa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
