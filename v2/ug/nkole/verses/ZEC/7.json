              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya MUKAMA kyagaruka kyaija ahari Zekaria nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.8",
            "verseOrgIds": [
              "ZEC.7.8"
            ]
          }
        },
