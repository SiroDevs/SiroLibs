              "items": [
                {
                  "text": "Mat 23:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA ow'amahe arikugamba naagira ati: Mucwe emanja z'oburyo, buri muntu agirire mwene waabo embabazi n'esaasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.9",
            "verseOrgIds": [
              "ZEC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murekye kuhata abafaakazi, efuuzi, abashuuhuuki n'abooro; kandi harekye kugira n'omwe omuriimwe owaagirira omwene waabo enaama mbi omu mutima gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.10",
            "verseOrgIds": [
              "ZEC.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.29"
              },
              "items": [
                {
                  "text": "Neh 9:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka baayanga kuhurira, baatunika amabega, baayereebera kuriya, amatu baagahenderamu ebiti, ngu batampurira. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.11",
            "verseOrgIds": [
              "ZEC.7.11"
            ]
          }
        },
