              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka gwa kana ogw'omu busingye bw'omugabe Dario, ekigambo kya MUKAMA kikaija ahari Zekaria aha kiro kya kana ky'okwezi kwa mwenda okurikwetwa Kisileevi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.1",
            "verseOrgIds": [
              "ZEC.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.13.12"
              },
              "items": [
                {
                  "text": "1 Sam 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.9"
              },
              "items": [
                {
                  "text": "Mal 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro ebyo aba Beseeli bakaba batumire Sharezeeri na Regyemu-meleki n'abashaija baabo kweshengyereza MUKAMA kubagirira embabazi, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.2",
            "verseOrgIds": [
              "ZEC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.8"
              },
              "items": [
                {
                  "text": "2 Bag 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.12"
              },
              "items": [
                {
                  "text": "Zek 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'okubuuza abanyamurwa b'enju ya MUKAMA ow'amahe na baanabi, bati: Tushemereire kuza omu magyenyi n'okwesiibyakwo omu kwezi kwa kataano, nk'oku tubaire nitugira omu myaka egi yoona? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.3",
            "verseOrgIds": [
              "ZEC.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ekigambo kya MUKAMA ow'amahe kyanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.4",
            "verseOrgIds": [
              "ZEC.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.25"
              },
              "items": [
                {
                  "text": "2 Bag 25:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.58.4"
              },
              "items": [
                {
                  "text": "Isa 58:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.58.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.12"
              },
              "items": [
                {
                  "text": "Zek 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gambira abantu b'omuri egi nsi boona n'abanyamurwa oti: Obu mwabaire mwesiibyakwo, mukaza omu magyenyi omu kwezi kwa kataano n'okwa mushanju omuri egyo myaka makumi mushanju, obwo niiye mwabaire mwesiibizakwo? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.5",
            "verseOrgIds": [
              "ZEC.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.20"
              },
              "items": [
                {
                  "text": "1 Kor 11:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ku murya, mwanywa, ti mweriira mukeenywera? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.6",
            "verseOrgIds": [
              "ZEC.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.26"
              },
              "items": [
                {
                  "text": "Yer 17:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo tibyo MUKAMA yaagambire naaraba omuri baanabi aba ira, obu Yerusaalemu yaabaire ekitwirwemu, ekigogyeire kandi ekyehinguririziibwe endembo zaayo, n'ensi y'obukiizi-bwa-buryo bikitwirwemu?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.7",
            "verseOrgIds": [
              "ZEC.7.7"
            ]
          }
        }
      ]
    },
