            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA naagira ati: Nk'oku naabeetsire, bakanga kuhurira, nikwo nabo baanyetsire, nkanga kubahurira, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.13",
