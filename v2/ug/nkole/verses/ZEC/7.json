                {
                  "text": "Ezk 11:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baagangaaza emitima yaabo nk'amabaare, ngu batahurira ebiragiro bya MUKAMA ow'amahe, n'ebigambo ebi yaabatumireho Omwoyo we, naaraba omuri baanabi aba ira. Nikyo ekiniga kingi kyarugiire ahari MUKAMA ow'amahe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.12",
            "verseOrgIds": [
              "ZEC.7.12"
            ]
          }
        },
