            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba oku nikwo MUKAMA ow'amahe arikugamba naagira ati: Nk'oku naamaririire kubakora kubi, obu baashwenkuriimwe bankwatsa ekiniga, nkanga kwegarukamu, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.14",
            "verseOrgIds": [
              "ZEC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikwo n'omuri ebi biro mmaririire kukora gye Yerusaalemu n'enju ya Yuda. Mutatiina; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.15",
            "verseOrgIds": [
              "ZEC.8.15"
            ]
          }
        },
        {
