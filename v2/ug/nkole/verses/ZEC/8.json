              "items": [
                {
                  "text": "Hag 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA ow'amahe arikugamba naagira ati: Imwe abarikuhurira omu biro ebi ebigambo ebigambirwe baanabi, okwiha aha izooba eri omusingi gw'enju ya MUKAMA gwateereirweho, ngu hekalu eyombekwe, murekye kugwa emikono; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.9",
            "verseOrgIds": [
              "ZEC.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba ebyo biro bitakahikire, tihaine waabaire aheebwa ebihembo ahabwe nari ahabw'enyamaishwa ye; kandi ahabw'ababisha hakaba hatariho busingye aha muntu weena owaabaire ataaha nari owaabaire ashohora; ahabw'okuba buri muntu nkamuteerana na mugyenzi we, baayangana. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.10",
            "verseOrgIds": [
              "ZEC.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka hati tindikwija kugira aba bantu abatsigaireho, nk'oku naabagizire obunyakare; nikwo MUKAMA ow'amahe arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.11",
            "verseOrgIds": [
              "ZEC.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
