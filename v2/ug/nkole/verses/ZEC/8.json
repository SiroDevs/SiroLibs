              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi imwe nju ya Yuda n'eya Israeli 'mwe, nk'oku mwabaire muri eky'okucweraho enfumu n'eky'okukyeenwa omu mahanga, nikwo ndibajuna, mukaba ab'okuhaisa abandi omugisha. Mutatiina, kureka emikono yaanyu egume.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.13",
            "verseOrgIds": [
              "ZEC.8.13"
            ]
