                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba haryabaho okubibira omu busingye n'omu kugogyera; emizaabibu eryayera ebijuma byayo, eitaka ryeze emyaka yaaryo, n'eiguru ritoonyereze orume; kandi ndyaha abo bantu abatsigaireho ebyo bintu byona, bibe ebyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.12",
            "verseOrgIds": [
              "ZEC.8.12"
            ]
          }
        },
        {
