                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebi nibyo muraagume nimukora. Mugume mugambirane amazima, mucwere omu marembo gaanyu emanja z'oburyo, kandi ezirikureeta obusingye; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.16",
            "verseOrgIds": [
