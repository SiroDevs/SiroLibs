                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " oruganda rw'enju ya Leevi okwarwo n'abakazi baabo okwabo; oruganda rw'aba Shimei okwarwo n'abakazi baabo okwabo; ",
          "type": "text",
