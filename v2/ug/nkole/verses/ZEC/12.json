            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ensi eryacura, buri ruganda rucure okwarwo, oruganda rw'enju ya Daudi okwarwo n'abakazi baabo okwabo; oruganda rw'enju ya Nasani okwarwo, n'abakazi baabo okwabo; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
