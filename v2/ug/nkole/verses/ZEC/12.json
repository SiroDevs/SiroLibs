                "loc": "ISA.48.13"
              },
              "items": [
                {
                  "text": "48:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eki n'ekigambo kya MUKAMA ekyahanwirwe ahari Israeli. MUKAMA owaabambire eiguru, akataho emisingi y'ensi, kandi akahangira omwoyo omu muntu, naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
