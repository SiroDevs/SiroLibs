            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eryo izooba omuri Yerusaalemu haryabamu okucura kwinigi okurikwinga n'oku baacuriire Hadadi-rimoni omu ruhita rwa Megido. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
