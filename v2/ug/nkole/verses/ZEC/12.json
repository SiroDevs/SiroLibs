            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eryo izooba enganda za Yuda ndyazigira nk'orugusyo orurikubugumwaho omuriro ahagati y'enku, nari nk'enkanza erikubugumira omu biba by'engano; ziryamaraho amahanga goona agaziri aha rubaju rwa buryo n'orwa bumosho; haza obwo Yerusaalemu eryaba neekituurwamu, nk'oku yaabaire eri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.6",
            "verseOrgIds": [
              "ZEC.12.6"
            ]
          }
        }
