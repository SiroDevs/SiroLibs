        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.14",
            "verseOrgIds": [
              "ZEC.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima MUKAMA yangira ati: Garuka okwate ebintu by'omuriisa, omuriisa otaine mugasho; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.15",
            "verseOrgIds": [
              "ZEC.11.15"
            ]
          }
        },
