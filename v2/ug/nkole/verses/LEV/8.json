          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaareeta empaya y'entaama eya kabiri, empaya ey'okushoroorwa kw'abanyamurwa; Arooni n'abatabani baata engaro zaabo aha mutwe gwayo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.22",
            "verseOrgIds": [
              "LEV.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
