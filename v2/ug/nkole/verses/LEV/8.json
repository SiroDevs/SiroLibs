                "loc": "ROM.12.1"
              },
              "items": [
                {
                  "text": "Rom 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaagiita, yaatwara aha shagama yaayo, yaagita aha nshonga y'okutu kwa Arooni okwa buryo n'aha kikumu kishaija eky'engaro ya buryo, n'aha kikumu kishaija eky'ekigyere kya buryo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.23",
            "verseOrgIds": [
              "LEV.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima yaareeta batabani ba Arooni, yaata eshagama aha nshonga z'amatu gaabo aga buryo n'aha bikumu bishaija eby'engaro zaabo za buryo n'aha bikumu bishaija eby'ebigyere byabo bya buryo; Musa yaashukyera endiijo shagama yoona aha itambiro embaju zoona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.24",
            "verseOrgIds": [
              "LEV.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaatwara ebishaju byayo n'omukira gw'ebishaju n'ebishaju ebishwekire eby'omunda, n'ekishaabo ky'aha kitugu n'entsigo zombi n'ebishaju byazo n'ekivune ky'okuguru kwa buryo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.25",
            "verseOrgIds": [
              "LEV.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi omu kiibo ky'emigaati etatumbisiibwe eyaabaire etuura omu maisho ga MUKAMA, yaihamu kaakeeki kamwe akatatumbisiibwe, n'akandi akasiigirwe amajuta na capati emwe, yaabita ahari ebyo bishaju n'aha kivune ky'okuguru kwayo okwa buryo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.26",
            "verseOrgIds": [
              "LEV.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "byona yaabita aha ngaro za Arooni n'aha ngaro z'abatabani, yaabizongazonzya, byaba empongano ezongazongiibwe omu maisho ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.27",
            "verseOrgIds": [
              "LEV.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.2"
              },
              "items": [
                {
                  "text": "Efe 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Musa yaabiiha omu ngaro zaabo, yaabyokyeza aha itambiro hamwe n'ekitambo ky'okwotsya, nk'empongano y'okushoroorwa kw'abanyamurwa ey'ekisooroora kirungi; yaaba empongano eyokiibwe omu muriro ehongyeirwe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.28",
            "verseOrgIds": [
              "LEV.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Musa yaatwara enkoro, yaagizongazonzya kuba empongano ezongazongiibwe omu maisho ga MUKAMA; enkoro egyo yaaba omugabo gwa Musa ogw'ahari egyo mpaya y'okushoroorwa kw'abanyamurwa, nk'oku MUKAMA yaaragiire Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Musa yaatwara aha majuta ag'okushukaho ahabw'okushoroora n'aha shagama eyaabaire eri aha itambiro, yaabimiisiira ahari Arooni n'aha bijwaro bye n'aha batabani n'aha bijwaro byabo; atyo yaayeza Arooni n'ebijwaro bye n'abatabani n'ebijwaro byabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
