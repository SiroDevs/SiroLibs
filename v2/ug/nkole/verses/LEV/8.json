          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.1",
            "verseOrgIds": [
              "LEV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twara Arooni n'abatabani n'ebijwaro biri n'amajuta g'okushukaho ahabw'okushoroora, n'enimi y'ekimasha ey'empongano y'ekibi, n'empaya ibiri z'entaama, n'ekiibo ky'emigaati etatumbisiibwe; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.2",
            "verseOrgIds": [
              "LEV.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi oteeranire eihanga ryona aha muryango gw'Eihema ry'okubugaabuganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.3",
            "verseOrgIds": [
              "LEV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaakora nk'oku MUKAMA yaamuragiira; eihanga ryona ryateeranira aha muryango gw'Eihema ry'okubugaabuganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.4",
            "verseOrgIds": [
              "LEV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagambira eihanga ryona ati: Eki nikyo MUKAMA yaaragiira kukorwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.5",
            "verseOrgIds": [
              "LEV.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.11"
              },
              "items": [
                {
                  "text": "Isa 52:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.11"
              },
              "items": [
                {
                  "text": "1 Kor 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaareeta Arooni n'abatabani, yaaboozya n'amaizi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.6",
            "verseOrgIds": [
              "LEV.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaamujweka ekooti, yaamuzirika n'eky'okwezirikisa kiri, yaamujweka ekanzu, yaagitungikaho efodi, yaamuzirika eky'okwezirikisa kya efodi ekirukirwe abanyamwoga, yaakigimuhamisaho; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.7",
            "verseOrgIds": [
              "LEV.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.6"
              },
              "items": [
                {
                  "text": "1 Sam 28:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.2.63"
              },
              "items": [
                {
                  "text": "Ezr 2:63",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaamujweka eky'aha kifuba kiri, kandi omurikyo yaakitamu Urimu na Tumimu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.8",
            "verseOrgIds": [
              "LEV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.5"
              },
              "items": [
                {
                  "text": "Zek 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.11"
              },
              "items": [
                {
                  "text": "6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaamujweka ekikwemba aha mutwe, kandi aha kikwemba omu maisho yaataho ekipande ky'ezaabu, nikyo kirunga ekirikwera, nk'oku MUKAMA yaaragiire Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Musa yaihayo amajuta gari ag'okushukaho ahabw'okushoroora, yaagashuka aha butaaho n'ahari byona ebyabaire birimu, yaabyeza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.10",
            "verseOrgIds": [
              "LEV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagamiisiira n'aha itambiro emirundi mushanju, kandi yaagashuka ahari eryo itambiro n'ebintu byaryo byona, n'aha kinaabiro n'ekibunu kyakyo, kubyeza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.11",
            "verseOrgIds": [
              "LEV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaagashuka n'aha mutwe gwa Arooni kumweza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.12",
            "verseOrgIds": [
              "LEV.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.8+EXO.29.9+EXO.29.10+EXO.29.11+EXO.29.12+EXO.29.13+EXO.29.14+EXO.29.15+EXO.29.16+EXO.29.17+EXO.29.18+EXO.29.19+EXO.29.20+EXO.29.21+EXO.29.22+EXO.29.23+EXO.29.24+EXO.29.25+EXO.29.26+EXO.29.27+EXO.29.28+EXO.29.29+EXO.29.30+EXO.29.31+EXO.29.32+EXO.29.33+EXO.29.34+EXO.29.35"
              },
              "items": [
                {
                  "text": "Kur 29:8-35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.9"
              },
              "items": [
                {
                  "text": "Zab 132:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Musa yaareeta batabani ba Arooni, yaabajweka ekooti, yaabazirika n'eby'okwezirikisa, yaabajweka n'enkofiira, nk'oku MUKAMA yaamuragiire.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        }
      ]
