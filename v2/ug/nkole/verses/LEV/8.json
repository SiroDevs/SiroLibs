    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaareeta enimi y'ekimasha ey'empongano y'ekibi; Arooni n'abatabani baata engaro zaabo aha mutwe gw'egyo nimi y'empongano y'ekibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.14",
            "verseOrgIds": [
              "LEV.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagiita, yaatwara eshagama yaayo, yaagita aha mahembe g'eitambiro n'orukumu rwe aha nshonda zaaryo zoona, yaarishemeza, yaashuka endiijo shagama yoona ahansi aha kibunu kyaryo kuririhiirira, yaaryeza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.15",
            "verseOrgIds": [
              "LEV.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaatwara ebishaju byona ebishwekire eby'omunda, n'ekishaabo eky'aha kitugu, n'entsigo zombi n'ebishaju byazo, yaabyokyeza aha itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.16",
            "verseOrgIds": [
              "LEV.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka enimi, oruhu rwayo n'enyama zaayo n'efa yaayo, yaabyokyeza aheeru y'orusiisira nk'oku MUKAMA yaamuragiire.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaareeta empaya y'entaama kuba ekitambo ky'okwotsya; Arooni n'abatabani baata engaro zaabo aha mutwe gw'egyo mpaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.18",
            "verseOrgIds": [
              "LEV.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagiita, yaashukyera eitambiro eshagama yaayo embaju zoona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.19",
            "verseOrgIds": [
              "LEV.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaaherize kugicwagacwagura, yaayotsya omutwe gwayo n'ebicweka byayo n'ebishaju byayo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.20",
            "verseOrgIds": [
              "LEV.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaayozya eby'omunda byayo n'amaguru gaayo n'amaizi, yaayokyeza egyo mpaya yoona aha itambiro; kyaba ekitambo kyokize eky'ekisooroora kirungi, empongano eyokiibwe omu muriro, ehongyeirwe MUKAMA, nk'oku MUKAMA yaaragiire Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.21",
            "verseOrgIds": [
              "LEV.8.21"
            ]
          }
        }
      ]
    },
    {
