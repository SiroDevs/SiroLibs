              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ate engaro ze aha mutwe gwayo, agiitire omu maisho g'Eihema ry'okubugaabuganiramu; batabani ba Arooni bashukyere eitambiro eshagama yaayo embaju zoona; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.13",
