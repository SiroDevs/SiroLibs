              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "aihe ahari ekyo kitambo empongano ye eyokiibwe omu muriro ei ahongyeire MUKAMA, ebishaju ebishwekire eby'omunda, n'ebishaju byona ebibiriho, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
            "verseOrgIds": [
              "LEV.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
