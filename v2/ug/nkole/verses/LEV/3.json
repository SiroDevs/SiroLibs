          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'entsigo zombi eziri aha mugongo n'ebishaju ebiziriho, n'ekishaabo eky'aha kitugu akitwarirane n'entsigo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.15",
