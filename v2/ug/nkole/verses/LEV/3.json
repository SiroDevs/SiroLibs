          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empongano ye ey'ekitambo ky'okusiima MUKAMA ahabw'obusingye ku eriba eri ey'omu busyo bw'entaama, yaaba mpaya nari omwagazi, ahongye ekitaine kamogo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku arihayo omwana gw'entaama kuba empongano ye, aguhongye omu maisho ga MUKAMA; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ate engaro ze aha mutwe gw'empongano ye, agiitire omu maisho g'Eihema ry'okubugaabuganiramu; batabani ba Arooni bashukyere eitambiro eshagama embaju zoona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.8",
            "verseOrgIds": [
              "LEV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aihe ebishaju ahari ekyo kitambo ky'okusiima ahabw'obusingye, ekyokiibwe omu muriro, ekihongyeirwe MUKAMA, n'omukira gwona ogw'ebishaju agukuuriraine n'engugi, n'ebishaju ebishwekire eby'omunda, n'ebishaju byona ebibiriho, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'entsigo zombi eziri aha mugongo n'ebishaju byazo, n'ekishaabo eky'aha kitugu akitwarirane n'entsigo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "omunyamurwa akyokyeze aha itambiro kuba empongano y'eby'okurya eyokiibwe omu muriro ehongyeirwe MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        }
