                {
                  "text": "1 Pet 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ate engaro ze aha mutwe gw'empongano ye, agiitire aha muryango gw'Eihema ry'okubugaabuganiramu; batabani ba Arooni abanyamurwa bashukyere eitambiro eshagama embaju zoona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.2",
            "verseOrgIds": [
              "LEV.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aihe ahari ekyo kitambo ky'okusiima ahabw'obusingye empongano eyokiibwe omu muriro ehongyeirwe MUKAMA, ebishaju ebishwekire eby'omunda n'ebishaju byona ebibiriho, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.3",
            "verseOrgIds": [
              "LEV.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'entsigo zombi eziri aha mugongo n'ebishaju byazo, n'ekishaabo ky'aha kitugu, abihongye; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.4",
            "verseOrgIds": [
              "LEV.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "batabani ba Arooni bagyokyeze aha itambiro ry'okwokyezaho ebitambo aha nku eziri aha muriro; egyo n'empongano eyokiibwe omu muriro ey'ekisooroora kirungi ahari MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.5",
            "verseOrgIds": [
              "LEV.3.5"
            ]
          }
        }
      ]
    },
    {
