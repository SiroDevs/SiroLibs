        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa bwanyima y'okufa kwa batabani ba Arooni, obu bairira omu maisho ga MUKAMA, bakafa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.10+1KI.8.11+1KI.8.12"
              },
              "items": [
                {
                  "text": "1 Bag 8:10-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagira Musa ati: Gambira Arooni mukuru waawe, arekye kuguma naataaha buri kaanya Aharikwera omunda y'omukingo, omu maisho g'ekitebe ky'okusaasira, ekiri aha mutwe gw'eshanduukye, atakaafa; ahabw'okuba niinyija kweyorekyera omu kicu aha kitebe ky'okusaasira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.2",
            "verseOrgIds": [
              "LEV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka oku nikwo Arooni araagume naatwaza, yaaba naija Aharikwera, aijane enimi y'ekimasha kuba empongano y'ekibi, kandi n'empaya y'entaama y'ekitambo ky'okwotsya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.3",
            "verseOrgIds": [
              "LEV.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.22"
              },
              "items": [
                {
                  "text": "Heb 10:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ajware ekooti erikwera ya bafuta, n'empare ya bafuta, bibanze aha mubiri, ayezirikise orukoba rwa bafuta, ajware n'ekikwemba kya bafuta; ebyo nibyo bijwaro ebirikwera. Abanze ayogye, bwanyima abijware. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.4",
            "verseOrgIds": [
              "LEV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aihe omu Baisraeli empaya ibiri z'embuzi kuba empongano y'ekibi, kandi n'empaya y'entaama kuba ekitambo ky'okwotsya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.5",
            "verseOrgIds": [
              "LEV.16.5"
            ]
          }
        }
      ]
    },
