                {
                  "text": "Heb 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima aite egyo mbuzi y'empongano y'ekibi ey'okuhongyerera abantu, areete eshagama yaayo omunda y'omukingo, agitwaze nk'oku yaatwaza ey'enimi, agimiisiire aha kitebe ky'okusaasira n'omu maisho gaakyo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.15",
            "verseOrgIds": [
              "LEV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "arihiirire atyo Aharikwera ahabw'okusiisikara kw'Abaisraeli, kandi n'ahabw'eby'okushiisha byabo, n'ebibi byabo byona; kandi abe nikwo yaatwaza Eihema ry'okubugaabuganiramu, eri batuura naryo omu kusiisikara kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.16",
            "verseOrgIds": [
              "LEV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.10"
              },
              "items": [
                {
                  "text": "Luk 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hatarigira owaaguma omu Ihema ry'okubugaabuganiramu, Arooni yaaba naataaha Aharikwera kukora eby'okurihiirira, okuhitsya obu araarugyemu, yaaheza kwerihiirira we n'eka ye n'eihanga rya Israeli ryona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.17",
            "verseOrgIds": [
              "LEV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ashohore aze aha itambiro eriri omu maisho ga MUKAMA, aririhiirire, kandi atware aha shagama y'egyo nimi n'ey'egyo mbuzi, agite aha mahembe g'eitambiro aha nshonda zoona; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.20"
              },
              "items": [
                {
                  "text": "Ezk 43:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " akore ahari egyo shagama, agimiisiire aha itambiro n'orukumu rwe emirundi mushanju, arishemeze, aryeze, rirugweho okusiisikara kw'Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        }
      ]
