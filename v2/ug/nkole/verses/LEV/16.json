              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arooni ahongye egyo nimi kuba empongano ye ey'ekibi, ayerihiirire we n'eka ye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.6",
            "verseOrgIds": [
              "LEV.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima atware ezo mbuzi zombi, azite omu maisho ga MUKAMA aha muryango g'Eihema ry'okubugaabuganiramu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni ateerere ezo mbuzi zombi enteenyu, emwe ahabwa MUKAMA, n'endi ahabwa Azazeeli. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni areete egyo mbuzi eyaakwatwa enteenyu ya MUKAMA, agitambe ebe empongano y'ekibi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.21"
              },
              "items": [
                {
                  "text": "2 Kor 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka embuzi eyaakwatwa enteenyu eya Azazeeli emurikwe omu maisho ga MUKAMA ehuriire, bagikorereho eby'okurihiirira ebibi, bagyohereze omu ihamba ahabwa Azazeeli. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Arooni amurikye egyo nimi kuba empongano ye y'ekibi, ayerihiirire we n'eka ye; aite egyo nimi ei yaayetambirira kuba empongano y'ekibi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.11",
            "verseOrgIds": [
              "LEV.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.3"
              },
              "items": [
                {
                  "text": "Kush 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " areete ekyoterero ekiijwire amakara garikwaka, agu yaiha aha itambiro omu maisho ga MUKAMA, kandi n'empi ibiri z'obubaane bushekwire oburikutaamirana, akitware omunda y'omukingo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "abute aha muriro omu maisho ga MUKAMA, omwika gw'obubaane gushwekye ekitebe ky'okusaasira ekiri aha Birikuhamya, ngu atafa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi atware aha shagama y'egyo nimi, agimiisiire n'orukumu rwe aha rubaju rw'ekitebe ky'okusaasira orurikureeba omumaisho, kandi agimiisiire omu maisho g'ekitebe ky'okusaasira emirundi mushanju.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.14",
            "verseOrgIds": [
              "LEV.16.14"
            ]
          }
        }
      ]
    },
