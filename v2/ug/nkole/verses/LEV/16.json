                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekyo kigume kiri ekiragiro ekibateereirweho ekitahwaho; omu kwezi kwa mushanju aha kiro kya ikumi eky'okwo kwezi, muryaguma mwebonabonese, mutarikikoreraho omurimo gwona, n'obu yaakuba omuntu enzaarwa, nari omunyaihanga oshuhuukiire omuriimwe; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba aha kiro ekyo nikyo muriguma nimurihiiririrwaho kushemezibwa; obwo muryaba abashemeziibweho ebibi byanyu byona omu maisho ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizooba eryo riryababeera sabato ey'okuruhuukiraho, muryayebonabonesa; n'ekiragiro ekitairweho okuhitsya ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omunyamurwa oriba waashukirweho amajuta, akashoroorwa kuba omunyamurwa omu mwanya gwa ishe, niwe ariguma naabarihiirira, ajwaire ebyo bijwaro birikwera bya bafuta; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi arihiirire Omwanya ogurikwera, arihiirire Eihema ry'okubugaabuganiramu n'eitambiro; kandi arihiirire abanyamurwa n'abantu b'eihanga boona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
