          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni ku araaheze kurihiirira Aharikwera n'Eihema ry'okubugaabuganiramu n'eitambiro, areete egyo mbuzi ehuriire; ",
          "type": "text",
          "attrs": {
