        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku murihika omu nsi egyo, mwabyara emiti y'emiringo yoona ahabw'ebyokurya, mubanze mutwaze ebijuma byayo nk'ebitarikwikirizibwa kuriibwa; muryamara emyaka eshatu mutarikubiikirizibwa; bitaririibwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.23",
            "verseOrgIds": [
              "LEV.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omu mwaka gwa kana ebijuma byayo byona biryaba ebirikwera, empongano y'okuhimbisa MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.24",
            "verseOrgIds": [
              "LEV.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omu mwaka gwa kataano muryaikirizibwa kurya aha bijuma byayo, egyo miti ebone kuguma neebeerera munonga. Niinye MUKAMA Ruhanga waanyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.25",
            "verseOrgIds": [
              "LEV.19.25"
            ]
          }
        }
      ]
    },
