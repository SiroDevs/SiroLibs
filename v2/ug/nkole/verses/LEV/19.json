              "items": [
                {
                  "text": "Rus 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku murishaaruura emyaka y'omu nsi yaanyu, mutarishaaruurira kimwe n'ey'aha mbibi, n'obu kwakuba okuhumba ebitsigairemu bwanyima y'okugyesha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.9",
            "verseOrgIds": [
              "LEV.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.5.8"
              },
              "items": [
                {
                  "text": "Mub 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otarishoroma emizaabibu yaawe okagiherezamu kimwe, n'obu kwakuba okutorotoora eragarikire; ogitsigire enshoberwa n'omushuhuuki. Niinye MUKAMA Ruhanga waanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.10",
            "verseOrgIds": [
              "LEV.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.25"
              },
              "items": [
                {
                  "text": "Efe 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutariiba, mutarigobya, kandi mutaribeihana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutarirahirira busha eiziina ryangye, mukajumisa eiziina rya Ruhanga waanyu. Niinye MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.12",
            "verseOrgIds": [
              "LEV.19.12"
            ]
          }
        }
      ]
    },
