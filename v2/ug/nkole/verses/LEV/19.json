        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.1",
            "verseOrgIds": [
              "LEV.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.7"
              },
              "items": [
                {
                  "text": "1 Tes 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gambira eihanga ry'Abaisraeli ryona ebi ndikugamba ningira nti: Mushemereire kuba abarikwera; ahakuba Nyowe MUKAMA Ruhanga waanyu ndi orikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.2",
            "verseOrgIds": [
              "LEV.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.15+NEH.13.16+NEH.13.17+NEH.13.18+NEH.13.19+NEH.13.20+NEH.13.21"
              },
              "items": [
                {
                  "text": "Neh 13:15-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu weena omuriimwe ashemereire kutiina nyina na ishe; kandi mugume murinde sabato zangye. Niinye MUKAMA Ruhanga waanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.3",
            "verseOrgIds": [
              "LEV.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.14"
              },
              "items": [
                {
                  "text": "1 Kor 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutarihindukira ebishushani ebirikuramibwa, n'obu kwakuba okweheeshera baaruhanga b'ebishushani. Niinye MUKAMA Ruhanga waanyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.4",
            "verseOrgIds": [
              "LEV.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.4",
            "verseOrgIds": [
              "LEV.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku muritambira MUKAMA ebitambo by'empongano y'okusiima ahabw'obusingye, muryaguma mubihongye omu buryo obu murikubaasa kwikiririzibwamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.5",
            "verseOrgIds": [
              "LEV.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kitambo kiriibwe aha izooba eri murikihongyeraho, n'eririkurataho; ekiriba kyatsigaireho okuhitsya aha izooba rya kashatu, kyokibwe omu muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.6",
            "verseOrgIds": [
              "LEV.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku kiririibwaho aha izooba rya kashatu, kiryaba ekirikunugwa; tikiriikirizibwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.7",
            "verseOrgIds": [
              "LEV.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi omuntu weena orikiryaho, orubanja rw'okutahikiirira ruryamugumaho, ahabw'okuba aryaba asiisire ekintu kya MUKAMA ekirikwera; ogwo muntu aryacuubwa omu ihanga rye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.8",
            "verseOrgIds": [
              "LEV.19.8"
            ]
          }
        }
      ]
    },
