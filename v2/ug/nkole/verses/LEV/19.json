        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugume mworobere ebiragiro byangye. Otaryemesa amatungo gaawe aha nyamaishwa ezitari z'oruganda rwago; otaribiba omu musiri gwawe embibo z'emiringo ebiri; kandi otarijwara ekijwaro kibaziire omu myenda y'emiringo ebiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ku aribyama n'omuzaana, orikugambwa ondiijo mushaija obugyenyi, omuzaana ogwo atakacungwirwe nari atakarekwirwe, ebyabo biryayetegyerezibwa, kwonka tibariitwa, ahabw'okuba omukazi abaire atakarekwirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.20",
            "verseOrgIds": [
              "LEV.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ogwo mushaija areetere MUKAMA empongano y'okwihaho orubanja aha muryango gw'Eihema ry'okubugaabuganiramu, empaya y'entaama kuba empongano y'okwihaho orubanja; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.21",
            "verseOrgIds": [
              "LEV.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "omunyamurwa amurihiirire omu maisho ga MUKAMA empaya y'entaama kuba empongano y'okwihaho orubanja rw'ekibi eki akozire, nawe aryasaasirwa ekyo kibi ki akozire.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        }
      ]
    },
    {
