          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugume murinde sabato zangye, muhe ekitiinisa Omwanya gwangye ogurikwera. Niinye MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
