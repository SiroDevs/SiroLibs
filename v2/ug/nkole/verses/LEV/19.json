              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otarishiisha muhara waawe, okamuhindura maraaya, ensi erekye kwohokyera omu bushambani, ekaijura obubi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.29",
            "verseOrgIds": [
              "LEV.19.29"
            ]
