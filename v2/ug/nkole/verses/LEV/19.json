              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutarikora ebitari by'oburyo omu kucwa emanja, omu kugyera oburaingwa, nari oburemeezi, nari obwingi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
