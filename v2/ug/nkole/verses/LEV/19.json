                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutarishara emibiri yaanyu ahabw'okuba omu rufu, kandi mutaricwa engondo. Niinye MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.28",
            "verseOrgIds": [
              "LEV.19.28"
