                  "text": "Yak 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otarikora ebitari by'oburyo omu kucwa emanja; otarigwera orubaju rw'omworo, n'obu kwakuba okweta aha kitiinisa ky'omukuru; kureka ocwere mutaahi waawe orubanja rw'oburyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.15",
            "verseOrgIds": [
              "LEV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otarigyendagyenda noogambuura abantu omu bantu b'owaanyu; kandi otariba mushinja w'ebishuba kwitisa mutaahi waawe. Niinye MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        }
      ]
