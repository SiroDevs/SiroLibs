            "number": "18",
            "style": "v",
            "sid": "LEV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otarihoora abantu b'eihanga ryawe, n'obu kwakuba okubagiraho enziika; kureka okunde mutaahi waawe, nk'oku oyekunda. Niinye MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
