              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyaihanga ku arishuhuukira owaanyu omu nsi yaanyu, otarimwita kubi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.33",
