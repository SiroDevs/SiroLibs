          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebirikugyendera ahansi byona, yaaba ebirikugyendesa enda, yaaba eby'amaguru ana, nari eby'amaguru maingi, mutaribirya; ahakuba n'ebirikunugwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.42",
            "verseOrgIds": [
              "LEV.11.42"
            ]
          }
        },
        {
          "name": "verse",
