          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaryehindura abarikunugwa ahabw'ekintu kyona ekirikugyendera ahansi, kandi mutaribyesiisisa, bikabashiisha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.43",
            "verseOrgIds": [
              "LEV.11.43"
            ]
          }
        },
