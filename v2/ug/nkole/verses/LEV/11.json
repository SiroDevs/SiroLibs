          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekirikugyendera ahansi kyona, n'ekirikunugwa; kitaririibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.41",
            "verseOrgIds": [
              "LEV.11.41"
            ]
          }
