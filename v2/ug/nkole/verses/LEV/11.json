            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi orirya aha mutumbi gwayo, aryayozya ebijwaro bye, agume ari osiisikaire okuhitsya omu mwabazyo; kandi n'oryekorera omutumbi gwayo, aryayozya ebijwaro bye, agume ari osiisikaire okuhitsya omu mwabazyo.",
          "type": "text",
