              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa na Arooni, naabagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.1",
            "verseOrgIds": [
              "LEV.11.1"
            ]
          }
        },
        {
