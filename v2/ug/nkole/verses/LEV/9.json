          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.3"
              },
              "items": [
                {
                  "text": "1 Kor 15:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaareeta empongano z'abantu, yaatwara embuzi y'empongano y'ekibi kyabo, yaagiita, yaagihongyerera ekibi, nk'empongano y'ekibi ey'okubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.15",
            "verseOrgIds": [
              "LEV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima yaareeta ekitambo ky'okwotsya, yaakihonga nk'oku omugyenzo gwakyo guri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.16",
            "verseOrgIds": [
              "LEV.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaareeta empongano y'esaano, yaagiihaho oruhi rwijwire, yaagyokyeza aha itambiro, naagyongyera aha kitambo ky'okwotsya eky'omu kasheeshe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.17",
            "verseOrgIds": [
              "LEV.9.17"
            ]
          }
        }
      ]
    },
