              "items": [
                {
                  "text": "Luk 24:50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Arooni yaimutsya emikono ye aha bantu, yaabashabira omugisha, yaaruga aha itambiro ahu yaabaire naatambira empongano y'ekibi n'ekitambo kyokize n'empongano z'okusiima ahabw'obusingye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Arooni baataaha omu Ihema ry'okubugaabuganiramu; ku baashohoire, baashabira abantu omugisha; ekitiinisa kya MUKAMA kyabonekyera abantu boona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
        },
        {
