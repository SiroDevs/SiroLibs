          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaita n'egyo nimi n'empaya y'entaama eby'okutambirira abantu kuba empongano zaabo ez'okusiima ahabw'obusingye; abatabani baamureetera eshagama yaabyo, yaagishukyera eitambiro embaju zoona, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.18",
            "verseOrgIds": [
              "LEV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'ebishaju by'enimi n'eby'empaya, n'omukira gw'ebishaju, n'ebishaju ebishwekire eby'omunda, n'entsigo zombi, n'ekishaabo ky'aha kitugu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "baata ebyo bishaju aha nkoro zaazo, yaabyokyeza aha itambiro; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka enkoro zaazo n'ekivune ky'okuguru kwa buryo Arooni yaabizongazonzya kuba empongano ezongazongiibwe omu maisho ga MUKAMA, nk'oku Musa yaaragiire.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        }
      ]
    },
