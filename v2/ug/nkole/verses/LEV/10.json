              "LEV.10.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.9"
              },
              "items": [
                {
                  "text": "Kur 30:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Nadabu na Abihu batabani ba Arooni baatwara buri omwe ekyoterero kye, baabitamu omuriro, baagushukaho obubaane, baabwoterera omu maisho ga MUKAMA n'omuriro ogundi ogu atarabaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.1",
            "verseOrgIds": [
              "LEV.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.35"
              },
              "items": [
                {
                  "text": "Kub 16:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho omuriro gwaruga ahari MUKAMA, gwabootsya, baafeera omu maisho ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.22"
              },
              "items": [
                {
                  "text": "Ezk 28:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaagira Arooni ati: Eki nikyo MUKAMA yaagambire ati: Ndyayeyoreka ku ndi Orikwera omu barikuunyirira haihi, kandi ndyaheebwa ekitiinisa omu maisho g'aba bantu boona. Arooni yaahunama. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.6"
              },
              "items": [
                {
                  "text": "Byak 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaayeta Mishaeli na Elizafani, batabani ba Uzieli, ishento wa Arooni, yaabagira ati: Mwirire haihi, mwihe beene waanyu omu maisho g'Omwanya ogurikwera, mubatware aheeru y'orusiisira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.4",
            "verseOrgIds": [
              "LEV.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bairira haihi, baabatwara bajwaire ekooti zaabo, baabaiha omu rusiisira, nk'oku Musa yaaragiira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.5",
            "verseOrgIds": [
              "LEV.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.6"
              },
              "items": [
                {
                  "text": "Kub 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaagambira Arooni n'abatabani, Eleazaari na Itamaari ati: Mutazingurura eishokye, n'obu kwakuba okutaagura emyenda yaanyu, mukafa, kandi ekiniga kya MUKAMA kikajuumikira eihanga ryona; kwonka murekye beene waanyu ab'enju ya Israeli boona bacure ahabw'abookiibwe omuriro ogu MUKAMA areetsire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mutaruga omu muryango gw'Eihema ry'okubugaabuganiramu, mukafa, ahabw'okuba amajuta ga MUKAMA agu mushukirweho gabariho. Baakora nk'oku Musa yaabaragiira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Arooni ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.8",
            "verseOrgIds": [
              "LEV.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.27.7"
              },
              "items": [
                {
                  "text": "Isa 27:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.18"
              },
              "items": [
                {
                  "text": "Efe 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutarinywa viinyo nari eky'okunywa eky'amaani, iwe na batabani baawe mwaba nimutaaha omu Ihema ry'okubugaabuganiramu, mutakaafa; ekyo n'ekiragiro ky'ebiro byona omu busingye bwanyu bwona, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.9",
            "verseOrgIds": [
              "LEV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.22.26"
              },
              "items": [
                {
                  "text": "Ezk 22:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.23"
              },
              "items": [
                {
                  "text": "44:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mubone kutaanisa ebirikwera n'ebitarikwera, kandi ebirikuzira n'ebitarikuzira, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.10",
            "verseOrgIds": [
              "LEV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okwegyesa Abaisraeli ebiragiro byona, ebi MUKAMA yaabagambiire naaraba omuri Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.11",
            "verseOrgIds": [
              "LEV.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.11",
            "verseOrgIds": [
              "LEV.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagambira Arooni n'abatabani, abaatsigaireho, Eleazaari na Itamaari, naagira ati: Mutware empongano y'esaano etsigaire aha mpongano ezihongyeirwe MUKAMA ezookiibwe omu muriro, mugiriire aha rubaju rw'eitambiro etatumbisiibwe; ahakuba n'erikwera munonga; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.12",
            "verseOrgIds": [
              "LEV.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mugiriire omu mwanya gurikwera, ahakuba n'omugabo gwawe na batabani baawe, ogu mushemereire kuheebwa aha mpongano ezihongyeirwe MUKAMA ezookiibwe omu muriro, ahakuba okwo nikwo naaragiirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.13",
            "verseOrgIds": [
              "LEV.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka enkoro ezongazongiibwe n'ekivune ky'okuguru ekiihirweho mubiriire omu mwanya gwona ogushemeire, iwe na batabani baawe na bahara baawe, ahakuba n'omugabo gwawe ogu origuma nooheebwa na batabani baawe aha bitambo by'empongano z'Abaisraeli z'okusiima ahabw'obusingye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.14",
            "verseOrgIds": [
              "LEV.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekivune ky'okuguru ekiihirweho n'enkoro ezongazongiibwe baryaguma nibabireeta hamwe n'empongano z'ebishaju ez'okwokibwa omu muriro, babizongazongyeze omu maisho ga MUKAMA kuba empongano ezongazongiibwe; bibe ebyawe na batabani baawe kuba omugabo gwanyu ogw'ebiro byona, nk'oku MUKAMA yaaragiire.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaayezirika munonga kusherura embuzi y'empongano y'ekibi, yaashanga bagyokyeize kimwe; yaagwerwa kubi Eleazaari na Itamaari, batabani ba Arooni abaatsigaireho, yaababuuza ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.16",
            "verseOrgIds": [
              "LEV.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'enki ekyabazibira kuriira empongano y'ekibi omu mwanya gw'Aharikwera, haza eri erikwera munonga; kandi mugihairwe ngu mubone kutwara okutahikiirira kw'eihanga okuririhiirira omu maisho ga mukama? ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reeba eshagama yaayo tereetsirwe mu mwanya gw'Aharikwera; buzimazima mukaabaire mugiriiriire omu mwanya gw'Aharikwera nk'oku naaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.18",
            "verseOrgIds": [
              "LEV.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni yaagarukamu Musa ati: Reeba eri izooba baaheza kutamba empongano yaabo ey'ekibi n'ekitambo kyabo ekyokiibwe omu maisho ga MUKAMA; ebintu ebirikushusha biti byambaho! Mbwenu shi, kuri naarya empongano y'ekibi eri izooba, kikaabaire kirungi omu maisho ga MUKAMA? ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ku yaakihuriire, yaaguubwa gye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.20",
            "verseOrgIds": [
              "LEV.10.20"
            ]
          }
        }
      ]
    }
  ],
