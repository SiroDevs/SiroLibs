        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.1",
            "verseOrgIds": [
              "LEV.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ragiira Abaisraeli bakureetere amajuta marungi g'emizeituuni eshekwirwe ag'okuhemba, amatabaaza gabone kuguma nigaaka obutoosha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.2",
            "verseOrgIds": [
              "LEV.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyima y'omukingo ogurikukingira Ebirikuhamya, omu Ihema ry'okubugaabuganiramu, Arooni abe niho yaaguma naagashemereza obutoosha, gabone kuguma nigaakira omu maisho ga MUKAMA okuruga omu mwabazyo okuhitsya omu kasheeshe. Ekyo kibe ekiragiro ekitarihwaho omu busingye bwanyu bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.3",
            "verseOrgIds": [
              "LEV.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni agume ashemereze ago matabaaza aha kikondo kyago eky'ezaabu eshemeziibwe, gaakire omu maisho ga MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
              "LEV.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
              "LEV.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
