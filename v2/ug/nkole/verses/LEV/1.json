            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akeeta Musa, yaagambira nawe omu Ihema ry'okubugaabuganiramu, naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.1",
            "verseOrgIds": [
              "LEV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gambira Abaisraeli, obagire oti: Omuntu weena omuriimwe ku ariba naareetera MUKAMA ekitambo, muryaguma muhongye ekirugire omu masyo g'ente nari ag'entaama.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
