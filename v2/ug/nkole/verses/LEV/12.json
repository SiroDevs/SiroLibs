        },
        {
          "text": "MUKAMA yaagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.1",
            "verseOrgIds": [
              "LEV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
