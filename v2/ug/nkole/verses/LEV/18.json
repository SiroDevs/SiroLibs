                  "text": "Isa 24:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ensi yaabo ekasiisikara; nikyo ndikugitura ahabw'okutahikiirira kwayo, ekatanaka abagitwiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.25",
