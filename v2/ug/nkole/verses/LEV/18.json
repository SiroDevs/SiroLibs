            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutarigira eki mwayesiisisa ahari ebyo byona; ahakuba ebi nibyo amahanga gu ndikubinga omu maisho gaanyu gaayesiisiise, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.24",
            "verseOrgIds": [
