          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo nikyo kiragiro ky'ekitambo eky'okwotsya, n'eky'empongano y'esaano, n'eky'empongano y'ekibi, n'eky'empongano y'okwihaho orubanja, n'eky'okushoroora, n'eky'ekitambo ky'okusiima ahabw'obusingye, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebi MUKAMA yaaragiriire Musa aha rushozi Sinai, aha izooba eri yaaragiriireho Abaisraeli kureetera MUKAMA empongano zaabo omu ihamba rya Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
