              "attrs": {
                "loc": "HEB.7.18+HEB.7.19+HEB.7.20+HEB.7.21+HEB.7.22+HEB.7.23+HEB.7.24+HEB.7.25+HEB.7.26+HEB.7.27+HEB.7.28"
              },
              "items": [
                {
                  "text": "Heb 7:18-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ogwo mugabo MUKAMA akaragiira Abaisraeli kuguma nibagubaha, yaakiragiira aha izooba eri yaabashukiireho amajuta kubashoroora. Ekyo kyaba ekiragiro ekitarihwaho omu busingye bwabo bwona.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        }
