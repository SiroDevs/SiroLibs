            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eihanga ryona ery'Abaisraeli ku ririba niryo rikozire ekibi aha bi MUKAMA yaazibiire, ritakikozire nkana, haza kyasherekwa omutwe gw'abantu abateeraine, eihanga ryagiibwaho orubanja, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.13",
            "verseOrgIds": [
              "LEV.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima ekibi eki bakozire kyamanywa, eihanga ryona rihongye enimi y'ekimasha kuba empongano y'ekibi, bagireete omu maisho g'Eihema ry'okubugaabuganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.14",
            "verseOrgIds": [
              "LEV.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
