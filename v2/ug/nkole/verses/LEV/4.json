              "items": [
                {
                  "text": "Isa 53:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abakuru b'eihanga bate engaro zaabo aha mutwe gw'egyo nimi omu maisho ga MUKAMA, kandi eitirwe omu maisho ge; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.15",
            "verseOrgIds": [
              "LEV.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
