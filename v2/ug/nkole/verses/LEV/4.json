          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ebishaju byayo byona abiiheho, abyokyeze aha itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.19",
            "verseOrgIds": [
              "LEV.4.19"
            ]
          }
        },
