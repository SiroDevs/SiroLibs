              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " omunyamurwa owaashukirweho amajuta areete aha shagama y'egyo nimi omu Ihema ry'okubugaabuganiramu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.16",
            "verseOrgIds": [
              "LEV.4.16"
            ]
          }
        },
        {
