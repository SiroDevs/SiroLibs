          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "agikozemu orukumu, agimiisiire emirundi mushanju omu maisho ga MUKAMA omu maisho g'ogwo mukingo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.17",
            "verseOrgIds": [
              "LEV.4.17"
            ]
          }
        },
        {
