              "type": "text"
            }
          ]
        },
        {
          "text": " kinukio nepepe kaŋes kaibatis, kaŋin da aponi kitajarun nepepe kaŋes, kanuka aiyuun aswam naka Edeke lokitajaruni ŋes kokatwak, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.12",
