                  "text": "Any 30:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiladaa ŋesi etogo kere kesabu, aitodol neadaunor etogo kere: kiladaa etem da kere lokejai toma aibois neinerenenere akiro kesabu,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
