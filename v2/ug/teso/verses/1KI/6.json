                  "text": "Bur 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koduk ŋes ikubitin akaisaarei to ketogo kabaoi nuka eres anyoun kokwap aitodol arwatatin: kodukok kes toma, araun neinerenenere akirot, araun aibois nakalaunan noi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etogo da, ŋes eyekalu, koinaren neinerenenere akirot kerai aojauke ikubitin akaisaoijon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.17",
            "verseOrgIds": [
              "1KI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kejaas akito nuka eres toma togo, nuigiritai kaputosia nuka ituol ka atur nuelakara: kere keraas eres; mam amor ketakanete. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.18",
            "verseOrgIds": [
              "1KI.6.18"
            ]
          }
        },
        {
