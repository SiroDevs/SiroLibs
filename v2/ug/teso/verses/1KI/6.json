              "type": "text"
            }
          ]
        },
        {
          "text": "Kosipokinai apetetait naka etogo loka EJAKAIT kokaru lokiwononet, kolap Sibo ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
