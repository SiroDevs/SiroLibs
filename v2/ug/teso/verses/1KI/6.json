            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abebenok adiopet naka ekerubi ikubitin ikany, abebenok ace naka ekerubi ikubitin ikany: anyoun kosane loka abebenok adiopet kiton osaŋe loka abebenok ace keiaas ikubitin itomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekerubi ece da ikubitin itomon: ikerubin kere keraas luka aitemis adiopet ka aput adiopet. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amukurur naka ekerubi ediopet ikubitin itomon, kwape kwaŋin da ekerubi ece. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
