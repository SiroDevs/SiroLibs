              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswamau ikerubin iarei luka akito nuka eseitun toma aibois neinerenenere akirot, ŋinidiopet ikubitin itomon amukurur. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
