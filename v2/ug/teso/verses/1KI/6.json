          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigirak ikerubin ka idukudukun ka atur nuelakara: kiladaa kes kesabu neigiritai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        },
