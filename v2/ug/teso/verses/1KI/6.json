          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu akirot naka EJAKAIT mama ejai Solomon ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuka etogo lo loiduki ijo, arai ilosenenei kokisilaka kitodoli itubesiaka, koricenenei aicorakinetaka kere alosenen kakes; ŋes konyet etieasia akakirot kamakon, naabu kalimok papakon Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        },
