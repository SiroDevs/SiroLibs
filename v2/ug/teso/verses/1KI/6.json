          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koduk alaro nakotoma kikokoron iuni luka amor nuekee, ka ekokoro loka abaoi nuka eres.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
