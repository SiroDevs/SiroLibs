          ]
        },
        {
          "text": "Kiswamak da neelomanarere oyekalu ategerio nuka akito nuka eseitun, idiopet kooŋon yenika arwatat; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
