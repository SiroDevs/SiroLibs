              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koduk Solomon kwanm etogo, kodau. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koduk arwatatin nukotoma nuka etogo kabaoi nuka eres: anyoun kokwap ketogo aitodol arwatatin nukokuju, korapia kes toma kakito: korapia kwap ketogo kabaoi nuka eberos, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        },
