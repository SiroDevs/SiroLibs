                "loc": "1KI.8.6+1KI.8.7+1KI.8.8+1KI.8.9+1KI.8.10"
              },
              "items": [
                {
                  "text": "1 Ika 8:6-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitemok aibois neinerenenere akirot kokidin togo toma, asipokin asaduku naka aitutuket naka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toma aibois nainerenenere akirot kejai apak aojauke ikubitin akaisaarei, alalauke ikubitin akaisaarei, amukururuke ikubitin akaisaarei; kiladaa kesabu kaloelai: korapia etem kakito nuka eres. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiladaa Solomon etogo kotoma kesabu kaloelai: kitotor irikoi luka esabu koiŋaren kaibois neinerenenere akirot; kiladaa kesabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.21",
            "verseOrgIds": [
              "1KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
          },
          "items": [
