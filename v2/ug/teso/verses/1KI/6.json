            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka ikirigin iarei luka akito nuka eberos; asukonokinos atutubeta aarei nuka ekirigi ediopet, asukonokinos da atutubeta aarei nuka ekirigi ece. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
