            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Neelomarere aibois neinerenenere akirot kiswamau ikirigin luka akito nuka eseitun: acunetait ka ategerio keraas idiopet kokany yenika arwatat, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
