              "items": [
                {
                  "text": "Awa 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Yesebel aijukar ekiyakia neejai Eliya ebe, “Keswama kis idekesio eoŋ kwaŋin, ka adepar da, arai mam moi esawa kwape kalo eoŋ etusubit akoniijar bala aijar naka ediopet kakesi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.2",
            "verseOrgIds": [
              "1KI.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepupu ŋun, konyou, kolot kanuka akeiiar, kobu Beer-seba, loerai loka Yuda, kitasal ekekejaanakinan kaŋ ina.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.3",
            "verseOrgIds": [
              "1KI.19.3"
            ]
          }
        }
      ]
    },
