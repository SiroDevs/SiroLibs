                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Napelosi, kiriamakinos kenaruny korot, koar eŋatuny ŋes, kocakak akekuan orot, kobwo asigiria die kaŋes; kobwo da eŋatuny die kakekuan, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.24",
            "verseOrgIds": [
              "1KI.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido koany, kitoroto ituŋa, koanyutu akuan korot, eŋatuny da ebwoi die kates; kopotu, koyaut akiro ore neeboieneno enabi ŋol lomoion.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        }
