              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema ŋes atiar, “Eoŋ da enabi kwape kajo; abu emalaika kalimok eoŋ kakirot naka EJAKAIT ebe, ‘Kinyaku ŋes togokon, konyam atap, komat akipi.’’’ Konye abu kinalai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.18",
            "verseOrgIds": [
              "1KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaŋin kobono kaŋes, konyam atap kotogoke, komat akipi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        }
      ]
