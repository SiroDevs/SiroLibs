                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitarau ekabaka epuesa asubit bala amor koYerusalem, kitarau iresia asubit bala ikito luka esukumor luejaas apuutona, kanuka aipues. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
