              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido erioŋet loka ameerin nuka Kiram, lokeyauni esabu kOpir, koyau kOpir ikito lukajokak luipu noi noi ka amor nuka akais nuipu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.11",
            "verseOrgIds": [
              "1KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.11"
              },
              "items": [
                {
                  "text": "2 Siit 9:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitarau ekabaka ikito lukajokak ipirin luka etogo loka EJAKAIT ka luka etogo loka ekabaka da, adeudeun da ka isabulin luka ikayook: mam eyauna bobo ikito lukajokak lueputos kanul, kwabo mam etakanuna, kiton lolo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        }
      ]
