            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kejai ekabaka erioŋet loka Tarusis aŋolol ncpepe kerionet loka Kiram: abu erioŋet loka Tarusis kobunenenei atipet ŋulukar iuni, ayaun esa bu, ka epuesa, ka ikela luka etom, ka ieomion, ka akweny nukejaas ikorio lukiiesesinei kaluipu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.22",
            "verseOrgIds": [
              "1KI.10.22"
            ]
          }
        }
