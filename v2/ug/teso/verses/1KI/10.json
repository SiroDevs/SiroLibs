          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaniru naka esabu loainunitai Solomon kokaru ediopet kerai atalatan akwat akanykape ka akaisakanykape ka nukanykape nuka esabu. ",
          "type": "text",
          "attrs": {
