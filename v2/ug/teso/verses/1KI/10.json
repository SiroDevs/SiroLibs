            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ayaunio ibalasin lukejaas kaSolomon koMisirij kodumut ikagwelanarak luka ekabaka kes kosipanin, nolisipan kotiaike. ",
          "type": "text",
          "attrs": {
