            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotukonok Solomon agalin ka ikebwanenok: kejaas ŋes agalin alukumit ka akwat aoŋon, ka ikebwanenok ilukumin itomon ka luarei, lukibwaikinit oreria luka agalin, ka Yerusalem da nekejai ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
