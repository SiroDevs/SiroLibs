              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaŋin kiteleka ekabaka Solomon ikabakan kere luka akwap kabar ka acoa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
