          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komoata lukakwap kere aanyun Solomon, akiirar acoake, nakibwaikinit Edeke otauke. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
