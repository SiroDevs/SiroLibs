                {
                  "text": "Pil 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kimarakinai imakio lueyaito ejok araut luibusakinito ayoŋio irwan aarei, ido aitelekarit luitaaritos kotoma akirot ka aisisianakin da; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.17",
            "verseOrgIds": [
              "1TI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
