              "1TI.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.32"
              },
              "items": [
                {
                  "text": "Leb 19:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikitoron ekimat, konye kicorenenei kwape papakon; ikatumunak kwape iinacan, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.1",
            "verseOrgIds": [
              "1TI.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "amakio kwape nukatoto, akatumunak da kwape ainacan, kotoma asegara kere,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.2",
            "verseOrgIds": [
              "1TI.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.2",
            "verseOrgIds": [
              "1TI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyoŋit apuserun nueraas apuserun cut. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.3",
            "verseOrgIds": [
              "1TI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye apuserut arai ejaas kidwe arai itatai, kisiaunete aisisia ayoŋit Edeke kokaliakec, ka atacakin ikauriakakec; naarai ecamunitai ŋin kakonyen nuka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.4",
            "verseOrgIds": [
              "1TI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.49.11"
              },
              "items": [
                {
                  "text": "Yer 49:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.37"
              },
              "items": [
                {
                  "text": "Luk 2:37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.7"
              },
              "items": [
                {
                  "text": "18:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ŋin naerai apuserut cut, kinyeinai bon, emunokina Edeke, kosalak aiŋaiŋa ka ailipenen akuare ka apaaran. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.5",
            "verseOrgIds": [
              "1TI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye ŋin naeminakinito aboliasio, etwanit karaida kejari. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.6",
            "verseOrgIds": [
              "1TI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicorak kes ŋun da, tetere eraas nuemamei aitoronet. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.7",
            "verseOrgIds": [
              "1TI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye ituŋanan kere arai mam idari lukeŋ, aitelekarit lukokaleke ilopet, aŋer ŋesi aiyuun, erono da adepar yenimam iyuunit.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.8",
            "verseOrgIds": [
              "1TI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.8",
            "verseOrgIds": [
              "1TI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siriwadikao apuserut namam edolit ikar akaisakanykape, nakerai aberu naka ekiliokit ediopet; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.9",
            "verseOrgIds": [
              "1TI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.2"
              },
              "items": [
                {
                  "text": "Bur 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.14"
              },
              "items": [
                {
                  "text": "Yok 13:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " itejenunitai kanuka aswamisio nuejok; arai esait idwe, arai abu kisukuny ipejok, kilot akeje nuka lukalaunak, iŋarakinit luiticanio, arai da edunyit atupit ŋiniswam kere naejok, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.10",
            "verseOrgIds": [
              "1TI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye koŋer aiwadik apuserun nukatumunak; naarai naiyatakiniata aipaliikin Kristo, ekotosi adukokin; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.11",
            "verseOrgIds": [
              "1TI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "egwaunete akiro naarai enyeis aiyuunikec nasodit. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.12",
            "verseOrgIds": [
              "1TI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.11"
              },
              "items": [
                {
                  "text": "2 Ses 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bobo da isisiaunete araut nuebwalaka, kirimete otogoi; kwabo mere nuebwalaka bon, konye ibeeleaka ka nuiramaaka da, inerasi numam ibusakinito. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.13",
            "verseOrgIds": [
              "1TI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.9"
              },
              "items": [
                {
                  "text": "1 Kor 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso akoto apuserun nukatumunak adukokin, kouriata idwe, koyaito ikalia, komam einakinete lokasurup apak naemoromoroo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.14",
            "verseOrgIds": [
              "1TI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ejaas kwana ace nuapaasi atupar Satan. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.15",
            "verseOrgIds": [
              "1TI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai ejaas aberu naiyuunit apuserun, kiŋarak ŋin kes, kinyeinai alaŋirikin ekanisa, tetere iŋarakini nueraas apuserun cut,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.16",
            "verseOrgIds": [
              "1TI.5.16"
            ]
          }
        }
      ]
    },
