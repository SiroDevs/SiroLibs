            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kitaaritoi kiwuta da kanuka ŋun, naarai kimunokina Edeke lokajaran, loerai Eketaiaran loka ituŋa kere, aitelekarit loka luiyuunito.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.10",
            "verseOrgIds": [
              "1TI.4.10"
