            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Namunot akirot na, ido naibusakinit ituŋa kere acamun. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.9",
            "verseOrgIds": [
              "1TI.4.9"
            ]
