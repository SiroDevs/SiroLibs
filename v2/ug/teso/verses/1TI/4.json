              "type": "text"
            }
          ]
        },
        {
          "text": " Kinac awaragasia numam eraas nuka edini, nukabaŋaanut. Konye kitwasama bon kotoma ayoŋit Edeke; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.7",
