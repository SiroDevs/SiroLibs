          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aitodol neabunio, kodunyak asoman, ka aicor, ka aisisianakin da. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.13",
            "verseOrgIds": [
              "1TI.4.13"
            ]
