          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "naarai italaunitai kanuka akirot naka Edeke ka ailip da.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.5",
