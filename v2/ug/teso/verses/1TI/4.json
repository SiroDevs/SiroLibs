              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikijal ainakinet naejai kotomakon, nakiinakinitai kanuka adwaranut ka aidokokinio akanin nuka imakio. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.14",
            "verseOrgIds": [
              "1TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
