              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ejok ŋinibore kere yenikesubi Edeke, emamei da ibore yeneŋerio, arai ecamunio kaimal; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.4",
            "verseOrgIds": [
              "1TI.4.4"
            ]
