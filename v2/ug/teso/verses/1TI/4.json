                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinyek idiotuŋanan aimen atumunikon, konye korau ijo aanyunet mama ejaas luiyuunito kotoma oiner, ka ejautene, kotoma amin, kotoma aiyuun, ka asegara da. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.12",
            "verseOrgIds": [
              "1TI.4.12"
            ]
          }
        },
        {
          "name": "verse",
