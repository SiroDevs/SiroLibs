            "sid": "AMO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luibalas ebe, “Mam kereka kipou kademutu amumwara kagogonukosi?”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.13",
            "verseOrgIds": [
              "AMO.6.13"
            ]
          }
        }
