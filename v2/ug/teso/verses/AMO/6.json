              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, arai edeunos ituŋa itomon togo ediopet, etwakete, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakedakaria papake lodidi, ŋol loiewei ŋes, aitolomun akoio kina ketogo etemari ŋesi ŋol loejai to ketogo atiar, “Eroko idio ejai kajo?” Ebala ŋesi ebe, “Mam,” Kosodi ŋesi atemar atiar, “Kililin: naarai mam kibusakinit oni alimor ekiror loka EJAKAIT,”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
