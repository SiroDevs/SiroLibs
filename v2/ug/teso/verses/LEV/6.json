          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso do arai kediaka, egwaunit da akirot, inyakari do ŋin yenaŋatarit, arai ibore yenaoliorit yenadumu ŋesi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4",
            "verseOrgIds": [
              "LEV.6.4"
            ]
          }
        },
