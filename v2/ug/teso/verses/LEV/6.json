          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituluci esasedoti ŋes kakonyen nuka EJAKAIT, isionio ŋes; kaŋun kere nuiswamai ŋesi nuagwaunit.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
