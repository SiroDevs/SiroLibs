              "type": "text"
            }
          ]
        },
        {
          "text": " Arai akirot kere naeyapoi nuka aisab; inyakari do kere, iyatakin ida idiopet kokany: einakini loerai elopet, kapaaran naitodunor ebe egwaunit akirot. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.6.5"
            ]
