          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kicorak Aaron ka odweke ebe, Lo ŋes ekisil loka ainakinet naicweio: ejaanakini ainakinet naicweio akito nukotem akuare kiya kiton tupuruc; inokenonoo akim ŋin nakotem. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
