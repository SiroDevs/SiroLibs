              "type": "text"
            }
          ]
        },
        {
          "text": " Eyauni ainakineteke naka aronis mama ejai EJAKAIT, emerekek lomam eŋwalit kosipan, kwape itubokinia ijo, mama ejai esasedoti, araun ainakinet naka aronis. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
