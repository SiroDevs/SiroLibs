              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elemari elogorotoke ka ajuloke, ecakakini owai lokokide loka etem, aibois naka ekurwon: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.16",
