              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyauni esasedoti ŋes otem, emojirikini aŋedar akouke, kicweikin kotem; eitanakini aokotoke ariri ketem: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.15",
            "verseOrgIds": [
