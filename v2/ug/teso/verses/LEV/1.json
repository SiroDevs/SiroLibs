              "items": [
                {
                  "text": "Pil 4:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ilosi kakip lukotomake ka akejeke: kosodi esasedoti aicweikin kere kotem, araun ainakinet naicweio, ainakinet naeinakinere kakim, naka asakat naeuru saa mama ejai EJAKAIT.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        }
      ]
