              "type": "text"
            }
          ]
        },
        {
          "text": " Idokokini akekan akou naka ainakinet naicweio; ecamunio kanukeŋ alucio ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.4",
            "verseOrgIds": [
              "LEV.1.4"
            ]
          }
        },
        {
