            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai erai ainakineteke ainakinet naicweio nakosipan loka aituk, einakini yenikiliokit yenimam eŋwalit: einakini ŋes kokek loka ewema loka airiamunun, tetere ecamunio kakonyen nuka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.3",
            "verseOrgIds": [
              "LEV.1.3"
            ]
          }
        },
