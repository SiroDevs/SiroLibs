            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Musa Aaron, ka Eleasar, ka Itamar, odweke atiar, “Sirikilakasi itima luka akwesikus, karaida aicil ikusinapen; kinyeis atwakare, kinyek ŋesi anyunyurikin ekodet kere: konye iinacanakus, ekek kere loka Isirael, kibworoto aicwe naecweiki EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
