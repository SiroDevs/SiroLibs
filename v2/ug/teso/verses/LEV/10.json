                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolom akim kakonyen nuka EJAKAIT, kicweik kes, kotwakikis akonyen nuka EJAKAIT. ",
