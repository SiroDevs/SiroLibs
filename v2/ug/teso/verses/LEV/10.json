            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.6.26"
              },
              "items": [
                {
                  "text": "Leb 6:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, mam aokotoke ayaŋaunitai toma aibois nakalaunan: tikinyamakis cut aibois nakalaunan, kwape kecorakinia.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.18",
            "verseOrgIds": [
