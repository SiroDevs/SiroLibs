            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.29"
              },
              "items": [
                {
                  "text": "Esk 44:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kanukinyo mam ipotu konyamakiniata ainakinet naka adiakaret aibois nakalaunan, naarai erai nakalaunan noi, abu ŋesi koinak ŋes aibwokia numam adolit nuka ekodet, aitulucio kes kakonyen nuka EJAKAIT? ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 10:18"
          },
          "items": [
