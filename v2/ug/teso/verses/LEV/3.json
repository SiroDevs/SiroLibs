        },
        {
          "text": " Idokokini akanike akou naka ainakineteke, earakini ŋes okek loka ewema loka airiamunun: ebwatanakinete odwe luka Aaron lusasedotin aokot owaitin luka etem. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.2",
            "verseOrgIds": [
              "LEV.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
