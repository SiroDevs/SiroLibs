            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai kitalau etuŋanan etogoke araun lokalaunan mama ejai EJAKAIT itiriani do esasedoti etiaike, arai ejok arai erono: kwape itiriania esasedoti etiaike, kojau kwaŋin, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai ekoto ŋol loetalaunit alakun etogoke, iyatakini do idiopet kokany mama ejaas apesan nuka etiaikon, eraun lokeŋ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
