        },
        {
          "text": " “Kolimok idwe luka Isirael ebe, Naiyapoo ituŋanan aiyaposit mama ejai EJAKAIT naebeit ituŋa, itiriani ijo etiaike. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
