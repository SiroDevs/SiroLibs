              "items": [
                {
                  "text": "2 Kor 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai icana ŋesi adepar etiaikon, itobwoi ŋes kakonyen nuka esasedoti, itiriani esasedoti etiaike; kwape ejaar apedor naka ŋol kaloeyapoi itiriani esasedoti etiaike.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        }
      ]
