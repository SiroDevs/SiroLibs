              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye naeosikinere koyubili eraun emanikor lokalaunan mama ejai EJAKAIT, kwape emanikor loegitunitai; eraunos alup nuka esasedoti, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
