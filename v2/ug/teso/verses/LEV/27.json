          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imarakini esasedoti ŋes ajokis naka etiaikon kiton okaru loka eyubili: einakini etiaikon kapaaran kaŋin, kwape ibore yenikalaunan mama ejai EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
