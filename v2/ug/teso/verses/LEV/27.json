                  "text": "Leb 25:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokaru laka eyubili eboŋori emanikor mama ejai je loagwelari, ŋes elopet loebeitos alup. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
