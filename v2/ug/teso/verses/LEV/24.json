            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inapanakini imugatin ŋinipaaran nakasabato kakonyen nuka EJAKAIT tiritir: erai aitutuket namam edaun kanuka idwe luka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.8",
