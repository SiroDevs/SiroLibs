            "number": "3",
            "style": "v",
            "sid": "LEV 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋa kaigalisit naka aitejenunet, kowema loka airiamunun, itemonokini Aaron tiritir kakonyen nuka EJAKAIT, agear eboŋ kiton tupuruc: eraun ekisilomam edaun anatar aturiokus, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.3",
            "verseOrgIds": [
              "LEV.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 24:4"
          },
          "items": [
