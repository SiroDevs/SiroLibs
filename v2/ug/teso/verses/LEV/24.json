                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Itemonokini ŋesi tiritir atalai nukopir loelai loka atala kakonyen nuka EJAKAIT,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
