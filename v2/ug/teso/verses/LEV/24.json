            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inapanakini kes okokoron iarei, kaŋolikokoro ikanykape, omesa loelai kakonyen nuka EJAKAIT, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
