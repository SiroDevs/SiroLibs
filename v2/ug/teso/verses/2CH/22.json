                "loc": "2CH.21.17"
              },
              "items": [
                {
                  "text": "2 Siit 21:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete luiboiete koYerusalem kitaraut Akasia enooritie ekabaka aiboisike: naarai abu erioŋet loka ituŋa luauparos ka Iarabun oidukurun koar lukapolok kere. Kirum do Akasia okoku loka Yekoram ekabaka loka Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.1",
            "verseOrgIds": [
              "2CH.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.26"
              },
              "items": [
                {
                  "text": "2 Ika 8:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.28"
              },
              "items": [
                {
                  "text": "1 Ika 16:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.6"
              },
              "items": [
                {
                  "text": "2 Siit 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kerai Akasia loka ikar akaisaoŋon ka luarei egeuni airum; kirumak ekaru ediopet ko Yerusalem: ekiror loka totoke kerai Aralia akoku naka Omiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.2",
            "verseOrgIds": [
              "2CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolosenenei Akasia da korotin luka ekek loka Akab: naarai totoke ŋes akenerunanike aswam nukaronis. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.3",
            "verseOrgIds": [
              "2CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.17"
              },
              "items": [
                {
                  "text": "2 Siit 24:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.10"
              },
              "items": [
                {
                  "text": "Awa 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.19.27"
              },
              "items": [
                {
                  "text": "19:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswama nueroko kakonyen nuka EJAKAIT, kwape lukokek loka Akab: naarai araas kesi ikenerunakake akaulo katwanare naka papake, amudiar ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.28"
              },
              "items": [
                {
                  "text": "2 Ika 8:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupa da ainerunikec, kouparos ka Yekoram okoku loka Akab ekabaka loka Isirael aitiji Kasael ekabaka loka Suria koRamot-gilead: kimusuŋata Isurian Yoram. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.5",
            "verseOrgIds": [
              "2CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.15"
              },
              "items": [
                {
                  "text": "2 Ika 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobono Yesereel aŋaleun amusuŋun nuemusuŋitai ŋes koRama, naajiotor ka Kasael ekabaka loka Suria. Kolot Asaria okoku loka Yekoram ekabaka loka Yuda aanyun Yekoram okoku loka Akab koYesereel, naarai adeka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
      ]
    },
