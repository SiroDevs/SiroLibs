            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobut Amasia okoku loka Yoas ekabaka loka Yuda ikar itomon ka lukany akaulo katwanare naka Yoas okoku loka Yekoakas ekabaka loka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
