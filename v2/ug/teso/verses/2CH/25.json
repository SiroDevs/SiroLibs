                "loc": "2KI.14.5"
              },
              "items": [
                {
                  "text": "2 Ika 14:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, nakiticasere akejakanut kamake, koar ikekejaanakinak luapotu koarata papake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
