          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiboleoto ŋesi kituŋa ilukumin akwatat lukirigin luetitin koIsirael atalatan akwatat nuka epuesa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
