            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kerai Amasia laka ikar akaisaarei ka lukany egeuni airum; kirumak ikar akaisaarei ka Iukanykaoŋon koYerusalem: ekiror loka totoke kerai Yekoadan naka Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
