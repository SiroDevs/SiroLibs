            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye koŋer Amasia akiirar; naarai kerai akirot naka Edeke, tetere ijaikini kes akan naka lukasurupokec, naarai amoata idekesio luka Edom. ",
          "type": "text",
          "attrs": {
