                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikam Yoas ekabaka loka Isirael Amasia ekabaka loka Yuda, okoku loka Yoas, okoku loka Yekoakas, kolset-semes, koyau ŋes Yerusalem, kotiyatiya arwatat naka Yerusalem anyoun korute loka Epuraim kiton orute loka agor, ikubitin akwat aoŋon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koŋata esabu ka epuesa kere, ka iboro kere luadumunio koObededom togo loka Edeke, ka iboro luka akais nuipu Iukotogo loka ekabaka, ka lukititiŋa da, koboŋo Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
