          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aswamisio ace nuka Amasia, nusodit ka nukawasia, koany, mam kereka iwadikatai oitabo loka ikabakan luka Yuda ka Isirael? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agear kapaarasia nuebelokinor Amasia anyoun katupit EJAKAIT, kinerut asurokin ŋes koYerusalem; koker Lakis; konye kijukasi atupakin ŋes Lakis, koarakinai ŋina, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
