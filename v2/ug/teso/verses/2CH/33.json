          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojotoor do Manase kalukapapaake, aponi kidaikinai togoke kelopet: kirum Amon okokuke aiboisike.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.20",
