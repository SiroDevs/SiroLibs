                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswama nueroko kakonyen nuka EJAKAIT, kwape ajaatar italesia luka ikapirin, luerenearit EJAKAIT kakonyen nuka idwe luka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
