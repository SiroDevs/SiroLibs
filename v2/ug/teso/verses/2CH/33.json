              "items": [
                {
                  "text": "2 Ika 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitotor ikedwe akim kaditot naka okoku loka Kinom: konye aanyuneta, kitwasam nukalemelem, kiswama nukaicud, kouparos kaŋul kaluajaas ajokina, ka ikepiedak: kiswama nukaronok nuipu kakonyen nuka EJAKAIT aitunyunyurikin ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.6",
            "verseOrgIds": [
              "2CH.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.7"
              },
              "items": [
                {
                  "text": "2 Ika 21:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.14"
              },
              "items": [
                {
                  "text": "Sab 132:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kibwaik aput naegerer naka ibore yenemai ŋesi, naabu kiswamau, togo loka Edeke, loabu Edeke kolimok Daudi ka Solomon okokuke ebe, “Ebwaikini ekakiror togo lo ikar kere, Yerusalem da, loaseunit katekerin kere nuka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.10"
              },
              "items": [
                {
                  "text": "2 Sam 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam bobo da alemari akeju naka Isirael kakwap naaseikinit lukapapaakus; arai teni iricete aiswamaenen nuecoraki kes kere, ikisila kere ka apucuneta ka aicorakineta kakan naka Musa.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.8",
            "verseOrgIds": [
              "2CH.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitapaa Manase Yuda ka luiboiete koYerusalem, kiswamata nueroko aitelekar atekerin, nuabu EJAKAIT komudia kakonyen nuka idwe luka Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        }
      ]
    },
