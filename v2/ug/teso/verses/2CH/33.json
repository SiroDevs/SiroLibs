            "number": "19",
            "style": "v",
            "sid": "2CH 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akeilip da, ido kwape kiiraria Edeke ŋes, aronisike kere, ka adiakarike, ka aiboisio nuadukokinit ŋesi aiboisio nuiceleleete, kosipok Aserim, ka aputosia nuegerer, eriŋa kitasonikino; koany, iwadikatai kakiro nuka Kosai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.19",
            "verseOrgIds": [
              "2CH.33.19"
            ]
          }
        },
        {
          "name": "verse",
