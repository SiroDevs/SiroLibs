          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswama nueroko kakonyen nuka EJAKAIT, kwape eswamaa Manase papake: koinak Amon asuban mama ejaas aputosia kere nuegerer nuabu Manase papake kiswamau, kijaanak kes. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.22",
            "verseOrgIds": [
              "2CH.33.22"
            ]
          }
        },
