                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kerai Manase loka ikar itomon ka luarei egeuni airum; kirumak ŋesi ikar akaisakany ka lukany ko Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.1",
            "verseOrgIds": [
              "2CH.33.1"
            ]
          }
        },
