              "type": "text"
            }
          ]
        },
        {
          "text": "Kerai Amon loka ikar akaisaarei ka luarei egeuni airum: kirumak ikar iarei koYerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.21",
            "verseOrgIds": [
              "2CH.33.21"
            ]
          }
