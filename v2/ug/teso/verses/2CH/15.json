            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobilibilunos, ateker kateker, ka ere ka ere: naarai kisiyaloŋoŋ Edeke kes katiokisio kere, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.6",
