              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apak naepol amamei Isirael Edeke lokabeit, amamei da esasedoti loisisianakini, amameete da ikisila: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
          }
        },
        {
