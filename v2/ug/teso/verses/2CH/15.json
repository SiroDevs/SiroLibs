        },
        {
          "text": " Kepupu Asa akiro ŋun, ka aidwar naka Oded enabi, kotitiŋior, kolema italesia kakwap kere nako Yuda ka Benyamin, koreria da luerumit kakwap nakiukon naka Epuraim; kiteteu etem loka EJAKAIT, lokejai iŋaren kaneelomarere togo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 15:9"
          },
