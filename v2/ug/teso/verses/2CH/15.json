          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyapoikis EJAKAIT keporoto loepol, keibwoŋ, karupepen, ka apeen. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
