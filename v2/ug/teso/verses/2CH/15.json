            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisiyalamik Yuda kere aiyaposit: naarai apotu kiyapoto kitauonokec kere, komoata ŋes keimielakec kere; apotu kodumut ŋes: kisiyeŋu EJAKAIT kes kowaitin kere,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
