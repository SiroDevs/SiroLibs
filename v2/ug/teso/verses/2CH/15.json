            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapaarasia kwa amamei ainapakin ŋin yenelomari, karaida ŋin yenelomuni, konye kiyaloŋoŋoete noi luiboiete kere kakwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.5",
            "verseOrgIds": [
              "2CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
