                  "text": "Ikis 4:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye nakejaatar ocan kibelokinos mama ejai EJAKAIT, Edeke loka Isirael, komoata ŋes, kodumutu nes. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
