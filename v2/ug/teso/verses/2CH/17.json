              "items": [
                {
                  "text": "Mal 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisisianakinete koYuda, kejaas keitabo loka ikisila luka EJAKAIT; kitoroto anatar ireria kere luka Yuda, kisisianakinete ituŋa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        }
