              "items": [
                {
                  "text": "2 Siit 18:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun kiticat EJAKAIT ajakanut kakanike; koinu Yuda kere ainakineta mama ejai Yekosapat; kojau ŋesi kabar ka aibuses naepol. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.5",
            "verseOrgIds": [
              "2CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
