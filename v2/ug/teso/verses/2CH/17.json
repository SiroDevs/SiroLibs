          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotupite ŋes Yekosabad, ka ilukumin akwatat ka ilukumin akaisakanykauni nepepe kaŋes luetemokino ejie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.18",
