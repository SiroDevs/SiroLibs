            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.19.3"
              },
              "items": [
                {
                  "text": "19:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitonyounoi eketau orotin luka EJAKAIT: bobo da kolema aiboisio nuiceleleete ka Aserim koYuda,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
