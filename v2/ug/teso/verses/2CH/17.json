                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokaru lokiwuniet da loka airumuke kijuka ikapolokoke, Ben-kail, ka Obadia, ka Sekaria, ka Netanel, ka Mikaia, aisisianakin oreria luka Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nepepe kakes da Ilebin, Semaia, ka Netania, ka Sebadia, ka Asakel, ka Semiramot, ka Yekonatan, ka Adoniya, ka Tobiya, ka Tob-adoniya, Ilebin; nepepe kakes da Elisama ka Yekoram, isasedotin, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
