              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luka Benyamin; Eliada etuŋanan lokirigi Ioetitin, ka ilukumin akwat aarei nepepe kaŋes lukekapito akabwai ka ibukui: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.17",
            "verseOrgIds": [
              "2CH.17.17"
            ]
          }
        },
