            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokaru losodit laka Kuro ekabaka loko Perusia, tetere itodolikinio akirot naka EJAKAIT kaituk naka Yeremia, kisidik EJAKAIT etau laka Kuro ekabaka loko Perusia, kolimo anatar ajakanutuke kere, kiwadika da ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
