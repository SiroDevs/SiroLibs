                  "text": "Dan 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodaka Nebukadanesar da lukoboro luka etogo laka EJAKAIT Babulon, kibwaik kes oyekaluke koBabulon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
