            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kedol ekaru, kijuka ekabaka Nebukadanesar koyau ŋes Babulon, nepepe kiboro luejok luka etogo laka EJAKAIT, kitarau Sedekia onaceke ekabaka loka Yuda ka Yerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
