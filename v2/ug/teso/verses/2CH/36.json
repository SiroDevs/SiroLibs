        },
        {
          "text": " Kobu Nebukadanesar ekabaka loko Babulon asurokin ŋes, koen ŋes kasua, adakar ŋes Babulon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
