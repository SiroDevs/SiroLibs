                "loc": "MAT.14.3"
              },
              "items": [
                {
                  "text": "Mat 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Asa anyunyurikin ekadwaran, kibwaik nes aidaris; naarai kisiopak ŋes kanuka akirot kaŋin. Koroik Asa ice kotuna kapak kanin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        }
