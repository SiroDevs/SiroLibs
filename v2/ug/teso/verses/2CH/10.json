                "loc": "1KI.11.40"
              },
              "items": [
                {
                  "text": "1 Ika 11:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, kepupu Yeroboam okoku loka Nebat ŋun, (naarai kejai Misiri, neakeriarit anyoun kakonyen nuka ekabaka Solomon,) koboŋu do Yeroboam koMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.2",
            "verseOrgIds": [
              "2CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijukasi konyarautu ŋes; kobu Yeroboam ka Isirael kere, kinerata ka Rekoboam atiar, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.3",
            "verseOrgIds": [
              "2CH.10.3"
            ]
          }
        },
