                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Abu papakon kitalaŋir ajookotokosi: aso do kitebeben aswam naetiono naka papakon, ka ajookotoke naelaŋir naebwaikinit mamakosi, isio da kiŋaanakini jo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.4",
            "verseOrgIds": [
              "2CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema kes atiar, “Koboŋutu neajai eoŋ ketuboros apaarasia auni.” Koloto ituŋa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.5",
            "verseOrgIds": [
              "2CH.10.5"
            ]
          }
        }
      ]
    },
