              "items": [
                {
                  "text": "Sab 112:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.15.1"
              },
              "items": [
                {
                  "text": "Awa 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobalas ŋes ebe, “Arai kisianiar ijo kaneejaas ituŋa ŋul, kisiyalamik kes, kolimok akiro nuejok, aso eraunos kesi ikonikejaanakinak ikar kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.7",
            "verseOrgIds": [
              "2CH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 10:8"
          },
          "items": [
