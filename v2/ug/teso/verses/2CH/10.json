            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso mam abu ekabaka kopup ituŋa; naarai kerai akirot naabu Edeke koyau, tetere iticasi EJAKAIT akekirot, naabu kiner kama ka Akiya Esilonit mama ejai Yeroboam okoku loka Nebat,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.15",
            "verseOrgIds": [
