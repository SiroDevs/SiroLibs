                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinerut ekabaka Rekoboam kimakio, luabwoenenete kakonyen nuka Solomon papake eroko ejari ebe, “Ibalasi bo yesi ai eoŋ aboŋokin ituŋa ŋul?” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.6",
            "verseOrgIds": [
              "2CH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.7"
              },
              "items": [
                {
                  "text": "1 Ika 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.5.19"
              },
              "items": [
                {
                  "text": "Nek 5:19",
