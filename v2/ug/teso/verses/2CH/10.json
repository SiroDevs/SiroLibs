            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolot Rekoboam Sekem: naarai kinotara Isirael kere Sekem aitaraun nes ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.1",
            "verseOrgIds": [
              "2CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
