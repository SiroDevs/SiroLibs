                  "text": "Lim 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kola ainerun naka imakio naapesikinito ŋes, kineru kikatumunak luapolounete kaŋes, luabwoete kakonyeneke, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.8",
            "verseOrgIds": [
              "2CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema kes atiar, “Ibalasi bo yesi ai, kaboŋokis ituŋa ŋul, luapotu kabalas eoŋ ebe, ‘Kitebeben ajookot nakibwaikini papakon mamakosi?’” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.9",
            "verseOrgIds": [
              "2CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotemasi ikatumunak luapolounete kaŋes atiar, “Kolimok ituŋa ŋul lukibalas jo ebe, ‘Abu papakon kitalaŋir ajookotokosi, konye jo kitebeben ŋes kamakosi’; ilimokini kes kwanata ebe, ‘Ebur ekabokorit lodidi aitelekar aŋabet naka papake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.10",
            "verseOrgIds": [
              "2CH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso do abu papaka kisibwok yes ajookot naelaŋir, eyatakini do eoŋ ajookotokus: abu papaka koswala yes kidas, konye eoŋ kaswalari yes kikiritona.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.11",
            "verseOrgIds": [
              "2CH.10.11"
            ]
          }
        }
      ]
    },
