              "items": [
                {
                  "text": "Lim 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema ikatubok atiar, “Koomitos nuiswamaete: naarai mam itubete kanuka ituŋanan, konye kanuka EJAKAIT: ejai ŋesi kayes kotube. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.6",
            "verseOrgIds": [
              "2CH.19.6"
            ]
          }
        },
