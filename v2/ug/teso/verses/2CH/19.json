          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiboie Yekosapat koYerusalem: koloma bobo mama ejaas ituŋa anyoun koBeer-seba kiton akwap nakiukon naka Epuraim, kinyaku kes mama ejai EJAKAIT, Edeke loka lukapapaakec. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.4",
            "verseOrgIds": [
              "2CH.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.18"
              },
              "items": [
                {
                  "text": "Ikis 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodakanak ikatubok kakwap anatar ireria kere luebwaitai luka Yuda, kaŋolire kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.5",
            "verseOrgIds": [
              "2CH.19.5"
            ]
          }
        },
