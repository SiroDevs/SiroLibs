                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do koyoŋito yesi EJAKAIT; kocoito kiswamata: naarai emameete numam adolit kaneejai EJAKAIT Ewokodeke, karaida atiakit ituŋa, karaida aijaun ainakineta.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        }
