        {
          "text": "Koboŋo Yekosapat ekabaka loka Yuda togoke Yerusalem inapakina. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.1",
            "verseOrgIds": [
              "2CH.19.1"
            ]
          }
        },
