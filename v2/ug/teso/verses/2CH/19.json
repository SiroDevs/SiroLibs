              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.8"
              },
              "items": [
                {
                  "text": "Ikis 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.46"
              },
              "items": [
                {
                  "text": "Mar 16:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.18"
              },
              "items": [
                {
                  "text": "Esk 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naeyauniata ikusiinacan luiboiete koreriakec epeget kere mama ijaas, kokidiŋ kaokot ka aokot, kokidin kekisil ka aicorakinet, ikisila ka itubesia, kikwenyasi kes, kinyeis agwaun akiro mama ejai EJAKAIT, kosodi anyunyura abunokin yes ka ikusiinacan: kiswamata ŋun, mam do igwaunete. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.10",
            "verseOrgIds": [
              "2CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido koany, kipolokinit yes Amaria esasedoti lopeti kakiro kere nuka EJAKAIT; ka Sebedia okoku loka Isimael, ekayaiton ekek loka Yuda kakiro kere nuka ekabaka: Ilebin da eraunos ikapolokitokokus, Kiswamata katitiŋ, kojai EJAKAIT ka yenejok.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        }
