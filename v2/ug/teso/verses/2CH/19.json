              "items": [
                {
                  "text": "2 Siit 32:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloma Yeku okoku loka Kanani ekadwaran airiamakin kaŋes, kotema ŋesi ekabaka Yekosapat atiar, “Ti kereka ejok jo aiŋarakin ikaronok, amina da ŋjul luelaito EJAKAIT? Kanuka akirot kaŋin kibunok jo anyunyura kakonyen nuka EJAKAIT, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.2",
            "verseOrgIds": [
              "2CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.12.12"
              },
              "items": [
                {
                  "text": "2 Siit 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.30.19"
              },
              "items": [
                {
                  "text": "30:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.10"
              },
              "items": [
                {
                  "text": "Esr 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye edumuna nuejok kotomakon, naarai ilema Aserot kakwap, ibwaikinit ekonitau amoot Edeke.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        }
      ]
    },
    {
