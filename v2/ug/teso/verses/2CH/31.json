          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kogelara ŋul luemaritai kaurikec naka lukiliok, ageun ka luka ikar iuni ka adepar, ŋolituŋanan loelomari togo loka EJAKAIT, kwape ibusakinitor aswam naka ŋinipaaran, aijaanakin kaswamukec kwape ajaatar abeanakinetakec, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
