                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kicorak da ituŋa lueboiete koYerusalem ainanakin ewai loka isasedotin ka Hebin, tetere einanakinete bonik kokisila luka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
