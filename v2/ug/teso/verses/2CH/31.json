                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atipet nakitisiarikinor aicorakinet, koinanakis idwe luka Isirael kaipues lugeet luka akima, ka ebino, ka akinyet, ka esik, ka luka amio kere nakomanikor: koyaununut yenikitomonet yenika iboro kere kaipues. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30"
              },
              "items": [
                {
                  "text": "Leb 27:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.28"
              },
              "items": [
                {
                  "text": "Ikis 14:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Idwe luka Isirael ka Yuda, lukiboiete koreria luka Yuda, koyaut da yenikitomonet yenika imoŋin ka amerekekin, ka yenikitomonet yenika iboro luetiakunitai mama ejai EJAKAIT Ekecedeke, kibwaikis atukon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolap lokiwuniet kogeut aituk atukon, kodaut kes kolap lokikanyetekaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
