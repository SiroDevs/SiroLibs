            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwapuke ajai Eden ka Minaimin, ka Yesua, ka Semaia, ka Amaria, ka Sekania, koreria luka isasedotin, kaswamukec, ainakin ikeceinacan kabeanakin, lukapolok ka ludidik da: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        },
        {
