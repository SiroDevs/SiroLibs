        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.1"
              },
              "items": [
                {
                  "text": "Mar 28:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.1"
              },
              "items": [
                {
                  "text": "29:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitetemik da ewai loka iboro Iuejaatar ekabaka araun ainakineta nuicweio, kes nu, nuka ainakineta nuicweio nuka tupuruc ka eboŋ, ainakineta nuicweio da nuka asabaton, ka napilamununei elap, ka nuka ipucin lueseunitai, kwape iwadikatere okisila luka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
