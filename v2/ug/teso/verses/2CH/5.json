            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bobo da kobwaata Ilebin lukeraas ikayook kowai lokokide loka etem, kes kere, Asap, ka Keman, ka Yedutun, ka odwekec ka iinacanakec, konapito ebaputa loejok, kojaas kaisinin nueruosi ka isabulin ka adeudeun; ido isasedotin akwatat ka akaisaarei nepepe kakes kokusete arupepen:) ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
