            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokaru lokikanyetekaarei kogogoŋoor Yekoiada, koyaŋa ikapolok luka akwat, Asaria okoku loka Yekoram, ka Isimael okoku loka Yekokanan, ka Asaria okoku loka Obed, ka Maaseia okoku loka Adaia, ka Elisapat okoku loka Sikiri, kitutukoto kakes. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 23:2"
          },
          "items": [
