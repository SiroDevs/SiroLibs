                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete kesi aitolomun okoku loka ekabaka, kidokokis aboko akouke, koinakis ajteienunet, kitaraut ŋes ekabaka: kinyonyoata do ŋes Yekoiada ka odweke akinyet; kotemasi atiar, “Kidari Edeke ekabaka.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.11",
            "verseOrgIds": [
              "2CH.23.11"
            ]
          }
        }
      ]
    },
