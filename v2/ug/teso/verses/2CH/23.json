        },
        {
          "text": " Kitutukoto ekodet kere ka ekabaka togo loka Edeke. Kotema kes atiar, “Koany, irumi okoku loka ekabaka, kwape abalar EJAKAIT kodwe luka Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
