        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.112.5"
              },
              "items": [
                {
                  "text": "Sab 112:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitoroto koYuda, kotukonokis Ilebin koreria kere luka Yuda, ka lukapolok luka ikekia luka lukapapaa luka Isirael, kopotu Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
