          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido toma apak kaŋin kalimok ituŋa ebe, “Koperenenei ninitunanan ka ekekejaanakinan toma Yerusalem, koraananas ikedarakakosi kuare, ido kitaaritos paaran.” ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.22",
