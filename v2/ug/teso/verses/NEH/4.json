            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka nun mam kilaeununei inapcnekosi, karaida eoŋ karaida ikainaean, karaida ikakeiaanakinak, karaida ituŋa lukedarak lukatupito eoŋ, kolosenenei ŋinitunanan atan itiŋ it yenijiisike.",
          "type": "text",
          "attrs": {
