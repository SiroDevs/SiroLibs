              "type": "text"
            }
          ]
        },
        {
          "text": "Kasodete keswamaenenete aswam: kitinenenete atutubetekec akwaras ageun eeilakide kiton neetakanuniata aacer. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.21",
