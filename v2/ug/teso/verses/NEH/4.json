          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kepuput Sanabalat, ka Tobia, ka Iarabun, ka Imonain, ka Isudodain, ebe iyatanakin aswam naka aiteteun arwatatin nuka Yerusalem, ageun da ainwok arorwaitin, konyunyurikinos noi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.7",
            "verseOrgIds": [
              "NEH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
