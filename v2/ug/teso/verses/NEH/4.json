            "number": "18",
            "style": "v",
            "sid": "NEH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikadukok da, koenikinite ŋinituŋanan ekileŋike anabcteke, kodukenenei kwaŋin. Ŋol da loakusenenei arupepe kiiaenena keoŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.18",
            "verseOrgIds": [
              "NEH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalimoki isotia, ka ikayaitok, ka ituŋa ice ebe, “Epol aswam, elal da, kiderakina oni karwatat, elwanikina ijinitunanan ka yeniee: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.19",
            "verseOrgIds": [
              "NEH.4.19"
            ]
          }
        },
