            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋul luadukenenete arwatat, ka nul luebwokenenete abwokon kigugunatos, kiswamai ŋinituŋanan aswam kadiopekan, kitinite naee da yeniiiisike, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.17",
            "verseOrgIds": [
              "NEH.4.17"
            ]
          }
        },
        {
          "name": "verse",
