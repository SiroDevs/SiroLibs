          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasodete kadukoto arwatat; arwatat kere kimorikikin nepepe aitodol atutubet naka amukururuke: naarai apotu ituŋa kibwaikis itauon aswam,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        }
