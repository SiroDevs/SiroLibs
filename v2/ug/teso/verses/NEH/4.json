        },
        {
          "text": " Konye kepupu Sanabalat kwape kidukio isio arwatat, konyunyurikin, kisiop noi, kisekel Iyudayan. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.1",
            "verseOrgIds": [
