        },
        {
          "text": " Kotukonokinos ituŋa kere kwapc ediopetunanan aibois naelal, naesesenas kerute loka Akipi; kobalasi Esera ekewadikan ayaun eitabo loka ikisila luka Musa, luabu EJAKAIT kicorak Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
            "verseOrgIds": [
              "NEH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
