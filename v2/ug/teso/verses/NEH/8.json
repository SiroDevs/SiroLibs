        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.11"
              },
              "items": [
                {
                  "text": "Leb 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido Yesua, ka Bani, ka Serebia, ka Yamin, ka Akub, ka Sabetai, ka Kodia, ka Maaseia, ka Kelita, ka Asaria, ka Yosabad, ka Kanan, ka Pelaia, ka Ilebin, kiteienut ituŋa ikisila; kobwaata ituŋa kaiboisiokee. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
