            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koramenenete kolimonokinete koreriakec kere, ka Yerusalem ebe, “Koloto moru, koomata atenuna nuka eseitun, ka atenuna da nuka eseitun loka ais, ka atenuna nuka ikadasia, ka atenuna nuka idukudukun, ka atenuna nuka ikito luetumito, aiswamaa iswamin, kwape kiwadikatere.” ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
