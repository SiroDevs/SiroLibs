          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapaaran nakiareit da kotukonokinos ikapolok luka ikekia luka lukapapaa luka ituŋa kere, ka isasedotin, ka Ilebin, neejai Esera ekewadikan, aitoikin aki necjaas akiro nuka ikisila. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 8:14"
          },
          "items": [
