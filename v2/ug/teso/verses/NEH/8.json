              "items": [
                {
                  "text": "Leb 23:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyau Esera esasedoti ikisila akonyen nuka atukot, ikiliok ka aŋor da, ka kere luapedorete apupun kajenun, kapaaran nasodit naka elap lokikanyetekaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.2",
            "verseOrgIds": [
              "NEH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosiom nu koinaren kaibois naelal naesesenas kerute loka Akipi ageun tupuruc sek kiton kidin paaran, kojaas kiliok ka aŋor da, ka nul luapedorete ajenun; kitoikis ituŋa kere apupokin eitabo loka ikisila. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.3",
            "verseOrgIds": [
              "NEH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobwo Esera ekewadikan kotut loka akito, loekeitoi kanuka nun; kobwaata Matitia, ka Sema ka Anaia, ka Uria, ka Kilikia, ka Maaseia eiduny kaŋes kakekan nakoteten; kakekan da nakokediany Pedaia, ka Misael, ka Malakiya, ka Kasum, ka Kasabadana, ka Sekaria, ka Mesulam. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.4",
            "verseOrgIds": [
              "NEH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.20"
              },
              "items": [
                {
                  "text": "Tub 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kopuko Esera eitabo kakonycn nuka ituŋa kere; (naarai ajai kuju kituna kere;) kepuko, kobwaata ituŋa kere. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.5",
            "verseOrgIds": [
              "NEH.8.5"
            ]
          }
        },
        {
