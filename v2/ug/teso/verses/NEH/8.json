                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete ituŋa alomar, koyanaut kes, kiswamata da iswamin, ninitunanan oswi loka etogoke, ka alaroikee, ka alaroi nuka etogo loka Edeke, kaibois da naelal naka erute loka Akipi, kaibois da naelal naka erute loka Epuraim. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswamata ekodet loka ŋul kere Iuabonunete kaiioreorio iswamin, kiboikinos oswamin: naarai agear kapaarasia nuka Yesua okoku loka Nun aitodol apaaran ŋin mam idwe luka Isirael eswamaenenete kwaŋin, Kojai ailel naepol noi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.17",
            "verseOrgIds": [
              "NEH.8.17"
            ]
          }
        },
