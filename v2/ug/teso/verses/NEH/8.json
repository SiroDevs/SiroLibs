              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koanyut nukiwadikatai okisila, kwape abu EJAKAIT kicorakinia kama ka Musa ebe koperenenete idwe luka Isirael oswamin kopucit loka elap lokikanyetekaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
