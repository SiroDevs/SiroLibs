            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kimala Esera EJAKAIT, Edeke lokapolon. Kobonokis ituŋa kere ebe, “Amen, Amen”; kikianarete akaninikec: kosodete kituluroto akwesikee, komaata EJAKAIT, kitulurito akecekonyen kwap, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 8:7"
          },
          "items": [
            {
              "text": "7",
