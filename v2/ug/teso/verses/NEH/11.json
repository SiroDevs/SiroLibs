        },
        {
          "text": " Lu kes eraas ijaka luka ebuku lueboienenete koYerusalem: konye koreria luka Yuda koiaenena nlnituŋanan alupoke kotoma oreriakec, Isirael, isasedotin, Ilebin, Inetinim, ka idwe luka ikeiaanakinak luka Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.3",
            "verseOrgIds": [
              "NEH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.3"
              },
              "items": [
                {
                  "text": "1 Siit 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.29"
              },
              "items": [
                {
                  "text": "Age 38:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojaenenas koYerusalem ice kodwe luka Yuda, ka lukodwe luka Benyamin. Kodwe luka Yuda; Ataia okoku loka Usia, okoku loka Sekaria, okoku loka Amaria, okoku loka Sepatia, okoku loka Makalalel lokodwe luka Peres; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.4",
            "verseOrgIds": [
              "NEH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Maaseia okoku loka Baruk, okoku loka Kol-kose, okoku loka Kasaia, okoku loka Adaia, okoku loka Yoiarib, okoku loka Sekaria, okoku loka Esilonit. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.5",
            "verseOrgIds": [
              "NEH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odwe luka Peres kere luaiaenenas koYerusalem emwaasi ituŋa luetitin akwat aoŋon ka akaisakanykape ka lukanykauni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.6",
            "verseOrgIds": [
              "NEH.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
