                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lukosasedotin: Yedaia okoku loka Yoiarib, Yakin, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.10",
            "verseOrgIds": [
              "NEH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seraia okoku loka Kilikia, okoku loka Mesulam, okoku loka Sadok, okoku loka Meraiot, okoku loka Akitub, ekayaiton loka etogo loka Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.11",
            "verseOrgIds": [
              "NEH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikeeeinacan lueswamaenenete aswam naka etogo, akwat akanykauni ka akaisaarei ka luarei: ka Adaia okoku loka Yerokam, okoku loka Pelalia, okoku loka Amisi, okoku loka Sekaria, okoku loka Pasur, okoku loka Malikiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.12",
            "verseOrgIds": [
              "NEH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ikeinacan, ijaka luka ikekia luka lukapapaakee, akwat aarei ka akaisaoŋon ka luarei: ka Amasisai okoku loka Asarel, okoku loka Akasai, okoku loka Mesilemot, okoku loka Imer, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.13",
            "verseOrgIds": [
              "NEH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ikeceinacan, iruna lukirigin luetitin, akwatat ka akaisaarei ka lukanykauni: Sabidiel okoku loka Kagedolim ŋes ckaanyanaranikee.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        }
      ]
    },
