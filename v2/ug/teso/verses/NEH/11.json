        },
        {
          "text": " ka Sabetai ka Yosabad lukojaka luka Ilebin, luaanyanarete aswamisio nukokina nukotogo loka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.16",
