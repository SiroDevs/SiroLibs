            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.1+AMO.2.2+AMO.2.3"
              },
              "items": [
                {
                  "text": "Amo 2:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapaaran kaŋin kosioma toma oitabo loka Musa kopupete ituŋa kere; kodumut iwadikatai nen ebe mam elomanari Emonait ka Emoabit toma atukot naka Edeke ikar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.1",
            "verseOrgIds": [
              "NEH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.5"
              },
              "items": [
                {
                  "text": "Mar 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
