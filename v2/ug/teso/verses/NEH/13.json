          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapaarasia kanun da abu kaany lyudayan luamanyitos aŋor nuka Asudod, ka nuka Amon, ka nuka Moab: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kinerasi idwekec da aŋajep nainyalinyala naka Asudod, kwabo mam apedorete einer aŋajep naka Iyudayan, konye kwape ajaar aŋajep naka ninlteker. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.24",
            "verseOrgIds": [
              "NEH.13.24"
            ]
          }
        },
