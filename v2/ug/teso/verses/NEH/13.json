              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.10.2"
              },
              "items": [
                {
                  "text": "Esr 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do kopupunoi yes da iswamaete aronis na naepol kere, aibucar mama ejai Edekewok aimany aŋor numo?”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
            "verseOrgIds": [
              "NEH.13.27"
            ]
          }
        }
