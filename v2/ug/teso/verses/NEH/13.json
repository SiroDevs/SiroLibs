                "loc": "DEU.23.5"
              },
              "items": [
                {
                  "text": "Ikis 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.109.28"
              },
              "items": [
                {
                  "text": "Sab 109:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.6.5"
              },
              "items": [
                {
                  "text": "Mik 6:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam apotu kisiriamata idwe luka Isirael ejaas kinyamat ka akipi, konye koropata Baalam aluikin kes, aiken kes: konye kituluo Edeke ekenit araun arereŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.2",
            "verseOrgIds": [
              "NEH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.2"
              },
              "items": [
                {
                  "text": "Nek 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.27"
              },
              "items": [
                {
                  "text": "Yak 1:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, kedaut apupun ikisila, kosodete atiakar kotoma Isirael erioŋet kere loka imo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eroko ŋun keiaikina, abu Eliasib esasedoti loaseunitai apolokin agolai nuka etogo loka Edekewok, naarar ekamuran loka Tobia, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.4",
            "verseOrgIds": [
              "NEH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kitemokinite Tobia agola naepol, nelem ibwaanakinete ainakineta nuka akiria, ka lueur maa, ka iboro, ka lukitomoneta luka akima ka ebino ka akinyet, nuainanakinio Elebin, ka kiyaook, ka ikagolok kaieorakinet; ka ainakineta nuikearitai nuka isasedotin. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.5",
            "verseOrgIds": [
              "NEH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.5.14"
              },
              "items": [
                {
                  "text": "Nek 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kapakio kanun kere kamamei eoŋ koYerusalem: naarai kokaru loka akaisauni ka luarei loka Aratasasata ekabaka loka Babulon, abu kalot mama ejai ekabaka, kosodi ketuboros apaarasia kenitu ekabaka: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.6",
            "verseOrgIds": [
              "NEH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kabu Yerusalem, kajenu aronis naabu Eliasib kiswama kanuka Tobia, aitemokin ŋes agola kalaroi nuka etogo loka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.7",
            "verseOrgIds": [
              "NEH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Sab 69:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.15+MRK.11.16+MRK.11.17"
              },
              "items": [
                {
                  "text": "Mk 11:15-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.13"
              },
              "items": [
                {
                  "text": "Yok 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ketakadik eoŋ noi: ŋes ainakin acakar kina iboro kere luka Tobia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.8",
            "verseOrgIds": [
              "NEH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.29.5"
              },
              "items": [
                {
                  "text": "2 Siit 29:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi aicorakin, kitesegaasi agolai: kayau do bobo iboro luka etogo loka Edeke, ka ainakineta nuka akiria ka lueur maa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        }
      ]
    },
