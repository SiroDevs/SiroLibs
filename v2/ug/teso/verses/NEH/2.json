                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, kolap Nisan, kokaru loka akaisaarei loka Aratasasata ekabaka, naajaar ebino kakonyeneke, abu kayaŋa ebino, kainak ekabaka.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.1",
            "verseOrgIds": [
              "NEH.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam lem kakadanakini kakonyeneke. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.1",
            "verseOrgIds": [
              "NEH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.15.13"
              },
              "items": [
                {
                  "text": "Awa 15:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kabala ekabaka eoŋ atiar, “Inyo bo lolo ekadakinitotor akonikonycn, naarai mam jo ideka? Mam na erai acekirot dimarai akadakinite nakotau.” Kasodi akurianar noi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.2",
            "verseOrgIds": [
              "NEH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.31"
              },
              "items": [
                {
                  "text": "1 Ika 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.4"
              },
              "items": [
                {
                  "text": "Dan 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.10"
              },
              "items": [
                {
                  "text": "5:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.3"
              },
              "items": [
                {
                  "text": "Nek 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.137.5"
              },
              "items": [
                {
                  "text": "Sab 137:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi katema ekabaka ebe, “Kobusenenei ekabaka ikar kere: ti inyo kisimiki akakonyen akadakinite, emejeiki ere, aibois naka atesin nuka lukapapaaka, iruteike da ecwei kakim?” ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.3",
            "verseOrgIds": [
              "NEH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.1.13"
              },
              "items": [
                {
                  "text": "1 Sam 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.6"
              },
              "items": [
                {
                  "text": "Awa 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ekabaka atemar eoŋ atiar, “Ilipit inyo?” Kelip do Edeke loka akui. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.4",
            "verseOrgIds": [
              "NEH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katema eoŋ ekabaka atiar, “Arai kitojok ekabaka, arai edumunit ekonikeiaanakinan asianut kakonyenekon, kijukarai Yuda, ore loka atesina nuka lukapapaaka, kaduk.” ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.5",
            "verseOrgIds": [
              "NEH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.5.14"
              },
              "items": [
                {
                  "text": "Nek 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Katema ekabaka eoŋ atiar (eboie akabaka da kidunyas kaŋes),” Erai bo akonilosit naka apaarasia imwaasi ai? Ido ibonuni wori?” Kitoiok ekabaka aijukar eoŋ: ketodik apak. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.6",
            "verseOrgIds": [
              "NEH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo da katema ekabaka atiar, “Arai itojokit ekabaka kainakin ibaluan mama ejaas lukibukui lukokekwa juwai, tetere kacamakinio atubor adolore toma Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.7",
            "verseOrgIds": [
              "NEH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.10.6"
              },
              "items": [
                {
                  "text": "Esr 10:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.10.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.7"
              },
              "items": [
                {
                  "text": "Nek 3:7",
                  "type": "text"
                }
