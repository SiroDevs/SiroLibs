                  "text": "Nek 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi aiyatakin neejai erute loka Ecor kiton Atapar naka Ekabaka: konye komameun erot lotikitor etianaka loebwanenit. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.14",
