                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.14"
              },
              "items": [
                {
                  "text": "Isa 66:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.9"
              },
              "items": [
                {
                  "text": "Dan 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.10"
              },
              "items": [
                {
                  "text": "Asw 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka ebalua da mama ejai Asap ekedaran laka amagoro naka ekabaka, tetere kainakini akito aiswamaunia abaoi nuka irutei luka etogo lokagogon loidunyasi etogo, ido nuka arwatat naka ere, nuka etogo da loalomari.” Kiyu ekabaka, kanuka akan nakaiokan naka Ekadeke naajai kaeoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.8",
            "verseOrgIds": [
              "NEH.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
