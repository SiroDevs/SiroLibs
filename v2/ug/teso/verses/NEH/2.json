                "loc": "EZR.8.32"
              },
              "items": [
                {
                  "text": "Esr 8:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi abunore Yerusalem, kadau kanen apaarasia auni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.11",
            "verseOrgIds": [
              "NEH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanyou kuare, eoŋ nepepe kituna luikidioko; ido mam abu kalimok etuŋanan nuabu Ekadeke kibwaik otauka aiswamakin Yerusalem: kwabo amamei ecetian kere dimarai etiaŋ loebwanenit. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.12",
            "verseOrgIds": [
              "NEH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
