            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.10"
              },
              "items": [
                {
                  "text": "Yer 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kaloma kuare korute loka Aditot, mama ejai Atan naka Apiu, orute da loka Aoret, kasodi aiŋic arwatatin nuka Yerusalem nuebilibilunos, ka iruteike lueewei kakim. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.13",
            "verseOrgIds": [
              "NEH.2.13"
            ]
          }
        },
        {
