            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi kadoka kuare kaguurut, aiŋic arwatat; kebelokin, kaloma korute loka Aditot, kabon kwaŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.15",
