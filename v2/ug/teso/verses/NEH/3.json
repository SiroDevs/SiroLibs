            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiteteut isasedotin kuju kerute loka Ibalasin, nolitunanan neasesenas keketogo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
