                {
                  "text": "Esr 2:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Malakiya okoku loka Karim, ka Kasub okoku loka Pakat-moab, kiteteut ecewai, ka etogo loeoia loka iupa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
            "verseOrgIds": [
              "NEH.3.11"
            ]
          }
        },
