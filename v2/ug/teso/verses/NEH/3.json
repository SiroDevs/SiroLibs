          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotupakis ŋes Ilebin, Rekum okoku loka Bani aiteteun. Kotupakin ŋes Kasabia, ekayaiton atutubet naka ebuku loka Keila, aiteteun kanuka ebukuke. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
        },
        {
