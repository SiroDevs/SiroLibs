                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (Kiboienenete Inetinim koOpel aitodol aibois naesesenas kerute loka Akipi kokide, ka etogo locoja loelitoro kina.) ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
        {
