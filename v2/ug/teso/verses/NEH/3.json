          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotupakis Itekoin aiteteun ewai ece, loesesenas ketogo loeoja loepol loelitoro kina, aitodol arwatat naka Opel,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
