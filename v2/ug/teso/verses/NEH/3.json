            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kiteteut ikatatak luka esabu ka ikagwelanarak kidiŋ kaneadokarere agor ka erute loka Amerekekin.",
          "type": "text",
