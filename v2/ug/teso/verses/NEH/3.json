              "type": "text"
            }
          ]
        },
        {
          "text": " Kiteteut Yoiada okoku loka Pasea ka Mesulam okoku loka Besodeia erute lomoion, kopesikis abaoike, kosipokis ikiriginike, ka igolisike, ka atiketake. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.6",
            "verseOrgIds": [
              "NEH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
