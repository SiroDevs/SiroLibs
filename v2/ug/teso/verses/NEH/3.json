              "items": [
                {
                  "text": "Nek 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupakinete kes Melatia Egibeonit, ka Yadon Emeronotit, ituŋa luka Gibeon, ka luka Misipa, aiteteun, naarai keraas lukeyait lokebuku lokokekwa juwai. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.38"
              },
              "items": [
                {
                  "text": "Nek 12:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupakin ŋes Usial okoku loka Karakaia ikatatak luka esabu, aiteteun. Kotupakin ŋes Kanania ediopet kokenyalak aures, aiteteun, kitogogonoto Yerusalem kiton arwatat naelal. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotupakin kes Rapaia okoku loka Kur, ekayaiton loka atutubet naka ebuku loka Yerusalem aiteteun. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotupakin kes Yedaia okoku loka Karumap aiteteun neesesenas ketogoke. Kotupakin ŋes Katus okoku loka Kasabaneia aiteteun. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
