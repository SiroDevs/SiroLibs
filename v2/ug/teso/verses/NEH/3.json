                  "text": "Yer 19:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupakin Sadok okoku loka Imer aiteteun neasesenas keketogo. Kotupakin Semaia okoku loka Sekania ekagolon erute lokokide aiteteun. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.29",
            "verseOrgIds": [
              "NEH.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotupakinete Kanania okoku loka Selemia, ka Kanun okoku lokikanyetekape loka Salap, aiteteun ewai ece. Kotupakin Mesulam okoku loka Berekia aiteteun neasesenas kakegola. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotupakin Malikiya ediopet kokatatak luka esabu aiteteun aitodol togo loka Inetinim, ka loka ikagwelanarak, loasesenas kerute loka Kamipikad, aitodol neadokareren agor. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 3:32"
          },
          "items": [
