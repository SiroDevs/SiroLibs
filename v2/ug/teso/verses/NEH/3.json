            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupakin ŋes Baruk okoku loka Sabai aiteteun ewai ece kakukuranut, anyoun kaneekudio arwatat kiton okek loka etogo loka Eliasib esasedoti lopeti. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.20",
