            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.6.1"
              },
              "items": [
                {
                  "text": "Nek 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodukoto odwe luka Kasenaa erute loka Lukecor; kopesikis abaoike, kosipokis ikiriginike, ka igolisike, ka atiketake. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotupakin kes Meremot, okoku loka Uria, okoku loka Kakos, Kotupakin kes Mesulam okoku loka Berekia, okoku loka Mesesabel aiteteun. Kotupakin kes Sadok okoku loka Baana aiteteun. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.23"
              },
              "items": [
                {
                  "text": "Tub 5:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupakinete kes Itekoin aiteteun: konye mam isotiakec ibwaikinito imurisiŋakec aswam naka ejakaitikec.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        }
