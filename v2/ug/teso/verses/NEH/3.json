                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupakinete ŋes ituŋa luka Yeriko aiduk. Kotupakin kes Sakur okoku loka Imiri aiduk, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        },
        {
