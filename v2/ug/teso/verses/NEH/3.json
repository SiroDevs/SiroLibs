            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotupakinete kes Benyamin ka Kasub aiteteun neasesenas kekeeetogo. Kotupakin Asaria okoku loka Maaseia okoku loka Anania aiteteun osiep loka etogoke. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotupakin Binui okoku loka Kenadad aiteteun ewai ece, anyoun kotogo loka Asaria aitodol neakudokinia arwatat, ka aitodol agor da. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
            "verseOrgIds": [
              "NEH.3.24"
            ]
          }
        },
