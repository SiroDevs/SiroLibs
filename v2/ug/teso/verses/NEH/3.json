                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupakis ŋes ikeeeinaean, Babai okoku loka Kenadad, ekayaiton loka atutubet naka ebuku loka Keila aiteteun. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
