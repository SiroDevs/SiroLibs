                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " irwanipu kotoma alosit, karonis naka icorin, karonis naka ikaŋatak, karonis naka Iukatekereka, karonis naka Imo, karonis kotoma oreria luepolok, karonis nakotoma amodiŋ, karonis nakotoma aŋolol, karonis naka iinacan lukeŋalak; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
