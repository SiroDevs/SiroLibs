                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ko Damasiko, abu ekayaiton loka Areta ekabaka kidar ere loka Damasiko tetere kekamuni, ",
          "type": "text",
