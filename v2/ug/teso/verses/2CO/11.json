                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Komam imarakinit nukokiŋa, ejai nakalanirikinit tiritir, ŋes aiyaloŋoŋ kanuka ikanisan kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
