                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iŋai bo ekalanyana, komam eoŋ da akalanyana? Iŋai bo kitiguikinitai, komam eoŋ da anoki?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
