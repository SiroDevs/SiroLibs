                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Edeke Papa loka Ejakait Yesu loituritoi ikar kere ejeŋi ebe mam eŋalai, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
