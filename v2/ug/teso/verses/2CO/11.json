                  "text": "2 Kor 6:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kaitaaritoi ka ailolony, irwan ipu kotoma aikoler, kotoma eteŋei ka akure, irwan ipu kotoma ailuŋ, kaaterot ka amujalal da. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
        {
