              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.3.4"
              },
              "items": [
                {
                  "text": "Pes 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye karaida arai eoŋ lomam ajeni einer, mere kwaŋin kotoma acoa; konye koponesio kere kitodia ŋin kakiro kere mamakus,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.6",
            "verseOrgIds": [
              "2CO.11.6"
            ]
          }
        }
      ]
