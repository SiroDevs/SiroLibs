              "attrs": {
                "loc": "2CO.2.13"
              },
              "items": [
                {
                  "text": "2:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.113.6"
              },
              "items": [
                {
                  "text": "Sab 113:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.138.6"
              },
              "items": [
                {
                  "text": "138:6",
