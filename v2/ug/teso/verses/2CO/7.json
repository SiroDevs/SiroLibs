                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.2"
              },
              "items": [
                {
                  "text": "Isa 66:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye Edeke, loitalakari luitisilitoi, abu kitalaka sio kanuka abunore naka Tito; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.6",
            "verseOrgIds": [
              "2CO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwabo mere kanuka abunoreke bon, konye kanuka aitalakario nakitalakario ŋes kamakus, kolimonok sio akiro nuka eimielikus, nuka akuudianakus, ka adunyanutukus kanukaŋ, ŋes eyatakinia alakar. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.7",
            "verseOrgIds": [
              "2CO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.4"
              },
              "items": [
                {
                  "text": "2 Kor 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai karaida abu kesiturur yes kanuka ebaluaka, mam eitokina, (karaida abu keitok,) naarai aany ebe abu ebalua ŋol kisiturur yes, karaida adaun apak naedit. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.8",
            "verseOrgIds": [
              "2CO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kwana aleli, mere naarai kitururuoto, dimarai naarai kitururuoto kiton aitoronikin; naarai ipotu kitururuoto mama ejai Edeke, kinyeis atwakiar akirot kere kamakosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.9",
            "verseOrgIds": [
              "2CO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.3+MAT.27.4+MAT.27.5"
              },
              "items": [
                {
                  "text": "Mat 27:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.17"
              },
              "items": [
                {
                  "text": "Bur 12:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai aiturur mama ejai Edeke iswamai aitoronikin, kiton aitajario namam iitokin, konye aiturur naka akwap iswamai atwanare. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.10",
            "verseOrgIds": [
              "2CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai koany aiturur ŋin mama ejai Edeke abu kiswamak yes adunyanut naetia nen, aiyara da, ka anyunyura, ka akurian, ka eimiel, ka akukuranut, ka ainyaŋ da. Kaŋinikirot itodiara yesi araut luilaete kotoma aswamisioit kaŋin, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.11",
            "verseOrgIds": [
              "2CO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso karaida kewadikakinit yes, mere kanuka yenekonit erono, karaida kanuka ŋin yenikikonakinitai erono, dimarai kitoduunai adunyanutukus kanukosi mamakus kakonyen nuka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.12",
            "verseOrgIds": [
              "2CO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka ŋun kitalakaritai.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.13",
            "verseOrgIds": [
              "2CO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo da kotoma aitalakariokosi kipou kalelata noi jokan kanuka aile! naka Tito, naarai ipotu yesi kere kisiyenut ekemoyo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.13",
            "verseOrgIds": [
              "2CO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai arai abu kaolobobote kamakeŋ kotoma akirot kere kanukus, mam kesurumitai ileic; konye kwape kiilimonokinitor yes akiro kere kabeit, kwape kwaŋin da aolobobotekosi kama ka Tito kerai nakabeit. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.14",
            "verseOrgIds": [
              "2CO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.9"
              },
              "items": [
                {
                  "text": "2 Kor 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido iyatanakin aminake mamakus, naiitunio kwape irimatar kere, kwape kisukunyikiniata ŋes kakurian ka amaran. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.15",
            "verseOrgIds": [
              "2CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aleli naarai kotoma ŋinikirot icasit amunoka kanukus.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.16",
            "verseOrgIds": [
              "2CO.7.16"
            ]
          }
        }
      ]
    }
  ],
