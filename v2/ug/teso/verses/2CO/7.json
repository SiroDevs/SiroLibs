        },
        {
          "text": "Aso luminan, naarai kija kaisumuneta ŋun, ketesegaaros kotoma asilianut kere naka akuan ka naka emoyo da, ketodoloto alaunit kotoma ayoŋit Edeke.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.1",
            "verseOrgIds": [
              "2CO.7.1"
            ]
          }
        }
