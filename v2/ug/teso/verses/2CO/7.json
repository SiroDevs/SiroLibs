                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koinakinai apak kotauonokus; mam kikonakinit idiotuŋanan erono, karaida amunaar idiotuŋanan, mam da kirodit idiotuŋanan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.2",
            "verseOrgIds": [
              "2CO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.11+2CO.6.12+2CO.6.13"
              },
              "items": [
                {
                  "text": "2 Kor 6:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam enera akirot ŋin tetere atubokini yes, naarai abu kenerite sek ebe ijaas yes otauonokosi, kiton atwanare nepepe ka aijar da nepepe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.3",
            "verseOrgIds": [
              "2CO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kija katitiŋ naepol mamakus; kija kaolobob naepol kanukus; ileleba eoŋ alakara. Ilapara noi aileleka kotoma aiticaniokos kere.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.4",
            "verseOrgIds": [
              "2CO.7.4"
            ]
          }
        }
      ]
    },
