              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai aolobobotekosi ŋes nata, ajenanut naka aomisiokosi ebe kipou kalosenenete kotoma akwapin aitelekarit mamakus, kotoma alaunit ka aipioror naka emoyo loebuni kama ejai Edeke, mere kanuka acoa naka akuan, dimarai kanuka asianut naka Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai mam kiwadikakinit yes akirot dimarai nuipedorete asoman ka ajenun, ido amuno ebe ijenunete ŋun kiton awasia, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
