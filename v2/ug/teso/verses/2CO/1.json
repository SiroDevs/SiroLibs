              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwape ipotu kojenuniata ace kamakosi, ebe kirai isio aolobobotekus, kwape irauniata yesi da nakosi, kapaaran naka Ejakaitiwok Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
