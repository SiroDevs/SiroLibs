                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kituritete Edeke Papa loka Ejakaitiwok Yesu Kristo, Papa loka aitim, Edeke da loka aitalakar kere, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokitalakarit oni kotoma aiticanitoiwok kere, tetere oni da kipedori aitalakar ŋul luejaas toma aiticanitoi kere, kaitalakar ŋin nakitalakaria Edeke oni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.19"
              },
              "items": [
                {
                  "text": "Sab 34:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.94.19"
              },
              "items": [
                {
                  "text": "94:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kwape iyatanakinor ariebo naka Kristo kamawok, kwape kwaŋin da iyatanakinor aitalakariowok kanuka Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.15"
              },
              "items": [
                {
                  "text": "2 Kor 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai kiticanitoi sio, erai kanuka aitalakariokus ka aitajariokus da; ido arai kitalakario sio, erai kanuka aitalakariokus naeyauni atitiŋikin kariebo ŋin nakisiriebio sio da. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icasit amunokosi kanukus; naarai kijeni ebe kwape imoriata ariebokosi, imorete kwape kwaŋin aitalakariokosi da.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
    },
