            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai, iinacan, mam kikoto yes kinyeis ajenun aiticanitoi nakidoikinit sio ko Asia, ebe kinuaritai noi noi adepar apedorikosi, komam kiwomit aijar. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabo kipou isio kapuput atwanare kotomakosi, kenyeis amunokina bonik, dimarai Edeke loitajaruni lukatwak; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.18"
              },
              "items": [
                {
                  "text": "2 Tim 4:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ŋ es abu koyuu sio kotoma atwanare naetia nen, ido kiyuuni, lokimunokina ebe iyatanakini ayuun, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yes da kiŋarakinos ailipanakin sio, tetere imalaete luipu kanukosi, kanuka ainakinet nakiinakinitai sio kanuka ailip naka ituŋa luipu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
