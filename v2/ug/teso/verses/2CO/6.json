            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kiswamai nepepe kaŋes, kiŋaiŋait yes sirikicamut asianut naka Edeke atitai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.1",
