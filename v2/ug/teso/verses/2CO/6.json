            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikienikinos ajookot nepepe kalumam iyuunito. Naarai emorete biai adolit ka amamus adolit? Arai ejai eidicane enyoin kidiŋ kaica ka amuton? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.14",
            "verseOrgIds": [
              "2CO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyoin da acamanara naka Kristo ka Belial? Arai bo anyoin akorakinet naka yeniyuunit ka yenimam iyuunit? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
