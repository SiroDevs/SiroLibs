                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kotoma aleconorio, kotoma aenio, kotoma iceleta, kotoma aitaaritoi, kotoma aikolerit, kotoma ailuŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.5",
            "verseOrgIds": [
              "2CO.6.5"
            ]
          }
        },
        {
