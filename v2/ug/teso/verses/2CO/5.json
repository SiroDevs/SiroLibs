          ]
        },
        {
          "text": " Aso kititiŋikini oni apaarasia kere, naarai kijeni ebe nakijaar toma akuan, kilwaniar kama ejai Ejakait, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.6",
            "verseOrgIds": [
              "2CO.5.6"
