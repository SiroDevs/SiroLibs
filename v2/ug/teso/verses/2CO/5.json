                {
                  "text": "Rom 8:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kane kidinya kabeit, kemielas noi aitanapio etogowok loebuni kokuju, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.2",
            "verseOrgIds": [
              "2CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
