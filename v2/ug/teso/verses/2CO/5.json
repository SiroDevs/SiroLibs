                  "text": "Pil 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun kititiŋikini, kikoto alwaniar kakuan, kajaut die ka Ejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.8",
            "verseOrgIds": [
              "2CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
