              "items": [
                {
                  "text": "Sab 39:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kigipari aisiyalamikin Ejakait, arai kija die arai kilwaka da. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.9",
            "verseOrgIds": [
              "2CO.5.9"
            ]
          }
        },
        {
