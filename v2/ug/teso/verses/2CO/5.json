                {
                  "text": "1 Kor 15:53",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kidinya oni lukija toma oswam yen, naarai kilaŋirikinito; mam kikoto alacar, konye aitanapio, tetere ejwenyari aijar yenetwani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
        {
