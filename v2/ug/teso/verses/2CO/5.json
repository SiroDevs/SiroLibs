            "number": "3",
            "style": "v",
            "sid": "2CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kosodi nakitanapere, kenyeis atakanun kimujalal. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.3",
            "verseOrgIds": [
              "2CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 5:4"
          },
          "items": [
