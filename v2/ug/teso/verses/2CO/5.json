                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kibusakinit kere atakanun koiŋaren keicoloŋ loka aitub loka Kristo; kodum ŋinituŋanan nukiswamai akuanake, kwape eswamator, arai nuejok arai nueroko.",
          "type": "text",
          "attrs": {
