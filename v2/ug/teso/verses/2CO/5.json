                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai kilosi kanuka aiyuun mere kanuka aanyun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.7",
            "verseOrgIds": [
              "2CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
