              "type": "text"
            }
          ]
        },
        {
          "text": " Aso naarai kijeni ayoŋit Ejakait, kijodouni ituŋa; konye kitakanunitai sio kakonyen nuka Edeke, ido amuno ebe kitakanunitai kotoma aomisiokus da. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.11",
            "verseOrgIds": [
              "2CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
