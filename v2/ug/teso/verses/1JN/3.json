              "items": [
                {
                  "text": "1 Yok 5:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koanyut amin naetia nen nakiinakinit Papa oni, tetere kinyaritai idwe luka Edeke, kirai da. Kanuka ŋun ŋes mam akwapin kijeniata oni, naarai mam apotu kojenut ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.1",
            "verseOrgIds": [
              "1JN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 3:2"
          },
          "items": [
