              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.12"
              },
              "items": [
                {
                  "text": "15:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai na ŋes aitejenunet naipotu kopuput ameun kageunet, ebe, kaminanaros. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.11",
            "verseOrgIds": [
              "1JN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.8"
              },
              "items": [
                {
                  "text": "Age 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mere kwape Kain, lokerai loka lokaronon, koar da onaceke: Ido kanukinyo kearia ŋes? Naarai keroko akeswamisio, kwabo kedolito nuka onaceke.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.12",
            "verseOrgIds": [
              "1JN.3.12"
            ]
          }
        }
      ]
    },
