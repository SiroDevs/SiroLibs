                "loc": "2CO.3.18"
              },
              "items": [
                {
                  "text": "2 Kor 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.21"
              },
              "items": [
                {
                  "text": "Pil 3:21",
