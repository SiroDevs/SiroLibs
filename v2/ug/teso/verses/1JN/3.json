                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.18"
              },
              "items": [
                {
                  "text": "Yok 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikiwumokis, iinacan, arai kilaete akwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.13",
            "verseOrgIds": [
              "1JN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.24"
              },
              "items": [
                {
                  "text": "Yok 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.11"
              },
              "items": [
                {
                  "text": "1 Yok 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijeni oni ebe kipou kanyoutu katwanare alomar aijar, naarai kimina iinacan. Yenimam emin esalit toma atwanare. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.14",
            "verseOrgIds": [
              "1JN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
