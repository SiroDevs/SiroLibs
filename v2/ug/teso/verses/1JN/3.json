              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.28"
              },
              "items": [
                {
                  "text": "1 Yok 2:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
