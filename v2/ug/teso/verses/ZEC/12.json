                  "text": "Apu 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abukokini ekek loka Daudi, ka luibojete koYerusalem, emoyo loka asianut ka loka aiŋaiŋa; esesenete ŋol loapotu kicumata: ibworos ŋes, kwape ibworor ituŋanan okokuke loteluna, ekuudiani ŋes, kwape yenekuudiani ekiyaike. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
