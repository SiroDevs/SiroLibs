                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapaaran kaŋin ejaun aibworo naepol ko Yerusalem, kwape aibworo naka Kadad-rimon kaditot naka Megidon, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibworos lukakwap, ŋolikek kowaike; ekek loka etogo loka Daudi kowaike, ka akecenor kowaikee; ekek loka etogo loka Natan kowaike, ka akecenor da kowaikee; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekek loka etogo loka Lebi kowaike, ka akecenor kowaikee; ekek loka Isimein kowaike, ka akecenor kowaikee; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikekia kere luedeunos, nolikek kowaike, ka akecenor da kowaikec.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
