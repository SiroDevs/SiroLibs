            "number": "8",
            "style": "v",
            "sid": "ZEC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobala ebe, “Na ŋes Aronis”; koeaka ŋes kotoma epa, kocaka alaniru naka asasit kaitukuke, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.8",
            "verseOrgIds": [
              "ZEC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasodi aiteluor akakonye, kete, ido koany, kolomut aŋor aarei. Kojai ekwam kabebenokakec; ajaas kes kabebenoka kwape abebenoka nuka etolut: kodakasi epa kidin kakwap ka akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.9",
            "verseOrgIds": [
              "ZEC.5.9"
            ]
          }
        },
        {
