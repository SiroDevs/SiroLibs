          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasodi eoŋ atemar emalaika lokinera keoŋ atiar, “Ai bo eyaŋaarete nu epa?” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.10",
