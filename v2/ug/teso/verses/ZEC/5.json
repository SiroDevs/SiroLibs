              "type": "text"
            },
            {
              "text": "tepa itemi alaŋir",
              "type": "text"
            }
          ]
        },
        {
          "text": " loelosi.” Ido kotema atiar, “Ŋin ŋes numam adolit kakwap kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.6",
            "verseOrgIds": [
              "ZEC.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
