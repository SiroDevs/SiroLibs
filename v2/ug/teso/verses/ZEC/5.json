          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido koany, aponi kikeunai arapetait naka asasit, ido kiboie aberu kotoma epa! ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.7",
            "verseOrgIds": [
              "ZEC.5.7"
            ]
          }
        },
        {
          "name": "verse",
