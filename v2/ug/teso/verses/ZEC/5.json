              "type": "text"
            }
          ]
        },
        {
          "text": "Kabala ebe, “Inyo bo ii?” Kotema atiar, “Ŋin ŋes epa ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.6",
            "verseOrgIds": [
              "ZEC.5.6"
            ]
          }
        },
        {
