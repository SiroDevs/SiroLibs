                "loc": "EZK.34.2"
              },
              "items": [
                {
                  "text": "Esk 34:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kabala EJAKAIT eoŋ ebe, “Kolemu bobo iboro luka ekeeokon loebanaana. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.15",
            "verseOrgIds": [
              "ZEC.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai koany, adakuni ekecokon kakwap, lomam epod lueoliorito, karaida amoot luesiarakina, karaida aider luebilil; mam da itadaki luicasito, konye enyami ŋesi akiriŋ naka luetumitos, ecilicilei imagegerekee.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.16",
            "verseOrgIds": [
              "ZEC.11.16"
            ]
          }
        }
