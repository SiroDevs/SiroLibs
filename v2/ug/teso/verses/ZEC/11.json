            }
          ]
        },
        {
          "text": "Abu EJAKAIT Ekadeke kiner kwanata ebe: “Korau ijo ekecokon loka esipan loebuni aario. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.4",
            "verseOrgIds": [
              "ZEC.11.4"
            ]
          }
