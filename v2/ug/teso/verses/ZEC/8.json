                {
                  "text": "Nak 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ebala kwanata EJAKAIT loka ajoresio ebe: Ekokotikin Sion kekokote loepol, ekokotikin ŋes kanyunyura naepol. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.2",
            "verseOrgIds": [
              "ZEC.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 8:3"
          },
