        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.21"
              },
              "items": [
                {
                  "text": "Isa 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
