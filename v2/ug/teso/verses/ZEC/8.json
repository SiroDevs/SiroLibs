                  "text": "1 Tim 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ejaunos ikinyom luka ainapakin; einakini emusabibu araitoke, einakinete alup amiokec, einakini da akuj akopyoke; esurumi da aatoŋot naka ituŋa kalu iboroŋul kere. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.12",
            "verseOrgIds": [
              "ZEC.8.12"
            ]
          }
        },
