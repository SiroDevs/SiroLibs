              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu akirot naka EJAKAIT loka ajoresio mama ajai ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.1",
            "verseOrgIds": [
