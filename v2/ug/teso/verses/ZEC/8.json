              "items": [
                {
                  "text": "Yer 31:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inera EJAKAIT kwanata ebe: Aboŋuni eoŋ Sion, eboienenei kokidin Yerusalem: emaikinio Yerusalem Ere loka abeit: ka eronat da loka EJAKAIT loka aioresio Eronat lokalaunan. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.3",
            "verseOrgIds": [
              "ZEC.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.31"
              },
              "items": [
                {
                  "text": "1 Sam 2:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.20"
              },
              "items": [
                {
                  "text": "Isa 65:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inera kwanata EJAKAIT loka ajoresio ebe: Ibojenenete imakio ka amakio bobo korotin luka Yerusalem, kitiŋite ninitunanan ebelake loitabia kakanike naarai amoion noi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.4",
            "verseOrgIds": [
              "ZEC.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilelebunos irotin luka ere itelepai ka apesur koboliasi korotinike. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.5",
            "verseOrgIds": [
              "ZEC.8.5"
            ]
          }
        },
        {
