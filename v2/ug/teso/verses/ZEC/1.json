            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Toma olap lokikanyetekauni, kokaru lokiareit loka Dario, kobu akirot naka EJAKAIT mama ejai Sekaria okoku loka Berekia, okoku loka Ido, enabi, kobala ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
