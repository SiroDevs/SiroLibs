              "items": [
                {
                  "text": "Asw 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikiputokinos kalukapapaakus, luamonyanakinete inabin lusek mamakee ebe, ‘Inera EJAKAIT loka ajoresio kwanata ebe, Koboŋutu ca yesi anyoun koponesiokus lueroko, ka aswamisiokus da nueroko.’ Konye ebala EJAKAIT ebe, Mam apotu kopuput, karaida akiirar eoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai bo ejaas lukapapaakus? Inabin da, ejarenenete kereka kesi ikar kere? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.5",
            "verseOrgIds": [
              "ZEC.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Isa 55:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.1.18"
              },
              "items": [
                {
                  "text": "Aku 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye akakiro ka ikakisila lueeorakinit ikakejaanakinak inabin, mam kes apotu kodolokis lukapapaakus? Kibelokis kotemasi atiar, Kwape keomitor EJAKAIT loka ajoresio aiswamakin oni, kwape ejaatar iponesiowok, kwape ejaatar da aswamisiowok, abu kiswamak oni kwape kwaŋin.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 1:6"
          },
          "items": [
            {
              "text": "6",
