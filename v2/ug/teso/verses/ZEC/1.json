                "loc": "MIC.7.19"
              },
              "items": [
                {
                  "text": "Mik 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.7"
              },
              "items": [
                {
                  "text": "Mal 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.20"
              },
              "items": [
                {
                  "text": "Luk 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun kolimok kes ebe, Inera EJAKAIT loka ajoresio kwanata ebe: Ebala EJAKAIT loka ajoresio ebe, Koboŋutu neajai eoŋ, Ebala EJAKAIT loka ajoresio ebe, Eoŋ da aboŋuni mama ijaas, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
