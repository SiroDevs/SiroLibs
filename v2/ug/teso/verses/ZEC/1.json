              "attrs": {
                "loc": "ZEC.7.5"
              },
              "items": [
                {
                  "text": "Sek 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi emalaika loka EJAKAIT aboŋokin ebe, ‘Wu EJAKAIT loka ajoresio, itodoli ai mam itimi Yerusalem, ka ireria luka Yuda, luinyunyurikinit ijo ikar lu akaisakanykaarei?’ ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
