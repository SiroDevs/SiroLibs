                "loc": "ZEC.8.2"
              },
              "items": [
                {
                  "text": "Sek 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Katema do emalaika lokinera keoŋ ebe, ‘Kiworo ijo ebe, Inera EJAKAIT loka ajoresio kwanata ebe: Ekokotikin noi Yerusalem ka Sion kekokote loepol. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
