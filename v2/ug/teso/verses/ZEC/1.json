              "items": [
                {
                  "text": "Yer 29:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋok EJAKAIT emalaika lokinera keoŋ kakiro nuejok, kes akiro nuitalakarete, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.13",
            "verseOrgIds": [
              "ZEC.1.13"
            ]
          }
        },
