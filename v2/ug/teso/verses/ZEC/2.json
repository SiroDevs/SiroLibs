              "ZEC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
