              "items": [
                {
                  "text": "Rom 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kililinata, awat kere, kakonyen nuka EJAKAIT: naarai akwenyu ŋesi anyoun kaiboisike nakalaunan.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
