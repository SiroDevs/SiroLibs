              "items": [
                {
                  "text": "Mik 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJAKAIT loka ajoresio ebe, Ipudapudaete yesi ikaronok; naarai eraunos ekurwon kotauon luka akeiekus kapaaran naeswamaa,",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
