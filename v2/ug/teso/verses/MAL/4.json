        },
        {
          "text": "“Naarai ebala EJAKAIT loka ajoresio ebe, Koany, ebunit apaaran, esarani bala eupa; craunos luituros kere, ka luiswamaete aronis kere ariaŋ: icwei kes apaaran naebunit, mam ideikini kes aliasit karaida atenu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
