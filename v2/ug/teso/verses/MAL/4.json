              },
              "items": [
                {
                  "text": "2 Pet 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye yes luiyonito ekakiror elomuni kanukus akoloŋ naka adolit ejai kaitanaleun kotoma abebenokake. Ilosete yesi icuros bala itak keŋaun kauj. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
