              "MAL.2.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.51.2"
              },
              "items": [
                {
                  "text": "Isa 51:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.9"
              },
              "items": [
                {
                  "text": "Mat 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.8.6"
              },
              "items": [
                {
                  "text": "1 Kor 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.9"
              },
              "items": [
                {
                  "text": "Bur 12:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.100.3"
              },
              "items": [
                {
                  "text": "Sab 100:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mere kereka papawok kere ediopet? Mere kereka Edeke ediopet kisubuni oni? Kanukinyo kimodia oni ŋinituŋanan onaceke, aibil aitutuket naka lukapapawok? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.10",
            "verseOrgIds": [
              "MAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.23"
              },
              "items": [
                {
                  "text": "Nek 13:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abil Yuda ebotet, eswama naketale kolsirael ka Yerusalem; naarai amuna Yuda alaunit naka EJAKAIT naemin, amany akoku naka edeke lomoit. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.11",
            "verseOrgIds": [
              "MAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emudiari EJAKAIT ŋol Joekwenyi ka ŋol loebonokini, koweman luka Yakob, ka ŋol loeinakini ainakinet mama ejai EJAKAIT loka aioresio, kama ejai ituŋanan yeniswamai ŋun.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iswamaete da bobo nu: irapiarete etem laka EJAKAIT kakiyo, ka aimony, ka eidiny, naarai mam bobo eseseni ainakinet, karaida aeamun kasianut kakanikus, ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.13",
            "verseOrgIds": [
              "MAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye ibalas ebe, “Kanllkinyo?” Naarai arai EJAKAIT ekaienanikon ka aberu naka atumunikon, nakimodomodoi ijo, kwabo erai apaupakon, ka aberu naka aitutuketekon. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.14",
            "verseOrgIds": [
              "MAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.4"
              },
              "items": [
                {
                  "text": "Mat 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam ŋes abu kosub idiopet, karaida abu kideu emoyo? Kanukinyo idiopet? Abu komo aur naejok, Aso do kocoito ikusimoyon, kinyek idiopet amodomod aberu naka atumunike. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.15",
            "verseOrgIds": [
              "MAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.1"
              },
              "items": [
                {
                  "text": "Ikis 24:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ebala EJAKAIT Edeke loka Isirael ebe, “Alait aireŋear, ŋin da yenerapiarit ekegoe kadedeŋ. Ebala EJAKAIT loka aioresio ebe, Aso, do koeoito ikusimoyon, kinyeis amodomod.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itapasata EJAKAIT kakusikiro, Kwabo ibalas ebe, “Kitapasa nes biai?” Naarai ibalas ebe, “ŋinituŋanan yeniswamai aronis ejok kakonyen nuka EJAKAIT, ido isiyalamikinit nes.” Arai ebe, “Ai bo ejai Edeke loka etube?”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.17",
            "verseOrgIds": [
              "MAL.2.17"
            ]
          }
        }
