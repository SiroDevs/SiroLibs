              "type": "text"
            }
          ]
        },
        {
          "text": "Akiro nuka Ekalimonokinan, okoku loka Daudi, ekabaka kotoma Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
    },
