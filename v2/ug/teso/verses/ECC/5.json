                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam iituni noi apaarasia nuka aiiarake; naarai eboŋokini Edeke toma alakara naka etauke",
          "type": "text",
