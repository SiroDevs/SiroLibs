                {
                  "text": "Mat 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikilebileb kaitukukon, karaida ekonitau aisunyit einer akirot kere kakonyen nuka Edeke; naarai ejai Edeke toma akuj, ijo da toma akwap; asa kikidiokoto akonikiro.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        }
