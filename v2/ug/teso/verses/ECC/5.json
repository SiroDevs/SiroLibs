            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋol Ioikila epuesa mam imonikin epuesa; ŋol da loikila luipu mam imonikini eiyas: ŋun da eraas aamameak.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
