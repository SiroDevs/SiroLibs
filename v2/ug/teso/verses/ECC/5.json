              "items": [
                {
                  "text": "1 Tim 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikijalak aitukukon aidupor akonikuan; sirikiner kakonyen nuka emalaika ebe kerai aibucaret: kanukinyo tienyunyurikinia Edeke ekoniporoto, amudiar da aswamisio nuka akaninikon?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.6",
            "verseOrgIds": [
