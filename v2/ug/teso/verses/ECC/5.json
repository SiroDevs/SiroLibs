            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ejai aronis naepol naabu kaany kokwap kakoloŋ ŋes nata, abar nainadakinit elopet eyaŋauni aronis: ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
