              "items": [
                {
                  "text": "1 Tim 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwape kelomunia kakoik naka totoke, eboŋori emujalal kwape kelomunia, kwabo mam eyaŋaari ibore kanuka aitaaritoike yenepedori ayaŋaar kakanike. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        },
