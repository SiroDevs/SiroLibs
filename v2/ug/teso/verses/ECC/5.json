            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ejok timam kiyapo itia aiyapo kosodi akurwokin aitodolikin. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.5",
            "verseOrgIds": [
