              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ebuni airujasit kaipues naka aswamisio; eporoto loka ebaŋ da ebuni kaipues naka akiro.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
