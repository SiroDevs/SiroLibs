                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ejenete lukajarak ebe etwakete: konye mam ikatwak ejenete ibore, mam bobo edumunete eropit; naarai imurwokinio aiitunetekee. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.5",
            "verseOrgIds": [
              "ECC.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aolio kwana aminakee ka elaitikee ka ekokotekec da; mam bobo ejaas kakorakinet apaarasia kere kakiro kere nueswamao kokwap kakoloŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.6",
            "verseOrgIds": [
              "ECC.9.6"
            ]
          }
        }
      ]
    },
