            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ape do, konyamenenei ikoninyamat kaiyalama, komasenenei ebinokon ketau loelakara; naarai adau Edeke acamun aswamisiokon.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.7",
            "verseOrgIds": [
              "ECC.9.7"
            ]
