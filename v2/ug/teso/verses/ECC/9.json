                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiboienenei kaiyalama kaberu naimina apaarasia kere nuka aijarakon naatai, nakiinakinit ŋesi jo kokwap kakoloŋ, apaarasiakon kere nuutai: naarai ŋin ŋes akorakinetekon kaiiar, kakoniitaaritoi naitaaritor kokwap kakoloŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.9",
            "verseOrgIds": [
              "ECC.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋin kere yenedumuni akonikan aswam, kiswamaenenei kakonigogon; naarai emamei aswam, karaida ainerun, karaida aijen, karaida acoa, kokatwak, kama ilosi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.10",
            "verseOrgIds": [
              "ECC.9.10"
            ]
          }
        }
      ]
