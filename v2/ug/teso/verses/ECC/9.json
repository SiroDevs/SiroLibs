            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai abu kebwaik nun kere toma otauka, airot ŋun kere; kwape ejaatar ikadolitok, ka lukacoa, ka aswamisiokec toma akan naka Edeke; arai amin arai alaio, mam etuŋanan ejeŋi; ejaas kere kakonyenekee. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.1",
            "verseOrgIds": [
              "ECC.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.73.3"
              },
