              "items": [
                {
                  "text": "1 Ses 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam etuŋanan ejeŋi akepak; kwape lukecor luikamunio koboi loerono, kwape da akweny nuipokete karuja, kwape kwaŋin da ipokiata ituŋa kapak nakaronis, naenesaria kes atipet,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        }
      ]
    },
