            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido abu kaany acoa kokwap kakoloŋ naikoni ne, esubit bala epol kamakaŋ: ",
          "type": "text",
