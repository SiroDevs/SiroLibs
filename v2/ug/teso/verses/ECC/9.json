          "type": "text",
          "attrs": {
            "verseId": "ECC.9.7",
            "verseOrgIds": [
              "ECC.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kokwanuut inapenekon apaarasia kere; siriemamuunun akinyet kakoukon.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.8",
            "verseOrgIds": [
              "ECC.9.8"
            ]
          }
        }
