              "items": [
                {
                  "text": "Yer 9:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kabon, kaany kokwap kakoloŋ ebe, abolobol mam erai naka luetiroko, karaida ejie loka ikagogoŋok, karaida inyamat luka lukacoa, karaida abar naka ituŋa lukaijen, karaida asianut naka ituŋa luepiriaka; konye edoikini kes kere apak ka arereŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
