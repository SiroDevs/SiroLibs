                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.16"
              },
              "items": [
                {
                  "text": "1 Tim 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuejaas da, elwaka, ido idulok noi; iŋai bo epedori aŋicun? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.24",
            "verseOrgIds": [
              "ECC.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ECC 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kebelokin, ketininik ekatau ajenun, ka aŋicun, ka amoot acoa ka apolou naka akiro, ajenun da ebe aronis ŋes abaŋasnut, ka abaŋaanut da kes ikerep. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
            "verseOrgIds": [
              "ECC.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ECC 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kadum da akirot naitelekarit atwanare kadwaris, ŋes aberu naerai etauke iica ka iboyan, akekanin da bala irikoi: ekui ŋolloisiyalamikinit Edeke kamaken; konye ikamuni ŋesi ekadiakanaran. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ECC 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koany, ebala Ekalimonokinan ebe, Abu kadum na, kwape etiiriania akirot kakirot adumunia apolou: ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ECC 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "naerina emoot ekatau, konye mam adumunit: abu kadum ediopetunanan kotoma olukumit; konye mam abu kadum aberu kotoma kanul kere. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.28",
            "verseOrgIds": [
              "ECC.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ECC 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.27"
              },
              "items": [
                {
                  "text": "Age 1:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, abu kadum na bon ebe, kosub Edeke ituŋa itenara; konye apotu kesi komoata lupwakununa luipu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.29",
            "verseOrgIds": [
              "ECC.7.29"
            ]
          }
        }
      ]
