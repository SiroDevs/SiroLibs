          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋun kere abu ketem kacoa; kener atiar, “Araun lokacoan; konye kalwanik. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.23",
            "verseOrgIds": [
              "ECC.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ECC 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.11+DEU.30.12+DEU.30.13+DEU.30.14"
              },
              "items": [
                {
                  "text": "Ikis 30:11-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.11.12"
              },
              "items": [
                {
                  "text": "Yob 11:12",
