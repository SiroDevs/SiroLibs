          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.25.16"
              },
              "items": [
                {
                  "text": "Awa 25:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.6"
              },
              "items": [
                {
                  "text": "Pil 3:6",
