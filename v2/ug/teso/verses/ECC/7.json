              "items": [
                {
                  "text": "Rom 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikilitokin kadolitekon: karaida alitokin kacoa: kanukinyo tikimudiaror bon? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.16",
            "verseOrgIds": [
              "ECC.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.15.32"
              },
              "items": [
                {
                  "text": "Yob 15:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikilitokin karonis, karaida araut ebaŋ: kanukinyo tikitwania eriŋa edoluno apakikon? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.17",
            "verseOrgIds": [
              "ECC.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejok korie ŋun; eebo kakwa da mam ijalakini kakanikon: naarai loeyonit Edeke ebeluni kakes kere.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.18",
            "verseOrgIds": [
              "ECC.7.18"
            ]
          }
        }
      ]
    },
