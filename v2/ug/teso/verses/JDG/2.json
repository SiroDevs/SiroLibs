              "type": "text"
            }
          ]
        },
        {
          "text": "Amear kwana mam eoŋ ereŋeari kakonyenekee adio kotoma atekerin nuenyeini Yosua naatwania: ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.21",
            "verseOrgIds": [
              "JDG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
