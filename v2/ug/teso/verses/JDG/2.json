              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naatwaria Yosua ituŋa, apotu idwe luka lsirael koloto, ŋinitunanan airumeteke airum akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.6",
            "verseOrgIds": [
              "JDG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ituŋa kiiaanakis EJAKAIT apaarasia kere nuka Yosua, ka apaarasia kere nuka imakio luabusito adepar Yosua, luaanyunito aswam kere nakos naka EJAKAIT, naeswamakinit Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.7",
            "verseOrgIds": [
              "JDG.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotwana Yosua okoku loka Nun, ekejaanakinan loka EJAKAIT, korai loka ikar akwatat ka itomon. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.8",
            "verseOrgIds": [
              "JDG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.49+JOS.19.50"
              },
              "items": [
                {
                  "text": "Yos 19:49-50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kidaikis ŋes oikor loka airumeteke Timuna-keres, kakwap nakiukon naka Epuraim, kari naka agolitomei naka eronat loka Gaas. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
            "verseOrgIds": [
              "JDG.2.9"
            ]
          }
        },
