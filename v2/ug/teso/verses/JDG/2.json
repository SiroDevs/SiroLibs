            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋes do atemaria eoŋ da ebe, Mam ereŋeari kes kakonyenekus; eraunos bala ikukwa kosiepionokus, eraunos da idekesiokec ataeit kamakus.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.3",
            "verseOrgIds": [
              "JDG.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, naenerar emalaika loka EJAKAIT akiro nun mama ejaas idwe kere luka Isirael, kodelosi ituŋa, komonya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.4",
            "verseOrgIds": [
              "JDG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komaikis aibois ŋin Bokim: ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:5",
              "type": "text"
            },
            {
              "text": "Bokim Apolouke Ikamonyak.",
              "type": "text"
            }
          ]
        },
        {
          "text": " koinakis kanen EJAKAIT asuban.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
