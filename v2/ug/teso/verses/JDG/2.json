            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyanaarai atur ŋin kere mama ejaas lukapapaakee: kotupak kes atur ace namam ajeni EJAKAIT, karaida aswam naeswamakinit ŋesi Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.10",
            "verseOrgIds": [
              "JDG.2.10"
            ]
