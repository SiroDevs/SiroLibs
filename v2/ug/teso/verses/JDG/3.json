        {
          "text": " Kiswamata idwe luka Isirael nueroko kakonyen nuka EJAKAIT, kimurwokisi kes EJAKAIT Edekekee, kijaanakis Ibaalim ka Asiterot. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.7",
            "verseOrgIds": [
              "JDG.3.7"
            ]
          }
        },
        {
          "name": "verse",
