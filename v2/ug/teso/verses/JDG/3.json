            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobunok emoyo loka EJAKAIT ŋes, kotubok Isirael; koloma ejie, kijaik EJAKAIT Kusanrisataim eka baka loka Mesopotamia akanike: kipiko ŋesi Kusan-risataim. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.10",
            "verseOrgIds": [
              "JDG.3.10"
            ]
          }
        },
        {
