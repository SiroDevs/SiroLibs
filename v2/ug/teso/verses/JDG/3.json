          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyenu akwap ikar akaisaoŋon. Kotwana Otiniel okoku loka Kenas.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.11",
            "verseOrgIds": [
