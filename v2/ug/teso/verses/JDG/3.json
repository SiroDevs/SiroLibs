                {
                  "text": "Kbk 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka nun kinep anyunyura naka EJAKAIT aluikin Isirael, kogwela kes akan naka Kusanrisataim ekabaka loka Mesopotamia: ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.8",
            "verseOrgIds": [
              "JDG.3.8"
            ]
          }
        },
