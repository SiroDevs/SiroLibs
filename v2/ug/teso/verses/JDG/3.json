            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Komanyata adwekec, kokorakis odwekee adwekec, kijaanakis da idekesiokec.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.6",
            "verseOrgIds": [
              "JDG.3.6"
