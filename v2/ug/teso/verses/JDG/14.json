                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolot Samuson Timuna, koany apese koTimuna naka adwe nuka Ipilisitian. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.1",
            "verseOrgIds": [
              "JDG.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.21"
              },
              "items": [
                {
                  "text": "Age 21:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.4"
              },
              "items": [
                {
                  "text": "34:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋ, kolimok papake ka totoke atiar, “Aany apese koTimuna naka adwe nuka Ipilisitian: aso do komanyakinai ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.3"
              },
              "items": [
                {
                  "text": "Age 24:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.16"
              },
              "items": [
                {
                  "text": "Any 34:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.3"
              },
              "items": [
                {
                  "text": "Ikis 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete papake ka totoke atemar ŋes atiar, “Emamei do apese kadwe nuka iinaeanakon, arai kotunaka kere, tape jo ilosi aimany aberu naka Ipilisitian lumam ekepep?” Kotema Samuson papake atiar, “Komanyakinai ŋes; naarai kesiyalamikinit eoŋ noi.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        }
      ]
    },
    {
