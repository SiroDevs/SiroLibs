                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.27"
              },
              "items": [
                {
                  "text": "Age 29:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.45.22"
              },
              "items": [
                {
                  "text": "45:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.22"
              },
              "items": [
                {
                  "text": "2 Ika 5:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Samuson kes atiar, “Akoto eoŋ alimokin yes asogol: arai kipedosi yesi aitejenun ŋes kotoma apaarasia akanykaarei nuka epucit, ka aitebeikin ŋes, kainakini do yes igoen akaisauni luka ebaputa, ka inapen akaisauni luibusiak: ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.12",
            "verseOrgIds": [
              "JDG.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai mcm ipedorete aiteienun ŋes, kiinakinete do yesi eoŋ igoen akaisauni luka ebaputa, ka inapen akaisauni luibusiak.” Kotemasi ŋes atiar, “Kolim cani asogol, kapuputu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema kes atiar,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
