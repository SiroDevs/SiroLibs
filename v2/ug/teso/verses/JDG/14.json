                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kapaaran nakikanyetekaarei, kotemasi aberu naka Samuson atiar, “Kijodijod okilenikon, tetere kitebeikini sio asogol, kenyeis aicwe jo ka ekal loka papakon kakim: kinyaraunito sio aitaraun lukican? Mere kwaŋin?” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.15",
            "verseOrgIds": [
              "JDG.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 14:16"
          },
          "items": [
