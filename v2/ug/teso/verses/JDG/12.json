        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.12",
            "verseOrgIds": [
              "JDG.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotubok Abudon okoku loka Kilel Epiratonit Isirael atupakin ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.13",
            "verseOrgIds": [
              "JDG.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.10"
              },
              "items": [
                {
                  "text": "Tub 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.10.4"
              },
              "items": [
                {
                  "text": "10:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ajaas ŋes odweke akaisaoŋon ka odwe akaisauni luka odweke, luebwanenenete isigirian akaisakanykaarei: a bu ŋesi kotubok Isirael ikar ikanykauni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.14",
            "verseOrgIds": [
              "JDG.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
