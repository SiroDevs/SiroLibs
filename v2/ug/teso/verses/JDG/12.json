                "loc": "GEN.14.7"
              },
              "items": [
                {
                  "text": "Age 14:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.8"
              },
              "items": [
                {
                  "text": "Any 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.13"
              },
              "items": [
                {
                  "text": "Tub 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.14"
              },
              "items": [
                {
                  "text": "5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotwana Abudon okoku loka Kile! Epiratonit, kidaikinai Piraton akwap naka Epuraim, akwap nakiukon naka Imalekain.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.15",
            "verseOrgIds": [
