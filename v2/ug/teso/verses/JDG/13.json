              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.7",
            "verseOrgIds": [
              "JDG.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Manoa ailip EJAKAIT ebe, “Wu EJAKAIT, kenainait, koboŋ bobo etuŋanan loka Edeke loibu kiiuk mamakosi, kisisianak isio nukiswamakini ikoku yeneuruunio.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopup Edeke eporoto loka Manoa; koboŋ emalaika loka Edeke mama ejai aberu iboie komanikor: konye mam okilenike Manoa ajaas kaŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.9",
            "verseOrgIds": [
              "JDG.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwonya aberu koker, kolimok okilenike, kotema ŋes atiar, “Koany, ketakanikin eoŋ etuŋanan loabunit neajai eoŋ apaaran ya,” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.10",
            "verseOrgIds": [
              "JDG.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyou Manoa, kotup akeberu, kodol neejai etuŋanan, kotema ŋes atiar, “Ŋo ŋes etuŋanan loineras kaberu?” Koboŋok ebe, “Eoŋ lopelo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Manoa atiar, “Aso kedolot akonikiro, kekonakisi ai ikoku, ido anyoin aswamuke?” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.12",
            "verseOrgIds": [
              "JDG.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema emalaika loka EJAKAIT Manoa atiar, “Koeoite aberu ŋun kere nuabu kalimok ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.13",
            "verseOrgIds": [
              "JDG.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siri ŋes kenyam ibore yenelomuni komusabibu, karaida aimat ebino, arai nuitemerete, karaida ainyam idiobore yenimam elai; koric ŋesi kere nuecorakinit ŋes.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.14",
            "verseOrgIds": [
              "JDG.13.14"
            ]
          }
        }
      ]
    },
