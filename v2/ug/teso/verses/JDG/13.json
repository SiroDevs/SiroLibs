              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Manoa emalaika loka EJAKAIT atiar, “Iŋai bo ekonikiror, tetere kitopoloori jo kedolot akonikiro?” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
