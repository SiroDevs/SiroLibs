              "type": "text"
            }
          ]
        },
        {
          "text": " Aso cado kocoite, kenainait, sirikimat ebino karaida nuitemerete, sirikinyam da idiobore yenimam elai: ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.4",
            "verseOrgIds": [
              "JDG.13.4"
            ]
          }
        },
        {
