            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai koany, ipotuuni ijo, iwuruuni ikoku yenisapat; mam eiutet icaki akouke: naarai eraun ikoku Enasirit loka Edeke ageun kakoik: egeuni da ŋesi ai tajar Isirael kakan naka Ipilisitian.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 13:6"
