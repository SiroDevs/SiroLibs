            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi aberu abunore alimokin okilenike ebe, “Abu etuŋanan loka Edeke kobu neaiai, akekonven koputos bala akonyen nuka emalaika loka Edeke, loeyoŋitai; mam abu kenitu ŋes neabunio, karaida ŋes alimokin eoŋ ekekiror. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.6",
            "verseOrgIds": [
              "JDG.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye abu katema eoŋ atiar, ‘Koany, ipotuuni, iwuruuni ikoku yenisapat; sirikimat ebino karaida nuitemerete, sirikinyam da idiobore yenimam elai: naarai eraun ikoku Enasarit loka Edeke ageun kakoik kiton apaaran naka atwanareke.’’’",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.7",
            "verseOrgIds": [
              "JDG.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
