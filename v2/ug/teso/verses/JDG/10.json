            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akaulo ka Abimelek abu Tola okoku loka Pua, okoku loka Dodo, erunanan loka Isakar, konyou aitajar Isirael; abu kiboie koSamir kakwap nakiukon naka Epuraim. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.1",
            "verseOrgIds": [
              "JDG.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kotubok Isirael ikar akaisaarei kaluuni, kotwana, kidaikinai Samir.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.2",
            "verseOrgIds": [
              "JDG.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
