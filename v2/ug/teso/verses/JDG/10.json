              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema EJAKAIT idwe luka Isirael atiar, “Mam kereka eoŋ abu ketajar yes kaneejaas Imisirian, ka Imorain, ka idwe luka Amon, ka Ipilisitian? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.11",
            "verseOrgIds": [
              "JDG.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.19"
              },
              "items": [
                {
                  "text": "Tub 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.3"
              },
              "items": [
                {
                  "text": "6:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.42"
              },
              "items": [
                {
                  "text": "Sab 106:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apotu Isidonin da, ka Imalekain, ka Imaonin koroikis yes; ipotu komonyata kaneajai, abu eoŋ ketaiar yes kakanikee. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.12",
            "verseOrgIds": [
              "JDG.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
