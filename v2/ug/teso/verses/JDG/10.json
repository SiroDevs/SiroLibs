              },
              "items": [
                {
                  "text": "2 Ika 17:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswamata idwe luka Isirael bobo nueroko kakonyen nuka EJAKAIT, kijaanakis Ibaalim, ka Asitarot, ka idekesio luka Suria, ka idekesio luka Sidon, ka idekesio luka Moab, ka idekesio luka idwe luka Amon, ka idekesio luka Ipilisitian; apotu kojalata EJAKAIT, komam ijaanakinete ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.6",
            "verseOrgIds": [
              "JDG.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.9"
              },
              "items": [
                {
                  "text": "1 Sam 12:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinep anyunyura naka EJAKAIT aluikin Isirael, kogwela kes akan naka Ipilisitian, akan da naka idwe luka Amon. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.7",
            "verseOrgIds": [
              "JDG.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu kisiyalononoto koroikis da idwe luka Isirael kokaru kanol: apotu koroikis idwe kere luka Isirael luajaas okekwa loka Yorodan akwap naka Imorain naejai Gilead, ikar itomon ka lukanykauni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.8",
            "verseOrgIds": [
              "JDG.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodokasi idwe luka Amon Yorodan alosit aitiji Yuda ka Benyamin, ka ekal loka Epuraim; kwaŋin kiyalonon noi Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.9",
            "verseOrgIds": [
              "JDG.10.9"
            ]
          }
        }
      ]
    },
