              "items": [
                {
                  "text": "1 Sam 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Komonyata idwe luka Isirael mama ejai EJAKAIT ebe, “Kidiaka kamakon, naarai kijal Ekosideke, kijaanaki Ibaalim.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.10",
            "verseOrgIds": [
              "JDG.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 10:11"
          },
          "items": [
