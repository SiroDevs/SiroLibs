              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokoto Baranaba ayaŋaar Yokana loenyaritai Marako aupar kakes, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.37",
            "verseOrgIds": [
