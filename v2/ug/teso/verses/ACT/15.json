            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.68"
              },
              "items": [
                {
                  "text": "Luk 1:68",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitejenu oni Simeon kwape kisiaunia Edeke aanyanar Imo, alemun kotomakec ituŋa kanuka ekekiror. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.14",
            "verseOrgIds": [
              "ACT.15.14"
            ]
          }
        },
