                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kiyuunit ebe kitajario kanuka asianut naka Ejakait Yesu, kwape kakesi.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.11",
