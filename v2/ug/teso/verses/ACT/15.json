            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kojau epeget loepol kidiŋikec kiton neatiakatar, koyaŋa Baranaba Marako kikwaŋaros Kupuro, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
