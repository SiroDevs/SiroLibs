            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.1"
              },
              "items": [
                {
                  "text": "13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yuda ka Sila da, lukeraas inabin, kitalakasi iinacan kakiro nuipu, kitogogoŋo kes. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.32",
            "verseOrgIds": [
              "ACT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosalakis ŋina adaun apak, kotwara kes iinacan aboŋor kainapakin mama ejaas lukiyakuunete. [",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.33",
            "verseOrgIds": [
              "ACT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
