          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "konye Paul koseu Sila konyou, ilipakinete iinacan tetere einakinio asianut naka Ejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
