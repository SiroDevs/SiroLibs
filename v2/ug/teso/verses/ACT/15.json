              },
              "items": [
                {
                  "text": "Asw 10:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwabo mam etiakit oni ka kes, konye itesegaari itauonokec kaiyuun. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.9",
            "verseOrgIds": [
              "ACT.15.9"
            ]
          }
        },
        {
          "name": "verse",
