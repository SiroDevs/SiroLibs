              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kijesunos icetuŋa anyoun koYudaya, kisisianakis iinacan ebe, “Arai mam kikepio kwape ejaar epone loka Musa, mam ipedorete aitajario.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.1",
            "verseOrgIds": [
