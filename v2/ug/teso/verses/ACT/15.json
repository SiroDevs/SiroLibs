          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi ketwar, kijesaros Antiokia; kotukokis ekodet kere, koinakis ebalua. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.30",
            "verseOrgIds": [
              "ACT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
