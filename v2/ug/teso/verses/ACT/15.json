        {
          "text": "Kotukokinos ikiyakia ka imakio tetere eomoomoete akirot ŋin, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.6",
            "verseOrgIds": [
              "ACT.15.6"
            ]
