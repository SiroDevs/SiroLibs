          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakesiomiata, kiyalamikinos kanuka aitalakario kaŋin, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.31",
            "verseOrgIds": [
              "ACT.15.31"
            ]
          }
        },
        {
