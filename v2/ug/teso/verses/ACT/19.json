                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiyakia iarei kokejaanakinakake alosit Makedonia, kes Timoteo ka Erasito, kosalak ŋes elopet Asia apak.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
