            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kedaunos akiro ŋun kolosik Paul Komoyo aitor Makedonia ka Akaia alosit Yerusalem, kobala ebe, “Kadau ajaut ŋina, kebusakinit aanyun Rome da.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.21",
            "verseOrgIds": [
              "ACT.19.21"
            ]
