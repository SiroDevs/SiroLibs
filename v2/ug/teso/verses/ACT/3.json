            "sid": "ACT 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido tetere ijukuni Kristo lokiseikinitai apeŋo, ŋes Yesu: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.20",
            "verseOrgIds": [
              "ACT.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "loibusakinit akuj aisukunyikin aitodol apakio nuiteteunere akiro kere nukinerit Edeke kaituke nuka inabinoke lukalaunak ameun kageunet naka akwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.21",
            "verseOrgIds": [
              "ACT.3.21"
            ]
          }
        },
        {
