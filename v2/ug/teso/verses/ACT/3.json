              "items": [
                {
                  "text": "Asw 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Edeke loka Aburaam, ka loka Isaak, ka loka Yakob, Edeke loka lukapapaawok etopoloo Eketelepat Yesu; loipotu yesi kijaikis, ka aiŋer kakonyen nuka Pilato, nakekotor aosikin ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.13",
            "verseOrgIds": [
              "ACT.3.13"
            ]
          }
        },
        {
