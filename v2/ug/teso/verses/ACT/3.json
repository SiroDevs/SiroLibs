                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " koarata Ekapolon loka aijar; lokitajaruni Edeke kotoma okatwak, Kirai isio ikekajenak. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.15",
            "verseOrgIds": [
              "ACT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
