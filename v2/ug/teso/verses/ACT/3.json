            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye yes ipotu koŋeroto Lokalaunan Lokadoliton, kilipa ainakinio ekaaran, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.14",
            "verseOrgIds": [
              "ACT.3.14"
            ]
          }
        },
        {
