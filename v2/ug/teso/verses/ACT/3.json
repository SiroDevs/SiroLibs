              "items": [
                {
                  "text": "1 Tim 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwana da iinacan, ajeni ebe iswamato ŋun kanu mam ijeniata, kwape eswamaata ikayaitokokus da. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.17",
            "verseOrgIds": [
              "ACT.3.17"
            ]
          }
        },
        {
