                "loc": "ACT.5.12"
              },
              "items": [
                {
                  "text": "Asw 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naperiŋa ŋesi itiŋit Petero ka Yokana, kokerut ituŋa kere mama ejaas toma alomaret naenyaritai naka Solomon, eumokinitos noi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.11",
            "verseOrgIds": [
              "ACT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakeanyunia Petero, Koboŋok ituŋa ebe, “Yes ikiliok luka Isirael, kanukinyo iwumokinitotor nu, kanukinyo da kiseseniata sio, bala Iem kitolosi ŋes kakosipedor arai bo kakosiyoŋit Edeke? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.12",
            "verseOrgIds": [
              "ACT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 3:13"
          },
          "items": [
