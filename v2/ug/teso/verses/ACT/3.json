        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete edokarete Petero ka Yokana alosit oyekalu esawa loka ailip, ŋes lokikanyetekaoŋon. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.1",
            "verseOrgIds": [
              "ACT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.8"
              },
              "items": [
                {
                  "text": "Asw 14:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.1"
              },
              "items": [
                {
                  "text": "Yok 9:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido adakitai etuŋanan Ioeŋwalit ameun kaurioke, lokibwaanakinio ŋinipaaran orute loka eyakalu loenyaritai Lokajokan, tetere ilipitoi nukaitim kama ejaas ituŋa luelomanarete toma oyekalu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.2",
            "verseOrgIds": [
              "ACT.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keanyu ŋol Petero ka Yokana elomarete oyekalu, kilip kes nukaitim. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.3",
            "verseOrgIds": [
              "ACT.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.9"
              },
              "items": [
                {
                  "text": "Asw 14:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Petero kosesen ŋes nepepe ka Yokana, kotema atiar, “Kiteoi sio.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.4",
            "verseOrgIds": [
              "ACT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koŋolia kes, komun adumun ibore kamakec. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.5",
            "verseOrgIds": [
              "ACT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.16"
              },
              "items": [
                {
                  "text": "Asw 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye Petero kotema atiar, “Emamei eoŋ epuesa karaida esabu; konye yenikija keoŋ, kainakini ŋin, Kokiror loka Yesu Kristo loko Nasaret, kosakasak.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.6",
            "verseOrgIds": [
              "ACT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiŋ akekan nakoteten, kitonyou ŋes: atipet kodomut akekeje ka ikekurunya agogoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.7",
            "verseOrgIds": [
              "ACT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.14"
              },
              "items": [
                {
                  "text": "Yok 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodetu, kobwo, kogeu alosit; koloma oyekalu nepepe kakes, elosi, esomanari, iturit Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.8",
            "verseOrgIds": [
              "ACT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koanyut ituŋa kere elosi iturit Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.9",
            "verseOrgIds": [
              "ACT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojenata ebe kerai ŋesi ŋopeŋol lokiboie ilipitoi nukaitim korute Lokajokan loka eyekalu: koumokis noi ŋin naedoikinit ŋes.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.10",
            "verseOrgIds": [
              "ACT.3.10"
            ]
          }
        }
      ]
    },
