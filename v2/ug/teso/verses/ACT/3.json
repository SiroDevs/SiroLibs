                "loc": "LUK.24.27"
              },
              "items": [
                {
                  "text": "Luk 24:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye akiro kwa nukelimonokini Edeke ameun apeŋo kaituk nuka inabin kere ebe ibusakinit Kristoke aiticanio, etodoliki kwaŋin, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.18",
            "verseOrgIds": [
              "ACT.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
