                  "text": "Leb 23:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, ŋinituŋanan yenimam iirari enabi ŋol emudiario kotuŋa.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.23",
            "verseOrgIds": [
              "ACT.3.23"
            ]
          }
        },
