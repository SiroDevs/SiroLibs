          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka aiyuun ekekiror ainak ekekiror etuŋanan lo agogoŋ, loianyunete loijenete da; eebo, aiyuun ŋin naejai mamakeŋ ainak lo aŋaleu naeleleba kakonyenekus kere.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.16",
            "verseOrgIds": [
              "ACT.3.16"
            ]
          }
        }
      ]
