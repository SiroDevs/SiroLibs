              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do kitoronikinos, kibelokinos, komwatarai akusidiakanareta, tetere edolete apakio nuka aisikwarunio nuepote kama ejai Ejakait, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.19",
            "verseOrgIds": [
              "ACT.3.19"
            ]
          }
        },
        {
