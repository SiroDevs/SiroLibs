                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kulaudio Lusia mama ejai ekayaiton lokaibuses Pelikis, ayogan. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.26",
            "verseOrgIds": [
              "ACT.23.26"
            ]
          }
        },
        {
