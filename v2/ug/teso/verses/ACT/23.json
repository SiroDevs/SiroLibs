                "loc": "ACT.22.30"
              },
              "items": [
                {
                  "text": "Asw 22:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kakoto ajenun akirot naeosatotor, ketodoka aurianetekec. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.28",
            "verseOrgIds": [
              "ACT.23.28"
            ]
          }
        },
        {
