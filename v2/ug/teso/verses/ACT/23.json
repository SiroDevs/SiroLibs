                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikesite Paul akonye kaurianet, kobala ebe, “Ikiliok iinacan, abu kajar kakonyen nuka Edeke ketau kaloejok kiton lolo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.1",
            "verseOrgIds": [
              "ACT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
