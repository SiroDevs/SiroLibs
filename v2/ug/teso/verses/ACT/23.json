                "loc": "ACT.22.25"
              },
              "items": [
                {
                  "text": "22:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ikamunito Iyudayan etuŋanan lo, aapikinito aiar ŋes, kabunok kes nepepe ka iserikalei, kayu, kajenu ebe erai Eromayot. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.27",
            "verseOrgIds": [
              "ACT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
