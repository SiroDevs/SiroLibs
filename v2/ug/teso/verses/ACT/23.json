                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye nakejenunia Paul ebe atutubet adiopet kerai naka Isadukayon, ka nace da naka Iparisayon, kiworo kaurianet ebe, “Ikiliok iinacan, arai eoŋ Eparisayot, okoku loka Iparisayon; katubokinitai eoŋ kanuka amun naka ajarun naka ikatwak.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.6",
            "verseOrgIds": [
              "ACT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakedaunia einer ŋun, kojau epeget kidiŋ Iparisayon ka Isadukayon; kotiaka atukot, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.7",
            "verseOrgIds": [
              "ACT.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.23"
              },
              "items": [
                {
                  "text": "Mat 22:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.18"
              },
              "items": [
                {
                  "text": "Mk 12:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.27"
              },
              "items": [
                {
                  "text": "Luk 20:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ebalas Isadukayon ebe emamei ajarun, karaida emalaika, karaida emoyo; konye ecamunito Iparisayon ŋun kere. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.8",
            "verseOrgIds": [
              "ACT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.25.25"
              },
              "items": [
                {
                  "text": "Asw 25:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.39"
              },
              "items": [
                {
                  "text": "5:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojau ecelet loepol; kobwaata ikewadikak ice owai loka Iparisayon, koutasi kobalas ebe, “Mam sio kidumuni adiokirot naerono kotuŋanan kalo. Arai bo emoyo inera kaŋes, arai bo emalaika?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.9",
            "verseOrgIds": [
              "ACT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyatakin ecelet apoloor, kokurianar ekapolon ebe enyilinyiliete kesi Paul, kicorak iserikalei adokun ka alemun ŋes kagogoŋ kakaninikec, ainyakar da ore loka iserikalei.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.10",
            "verseOrgIds": [
              "ACT.23.10"
            ]
          }
        }
      ]
    },
