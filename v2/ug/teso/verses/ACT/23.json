                "loc": "ACT.18.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kadum ebe kiwosatai kanuka aiŋiseta nuka ikisilakec, kwabo mam kiwosatai adiokirot kere naibusakinitor aaria karaida aenia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.29",
            "verseOrgIds": [
              "ACT.23.29"
            ]
          }
        },
        {
          "name": "verse",
