          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotema atiar, “Keirari jo naeponiata lukiwosato.” Kicorak aidario kotogo lokapolou loka Kerode.",
          "type": "text",
          "attrs": {
