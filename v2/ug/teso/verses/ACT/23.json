            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.24.8"
              },
              "items": [
                {
                  "text": "Asw 24:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi nakapukokinere ebe ejaun ebotet loebilakinete ekiliokit lo, atipet kejuku mamakon, kecoraki da lukewosatok einer akecekiro kakonyenekon.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.30",
            "verseOrgIds": [
              "ACT.23.30"
            ]
          }
        }
