                {
                  "text": "Asw 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋes da nakedaunia asoman, kiŋit ebe, “Erai ŋesi loko buku ali?” Nakejenunia ebe erai loko Kilikia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.34",
            "verseOrgIds": [
              "ACT.23.34"
            ]
          }
        },
        {
          "name": "verse",
