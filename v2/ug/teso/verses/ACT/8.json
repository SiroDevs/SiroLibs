          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.8"
              },
              "items": [
                {
                  "text": "Asw 21:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kotakanu Pilip kotoma Asoto, nakitoritor kolimonok akiro nukajokak koreria kere, kiton adolore Kaisarea.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.40",
