                "loc": "ACT.22.20"
              },
              "items": [
                {
                  "text": "22:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitojokit Saul da akeario. Kapaaran kaŋin kodakun aimanit naepol aluikin ekanisa lokejai Yerusalem; kisiarakinos kere akwap nako Yudaya ka",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samaria, dimarai ikiyakia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.12"
              },
              "items": [
                {
                  "text": "Mat 14:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apotu ituŋa lueyoŋito Edeke kidaata Sitepan, kokuudianata da ŋes noi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.2",
            "verseOrgIds": [
              "ACT.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.4+ACT.22.5"
              },
              "items": [
                {
                  "text": "Asw 22:4-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.1"
              },
              "items": [
                {
                  "text": "9:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.9+ACT.26.10+ACT.26.11"
              },
              "items": [
                {
                  "text": "26:9-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye komuna Saul ekanisa, kolomanari ŋolitogo, kidilidiliununei ikiliok ka aŋor da, kibwaik aidaris.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete ŋul lukisiarakinio koloto elimonokinete akirot, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.4",
            "verseOrgIds": [
              "ACT.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.5"
              },
              "items": [
                {
                  "text": "Asw 6:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijesar Pilip ore loko Samaria, kolimonok Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.5",
            "verseOrgIds": [
              "ACT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopupokis ikodeta kacoit ketau ediopet nukinera Pilip, naiirariata ka aanyun da aanyuneta nukiswamai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.6",
            "verseOrgIds": [
              "ACT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.17"
              },
              "items": [
                {
                  "text": "Mk 16:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai apotu ajokin nuipu nueroko kolomut kama kaŋul lukikamunito, kiworoto keporoto loepol: luipu da lukasenyak ka iŋwalasik kitaŋaleunoi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.7",
            "verseOrgIds": [
              "ACT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.40+JHN.4.41+JHN.4.42"
              },
              "items": [
                {
                  "text": "Yok 4:40-42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojau aiyalama naepol ore ŋol.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye koiai etuŋanan ekekiror Simon, lolem eswamaenenei nukecudet kore kaŋol, kisiwumok ituŋa luko Samaria, kobala ebe ŋes lokapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.9",
            "verseOrgIds": [
              "ACT.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopupokito kesi kere kacoit, ameun ka yenididi kiton yenikapolon kobalas ebe, “Etuŋanan lo erai apedor naka Edeke naenyaritai Nakapolon.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.10",
            "verseOrgIds": [
              "ACT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopupokito kacoit, naarai abu kisiwumok kes apak naepol kanuka ecudeteke, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.11",
            "verseOrgIds": [
              "ACT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.19"
              },
              "items": [
                {
                  "text": "Mat 28:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye nakiyuuniata Pilip elimonokin akiro nukaiokak nuka ajakanut naka Edeke, ka ekiror da loka Yesu Kristo, kibatisai, ikiliok ka aŋor da. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.12",
            "verseOrgIds": [
              "ACT.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simon da elopet abu kiyu; kedau aibatisao koupakinos ka Pilip. Koumok nakeanyunia aanyuneta ka nukapedor nukapolok nukiswamai Pilip.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.13",
            "verseOrgIds": [
              "ACT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
