              "items": [
                {
                  "text": "Asw 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitejenut iinacan lukiboiete koLusitura ka Ikonium kwape ejokiar ŋesi,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.2",
            "verseOrgIds": [
              "ACT.16.2"
            ]
          }
        }
