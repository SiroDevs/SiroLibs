        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
