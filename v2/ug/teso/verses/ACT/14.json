                {
                  "text": "Yak 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikatuŋa, kanukinyo iswamaata nu? Kirai isio da ituŋa lukepone kwape kayesi, kiinunit yes akiro nukaiokak, tetere ibelokinos ainyein akiro nu nukamameak kosesena Edeke lokajaran lokesubi akuj ka akwap ka aŋolol ka iboro da kere luejaas tomakec, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.15",
            "verseOrgIds": [
              "ACT.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.30"
              },
              "items": [
                {
                  "text": "Asw 17:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Katurio nuatuboros abu kojalak atekerin kere alosit kotoma orotinikec; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.16",
            "verseOrgIds": [
              "ACT.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.147.8"
              },
              "items": [
                {
                  "text": "Sab 147:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.24"
              },
              "items": [
                {
                  "text": "Yer 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye mam kinyein komamei aitejenunet, naarai kiswama nuejok, koinak yes akiru abunore kakuj, ka apakio nuka amio, isimonikini ikusitauon kinyamat ka aiyalama.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.17",
            "verseOrgIds": [
              "ACT.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakiro kaŋun, kitikokis ikodeta kationis ainakin kes asuban.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.18",
            "verseOrgIds": [
              "ACT.14.18"
            ]
          }
        }
      ]
