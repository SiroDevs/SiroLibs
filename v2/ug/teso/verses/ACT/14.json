        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen kotoma Ikonium, kolomasi nepepe toma atukos naka Iyudayan, ido kanuka ŋun nuenerasi kiyu ekodet loapol loka Iyudayan ka Iyonanin. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.1",
            "verseOrgIds": [
              "ACT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.45"
              },
              "items": [
                {
                  "text": "Asw 13:45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye Iyudayan lumam kiyuunito kisidikoto Imo kitolomikis etau loerono asurokin iinacan. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.2",
            "verseOrgIds": [
              "ACT.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.11"
              },
              "items": [
                {
                  "text": "Asw 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.20"
              },
              "items": [
                {
                  "text": "Mk 16:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.4"
              },
              "items": [
                {
                  "text": "Bur 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete kosala nen apak naepol, inerasi katitiŋ kotoma Ejakait, lokitejenuni akirot naka akesianut, kocamak aanyuneta ka nukaumokin aiswamao kakaninikec, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.3",
            "verseOrgIds": [
              "ACT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kotiakas ituŋa lukore; ice owai loka lyudayan, ice da owai loka ikiyakia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.4",
            "verseOrgIds": [
              "ACT.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.19"
              },
              "items": [
                {
                  "text": "Asw 14:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.3.11"
              },
              "items": [
                {
                  "text": "2 Tim 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiton neatakanunia asurokin naka Imo ka Iyudayan, nepepe kikayaitokokec, aiswamakin kes erono, ka aibiribir kamor. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.5",
            "verseOrgIds": [
              "ACT.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.23"
              },
              "items": [
                {
                  "text": "Mat 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kejenut kes ŋun, kokereasi Lusitura ka Derube, ireria luka Lukaonia, ka akwapin nuedunyatar; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.6",
            "verseOrgIds": [
              "ACT.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.19"
              },
              "items": [
                {
                  "text": "Asw 11:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kanen da kolimonokis akiro nukajokak.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.7",
            "verseOrgIds": [
              "ACT.14.7"
            ]
          }
        }
      ]
