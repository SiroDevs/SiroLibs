              "type": "text"
            }
          ]
        },
        {
          "text": "Kodau Paul ikar iarei kotogoke loketacanakini, kisukunyanakinenei kere lukeponenenete mamakeŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
