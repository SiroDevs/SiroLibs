            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedaut aseikin ŋes apaaran kopotu luipu noi mamakeŋ togo lokiboio.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        }
      ]
    },
