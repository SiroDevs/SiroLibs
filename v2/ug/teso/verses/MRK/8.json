        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.56"
              },
              "items": [
                {
                  "text": "Mk 6:56",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodoloto Betesaida. Koinunai emuduki, kiŋaiŋaata atiror ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.22",
            "verseOrgIds": [
              "MRK.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
