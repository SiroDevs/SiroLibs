          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.10",
            "verseOrgIds": [
              "MRK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 8:11"
          },
          "items": [
            {
              "text": "11",
