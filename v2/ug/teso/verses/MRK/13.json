                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.13"
              },
              "items": [
                {
                  "text": "Asw 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ibirununos aacerin kotoma akuj, itamaranio da nukapedor nuejaas toma akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.25",
            "verseOrgIds": [
              "MRK.13.25"
            ]
          }
