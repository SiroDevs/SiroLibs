                  "text": "Isa 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Konye kapaarasia kaŋun akaulo ka ican ŋul, itumutonorio akoloŋ, mam elap ecauni, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
