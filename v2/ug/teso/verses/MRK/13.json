              "items": [
                {
                  "text": "Mat 24:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Konye akiro nuka apaaran kaya ka esawa da emamei yenejeni, karaida imalaikan luejaas toma akuj, karaida Okoku, dimikito Papa bon. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.32",
            "verseOrgIds": [
              "MRK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kocoito, kokwenyete, kilipete: naarai mam ijenete naejaikinor apak. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.33",
            "verseOrgIds": [
              "MRK.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
