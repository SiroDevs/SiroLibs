              "items": [
                {
                  "text": "Mat 25:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eputos bala etuŋanan ekepejon loiboiororoi kacekwap, kinyeinite eketogo, koinakinite ikebulesin apolou, ŋinituŋanan akeswam, kicorakinite da ekagolon aikweny. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.34",
            "verseOrgIds": [
              "MRK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.38"
              },
              "items": [
                {
                  "text": "Luk 12:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kokwenyete: naarai mam ijenete naebunio ejakait loka etogo, arai eboŋ, arai kidiŋ ebai, arai naeruikinioto ikokoroi, arai tupuruc; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.35",
            "verseOrgIds": [
              "MRK.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kinyek aŋesun atipet kodum yes ijotoete. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.36",
            "verseOrgIds": [
              "MRK.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido nukalimokini yes, alimokini kere, ebe Kokwenyete.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.37",
            "verseOrgIds": [
              "MRK.13.37"
            ]
