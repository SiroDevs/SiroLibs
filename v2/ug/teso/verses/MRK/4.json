                  "text": "Luk 6:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema kes atiar, “Kocoito nuipupete. Aitemis naitemioto yesi, ŋipeŋin kitemere yes, kiyatakinio da. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
