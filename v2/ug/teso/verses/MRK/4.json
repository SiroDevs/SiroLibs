            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai yenejai ibore einakinio ice; konye yenemamei ibore, edemunio ŋin da yenejaas kaŋes.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.25",
