                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye nakeyeikin, epoloor, eraun lokapolon aitelekarit idiasio kere, kijany atenieik nuepolok, tape edukete akweny nuka apak akaisikec otolimike.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.32",
            "verseOrgIds": [
              "MRK.4.32"
            ]
          }
        }
