            }
          ]
        },
        {
          "text": "Kotema atiar, “Ikoni ne ajakanut naka Edeke bala etuŋanan lokeyei ikinyom alup; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
