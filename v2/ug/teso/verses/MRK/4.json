                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema kes atiar, “Eyaŋaunio kereka atala aibwaikin obukit, arai bo kwap keitada? Mam kereka ibwaikinio kuju ocoget? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
