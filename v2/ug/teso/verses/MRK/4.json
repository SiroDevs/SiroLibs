          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai ejaas ituŋanan aki nuka akiirar, kiira.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.23",
            "verseOrgIds": [
              "MRK.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
