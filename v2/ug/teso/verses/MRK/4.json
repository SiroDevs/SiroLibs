              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema atiar, “Kitupusi kinyo ajakanut naka Edeke, arai ketetemo kawaragan anyoin? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eputos ka ecokat loka ekaradali, loeyeikinio toma alup, karaida kedit aitelekarit ikinyom kere luka akwapin; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 4:32"
