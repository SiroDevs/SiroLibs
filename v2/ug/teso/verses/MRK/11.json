                  "text": "Luk 20:1-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodoloto bobo Yerusalem: ido nakitoritor oyekalu, kopotu isasedotin lupeti ka ikewadikak ka imakio mama ejai; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.27",
            "verseOrgIds": [
              "MRK.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotemasi ŋes atiar, “Iswamai ijo nu kapolou anyoin? Iŋai da kiinakini jo apolou nakiswamaa nu?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.28",
            "verseOrgIds": [
              "MRK.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Yesu kes atiar, “Mere eoŋ da keŋit yes akirot adiopet, yes da koboŋokis eoŋ, ŋes konyet kalimokiniata apolou nakeswamaa nu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.29",
            "verseOrgIds": [
              "MRK.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aibatisa naka Yokana kebuni kotoma akuj, arai bo kotuŋa? Koboŋokinoi.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.30",
            "verseOrgIds": [
              "MRK.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋitanakinos bonik ka bonik, kobalas ebe, “Arai kiitema ebe, ‘Kebuni kotoma akuj’; etemari ŋesi ebe, ‘Aso kanukinyo mam kiyuuniata ŋes?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.31",
            "verseOrgIds": [
              "MRK.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai kiitema ebe, ‘Kebuni kotuŋa’ kokuriaka ituŋa: naarai aomito ituŋa kere ebe kerai Yokana enabi abeit. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.32",
            "verseOrgIds": [
              "MRK.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋokis Yesu ebe, ‘Mam kijeni.’ ” Kotema Yesu kes atiar, “Eoŋ da mam kalimokini yes apolou nakeswamaa nu.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.33",
            "verseOrgIds": [
              "MRK.11.33"
            ]
          }
        }
