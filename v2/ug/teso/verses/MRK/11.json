                "loc": "LUK.17.6"
              },
              "items": [
                {
                  "text": "Luk 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abeit katemari yes atiar, Ŋinituŋanan yenelimokini eroŋat lo ebe, ‘Koukor, kocakakin aŋolol’; komam ebuonokini kotauke, konye kiyuunite ebe nuinera edolete; iswamakinio. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.23",
            "verseOrgIds": [
              "MRK.11.23"
            ]
          }
        },
        {
