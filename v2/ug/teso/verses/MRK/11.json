            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.23"
              },
              "items": [
                {
                  "text": "5:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naibwoenenaata ilipete, kisioniete, arai ijaas kakirot kayenice; tetere Papakus loejai toma akuj isioniei akusiibucanar. [ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.25",
            "verseOrgIds": [
              "MRK.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai mam yes isioniete, Papakus da loejai toma akuj mam isioniei akusiibucanar.]”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.26",
            "verseOrgIds": [
              "MRK.11.26"
            ]
          }
        }
