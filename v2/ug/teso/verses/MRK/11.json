                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.12+JHN.12.13+JHN.12.14+JHN.12.15+JHN.12.16"
              },
              "items": [
                {
                  "text": "Yok 12:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakeapiariata Yerusalem, die ka Betapage ka Betaniya, moru loka Iseitunin, kijuka iarei kokesisiakake, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.1",
            "verseOrgIds": [
              "MRK.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema kes atiar, “Koloto kiton ore loisesenete: atipet kilomasi idumunete ikoku yenika asigiria eenitai, yenimam lem ibwanenit idiotuŋanan; kolacut, koinut. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.2",
            "verseOrgIds": [
              "MRK.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.14"
              },
              "items": [
                {
                  "text": "Mk 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai kitemari yes ituŋanan ebe, ‘Kanukinyo iswamaata kwaŋin?’ ilimokinete ŋes ebe, ‘Ejakait ipuda ŋes, ido inyakuni bobo ne atipet.’” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.3",
            "verseOrgIds": [
              "MRK.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koloto, kodumut isigiria eenikinitai okek kiŋa orot; kolacut. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.4",
            "verseOrgIds": [
              "MRK.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotemasi ice kalukebwoete kanen atiar, “Kanukinyo ilacariata yesi isigiria?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.5",
            "verseOrgIds": [
              "MRK.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋokis kes kwape alimokinitor Yesu: kocamakis kes alosit. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.6",
            "verseOrgIds": [
              "MRK.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koinut Yesu isigiria, kocakanakis ikecenapen; kibwanen ŋesi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.7",
            "verseOrgIds": [
              "MRK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopetanakis luipu ikecenapen orot; ice da akui nukejepununete kamanat. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.8",
            "verseOrgIds": [
              "MRK.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.25+PSA.118.26"
              },
              "items": [
                {
                  "text": "Sab 118:25-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiworoto ituŋa lukiŋarenikinito ka luketupakinito ebe, “Kosana! Isirereŋitoi loebunit kokiror loka Ejakait! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.9",
            "verseOrgIds": [
              "MRK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirereŋitoi ajakanut naebunit, naka papaakosi Daudi! Kosana kuju noi kakuj.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.10",
            "verseOrgIds": [
              "MRK.11.10"
            ]
          }
        }
      ]
    },
    {
