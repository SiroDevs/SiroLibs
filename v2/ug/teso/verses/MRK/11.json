                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun katemari yes atiar, Akiro kere nuilipete ka nuiŋaiŋaete kiyuunito ebe kiinakinitai, ido kiswamakinio. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
            "verseOrgIds": [
              "MRK.11.24"
            ]
          }
        },
        {
