                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋok Yesu kotema kes atiar, “Kiyuutu Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.22",
            "verseOrgIds": [
              "MRK.11.22"
            ]
