                {
                  "text": "2 Ika 25:1-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Siit 36:17-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kenaiŋair, kiŋitakinai EJAKAIT, naarai itemonokino Nebukadaresar ekabaka loko Babulon aitiji oni: motoko kiswamakini EJAKAIT kwape ejaatar akeswamisio kere nukaumokin, tetere itobonoori ŋes.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
