            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ilimokini ituŋa lu ebe, ‘Inera kwanata EJAKAIT ebe: Koany, ebwaik kakonyenekus erot loka aijar, ka erot loka atwanare. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
