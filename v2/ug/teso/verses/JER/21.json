            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akirot naka EJAKAIT naabu kobu mama ejai Yeremia, nakijukaria ekabaka Sedekia Pasur okoku loka Malikiya, ka Sepania okoku loka Maaseia esasedoti, mama ejai, ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
