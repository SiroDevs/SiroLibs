              "items": [
                {
                  "text": "Yer 38:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.18"
              },
              "items": [
                {
                  "text": "39:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yeniboikini ore lo, eari ekileŋ, ka eteŋei, ka atular; konye yenelomari, alunakin Ikaludean lukirigaunete, ebusi ŋipeŋin, akeijar da eraun anaruna. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
