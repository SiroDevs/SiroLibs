              "type": "text"
            }
          ]
        },
        {
          "text": "“Ido nuka ekek loka ekabaka loka Yuda, kiner ebe, ‘Kiirasi akirot naka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
