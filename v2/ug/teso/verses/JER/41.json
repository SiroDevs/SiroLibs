        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.27"
              },
              "items": [
                {
                  "text": "2 Sam 3:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi konyou Isimael okoku loka Netania, ka ituŋa itomon Iuajaas kaŋes, kicumata Gedalia okoku loka Akikam, okoku loka Sapan, kekilen, koarata, loabu eka baka loko Babulon kodakak ayait akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
