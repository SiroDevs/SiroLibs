                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kijoreo Isimaelluedeunos kere luka ituŋa luajaas Misipa, kiton adwe nuka ekabaka, ka ituŋa da kere luasalito Misipa, luabu Nebusaradan ekapolon loka ikedarak kititin Gedalia okoku loka Akikam. Kijoreo Isimael okoku loka Netania kes, konyou alosit mama ejaas idwe luka Amon.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
