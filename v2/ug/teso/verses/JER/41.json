            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye nakiiraria Yokanan okoku loka Karea, ka ikapolok kere luka irioneta luajaas kaŋes, nukaronok kere nueswama Isimael okoku loka Netania, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
