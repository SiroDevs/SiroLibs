              "items": [
                {
                  "text": "Rom 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koar bobo Isimael lyudayan kere luajaas ka Gedalia, Misipa, ka Ikaludean luadumunio kaŋina, kes ikaiiok.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
