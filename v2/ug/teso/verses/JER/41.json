                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aipany nin naacakakini Isimael awat kere nukatwak nuka ituŋa luaari, kosiep loka Gedalia, ŋipenin aipany naaboki Asa eka baka kanuka akurian Baasa ekabaka loka Isirael. Kileleb Isimael okoku loka Netania kituna luaari. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        },
        {
