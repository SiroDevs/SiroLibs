        },
        {
          "text": " Kosodi kanen kolap kalokikanyetekaarei kobu Isimael okoku loka Netania, okoku loka Elisama, lokaur naka ekabaka, ediopet ka lukapolok luka eka baka, nepepe kituija itomon mama ejai Gedalia okoku loka Akikam Misipa: komorata ainyam koMisipa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
