                {
                  "text": "2 Sam 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " koyanaasi ituŋa kere, koloto aitiji Isimael okoku loka Netania, kodumakis atapar naepol naajai Gibeon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
