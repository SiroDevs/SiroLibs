              "items": [
                {
                  "text": "Yer 29:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.2"
              },
              "items": [
                {
                  "text": "Dan 9:2",
