            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.22+REV.18.23"
              },
              "items": [
                {
                  "text": "Apu 18:22-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido bobo, alemari kamakee eporoto lokaiyalama ka eporoto lokailel, eporoto loka eteran ka eporoto da loka ateran, aruo naka akaŋas, ka aica naka atala, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.10",
            "verseOrgIds": [
              "JER.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
