                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.3+LUK.13.4+LUK.13.5"
              },
              "items": [
                {
                  "text": "Luk 13:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala ebe, ‘Kobonutu kinye ninitunanan ekerot loerono, ka aronis naka aswamisiokus, kiboikinos akwap nakiinakinit EJAKAIT yes ka lukapapaakus, ageun apeŋo aitodol ikar kere; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.5",
            "verseOrgIds": [
              "JER.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ido siritupanarete idekesio ice aijaanakin ka aima kes, sirikitunyunyuranakis eoŋ kaswamisio nuka akaninikus. Eoŋ da mam keswamakini yes aronis.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.6",
            "verseOrgIds": [
              "JER.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.19"
              },
              "items": [
                {
                  "text": "Yer 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.30"
              },
              "items": [
                {
                  "text": "32:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJAKAIT ebe, Konye mam ipotu kopuput eoŋ; kitunyunyurikis kaswamisio nuka akaninikus aiswamakin bonik aronis.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        }
