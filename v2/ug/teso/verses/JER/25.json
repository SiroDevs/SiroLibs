          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kanuka mm ŋes inerar kwanata EJAKAIT loka ajoresio ebe: Naarai mam ipotu kopuput akakiro, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.8",
            "verseOrgIds": [
              "JER.25.8"
            ]
          }
        },
