              "type": "text"
            }
          ]
        },
        {
          "text": " Akirot naabu kobu mama ejai Yeremia nuka ituŋa kere luka Yuda, kokaru lokiwononet loka Yekoiakim okoku loka Yosia, ekabaka loka Yuda: ekaru ŋol ŋes ekaru losodit loka Nebukadaresar ekabaka loko Babulon; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.1",
            "verseOrgIds": [
              "JER.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "naalimokini enabi Yeremia ituŋa kere luka Yuda, ka ŋul kere luibojete koYerusalem kobala ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.2",
            "verseOrgIds": [
              "JER.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.2"
              },
              "items": [
                {
                  "text": "Yer 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ageun kokaru lokitomonet kauni loka Yosia okoku loka Amon, ekabaka loka Yuda, kiton lolo, ikar lu akaisaarei ka luuni, kobunenenei akirot naka EJAKAIT mama ajai, kenerenena kayes, adilonokini tupuruc einer, konye mam yes ipotu kopuput. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.3",
            "verseOrgIds": [
              "JER.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.15"
              },
              "items": [
                {
                  "text": "2 Siit 36:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
