                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.19"
              },
              "items": [
                {
                  "text": "Isa 13:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, ebala EJAKAIT ebe, Kedaunos ikar akaisakanykaarei, kasodi eticani eoŋ ekabaka loko Babulon, ka ateker ŋin, ka akwap naka Ikaludean, kanuka numam adolitekec, ido etisili ikar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.12",
            "verseOrgIds": [
              "JER.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido ayauni kakwap ŋin akakiro kere nuabu kenerite, kere nuewadikatai oitabo lo, loadwari Yeremia mama ejaas atekerin kere, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.13",
            "verseOrgIds": [
              "JER.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 25:14"
          },
          "items": [
