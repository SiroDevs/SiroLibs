          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.15"
              },
              "items": [
                {
                  "text": "Yer 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.2"
              },
              "items": [
                {
                  "text": "40:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.16"
              },
              "items": [
                {
                  "text": "18:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ebala EJAKAIT ebe, Koany, ejukari aomare ikekia kere luka ari naka agolitomei, ka Nebukadaresar ekabaka loko Babulon, ekakejaanakinan, kayau kes aitiji akwap na, ka ŋul da luibojete kotoma, ka atekerin nu kere nuirimorito; ido amudiari cut, ketuluo kes aumokinet, aimuaret, asilio da namam edaun. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.9",
            "verseOrgIds": [
              "JER.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
