            "number": "19",
            "style": "v",
            "sid": "JER 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiira eporoto loka ŋul kaluketonolopete eoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.19",
            "verseOrgIds": [
              "JER.18.19"
