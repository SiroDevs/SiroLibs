          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibwaikinai eoŋ etau, wu EJAKAIT,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.19",
            "verseOrgIds": [
              "JER.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
