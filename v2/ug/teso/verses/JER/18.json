                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.10"
              },
              "items": [
                {
                  "text": "Yok 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " arai ibelokin ateker nin, naabu kenerite nuke, ainyein aronisike, eitokini aronis naalosikinit aiswamakin kes. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido kapak kaŋin naenerar nuka ateker ka nuka ajakanut, aiduk ka aira ŋes; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.9",
            "verseOrgIds": [
              "JER.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "arai kiswama aronis kakonyeneka, komam erimari eporotoka, kasodi eoŋ aiitokin aiokis naabu kener aitoiok ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.10",
            "verseOrgIds": [
              "JER.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.13"
              },
              "items": [
                {
                  "text": "2 Ika 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.16+ISA.1.17+ISA.1.18+ISA.1.19"
              },
              "items": [
                {
                  "text": "Isa 1:16-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do kolot, kolimok ituŋa luka Yuda, ka luibojete ko Yerusalem ebe: ‘Ebala kwanata EJAKAIT ebe: Koany, etemok aronis mama iiaas, eneru akirot asurokin yes. Kobonutu do yesi, ninitunanan korotoke lokaronon, kitojokata ikusirotin ka aswamisiokus da.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
