                  "text": "Mal 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete kesi atemar ebe, “Kopotu, kenerutu akiro asurokin Yeremia; naarai mam ikisila eoliorete kaneejai esasedoti, karaida ainerun kama ejaas lukacoa, karaida akirot kaneejai enabi. Kopotu do, kenomata ŋes kaŋajep, kenyeis oni aibwaikin etau akiroke kere.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.18",
            "verseOrgIds": [
              "JER.18.18"
            ]
          }
        }
      ]
    },
    {
