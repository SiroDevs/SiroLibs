                  "text": "2 Ses 2:9-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi EJAKAIT atemar eoŋ atiar, “Edwareteinabin nukainal kokirorika; mam eoŋ ejukarit kes, mam abu keeorak kes, karaida einer kakes: kidwarakinete yes aitapoer nakainal, ka aidwar naatai, ka aimod naka itauonokee bonik. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.14",
            "verseOrgIds": [
              "JER.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.15"
              },
              "items": [
                {
                  "text": "Yer 23:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka nun ebala kwanata EJAKAIT nuka inabin luedwarete kokirorika, komam eoŋ ejukarit kes, konye ebalasi ebe, ‘Mam ejaunos ekileŋ ka eteŋei kakwap kana’, ebe: Epiari ekileŋ ka eteŋei inabin ŋul. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.15",
            "verseOrgIds": [
              "JER.14.15"
            ]
          }
        },
        {
