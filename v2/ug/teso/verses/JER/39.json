                "loc": "JER.38.18"
              },
              "items": [
                {
                  "text": "Yer 38:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kieweata Ikaludean etogo loka eka baka, ka itogoi luka ituŋa, kotiyatiyata arwatatin nuka Yerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.8",
            "verseOrgIds": [
              "JER.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.11"
              },
              "items": [
                {
                  "text": "2 Ika 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.15"
              },
              "items": [
                {
                  "text": "Yer 52:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Nebusaradan ekapolon loka ikedarak aijoreor luasalito luka ituŋa luapianuna kore, ka luasiete da mamakeŋ, ka luasalito luka ituŋa luapianuna, koyana Babulon, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.9",
            "verseOrgIds": [
              "JER.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kitasal Nebusaradan, ekapolon loka ikedarak, lukican kotuna, luamamei idiobore, toma akwap naka Yuda, koinak kes kapak kaŋin amanat nuka emusabibu ka imanikoria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.10",
            "verseOrgIds": [
              "JER.39.10"
            ]
          }
        }
      ]
    },
    {
