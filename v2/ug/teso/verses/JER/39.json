            "sid": "JER 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido kicorak Nebukadaresar ekabaka loko Babulon Nebusaradan, ekapolon loka ikedarak, nuka Yeremia ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.11",
            "verseOrgIds": [
              "JER.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Koyana ŋes, kidari ŋes ejok, sirikiswamak nueroko; konye nukilimokini, nun iswamakini ŋes.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.12",
            "verseOrgIds": [
              "JER.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso kijuka Nebusaradan, ekapolon loka ikedarak, ka Nebusasiban lokerai Rabsaris, ka Neregal-sareser lokerai Rab-mag, ka ijaka kere luka ekabaka loko Babulon; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.13",
            "verseOrgIds": [
              "JER.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 39:14"
          },
          "items": [
