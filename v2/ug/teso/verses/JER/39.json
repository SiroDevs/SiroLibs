        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.10",
            "verseOrgIds": [
              "JER.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
