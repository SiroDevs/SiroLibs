            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.24"
              },
              "items": [
                {
                  "text": "26:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kijuka, kolemasi Yeremia kalaro naka ikedarak, kijaikis Gedalia okoku loka Akikam, okoku loka Sapan, ayaŋaar oreken. Kosodi kiboioto kituna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.14",
