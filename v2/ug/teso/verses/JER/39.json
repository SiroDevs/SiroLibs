                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokaru lokikanyetekaonon loka Sedekia ekabaka loka Yuda, olap lokitomonet, kobu Nebukadaresar ekabaka loko Babulon ka akeiore kere asurokin Yerusalem, kirigaut; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.1",
            "verseOrgIds": [
              "JER.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kokaru lokitomonet kalodiopet loka Sedekia, kolap lokiwononet, kapaaran nakikanyetekaonon naka elap, kocila ere. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.2",
            "verseOrgIds": [
              "JER.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen naerumiarere Yerusalem, kolomas ikapolok kere luka ekabaka loko Babulon, kiboikinos orute lokokidin, kes Neregal-sarescr, Samugar-nebo, Saresekim lokerai Rab-saris, Neregal-sareser lokerai Rabmag, ka ikapolok ice kere luka ekabaka loko Babulon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.3",
            "verseOrgIds": [
              "JER.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, keanyu Sedekia ekabaka loka Yuda, ka ikajiok kere, kokerata, konyout kotoma ore kuare, korot loka emanikor loka ekabaka, korute lokokidiŋ arwatatin aarei: koloma korot loka Araba, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.4",
            "verseOrgIds": [
              "JER.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
