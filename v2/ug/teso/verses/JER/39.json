                {
                  "text": "52:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kogorununoi akonye nuka Sedekia, koenai ŋes kirikoi, ayaŋaar Babulon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.7",
            "verseOrgIds": [
              "JER.39.7"
            ]
          }
        },
        {
