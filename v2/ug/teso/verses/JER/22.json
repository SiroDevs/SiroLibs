                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai inera kwanata EJAKAIT nuka ekek loka ekabaka loka Yuda ebe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
