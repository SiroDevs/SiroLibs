        },
        {
          "text": " Inera EJAKAIT kwanata ebe: Kitodolenenete etube ka adolit, koyuutu inatara kakan naka ekareiton. Sirikireata, sirikiswamakis imoit, ka ikoki, ka apuserut, nukepali, sirikibukosi aokot numam akirot kaibois kana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.3",
            "verseOrgIds": [
              "JER.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 22:4"
          },
          "items": [
