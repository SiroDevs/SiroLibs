                {
                  "text": "Yer 17:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai arai teni kiswamata akirot ŋin, kwaŋin elomuniata korutei luka etogo kalo ikabakan luibojete koicolon loka Daudi, ibwanenito agalin ka ibalasin, kes, ka ikecekejaanakinak, ka ikeceruna da. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.4",
            "verseOrgIds": [
              "JER.22.4"
            ]
          }
        },
