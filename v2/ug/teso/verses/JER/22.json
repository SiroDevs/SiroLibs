            "number": "2",
            "style": "v",
            "sid": "JER 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolimok ebe, ‘Kiira akirot naka EJAKAIT, ijo ekabaka loka Yuda, loiboie koicolon loka Daudi, ijo ka ikonikejaanakinak ka ikonituŋa da luelomununete orutei lu, ",
          "type": "text",
          "attrs": {
