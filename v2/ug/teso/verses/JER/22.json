          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabarai ŋipeŋina neijoreoritai ŋes etwanikini, kwabo mam bobo eanyuni akwap na.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
