        },
        {
          "text": " Akirot naka EJAKAIT naabu kobu mama ejai Yeremia, kodaunite ekabaka Sedekia aitutuk aitutuket kituna kere luajaas Yerusalem, alimor aosikinio kamakec. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.8",
            "verseOrgIds": [
              "JER.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 34:9"
          },
          "items": [
