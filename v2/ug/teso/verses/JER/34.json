                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.39"
              },
              "items": [
                {
                  "text": "Leb 25:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋinitunanan aosikin ekebulesit, ka ninitunanan aosikin akebulesit, arai erai Eburaniat, arai Aburaniat; kinye ajaut yeriitubusiani Eyudayat, onaceke, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.9",
            "verseOrgIds": [
              "JER.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete ikapolok kere ka iruna kere arimar, nul luetutukito aitutuket, ninirunanan aosikin ekebulesit, ka ŋinituŋanan aosikin akebulesit, kinyeis aitubusianio bobo; korimasi, koosikis, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.10",
            "verseOrgIds": [
              "JER.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
