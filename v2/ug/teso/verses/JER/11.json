            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.11"
              },
              "items": [
                {
                  "text": "Tub 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.18"
              },
              "items": [
                {
                  "text": "Esk 20:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abonosi mama ejaas numam adolit nuka lukapapaakee, luapotu kogiroto apupun akakiro; atupasi kesi icedekesio aijaanakin: abilata ekek loka Isirael ka ekek loka Yuda akaitutuket naketutukit kalukapapaakee. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.10",
            "verseOrgIds": [
              "JER.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
