            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete ireria luka Yuda ka luibojete koYerusalem alosit amonyakin idekesio luisupuronokino lukisupurununo: konye mam cut itajarete kes kapak naka icanikec. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.12",
            "verseOrgIds": [
              "JER.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kwape imwatatar ireriakon, imwaasi kwaŋin ikonidekesio da, ijo Yuda; ido kwape imwatatar irotin luka Yerusalem, ipotu kosipokis ileic itemwan, kes itemwan aisupurikin Baal lukisupurununo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.13",
            "verseOrgIds": [
              "JER.11.13"
            ]
          }
        }
      ]
    },
