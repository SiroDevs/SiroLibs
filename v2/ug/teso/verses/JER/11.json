              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.2"
              },
              "items": [
                {
                  "text": "Sab 44:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.2"
              },
              "items": [
                {
                  "text": "Isa 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai abu EJAKAIT loka aioresio lokiraikini jo kolim aronis kamakon, kanuka aronis naka ekek loka Isirael, ka naka ekek loka Yuda, nakiswamakinos bonik ketunyunyurikis eoŋ kanuka aisupuronokin Baal lukisupurununo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.17",
            "verseOrgIds": [
              "JER.11.17"
            ]
          }
        }
      ]
