            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun ebala EJAKAIT kwanata ebe, Koany, ayaun aronis mamakec, namam epedorete ainae; karaida kamonyakis, konye mam eoŋ eirari kes. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.11",
            "verseOrgIds": [
