              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.13"
              },
              "items": [
                {
                  "text": "Yer 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.16"
              },
              "items": [
                {
                  "text": "2 Ika 21:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kajalata eoŋ, amunaut aibois na, kisupurununut lukisupurununo kotomake mama ejaas idekesio ice, lumam lem ejenete, kes ka lukapapaakec, ka ikabakan luka Yuda; kilelebata aibois na kaokot nuka lumam akirot. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.4",
            "verseOrgIds": [
              "JER.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
