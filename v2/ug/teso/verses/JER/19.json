            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ilimokini kes ebe, ‘Ebala kwanata EJAKAIT loka ajoresio ebe: Abwani kwape kwaŋin ituŋa lu ka ere lo, kwape ebwania ituŋanan amot naka ekaiean, namam bobo epedorio aipueakin. Ido idaikinete ituŋa Topet, naarai emamikini aibois kamace, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala EJAKAIT ebe, Eswamakini kwape kwaŋin aibois na, ka luibojete kotoma, aituputoor ere lo kwape Topet, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
