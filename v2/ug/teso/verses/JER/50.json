          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Araur ikatuŋa amerekekin nukeoliorete; erooliosi ikecokokokec, etapaasi oroŋan: anyout koronat kiton oukor, imurwokinito nekeuriakenenata. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.6",
            "verseOrgIds": [
              "JER.50.6"
            ]
          }
        },
        {
