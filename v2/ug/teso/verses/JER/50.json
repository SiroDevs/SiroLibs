        },
        {
          "text": "“Ebala EJAKAIT ebe, Kapaarasia kakwa, kapak kaŋin da, epote idwe luka Isirael, kes nepepe ka idwe luka Yuda; emonyete elosete, komootos EJAKAIT Ekecedeke. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.4",
            "verseOrgIds": [
              "JER.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
