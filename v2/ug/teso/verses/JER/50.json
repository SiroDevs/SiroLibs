                "loc": "JER.31.31"
              },
              "items": [
                {
                  "text": "Yer 31:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.25"
              },
              "items": [
                {
                  "text": "1 Pet 2:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inisete nuka Sion, kotereitos ereetakec nina, koba las ebe, ‘Kopotu, kemorikikinos ka EJAKAIT kaitutuket namam edaun namam imurwokinio.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.5",
            "verseOrgIds": [
              "JER.50.5"
            ]
          }
        }
