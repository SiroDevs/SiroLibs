                  "text": "Sab 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anyamata kere lukeanyunete: kobalas lukasurupokec ebe, ‘Mam kigwaunit akiro, naarai adiakasi kama ejai EJAKAIT, aiboisikec nakabeit, ŋes EJAKAIT, amun naka lukapapaakee.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.7",
            "verseOrgIds": [
