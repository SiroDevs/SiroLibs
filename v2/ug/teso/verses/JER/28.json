            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, kokaru kanope kanol, kageunet naka airum naka Sedekia ekabaka loka Yuda, okaru lokiwononer, olap lokikanyet, abu Kanania okoku loka Asur, enabi, lokerai loka Gibeon kiner keoŋ kotogo loka EJAKAIT, koiaas isasedotin ka ituŋa da kere nepenen, kobala ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.1",
            "verseOrgIds": [
              "JER.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
