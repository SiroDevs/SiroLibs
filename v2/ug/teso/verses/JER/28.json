              "items": [
                {
                  "text": "Awa 26:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiner Kanania koiaas ituŋa kere ebe, “Ebala EJAKAIT kwanata ebe: Abili kwaŋin ajookot naka Nebukadaresar ekabaka loko Babulon komurisina luka atekerin kere eriŋa cut edauna ikar iarei.” Kosodi enabi Yeremia asuenyikin.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        }
