              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Kanania enabi, kolem akitoi komurisin loka enabi Yeremia, kobil. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.10",
            "verseOrgIds": [
