              },
              "items": [
                {
                  "text": "2 Ika 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Siit 36:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.16+JER.27.17+JER.27.18+JER.27.19+JER.27.20+JER.27.21+JER.27.22"
              },
              "items": [
                {
                  "text": "Yer 27:16-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eriŋa cut edauna ikar iarei enyakuni bobo toma aibois na iboro kere lukotogo loka EJAKAIT, luabu Nebukaderesar ekabaka loko Babulon kolema kaibois kana kosodi ayaŋaar Babulon, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido ebala EJAKAIT ebe, Enyakuni bobo toma aibois na Yekonia okoku loka Yekoiakim, ekabaka laka Yuda, ka ikijoreoritono kere luka Yuda, lualosito Babulon: naarai abili ajookot naka ekabaka loko Babulon.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        }
      ]
    },
    {
