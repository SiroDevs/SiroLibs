          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi enabi Yeremia alimokin enabi Kanania kojaas isasedotin, koiaas da iruŋa kere ebwoete kotogo loka EJAKAIT, ",
          "type": "text",
          "attrs": {
