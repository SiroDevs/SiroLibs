                "loc": "DEU.18.22"
              },
              "items": [
                {
                  "text": "Ikis 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.20"
              },
              "items": [
                {
                  "text": "Isa 8:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Enabi loedwari nuka ainapakin, kedol akirot naka enabi kanol, ŋes konyet ejenunere ebe, abeit EJAKAIT ejukunit enabi ŋol.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
