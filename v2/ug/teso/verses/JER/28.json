          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋes ebalar EJAKAIT ebe: ‘Koany, kereneari jo kakwap: itwani kokaru kalo, naarai iner nuka epali mama ejai EJAKAIT.’’’",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
