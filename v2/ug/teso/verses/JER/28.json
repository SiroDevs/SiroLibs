                {
                  "text": "Yer 27:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inera kwanata EJAKAIT loka aioresio, Edeke loka Isirael ebe: Abi! eoŋ aiookot naka ekabaka loko Babulon, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
        {
          "name": "verse",
