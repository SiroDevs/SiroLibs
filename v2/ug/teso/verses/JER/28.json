              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kedau enabi Kanania aibil akitoi komurisin loka enabi Yeremia, kobu akirot naka EJAKAIT mama ejai Yeremia kobala ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.12",
            "verseOrgIds": [
              "JER.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kolot, kolimok Kanania ebe, ‘Inera EJAKAIT kwanata ebe, Ibila ijo ajookot naka akito; konye iswamauni do aiookon nuka asua aiboisikec. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.13",
            "verseOrgIds": [
              "JER.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 28:14"
          },
          "items": [
