        },
        {
          "text": " Kosodi enabi Yeremia kotema enabi Kanania atiar, “Kiira kito, Kanania; mam EJAKAIT kiyakienenet: konye iinak ituŋa lu amunokina aiŋal, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.15",
            "verseOrgIds": [
