              "items": [
                {
                  "text": "Ikis 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJAKAIT ebe, Mere kwape ejaar aitutuket nakolo etutuki ka lukapapaakec kapaaran naketinia kakan aitonyoun kakwap nako Misiri: apotu kobilata aitutuket ŋin karaida abu karai lokowaikec. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.32",
            "verseOrgIds": [
              "JER.31.32"
            ]
          }
        },
