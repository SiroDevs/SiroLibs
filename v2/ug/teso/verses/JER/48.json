            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Irumete Moab ileic kanuka Kemos, kwape erumiata ileic ekek loka Isirael kanuka Bet-el loamunokina.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.13",
            "verseOrgIds": [
              "JER.48.13"
            ]
          }
        }
      ]
    },
    {
