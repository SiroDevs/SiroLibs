              "items": [
                {
                  "text": "Yer 25:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kitemerata ŋes, naarai itopolooro kama ejai EJAKAIT; imodumodun Moab kalekanake, imuario da. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.26",
            "verseOrgIds": [
              "JER.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.24.17"
              },
              "items": [
                {
                  "text": "Awa 24:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.2.8"
              },
              "items": [
                {
                  "text": "Sep 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.26"
              },
              "items": [
                {
                  "text": "Yer 2:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam kereka kerai Isirael eimuaritono kamakon? Aponi kereka kodumakinai kidiŋ kikokolak? Naarai nainerenenar nuke, imunimuŋi akonikou.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.27",
            "verseOrgIds": [
              "JER.48.27"
            ]
          }
        }
      ]
    },
