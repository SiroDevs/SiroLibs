          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Adoloki atubokinio akwap naka apuutona; Kolon, ka Yasa, ka Mepaat, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.21",
            "verseOrgIds": [
              "JER.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Dibon, ka Nebo, ka Bet-dibilataim; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.22",
            "verseOrgIds": [
              "JER.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Kiriataim, ka Betgamul, ka Bet-meon; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.23",
            "verseOrgIds": [
              "JER.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.2"
              },
              "items": [
                {
                  "text": "Amo 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka Keriot, ka Bosura, ka ireria kere luka akwap nako Moab, lueiaas kama elwana, ka lueapiete da. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.24",
            "verseOrgIds": [
              "JER.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala EJAKAIT ebe, Atubor amumwarat naka Moab, abila akekan da.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.25",
            "verseOrgIds": [
              "JER.48.25"
            ]
          }
        }
      ]
    },
