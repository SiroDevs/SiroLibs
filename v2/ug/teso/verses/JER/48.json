        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.11",
            "verseOrgIds": [
              "JER.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ebala EJAKAIT ebe, Aso koany, epote apaarasia nueiukunia nul luebukonorete, ido ebukonorete ŋes; itoonete amotiike, ebwanabwangaete da acupaike. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.12",
            "verseOrgIds": [
              "JER.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
