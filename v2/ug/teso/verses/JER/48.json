            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kikenoi nin yenipalisikini aswam naka EJAKAIT; kikenoi da ijin yenirebokini ekileŋ kinyek abukor aokot.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.10",
