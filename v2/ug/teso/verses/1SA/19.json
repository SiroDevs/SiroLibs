          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelimokin Saul nun, abu kijuka ieekiyakia, kodwarata nul da, Kijuka Saul ikiyakia bobo irwan nakiwuniet, kodwarata kesi da, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.21",
            "verseOrgIds": [
