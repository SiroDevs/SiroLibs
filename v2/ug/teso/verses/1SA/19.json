              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.16"
              },
              "items": [
                {
                  "text": "Asw 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye Yonatan okoku loka Saul amina noi Daudi. Kolimok Yonatan Daudi ebe, “Ekot Saul papaka aiar jo: asa do kenainait, koeoikin tupuruc, konop kaibois nakaiyeiyea: ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.2",
            "verseOrgIds": [
              "1SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alomari eoŋ abwoi da kapapaka komanikor loijai, eneruni nukon kapapaka; arai kajen akirot, kalimokini jo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.3",
            "verseOrgIds": [
              "1SA.19.3"
            ]
          }
        },
        {
