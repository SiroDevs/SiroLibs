            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.29.10"
              },
              "items": [
                {
                  "text": "29:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokoto Saul airem Daudi aiminaikin arwatat kakekwara: konye kigaikin ŋesi konyou kakonyen nuka Saul, korem do akwarake arwatat: koker Daudi koku akuare ŋin.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.10",
            "verseOrgIds": [
              "1SA.19.10"
            ]
          }
        }
      ]
    },
