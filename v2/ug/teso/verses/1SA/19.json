                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Saul Mikal atiar, “Kanukinyo kimodia ijo eoŋ kwaŋin, aisiikin lokasurupika alosit, tape ekui?” Koboŋok Mikal Saul atiar, “Abu katema eoŋ atiar, ‘Koosikinai kalot; kanu kainyo tikaaria eoŋ ijo?’”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        }
