          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.7",
            "verseOrgIds": [
              "1SA.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojaun bobo ejie: koloma Daudi kitiji Ipilisitian, koara kes noi; kokerata kakonyeneke. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.8",
            "verseOrgIds": [
              "1SA.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.14"
              },
              "items": [
                {
                  "text": "1 Sam 16:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.10"
              },
              "items": [
                {
                  "text": "18:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobunok Saul emoyo loerono loabuni kama ejai EJAKAIT, iboie ŋesi kotogoke kakekwara kakanike; koram Daudi adeudeu kakekan. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.9",
            "verseOrgIds": [
              "1SA.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 19:10"
          },
          "items": [
