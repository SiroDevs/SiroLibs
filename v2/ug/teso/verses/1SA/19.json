                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijuka Saul ikiyakia togo loka Daudi aidar ŋes, tetere earete tupuruc: kotema Mikal aberu naka Daudi ŋes atiar, “Arai mam jo itajari akoniijar akuare na kiario moi jo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.11",
            "verseOrgIds": [
              "1SA.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
