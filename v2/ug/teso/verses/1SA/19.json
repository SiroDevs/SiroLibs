            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiner Saul kaYonatan okokuke, ka ikekejaanakinak kere ebe tikearata kesi Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.1",
            "verseOrgIds": [
              "1SA.19.1"
            ]
          }
        },
