              "type": "text"
            }
          ]
        },
        {
          "text": "Kijuka Saul ikiyakia aanyun Daudi ebe, “Koinunai ŋes koitada, tetere aari ŋes.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.15",
            "verseOrgIds": [
              "1SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakelomut ikiyakia, koany, ajai aput naka edeke oitada, ka egoe loka ajul nuka akinei akwesike. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.16",
            "verseOrgIds": [
              "1SA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
