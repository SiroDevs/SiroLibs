                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodilok Daudi anyoun, ŋes ka iketuŋa, alosit tupuruc, aboŋor akwap naka Ipilisitian. Koloto Ipilisitian Yesereel.",
          "type": "text",
          "attrs": {
