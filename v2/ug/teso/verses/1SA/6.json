              "type": "text"
            }
          ]
        },
        {
          "text": "Nu kes abusion nuka esabu nuenyakarete Ipilisitian araun ainakinet naka aibucaret mama ejai EJAKAIT; naka Asudod adiopet, naka Gasa adiopet, naka Asukelon adiopet, naka Gat adiopet, ka naka Ekuron da adiopet; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.17",
            "verseOrgIds": [
              "1SA.6.17"
            ]
          }
        },
        {
          "name": "verse",
