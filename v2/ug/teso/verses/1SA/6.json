          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka imirio luka esabu, kwape ajaar etiai loka ireria kere luka iiaka ikany luka Ipilisitian, ireria luebwaitai ka ireria lukoronyia. Amoru naapol, naasipokinete kesi asaduku naka EJAKAIT, amoru nin ejai kiton lolo omanikor loka Yosua Ebet-semit,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.18",
            "verseOrgIds": [
              "1SA.6.18"
            ]
          }
        }
