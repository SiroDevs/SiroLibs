                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.35.1"
              },
              "items": [
                {
                  "text": "Sab 35:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
