                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, napenetakini Daudi einer akiro ŋun mama ejai Saul, kotema Saul atiar, “Erai lo eporotokon, okokuka Daudi?” Kodelo Saul komony. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.16",
            "verseOrgIds": [
