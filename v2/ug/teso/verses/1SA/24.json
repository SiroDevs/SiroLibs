              "items": [
                {
                  "text": "43:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.9"
              },
              "items": [
                {
                  "text": "Mik 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kirabak EJAKAIT, kotubok da eoŋ ka jo, koany ŋesi, kapurok, kayuu da kakanikon.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.15",
            "verseOrgIds": [
