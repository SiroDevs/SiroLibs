                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.43"
              },
              "items": [
                {
                  "text": "1 Sam 17:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.9.8"
              },
              "items": [
                {
                  "text": "2 Sam 9:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iŋai nat elomunit ekabaka loka Isirael asurokin? Iŋai bo idopiat ijo? Ekiŋok lokatwan, idepidepit. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.14",
            "verseOrgIds": [
              "1SA.24.14"
            ]
          }
        },
        {
