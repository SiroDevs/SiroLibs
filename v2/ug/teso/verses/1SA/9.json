                "loc": "1SA.10.1"
              },
              "items": [
                {
                  "text": "1 Sam 10:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.1"
              },
              "items": [
                {
                  "text": "15:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
