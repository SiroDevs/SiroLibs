              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.23"
              },
              "items": [
                {
                  "text": "1 Sam 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kejai ŋes okokuke, ekekiror Saul, ekatumunan loejok loetemelel: amamei kodwe luka Isirael yenadeparit ŋes katemelel: aoia ŋesi anyoun kokeperinike adepar iruna kere.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.2",
            "verseOrgIds": [
              "1SA.9.2"
            ]
          }
        }
