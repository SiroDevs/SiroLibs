              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu kooliosi asigiria nuka Kis, papa loka Sau!. Kotema Kis Saul okokuke atiar, “Koyaŋa ediopet kobulesin konyou, kolot aimo asigiria.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.3",
            "verseOrgIds": [
              "1SA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.42"
              },
              "items": [
                {
                  "text": "2 Ika 4:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitor akwap nakiukon naka Epuraim, kitor da akwap naka Salisa, konye mam apotu kodumut kes: kosodete aitor akwap naka Saalim, komameete kanen da: kitor akwap naka Ibenyamin, konye mam apotu kodumut kes.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.4",
            "verseOrgIds": [
              "1SA.9.4"
            ]
          }
        }
      ]
    },
