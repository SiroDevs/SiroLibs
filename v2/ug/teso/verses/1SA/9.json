                "loc": "LEV.7.32"
              },
              "items": [
                {
                  "text": "Leb 7:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.4"
              },
              "items": [
                {
                  "text": "Esk 24:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.9"
              },
              "items": [
                {
                  "text": "Asw 10:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyana ekepoon amurwo ka akwalikwalike, kibwaik akonyen nuka Saul. Kotema Samuel atiar, “Koany, nin naaponi kinadakinail Kibwaik akonyenekon, konyam; naarai kinadakinitai jo aitodol apak naaseikinitai, naarai abu kabala ebe, Anyaraunit iruna.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
