                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu EJAKAIT kopukokinite Samuel apaaran adiopet eroko Saul kebuno ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.15",
            "verseOrgIds": [
              "1SA.9.15"
            ]
          }
        },
