              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Saul atemar ekebulesit atiar, “Iner ejok; bia, kaloto.” Kolototo ore neajai etuŋanan loka Edeke.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.10",
