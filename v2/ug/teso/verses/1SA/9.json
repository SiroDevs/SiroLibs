            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.15"
              },
              "items": [
                {
                  "text": "Tub 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋok Saul ebe, “Mere eoŋ Ebenyamit, loka ateker naedit noi katekerin nuka Isirael? Ekekika da loedit noi kokekia kere luka ateker naka Benyamin? Kanukinyo inerar keoŋ nuikote nen?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.21",
            "verseOrgIds": [
              "1SA.9.21"
            ]
          }
        }
      ]
