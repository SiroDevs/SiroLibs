          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.26",
            "verseOrgIds": [
              "1SA.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋesaros kesi alomar kore, kotema Samuel Saul atiar, “Kolimok ebulesit kotubor kinarencwok, (kotubori ŋesi,) konye kobwo ijo kanepekane, tetere kesiirari jo akiro naka Edeke.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.27",
            "verseOrgIds": [
              "1SA.9.27"
            ]
          }
        }
      ]
