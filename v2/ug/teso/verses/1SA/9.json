        },
        {
          "text": " Kojai etuŋanan loka Benyamin, ekekiror Kis, okoku loka Abiel, okoku loka Seror, okoku loka Bekorat, okoku loka Apia, okoku loka Ebenyamit, etuŋanan Ioagogon loabarit. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.1",
            "verseOrgIds": [
              "1SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 9:2"
          },
          "items": [
