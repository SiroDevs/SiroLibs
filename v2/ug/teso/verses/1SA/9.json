          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyana Samuel Saul ka ebulesitike, koyaŋau kes agola naka ipejok, kisiboik kes aiboisio nukapolou neaiaas Iuanyaritai, luemwaasi ituŋa akaisauni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.22",
            "verseOrgIds": [
              "1SA.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Samuel ekepoon atiar, “Koyau einer loabu kainak jo, loabu kalimok jo ebe, ‘Kidar ŋes.’’’ ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.23",
            "verseOrgIds": [
              "1SA.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
