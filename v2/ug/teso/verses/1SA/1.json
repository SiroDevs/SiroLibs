        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.2",
            "verseOrgIds": [
              "1SA.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 1:3"
