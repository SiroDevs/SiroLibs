            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.17.8"
              },
              "items": [
                {
                  "text": "2 Sam 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koriebi ŋin eketau, kilip EJAKAIT, komony noi akiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.10",
            "verseOrgIds": [
              "1SA.1.10"
            ]
