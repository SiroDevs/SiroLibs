            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.27"
              },
              "items": [
                {
                  "text": "1 Siit 6:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.2"
              },
              "items": [
                {
                  "text": "Rus 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kojai etuŋanan loka Ramataim-sopim loka akwap nakiukon naka Epuraim, ekekiror Elukana okoku loka Yerokam, okoku loka Eliku, okoku loka Toku, okoku loka Sup, Epuraimut. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.1",
            "verseOrgIds": [
              "1SA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojaas ŋes aŋor aarei; adiopet ekekiror Kana, naee da ekekiror Penina: ajaas Penina idwe, konyc amameete Kana idwe,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.2",
            "verseOrgIds": [
              "1SA.1.2"
            ]
          }
        }
      ]
    },
    {
