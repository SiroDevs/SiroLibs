              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.12+JER.7.13+JER.7.14"
              },
              "items": [
                {
                  "text": "Yer 7:12-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi konyounenei etuŋanan ŋol koreke ŋolikaru, kolosenenei aima ka ainakin asuban mama ejai EJAKAIT loka ajoresio kotoma Silo, Kojaas ŋina odwe iarei luka Eli, Kopuni ka Pinekas, isasedotin luka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.3",
            "verseOrgIds": [
              "1SA.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kedol apaaran nakeinakinia Elukana asuban, koinanak akeberu Penina, ka ikedwe kere lusap ka lupesur, akorakineta; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.4",
            "verseOrgIds": [
              "1SA.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.30.2"
              },
              "items": [
                {
                  "text": "Age 30:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye koinak Kana akorakineta aarei: naarai kemina ŋesi Kana, konye kegolit EJAKAIT akeliliget. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.5",
            "verseOrgIds": [
              "1SA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kitunyunyurik noi akainike ŋes, kisiyalonono da, naarai kegolit EJAKAIT akeliliget. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.6",
            "verseOrgIds": [
              "1SA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.14"
              },
              "items": [
                {
                  "text": "Any 23:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Ikis 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.41"
              },
              "items": [
                {
                  "text": "Luk 2:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswamaenenei kwaŋin nolikaru, nakeloseneneo togo loka EJAKAIT, kitunyunyuranakini ya kwaŋin: tape emonyi akiyo, kogir ainyam. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.7",
            "verseOrgIds": [
              "1SA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.15"
              },
              "items": [
                {
                  "text": "Rus 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobala okilenike Elukana ŋes ebe, “Kana, inyo bo imonyi ijo? Inyo bo kitukurwo ainyam? Inyo da itururwoo ekonitau? Mam kereka eoŋ etelekarit idwe itomon kaiokis kamakon?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.8",
            "verseOrgIds": [
              "1SA.1.8"
            ]
          }
        }
      ]
    },
