                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eswama EJAKAIT kanuke, kwape abu kineria kamakaŋ: acila EJAKAIT ajakanut kakanikon, ainaki eidunyetekon Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
