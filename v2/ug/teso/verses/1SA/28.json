              "items": [
                {
                  "text": "1 Sam 31:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotukonokinos Ipilisitian kopotu kidukuroto Sunem: kotukok Saul Isirael kere, kidukuroto Giliboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.4",
            "verseOrgIds": [
              "1SA.28.4"
            ]
          }
        },
