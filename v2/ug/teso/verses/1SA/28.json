              "type": "text"
            }
          ]
        },
        {
          "text": " Keanyu Saul aiore naka Ipilisitian abu kokurianar, komaran eketau noi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.5",
            "verseOrgIds": [
              "1SA.28.5"
            ]
          }
