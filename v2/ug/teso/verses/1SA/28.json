                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi nakinisia Saul EJAKAIT, mam EJAKAIT abu koboŋok ŋes, karaida kotoma airujasia, karaida koUrim, karaida konabin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Saul atemar ikebulesin atiar, “Komoikinai aberu naejai ajokit, tetere alosi mamake aiŋitun.” Kotemasi ikekejaanakinak ŋes atiar, “Koany, ejai aberu En-dor naejai aiokit.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        }
      ]
    },
    {
