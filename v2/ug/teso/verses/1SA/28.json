              "items": [
                {
                  "text": "Isa 8:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitegelikin Saul, konap ieenapen, kolot, ŋes ka ituŋa iarei, kopotu neejai aberu kuare: kotema atiar, “Keŋainait, kodwarakinai kaiokit, kitodokik eoŋ kere yenikalimokini.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.8",
            "verseOrgIds": [
              "1SA.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema aberu ŋes atiar, “Koany, ijeni nueswama Saul, kwape erenearia luejaas ajokin ka ikacudak kakwap: kanukinyo ilokia ijo akaijar, aiar eoŋ?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.9",
            "verseOrgIds": [
              "1SA.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyapcik Saul ŋes kolimit EJAKAIT ebe, “Kwape ejaria EJAKAIT, mam adiokiticanet kidoikin jo kanuka akirot kana,” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi aberu atemar atiar, “Iŋai bo etodokuni mamakon?” Kotema atiar,” Kitodokikinai Samuel.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.2"
              },
              "items": [
                {
                  "text": "Isa 57:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.13"
              },
              "items": [
                {
                  "text": "Apu 14:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keanyu aberu Samuel, kodelo keporoto loepol: kotema aberu Saul atiar, “Kanukinyo kimodia ijo eoŋ? Kwabo irai ijo Sau!.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.12",
            "verseOrgIds": [
              "1SA.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.28"
              },
              "items": [
                {
                  "text": "Any 22:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.138.1"
              },
              "items": [
                {
                  "text": "Sab 138:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema ekabaka ŋes atiar, “Sirikikurianar: naarai inyo iseseni ijo?” Kotema aberu Saul atiar, “Aseseni edeke edokuni kokwap.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        },
        {
          "name": "verse",
