          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.9"
              },
              "items": [
                {
                  "text": "Rom 12:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Daudi Akis atiar, “Kanuka nun ijenuni nuiswamai ekonikejaanakinan.” Kotema Akis Daudi atiar, “Kanuka nun kadakakini araun ekedaran akouka apaarasia kere.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
