              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Samuel atiar, “Aso kanukinyo kinisia eoŋ, naarai anyou EJAKAIT kamakon, erai da lokasurupikon? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.16",
            "verseOrgIds": [
              "1SA.28.16"
            ]
          }
        },
