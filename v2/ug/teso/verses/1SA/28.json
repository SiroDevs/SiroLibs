            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobu aberu neejai Saul, koany ebe eyalononoi noi, kotema ŋes atiar, “Koany, apupoki akonibulesit eporotokon, adaearit akaiiar, apupok akonikiro nuibu kolimok eoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.21",
