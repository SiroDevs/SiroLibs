                  "text": "2 Sam 24:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kimara kes koBesek; emwaasi idwe luka Isirael ilukumin akwat auni, ka ituŋa luka Yuda ilukumin akaisauni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.8",
            "verseOrgIds": [
              "1SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotemasi kesi ikiyakia luapote atiar, “Ilimokinete kwanata ituŋa luka Yabes-gilead ebe, ‘Moi, kapak naemwaniar akoloŋ, kiyuunio.’ “Kopotu ikiyakia kolimokis ituŋa luka Yabes; kiyalamikinos. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.9",
            "verseOrgIds": [
              "1SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka ŋun kotemasi ituŋa luka Yabes atiar, “Kibuni moi mama ijai, kiswamakini isio kere nuitojokit ijo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.10",
            "verseOrgIds": [
              "1SA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 11:11"
          },
          "items": [
