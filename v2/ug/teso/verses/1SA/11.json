            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kopotu ikiyakia Gibea loka Saul, kolimokis ituŋa akiro ŋun: kodelosi ituŋa kere, komonyata,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.4",
