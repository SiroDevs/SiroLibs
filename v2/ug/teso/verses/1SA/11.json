            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodoik emoyo loka Edeke Saul kagogon nakepupunia akiro nun, kinep noi akenyunyura. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.6",
            "verseOrgIds": [
              "1SA.11.6"
            ]
          }
        },
