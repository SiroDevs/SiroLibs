              "items": [
                {
                  "text": "Yak 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojaun kwaŋin tupuruc, kitemok Saul ituŋa orioneta iuni; kopotu kidin kiidukurun kakwenyunet naka tupuruc, kodanyata monain aitodol amwanis naka apaaran: kosodi kanen kisiarakinos luapotu kideunos, komam iarei kakesi esalete nepepe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.11",
            "verseOrgIds": [
              "1SA.11.11"
            ]
          }
        }
      ]
