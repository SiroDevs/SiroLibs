            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido koany, kobu Saul komanikor, etupit imoŋin; kotema Saul atiar, “Inyo bo isiriebi ituŋa tape emonyete?” Kolimokis ŋes akiro nuka ituŋa luka Yabes. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.5",
            "verseOrgIds": [
              "1SA.11.5"
            ]
          }
        },
