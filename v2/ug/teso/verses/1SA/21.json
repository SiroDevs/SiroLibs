              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyou Daudi koker kapaaran kaŋin kanuka ayoŋit Saul, kolot mama ejai Akis eka baka loka Gat, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.10",
            "verseOrgIds": [
              "1SA.21.10"
            ]
          }
        },
