            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ajai etuŋanan loka ikejaanakinak luka Saul nen kapaaran kaŋin, loetapaikinitai akonyen nuka EJAKAIT; ekekiror Doeg Edomait, ekapolon Ioka ikeeokok luka Saul.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.7",
