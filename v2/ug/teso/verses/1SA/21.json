              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Daudi Akimelek atiar, “Emamei kane kakanikon akwara atai ekileŋ? Naarai mam ayaunit ekakileŋ karaida lujiisika, naarai abu aswam naka eka baka kesuburia.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.8",
            "verseOrgIds": [
              "1SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
