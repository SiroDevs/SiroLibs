                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.26"
              },
              "items": [
                {
                  "text": "Leb 8:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋok Daudi esasedoti atiar, “Abeit mam sio kiperit kanor apaarasia nu auni; naanyounio eoŋ alaete iboro luka ikatumunak, karaida kerai alosit nakadue; elaete do noi ikeeeboro lolo,” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.5",
            "verseOrgIds": [
              "1SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
