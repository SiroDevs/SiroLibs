            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋok esasedoti Daudi ebe, “Emamei emugati lodue kakanika, konye ajaas imugatin lukalaunak; arai mam ca ikatumunak eperito kanor,’ ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.4",
            "verseOrgIds": [
              "1SA.21.4"
            ]
          }
        },
        {
