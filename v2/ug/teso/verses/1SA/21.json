              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.56.1"
              },
              "items": [
                {
                  "text": "Sab 56:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kibwaik Daudi akiro ŋun otauke, kokurianar noi Akis eka baka loka Gat. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.12",
            "verseOrgIds": [
              "1SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.1"
              },
              "items": [
                {
                  "text": "Sab 34:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijulak ejauteneke kakonyenekee, kosub bala ebaŋ kakaninikee, koram ikirigin lukorute, kojalak akeimul eleleete kopenekike. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.13",
            "verseOrgIds": [
              "1SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Akis atemar ikekejaanakinak atiar, “Okwe ikatuŋa, kianyut ebe ebanaana etuŋanan ŋol: kanukinyo kiinuniata? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.14",
            "verseOrgIds": [
              "1SA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emameete eoŋ ibaŋiok, tape iyaunete etuŋanan lo asubit ebaŋ kakonyeneka? Elomuni kereka etuŋanan lo oreka?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.15",
            "verseOrgIds": [
              "1SA.21.15"
            ]
          }
        }
      ]
