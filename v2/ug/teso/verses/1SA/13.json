              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye alosenenete Isiraelin kere mama ejaas Ipilisitian, ninituŋanan aipen ekemeleku, ka ekilenike, ka aepeke ka eŋitike; ",
          "type": "text",
          "attrs": {
