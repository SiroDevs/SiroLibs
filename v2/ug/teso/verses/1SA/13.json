              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kopotu ikaŋatak koidukurun luka Ipilisitian korioneta iuni: kitor erioŋet ediopet orot loebei Opura, kiton akwap naka Saul: ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.17",
            "verseOrgIds": [
