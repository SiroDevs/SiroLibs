              },
              "items": [
                {
                  "text": "Yos 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotukokinos Ipilisitian aitiji Isirael, agalin alukumin akaisauni, ka ikebwanenok ibalasin ilukumin ikanykape, ka ituŋa bala asine naejai ariri naka aŋolol: kopotu kidukuroto Mikimas, ari nakokide naka Bet-aben. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.5",
            "verseOrgIds": [
              "1SA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.2"
              },
              "items": [
                {
                  "text": "Tub 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keanyut ituŋa luka Isirael ebe aridakina kesi, (naarai eyalononoete ituŋa) apotu ituŋa koŋopata kabuai, kamonieik komorun, katesin ka apanya da. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.6",
            "verseOrgIds": [
              "1SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwanara ice koBuranian koYorodan akwap naka Gad ka Gilead; konye Saul, aroko ŋesi ajai Giligal, kotupasi ŋes ituŋa kere komaranete.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        }
      ]
    },
