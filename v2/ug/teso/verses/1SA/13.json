              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keniŋioros initia, ka ikileŋa, ka imelekes ka aepei; aitemokin da imacarin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
