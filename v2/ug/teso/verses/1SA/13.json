                "loc": "1SA.10.8"
              },
              "items": [
                {
                  "text": "1 Sam 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kidarak apaarasia akanykaarei, kwape ajaar apak naaseunit Samuel: konye mam Samuel abu kobu Giligal; kisiararos ituŋa kaneajai ŋesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.8",
