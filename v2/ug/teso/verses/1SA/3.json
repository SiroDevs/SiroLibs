              "1SA.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.85.8"
              },
              "items": [
                {
                  "text": "Sab 85:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.6"
              },
              "items": [
                {
                  "text": "Asw 9:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobu EJAKAIT, kobwo, kiworo kwape aatenak ace ebe, “Samuel, Samuel.” Kosodi Samuel atemar ebe, “Kiner; naarai epupi ekonibulesit.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.10",
            "verseOrgIds": [
              "1SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema EJAKAIT Samuel atiar, “Koany, abuni aswam akirot kolsirael, naisidelori aki kere nuka ninitunanan yeniirari. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.11",
            "verseOrgIds": [
              "1SA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.30"
              },
              "items": [
                {
                  "text": "1 Sam 2:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapaaran kaŋin etodolikini Eli kere nuabu kener nuka ekekike, ageun ka nasodit aitodol nakawasia, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.12",
            "verseOrgIds": [
              "1SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.12"
              },
              "items": [
                {
                  "text": "1 Sam 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai abu kalimok ŋes ebe atubokini ekekike ikar kere, kanuka numam adolit nuabu kojen, naarai einyanakinete odweke Edeke, komam ŋes itikokini kes. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.13",
            "verseOrgIds": [
              "1SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.30"
              },
              "items": [
                {
                  "text": "Mar 15:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.14"
              },
              "items": [
                {
                  "text": "Isa 22:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.16"
              },
              "items": [
                {
                  "text": "Yer 7:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.26+HEB.10.27+HEB.10.28+HEB.10.29+HEB.10.30+HEB.10.31"
              },
              "items": [
                {
                  "text": "Bur 10:26-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun eyapoikinit ekek loka Eli ebe, numam adolit nuka ekek loka Eli mam elucio kasubanit karaida kainakinet ikar kere.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koper Samuel aitiwalar akwap, konaana ikekia luka etogo loka EJAKAIT. Kokurianar Samuel alimokin Eli etapo, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kiworo Eli Samuel, kobala ebe, “Samuel, okokuka.” Kotema atiar, “Eoŋ lo,” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.17"
              },
              "items": [
                {
                  "text": "Rus 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.63"
              },
              "items": [
                {
                  "text": "Mat 26:63",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema atiar, “Anyoin akirot nakilimok jo EJAKAIT? Kenaiŋait, sirikiimunonik eoŋ: kiswamak jo Edeke kwaŋin ka adepar da, arai kimunon adiokirot kakiro kere nukilimok ŋesi jo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.17",
            "verseOrgIds": [
              "1SA.3.17"
            ]
          }
        },
