                "loc": "AMO.8.11"
              },
              "items": [
                {
                  "text": "Amo 8:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijaanakinenei ikoku Samuel EJAKAIT kakonyen nuka Eli. Ido kocicin akirot naka EJAKAIT kapaarasia kanun; amamei da ituŋanan yeneanyunit aitapoet.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        }
