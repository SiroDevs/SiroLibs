                  "text": "1 Ses 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kotema Kaman atiar, “Eebo, mam abu Esita akabaka kisunup ituŋanan alomar nepepe kekabaka opueit loepoit ŋesi nabarai eoŋ; moi da kanyararit eoŋ nepepe kekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.12",
            "verseOrgIds": [
              "EST.5.12"
            ]
          }
        },
