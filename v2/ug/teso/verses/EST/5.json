            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitatamik Kaman kes ailiil naka abarake, ka aipues da naka idweke, ka akiro kere da nuadakaki ŋes ekabaka, kwape kitopoloo ŋes aitelekarit ikapolok ka ikeiaanakinak luka ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.11",
            "verseOrgIds": [
              "EST.5.11"
            ]
          }
        },
        {
