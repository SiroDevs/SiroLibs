                  "text": "Yob 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye nun kere kamamikinit aiokis, eroko eoŋ aanyuni Morudekai Eyudayat iboie korute leka ekabaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.13",
