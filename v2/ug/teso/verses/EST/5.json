            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye do kotitinik Kaman, kolot ore; kijuka aomare ikepapero ka Seres akeberu, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
