              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Kaman alomar iyalama kaparit kaŋin, kolakara da kotauke: konye keanyu Kaman Morudekai korute loka ekabaka, komam ebwoi karaida anyoun kanuken, konyunyurik noi Morudekai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.9",
            "verseOrgIds": [
              "EST.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
