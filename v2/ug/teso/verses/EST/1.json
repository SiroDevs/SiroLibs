                "loc": "DAN.5.1"
              },
              "items": [
                {
                  "text": "Dan 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.21"
              },
              "items": [
                {
                  "text": "Mk 6:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kokaru lokiwuniet loka airumuke, abu kipoik epueit ikapolokoke kere ka ikekejaanakinak; kojaun apedor naka Perusia ka Media, kes ijaka ka ikapolok luka ibukui akonyeneke: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "abu kitodia abar naka akejakanut nakaibuses, ka aiturio naka apolouke naitelekarit, apaarasia nuipu, kes apaarasia akwatat ka akaisakanykauni, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi ketuboros apaarasia ŋun, abu ekabaka kipoik epucit ituŋa kere luajaas nen Susa togo lokapolou, lukapolok ka ludidik da, apaarasia akanykaarei, kotoma alaro naka emanikor loka etogo lokapolou loka ekabaka: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.7.8"
              },
              "items": [
                {
                  "text": "Est 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.8"
              },
              "items": [
                {
                  "text": "Amo 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ajaas aigalisio nuka egoe loekwaŋ, lopiria, lobululu koenitete kaunoi nuka ebaputa loejok, ka lomuge, kigiluna luka epuesa ka ipirin luka amor nukijesesinei: keraas itutio luka esabu ka epuesa, kamor nukijesesinei nuepesitai nukareŋak, nukakwaŋak, nudos, ka nukirionok da. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koinakis kes aimat koboro luka esa bu, (kogelegela iboro kaputokee,) kepol da noi ebino loka ekabaka, kwape ajaar aikor naka ekabaka, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aimat da kojai kwape ejaar ekisil; komamei yenepedor aitiŋaikinit: naarai abu ekabaka kicorakinite ikekapolokitok kere lukotogoke kwaŋin, kiswama ŋinituŋanan kwape ekotor. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Basiti da akabaka, kipoik aŋor epueit kotogo loka ekabakane loarai loka ekabaka Akasuero,",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
