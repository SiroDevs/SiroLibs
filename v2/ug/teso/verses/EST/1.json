                "loc": "MAT.16.3"
              },
              "items": [
                {
                  "text": "Mat 16:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi do ekabaka atemar lukacoa, luejenete apakio, (naarai kerai ŋol epone loka ekabaka mama ejaas kere luejenete ikisila ka etube: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.14"
              },
              "items": [
                {
                  "text": "Esr 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kidunyasi Karasena, ka Setar, ka Adamata, ka Tarusis, ka Meres, ka Marasena, ka Memukan, kaŋes, ikapolok ikanykaarei luka Perusia ka Media, luaanyununete akonyen nuka ekabaka, luaraas lusodit kotoma ajakanut:) ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotema atiar, “Kekwaikis ai akabaka Basiti kwape ajaar ekisil, naarai mam erimarit ŋin naabu ekabaka Akasuero kicorak kobwaein?” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok Memukan kakonyen nuka ekabaka ka ikapolok ebe, “Mam akabaka Basiti ediakarit mama ejai ekabaka bon, konye mama ejaas ikapolok kere, ka ituŋa da kere luejaas obulmi kere luka ekabaka Akasuero, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai epupunete do aŋor kere aswamisioit na naka akabaka, emwaŋenenete ikeeekiliok kakonyenekee naelimitere ebe, ‘Abu ekabaka Akasuero kicorak Basiti akabaka ayaunio kakonyeneke, konye mam ebuno.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaaran na da akapolok nuka Perusia ka Media nueiras nuka aswamisioit naka akabaka elimokinete kwaŋin ikapolok kere luka ekabaka, Aso ejaun do emwaŋit loepol ka anyunyura da. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai kitojok ekabaka, kieorakinai do aicorakinet naka ekabaka, kiwadikai da kokisila luka Iperusian ka Imedian, kinyek ailocio, ebe, ‘Sirikebu bobo Basiti kakonyen nuka ekabaka Akasuero’; koinak ekabaka apolouke naka akabaka ace naitelekarit ŋes ajokis. ",
          "type": "text",
          "attrs": {
