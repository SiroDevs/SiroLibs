                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.2"
              },
              "items": [
                {
                  "text": "Dan 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kapaarasia kaŋun, nakiboikinor ekabaka Akasuero oicoloŋ loka ajakanutuke, loajai Susa togo lokapolou, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
