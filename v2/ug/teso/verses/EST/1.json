          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapaaran nakikanyetekaarei, naalakaror etau loka ekabaka kanu ebino, kicorak ŋesi Mekumam, Bisita, Karabona, Bigita, ka Abagata, Setar, ka Karakas, ibwaein ikanykaarei luejaanakinete kakonyen nuka Akasuero ekabaka, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.9"
              },
              "items": [
                {
                  "text": "Awa 16:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ayaun Basiti akabaka kakonyen nuka ekabaka konapite aboko naka ajakanut aitodikin ituŋa ka ikapolok ajokisike: naarai kerai naatemel. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyc koŋer akabaka Basiti abunore kaicorakinet naka ekabaka kobwaein: ŋes anyunyurikinor noi ekabaka, koresiar da akenyunyura kotomake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        }
      ]
    },
