          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "aitogogoŋ apaarasia ŋun nuka Purim kapakiokee nueseunitai, kwape kicorakinia Morudekai Eyudayat ka Esita akabaka, ido kwape kicorakiniata kesi kanukec ka aurikec da, kakiro nuka ailunukec ka aimony. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
