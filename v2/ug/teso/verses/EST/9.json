              },
              "items": [
                {
                  "text": "Any 23:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotukonokinos Iyudayan oreriakec anatar ibukui kere luka ekabaka Akasuero, aikam nul luemootos aitican kes: amamei da ituŋanan yenepedor airebokin kes: naarai kodoikinite atekerin kere akurian kes. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.7"
              },
              "items": [
                {
                  "text": "Awa 16:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apotu ikapolok kere lukibukui, ka lukibukui, ka ikayaitok, ka ŋul da lukiswamaenenete aswam naka ekabaka kinarakis Iyudayan; naarai kodoikinite kes akurian Morudekai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
