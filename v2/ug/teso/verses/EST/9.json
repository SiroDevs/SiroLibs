              "items": [
                {
                  "text": "1 Ses 5:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotukonokinos Iyudayan ice luajaas obukui, kobwoikis aijarakee, koiaut kaibworar kama kalukasurupokec, koarata ilukumin akaisakanykaarei ka lukany kanul kalukelaito kes; konye mam kes apotu kibwaikis akanikec onasit, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.16",
            "verseOrgIds": [
              "EST.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi nun kiswamai kapaaran nakitomonet kauni naka elap Adar; kapaaranike nakitomonet kaonon kibworasi kesi, kituluosi apaaran naka ipucino ka aiyalama. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye apotu Iyudayan luajaas Susa kotukonokinos kapaaran nakitomonet kauni ka apaaran nakitomonet kaonon da; kapaaran nakitomonet kakany kibworasi, kituluosi apaaran naka ipucino ka aiyalama. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.18",
            "verseOrgIds": [
              "EST.9.18"
            ]
          }
