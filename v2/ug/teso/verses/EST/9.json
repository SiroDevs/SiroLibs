              },
              "items": [
                {
                  "text": "Isa 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kerai Morudekai ekapolon kotogo loka ekabaka, kisiarakina eemutuke anatar ibukui kere: naarai kiyatanakin etuŋanan ŋol Morudekai apoloor noi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.4",
            "verseOrgIds": [
              "EST.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodanyata Iyudayan lukasurupokee kere iposete kes kekilen, ka aiar, ka amudiar, kiswamakis nul lukelaito kes kwape akototor. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "KoSusa togo lokapolou apotu Iyudayan koarata komudiasi ituŋa akwat akany, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.6",
            "verseOrgIds": [
              "EST.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Parasanadata, ka Dalapon, ka Asapata, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.7",
            "verseOrgIds": [
              "EST.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Porata, ka Adalia, ka Aridata, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.8",
            "verseOrgIds": [
              "EST.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Paramasata, ka Arisai, ka Aridai, ka Baisata. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.9",
            "verseOrgIds": [
              "EST.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
