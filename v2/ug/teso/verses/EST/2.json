                "loc": "1KI.1.2"
              },
              "items": [
                {
                  "text": "1 Ika 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete ikejaanakinak luka ekabaka luijaanakinete ŋes atemari ŋes atiar, “Mere komoikinai ekabaka abekon nukatumunak nuitemelelas: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "koseu ekabaka ijaka kobukui kere luka ajakanutuke, kotukonokis abekon kere nukatumunak nuitcmelelas Susa togo lokapolou, togo loka aŋor, toma akan naka Kegai ebwacit loka ekabaka, ekedaran aŋor; kijaikinai iborokee luka aitesegaario: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "apese da naitojokit ekabaka koraun akabaka aibois naka Basiti.” Kitalaka akirot nin ekabaka; kiswama kwaŋin.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        }
      ]
    },
    {
