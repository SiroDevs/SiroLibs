              "type": "text"
            }
          ]
        },
        {
          "text": " Naatukokinotor abekon irwan nakiareit, abu Morudekai kiboikin orute loka ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.19",
