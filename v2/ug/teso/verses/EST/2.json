            "number": "5",
            "style": "v",
            "sid": "EST 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojai Eyudayat toma Susa togo lokapolou, ekekiror Morudekai, okoku loka Yair, okoku loka Simei, okoku loka Kis, Ebenyamenit: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.5",
            "verseOrgIds": [
              "EST.2.5"
            ]
          }
        },
        {
