          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.14"
              },
              "items": [
                {
                  "text": "2 Ika 24:14",
                  "type": "text"
                }
