              "items": [
                {
                  "text": "Yer 22:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " lokeyanaario ko Yerusalem nepepe ka lueioreunitai ka Yekonia ekabaka loka Yuda, loabu Nebukadanesar ekabaka loko Babulon koyana. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.6",
            "verseOrgIds": [
              "EST.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitanu ŋesi Kadasa, ŋes Esita, akoku naka papake lodidi: naarai amamei nin papa karaida toto, etemelel apese ajok asesen noi; ketwana papake ka totoke, koyana Morudekai ŋes araun akokuke, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.7",
            "verseOrgIds": [
              "EST.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, kepupun aicorakinet naka ekabaka, ka ekekisil, kotukokinitete apesur nuipu Susa togo lokapolou, akan naka Kegai, koyanaarai Esita togo loka ekabaka, kotoma akan naka Kegai, ekedaran loka aŋor. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.8",
            "verseOrgIds": [
              "EST.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisiyalamik ŋes apese, kodum asianut kamaken; kisunya ŋesi ainakin ŋin iboroke luka aitesegaario, ka akorakinetake, ka apesur akanykaarei nuibusakinit ainakinio kotogo loka ekabaka: abu kiloeo ŋes ka apesuruke kitolomik kes aibois naitelekarit ajokis kotogo loka aŋor, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.9",
            "verseOrgIds": [
              "EST.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.8"
              },
              "items": [
                {
                  "text": "Est 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.36"
              },
              "items": [
                {
                  "text": "Leb 26:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.65"
              },
              "items": [
                {
                  "text": "Ikis 28:65",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam abu Esita kitejenu atekerike ka ikeinacan: naarai abu Morudekai kieorite ŋes ebe sirikitejenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.10",
            "verseOrgIds": [
              "EST.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitorenenei Morudekai nolikolonit kinaren kalaro naka etogo loka aŋor, ajenun kwape ejaar Esita, ka nuedoikinete ŋes.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.11",
            "verseOrgIds": [
              "EST.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
