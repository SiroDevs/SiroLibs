              "type": "text"
            }
          ]
        },
        {
          "text": " Akaulo kanun, nakiyamakinor anyunyura naka ekabaka Akasuero, kiitu Basiti, ka nueswama ŋesi, ka naaponi kisilakinai mamakeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.1",
            "verseOrgIds": [
              "EST.2.1"
            ]
          }
        },
        {
