            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aponi Esita koyanaarai mama ejai ekabaka Akasuero toma togoke loka akabakane olap lokitomonet, ŋes elap Tebet, okaru lokikanyetekaarei loka airumuke. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.16",
            "verseOrgIds": [
