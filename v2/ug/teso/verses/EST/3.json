              "items": [
                {
                  "text": "Yob 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.12.16"
              },
              "items": [
                {
                  "text": "Awa 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.3.19"
              },
              "items": [
                {
                  "text": "Dan 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keanyu Kaman ebe mam Morudekai ekukumit karaida mam abu kisudedikin ŋes, konyunyurikin Kaman noi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.4"
              },
              "items": [
                {
                  "text": "Sab 83:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye komwan aikamun Morudekai bon; naarai aponi kitejenikinitete ŋes ateker naka Morudekai: kanuka nun komoote Kaman amudiar Iyudayan kere luajaas anatar ajakanut kere naka Akasuero, ŋes ateker naka Morudekai.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        }
      ]
    },
    {
