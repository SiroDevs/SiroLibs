                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolap losodit, ŋes elap Nisan, kokaru lokitomonet kaarei loka ekabaka Akasuero, kilamilamata Pur, kes iroeta, kakonyen nuka Kaman ŋinipaaran, ka ŋolilap, kiton olap lokitomonet kaarei, ŋes elap Adar. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.4.13"
              },
              "items": [
                {
                  "text": "Esr 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.20"
              },
              "items": [
                {
                  "text": "Asw 16:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Kaman ekabaka Akasuero atiar, “Ejaas ituŋa luisiarakina aikaara toma atekerin kobukui kere luka ajakanutukon; kogelara ikisilakec kanul luka ateker ace; mam kes ericete ikisila luka ekabaka: kanuka ŋun mam ajokis ekabaka aeamakinit kes. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.8",
            "verseOrgIds": [
              "EST.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai kitojok ekabaka, kiwadikai komudiarai: atacakini eoŋ atalatan alukumin atomon nuka epuesa akanin nuka ŋul kaluidarete akiro nuka ekabaka, ayaun toma aiŋadisia nuka ekabaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.42"
              },
              "items": [
                {
