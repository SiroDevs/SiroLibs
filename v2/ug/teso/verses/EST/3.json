              "type": "text"
            }
          ]
        },
        {
          "text": " Akaulo kanun kodakak eka baka Akasuero Kaman okoku loka Kamedata Egagait, kitopolo ŋes, kitodok ekeicoloŋ kuiu aitelekar ikapolok kere luajaas kaŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
          }
        },
        {
