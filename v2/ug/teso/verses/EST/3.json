                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijukarai ibaluan kikakerak obukui kere luka ekabaka, amudiar, aiar, ka aidany Iyudayan kere, ludidik ka imoionai, idwe ludidik ka aŋor, kapaaran adiopet, ŋes apaaran nakitomonet kauni naka elap lokitomonet kaarei, ŋes elap Adar, ayaŋaar da lunatunakec araun imejan. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.13",
            "verseOrgIds": [
              "EST.3.13"
            ]
          }
        },
