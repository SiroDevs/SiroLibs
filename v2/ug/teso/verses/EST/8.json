              },
              "items": [
                {
                  "text": "Est 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapaaran kaŋin abu ekabaka Akasuero koinak Esita akabaka etogo loka Kaman lokasurup loka Iyudayan. Kobu Morudekai kakonyen nuka eka baka, naarai abu Esita akabaka kolimok kwape ejaar kamake. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.1",
            "verseOrgIds": [
              "EST.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.42"
              },
              "items": [
                {
                  "text": "Age 41:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.10"
              },
              "items": [
                {
                  "text": "Est 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.29"
              },
              "items": [
                {
                  "text": "Dan 5:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.22"
              },
              "items": [
                {
                  "text": "Luk 15:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolaeu eka baka egilutuke loalemun kama ka Kaman, koinak Morudekai. Kibwaik Esita Morudekai ayait etogo loka Kaman,",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.2",
            "verseOrgIds": [
              "EST.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.2",
            "verseOrgIds": [
              "EST.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinera bobo Esita kakonyen nuka ekabaka, kibirokin akejeneke, kinaina ŋes emonyi akiyo alemar aronis naka Kaman Egagait, aibil da eboteteke mama ejaas Iyudayan. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.3",
            "verseOrgIds": [
              "EST.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.4.11"
              },
              "items": [
                {
                  "text": "Est 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ekabaka arior esas loka esabu mama ejai Esita, Konyou do Esita, kobwo kakonyen nuka ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.4",
            "verseOrgIds": [
              "EST.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema atiar, “Arai kitojok ekabaka, arai da kadum asianut kakonyeneke, arai kesub akirot bala edolit kakonyen nuka ekabaka, eoŋ da esiyalamik akonyeneke, kiwadikai ailoc ibaluan luenerunitor Kaman okoku loka Kamedata Egagait, luewadika amudiar Iyudayari luejaas obukui kere luka ekabaka: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.5",
            "verseOrgIds": [
              "EST.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.2.3"
              },
              "items": [
                {
                  "text": "Nek 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.137.6"
              },
              "items": [
                {
                  "text": "Sab 137:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai ekoni apedor ai atitiŋikin asesen aronis naebunokini ituŋaka? Ekoni apedor ai da atitiŋikin asesen amudiar naka lukatekerika?” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.6",
            "verseOrgIds": [
              "EST.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.13.22"
              },
              "items": [
                {
                  "text": "Awa 13:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ekabaka Akasuero atemar Esita akabaka ka Morudekai Eyudayat atiar, “Koany, ainak Esita etogo loka Kaman, aponi kikajakinai ŋes akito, naarai abu kibwaik akanike oYudayan. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.7",
            "verseOrgIds": [
              "EST.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.6.8"
              },
              "items": [
                {
                  "text": "Dan 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.19"
              },
              "items": [
                {
                  "text": "2 Tim 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiwadikakis yesi lyudayan, kwa pe itojokitotor yesi, kokiror loka ekabaka, kipueakis da aanyunet kegilut loka ekabaka: naarai aiwadikaet naiwadikatai okiror loka ekabaka, ido naipucakinitai aanyunet kegilut loka ekabaka, emamei ituŋanan yenepedori ailocokin,",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.8",
            "verseOrgIds": [
              "EST.8.8"
            ]
          }
        }
      ]
    },
    {
