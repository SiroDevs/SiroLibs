        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye abu kaomite cut iboro kere araut atwaniar kanuka ajokis naepol noi naka ajenun Kristo Yesu Ejakaitika, Abu katwania iboro kere kanukeŋ, kaomite da araut acin, tetere adumuni Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.8",
            "verseOrgIds": [
              "PHP.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
