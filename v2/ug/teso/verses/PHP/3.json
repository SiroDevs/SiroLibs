                "loc": "1CO.2.6"
              },
              "items": [
                {
                  "text": "1 Kor 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso oni kere lukipoloor, kaomitos ŋun; ido arai iwomitos yesi nuegelara, kipukokini da Edeke yes ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.15",
            "verseOrgIds": [
