            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kocoito iŋokwo, kocoito ikeswamak nueroko, kocoito luegeras. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.2",
            "verseOrgIds": [
