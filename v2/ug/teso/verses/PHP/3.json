            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Karaida kapedori eoŋ amunokina akuan. Arai eomit etuŋanan ece kere amunokina akuan eoŋ etelekarit: ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.4",
            "verseOrgIds": [
              "PHP.3.4"
            ]
          }
        },
