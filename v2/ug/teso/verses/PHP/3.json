              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kasodi adumunio kotomakeŋ, komamei adoliteka, naebuni kotoma okisila, dimarai ŋin naebuni kanuka aiyuun Kristo, adolit naebuni kama ejai Edeke kotoma aiyuun, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.9",
            "verseOrgIds": [
              "PHP.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
