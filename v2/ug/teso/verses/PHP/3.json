          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iinacan, mam aomit ebe adau aikamun, konye eswamai adiopekirot, kemurwokinete nukokau, kewopei nuejaas kiŋaren, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.13",
            "verseOrgIds": [
              "PHP.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.24"
              },
              "items": [
                {
                  "text": "1 Kor 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ebwapit adolore neepegare, neejai ainakinet naka anyarit nakokuju naka Edeke toma Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.14",
            "verseOrgIds": [
              "PHP.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 3:15"
          },
          "items": [
