                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " tetere ajenuni ŋes, ka apedor naka ajarunike, ka aimor kaŋes arieboke, ketuputoritere katwanareke, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.10",
