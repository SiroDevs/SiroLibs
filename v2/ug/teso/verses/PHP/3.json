            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " aponi kakepi kapaaran nakikanyetekauni, loka ajena naka Isirael, loka ateker naka Benyamin, Eburaniat obe loka Iburanian; kakiro nuka ikisila, Eparisayot, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.5",
            "verseOrgIds": [
              "PHP.3.5"
            ]
