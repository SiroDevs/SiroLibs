              },
              "items": [
                {
                  "text": "Rom 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kirai oni luka akepio nakabeit, lukimai kOmoyo loka Edeke, lukiwolobobot kotoma Kristo Yesu, ido lumam kimunokina akuan. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.3",
            "verseOrgIds": [
              "PHP.3.3"
            ]
          }
        },
        {
