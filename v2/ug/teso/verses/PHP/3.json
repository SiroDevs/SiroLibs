                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mere ebe adau adumun karaida aitodolikinio; konye ebwapit tetere ekamuni, naarai kekamunit Kristo Yesu eoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.12",
            "verseOrgIds": [
              "PHP.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
