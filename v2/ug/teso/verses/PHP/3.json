                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kere nukeraas ameda kamakaŋ, abu kaomit atwaniar kanuka Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.7",
            "verseOrgIds": [
              "PHP.3.7"
            ]
          }
