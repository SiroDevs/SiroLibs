                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kakiro nuka adunyanut, kareite ekanisa, kakiro nuka adolit naejai toma okisila, mam abu kajai kaitoronet. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.6",
            "verseOrgIds": [
              "PHP.3.6"
            ]
