          ]
        },
        {
          "text": " Kinyek ŋinituŋanan asesen nuke bon, konye nuka luce da. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.4",
            "verseOrgIds": [
              "PHP.2.4"
