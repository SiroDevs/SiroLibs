              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye Edeke lokasianut kere, lokinyarakinit yes aibusesuke naka ikar kere toma Kristo, kidaut aisiriebio apak naedit, kitetemikini yes, kiticat, ka aitogogoŋ da. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.10",
            "verseOrgIds": [
              "1PE.5.10"
            ]
          }
        },
        {
