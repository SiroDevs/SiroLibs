        {
          "text": " Kitepegata ŋes, kicasito kaiyuun, kojenete ebe itodolitoi aisiriebio ŋipeŋin koinacanakus luejaas akwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.9",
            "verseOrgIds": [
