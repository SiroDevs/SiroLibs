              "type": "text"
            }
          ]
        },
        {
          "text": "konye korai etuŋanane loibwaa lokotau, anapito namam edaun naka emoyo loiyapepera ka aiyapaara, loerai loketiai loepol kakonyen nuka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
