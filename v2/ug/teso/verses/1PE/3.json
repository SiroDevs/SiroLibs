          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kwape kwaŋin kolo sek kisirenenoto aŋor nukalaunak nuamunosi Edeke, kononokikinito da ikiliokokec. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
