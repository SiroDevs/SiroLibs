            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye inyakunete kesi akirot mama ejai ŋol loitemonokino atubokin lukajarak ka lukatwak da. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.5",
            "verseOrgIds": [
              "1PE.4.5"
            ]
