                "loc": "1JN.2.16"
              },
              "items": [
                {
                  "text": "1 Yok 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " tetere idaunete apaarasiakus nuideuna iriŋa ijaas toma akuan, mere bobo kanuka aiŋobel naka ituŋa, konye kanuka ŋun nuekot Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
            "verseOrgIds": [
              "1PE.4.2"
            ]
          }
        },
        {
          "name": "verse",
