              "items": [
                {
                  "text": "1 Kor 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ŋin ŋes elimonokinere lukatwak da Akiro Nukajokak, tetere kes da etubokinio kwape ituŋa luejaas awat, konye kojarata kotoma omoyo kwape ka Edeke,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
