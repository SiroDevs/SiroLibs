                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " arai ejai yeninera, kwape yeninera akiro nuka Edeke; arai ejai yenijaanakini, kwape kanuka agogoŋ naekori Edeke; tetere itopolooritai Edeke kotoma kere kanuka Yesu Kristo. Aibuses ka ayait kojaas mamakeŋ ikar ka ikar. Amen,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
