              "type": "text"
            }
          ]
        },
        {
          "text": " Eapie awasia naka iboro kere; aso koomito kacoit, kinyeis da amer, tetere ilipenenete. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.7",
