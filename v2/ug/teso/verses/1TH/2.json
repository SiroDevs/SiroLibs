                  "text": "Asw 20:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwape ijeniata yesi ebe, kwape icoria papa ikedwe, kipou kecorata ŋinidiopet kayesi, kesinyikokito, ka aitejenun da, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.11",
            "verseOrgIds": [
              "1TH.2.11"
