            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai, iinacan, iitunito yesi akosiitaaritoi ka ailolony; nakiswamaenena akuare ka apaaran da, kenyeis alaŋirikin ituŋanan kere kayesi, kalimonokinete yes Akiro Nukajokak nuka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.9",
            "verseOrgIds": [
              "1TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iraas yesi ikajenak, ka Edeke da, kwape kijaar kamakus luiyuunito kalaunit, ka adolit, komamei aitoronet; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.10",
            "verseOrgIds": [
              "1TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 2:11"
          },
          "items": [
