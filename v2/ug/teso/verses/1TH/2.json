              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ijenete yesi iinacan, ebe akosilomun mamakus mam kerai atai; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.1",
            "verseOrgIds": [
              "1TH.2.1"
            ]
