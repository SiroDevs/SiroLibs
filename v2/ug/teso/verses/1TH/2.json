              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mam kipou kamootos aibuses kama kituŋa, karaida kamakus, karaida kama kice, nakipedoria alaŋirikinit yes, kwape ikiyakia luka Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.6",
            "verseOrgIds": [
              "1TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kipou keyapeperas kokidiŋikus, kwape akasaan naitani ikedwe alopet. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.7",
            "verseOrgIds": [
              "1TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaŋin kipodori yes, ketojokata akorakin yes mere Akiro Nukajokak nuka Edeke bon, konye akosiijar da, naarai iraas iminanakosi noi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.8",
            "verseOrgIds": [
              "1TH.2.8"
            ]
          }
        }
      ]
