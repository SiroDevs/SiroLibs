        },
        {
          "text": " Ido ipotu koputosi sio ka Ejakait, naarai ijaut akirot kotoma aiticanio naepol, kaiyalama naka Emoyo Lokalaunan; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.6",
            "verseOrgIds": [
