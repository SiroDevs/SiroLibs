              "type": "text"
            }
          ]
        },
        {
          "text": " kosodete araun aanyunet mama ejaas luiyuunito kere kotoma Makedonia ka Akaia da, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.7",
