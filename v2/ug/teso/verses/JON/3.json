                "loc": "DEU.18.22"
              },
              "items": [
                {
                  "text": "Ikis 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.41"
              },
              "items": [
                {
                  "text": "Mat 12:41",
