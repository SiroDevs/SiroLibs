        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koany Edeke aswamisiokec, kwape ebelokinotor ainyein ekecerot loerono; kiitu Edeke kinyek aronis naabala iswamakini kes; mam abu kiswama.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.10",
