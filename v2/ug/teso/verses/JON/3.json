            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodolokis akiro ekabaka loka Ninebe, konyou koicoloŋoke loka ajakanut, kolae ekegoe, konap epuko, kiboikin okurwon. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.6",
            "verseOrgIds": [
