            }
          ]
        },
        {
          "text": "Kirucak akirot naka EJAKAIT abunore mama ejai Yona ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.1",
            "verseOrgIds": [
              "JON.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Konyou, kolot Ninebe, ore ŋol loepol, kolimok ŋes akirot nakecorakin jo.”",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.2",
            "verseOrgIds": [
              "JON.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
