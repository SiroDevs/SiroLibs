                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.32"
              },
              "items": [
                {
                  "text": "Luk 11:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kogeu Yona alomar ore alosit naka adiopepaaran. Kiworo, kotema atiar, “Esalito apaarasia akaisaoŋon, kosodi konyet Ninebe atiyanakinio!” ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.4",
            "verseOrgIds": [
              "JON.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
