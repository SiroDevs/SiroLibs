              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.3"
              },
              "items": [
                {
                  "text": "2 Siit 20:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.15"
