              "items": [
                {
                  "text": "Luk 11:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiyuut ituŋa luka Ninebe Edeke; kolimosi ailuŋ, konapitos ipukoi, ageun ka lukapolok kiton ludidik kakesi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.5",
            "verseOrgIds": [
              "JON.3.5"
            ]
          }
        }
