              "items": [
                {
                  "text": "Yok 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kolimo kitejen Ninebe kere ebe, “Kokisil loka ekabaka ka ikapolokoke; Sirikiir ituŋanan karaida itian, esipan loka aituk, karaida loka amerekekin, idiobore: sirikenyama, karaida aimat akipi; ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        },
