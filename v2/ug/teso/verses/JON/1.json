              "type": "text"
            }
          ]
        },
        {
          "text": " “Konyou, kolot Ninebe, ore ŋol loepol, kiworo aikwenyar ŋes; naarai adolu aronisikec mamakaŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.2",
            "verseOrgIds": [
              "JON.1.2"
            ]
          }
        },
