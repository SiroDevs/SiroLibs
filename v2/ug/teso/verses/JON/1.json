                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye konyou Yona akerear Tarusis anyoun kakonyen nuka EJAKAIT. Kolot Yopa, kodum ameeri naalosi Tarusis: kotae etiai loka erotoke, kikwaŋar, alosit kakes Tarusis, anyoun kakonyen nuka EJAKAIT.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
