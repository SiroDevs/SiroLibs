                  "text": "1 Kor 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " aitodol naebunio Emoion loŋorot, kotubokinai akiro mama ejaas lukalaunak luka ŋol loejai kuju kakuj; kodol apak naerumiata lukalaunak ajakanut.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
