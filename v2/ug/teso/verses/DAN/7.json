            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kasesen, ido kojiikinos amumwarat ŋin kalukalaunak, kipiko kes; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.21",
            "verseOrgIds": [
              "DAN.7.21"
            ]
          }
