                "loc": "REV.20.4"
              },
              "items": [
                {
                  "text": "Apu 20:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.5"
              },
              "items": [
                {
                  "text": "22:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido ajakanut ka ayaetait, ka apolou da naka ajakanuto nuejaas kwap kakuj kere, einakinio ituŋa luka lukalaunak luka ŋol loejai kuiu kakuj: akejakanut ŋes ajakanut namam enaŋi, ijaanakinete ŋes ayaeta kere, erimarete da.’",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.27",
            "verseOrgIds": [
              "DAN.7.27"
            ]
          }
        }
