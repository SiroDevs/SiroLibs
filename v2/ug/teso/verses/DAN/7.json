          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ido eoŋ, Daniel, kokadak emoyoka kotoma akuanaka, kesiyalononoto aitapoeta nuka akouka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.15",
            "verseOrgIds": [
              "DAN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kekunyak ediopet kanul luabwoete kanen kenit ŋes abeit naka ŋun kere. Aso kalimok ŋesi eoŋ ketejen apolou naka akiro, ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.16",
            "verseOrgIds": [
              "DAN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Itiaŋ ŋul lukos, luimwaasi iwonon, kes ikabakan iwonon luelomunete kakwap. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.17",
            "verseOrgIds": [
              "DAN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.12"
              },
              "items": [
                {
                  "text": "Isa 60:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.5"
              },
              "items": [
                {
                  "text": "Apu 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye einakinio lukalaunak luka ŋol loejai kuju kakuj ajakanut, ido irumete ajakanut ikar kere, kes ikar ka ikar.’",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        }
      ]
