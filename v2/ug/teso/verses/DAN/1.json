        },
        {
          "text": " Abu EJAKAIT kijaik Yekoiakim ekabaka loka Yuda akanike, kice koboro luka etogo loka Edeke; koyaŋa kes akwap naka Sinar togo loka ekedeke: kibwaik iboro aiŋadis togo loka ekedeke. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ekabaka kolimok Asupenas ekapolokiton ibwacinake aitolomikin ice kodwe luka Isirael, luka aur naka ekabaka ka naka ikapolok da; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
