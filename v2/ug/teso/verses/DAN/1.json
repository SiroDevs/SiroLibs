            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kopeleik Daniel kotauke kinyek amunaun kinyamat luka ekabaka, karaida kebino loemasenenei: kanuka ŋun kilip ekapolon loka ibwaein kinyek ŋesi amunaun. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.8",
            "verseOrgIds": [
              "DAN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
