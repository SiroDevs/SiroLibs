                  "text": "Age 39:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.50"
              },
              "items": [
                {
                  "text": "1 Ika 8:50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu Edeke koinak Daniel aminunio ka aitimio kakonyen nuka ekapolon loka ibwaein, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.9",
            "verseOrgIds": [
              "DAN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema ekapolon loka ibwacin Daniel atiar, “Ayoŋit eoŋ ejakaitika ekabaka, loabu kicorak luinyamenenete ka luimasenenete: kinyek aanyun akusikonyen mam ejokuka kwape nuka ikatumunak luka aturikus; kwaŋin iyaunete aronis akouka kama ejai ekabaka,” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Daniel atemar eketeon, loabu ekapolon loka ibwacin koinak ayait Daniel, ka Kanania, ka Misael, ka Asaria ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.11",
            "verseOrgIds": [
              "DAN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Keŋaiŋait, kitem ber ikonibulesin apaarasia atomon; koinanakinete sio idiasio ainyam, ka akipi da aimat, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.12",
            "verseOrgIds": [
              "DAN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete konyet airer akonyenekosi kakonyenekon, ka akonyen da nuka ikatumunak luenyamenenete inyamat luka ekabaka; ido kwape ianyunia ijo, kikwaik nen ikonibulesin,” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopup ŋesi kes kakirot kaŋin, kitem kes apaarasia atomon. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.14",
            "verseOrgIds": [
              "DAN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi ketuboros apaarasia atomon, kotakanut akonyenekee ejok, ido kibukeikinito awatekee, aitelekarit ikatumunak kere luanyamenenete inyamat luka ekabaka, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.15",
            "verseOrgIds": [
              "DAN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi do eketeon alemar inyamatakee, ka ebino lotikemasenenete, koinanak kes idiasio.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        }
      ]
    },
