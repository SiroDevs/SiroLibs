            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kokaru losodit loka airumiteke abu eoŋ Daniel kajenu kanuka iitabon etiai loka ikar luibusakinit atubor aitodolikin aimejeikin naka Yerusalem kwape ejaar akirot naka EJAKAIT mama ejai enabi Yeremia, kes ikar akaisakanykaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kagipa mama ejai EJAKAIT Edeke, amoot ailip, ka aiŋaiŋa, kekanyi eteŋei, kanapite epuko ka ekurwon. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.3",
            "verseOrgIds": [
              "DAN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelip EJAKAIT Ekadeke, kalimo, kenera ebe, “Wu EJAKAIT Edeke lopeti, loketasuro, loitodoli aitutuket ka aitim mama kanul lueminas ŋes korieito da akeicorakineta; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
