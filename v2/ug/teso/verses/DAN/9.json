                "loc": "1KI.8.47"
              },
              "items": [
                {
                  "text": "1 Ika 8:47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.9.6"
