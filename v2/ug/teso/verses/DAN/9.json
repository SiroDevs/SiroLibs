                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eebo, eriŋa enera kailip, aponi kitoporounoi katipet etuŋanan Gaburiel, loabu kaany kaitapoet kageunet, kikuny kapak naka ainakinet naka atiboŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.21",
            "verseOrgIds": [
              "DAN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketejenik, kiner keoŋ, kotema atiar, “Ŋo Daniel, alom eoŋ kwana aitedesiar jo toma aijen, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.22",
            "verseOrgIds": [
              "DAN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ageunet naka aiŋaiŋakon kolom aicorakinet, abunit eoŋ da alimokin jo: naarai kiminai noi: asa koomoom akirot, kojen aitapoet.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        }
