          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi napenerar, elipi, alimori da akaronis ka aronis naka ikatuŋa Isirael, ayait da aiŋaiŋaka akonyen nuka EJAKAIT, Ekadeke kanuka eronat lokalaunan loka Ekadeke; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.20",
            "verseOrgIds": [
              "DAN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
