          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kesineri jo ikar kere; eebo, kesineri jo kadolit, kotube, kasianut-nakamin, ka aitimio da. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.19",
            "verseOrgIds": [
              "HOS.2.19"
            ]
