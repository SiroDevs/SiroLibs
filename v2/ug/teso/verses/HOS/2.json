            }
          ]
        },
        {
          "text": "Ebala EJAKAIT ebe, “Kosodi kapaaran kaŋin, kimaikini eoŋ,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
              "HOS.2.16"
            ]
          }
        }
