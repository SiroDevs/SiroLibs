          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kedau aitajakaar Lo-rukama, kopotuu, kouru isapat. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.8",
            "verseOrgIds": [
              "HOS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema EJAKAIT atiar, “Komaik ekekiror Lo-ami; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:9",
              "type": "text"
            },
            {
              "text": "Lo-ami apolouke Mere ikatuŋa",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai mam eraas ikatuŋa, eoŋ da mam araun Ekusideke.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        }
      ]
    },
