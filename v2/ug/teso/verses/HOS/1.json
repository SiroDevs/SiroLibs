              },
              "items": [
                {
                  "text": "Sab 73:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakegeunia EJAKAIT einer ka Kosea, kobala EJAKAIT Kosea ebe, “Kolot, komany aberu nakadoteu, ka idwe luka adoteu: naarai adotear noi akwap, anyoun kama ejai EJAKAIT.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso abu ŋesi kolot komany Gomer akoku naka Dibilaim; kopotuu ŋesi, kourik ŋes isapat.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
