                  "text": "Rom 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye do eraun etiai loka idwe luka Isirael kwape asiŋe naka aŋolol namam epedori aitemio karaida aimario; kosodi kanen, kaibois naaponi kotemarere kes ebe, “Mam iraas ikatuŋa,” etemario do kes ebe, “Yes odwe luka Edeke lokajaran.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etukonokinos idwe luka Yuda ka idwe luka Isirael, eseunete lokapolon ediopet, enyounete kakwap: naarai epol apaaran naka Yesereel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
