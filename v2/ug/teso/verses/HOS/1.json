              },
              "items": [
                {
                  "text": "2 Pet 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akirot naka EJAKAIT naabu kobu mama ejai Kosea okoku loka Beeri, kapaarasia nuka Usia, ka Yotam, ka Akas, ka Kesekia da, ikabakan luka Yuda, kapaarasia da nuka Yeroboam okoku loka Yoas, ekabaka loka Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        }
      ]
