          ]
        },
        {
          "text": " koyuu da Lot ekadoliton loeyaloŋoŋoi noi kanuka iponesio luka abenyanut naka ikaronok, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.7",
            "verseOrgIds": [
