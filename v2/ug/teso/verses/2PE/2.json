            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naabu kituluoria ireria luka Sodom ka Gomora ekurwon, kotubok akiro kibiro, kibwaik naanyunet mama ejaas ŋul luepote amamus ayoŋit Edeke; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.6",
            "verseOrgIds": [
              "2PE.2.6"
            ]
          }
