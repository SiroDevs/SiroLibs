            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Etuparete da luipu abenyanutukec, ido emoromoroo kanukec erot loka abeit, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.2",
            "verseOrgIds": [
              "2PE.2.2"
            ]
