              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.12"
              },
              "items": [
                {
                  "text": "Yud 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ikonakinio kes erono ŋes eropit loka aronis. Eomito nukaiyalama abolia paaran. Eraas akemerin ka amasikineta, eboliaete kopucinokec luka aminanar, emorete kayes. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.13",
            "verseOrgIds": [
              "2PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejaas kakonye nuileleba adoteu, mam inyeinete adiakar. Ijodijodoete imoyon lumam icasito. Ejaas itauon luituutoro airaŋaanut. Idwe luikenen! ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.14",
            "verseOrgIds": [
              "2PE.2.14"
            ]
          }
        },
