                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (naarai ekadoliton ŋol loeboie kotomakec, naaanyunia ka aiirar da, aponi kiticanai ekemoyo loedolit, ŋinipaaran kanuka aswamisiokec nukepali), ",
          "type": "text",
          "attrs": {
