              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.10"
              },
              "items": [
                {
                  "text": "Yud 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kes, kwape isuban luemamei acoa, lueuritai bala itiaŋ lutai aikamunio ka amudiario da, emoromoroete kotoma akiro numam ejenete, emudiario cut kotoma amudiarikec, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.12",
            "verseOrgIds": [
              "2PE.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 2:13"
          },
          "items": [
