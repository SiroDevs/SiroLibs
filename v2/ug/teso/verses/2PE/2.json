                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mam da abu kitim akwapin nukolo sek, konye kidar Noa ekalimonokinan loka adolit nepepe kituŋa ice ikanykaarei, naayaunia akalele akwapin nuka lumam eyoŋito Edeke; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.5",
            "verseOrgIds": [
              "2PE.2.5"
            ]
          }
        },
