            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotoma airaŋaanut da itudumunos ameda naepol kamakus kakiro nuepwakunete; atubokiniokec ageun apeŋo mam itiloro, amudiariokec da mam iluranari,",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.3",
            "verseOrgIds": [
              "2PE.2.3"
            ]
          }
