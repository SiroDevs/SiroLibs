            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ejeni Ejakait ayuun lueyoŋito Edeke kotoma acodunio, ka aidar lumam edolito kiticanete kiton apaaran naka atubokinio; ",
          "type": "text",
          "attrs": {
