        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.17",
            "verseOrgIds": [
              "GEN.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisiyalamikis akecekiro Kamor, ka Sekem okoku loka Kamor. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.18",
            "verseOrgIds": [
              "GEN.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
