            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.5+GEN.49.6+GEN.49.7"
              },
              "items": [
                {
                  "text": "Age 49:5-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kapaaran kanakiwunict, eriebas kesi, idwe iarei lutelepai luka Yakob, Simeon ka Lebi, iinacan luka Dina, kitin nolitunanan ekekileŋ, kosurokis ere kaiyeiyea, koarata ikiliok kere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.25",
            "verseOrgIds": [
              "GEN.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koarata Kamor ka Sekem kakwanis naka ekileŋ, kitolomut Dina kotogo loka Sekem, koloto. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.26",
            "verseOrgIds": [
              "GEN.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopotu odwe luka Yakob mama ejaas luearar, konata ere, naarai apotu komunaut kinacikec. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.27",
            "verseOrgIds": [
              "GEN.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyanaasi ikecesipanin ka ikecebaren ka asigiriakec, ka luajaas ore, ka luajaas omanikor; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
            "verseOrgIds": [
              "GEN.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konatasi abarakec kere, ka idwekec ludidik, ka aijorokec, kere luajaas togo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
            "verseOrgIds": [
              "GEN.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
