                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.9"
              },
              "items": [
                {
                  "text": "Isa 54:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eitununei eoŋ da akaitutuket naabu ketutuk eoŋ nepepe kayes, ka ninisubat yenejari yenikakuan kere, ido mam bobo akipi eraunos akalele amudiar akuan naka ŋinibore kere, ",
          "type": "text",
          "attrs": {
