            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam kakurwokin aibura akusiwokot, aokot nuka aijarakus, eburai kes kakan naka ŋolitiaŋ; kakan da naka ituŋanan, karaida kakan naka onace loka ninitunanan, eburai eoŋ aijar naka ituŋanan, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.5",
            "verseOrgIds": [
              "GEN.9.5"
            ]
          }
        },
