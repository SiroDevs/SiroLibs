              "type": "text"
            }
          ]
        },
        {
          "text": " Odwe luka Noa, lualomunete kataker kes Sem, ka Kam, ka Yapet: Kam da ŋes papa loka Kanaan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.18",
