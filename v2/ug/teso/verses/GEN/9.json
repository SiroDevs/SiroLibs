            }
          ]
        },
        {
          "text": " Kisireren Edeke Noa ka odweke, kotema kes atiar, “Kouriata, kipuaros, kilelebata akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
            "verseOrgIds": [
              "GEN.9.1"
            ]
          }
        },
        {
