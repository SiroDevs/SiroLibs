        },
        {
          "text": " Konyarau Isaak Yakob, kilipak arereij, kicorak, kobala ebe, “Sirikimany aberu naka apesur nukoKanaan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.1",
            "verseOrgIds": [
