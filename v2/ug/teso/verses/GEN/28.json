          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyakia Isaak Yakob: kolot Padan-Aram, mama ejai Laban okoku loka Betuel Esuriat onaceke loka Rebeka toto naka Yakob ka Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
            "verseOrgIds": [
