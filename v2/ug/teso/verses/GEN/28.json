          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodol aceibois korotoke, koper aitiwalar akwap, naarai alomarit akoloŋ; koyana amoru adiopet naka aibois kaŋin, kicolonik akekou, kojotoor kaibois kaŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.11",
            "verseOrgIds": [
              "GEN.28.11"
            ]
