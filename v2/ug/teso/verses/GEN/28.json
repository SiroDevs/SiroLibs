        {
          "text": " Koinak jo arereŋ naka Aburaam, ijo nepepe kakoniwur, tetere irumi akwap nakolo kitorit nakeinakini Edeke Aburaam.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.4",
            "verseOrgIds": [
              "GEN.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
