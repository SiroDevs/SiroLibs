            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Edeke da Lokapedor kere kisireren jo, kitupu, kiyatanak, koraun erioner loka atekerin; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.3",
