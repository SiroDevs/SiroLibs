              "items": [
                {
                  "text": "1 Kor 16:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.12"
              },
              "items": [
                {
                  "text": "2 Kor 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.14"
              },
              "items": [
                {
                  "text": "1 Pet 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konu Yakob Rakel, kodelo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.11",
            "verseOrgIds": [
              "GEN.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.8"
              },
              "items": [
                {
                  "text": "Age 13:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.28"
              },
              "items": [
                {
                  "text": "24:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolimok Yakob Rakel kwape eraar ŋesi onace loka papake, ido kwape eraar okoku loka Rebeka; koker kolimok papake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        }
      ]
    },
