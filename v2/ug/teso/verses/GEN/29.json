                "loc": "EXO.2.16"
              },
              "items": [
                {
                  "text": "Any 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eroko ŋesi inera kakes, kobu Rakel nepepe kamerekekin nuka papake; naarai ŋes ecokienenei. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.9",
            "verseOrgIds": [
              "GEN.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.17"
              },
              "items": [
                {
                  "text": "Any 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi nakeanyunia Yakob Rakel akoku naka Laban onace loka totoke, ka amerekekin nuka Laban onace loka totoke, kikuny Yakob, kikokorio amoru kolema kaituk naka atan, kiruanak esipan loka Laban onace loka totoke, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.10",
            "verseOrgIds": [
              "GEN.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.33.4"
              },
              "items": [
                {
                  "text": "Age 33:4",
