              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloma neejai Rakel da, komina Rakel aitelekarit Lea, kijaanak bobo ikar ice ikanykaarei.",
          "type": "text",
          "attrs": {
