              },
              "items": [
                {
                  "text": "Age 24:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kiira Laban akiro nuka Yakob okoku loka inacike, koker airiamun kaŋes; kotun, konu noi, kitoloma togoke. Kolimok Laban akiro ŋun kere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.13",
            "verseOrgIds": [
              "GEN.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.23"
              },
              "items": [
                {
                  "text": "Age 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.9.2"
              },
              "items": [
                {
                  "text": "Tub 9:2",
