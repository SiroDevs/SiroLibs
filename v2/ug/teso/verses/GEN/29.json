              },
              "items": [
                {
                  "text": "Eko 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijaanak Yakob ikar ikanykaarei tetere einakinio Rakel; kosubata apaarasia bala ikidioko, kanuaminar ŋes,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
            "verseOrgIds": [
              "GEN.29.20"
            ]
          }
        }
