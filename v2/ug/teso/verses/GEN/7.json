                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lualomarete da, kolomasi yenikiliokit ka yeniberu yenika ninikuan kere, kwape kicorakinia ŋes Edeke: kogolok EJAKAIT ŋes toma,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
