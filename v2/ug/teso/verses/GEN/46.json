            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyou Yakob anyoun koBeer-seba: apotu odwe luka Isirael kodakasi Yakob papakec, ka ikecedwe ludidik ka akecenor da, kagalin nuejukari Parao adakunia ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.5",
            "verseOrgIds": [
              "GEN.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
