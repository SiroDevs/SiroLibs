          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Yosep ikeinacan ka ekalloka papake atiar, “Alosi alimokin Parao ebe, ‘Apotu mama ajai ikainacan ka ekalloka papaka luajaas akwap nako Kanaan, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        },
        {
          "name": "verse",
