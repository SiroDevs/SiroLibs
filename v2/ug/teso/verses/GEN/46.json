                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Odwe luka Gad; Sipion, ka Kagi, ka Suni, ka Esebon, ka Eri, ka Arodi, ka Areli. ",
          "type": "text",
          "attrs": {
