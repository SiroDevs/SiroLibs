          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 46:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido eraas kesi ikecokok, naarai icokienenete ibaren; ayaut da isipaninikec luka amerekekin ka aituk, ka iboro kere luejaatar.’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
          }
        },
