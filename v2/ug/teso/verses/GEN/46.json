            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobala ebe, “Eoŋ Edeke, Edeke loka papakon: sirikikurianar alosit Misiri, naarai ketuluori jo kaŋina ateker naepol. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.3",
            "verseOrgIds": [
              "GEN.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 46:4"
          },
          "items": [
