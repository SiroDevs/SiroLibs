            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiner Edeke ka Isirael kotapo loka akuare ebe, “Yakob, Yakob.” Kotema atiar, “Eoŋ lo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.2",
            "verseOrgIds": [
              "GEN.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
