              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lu kes ikiroria luka idwe luka Isirael, luapotu kolomasi Misiri, Yakob ka odweke; Reuben, ekiyai loka Yakob. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.8",
            "verseOrgIds": [
              "GEN.46.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
