                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Natikwana sirikiikadakis, karaida anyunyurikin kotauonokus, kanukigwelariata tape kayaunio ne: naarai abu Edeke ketiliŋ eoŋ aitaiar yes. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.5",
            "verseOrgIds": [
              "GEN.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adau ebeli kotoma akwap ikar iarei: ido eriŋa esalito ikar ikany lumam ekoriere karaida asakia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.6",
            "verseOrgIds": [
              "GEN.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido Edeke ŋes ketilini aitajarikin yes ipapai kotoma akwap, aitajar da yes koraut erioŋet loepol loedeun. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.7",
            "verseOrgIds": [
              "GEN.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.43"
              },
              "items": [
                {
                  "text": "Age 41:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.10"
              },
              "items": [
                {
                  "text": "Tub 17:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.29.16"
              },
              "items": [
                {
                  "text": "Yob 29:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso mere yes kiyaunete eoŋ ne, nabarai Edeke; ketuluo da papa neejai Parao, ido ejakait loka etogoke kere, ekayaiton akwap kere nako Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.8",
            "verseOrgIds": [
              "GEN.45.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.14"
              },
              "items": [
                {
                  "text": "Asw 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisunyito, kobonosi neejai papaka, kotemasi ŋes atiar, ‘Okokukon Yosep atema kwanata ebe, “Abu Edeke ketuluo ejakait loka Misiri kere: kobwot neaiai, sirikiyap. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.9",
            "verseOrgIds": [
              "GEN.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.47.1"
              },
              "items": [
                {
                  "text": "Age 47:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido iboienenei kakwap nako Gosen, kidunyakin keen, ijo ka ikonidwe, ka idwe luka idwekon, ka akonimerekekin, ka akoniituk, ka luiiaatar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.10",
            "verseOrgIds": [
              "GEN.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.4"
              },
              "items": [
                {
                  "text": "1 Tim 5:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ketanenenei da kanen: naarai eriŋa esalito ikar ikany luka ebeli: kinye aiyarorotoi, ijo ka ekalekon ka luiiaatar.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.11",
            "verseOrgIds": [
              "GEN.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.23"
              },
              "items": [
                {
                  "text": "Age 42:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido koany, esesenete akusikonye, akonye da nuka onaceka Benyamin, aitukuka ŋipeŋin inera kayes. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.12",
            "verseOrgIds": [
              "GEN.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.12"
              },
              "items": [
                {
                  "text": "Mar 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.29"
              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.14"
              },
              "items": [
                {
                  "text": "Asw 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ilimokinete papaka aibusesuka kere kotoma Misiri kwape ejaar, ka nuianyut kere: kiwonyakisi kitwobotut papaka ne.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.13",
            "verseOrgIds": [
              "GEN.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kibirokin omurisin loka onaceke Benyamin, komony akiyo: Benyamin da komony komurisinlke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.14",
            "verseOrgIds": [
              "GEN.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konuana ikeinacan kere, komony kamakec: kokau kanun kiyalata ikeinacan kaŋes.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.15",
            "verseOrgIds": [
              "GEN.45.15"
            ]
          }
        }
      ]
    },
    {
