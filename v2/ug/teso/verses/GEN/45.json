              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kekurwoki Yosep aitik etauke kakonyen nuka ŋul kere luabwoete aaput kaŋes; kiworo kotema atiar, “Kitolomasi ŋinituŋanan konyout kaneaiai.” Komamuun ituŋanan yenabwoi kaneajai ŋesi, naalimoror Yosep koinacanake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.1",
            "verseOrgIds": [
              "GEN.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodelo noi; kiirasi Imisirian, kiira da etogo loka Parao, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.2",
            "verseOrgIds": [
              "GEN.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
