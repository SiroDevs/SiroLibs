              "items": [
                {
                  "text": "Mk 6:50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Yosep ikeinacan atiar, “Eoŋ Yosep; eriŋa papaka ejari?” Mam iinacanake apotu kobonokis ŋes: naarai eyalononoete kakonyeneke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.3",
            "verseOrgIds": [
              "GEN.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.28"
              },
              "items": [
                {
                  "text": "Age 37:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Yosep ikeinacan atiar, “Kikunyutu neaiai, kenainaito.” Kikunyakis. Kotema atiar, “Eoŋ Yosep onacekus, Ioipotu kogwelasi tape kayaunio Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.4",
            "verseOrgIds": [
              "GEN.45.4"
            ]
          }
        },
