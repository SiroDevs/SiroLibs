          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.22"
              },
              "items": [
                {
                  "text": "1 Sam 15:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.5"
              },
              "items": [
                {
                  "text": "Age 26:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
