                "loc": "ROM.8.32"
              },
              "items": [
                {
                  "text": "Rom 8:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.22"
              },
              "items": [
                {
                  "text": "Yak 2:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema atiar, “Sirikidokok akan otelepat, kwabo sirikisubak idiobore: naarai ajeni kwana kwape iyonitor Edeke, naarai mam kimikit ikokukon, ikonikoku iteluna.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.12",
            "verseOrgIds": [
              "GEN.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 22:13"
          },
          "items": [
