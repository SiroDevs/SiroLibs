                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodoloto aibois naalimokinit ŋes Edeke; kodukok Aburaam etem nen, kigan akito, koen ikekoku Isaak, kisiperik otem, kuju akito. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.9",
            "verseOrgIds": [
              "GEN.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.6+ISA.53.7+ISA.53.8+ISA.53.9+ISA.53.10+ISA.53.11+ISA.53.12"
              },
              "items": [
                {
                  "text": "Isa 53:6-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Korio Aburaam akekan, kolem ekileŋ aaria ikekoku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.10",
            "verseOrgIds": [
              "GEN.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiworo emalaika loka EJAKAIT ebwoi kokuju, kobala ebe, “Aburaam, Aburaam.” Kotema atiar, “Eoŋ lo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
