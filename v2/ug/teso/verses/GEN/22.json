              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.7"
              },
              "items": [
                {
                  "text": "1 Kor 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitonyou Aburaam akekonyen, kosesen, ido koany, kojai emerekek kauken, ikamunit amoni amumwarake: kolot Aburaam koyana emerekek, koinak araun ainakinet naicweio aibois naka ikekoku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.13",
            "verseOrgIds": [
              "GEN.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komaik Aburaam aibois nin Yawe-yire: kwape inerare aitodol lolo ebe, “Komoru loka EJAKAIT edumunere.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        }
      ]
