              "type": "text"
            }
          ]
        },
        {
          "text": " Kotwanik Sara Kiriat-aruba (ŋes Keburon) kakwap naka Kanaan; kobu Aburaam akuudian ka eibworo Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.2",
            "verseOrgIds": [
              "GEN.23.2"
            ]
          }
        },
        {
