              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araun luke kakonyen nuka idwe luka Ket, kakonyen nuka nul kere luapotu kolomut korute loka ereke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
