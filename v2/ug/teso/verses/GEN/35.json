            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodukok nen etem, komaik aibois El-bet-el: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
