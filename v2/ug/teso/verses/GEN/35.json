              "items": [
                {
                  "text": "Age 24:59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotwana Debora akasaan naka Rebeka, kidaikinai kwap naka Bet-el kwap kelua: komaikinai ekiror Alon-bakut.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
