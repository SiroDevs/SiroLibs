                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwaŋin kodolo Yakob Lus, naejai akwap naka Kanaan (nin ŋes Bet-el), ŋes ka ituŋa kere lukejaatar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.6",
            "verseOrgIds": [
