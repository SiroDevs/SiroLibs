            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "35:8",
              "type": "text"
            },
            {
              "text": "Alon-bakut Apolouke Elua loka aibworo.",
              "type": "text"
            }
          ]
        }
