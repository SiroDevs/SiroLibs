        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "35:7",
              "type": "text"
            },
            {
              "text": "El-bet-el Apolouke Edeke loka Bet-el.",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai nen etakanikinor Edeke, naakeria kakonyen nuka onaceke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
