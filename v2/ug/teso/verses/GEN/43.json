                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodedenear ebeli kakwap. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.1",
            "verseOrgIds": [
              "GEN.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, kedaut ainyam akima kere nuaomete koMisiri, kotema kes papakec atiar, “Koloto bobo, kogwelut idisinyamat.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.2",
            "verseOrgIds": [
              "GEN.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.20"
              },
              "items": [
                {
                  "text": "Age 42:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.23"
              },
              "items": [
                {
                  "text": "44:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobala Yuda ŋes ebe, “Abu etuŋanan kiyapoik sio cut, kobala ebe, ‘Mam ianyunete akakonyen dimikito ejai onacekus kayes.’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.3",
            "verseOrgIds": [
              "GEN.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai ijukari onacekos kasio, kilosi agwelakin jo inyamat; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.4",
            "verseOrgIds": [
              "GEN.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai mam iiukari, mam kilosi: naarai abu etuŋanan kobala sio ebe, ‘Mam ianyunete akakonyen, dimikito ejai onacekus kayes.’’’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.5",
            "verseOrgIds": [
              "GEN.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobala Isirael ebe, “Kanukinyo kiswamakiniata eoŋ erono kwaŋin, alimokin etuŋanan ebe ejai onacekus ece?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.6",
            "verseOrgIds": [
              "GEN.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobalas ebe, “Abu etuŋanan je kinitinit sio kwape kiiaar, ido kwape eiaar cwokokek, kobala ebe, ‘Eroko papakus ejari? Ejai yes onaeekus ece?’ Kalimokis ŋes kwape ejaatar akiro ŋun; tikipedo biai ajenun ebe etemari atiar, ‘Koyaut onaeekus da’?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.7",
            "verseOrgIds": [
              "GEN.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Yuda Isirael papake atiar, “Kijuka esapat keoŋ, kinyouni isio da kaloto: tetere kiiari, kenyeisi atwakare, isio ka jo, ka idwckosi ludidik. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.8",
            "verseOrgIds": [
              "GEN.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.32"
              },
              "items": [
                {
                  "text": "Age 44:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.18"
              },
              "items": [
                {
                  "text": "Plm 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Araun eoŋ ekabwoiaranike: kitepeseni eoŋ kanuken; arai mam enyakunit mamakon, kebwaik kakonyenekon, kabeik eoŋ akirot apaarasia kere: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.9",
            "verseOrgIds": [
              "GEN.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kedim isio aitumor, abeit tikiibonu sek irwan nakiareit.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.10",
            "verseOrgIds": [
              "GEN.43.10"
            ]
          }
        }
      ]
    },
