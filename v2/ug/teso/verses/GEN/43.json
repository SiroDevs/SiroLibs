                "loc": "GEN.24.2"
              },
              "items": [
                {
                  "text": "Age 24:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.39.4"
              },
              "items": [
                {
                  "text": "39:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keanyu Yosep Benyamin ejai kakes, kotema ekeŋadan loka etogoke atiar, “Kitoloma ituŋa togo, kopuik, kitemonok; naarai kimori ituŋa ŋul keoŋ luka paaran.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.16",
            "verseOrgIds": [
              "GEN.43.16"
            ]
          }
        },
