                  "text": "Awa 14:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobalas ebe, “Eŋalei ebulesitikon papakosi, eroko eiari.” Kituluroto akecekwes, kokukumoto. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.28",
