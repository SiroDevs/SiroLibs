                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitoloma etuŋanan ituŋa togo loka Yosep, koinak kes akipi, kilotata akeeekeje: koinak akeeesigirian da inyamat. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.24",
            "verseOrgIds": [
              "GEN.43.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitemonokis ainakinet tetere kebu Yosep paaran; naarai apuput ebe enyamete atap kanen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.25",
            "verseOrgIds": [
              "GEN.43.25"
            ]
          }
        }
