                  "text": "Esk 27:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobala kes papakee Isirael ebe, “Arai do ikote nen, kiswamata kwanata; koyaata koborokus adisiraito nuka akwap nuitelekarito aiokis, koinakis etuŋanan ainakinet, ediomina, ka ediosik, ka luesaete, ka akinyet, ka emaido ka akunur: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.11",
            "verseOrgIds": [
              "GEN.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.25"
              },
              "items": [
                {
                  "text": "Age 42:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.35"
              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyaata da apesan aitemisio aarei kotoma akaninikus; koyaata bobo kakaninikus apesan nuenyakunio kaituke nuka ipukoikus; diat kinyakunio kanuka abuikin: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.12",
            "verseOrgIds": [
              "GEN.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyaata onaeekus da, konyout, kobonosi mama ejai etuŋanan, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.13",
            "verseOrgIds": [
              "GEN.43.13"
            ]
          }
        },
        {
