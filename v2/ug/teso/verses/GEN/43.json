              "items": [
                {
                  "text": "Nak 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Edeke Lokapedor koinak aitimio kakonyen nuka etuŋanan, kolaeak onaeekus je ka Benyamin. Eoŋ da arai katwania idweka, atwaniari.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.14",
            "verseOrgIds": [
              "GEN.43.14"
            ]
