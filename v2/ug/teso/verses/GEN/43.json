              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyaata ituŋa ainakinet ŋin, koyaata apesan aitemisio aarei kakaninikee, ka Benyamin; konyout koloto Misiri, kobwaata kakonyen nuka Yosep. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.15",
            "verseOrgIds": [
              "GEN.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
