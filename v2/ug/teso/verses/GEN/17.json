        },
        {
          "text": " Kotema Edeke atiar, “Mam, konye kiwurikin Sara aberukon ikoku; imaikini ijo da ekekiror Isaak; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
