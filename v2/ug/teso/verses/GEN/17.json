              "type": "text"
            }
          ]
        },
        {
          "text": "Kodaunite Aburaam ikar akaisakanykaoŋon ka lukanykaonon, nakekepere amuny naka ekiliokaneke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
            "verseOrgIds": [
