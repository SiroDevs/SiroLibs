                  "text": "Yok 7:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekepeneneo kotomakus yenedaunit apaarasia akanykauni; noliklliokit kotoma aturiokus, loewurikinio okal, ka ŋol da lokitwegelete imo kapesan, lomere loka aurikon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loeurio kokalekon, ka ŋol da loegweleneneo kapesanakon, ibusakinit akepio. Ejaununei da akaitutuket toma awatekus araun aitutuket namam edaun. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
