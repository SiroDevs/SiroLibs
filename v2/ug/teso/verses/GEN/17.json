            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Etutuki eoŋ akaitutuket kajo, kesupui da noi adepar.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
