          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaunit okokuke da Isimael ikar itomon ka luuni, nakekepere amuny naka ekiliokaneke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
