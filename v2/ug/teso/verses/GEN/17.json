        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.8"
              },
              "items": [
                {
                  "text": "Asw 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.11"
              },
              "items": [
                {
                  "text": "Rom 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na ŋes akaitutuket, nairicenenete, kidiŋ eoŋ ka jo ka akoniwur naetupanakini; Ekepeneneo ŋolikiliokit kotomakus. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.10",
            "verseOrgIds": [
              "GEN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 17:11"
