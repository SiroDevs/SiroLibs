        },
        {
          "text": " Kotema Edeke Aburam atiar, “Ŋo da, irici akaitutuket, ijo ka akoniwur naetupanakini anatar aturiokec kere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.9",
            "verseOrgIds": [
