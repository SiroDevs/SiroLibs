              "items": [
                {
                  "text": "Ikis 22:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ketuboros ilapio kwaka iuni, kolimokinai Yuda ebe, “Erai Tamar aberu naka okokukon naadote; ido koany, epotie akoik naka adoteu.” Kotema Yuda atiar, “Kitolomut ŋes, kicweai.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 38:25"
          },
          "items": [
            {
