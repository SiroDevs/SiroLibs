            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.34.31"
              },
              "items": [
                {
                  "text": "Yob 34:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kocam Yuda kes, kotema atiar, “Ketelekaa eoŋ karaut naedolit, naarai mam abu kainak ŋes Sela okokuka.” Mam bobo abu kojenu ŋes.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
