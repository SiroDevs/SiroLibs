              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.19",
            "verseOrgIds": [
              "GEN.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijuka Yuda ikalol yenika akinei kakan naka epaperoke Edulamit, ainyakunia aititiŋet kakan naka aberu: konye mam abu kodum ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.20",
            "verseOrgIds": [
              "GEN.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinit tuna luka aibois naka aberu atiar, “Anibo nadote nalem ejai Enaim ariri naka erot?” Kotemasi atiar, “Emamei lem nadote kane.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobono mama ejai Yuda, kotema atiar, “Mam abu kadum ŋes, ido ebalasi ituŋa luka aibois ebe, ‘Emamei lem nadote kane.’’’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.22",
            "verseOrgIds": [
              "GEN.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Yuda atiar, “Kenyeisi koyanaa, kinyein aisurum oni ileic; koany, ejuka ikalol yen, mam jo idumunit ŋes.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.23",
            "verseOrgIds": [
              "GEN.38.23"
            ]
          }
        }
      ]
    },
