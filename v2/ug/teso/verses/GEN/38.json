              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.32"
              },
              "items": [
                {
                  "text": "Age 37:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakitolomasi ŋes, kiyakik papaake atiar, “Ekiliokit elopet iboro lu, ŋes kapotikini.” Kotema atiar, “Kenainait, kojen lukanai lu, egilut, ka auno, ka ebela.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        },
