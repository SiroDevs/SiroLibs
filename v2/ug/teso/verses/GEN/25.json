                "loc": "GEN.49.29"
              },
              "items": [
                {
                  "text": "Age 49:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.30"
              },
              "items": [
                {
                  "text": "30",
