                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.16.12"
              },
              "items": [
                {
                  "text": "Age 16:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiboioto anyoun koKabila aitodol Sur naitei Misiri; bala ilosi Asuria; eboienenei kaneajaas ikeinaean kere.",
          "type": "text",
