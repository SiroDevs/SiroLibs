          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipo Yakob emanor; kolom Esau kais, ilworuna noi: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
            "verseOrgIds": [
              "GEN.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Esau Yakob atiar, “Keŋaiŋait, kitanyamai emanor ŋol Ioeren, naarai elworuna eut.” Ŋes enyaritere ekekiror Edom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:30",
              "type": "text"
            },
            {
              "text": "Edom Apolouke Eren.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Yakob atiar, “Kitwegelai lolo akonipolou.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
            "verseOrgIds": [
              "GEN.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Esau atiar, “Koany, eapie eoŋ atwanare, ido kenarakini eoŋ apolou biai?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.32",
            "verseOrgIds": [
              "GEN.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.16"
              },
              "items": [
                {
                  "text": "Bur 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Yakob atiar, “Kiyapoikinoi lolo.” Kiyapoik: kitwegel Yakob akepolou. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
            "verseOrgIds": [
              "GEN.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.32"
              },
              "items": [
                {
                  "text": "1 Kor 15:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koinak Yakob Esau atap ka emanor loka imare; konyam, komat, konyou, kolot; kwaijin amwania Esau akepolou.",
