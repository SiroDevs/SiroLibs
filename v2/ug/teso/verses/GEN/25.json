                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ikar da luka Isimael luabu kobut, ikar akwatat ka akaisauni ka lukanykaarei; kojal aijar, kotwana; koyanaarai mama ejaas iketuŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.17",
            "verseOrgIds": [
              "GEN.25.17"
            ]
          }
        },
