                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolom yenisodit erai yeneren akuanake kere, koeekite bala anapito naka ajul; komaikis ekekiror Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
