            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokau kolom onaeeke, itinit akekan atitibat naka Esau; komaikinai ekekiror Yakob; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
