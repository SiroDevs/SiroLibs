            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojal Aburaam aijar, kotwana kodaunite akokosan ejok, komoionite noi, kodoloto ikekar; koyanaarai mama ejaas iketuŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.8",
            "verseOrgIds": [
              "GEN.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 25:9"
          },
          "items": [
            {
