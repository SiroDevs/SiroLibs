                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosub yenikiliokit ka yeniberu: kisireren kes, komaik ekecekiror Adam,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
