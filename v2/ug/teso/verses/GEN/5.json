            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:2",
              "type": "text"
            },
            {
              "text": "Apolouke etuŋanan,",
              "type": "text"
            }
          ]
        },
        {
          "text": " kapaaran kaŋin kanaasubunere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
