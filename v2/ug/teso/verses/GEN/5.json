              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaarasia nuka Adam kedau aur Set kes ikar akwat akanykauni: kouri idwe lusap ka lupesur. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
