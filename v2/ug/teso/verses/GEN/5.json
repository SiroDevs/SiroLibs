              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodau Adam ikar akwatat ka akaisauni, kouru okokuke kasimake, kotoma aputoke; komaik ekekiror Set. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
