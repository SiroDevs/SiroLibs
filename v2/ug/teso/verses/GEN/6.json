              "type": "text"
            }
          ]
        },
        {
          "text": " Kiitu EJAKAIT naarai abu kosub etuŋanan kotoma akwap, kokadak kotauke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
