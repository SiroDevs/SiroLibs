            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.33"
              },
              "items": [
                {
                  "text": "Mar 13:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapaarasia kanun kojaas Inepilin roma akwap: ido kokau kanun, nakelomanariata odwe luka Edeke mama ejaas adwe nuka ituŋa, kourianakis kes: nulkes ituŋa lukagogon lukolo sek, ituŋa luajenas,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
