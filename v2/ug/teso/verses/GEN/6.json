        },
        {
          "text": " Kotema EJAKAIT atiar, “Mam ekatau epegenenas kitunanan ikar ka ikar, naarai erai ŋesi da akuan: konye eraunos akepaarasia ikar akwatat ka akaisaarei.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
