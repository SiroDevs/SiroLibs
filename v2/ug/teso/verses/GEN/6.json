            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, ayauni eoŋ da akalele naka akipi toma akwap, amudiar akuan kere naejai eiyeŋane loka aijar toma, kwap kakuj; etwani nlnibore kere yenejai toma akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.17",
            "verseOrgIds": [
              "GEN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
