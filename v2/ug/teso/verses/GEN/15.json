                "loc": "2SA.7.12"
              },
              "items": [
                {
                  "text": "2 Sam 7:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido koany, kobu akirot naka EJAKAIT mama ejai ŋesi ebe, “Etuŋanan ŋol mam erauni ekerumanikon, konye loebuni kopikisikon ŋes eraun ekerumanikon.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.4",
            "verseOrgIds": [
              "GEN.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
