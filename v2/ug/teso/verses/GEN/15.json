              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobala ebe, “Wu EJAKAIT Edeke, inyo bo ketejenikini ebe erumi?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        },
        {
