        },
        {
          "text": " Kotema Aburam Lot atiar, “Kenainait kinye eŋuŋet ajakut kidinika ka jo, ido mama ejaas ikecokokoka ka ikecokokokon; naarai kirai oni ikinacan ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.8",
            "verseOrgIds": [
              "GEN.13.8"
            ]
          }
        },
        {
