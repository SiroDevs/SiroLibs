            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiteluo Lot akekonye, koanapuuton naka Yorodan kere, ajaas akip nuipu niniibois. Koroko be EJAKAIT kemudiara Sodom ka Gomora, kosubite bala emanikor loka EJAKAIT ido kwape akwap nako Misiri ilosi Soar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi koner Lot apuuror naka Yorodan kere; kidiar Lot kide: kotiakas kesi bonik. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.11",
            "verseOrgIds": [
              "GEN.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
