              "items": [
                {
                  "text": "Age 19:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiboikir Aburam akwap naka Kanaan, ka Lot da kiboikin oreria luka apuuton kibubuk ewemake Sodom. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.12",
            "verseOrgIds": [
              "GEN.13.12"
            ]
          }
