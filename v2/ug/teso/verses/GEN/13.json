            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.3.13+JAS.3.14+JAS.3.15+JAS.3.16+JAS.3.17+JAS.3.18"
              },
              "items": [
                {
                  "text": "Yak 3:13-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam akwap kere ejai akonyenekon? Kenainait, kogitar ijo kama ajai arai kinere ijo akan nakokediany, eoŋ da alosi nakoteten; arai kinere ijo akar nakoteten, eoŋ da alosi nakokediany.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.9",
            "verseOrgIds": [
              "GEN.13.9"
            ]
          }
        },
        {
