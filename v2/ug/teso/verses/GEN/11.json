            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso, kadokasi kwap, kenyalinyalatakanen anaiepakec, kinye ninituŋanan ajenun einer loka yenice.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.7",
            "verseOrgIds": [
              "GEN.11.7"
            ]
          }
        },
        {
