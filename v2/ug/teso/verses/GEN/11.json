            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.53.2"
              },
              "items": [
                {
                  "text": "53:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodoku EJAKAIT kwap aanyun ere ka etogo loeoia noi loadukete idwe luka ituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.5",
            "verseOrgIds": [
              "GEN.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 11:6"
          },
          "items": [
            {
