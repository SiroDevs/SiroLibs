                "loc": "1CO.14.23"
              },
              "items": [
                {
                  "text": "1 Kor 14:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋes kemaikinere ekekiror Babel, naarai kanen ŋes enyalinyalia EJAKAIT aŋajep naka akwap kere; ido kaŋina kisiarak kes EJAKAIT akwap kere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        }
      ]
