                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwaŋin kisiarak EJAKAIT kes cut anyoun kaŋina kikaaros akwap kere: kinyeis kesi aiduk ere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.8",
            "verseOrgIds": [
              "GEN.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 11:9"
          },
          "items": [
