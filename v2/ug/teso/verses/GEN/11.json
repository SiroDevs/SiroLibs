              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodau Arupakusad ikar akaisauni ka lukany, kouru Sela; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
