          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodau Arupakusad ikar akwat aoŋon ka iuni, kedau aur Sela, kouri idwe lusap ka lupesur,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
