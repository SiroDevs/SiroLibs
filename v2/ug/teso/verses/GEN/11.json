            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na ŋes aur naka Sem. Adaunit Sem ikar akwatat, kouru Arupakusad ikar iarei akaulo kakalele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
