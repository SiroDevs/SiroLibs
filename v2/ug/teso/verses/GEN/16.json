                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emalaika loka EJAKAIT kodumak ŋes okicoi loka akipi kamodiŋ, ekicoi loejai orot ilosi Sur. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.7",
            "verseOrgIds": [
              "GEN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema atiar, “Kagar, abulesit naka Sarai, kibuni kai? Ido ilosi ai?” Kotema atiar, “Asii eoŋ kakonyen nuka tataaka Sarai.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.8",
            "verseOrgIds": [
              "GEN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.5+EPH.6.6+EPH.6.7+EPH.6.8+EPH.6.9"
              },
              "items": [
                {
                  "text": "Pes 6:5-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema emalaika loka EJAKAIT ŋes atiar, “Koboŋo neejai tataakon, kononokikinite ŋes.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.9",
            "verseOrgIds": [
              "GEN.16.9"
            ]
          }
        },
        {
