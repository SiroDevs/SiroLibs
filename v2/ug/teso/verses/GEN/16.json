                  "text": "Age 25:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema emalaika loka EJAKAIT ŋes atiar, “Esupui noi akoniwur, komam imarunos kanuka aipues.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.10",
            "verseOrgIds": [
              "GEN.16.10"
            ]
          }
        },
        {
