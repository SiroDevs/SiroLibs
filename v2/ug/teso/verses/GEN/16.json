            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.139.1+PSA.139.2+PSA.139.3+PSA.139.4+PSA.139.5+PSA.139.6+PSA.139.7+PSA.139.8+PSA.139.9+PSA.139.10+PSA.139.11+PSA.139.12"
              },
              "items": [
                {
                  "text": "Sab 139:1-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Komaik ekiror loka EJAKAIT lokineras kaŋes ebe, “Irai ijo Edeke loitei”: ebe da, “Aseseni kereka eoŋ ŋol loketei kane da?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.13",
            "verseOrgIds": [
              "GEN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋes kemaikinere ekicoi Beer-Iakai-roi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:14",
              "type": "text"
            },
            {
              "text": "Beer-lakai-roi Apolouke Ekicoi loka Ekajaran loketei eoŋ.",
              "type": "text"
            }
          ]
        },
        {
          "text": " koany, ejai kidin ka Kades ka Bared.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        }
      ]
