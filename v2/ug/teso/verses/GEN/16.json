          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodaunite Aburam ikar akaisakany kauni ka lukanykape naaurikinia Kagar Aburam Isimael.",
          "type": "text",
