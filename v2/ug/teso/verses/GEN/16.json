            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kourik Kagar Aburam ikoku yenitelepat; komaik Aburam ikekoku yenaurier Kagar ekekiror Isimael. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
