              "type": "text"
            }
          ]
        },
        {
          "text": " Kinyikok aitoduun bon korai lokitojokit Edeke, ekeswaman lomam ipuda kirumata ileic, loitubi kotenan akirot naka abeit. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.15",
            "verseOrgIds": [
