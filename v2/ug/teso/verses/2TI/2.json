            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun ŋes atitiŋikinio kere, kanuka luseuna, tetere kes da edumunete aitajario naejai toma Kristo Yesu nepepe kaibuses naka ikar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
              "2TI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
