                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " arai kititiŋikini, kirumi da nepepe kaŋes; arai kiŋeri ŋes, ŋes da kiŋeri oni; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.12",
            "verseOrgIds": [
