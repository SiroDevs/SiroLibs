            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nueticanitor kiton aenio kwape loiswamai aronis. Konye akirot naka Edeke mam eenio. ",
          "type": "text",
          "attrs": {
