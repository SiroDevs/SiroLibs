                {
                  "text": "2 Kor 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Namunot akirot ŋin: naarai arai kipou katwaka nepepe kaŋes, kijari da nepepe kaŋes; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.11",
            "verseOrgIds": [
