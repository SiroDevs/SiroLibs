                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ibusakinit ekakorion loitaaritoi ageun ayaŋaar araito. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.6",
            "verseOrgIds": [
              "2TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koomoom nuener, naarai kiinakin Ejakait ajenun kotoma akiro kere.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
