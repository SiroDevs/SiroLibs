                  "text": "1 Tim 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinac akiro nutai, numam eraas nuka edini, naarai itedeparos kotoma amamus ayoŋit Edeke, ",
