              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idunyakin ateker naka Manase neejai ŋesi: ekapolon loka idwe luka Manase ŋes Gamaliel okoku loka Pedasur: ",
          "type": "text",
