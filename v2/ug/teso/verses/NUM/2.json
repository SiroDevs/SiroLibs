            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kere luaponi kimarai luka iidukurun luka Yuda emwaasi ilukumin akwatat ka akaisakanykauni ka lukanykape ka akwat aoijon, kwape ejaatar irionetakec. Kes egeete alosit.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
