              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋul luka emedera loka iidukurun luka Yuda, kes idukurete ari nakokide kama eniunia akoloŋ, kwape ejaatar irionetakec: ido ekapolon loka idwe luka Yuda ŋes Nason okoku loka Aminadab. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido erioneteke, ka ŋul luaponi kimarai kakesi, emwaasi ilukumin akaisakanykaarei ka luonon ka akwat akanykape. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 2:5"
