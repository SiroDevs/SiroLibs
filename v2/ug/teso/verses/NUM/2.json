            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido nul luidukurete eiduny kaŋes kes luka ateker naka Isakar: ekapolon da loka idwe luka Isakar ŋes Netanel okoku loka Suar: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.5",
            "verseOrgIds": [
              "NUM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 2:6"
          },
          "items": [
            {
