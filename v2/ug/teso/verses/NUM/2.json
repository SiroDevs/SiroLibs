          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erioneteke, ka nul luaponi kimarai kakesi, emwaasi ilukumin akaisakany ka lukanykaarei ka akwat aoŋon. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.8",
            "verseOrgIds": [
              "NUM.2.8"
            ]
          }
        },
        {
          "name": "verse",
