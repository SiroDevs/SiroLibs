        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.30.15"
              },
              "items": [
                {
                  "text": "2 Siit 30:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.31.2"
              },
              "items": [
                {
                  "text": "31:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akaulo kanun kolomasi Ilebin toma aswam naka aiiaanakin naka ewema loka airiamunun kakonyen nuka Aaron, kakonyen da nuka odweke: kwape ecorakinitor EJAKAIT Musa nuka Ilebin, kiswamakis kes kwaŋin.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        }
      ]
