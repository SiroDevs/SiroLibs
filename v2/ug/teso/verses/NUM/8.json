            }
          ]
        },
        {
          "text": " “Kolimok Aaron ebe, Naisipokinia ijo atalai, atalai akanykaarei kes ecaete koinaren kepir loka atala.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
              "NUM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswama Aaron kwaŋin; kosipok atalai nen tetere ecaete koinaren kepir loka atala, kwape kicorakinia EJAKAIT Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.3",
            "verseOrgIds": [
              "NUM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31"
              },
              "items": [
                {
                  "text": "Any 25:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eswamatai epir loka atala kwanata, esabu loerukuk; kwapuke kiton aturoke da korau aswam naerukuk: kwape ajaar aput naabu EJAKAIT kitodikinite Musa, kwaŋin kiswamau ŋesi epir loka atala.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        }
      ]
