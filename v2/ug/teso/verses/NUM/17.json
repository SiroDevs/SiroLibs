            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiperik Musa ibelai kakonyen nuka EJAKAIT kowema loka aitejenunet.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.7"
            ]
          }
