          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotemasi idwe luka Isirael Musa atiar, “Koany, kiolio, kitwaka, kitwaka isio kere, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.12",
            "verseOrgIds": [
              "NUM.17.12"
            ]
          }
        },
