            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ieweikinio ataok kakonyeneke; emukuleke, akirinike, aokotoke, ka ikijitike da, ieweikinio: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.5",
            "verseOrgIds": [
              "NUM.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
