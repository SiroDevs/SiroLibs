              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋinimot da namam erapap, naemamei arapetait kaitukuke, erai namam elai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
