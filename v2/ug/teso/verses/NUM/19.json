              "items": [
                {
                  "text": "2 Kor 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Etukonokini etuŋanan loelai ekurwon loka ataok, kosodi abukokin aibois naelai kokina kiidukurun, idario ŋes kanuka atukot naka idwe luka Isirael araun akipi nuitesegaarete: erai ainakinet naka adiakaret. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.9",
            "verseOrgIds": [
              "NUM.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilosi ŋol loetukonokini ekurwon loka ataok inapeneke, esali da erai lomam elai aitodol eboŋ: eraun ekisil mama ejaas idwe luka Isirael ka imoit yeniboienenei kamakee ikar kere,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
        }
      ]
    },
