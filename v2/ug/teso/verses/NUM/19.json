        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.14.4"
              },
              "items": [
                {
                  "text": "Leb 14:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.14.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elemuni esasedoti akitoi naka eres, ka esop, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.6",
            "verseOrgIds": [
              "NUM.19.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:6",
              "type": "text"
            },
            {
              "text": "esop eputosi bala emopim.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka eusi loeren, kosodi acakakin akim naicweere ataok, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.6",
            "verseOrgIds": [
              "NUM.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
