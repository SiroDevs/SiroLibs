        {
          "text": " Idomakini Eleasar esasedoti ekebokorit toma aokotoke, ebwatanakini aokotoke kiŋaren kewema loka airiamunun irwan akanykaarei: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.4",
            "verseOrgIds": [
              "NUM.19.4"
            ]
          }
        },
        {
