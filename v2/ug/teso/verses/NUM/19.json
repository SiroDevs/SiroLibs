              "items": [
                {
                  "text": "15:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi do esasedoti ailot ikenapen, ka ailoŋ akekuan kakip, akaulo kanun eboŋuni oidukurun, ido esali esasedoti erai lomam elai aitodol eboŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.7",
            "verseOrgIds": [
              "NUM.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido ŋol loecwei ataok ilosi ikenapen kakip, ka ailoŋ da akekuan kakip, esali erai lomam elai aitodol eboŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.8",
            "verseOrgIds": [
              "NUM.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
