              },
              "items": [
                {
                  "text": "Yos 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kidarete aleleŋio kotoma olap losodit, kapaaran nakitomonet kaonon naka elap, eboŋ, kamodiŋ naka Sinai: kwape ajaatar kere nueeorakinit EJAKAIT Musa, kiswamata idwe luka Isirael kwaŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
