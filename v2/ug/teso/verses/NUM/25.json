                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ebeloki Pinekas, okoku loka Eleasar, okoku loka Aaron esasedoti, akanyunyura anyoun kodwe luka Isirael, naarai ekokotiki kes kekakokote, kenye amudiar idwe luka Isirael kokokoteka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.11",
            "verseOrgIds": [
              "NUM.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.1"
              },
              "items": [
                {
                  "text": "Mal 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun kolimok ebe, ‘Koany, ainakini ŋes aitutuketeka naka ainapakin: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.12",
            "verseOrgIds": [
              "NUM.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
