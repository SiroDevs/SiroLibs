              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai apotu kiworosi ituŋa asuban nuka idekesiokec, konyamata innja, kokukonokinos idekesiokec, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.2",
            "verseOrgIds": [
              "NUM.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 25:3"
          },
          "items": [
