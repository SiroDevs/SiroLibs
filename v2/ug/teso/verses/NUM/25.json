          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiror da loka etuŋanan loka Isiraelloaario, loaario kaberu naMidianit, ŋes Simiri, okoku loka Salu, ekapolon loka ekal loka lukapapaakec luka Isimeonin. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.14",
            "verseOrgIds": [
              "NUM.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiror da loka aberu naMidianit naario, ŋes Kosibi, akoku naka Sur; arai ŋesi ekapolon loka ituŋa luka ekal loka lukapapaakec kotoma Midian.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.15",
            "verseOrgIds": [
              "NUM.25.15"
            ]
          }
        }
