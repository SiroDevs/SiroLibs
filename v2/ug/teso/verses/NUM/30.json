          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋul kes ikisila, lueeorakini EJAKAIT Musa, mama ejai etuŋanan ka akeberu, mama ejai papa ka akokuke naejai koiditeuke, okal loka papake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.16"
            ]
          }
        }
      ]
