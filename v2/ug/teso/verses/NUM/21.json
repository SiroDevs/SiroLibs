          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai arai Kesibon ere loka Sikon ekabaka loka Imorain, loabu kitiji ekabaka loka Moab losek, kodema kotoma akanike akekwap kere, kiton Arunon. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
