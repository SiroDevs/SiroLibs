                "loc": "1CO.10.9"
              },
              "items": [
                {
                  "text": "1 Kor 10:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.19"
              },
              "items": [
                {
                  "text": "Sab 78:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
