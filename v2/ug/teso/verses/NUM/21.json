          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋes ineratatar luineras kawaragasia ebe,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
