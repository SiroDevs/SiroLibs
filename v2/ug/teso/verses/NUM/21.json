              "items": [
                {
                  "text": "Awa 27:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinerata ituŋa erono mama ejai Edeke ka Musa, ebe, “Kanuk inyo kitonyounio sio koMisiri atwanikin amodiŋ? naarai emameete inyamat, emameete da akip: apas akosiiiar ainyam luebenen.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.5",
            "verseOrgIds": [
              "NUM.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 21:6"
          },
