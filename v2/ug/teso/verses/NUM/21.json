          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolototo idwe luka Isirael, kidukuroto Obot. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.10",
            "verseOrgIds": [
              "NUM.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolototo anyoun koObot, kidukuroto Iyeabarim, amodiŋ naitei Moab, kari nakokide, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.11",
            "verseOrgIds": [
              "NUM.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolototo anyoun kanen, kidukuroto aditot naka Sered. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.12",
            "verseOrgIds": [
              "NUM.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.36"
              },
              "items": [
                {
                  "text": "Mar 22:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.18"
              },
              "items": [
                {
                  "text": "Tub 11:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolototo anyoun kanen, kidukuroto juwai naka Arunon, naejai amodiŋ, naelomunit koikor loka Imorain: naarai Arunon ŋes eikor Ioka Moab, kidin Moab ka Imorain. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.13",
            "verseOrgIds": [
              "NUM.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋes ebakare kotoma oitabo loka Ŋiisio luka EJAKAIT ebe,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        }
      ]
    },
