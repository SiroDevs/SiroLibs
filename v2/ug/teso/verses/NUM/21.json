        },
        {
          "text": " Konyout komoru Kor koloto korot loka Aŋolol Nakarenan aiririar akwap naka Edom: kosorianata itauon luka ituŋa kanuka erot. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.4",
            "verseOrgIds": [
              "NUM.21.4"
            ]
          }
        },
        {
