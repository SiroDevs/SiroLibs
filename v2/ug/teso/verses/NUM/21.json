                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosub Musa emun loka aisinit, kibwaik kuju okitoi: kosodi kanen, arai etodit emun ituŋanan kere, naesesenia emun loka aisinit, koiari,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.9",
            "verseOrgIds": [
              "NUM.21.9"
            ]
          }
        }
      ]
