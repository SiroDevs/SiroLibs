              "items": [
                {
                  "text": "Leb 27:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiyapo Isirael aiyaposit mama ejai EJAKAIT, kobala ebe, “Arai kiijaik ituŋa lu akanika, amudiari cut ireriakec.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopup EJAKAIT eporoto loka Isirael, kijaik Ikanaanin; komudiasi kes cut ka ireriakee: komaikinai aibois Koruma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        }
      ]
    },
