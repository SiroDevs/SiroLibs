                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijukak EJAKAIT imunwo luka akim otuŋa, kotodotodoto ituŋa: kotwaka ituŋa luipu luka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.6",
