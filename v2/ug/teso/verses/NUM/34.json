                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekudoori ekusikor ari naka eŋalakimak naka acinat naka Akurabim, kobei Sin: kodoli ari naka eŋalakimak naka Kades-barunea; kolosi Kasaradar, kobei Asumon: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.4",
            "verseOrgIds": [
              "NUM.34.4"
            ]
          }
        },
