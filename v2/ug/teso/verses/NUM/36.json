                "loc": "NUM.27.7"
              },
              "items": [
                {
                  "text": "Mar 27:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kicorak Musa idwe luka Isirael kwape ajaar akirot naka EJAKAIT, ebe, “Inera ateker naka odwe luka Yosep nuedolito, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.5",
            "verseOrgIds": [
              "NUM.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ŋes akirot naieorakinit EJAKAIT kanuka adwe nuka Selopekad, ebe, ‘Kodukokinos kesi luitoiokito kesi; konye edukokinos lukokek loka ateker naka papakee.’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.6",
            "verseOrgIds": [
              "NUM.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.3"
              },
              "items": [
                {
                  "text": "1 Ika 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwaŋin mam airumet naka idwe luka Isirael eyanaario kateker adiopet ainakinio aceteker: naarai idonete idwe luka Isirael ŋinituŋanan airumet naka ateker naka lukapapake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.7",
            "verseOrgIds": [
              "NUM.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.22"
              },
              "items": [
                {
                  "text": "1 Siit 23:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido ninipese naejai airumet kotoma ateker kere naka idwe luka Isirael, edukokini lokokek loka ateker naka papake, tetere irumete idwe luka Isirael ŋinitunanan airumet naka lukapapake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.8",
            "verseOrgIds": [
              "NUM.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaŋin mam airumet eyanaario kateker adiopet ainakinio aceteker; naarai idonete atekerin nuka idwe luka Isirael ŋinidiopet airumeteke.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        }
      ]
    },
