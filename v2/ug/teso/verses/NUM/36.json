              },
              "items": [
                {
                  "text": "Mar 26:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikunyut ikapolok luka ikalia luka lukapapa luka ekek loka idwe luka Gilead, okoku loka Makir, okoku loka Manase, luka ikalia luka odwe luka Yosep, kinerata kakonyen nuka Musa ka ikapolok, kes ikapolok luka ikalia luka lukapapa luka idwe luka Isirael: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.1",
            "verseOrgIds": [
              "NUM.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.1"
              },
              "items": [
                {
                  "text": "Mar 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.55"
              },
              "items": [
                {
                  "text": "26:55",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.54"
              },
              "items": [
                {
                  "text": "33:54",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.3"
              },
              "items": [
                {
                  "text": "Yos 17:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobalas ebe, “Abu EJAKAIT kicorak ekajakait ainakin idwe luka Isirael akwap araun airumet kailamilam eroet: kicorak da EJAKAIT ekajakait ainakin airumet naka onacekosi Selopekad adweke. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.2",
            "verseOrgIds": [
              "NUM.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai kemanyata odwe luka atekerin ace nuka idwe luka Isirael kes, elemario do airumetekee kairumet naka Iukapapakosi, imorikikinio airumet naka ateker naemanyario kes: kwaŋin elemario do koroet loka airumetekosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.3",
            "verseOrgIds": [
              "NUM.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.10"
              },
              "items": [
                {
                  "text": "Leb 25:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kedol ekaru loka eyubili loka idwe luka Isirael, ŋes do imorikikinere airumetekee kairumet naka ateker naemanyario kes: kwaŋin elemario do airumetekec kairumet naka ateker naka lukapapakosi.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.4",
            "verseOrgIds": [
              "NUM.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
