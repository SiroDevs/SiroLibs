        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwape kieorakinia EJAKAIT Musa, kiswamata adwe nuka Selopekad kwaŋin: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.10",
            "verseOrgIds": [
              "NUM.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.1"
              },
              "items": [
                {
                  "text": "Mar 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai apotu Mala, ka Tirusa, ka Kogila, ka Milika, ka Noa, adwe nuka Selopekad, kodukonokinos odwe luka iinaean luka papakec. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.11",
            "verseOrgIds": [
              "NUM.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu kodukonokinos okekia luka odwe luka Manase okoku loka Yosep, kosalak airumetekec ateker naka ekek loka papakec.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.12",
            "verseOrgIds": [
              "NUM.36.12"
            ]
          }
        }
      ]
