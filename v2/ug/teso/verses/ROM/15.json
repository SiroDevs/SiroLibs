              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun ŋes ketikokinitere irwan ipu kenyek abunore mamakus, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
