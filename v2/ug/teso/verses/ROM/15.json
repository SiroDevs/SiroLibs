      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibusakinit oni lukagogoŋok aibwok akalanyanut naka luemamei agogoŋ, kwabo mere aisiyalamikina bonik. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.1",
            "verseOrgIds": [
              "ROM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.19"
              },
              "items": [
                {
                  "text": "1 Kor 9:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.24"
              },
              "items": [
                {
                  "text": "10:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kesiyalamikisi oni ŋinituŋanan ikeidunyet kodum ajokis kodukoi da. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.2",
            "verseOrgIds": [
              "ROM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Sab 69:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai Kristo da mam esiyalamikina elopet bon; dimarai kwape iwadikatere ebe, “Amorosito nuka lukimoromoroete jo, apotu kadoikis eoŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.3",
            "verseOrgIds": [
              "ROM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.23"
              },
              "items": [
                {
                  "text": "Rom 4:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.11"
              },
              "items": [
                {
                  "text": "1 Kor 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai nuewadikatai sek, ewadikatai kanuka aisisianakinia oni, tetere kanuka atitiŋikin ka aitalakara naka nukiwadikatai kidumuni amun. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.4",
            "verseOrgIds": [
              "ROM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.16"
              },
              "items": [
                {
                  "text": "Pil 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Edeke da loka atitiŋikin ka aitalakara koinak yes aomit adiopet bonik ka bonik koidicane loka Kristo Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.5",
            "verseOrgIds": [
              "ROM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "tetere itopoloorete Edeke Papa da loka Ejakaitiwok Yesu Kristo, ketau ediopet ka eporoto da ediopet.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka ŋun, kisukunyanakinos bonik ka bonik, kwape kiisukunyikinia Kristo oni, tetere itopoloorio Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.7",
            "verseOrgIds": [
              "ROM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.24"
              },
              "items": [
                {
                  "text": "Mat 15:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "Asw 3:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kalimokini ebe araun Kristo ebulesit loka aitutuket naka akepio kanuka abeit naka Edeke, tetere itogogoŋi aisumuneta nuka lukapapaakosi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.8",
            "verseOrgIds": [
              "ROM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.22.50"
              },
              "items": [
                {
                  "text": "2 Sam 22:50",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.18.49"
              },
              "items": [
                {
                  "text": "Sab 18:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.30"
              },
              "items": [
                {
                  "text": "Rom 11:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bobo da tetere Imo itopoloorete Edeke kanuka akeitim, Kwape iwadikatere ebe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.13",
            "verseOrgIds": [
              "ROM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikainacan, etogogoŋit eoŋ elopet kanukus ebe ileleba yes da ajokis, isilelebitai acoa kere, bobo da ipedorete aikwenyanar bonik ka bonik. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.14",
            "verseOrgIds": [
              "ROM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.5"
              },
              "items": [
                {
                  "text": "Rom 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.3"
              },
              "items": [
                {
                  "text": "12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kewadikakinit yes katitiŋ naepol katutubeta ace, aisiitun, kanuka asianut nakainakinit Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.15",
            "verseOrgIds": [
              "ROM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.13"
              },
              "items": [
                {
                  "text": "Rom 11:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.17"
              },
              "items": [
                {
                  "text": "Pil 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " tetere araun ebulesit loka Kristo Yesu mama ejaas atekerin, keswamak Akiro Nukajokak nuka Edeke aswam naka esasedoti, tetere eraunete atekerin asubanit naecamunitai, naitalaunit Emoyo Lokalaunan, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.16",
            "verseOrgIds": [
              "ROM.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso ejai akirot naaolobobotor kotoma Kristo Yesu kakonyen nuka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.17",
            "verseOrgIds": [
              "ROM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.5"
              },
              "items": [
                {
                  "text": "2 Kor 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam atitiŋikini einer akirot namam Kristo iswamat kotomakaŋ, tetere erimarete atekerin, kanuka akirot arai aswamisioit, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.18",
            "verseOrgIds": [
              "ROM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.17"
              },
              "items": [
                {
                  "text": "Mk 16:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kotoma apedor naka aanyuneta ka nukaumokin, kotoma apedor naka Emoyo Lokalaunan, kwaŋin ameun ka Yerusalem, kiton da airiamar Iliriko etodol alimonokin Akiro Nukajokak nuka Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.19",
            "verseOrgIds": [
              "ROM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.15"
              },
              "items": [
                {
                  "text": "2 Kor 10:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwabo alosikinit alimonokin Akiro Nukajokak, mere neelimoritere ekiror loka Kristo, kenyek adukokin apetetait naka icetuŋanan, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.20",
            "verseOrgIds": [
              "ROM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
