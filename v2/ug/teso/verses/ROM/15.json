                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye kwape iwadikatere ebe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        }
