        },
        {
          "text": "ebe ketajari kama ejaas lukepali kotoma Yudaya, bobo da akaijaanakin nakijaar ŋina Yerusalem korau naisiyalamikinit lukalaunak; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
