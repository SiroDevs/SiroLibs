                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kanuka asianut nakainakinitai alimokini ŋinituŋanan kayesi ebe siriwomiara adepar naibusakinit aomit, konye koomito kacoit, kwape ekorakinitor Edeke aitemis naka aiyuun. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.3",
            "verseOrgIds": [
              "ROM.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 12:4"
          },
          "items": [
