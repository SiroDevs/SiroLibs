              },
              "items": [
                {
                  "text": "1 Kor 12:4-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso naarai kija kainakineta nuegelegela kwape ejaar asianut nakiinakinitai, ketwasamata kes; arai adwaranut, kwape ejaar aiyuuniwok; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.6",
            "verseOrgIds": [
              "ROM.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
