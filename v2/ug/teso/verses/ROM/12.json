                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.3"
              },
              "items": [
                {
                  "text": "Pil 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotoma amin naka einacane, kominanaros bonik ka bonik; kotoma aibuses kitopoloorite ŋinituŋanan aupake. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.10",
            "verseOrgIds": [
              "ROM.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
