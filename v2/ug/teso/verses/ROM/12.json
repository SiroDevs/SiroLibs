                "loc": "1CO.12.27"
              },
              "items": [
                {
                  "text": "1 Kor 12:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.25"
              },
              "items": [
                {
                  "text": "Pes 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwape kwaŋin oni da lukipu, kirai akuan adiopet kotoma Kristo, ka atutubeta da nuka lucewok bonik ka bonik. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.5",
            "verseOrgIds": [
              "ROM.12.5"
            ]
          }
        },
        {
