                {
                  "text": "Apu 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.25"
              },
              "items": [
                {
                  "text": "Asw 18:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotoma adunyanut sirikalanyaka, kokokito komoyo, kijaanakis Ejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.11",
            "verseOrgIds": [
              "ROM.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 12:12"
          },
          "items": [
