            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwabo sirikiputo nuka ikar kalu, konye kanuka aisiteteunio naka aomisiokus kijulakinos, tetere igimorete nuekoto Edeke, nuejok, ka nuisiyalamikinito, ka nuedolito da.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        }
