                "loc": "1TH.5.17"
              },
              "items": [
                {
                  "text": "1 Ses 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolelakinito amun kotitiŋioto koean, kicebokinito ailip. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.12",
            "verseOrgIds": [
              "ROM.12.12"
            ]
          }
