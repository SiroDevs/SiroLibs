                {
                  "text": "1 Pet 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Itelekarit noi kaŋolipone. Nasodit, naarai isiŋadikinitai Iyudayan akiro nuka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.2",
            "verseOrgIds": [
              "ROM.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.6"
              },
              "items": [
                {
                  "text": "Rom 9:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.29"
              },
              "items": [
                {
                  "text": "11:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.13"
              },
              "items": [
                {
                  "text": "2 Tim 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anyoika bo arai ice kakesi araas lumere lumunon? Amamus amunonutukec itapalauni tope amunonut naka Edeke? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.3",
            "verseOrgIds": [
              "ROM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.51.4"
              },
              "items": [
                {
                  "text": "Sab 51:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.116.11"
              },
              "items": [
                {
                  "text": "116:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Madi akuj! Korai Edeke lokabeit, ŋinituŋanan da ikeŋalan, kwape iwadikatere ebe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.4",
            "verseOrgIds": [
              "ROM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.4",
            "verseOrgIds": [
              "ROM.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai amamus adolitewok iticasi adolit naka Edeke, kenera anu? Ebe Mam Edeke erai loedolit aitican oni kanyunyura? (Enera kopone loka etuŋanan.) ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.5",
            "verseOrgIds": [
              "ROM.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madi akuj! Kanuka ŋun ikonakini ai Edeke etubokini akwapin? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.6",
            "verseOrgIds": [
              "ROM.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai kanuka aiŋalaka iyatanakini abeit naka Edeke aitodiar akeibuses, kanukinyo eriŋa katubokinitere eoŋ kwape ekadiakanaran? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.7",
            "verseOrgIds": [
              "ROM.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.1"
              },
              "items": [
                {
                  "text": "Rom 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kanukinyo mam kibalar ebe, “Keswamata nukaronok tetere epote nukajokak”? kwape kisabanakiniata icetuŋa sio ebe kinera isio kwaŋin, Edolit atubokiniokec.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.8",
            "verseOrgIds": [
              "ROM.3.8"
            ]
          }
        }
      ]
