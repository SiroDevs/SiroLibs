                "loc": "GAL.2.16"
              },
              "items": [
                {
                  "text": "Gal 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ŋes adolit naka Edeke naejai kanuka aiyuun Yesu Kristo, mama ejaas kere luiyuunito. Naarai emamei atiaketait; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.22",
            "verseOrgIds": [
              "ROM.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.19"
              },
              "items": [
                {
                  "text": "Rom 9:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.2"
              },
              "items": [
                {
                  "text": "5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai adiakasi kere, komam edolokinito aibuses naka Edeke, ",
