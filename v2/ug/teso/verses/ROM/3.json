              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.143.2"
              },
              "items": [
                {
                  "text": "Sab 143:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.16"
              },
              "items": [
                {
                  "text": "Gal 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.7"
              },
              "items": [
                {
                  "text": "Rom 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun emamei yenejai akuan yenitojokio araut yenedolit kakonyeneke kanuka aswamisio nuka ikisila, naarai kanuka ikisila ŋes ejenunor adiakar.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.20",
            "verseOrgIds": [
              "ROM.3.20"
            ]
          }
        }
      ]
    },
