        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Rom 1:18–2:24.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Biai bo do? Kijokuka oni aitelekarit ice? Mam cut, nepepec da; naarai kidau aosan Iyudayan ka Iyonanin da kere ebe eyait adiakanar kes, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.9",
            "verseOrgIds": [
              "ROM.3.9"
            ]
          }
        },
        {
