              "items": [
                {
                  "text": "Gal 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kijeni ebe akiro kere nuelimito ikisila, inerasi mama ejaas ŋul lueyaito ikisila, tetere itubutario ŋiniituk, akwap kere da kojau otube loka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.19",
            "verseOrgIds": [
              "ROM.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 3:20"
          },
          "items": [
