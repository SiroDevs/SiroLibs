              "items": [
                {
                  "text": "Rom 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kwana edeleleu adolit naka Edeke komameete ikisila, itejenunitai kokisila ka inabin da, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.21",
            "verseOrgIds": [
              "ROM.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
