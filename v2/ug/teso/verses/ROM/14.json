                  "text": "Tit 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ajeni eoŋ bobo da etogogoŋit noi kotoma Ejakait Yesu ebe emamei ibore yeniketal kotoma oinonoke. Konye ŋin yeneomit ibore araut yeniketal, erai yeniketal kamakeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.14",
            "verseOrgIds": [
              "ROM.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.8.11+1CO.8.12+1CO.8.13"
              },
              "items": [
                {
                  "text": "1 Kor 8:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai arai ekadakinit onacekon kanuka inyamatakon, mam bobo ilosi kwape ejaar amin. Sirikimudia yenabu Kristo kotwanik kanuka inyamatakon. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.15",
            "verseOrgIds": [
              "ROM.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.5"
              },
              "items": [
                {
                  "text": "Tit 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kinyek yenejok kamakus ainyanakinio. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.16",
            "verseOrgIds": [
              "ROM.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.20"
              },
              "items": [
                {
                  "text": "Luk 17:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ajakanut naka Edeke mere ainyam ka aimat, dimarai adolit ka ainapakin ka aiyalama da kOmoyo Lokalaunan; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.17",
            "verseOrgIds": [
              "ROM.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "naarai ŋin yenijaanakini Kristo kotoma akiro kaŋun, isiyalamikinit Edeke, ecamunito da ituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.18",
            "verseOrgIds": [
              "ROM.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 14:19"
          },
          "items": [
