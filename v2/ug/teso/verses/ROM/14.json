            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai iwadikatai ebe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.11",
            "verseOrgIds": [
              "ROM.14.11"
            ]
