              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.18"
              },
              "items": [
                {
                  "text": "Rom 12:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.2"
              },
              "items": [
                {
                  "text": "15:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do katupasi akiro nuka ainapakin ka nuka adukonor bonik ka bonik. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.19",
            "verseOrgIds": [
              "ROM.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sirikimuna aswam naka Edeke kanuka inyamat. Abeit elaete kere, dimarai erono ituŋanan yenenyami kitiguikinia ice; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.20",
            "verseOrgIds": [
              "ROM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.8.13"
              },
              "items": [
                {
                  "text": "1 Kor 8:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ejok ainyein ainyam karaida aimat ebino, karaida aswam akirot kere naitiguikini onacekon, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.21",
            "verseOrgIds": [
              "ROM.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiyuun naijaatar, kojaut kaŋin ijo elopet kakonyen nuka Edeke. Isirereŋitoi ŋin yenimam etubokin ilopet kotoma akirot naceamunit. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.22",
            "verseOrgIds": [
              "ROM.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 14:23"
          },
          "items": [
