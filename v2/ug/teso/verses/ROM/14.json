                "loc": "COL.2.16"
              },
              "items": [
                {
                  "text": "Kol 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinyek yenenyami aimen yenimam enyami, karaida yenimam enyami siriketuboki yenenyami; naarai isukunyikinit Edeke ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.3",
            "verseOrgIds": [
              "ROM.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
