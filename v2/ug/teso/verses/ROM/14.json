              },
              "items": [
                {
                  "text": "Gal 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.10"
              },
              "items": [
                {
                  "text": "1 Ses 5:10",
