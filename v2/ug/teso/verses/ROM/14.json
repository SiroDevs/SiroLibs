            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iŋai bo jo yenitubokini ebulesit loka yenice? Ebwoi ŋesi arai ibirori kama kejakaitike elopet. Eebo, isibwoio naarai epedori Ejakait aisibwo ŋes.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.4",
            "verseOrgIds": [
              "ROM.14.4"
            ]
          }
        }
