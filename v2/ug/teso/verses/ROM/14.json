            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisukunyut yenekalanyana kaiyuun, kwabo mere atubokin abuonokinike. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.1",
            "verseOrgIds": [
              "ROM.14.1"
            ]
          }
