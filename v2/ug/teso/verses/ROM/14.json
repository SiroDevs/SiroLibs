        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.29"
              },
              "items": [
                {
                  "text": "Age 1:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.9.3"
              },
              "items": [
                {
                  "text": "9:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ituŋanan yeniyuunit enyami kere, konye yenekalanyana enyami ikui. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.2",
            "verseOrgIds": [
              "ROM.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 14:3"
          },
          "items": [
