              "items": [
                {
                  "text": "Luk 20:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso arai kijari, kijari kanuka Ejakait, arai kitwaki da, kitwaki kanuka Ejakait. Aso arai kiiari, arai kitwaki da, kirai luka Ejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.8",
            "verseOrgIds": [
              "ROM.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai abu Kristo kotwana kojaru da tetere eraun Ejakait loka lukatwak ka lukajarak da.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.9",
            "verseOrgIds": [
              "ROM.14.9"
            ]
          }
        }
