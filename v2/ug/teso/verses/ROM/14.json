                "loc": "TIT.1.15"
              },
              "items": [
                {
                  "text": "Tit 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye yenebuonokin arai enyami etubokinio aitelekar, naarai mam enyamit kaiyuun; naarai ŋiniswamisioit namam elomuni kaiyuun erai adiakar,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.23",
