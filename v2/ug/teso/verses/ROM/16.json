            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.3"
              },
              "items": [
                {
                  "text": "2 Pet 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai luikote kwaŋin mam ijaanakinete Ejakaitiwok Kristo, dimarai akecekoikes; iŋalaarete itauon luka luemamei akirot kanuka akecekiro nuejijim nuijodijodete. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.18",
            "verseOrgIds": [
              "ROM.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.8"
              },
              "items": [
                {
                  "text": "Rom 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.16"
              },
              "items": [
                {
                  "text": "Mat 10:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.14.20"
              },
              "items": [
                {
                  "text": "1 Kor 14:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai adolok akusirima ituŋa kere. Aso aleli kanukus, konye akoto yes koraas lukacoa kotoma akiro kanuejok, ka luiyapaara kotoma akiro kanueroko. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.19",
            "verseOrgIds": [
              "ROM.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
