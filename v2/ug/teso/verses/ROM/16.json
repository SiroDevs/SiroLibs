          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eturit Poibe kinaciwok kamakus, naerai akejaanakinan naka ekanisa loka Kenekerea, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "tetere isukunyikinete ŋes kotoma Ejakait kwape ibusakinitor lukalaunak, kisigalikis ŋes kotoma akirot kere naipuda kamakus, naarai arau ŋesi akeŋarakinan naka ituŋa luipu, ka eoŋ da elopet.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.2",
            "verseOrgIds": [
              "ROM.16.2"
            ]
          }
        }
      ]
    },
    {
