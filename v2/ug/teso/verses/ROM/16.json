              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.33"
              },
              "items": [
                {
                  "text": "Rom 15:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.15"
              },
              "items": [
                {
                  "text": "Age 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Edeke da loka ainapakin idecideci Satan atipet kwap kakejenekus.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
              "ROM.16.20"
            ]
          }
        }
