            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kapaaran naetubokinia Edeke nukaiyeiyea nuka ituŋa kama ka Yesu Kristo kwape ejaatar Akiro Nukajokak nuketitiŋitai eoŋ.",
          "type": "text",
