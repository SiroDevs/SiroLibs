              "items": [
                {
                  "text": "2 Ses 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kaŋul kalueŋolopaka, luiulakinito abeit, luerimasi amamus adolit, edumunete anyunyura ka adedeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.8",
            "verseOrgIds": [
              "ROM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
