          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo loiwolobobot kotoma okisila, itisili kereka Edeke kanuka apaar kokisila? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.23",
            "verseOrgIds": [
