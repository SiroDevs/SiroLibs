            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai emamei aitiak ituŋa kama ejai Edeke.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.11",
            "verseOrgIds": [
              "ROM.2.11"
            ]
