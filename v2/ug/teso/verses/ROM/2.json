        },
        {
          "text": "Naarai lukediakarete kere komameete ikisila, emudiaros da komameete ikisila, ŋul da kere lukediakarete kojaas kikisila, etubokinio kokisila. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.12",
            "verseOrgIds": [
              "ROM.2.12"
            ]
          }
