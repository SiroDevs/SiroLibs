              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo loibala ebe Siridote, idotei ijo? Jo loisacit aputosia, iŋasi ijo abilai? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.22",
            "verseOrgIds": [
              "ROM.2.22"
            ]
          }
