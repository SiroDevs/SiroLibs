                {
                  "text": "Asw 10:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai naiswamaata Imo luemameete ikisila koinono loka ikisila, karaida emameete ikisila eraas kesi ikulepek ikisila. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.14",
