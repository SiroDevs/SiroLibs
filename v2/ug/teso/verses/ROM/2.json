            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mere ŋul luiirarete ikisila kes eraas ikadolitok kakonyen nuka Edeke, konye ikeswamak ikisila kes luitojokio araut ikadolitok. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.13",
            "verseOrgIds": [
              "ROM.2.13"
            ]
          }
        },
        {
