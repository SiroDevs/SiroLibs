                {
                  "text": "Rom 1:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Itodikinete ebe iwadikatai aswam naka ikisila toma otauonokec itejenikini da etaukec, iwosaete akeceomisio nuepegasi bonik ka bonik, arai bo eiyaros; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.15",
