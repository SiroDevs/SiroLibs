                "loc": "ROM.3.9"
              },
              "items": [
                {
                  "text": "3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ejaunete ican ka aridakinio toma aijar naka ŋinituŋanan yeniswamai nueroko, aisiaun lyudayat, ka Iyonanit da, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.9",
            "verseOrgIds": [
              "ROM.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "konye aibuses ka ayoŋio ka ainapakin mama ejai ŋinituŋanan yeniswamai nuejok, aisiaun Iyudayat, ka Iyonanit da. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.10",
            "verseOrgIds": [
              "ROM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
