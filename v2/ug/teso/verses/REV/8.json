          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "koraun atutubet nakiwuniet naka aŋolol aokot, kotwana atutubet nakiwuniet naka isuban lukejaas toma aŋolol lukejai aijar; komudiarai atutubet nakiwuniet naka atakerin.",
          "type": "text",
