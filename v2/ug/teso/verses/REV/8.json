                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi kaany imalaikan ikanykaarei luebwoenenete kakonyen nuka Edeke, koinakinai kes arupepen akanykaarei.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
