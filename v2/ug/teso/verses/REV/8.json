                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kopurio apuru naka lukisupurununo nepepe kailip naka lukalaunak, kakan naka emalaika, kakonyen nuka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
