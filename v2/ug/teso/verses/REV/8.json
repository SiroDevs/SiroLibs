        },
        {
          "text": " Kobu emalaika ece kobwo koiŋaren ketem, kejai aisupurunet naka esabu; koinakinai ŋes lukisupurununo luipu tetere ibwaikin nepepe kailip naka lukalaunak kere otem loka esabu lokejai kiŋaren keicoloŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
