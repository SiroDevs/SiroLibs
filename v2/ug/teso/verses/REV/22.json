                "loc": "REV.21.25"
              },
              "items": [
                {
                  "text": "Apu 21:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam ejaun bobo akuare; mam ipudasi aica naka atala, ka aica da naka akoloŋ, naarai icaikini kes Ejakait Edeke, irumete kesi ikar ka ikar.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        }
      ]
