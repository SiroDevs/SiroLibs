          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirereŋitoi yenerici akiro nuka adwarasit naka eitabo kalo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
              "REV.22.7"
            ]
          }
        }
