            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kalimok ediopet komakio ebe, “Sirikimony; koany epiko Eŋatuny loka ateker naka Yuda, Aliasit naka Daudi, tetere epedori apukor eitabo ka aipucetake akanykaarei.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        }
