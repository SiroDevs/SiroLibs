            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋul kes lumam emunaara kama ejaas aŋor naarai eraas ibekon; ŋul kes luetupito Imerekek kama elosi kere; ŋul kes lualakunio kotoma otuŋa araut araito nugeet nuka Edeke, ka nuka Imerekek, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.4",
            "verseOrgIds": [
              "REV.14.4"
            ]
          }
