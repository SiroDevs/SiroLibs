                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolomu emalaika ece koyekalu, kiworoi keporoto loepol mama ejai ŋol loiboie kodou, ebe, “Kijuka ecilikiki, kosak, naarai adol apak naka aisak, naarai akoko noi isakan luka akwap.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.15",
            "verseOrgIds": [
              "REV.14.15"
            ]
          }
        },
