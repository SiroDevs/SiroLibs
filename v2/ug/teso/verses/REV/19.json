                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupakis ŋes ajoresio nukotoma akuj, kibwanenito ibalasin lukakwaŋak, konapito ebaputa loejok, loekwaŋ, loelai. ",
          "type": "text",
          "attrs": {
