        {
          "text": " Kosodi losodit alosit, kobukok atanyike toma akwap, koraun edola loerono loetiono kotuŋa luejai emacar loka etiaŋ, luemaete da aputoke, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
