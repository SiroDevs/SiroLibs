                  "text": "Any 7:17-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobukok emalaika lokiareit atanyike toma aŋolol, koraun aokot bala nuka yenikatwan, kotwaka da iboro kere luejarete, lukejaas toma aŋolol. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        },
        {
