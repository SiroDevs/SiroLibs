            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobukok emalaika lokiwuniet atanyike toma ocorin ka atanin nuka akipi, koraunos aokot. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
