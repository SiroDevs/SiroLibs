            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aponi koinakinai etiaŋ aituk nainera akiro nuepolok ka nuka ainyanakin, aponi koinakinai da apolou aswam ilapio akaisaoŋon ka luarei. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.5",
            "verseOrgIds": [
              "REV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kooŋ da akeituk ainyanakin Edeke, ainyanakin ekekiror, ka ewemake, kes luiboiete kotoma akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.6",
            "verseOrgIds": [
              "REV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.21"
              },
              "items": [
                {
                  "text": "Dan 7:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.7"
              },
              "items": [
                {
                  "text": "Apu 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aponi koinakinai ŋes ejie ka lukalaunak, ka aipikor kes, koinakinai da apolou kama kaŋiniteker, ka ituŋa, ka aŋajep, ka ajena da. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.7",
            "verseOrgIds": [
              "REV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
