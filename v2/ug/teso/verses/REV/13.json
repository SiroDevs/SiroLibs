            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi kaany etiaŋ ece elomuni kotoma akwap; ejaas amumwara aarei nueputosi bala imerekek, kinera kwape apiu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.11",
            "verseOrgIds": [
              "REV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
