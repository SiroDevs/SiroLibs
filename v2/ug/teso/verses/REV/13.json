            "number": "12",
            "style": "v",
            "sid": "REV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitwasam apolou kere naka etiaŋ losodit kakonyeneke. Koinak akwap ka luiboiete kotoma aima etiaŋ losodit, loaŋaleuni aŋoleke naka atwanare. ",
          "type": "text",
          "attrs": {
