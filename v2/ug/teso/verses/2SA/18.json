              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kokut Yoab arupepe, koboŋut ituŋa kama kerukitotor Isirael naarai kitikok Yoab ituŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.16",
