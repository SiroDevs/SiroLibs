                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.19.13"
              },
              "items": [
                {
                  "text": "19:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kiturur noi ekabaka, kodoka togo loejai orute, komony akiyo: napelosi kinera kwanata, ebe, “Wu ikakoku Abisalom, ikakoku, ikakoku Abisalom! Karai gwai eoŋ atwanit kojari ijo, wu Abisalom, ikakoku, ikakoku!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.18.33"
            ]
          }
        }
