              "items": [
                {
                  "text": "Isa 31:6-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiboie Daudi kokidiŋ orutei iarei; kodoka eketeon kuju orute loka abwas, kiteluo koŋoleŋol, ido koany, ekeruni etuŋanan bon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.24",
            "verseOrgIds": [
              "2SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiworok eketeon kolimok ekabaka. Kobala ekabaka ebe, “Arai erai ediopet, eyaunit akiro.” Kodiŋirir akerun; koeku die. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi koany eketeon ecetuŋanan loekeruni: konyarau eketeon ekedaran erute, kobala ebe, “Koany, ecetuŋanan loekeruni bon.” Kobala ekabaka ebe, “Eyaunit ŋesi da akiro.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.42"
              },
              "items": [
                {
                  "text": "1 Ika 1:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema eketeon atiar, “Aomit eoŋ akerit naka ŋol kaloiŋarenit esubit bala akerit naka Akimaas, okoku loka Sadok.” Kobala ekabaka ebe, “Erai etuŋanan lokajokan, eyaunit akiro nukajokak.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        }
      ]
