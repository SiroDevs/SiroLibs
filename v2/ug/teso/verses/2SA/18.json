                "loc": "JOS.17.15"
              },
              "items": [
                {
                  "text": "Yos 17:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete kolomasi ituŋa ais ejie ka Isirael; kojau ejie amagoro naka Epuraim. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.6",
            "verseOrgIds": [
              "2SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.11.21"
              },
              "items": [
                {
                  "text": "Awa 11:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kipikoroi kaŋina ituŋa luka Isirael kakonyen nuka ikejaanakinak luka Daudi, kojau aario naepol kapaaran kaŋin naka ituŋa ilukumin akwat aarei. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.7",
            "verseOrgIds": [
              "2SA.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kaŋina abu ejie kisiarakin akwap kere: koar amagoro ituŋa luipu kapaaran kaŋin aitelekarit lukeari ekileŋ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        }
      ]
    },
