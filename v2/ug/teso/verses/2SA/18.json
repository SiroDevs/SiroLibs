              "items": [
                {
                  "text": "Sab 49:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido eroko Abisalom ejari abu kolem epir lokejai aditot naka ekabaka kosipok: naarai enera atiar, “Emamei eoŋ ikoku yeniitununere ekakiror.” Komaik epir ekekiror: ido enyaritai aiitunet naka Abisalom kiton lolo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.18",
            "verseOrgIds": [
              "2SA.18.18"
            ]
          }
        }
