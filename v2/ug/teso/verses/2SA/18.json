                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Akimaas okoku loka Sadok, kobala ebe, “Mere kaker kwape kwana, kaina ekabaka akiro, kwape abu EJAKAIT kitokokolikinio ŋes lukasurupoke.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobala Yoab ebe, “Mam iyaŋaari akiro lolo, konye iyaŋaari acepaaran; konye lolo mam iyaŋaari akiro, naarai atwana okoku loka ekabaka,” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.20",
            "verseOrgIds": [
              "2SA.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kobala Yoab Ekusit ebe, “Kolot kolimok ekabaka akiro nuiany ijo.” Kokukokin Ekusit Yoab, kopaari akerit. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.21",
            "verseOrgIds": [
              "2SA.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Akimaas, okoku loka Sadok, kobala bobo Yoab ebe, “Mam akiro, kisiikinai kaker eoŋ da katupa Ekusit.” Kobala Yoab ebe, “Ikakoku, kanukinyo ikotor ijo akerit, naarai mam ibore yenidumuni kaŋina?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema ŋes atiar, “Mam akiro, akeri eoŋ.” Kobala ŋes ebe, “Koker bo.” Kosodi koker Akimaas, kitor Apuuton, kilany Ekusit.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
