            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyaŋaasi Abisalom, kocakakis aipany nakepol kamagoro, kotukokis kujuke atukot naepol noi naka amor: kosodete kokera luka Isirael kere, ŋinituŋanan owemake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.17",
            "verseOrgIds": [
              "2SA.18.17"
            ]
          }
        },
