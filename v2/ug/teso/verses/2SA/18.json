                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.55.18"
              },
              "items": [
                {
                  "text": "55:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido koany, kobu Ekusit; kobala Ekusit ebe, “Ainunit ekajakait ekabaka akiro: naarai kitokokolik lolo EJAKAIT ediŋet loka ŋul kere lukinyoikinete jo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobala ekabaka Ekusit ebe, “Ejai etelepat Abisalom ejok?” Koboŋok Ekusit ebe, “Lukasurup luka ekaiakait ekabaka ka ŋul kere lukinyoikinete jo aikonakin aronis, ekonakis kwape ejaar etelepat ŋol.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
