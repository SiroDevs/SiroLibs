                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojaun kwanata ebe, nakelosioto ŋul luadakete asaduku naka EJAKAIT ailameta akanykape, koinak emoŋ ka yenikasiepai. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
