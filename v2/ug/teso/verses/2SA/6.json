            "number": "16",
            "style": "v",
            "sid": "2SA 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojaun kwanata ebe, kelom asaduku naka EJAKAIT ore loka Daudi, koŋolia Mikal akoku naka Saul kadirisa, koany ekabaka Daudi esomanari ikosie kakonyen nuka EJAKAIT; komwan ŋes kotauke. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 6:17"
          },
          "items": [
