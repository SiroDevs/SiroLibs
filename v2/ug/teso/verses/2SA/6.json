              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.1"
              },
              "items": [
                {
                  "text": "1 Siit 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.8"
              },
              "items": [
                {
                  "text": "Sab 132:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.5"
              },
              "items": [
                {
                  "text": "1 Ika 8:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitolomut asaduku naka EJAKAIT, kibwaikis aiboisike, kidiŋ owema loebubukinit Daudi kanukeŋ: koinak Daudi ainakineta nuicweio ka ainakineta nuka ainapakin kakonyen nuka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedau Daudi ainakin ainakinet naicweio ka ainakineta nuka ainapakin, kilipak ituŋa arereŋ kokiror loka EJAKAIT loka ajoresio, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.43"
              },
              "items": [
                {
                  "text": "1 Siit 16:43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokorak ituŋa kere, ŋes ekodet kere loka Isirael, ikiliok ka aŋor da, ŋinituŋanan emugati ka aturosit naka akiriŋ, ka aluŋuret naka imusabibun luaokito. Kwaŋin koloto ituŋa kere ŋinituŋanan togoke.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.19",
            "verseOrgIds": [
              "2SA.6.19"
            ]
          }
        }
      ]
