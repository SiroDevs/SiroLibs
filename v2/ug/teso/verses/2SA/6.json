                  "text": "Isa 61:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosalak asaduku naka EJAKAIT togo loka Obed-edom Egitit ilapio iuni: kisirereŋ EJAKAIT Obed-edom ka eketogo kere.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        }
      ]
