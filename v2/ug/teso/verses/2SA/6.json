            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Daudi aboŋor ailipakin lukokaleke arereŋ, Kolom Mikal akoku naka Saul airiamakin kaŋes, kotema atiar, “Ibus ca lolo ekabaka loka Isirael, loetodiar lolo kakonyen nuka akejaanakinak nuka ikejaanakinakake, kwape itodiaror ediopet kotuŋa luutai komam ileicikinit!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.20",
            "verseOrgIds": [
              "2SA.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
