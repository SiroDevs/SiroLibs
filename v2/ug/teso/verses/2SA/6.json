          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolimokinai ekabaka Daudi ebe, “Esirereŋ EJAKAIT etogo loka Obededom, ka lukejaatar kaŋes kere, kanuka asaduku naka Edeke.” Kolot Daudi koyau asaduku naka Edeke kotogo loka Obed-edom kitoloma ore loka Daudi kaiyalama. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
