        },
        {
          "text": "Kwaŋin koyau Daudi ka ekek kere loka Isirael asaduku naka EJAKAIT, keibwoŋ, ka eporoto loka arupepe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        }
      ]
    },
