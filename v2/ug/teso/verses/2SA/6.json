              "items": [
                {
                  "text": "Luk 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokurianar Daudi EJAKAIT kapaaran kaŋin; kotema atiar, “Ikonakini ai asaduku naka EJAKAIT ebuni mama ajai?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koŋer Daudi alemar asaduku naka EJAKAIT ayaun ore loka Daudi; konye kodaka Daudi ŋes awai togo loka Obed-edom Egitit. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
              "2SA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
