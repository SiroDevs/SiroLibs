                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.33"
              },
              "items": [
                {
                  "text": "1 Ika 1:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Daudi Abisai atiar, “Kwana kiswamakini Seba okoku loka Bikiri oni aronis adepar naeswamakini Abisalom oni: koyaŋa ijo ikejaanakinak luka ejakaitikon korukitor ŋes, kinyek ŋesi adumun ireria luebwaitai, aiku kamawok.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.18"
              },
              "items": [
                {
                  "text": "2 Sam 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.38"
              },
              "items": [
                {
                  "text": "1 Ika 1:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolomasi ituŋa luka Yoab ka Ikeretin ka Ipeletin ka ituŋa kere lukirigin atupit ŋes; kolomasi koYerusalem, arukoria Seba okoku loka Bikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.7",
            "verseOrgIds": [
              "2SA.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedoloto kesi amoru naapol naajai Gibeon, kobu Amasa airiamakin kakes. Kiridak Yoab inapen luka ejie luanapit ŋesi, kejai arokoba naaenikinitai aŋabetekeŋ kekileŋ lokejai toma akuraruke; napelosi ŋesi kodoi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.8",
            "verseOrgIds": [
              "2SA.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.49"
