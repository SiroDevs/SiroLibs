                "loc": "1SA.26.6"
              },
              "items": [
                {
                  "text": "1 Sam 26:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.18"
              },
              "items": [
                {
                  "text": "2 Sam 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.18.2"
