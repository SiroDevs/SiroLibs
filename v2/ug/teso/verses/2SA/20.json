            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitelem Adoram esolo; korai Yekosapat okoku loka Akilud ekesiitonokinan. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        },
