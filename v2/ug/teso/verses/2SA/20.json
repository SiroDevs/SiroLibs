                "loc": "2KI.15.29"
              },
              "items": [
                {
                  "text": "2 Ika 15:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.4"
              },
              "items": [
                {
                  "text": "2 Siit 16:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitor ŋesi atekerin kere nuka Isirae! kiton Abel, ka Bet-maaka, ka Iberin kere: kotukonokinos kesi da kibwapito ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.14",
            "verseOrgIds": [
              "2SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.32"
              },
              "items": [
                {
                  "text": "2 Ika 19:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.24"
              },
              "items": [
                {
                  "text": "Yer 32:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.4"
              },
              "items": [
                {
                  "text": "33:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.43"
              },
              "items": [
                {
                  "text": "Luk 19:43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kopotu kirigautu ŋes ka Abel loka Bet-maaka, kitutuoto etut eiduny ka ere koriakas karwatat: apotu ituŋa kere lukejaas kaYoab kitakitakete arwatat atiyaikin. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.15",
            "verseOrgIds": [
              "2SA.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi aberu nakacoa aiworo kore ebe, “Kopuputu, kopuputu; keŋaiŋait, kolimokis Yoab ebe, ‘Kikuny, kenerakinos kajo.’’’ ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.16",
            "verseOrgIds": [
              "2SA.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikunyak ŋes; kotema aberu atiar, “jo ŋes Yoab?” Koboŋok ebe, “Eoŋ lo.” Kosodi ŋin atemar ŋes atiar, “Kopup akiro nuka akejaanakinanikon.” Koboŋok ŋesi ebe, “Apupi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinera ŋesi ebe, “Etapit apeŋo atemar ebe, ‘Abeit iŋisete kesi akiro ka Abel’: kwaŋin kitanaŋete kesi akiro, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.18",
            "verseOrgIds": [
              "2SA.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.26.19"
              },
              "items": [
                {
                  "text": "1 Sam 26:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ajai eoŋ owai kaŋul luinapakina ka lumunon koIsirael: imoot ijo amudiar ere loerai toto koIsirael: kanukinyo ikotor ijo ailikor airumet naka EJAKAIT?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok Yoab ebe, “Madi akuj, madi akuj, eoŋ ailikor arai amudiar. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam akiro ikote nen: abu etuŋanan loka akwap nakiukon naka Epuraim, ekekiror Seba okoku loka Bikiri, kikeu akekan asurokin ekabaka, ŋes Daudi: kijaik ŋes bon, eoŋ da anyouni kore.” Kotema aberu Yoab atiar, “Koany, eeakunio nat akekou mama ijai karwatat.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.7.19"
              },
              "items": [
                {
                  "text": "Lim 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.9.14"
              },
              "items": [
                {
                  "text": "9:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi aberu alosit kacoake mama ejaas ituŋa kere. Kojepasi akou naka Seba okoku loka Bikiri, kocakakis Yoab. Kokut ŋesi arupepe, kisiarakinos anyoun kore, ŋinituŋanan owemake. Koboŋo Yoab Yerusalem mama ejai ekabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        }
      ]
    },
