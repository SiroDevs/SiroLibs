                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyaite Yoab ajore kere naka Isirael: koyaite Benaia okoku loka Yekoiada Ikeretin ka Ipeletin: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
