                "loc": "ISA.28.21"
              },
              "items": [
                {
                  "text": "Isa 28:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobu Daudi Baal-perasim, kodany Daudi kes kanen; kotema atiar, “Acil EJAKAIT lukasurupoka kakonyeneka, kwape eciliata akip.” Ŋes amaikinere aibois ŋin Baal-perasim. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyeis aputosiakec kanen, koyaŋaasi Daudi ka ituŋake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.21",
            "verseOrgIds": [
              "2SA.5.21"
            ]
          }
