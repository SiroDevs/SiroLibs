              },
              "items": [
                {
                  "text": "1 Siit 11:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Daudi kapaaran kaŋin ebe, “Ŋolituŋanan loedanyi Iyebusin, kodoka neeleleete akip, kodany iŋwalasik ka imudukiok lualait etau loka Daudi.” Ŋes etemariata ebe, “Mam imudukiok ka iŋwalasik epedorete alomar togo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.8",
            "verseOrgIds": [
              "2SA.5.8"
            ]
          }
        },
