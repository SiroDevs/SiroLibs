          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lu kes ikiroria luka ŋul kaluaponi kourikinai ŋes koYerusalem; Samua, ka Sobab, ka Natan, ka Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.14",
