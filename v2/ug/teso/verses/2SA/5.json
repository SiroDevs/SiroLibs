          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyatanakin Daudi apoloor; naarai ajai EJAKAIT, Edeke loka ajoresio, kaŋes.",
          "type": "text",
