              "type": "text"
            }
          ]
        },
        {
          "text": " Kerai Daudi loka ikar akaisauni naageunia airum, kirumak ikar akaisaoŋon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
