          ]
        },
        {
          "text": " Kiboikin Daudi ore loebwaitai kagogoŋ, komaik ŋes ere loka Daudi. Koduk Daudi airimor anyoun koMilo kotoma da. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.9",
            "verseOrgIds": [
