              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopotu bobo Ipilisitian, kisiarakinos aditot naka Repaim. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.22",
            "verseOrgIds": [
              "2SA.5.22"
            ]
          }
        },
