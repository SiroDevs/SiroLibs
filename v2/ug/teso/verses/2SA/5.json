          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirum Yuda koKeburon ikar ikanykaarei ka ilapio ikanykape: kirum Isirael kere ka Yuda koYerusalem ikar akaisauni ka luuni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
