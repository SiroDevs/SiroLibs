            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiŋit Daudi EJAKAIT ebe, “Alosi kereka eoŋ aitiji Ipilisitian? Kijaikini ijo kes akanika?” Kotema EJAKAIT Daudi atiar, “Kolot, naarai abeit ejaikini Ipilisitian akanikon.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
