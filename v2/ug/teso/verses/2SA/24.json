              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.13.13"
              },
              "items": [
                {
                  "text": "1 Sam 13:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodusaun Daudi etau kedau aimar ituŋa. Kotema Daudi EJAKAIT atiar, “Adiaka noi kanueswama: konye wu EJAKAIT, keŋaiŋait, kolema numam adolit nuka ekonikejaanakinan; naarai eswama eoŋ nukabaŋaanut naepol.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.10",
            "verseOrgIds": [
              "2SA.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.5"
              },
              "items": [
                {
                  "text": "1 Sam 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.9.9"
              },
              "items": [
                {
                  "text": "9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kenyou Daudi tupuruc, kobu akirot naka EJAKAIT mama ejai cnebi Gad, ekadwaran loka Daudi, ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.11",
            "verseOrgIds": [
              "2SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kolot kolimok Daudi ebe, ‘Inera EJAKAIT kwanata ebe, Kejaik jo akiro auni; koseu ijo adiopet kakesi, tetere keswamakini jo.’’’ ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.12",
            "verseOrgIds": [
              "2SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.12"
              },
              "items": [
                {
                  "text": "1 Siit 21:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobu do Gad mama ejai Daudi, kolimok ŋes, kotema ŋes atiar, “Epote kereka ikar ikanykaarei luka ebeli mamakon kakwapukon? Arai bo ikeri kereka ijo ilapio iuni kakonyen nuka lukasurupokon korukitotor kesi jo? Arai bo ejaun atular apaarasia auni kakwapukon? Aso kiner, koomoom nuaboŋokini eoŋ ŋol lokejukuni.” ",
          "type": "text",
