              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.48"
              },
              "items": [
                {
                  "text": "Mar 16:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Arauna atiar, “Kanukinyo ebunitor ekajakait ekabaka mama ejai ekekejaanakinan?” Kotema Daudi atiar, “Agwelakin kajo epejal, adukokin EJAKAIT etem, tetere enaŋi atular kotuŋa.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 24:22"
          },
          "items": [
