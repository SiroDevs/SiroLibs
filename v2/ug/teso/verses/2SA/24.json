          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolot Daudi kwape ejaar akirot naka Gad, kwape ecorakinia EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.19",
            "verseOrgIds": [
              "2SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiteluo Arauna, koany eka baka ka ikekejaanakinak eponito mama ejai ŋesi: kolom Arauna kokukum kakonyen nuka ekabaka kitulurite akekou. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.20",
            "verseOrgIds": [
              "2SA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 24:21"
          },
          "items": [
