                "loc": "PSA.72.10"
              },
              "items": [
                {
                  "text": "72:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodany Moab, kitirian kaitemis, kiteperik kes kwap; kitirian ikokoron iarei aario, ido kitajar ekokoro ediopet, Koraut Imoabin ikejaanakinak luka Daudi, koyaut ainakineta.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        }
