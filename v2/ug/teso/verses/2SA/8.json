              "items": [
                {
                  "text": "Mik 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.24"
              },
              "items": [
                {
                  "text": "Apu 21:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋul da abu Daudi kotiakak EJAKAIT, nepepe kepuesa ka esabu luatiakenenei luka atekerin kere nuepikori. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luka Suria, ka luka Moab, ka luka idwe luka Amon, ka luka Ipilisitian, ka luka Amalek, ka luŋatuna luka Kadadeser, okoku loka Rekob, ekabaka loka Soba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        }
      ]
    },
