              "items": [
                {
                  "text": "2 Ika 14:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodum Daudi ekiror nakeboŋunia kaidany Isurian kAditot naka Abalaŋ, kes ituŋa ilukumin itomon ka lukanykauni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        },
        {
