              "items": [
                {
                  "text": "145:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kibwaik atukon nuka iserikalen Edom; kibwaik atukon nuka iserikalen anatar Edom kere, koraut Idomein ikejaanakinak luka Daudi. Koinak EJAKAIT Daudi aipikor kama kelosenenei kere.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        }
      ]
    },
