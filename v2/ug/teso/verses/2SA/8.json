          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirum Daudi Isirael kere; kitodolenenei Daudi itubesia ka nuetenito kotuŋake kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.15",
