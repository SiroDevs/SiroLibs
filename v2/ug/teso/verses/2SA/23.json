            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kerai Asakel onaec loka Yoab ediopet kotoma akaisauni; Elanan okoku loka Dodo loka Bet-Iekem; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.24",
