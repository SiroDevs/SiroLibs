            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Benaia Epiratonit, Kidai loka aguurun nuka Gaas; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.30",
            "verseOrgIds": [
              "2SA.23.30"
            ]
          }
        },
        {
