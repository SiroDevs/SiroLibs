              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.11.20"
              },
              "items": [
                {
                  "text": "1 Siit 11:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kerai Ablsai onace loka Yoab, okoku loka Seruia, lokapolon loka luuni, Kodaku ŋesi akwarake asurokin akwat auni, koar kes, kodum ekiror kotoma luuni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.18",
            "verseOrgIds": [
              "2SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam ŋes etopolooritai kouni? Kanuka ŋun kitaraunai ekapolonikee: konye mam abu kodolok luuni lusodit.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.19",
            "verseOrgIds": [
              "2SA.23.19"
            ]
          }
        }
      ]
    },
    {
