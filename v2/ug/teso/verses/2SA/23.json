              },
              "items": [
                {
                  "text": "27:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupite Eleasar okoku loka Dodai okoku loka Ekokait, ediopet kotuŋa iuni lukirigin luka Daudi, nakemwaŋitotor kesi Ipilisitian lukejaas ŋina etukokina ejie, kolosito ituŋa luka Isirael: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.9",
            "verseOrgIds": [
              "2SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyou ŋesi, kodany Ipilisitian aitodol neetegia akekan, kimakakin akekan okileŋ: kijaik EJAKAIT aipikor naepol kapaaran kaŋin; kobonut ituŋa kodumut ebe asal aijoreun bon.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        }
      ]
    },
    {
