              },
              "items": [
                {
                  "text": "1 Siit 11:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupite Sama okoku loka Agee Ekararit. Kotukonokinos Ipilisitian korioŋet, nekejai emanikor loeleleba epone ece loka akima; kokerata ituŋa kaneajaas Ipilisitian. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.11",
            "verseOrgIds": [
              "2SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kobwo ŋol kokidiŋ omanikor, kojiu ŋes, koar Ipilisitian: kijaik EJAKAIT aipikor naepol.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        }
      ]
    },
