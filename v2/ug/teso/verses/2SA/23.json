            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loenyonyoikinit Edeke loka Yakob akinyet,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
