                "loc": "JDG.20.4"
              },
              "items": [
                {
                  "text": "Tub 20:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.24"
              },
              "items": [
                {
                  "text": "1 Sam 10:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijaikinai sio ituŋa ikanykaarei lukodweke, kikajakini isio kes mama ejai EJAKAIT koGibea loka Saul eseuna loka EJAKAIT.” Kotema ekabaka atiar, “Kainakinete yes.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        }
