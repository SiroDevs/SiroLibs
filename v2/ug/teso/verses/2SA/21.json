            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojioto Ipilisitian bobo kaluka Isirael; kolot Daudi ka ikekejaanakinak kaŋes, kitiji Ipilisitian: kilworun Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Isibi-benob, lokerai lokodwe luka ekekososon, alaŋir naka akwarake isekelin akwat auni nuka aisinit, anapit ŋesi ekileŋ lokitetet, koomite ebe eari Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
