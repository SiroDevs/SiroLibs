          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kojau bobo ejie ka Ipilisitian koGob; koar Elanan okoku loka Yaareoregim Ebet-lekemit Goliat Egitit, koputos amorok naka akwarake bala akitoi naesonyere. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 21:20"
          },
          "items": [
