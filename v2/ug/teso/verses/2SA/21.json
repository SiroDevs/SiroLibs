                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, kokau kaŋun, kojau bobo ejie ka Ipilisitian koGob: kosodi Sibekai Ekusatit aiar Sap, lokerai lokodwe luka ekekososon, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
            ]
          }
        },
        {
          "name": "verse",
