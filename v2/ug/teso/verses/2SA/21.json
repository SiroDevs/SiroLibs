              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.25"
              },
              "items": [
                {
                  "text": "2 Sam 24:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konukata akojo nuka Saul ka Yonatan okokuke akwap naka Benyamin koSela, ates naka papake Kis: kiswamata kere nuecorakinit ekabaka, Akaulo kaŋun kiira Edeke aiŋaiŋaikinio naka akwap.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        }
