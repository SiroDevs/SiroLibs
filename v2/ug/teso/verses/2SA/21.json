                "loc": "1CH.20.6"
              },
              "items": [
                {
                  "text": "1 Siit 20:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kojau bobo ejie koGat, kejai kanen etuŋanan lokaojan, lokejaas ibokor ikanykape kaŋinikan, ka ibokor ikanykape kaŋinikeje, emwaasi ibokoroke akaisaarei ka Iuoŋon; ŋol da aurikinio ekekososon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.20",
            "verseOrgIds": [
              "2SA.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakemwaŋitor ŋesi Isirael abu Yonatan okoku loka Simei onace loka Daudi koar ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.21",
            "verseOrgIds": [
              "2SA.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keurikinio ŋul iwoŋon ekekososon koGat; kibiroros kakan naka Daudi kakan da naka ikekejaanakinak.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.22",
            "verseOrgIds": [
              "2SA.21.22"
            ]
          }
        }
