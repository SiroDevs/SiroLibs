            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kideu ekabaka Mepiboset, okoku loka Yonatan, okoku loka Saul, kanuka aiyaposit naka EJAKAIT nakejai kidiŋikec, kidiŋ Daudi ka Yonatan okoku loka Saul, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.19"
              },
              "items": [
                {
                  "text": "1 Sam 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.7"
              },
              "items": [
                {
                  "text": "2 Sam 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye koyaŋa ekabaka odwe iarei luka Risipa akoku naka Aia, luaurikinit ŋesi Saul, Arumoni ka Mepiboset; ka odwe ikany luka Mikal ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:8",
              "type": "text"
            },
            {
              "text": "ti kerai Merab.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akoku naka Saul, luaurikinit ŋesi Aduriel okoku loka Barisilai Emekolatit: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.17"
              },
              "items": [
                {
                  "text": "2 Sam 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijaik kes akanin nuka Igibeonin, kikajakis kes moru kakonyen nuka EJAKAIT, kotwaka kesi lukanykaarei kere: koarai kapaarasia nuka aisak, kapaarasia nusodit, kageunet naka aisak esairi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        }
      ]
