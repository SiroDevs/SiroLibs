        },
        {
          "text": " Kosodi kanen, kiboikin ekabaka togoke, nakisiyeŋunia EJAKAIT ŋes kama ejaas lukasurupoke lualukunito, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.1",
            "verseOrgIds": [
