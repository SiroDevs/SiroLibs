              },
              "items": [
                {
                  "text": "40:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema ekabaka enabi Natan ebe, “Koany, eboie eoŋ kotogo loka ikito luka eres, konye iboie asaduku naka Edeke kotoma aigalisio.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.2",
            "verseOrgIds": [
              "2SA.7.2"
            ]
          }
        },
        {
