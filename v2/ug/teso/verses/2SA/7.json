              },
              "items": [
                {
                  "text": "Isa 45:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋes ipoloor ijo, wu EJAKAIT Edeke: naarai emamei yeneputos kajo, emamei da Edeke ece dimarai ijo, kwape kejaatar kere nukipou keirasi kakosiki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.22",
            "verseOrgIds": [
              "2SA.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
