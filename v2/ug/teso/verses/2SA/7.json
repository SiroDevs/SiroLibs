          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.36+PSA.89.37"
              },
              "items": [
                {
                  "text": "Sab 89:36-37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.34"
              },
              "items": [
                {
                  "text": "Yok 12:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Itogogoŋio ekekikon ka ajakanutukon ikar kere kakonyenekon: iticasio eicoloŋokon loka ajakanut ikar kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.16",
            "verseOrgIds": [
              "2SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwape ejaatar akiro ŋun kere, kwape ejaar aitapoet ŋin kere, kolimok Natan Daudi kwaŋin.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.17",
            "verseOrgIds": [
              "2SA.7.17"
            ]
          }
        }
