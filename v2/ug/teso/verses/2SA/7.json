            }
          ]
        },
        {
          "text": " Kedoloto apaarasiakon, ijotori kalukapapaakon, adakakini aurikon naetupakini, naelomuni kakoikikon, eticasi da ajakanutuke. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.12",
            "verseOrgIds": [
              "2SA.7.12"
            ]
          }
        },
