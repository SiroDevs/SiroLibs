          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.11"
              },
              "items": [
                {
                  "text": "2 Sam 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.1"
              },
              "items": [
                {
                  "text": "Any 26:1",
