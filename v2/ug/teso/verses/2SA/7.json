            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.7"
              },
              "items": [
                {
                  "text": "1 Siit 22:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.2"
              },
              "items": [
                {
                  "text": "28:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Natan ekabaka atiar, “Kolot, kiswama kere nuejaas otaukon; naarai ejai EJAKAIT kajo.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.3",
            "verseOrgIds": [
              "2SA.7.3"
            ]
