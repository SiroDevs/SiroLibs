              "items": [
                {
                  "text": "33:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.147.20"
              },
              "items": [
                {
                  "text": "Sab 147:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.10"
              },
              "items": [
                {
                  "text": "Nek 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ani bo ateker adio kakwap naeputos kikonituŋa, kes Isirael, luabu Edeke kolot alakun kanuke araun iketuŋa, adumakin ŋes ekiror, ka aswam nukos kanukus, kakiro nusogim kanuka akonikwap, kakonyen nuka ituŋakon luibu kolaku koMisiri kanukon, katekerin kodekesiokec da? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.23",
            "verseOrgIds": [
              "2SA.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.18"
              },
              "items": [
                {
                  "text": "Ikis 26:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ibu kitieat kanukon ikonituŋa Isirael araun ituŋakon ikar kere; ka jo da EJAKAIT, ibu koraun Edekekec. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.24",
            "verseOrgIds": [
              "2SA.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wu EJAKAIT Edeke akirot naibu kolim naka ekonikejaanakinan ka ekekike, kitogogoŋ ijo ŋes ikar kere, kiswama kwape kilimokinia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.19"
              },
              "items": [
                {
                  "text": "Sab 72:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.9"
              },
              "items": [
                {
                  "text": "Mat 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitopolooroi ekonikiror ikar kere ebe, ‘EJAKAIT loka ajoresio ŋes Edeke loka Isirael’: iticasio ekek loka ekonikejaanakinan Daudi kakonyenekon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ijo, ‘wu EJAKAIT loka ajoresio, Edeke loka Isirael, ipukokinit ekonikejaanakinan ebe, ‘Adukokini jo ekek’: kanuka ŋun etitiŋior ekonikejaanakinan kotauke ailip ailipasit na mama ijai. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.17"
              },
              "items": [
                {
                  "text": "Yok 17:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wu EJAKAIT Edeke, irai ijo Edeke, akonikiro da eraas nukabeit, isumunik ekonikejaanakinan akirot ŋin naejok: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
