          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, kakuare kaŋin, kobu akirot naka EJAKAIT mama ejai Natan ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.4",
            "verseOrgIds": [
              "2SA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kolot kolimok Daudi ekakejaanakinan ebe, ‘Inera EJAKAIT kwanata ebe, Idukokini kereka ijo eoŋ etogo loeboieneno? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.5",
            "verseOrgIds": [
              "2SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.16"
              },
              "items": [
                {
                  "text": "1 Ika 8:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam eoŋ eboikino togo ageun kapaaran naetolomunia idwe luka Isirael koMisiri, kiton lolo, konye alosenenei kowema, kowema lokalaunan da. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.6",
            "verseOrgIds": [
              "2SA.7.6"
            ]
          }
        },
        {
