                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aseikini ikatuŋa Isirael aibois, eraikini kes, tetere iboiete aiboisikec, komam bobo itwobosete; komam bobo idwe luka aronis iticanete kes, kwape lem sek. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.10",
            "verseOrgIds": [
              "2SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwape kapaaran naecorakinia eoŋ ikatubok ayait ikatuŋa Isirael; esiyeŋuni jo kama ejaas lukasurupokon kere, Bobo da kilimokini EJAKAIT jo ebe kisubakini EJAKAIT jo ekek. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        },
