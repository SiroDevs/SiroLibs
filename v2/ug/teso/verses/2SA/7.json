              "items": [
                {
                  "text": "Age 32:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Daudi ekabaka alomar, kiboikin kakonyen nuka EJAKAIT; kotema atiar, “Eoŋ iŋai, wu EJAKAIT Edeke, ekakek da inyo, ijo aitodolun eoŋ kiton kwana? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
