                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.52"
              },
              "items": [
                {
                  "text": "Luk 1:52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ajaenena kajo kama ilosenenei kere, amudia lukasurupokon kere kakonyenekon; etuluori jo ekiror lokapolon, kwape ekiror loka lukapolok kaluejaas kakwap. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.9",
            "verseOrgIds": [
              "2SA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 7:10"
