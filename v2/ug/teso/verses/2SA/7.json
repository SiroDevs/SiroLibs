            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.4"
              },
              "items": [
                {
                  "text": "Sab 89:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋol ŋes edukokini ekakiror etogo, eticasi eoŋ eicoloŋ loka ajakanutuke ikar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.13",
            "verseOrgIds": [
              "2SA.7.13"
            ]
