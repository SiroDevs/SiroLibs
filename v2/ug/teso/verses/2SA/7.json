              },
              "items": [
                {
                  "text": "1 Sam 15:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye mam akaitim enyouni kamake, kwape kalemaria kaneejai Saul, loabu kalema kakonyenekon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.15",
            "verseOrgIds": [
              "2SA.7.15"
            ]
          }
        },
        {
