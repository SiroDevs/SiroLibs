          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, kedaut alosit, kodokut kesi katan, koloto kolimokis ekabaka Daudi; kotemasi kesi Daudi atiar, “Konyoutu, kiwonyasi kotuboros kakipi: naarai eneru Akitopel kwana aluikin yes.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.21",
            "verseOrgIds": [
              "2SA.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
