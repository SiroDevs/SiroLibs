              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Daudi abunore Makanaim. Kotubor Abisalom ko Yorodan, ŋes ka ituŋa kere luka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.24",
