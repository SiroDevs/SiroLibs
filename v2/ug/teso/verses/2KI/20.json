              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, eroko Isaia elomuna alosit kidlŋ ore, kobu akirot naka EJAKAIT mama ejai ŋesi ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.4",
            "verseOrgIds": [
