            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.12",
            "verseOrgIds": [
              "2KI.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopupok Kesekia kes, kitodik kes etogo kere loka iboroke luka akais nuipu, epuesa, ka esabu, ka lueuru maa, ka akinyet naka akais nuipu, ka etogo loka luiiisike, ka luadumuna koboroke luka akais nuipu: amamei ibore kotogoke karaida ayaetake kere, yenimam Kesekia etodikinit kes, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.13",
            "verseOrgIds": [
              "2KI.20.13"
            ]
          }
        },
        {
