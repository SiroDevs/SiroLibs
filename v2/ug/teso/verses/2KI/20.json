            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kobono, kolimok Kesekia ekapolon loka ikatuŋa ebe, ‘Inera kwanata EJAKAIT, Edeke loka Daudi papaakon ebe, Eira ailipikon, aany akonikiyo: koany, ketanaleuni jo: apaaran nakiwuniet ŋes idokaria togo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
