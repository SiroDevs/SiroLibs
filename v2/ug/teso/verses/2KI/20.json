              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapaarasia kanun kijukak Berodak-baladan okoku loka Baladan, ekabaka loko Babulon, Kesekia ibaluan ka ainakinet: naarai apupunit kwape adekar Kesekia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.12",
            "verseOrgIds": [
              "2KI.20.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
