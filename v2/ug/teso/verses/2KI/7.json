              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyout nape imuki alosit oidukurun luka Isurian: kedoloto ariri naka iidukurun luka lsurian, koany, kemamei ediotuŋanan. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.5",
            "verseOrgIds": [
              "2KI.7.5"
            ]
          }
        },
        {
          "name": "verse",
