                "loc": "PRO.11.19"
              },
              "items": [
                {
                  "text": "Awa 11:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.8.13"
              },
              "items": [
                {
                  "text": "Lim 8:13",
