            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋok Eliya ekapolon loka akaisakany ebe, “Arai arai eoŋ etuŋanan loka Edeke, kobu akim kokuju, kiewe jo ka akaisakanyikon.” Kobu akim kokuju, kiewe ŋes ka akaisakanyike.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        }
