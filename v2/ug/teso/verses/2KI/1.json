              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema emalaika loka EJAKAIT Eliya atiar, “Kikokoror kaŋes; sirikikurianar ŋes.” Konyou, kikokoror kaŋes mama ejai ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
