              "items": [
                {
                  "text": "Isa 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.23"
              },
              "items": [
                {
                  "text": "Rom 6:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.15"
              },
              "items": [
                {
                  "text": "Yak 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emamei kereka Edeke kotoma Isirael, tape ilosete aiŋitun kama ejai Baal-sebub edeke loka Ekuron?’ ‘Aso do inera EJAKAIT kwanata ebe, ‘Mam inyouni koitada loidokikinit, konye abeit itwani.’” Konyouni do Eliya,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 1:4"
