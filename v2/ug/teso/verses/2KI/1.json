        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.19"
              },
              "items": [
                {
                  "text": "Isa 8:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.10+JER.2.11+JER.2.12+JER.2.13"
              },
              "items": [
                {
                  "text": "Yer 2:10-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.8"
              },
              "items": [
                {
                  "text": "Yok 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kotema emalaika loka EJAKAIT Eliya Etisibit atiar, “Konyou, kolot kiriamakinos kikiyakia luka ekabaka loka Samaria, kotema kes atiar, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
