              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen kapaaran naatupakini, kolem eimukis, kidomak akipi, korapak akonyeneke, kotwana: kirum Kasael aiboisike.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.15",
