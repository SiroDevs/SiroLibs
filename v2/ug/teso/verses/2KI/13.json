            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojotoor Yoas kalukapapaake; kiboikin Yeroboam oicoloŋoke: aponi kidaikinai Yoas Samaria nepepe kikabakan luka Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        }
      ]
