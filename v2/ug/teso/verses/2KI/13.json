          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Koinak EJAKAIT Isirael eketajaran, konyout kakanin nuka Isurian: kiboikinos idwe luka Isirael oreriakee, kwape lem sek. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5",
