              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aswamisio ace nuka Yoas, ka nuabu kiswama kere, mam kereka iwadikatai oitabo loka aisiitonokin nuka ikabakan luka Yuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.19",
            "verseOrgIds": [
              "2KI.12.19"
            ]
          }
        },
