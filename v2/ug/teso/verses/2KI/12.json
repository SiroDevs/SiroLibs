              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Kasael ekabaka loka Suria alosit, kitiji Gat, kirum; kireo Kasael akekonye alosit Yerusalem. ",
          "type": "text",
          "attrs": {
