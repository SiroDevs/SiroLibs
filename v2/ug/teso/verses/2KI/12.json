          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyout ike’: jaanakinakake, kinerut, koarakis Yoas togo loka Milo, orot loebei Sila. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.20",
            "verseOrgIds": [
              "2KI.12.20"
            ]
          }
        },
        {
