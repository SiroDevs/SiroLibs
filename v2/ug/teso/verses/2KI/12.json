            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Yekoas isasedotin atiar, “Apesan kere nuka iboro lukalaunak nueyaunio togo loka EJAKAIT, apesan nuetwasamaenenete kapakio kanun, apesan nuka iruna kwape itiriania etiai loka ŋinitunanan, ka apesan nuekot etau loka ituŋanan ayaun togo loka EJAKAIT, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.4"
              },
              "items": [
                {
                  "text": "2 Ika 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.13"
              },
              "items": [
                {
                  "text": "Any 30:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.2"
              },
              "items": [
                {
                  "text": "Leb 27:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.35.5"
              },
              "items": [
                {
                  "text": "Any 35:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.9"
              },
              "items": [
                {
                  "text": "1 Siit 29:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijaununut isasedotin, ninitunanan kiiauni yeneieni ŋesi: kipueiata acilan nuka etogo, needumunere acilat kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.5",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kokaru loka akaisaarei ka luuni loka ekabaka Yekoas korina isasedotin ipuca acilan nuka etogo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.6",
            "verseOrgIds": [
              "2KI.12.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.5"
              },
              "items": [
                {
                  "text": "2 Siit 24:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.6",
            "verseOrgIds": [
              "2KI.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi ekabaka Yekoas anyaraun Yekoiada esasedoti, ka isasedotin ice, kotema kes atiar, “Inyo bo mam ipucanariata acilan nuka etogo? Aso do mam bobo ijaununete apesan kama kaluiienete, konye koinakis nun nuitukokinito kanuka acilan nuka etogo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.7",
            "verseOrgIds": [
              "2KI.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kocamut isasedotin ebe mam bobo iiaunete apesan kotuna, karaida aipucanar acilan nuka etogo,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye koyoŋa Yekoiada esasedoti asaduku, koped apedot toma arapetait, kibwaik eiduny ketem, kosiep lokoteten ilomari togo loka EJAKAIT: kosodete isasedotin luedarenenete ekek kibwaanakis apesan kere nuayaununio togo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.1"
              },
              "items": [
                {
                  "text": "Luk 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete keanyut ebe ejaas apesan nuipu toma asaduku, kopotu ekewadikan loka ekabaka ka esasedoti lopeti, koenata kimarata da apesan nuadumuna kotogo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.10",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijaikis apesan nuetemio akanin nuka nul kalueswamaete aswam, luapolokinito etogo loka EJAKAIT: koropiata ikekeok ka ikadukok lueswamaete aswam naka etogo loka EJAKAIT; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka lukadukok kamor, ka lukekeok amor, agwelia da akito ka amor nuikee aipueanaria acilan nuka etogo loka EJAKAIT, ka nuepudasi kere aiteteunia etogo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye mam aponi kiswamakinere etogo loka EJAKAIT akolin nuka epuesa, ka aitudeŋeta, ka atanya, ka arupepen, iboro kere luka esabu, arai iboro kere luka epuesa, kapesan nuetolomunio togo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai aponi koinakinai nun lueswamaete aswam, lueteteunete etogo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.14",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo da mam apotu kimarata etiai mama ejaas ituŋa luainakinio apesan akoranakin ikeswamak: naarai keraas lumunon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.15",
            "verseOrgIds": [
              "2KI.12.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
