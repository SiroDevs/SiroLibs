                  "text": "Ikis 25:5-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rusi da Amoabut apuserut naka Malon agwel eoŋ araun aberuka, aitoboŋikin airumeteke ekiror loka lokatwan, kinyek ekiror loka lokatwan aolior koinacanake, korute da loka aiboisitike: iraas yesi lolo ikajenak.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.10",
            "verseOrgIds": [
              "RUT.4.10"
            ]
          }
        },
