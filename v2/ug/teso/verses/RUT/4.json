          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Boas imakio ka ituŋa kere da ebe, “Iraas ikajenak lolo, agwel eoŋ lukolo araas luka Elimelek kere, ka luaraas luka Kilion ka luka Malon da, kakan naka Naomi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.9",
            "verseOrgIds": [
              "RUT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
