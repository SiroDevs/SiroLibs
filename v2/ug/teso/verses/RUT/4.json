              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi ekalakunan ŋol atemar Boas ebe, “Kogwel do ijo.” Kolac amukatake. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.8",
            "verseOrgIds": [
