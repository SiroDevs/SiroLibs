                  "text": "1 Sam 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eraun ŋesi da kamakon eketeteunan aiiar, ido eketanan kamojoŋukon; naarai ateranikon, nakimina ijo, naitelekarit idwe ikanykaarei lusap kajokis kamakon, ŋes auru ŋes.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.15",
            "verseOrgIds": [
              "RUT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Naomi ayaŋaar ikoku, kotunak atorobuke, koraun akasaanike. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
