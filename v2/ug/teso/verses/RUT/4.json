            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobalas aŋor Naomi ebe, “Kituritete EJAKAIT, lomam kinyeinit jo lolo emamei ekalakunan, kojenun du ekirorike kolsirael. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.14",
            "verseOrgIds": [
