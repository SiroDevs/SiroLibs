                  "text": "Mat 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi konyet ŋesi anyoun ka aterakake, aboŋor anyoun kakwap naka Moab; naarai abu kiira kakwap naka Moab ebe abu EJAKAIT koanyanar iketuŋa ainakin kes inyamat, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.6",
            "verseOrgIds": [
              "RUT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyou kaibois kanaeboienenoo, ka aterakake aarei nepepe kaŋes; koderoto erot aboŋor akwap naka Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.7",
            "verseOrgIds": [
              "RUT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.15"
              },
              "items": [
                {
                  "text": "Yos 24:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.1.16"
              },
              "items": [
                {
                  "text": "2 Tim 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Naomi atemar aterakake aarei ebe, “Ape, koboŋosi ŋinidiopet kayesi ore loka totoke; kiswamak EJAKAIT yes nukasianut, kwape ipotu yesi da kiswamakiniata lukatwak, ka eoŋ da. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.8",
            "verseOrgIds": [
              "RUT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.3.1"
              },
              "items": [
                {
                  "text": "Rus 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koinak EJAKAIT yes adumun aiyeŋun, ŋinidiopet kayesi kore loka ekileke.” Kosodi ŋesi ainu kes; kodelosi, komonyata akiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.9",
            "verseOrgIds": [
              "RUT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotemasi kesi ŋes atiar, “Okwe ito, konye kiboŋori isio nepepe kajo mama ejaas ituŋakon.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.10",
            "verseOrgIds": [
              "RUT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.11"
              },
              "items": [
                {
                  "text": "Age 38:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.5"
              },
              "items": [
                {
                  "text": "Ikis 25:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Naomi atemar kes ebe, “Kibelokinos bobo adweka: kanukinyo ipudatar yesi aupar keoŋ? Eroko kereka idwe ejaas aliligeteka lueraunos ikiliokokus? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.11",
            "verseOrgIds": [
              "RUT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibelokinos bobo, adweka, koloto; naarai amoion eoŋ noi, mam adumuni ekiliokit ece. Arai kener eoŋ ebe, Amuno, karaida kajaun kekiliokit akuare na, kauru da idwe lusap; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.12",
            "verseOrgIds": [
              "RUT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
