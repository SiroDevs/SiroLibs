        },
        {
          "text": " Ido koany, kobu Boas koBet-lekem, kotema ikasakak atiar, “EJAKAIT kojai kayes.” Koboŋokis ŋes ebe, “Kisirereŋ jo EJAKAIT.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Boas atemar ekebulesit loetasaki ikasakak atiar, “Nakanai apese na?” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.5",
            "verseOrgIds": [
              "RUT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
