              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobala Naomi ateranike ebe, “Kisirereŋ EJAKAIT ŋes, lomam enaŋi akesianut mama kalukajarak ka lukatwak da.” Naomi kobala ŋes ebe, “Ekiliokit ŋolŋes lokokekiwok eut, ediopet ka lukalakunakawok.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
