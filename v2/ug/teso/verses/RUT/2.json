              "text": "2:17",
              "type": "text"
            },
            {
              "text": "epa itemi alaniru",
              "type": "text"
            }
          ]
        },
        {
          "text": " loka esairi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.17",
            "verseOrgIds": [
              "RUT.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
