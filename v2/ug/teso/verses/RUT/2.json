              },
              "items": [
                {
                  "text": "Rus 1:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu ebulesit loetasaki ikasakak Koboŋok ŋes ebe, “Na ŋes apese Amoabut naaboŋunete kaNaomi anyoun kakwap naka Moab: ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.6",
            "verseOrgIds": [
              "RUT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kiner cbe,, Kenaiŋaito, kerarunun ka atukonokin da kaneasakiata ikasakak koisutan da’; kosodi do abunore, eswama apeanan katupuruc kiton kwana, mam ebonorit ore.”",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.7",
            "verseOrgIds": [
              "RUT.2.7"
            ]
          }
        }
      ]
