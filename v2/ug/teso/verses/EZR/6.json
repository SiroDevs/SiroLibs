          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.5"
              },
              "items": [
                {
                  "text": "Dan 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebwaik da ekisil ebe, loijulanakini akirot na, koketunai akitoi kotogoke, kodakarai ŋes koenikinai neni korau eketogo ameje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.11",
            "verseOrgIds": [
              "EZR.6.11"
            ]
          }
        },
