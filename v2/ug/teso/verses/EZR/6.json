                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Dario ekabaka aibwaikin ekisil, komoai togo loka iitabon, neeŋadanakinio iboro luka akais nuipu koBabulon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.1",
            "verseOrgIds": [
              "EZR.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodumunai anunuket koAkameta, kotogo lokapolon loejai obuku loka Media, aponi kiwadikatete tomake kwanata araut aisiitunet. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.2",
            "verseOrgIds": [
              "EZR.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kokaru losodit loka Kuro ekabaka, kibwaik Kuro ekabaka ekisil; Kanuka etogo loka Edeke koYerusalem, kodukoi etogo aibois naainanakinere asuban, kopesikinai apeteta kagogoŋ; amukururuke ikubitin akaisakanykape, alalauke ikubitin akaisakanykape; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.3",
            "verseOrgIds": [
              "EZR.6.3"
            ]
          }
        },
        {
          "name": "verse",
