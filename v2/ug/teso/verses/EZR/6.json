            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kinyakarai da iboro luka esabu ka luka epuesa luka etogo loka Edeke lualemari Nebukadanesar koyekalu loejai Yerusalem luayauni Babulon, koyaŋaarai bobo oyekalu loejai Yerusalem, ŋinibore aiboisike, ibwaikini kes togo loka Edeke,”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.5",
            "verseOrgIds": [
              "EZR.6.5"
            ]
          }
        }
