            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tetere einanakinete asuban nuka asakat naeuru saa mama ejai Edeke loka akui, kilipanakinete aijar naka ekabaka ka naka odweke da. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.10",
            "verseOrgIds": [
              "EZR.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 6:11"
          },
          "items": [
