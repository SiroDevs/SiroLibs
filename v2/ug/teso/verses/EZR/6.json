                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ikokoron iuni luka amor nukapolok, ka ekokoro loka akito nukitetiak: kotaeakinai etiaikec kotogo loka ekabaka: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.4",
