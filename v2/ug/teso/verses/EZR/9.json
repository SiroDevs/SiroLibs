          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aso do, wu Edekekosi, kineri anu akaulo kanun? Naarai kipou kenyeis akoniicorakineta, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.10",
            "verseOrgIds": [
              "EZR.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuibu kicorak kama kikonikejaanakinak inabin, ebe, ‘Akwap nailomarete airum, ŋes akwap namam elai kanuka amamus aila naka ituŋa luka akwapin, kanuka italesiakec, luesilelebata asilianutukec epuai kepuai da. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.11",
            "verseOrgIds": [
              "EZR.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.32"
              },
              "items": [
                {
