                  "text": "1 Kor 16:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai sio da arai emalaika loebuni kotoma akuj, kilimonok yes Akiro Nukajokak nuegelara ka ŋun nukipou kalimonokisi yes, korau loikenitoi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.8",
            "verseOrgIds": [
              "GAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwape kipou kalimokiniata sek, kwana da alimokini bobo, arai kilimonokini yes ituŋanan Akiro Nukajokak nuegelara kaŋun nuipotu kocamut, korau yenikenitoi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.9",
            "verseOrgIds": [
              "GAL.1.9"
            ]
          }
        }
