              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aumok eoŋ ebe isunyito yesi kwaŋin aibwot kama kaŋol lokinyaraunit yes kotoma asianut naka Kristo, mama ejaas Akiro Nukajokak ace— ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.6",
            "verseOrgIds": [
              "GAL.1.6"
            ]
          }
        },
