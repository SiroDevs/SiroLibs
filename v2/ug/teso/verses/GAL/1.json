              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ipotu kiirasi kwape kekonitor sek kodini loka Iyudayan, kwape kareitor noi noi ekanisa loka Edeke, kamuna da ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
