                  "text": "Asw 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido abu keyatakin kodini loka lyudayan adepar luatumunete nepepe keoŋ luka atekereka, kekokotikinite noi jokan iponesio luka lukapapaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
