            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ejodouni kereka eoŋ ituŋa, arai bo Edeke? Arai bo amoot kereka eoŋ aisiyalamikin ituŋa? Arai ariŋa esiyalamikinit ituŋa timam karau ebulesit loka Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
