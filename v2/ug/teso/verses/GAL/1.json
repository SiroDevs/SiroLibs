              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai iinacan, akoto yes ajenun ebe Akiro Nukajokak nuabu eoŋ kalimonok, mam keraas kopone loka ituŋanan, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.11",
            "verseOrgIds": [
              "GAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai mam abu kadum kes kama kituŋanan, kwabo mam kesisianakinitai, dimarai kotoma apukokinio naka Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.12",
            "verseOrgIds": [
              "GAL.1.12"
            ]
