              "type": "text"
            }
          ]
        },
        {
          "text": " Asianut kojai mama ijaas ka ainapakin nuepote kama ejai Edeke Papawok, ka Ejakait Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.3",
