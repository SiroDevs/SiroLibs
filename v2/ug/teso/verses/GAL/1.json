        },
        {
          "text": " Paul ekiyakia-mere kama kituŋa, karaida kanuka ituŋanan, dimarai kanuka Yesu Kristo ka Edeke Papa lokitajaruni ŋes kokatwak— ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.1",
            "verseOrgIds": [
