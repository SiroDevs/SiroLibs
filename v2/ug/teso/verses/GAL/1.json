                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " numam eraas ace, konye ejaas icetuŋa luiticanete yes, luekotosi aibelokin Akiro Nukajokak nuka Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.7",
            "verseOrgIds": [
              "GAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
