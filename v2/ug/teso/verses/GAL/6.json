            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ameari kwana kinyek idiotuŋanan aitican eoŋ; naarai adakit eoŋ imacarin luka Yesu kotoma akuanaka.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
