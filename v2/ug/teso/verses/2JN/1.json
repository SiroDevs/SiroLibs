              "2JN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2JN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyogaete jo idwe luka inacikon naseuna.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.13",
            "verseOrgIds": [
