                "loc": "3JN.1.1"
              },
              "items": [
                {
                  "text": "3 Yok 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eoŋ ekimat ewadikakini ajakait naseuna ka idweke, luamina kabeit, ido mere eoŋ bon konye ŋul kere da luejenete abeit, ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.1",
            "verseOrgIds": [
              "2JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanuka abeit naesalit tomawok, ido ejaun nepepe kaoni ikar kere:",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.2",
            "verseOrgIds": [
              "2JN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.2",
            "verseOrgIds": [
              "2JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asianut, ka aitim, ka ainapakin ejaunete kaoni kama ka Edeke Papa, ido kama ka Yesu Kristo Okoku loka Papa, toma abeit ka amin.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.3",
            "verseOrgIds": [
              "2JN.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.3",
            "verseOrgIds": [
              "2JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu keyalamikin noi naarai abu kadum ice kodwekon elosenenete kotoma abeit, kwape kidumunia aicorakinet kama ka Papa. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.4",
            "verseOrgIds": [
              "2JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.34"
              },
              "items": [
                {
                  "text": "Yok 13:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.12"
              },
              "items": [
                {
                  "text": "15:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.7"
              },
              "items": [
                {
                  "text": "1 Yok 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kwana ajakait, kelipi jo, mere bala kewadikakini jo aicorakinet nakitetet, konye ŋin nakijaatar ameun kageunet, kaminanaros bonik ka bonik. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.5",
            "verseOrgIds": [
              "2JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na da ŋes amin, kalosenenete kwape ejaatar aicorakinetake; na ŋes aicorakinet, kwape ipupunitotor yesi ameun kageunet, ebe, kolosenenete kotoma amin. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.6",
            "verseOrgIds": [
              "2JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.18"
              },
              "items": [
                {
                  "text": "1 Yok 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.1+1JN.4.2+1JN.4.3"
              },
              "items": [
                {
                  "text": "4:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai alomasi ikeŋalak luipu toma akwapin, lumam elimorete abunore naka Yesu Kristo kotoma akuan; ŋol ŋes ekeŋalan ido lokasurup loka Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.7",
            "verseOrgIds": [
              "2JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.11"
              },
              "items": [
                {
                  "text": "Gal 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kocoito kinyeis atwaniar nukiswamat, konye kijaut eropit loitekoro. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.8",
            "verseOrgIds": [
              "2JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.23"
              },
              "items": [
                {
                  "text": "1 Yok 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋin kere yenelitori komam esalit toma aisisianakin naka Kristo, emamei ŋin Edeke; yenesalit toma aisisianakin, ejai ŋin Papa ka Okoku da. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.9",
            "verseOrgIds": [
              "2JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.6"
              },
              "items": [
                {
                  "text": "2 Ses 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.17"
              },
              "items": [
                {
                  "text": "1 Ika 13:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "3JN.1.8"
              },
              "items": [
                {
                  "text": "3 Yok 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai ebuni ituŋanan mamakus, komam eyaunit aisisianakin ŋin, sirikisukunyikis ŋes togo, karaida ayogan ŋes; ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.10",
            "verseOrgIds": [
              "2JN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "naarai yeniyogai ŋes emorete kaŋes akeswamisio nukaronok.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.11",
            "verseOrgIds": [
              "2JN.1.11"
            ]
          }
        }
      ]
    },
