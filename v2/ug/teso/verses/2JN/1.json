            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "3JN.1.13"
              },
              "items": [
                {
                  "text": "3 Yok 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ejaas nuipu aiwadikakin yes, konye mam akoto aitwasam apapula ka ebwino, konye amun abunore mamakus, kenerata kaituke, kosodi kodol awokokiyalama.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        }
      ]
