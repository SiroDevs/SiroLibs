          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka iinacanakec luka ikekia luka lukapapaakec; Mikael, ka Mesulam, ka Seba, ka Yorai, ka Yakan, ka Sia, ka Eber, ikanykaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        },
        {
