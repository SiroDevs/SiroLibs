        {
          "text": " kari nakokide kiboie kiton neelomarere amodiŋ anyoun kocor Eupurat: naarai kiyatakinos ibarenekec kakwap naka Gilead. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
