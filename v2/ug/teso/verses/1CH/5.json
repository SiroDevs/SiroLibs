          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋul kes odwe luka Abikail, okoku loka Kuri, okoku loka Yaroa, okoku loka Gilead, okoku loka Mikael, okoku loka Yesisai, okoku loka Yado, okoku loka Bus: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aki okoku loka Abudiel, okoku loka Guni, ejakait loka ikekia luka lukapapaakec, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.15",
            "verseOrgIds": [
              "1CH.5.15"
            ]
