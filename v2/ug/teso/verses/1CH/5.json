          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika okokuke, Reaia okokuke, Baal okokuke; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
            ]
          }
