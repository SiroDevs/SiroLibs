          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iinacanake kokekiakec, kwapc emarere aur naka aturiokec; ejakait, Yeiel, ka Sekaria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
            "verseOrgIds": [
              "1CH.5.7"
