              "type": "text"
            }
          ]
        },
        {
          "text": " Beera okokuke, loabu Tiligat-pilineser ekabaka loka Asuria kijoreo: kerai ŋesi ekapolon loka Ireubin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
