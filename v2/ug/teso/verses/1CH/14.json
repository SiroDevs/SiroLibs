              "items": [
                {
                  "text": "1 Ika 5:1-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijuka Kiram ekabaka loka Turo ikiyakia mama ejai Daudi, ka ikito luka eres, ka ikadukok kamor, ka ikekeok, adukokin Daudi etogo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
              "1CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojen Daudi ebe abu EJAKAIT kitieat ŋes araun ekabaka loka Isirael, naarai kitopoiooritete akejakanut, kanuka iketuŋa Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        }
      ]
    },
