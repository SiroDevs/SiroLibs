                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.23"
              },
              "items": [
                {
                  "text": "2 Sam 5:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinit bobo Daudi Edeke; kotema Edeke ŋes atiar, “Mam ilosi atupakin kes: kiwarak kes, kobunok kaneeiaas ikito luka baka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejaun kwanata ebe, Kipup ijo eporoto loka lueraeete alosit kokuju kikito luka baka, kosodi konyet alosit ejie: naarai kinarenikinit Edeke aidany ajore naka Ipilisitian.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.15",
            "verseOrgIds": [
              "1CH.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.25"
              },
              "items": [
                {
                  "text": "2 Sam 5:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswama Daudi kwape ecorakinia EJAKAIT: kodanyata aiore naka Ipilisitian anyoun koGibeon kiton Geser. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
        },
        {
