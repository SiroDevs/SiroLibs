                "loc": "1KI.5.1+1KI.5.2+1KI.5.3+1KI.5.4+1KI.5.5+1KI.5.6+1KI.5.7+1KI.5.8+1KI.5.9+1KI.5.10+1KI.5.11+1KI.5.12"
