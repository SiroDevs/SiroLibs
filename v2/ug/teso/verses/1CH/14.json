                  "text": "11:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisiarakin eemuto loka Daudi akwapin kere; koinak EJAKAIT atekerin kere akurianar ŋes.",
          "type": "text",
          "attrs": {
