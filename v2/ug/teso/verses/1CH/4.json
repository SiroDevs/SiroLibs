              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitopolooritete Yabes aitelekarit iinaeanake: komaik totoke ekekiror Yabes ebe, “Naarai kedou ŋes kaiturur.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.9",
            "verseOrgIds": [
              "1CH.4.9"
            ]
          }
        },
