                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋul da luewadikao ikiroria apote kapaarasia nuka Kesekia ekabaka loka Yuda, komunaasi iwemanakec, ka Imeunim luadumunos kaŋina, komudiasi kes eut, kiton lolo, kiboikinos aiboisikec: naarai ajaas inya kaŋina luka isipaninikec. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
