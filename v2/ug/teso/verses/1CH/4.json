          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Elioenai, ka Yaakoba, ka Yesokaia, ka Asaia, ka Adiel, ka Yesimiel, ka Benaia; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.36",
            "verseOrgIds": [
              "1CH.4.36"
            ]
          }
        },
        {
