              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinerut Daudi ka ikapolok luka ilukumin ka luka akwatat, kes ikenarenokkere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.1",
            "verseOrgIds": [
              "1CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
