                "loc": "1CH.11.22"
              },
              "items": [
                {
                  "text": "1 Siit 11:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋes Benaia ŋol, lokerai etuŋanan lokirigi loka akaisauni, loapolokinit akaisauni: kerai Amisabad okokuke kotoma abeikineteke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.6",
            "verseOrgIds": [
              "1CH.27.6"
            ]
          }
        },
        {
