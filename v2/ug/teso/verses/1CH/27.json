                {
                  "text": "1 Siit 11:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kerai Ira okoku loka Ikes Etekoit ekapolon lokikanyetekape loka elap lokikanyetekape: emwaasi ilukumin akaisaarei ka luonon kotoma abeikineteke. ",
          "type": "text",
          "attrs": {
