            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kerai Asakel onaee loka Yoab ekapolon lokiwononet loka elap lokiwononet, ka Sebedia okokuke atupakin ŋes: emwaasi ilukumin akaisaarei ka luonon kotoma abeikineteke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.7",
            "verseOrgIds": [
              "1CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
