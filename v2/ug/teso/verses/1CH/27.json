                "loc": "HEB.11.12"
              },
              "items": [
                {
                  "text": "Bur 11:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye mam Daudi abu kimar etiai kanul luka ikar akaisaarei ka lueroko edolo ŋu!: naarai abu EJAKAIT kotema ebe iyatakini Isirael kwape aacer nuka akui, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.15"
              },
              "items": [
                {
                  "text": "2 Sam 24:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.7"
              },
              "items": [
                {
                  "text": "1 Siit 21:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kogeu Yoab okoku loka Seruia aimar, konye mam abu konetak; ŋes abunokinia Isirael anyunyura; etiai da mam aponi kiwadikai toma oitabo loka aisiitonokin nuka ekabaka Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
