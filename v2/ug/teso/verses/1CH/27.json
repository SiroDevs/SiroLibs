          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerai Samut Isarit ekapolon lokikanyet loka elap lokikanyet: emwaasi ilukunilii akaisaarei ka luonon kotoma abeikineteke, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.8",
            "verseOrgIds": [
              "1CH.27.8"
            ]
