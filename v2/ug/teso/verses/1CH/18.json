              "type": "text"
            }
          ]
        },
        {
          "text": " Bobo da abu Abisai okoku loka Seruia kodany ilukumin itomon ka lukanykauni luka Idomein kAditot naka Abalaŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
