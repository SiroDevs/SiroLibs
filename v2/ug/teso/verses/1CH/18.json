            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kepupu Tou ekabaka loka Kamat ebe adany Daudi aiore kere naka Kadareser ekabaka loka Soba, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.9",
            "verseOrgIds": [
              "1CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.10"
              },
              "items": [
                {
                  "text": "2 Sam 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " abu kijuka Kadoram okokuke mama ejai ekabaka Daudi, ayogan ŋes, ailipakin ŋes arereŋ, naarai etijiit Kadareser kodany ŋes; naarai abu Kadareser kitijiite Tou; kejaas kaŋes iponesio kere luka iboro luka esabu ka epuesa ka aisinit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.10",
            "verseOrgIds": [
              "1CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋul da abu Daudi kotiakak EJAKAIT, nepepe kepuesa ka esabu loabu konaru katekerin kere; kama ka Edom, ka Moab, kodwe luka Amon, koPilisitian, ka Amalek da.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        }
      ]
    },
