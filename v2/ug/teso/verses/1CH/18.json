              },
              "items": [
                {
                  "text": "2 Sam 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen akaulo kanun, kodany Daudi Ipilisitian, kipiko kes, kodemu Gat ka ireriake kakan naka Ipilisitian. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.1",
            "verseOrgIds": [
              "1CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.24.17"
              },
              "items": [
                {
                  "text": "Mar 24:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodany Moab; koraut Imoabin ikejaanakinak luka Daudi koyaut ainakineta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.2",
            "verseOrgIds": [
              "1CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.3"
              },
              "items": [
                {
                  "text": "2 Sam 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Age 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.24"
              },
              "items": [
                {
                  "text": "Ikis 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitoii Daudi Kadareser ekabaka loka Soba kiton Kamat, nakelosio aitieat ayaiteke eiduny kecor Eupurat. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.3",
            "verseOrgIds": [
              "1CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.4"
              },
              "items": [
                {
                  "text": "2 Sam 8:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolema Daudi kamake agalin alukumit, ka ikebwanenok ilukumin ikanykaarei, ka lualosete kakeie ilukumin akaisaarei: kitwanal Daudi ibalasin kere luka agalin, konye kinadak kakes luka agalin akwatat. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.4",
            "verseOrgIds": [
              "1CH.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepotu Isurian luka Damasiko aisigalikin Kadareser ekabaka loka Soba, kodany Daudi ituŋa ilukumin akaisaarei ka luarei luka Isurian. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.5",
            "verseOrgIds": [
              "1CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.17.8"
              },
              "items": [
                {
                  "text": "1 Siit 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.91.14"
              },
              "items": [
                {
                  "text": "Sab 91:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.121.8"
