                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.21.31"
              },
              "items": [
                {
                  "text": "Awa 21:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Daudi aibwaikin atukon nuka iserikalen Suria loka Damasiko; koraut Isurian ikejaanakinak luka Daudi, koyaut ainakineta. Koinak EJAKAIT Daudi aipikor kama kelosenenei kere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.6",
            "verseOrgIds": [
              "1CH.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konatu Daudi ibukui luka esabu lukeiaas kikejaanakinak luka Kadareser, koyau kes Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.7",
            "verseOrgIds": [
              "1CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.15"
              },
              "items": [
                {
                  "text": "1 Ika 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.12+2CH.4.13+2CH.4.14+2CH.4.15+2CH.4.16"
              },
              "items": [
                {
                  "text": "2 Siit 4:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konatu Daudi aisinit naepol noi koTibat, ko Cun, ireria luka Kadereser, naabu Solomon kiswamaa aŋolol naka aisinit, ka ipirin, ka iboro luka aisinit.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        }
      ]
