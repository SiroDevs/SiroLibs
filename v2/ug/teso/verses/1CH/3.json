            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aponi kourikinai ŋes ikanykape koKeburon; kirumak kaŋina ikar ikanykaarei ka ilapio ikanykape; kirumak ko Yerusalem ikar akaisauni ka luuni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 3:5"
          },
          "items": [
