          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odwe luka Kanania; Pelatia, ka Yesaia: odwe luka Repaia, odwe luka Arunan, odwe luka Obadia, odwe luka Sekania, ",
          "type": "text",
          "attrs": {
