            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋul kere kes odwe luka Daudi, kogelara odwe luka abusian; Tamar ŋes kinacikec,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
