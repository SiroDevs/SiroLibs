          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Kasuba, ka Okel, ka Berekia, ka Kasadia, ka Yusab-kesed, ikany. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.20",
            "verseOrgIds": [
              "1CH.3.20"
            ]
          }
        },
