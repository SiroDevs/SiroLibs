        },
        {
          "text": " Lu kes odwe luka Daudi luaponi kourikinai ŋes koKeburon: Aminon ekiyaike loka Akinoam Ayesereelit; lokiareit, Daniel, loka Abigail Akaramelit; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokiwuniet, Abisalom okoku loka Maaka akoku naka Talumai ekabaka loka Gesur; lokiwononet, Adoniya okoku loka Kagit; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 3:3"
          },
          "items": [
