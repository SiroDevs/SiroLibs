            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka Elisama, ka Eliada, ka Elipelet, ikanykaoŋon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.8",
            "verseOrgIds": [
              "1CH.3.8"
            ]
