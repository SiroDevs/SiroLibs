            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okoku loka Solomon ŋes Rekoboam, Abiya okokuke, Asa okokuke, Yekosapat oko kuke; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        },
