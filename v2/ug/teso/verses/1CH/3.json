                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Odwe luka Pedaia; Serubabel, ka Simei: odwe luka Serubabel; Mesulam, ka Kanania; Selomit ŋes kinacikec: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
