            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aponi kourikinai ŋes lu koYerusalem: Simea, ka Sobab, ka Natan, ka Solomon, iwonon, luka Bat-sua akoku naka Amiel: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Ibar, ka Elisama, ka Elipelet; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.6",
            "verseOrgIds": [
              "1CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
