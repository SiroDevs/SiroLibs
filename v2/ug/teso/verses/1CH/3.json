            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Odwe luka Yekoiakim: Yekonia okokuke, Sedekia okokuke, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.16",
            "verseOrgIds": [
              "1CH.3.16"
            ]
          }
        },
        {
