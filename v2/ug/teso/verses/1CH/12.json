                "loc": "ZEC.3.2"
              },
              "items": [
                {
                  "text": "Sek 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.9"
              },
              "items": [
                {
                  "text": "Yud 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloma Daudi airiamakin kakes, Koboŋok kotema atiar, “Arai ca iponito yesi inapakina mama ajai aitjarakin eoŋ, kimorikikin ekatau ka lukus; konye arai iponito abilakin eoŋ ebotet mama ejaas lukasurupoka, naarai emamei aronis kakaninika, kosesen Edeke loka lukapapaawok, kitoron.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
