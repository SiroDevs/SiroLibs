            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋul kes luapotu kodokas Yorodan kolap losodit, kedau ŋesi ailapanar aririke kere; kitekerata nul kere luka aditon, kiton kide, koto da.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        }
