              "items": [
                {
                  "text": "1 Siit 11:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lokapolon ŋes Akieser, kosodi Yoas, odwe luka Semaa Egibeatit; ka Yesiel, ka Pelet, odwe luka Asumabet; ka Bereka, ka Yeku Enatotait; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3",
            "verseOrgIds": [
              "1CH.12.3"
            ]
          }
        },
