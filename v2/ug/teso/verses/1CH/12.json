                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.1"
              },
              "items": [
                {
                  "text": "1 Sam 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lu kes itiaisinei luka ikapolok luka ŋul kaluakapitos lujiis, luapotu kopotu mama ejai Daudi Keburon, aibelokin ajakanut naka Saul mamake, kwape ajaar akirot naka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23",
            "verseOrgIds": [
              "1CH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idwe luka Yuda lukitinitos ibukui ka akwaras emwaasi ilukumin ikanykape ka akwat akanykauni, luakapitos luiiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.24",
            "verseOrgIds": [
              "1CH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukodwe luka Simeon, ituŋa lukirigin luetitin ejie, ilukumin ikanykaarei ka akwatat, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.25",
            "verseOrgIds": [
              "1CH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukodwe luka Lebi ilukumin iwonon ka akwat akanykape. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.26",
            "verseOrgIds": [
              "1CH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yekoiada ŋes ekenarenikinon loka ekek loka Aaron, kojaas kaŋes ilukumin iuni ka akwat akanykaarei; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.27",
            "verseOrgIds": [
              "1CH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.17"
              },
              "items": [
                {
                  "text": "2 Sam 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.8"
              },
              "items": [
                {
                  "text": "1 Ika 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.25"
              },
              "items": [
                {
                  "text": "2:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.8"
              },
              "items": [
                {
                  "text": "1 Siit 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.15"
              },
              "items": [
                {
                  "text": "Esk 44:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sadok ekatumunan lokirigi loetitiŋ, ka lukotogo loka papake ikapolok akaisaarei ka luarei. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.28",
            "verseOrgIds": [
              "1CH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukodwe luka Benyamin, iinaean luka Saul, ilukumin iuni: naarai aitodol apakio nun keraas luitelekarito aipues lukiketakina atupar etogo loka Saul. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.29",
            "verseOrgIds": [
              "1CH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukodwe luka Epuraim ilukumin akaisaarei ka akwat akanykauni, ituŋa lukirigin luetitin, ituŋa lukodwaratau kokekia luka lukapapaakec. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.30",
            "verseOrgIds": [
              "1CH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukatutubet naka ateker naka Manase ilukumin itomon ka lukanykauni, luabilitai ikiroriakee, aponare aitaraun Daudi ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.31",
            "verseOrgIds": [
              "1CH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.1.13"
              },
              "items": [
                {
                  "text": "Est 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lukodwe luka Isakar, ituŋa luajenete apakio, ajenun nuibusakinit Isirael aswam: ikapolokokec emwaasi akwat aarei; kiswamata iinacanakec kere kwape ajaar aicorakinetekec. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.32",
            "verseOrgIds": [
              "1CH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luka Sebulun, luapedorete alomar kaiore, luapedorete aiderakin ejie, lukejaas kiboro lukiponesio luipu lujiis, ilukumin akaisakany; luapedorete aiderakin ejie, luamameete itauon iarei, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.33",
            "verseOrgIds": [
              "1CH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luka Naputali ikapolok elukumit, nepepe kakes da lukejaas ibukui ka akwaras ilukumin akaisauni ka lukanykaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.34",
            "verseOrgIds": [
              "1CH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luka Idanin luapedorete aiderakin ejie, ilukumin akaisaarei ka lukanykauni ka akwat akanykape. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.35",
            "verseOrgIds": [
              "1CH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luka Aser, luapedorete alomar kajore, luapedorete aiderakin ejie, ilukumin akaisaoŋon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.36",
            "verseOrgIds": [
              "1CH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okekwa juwai Yorodan, luka Ireubenin, ka Igadin, ka atutubet naka ateker naka Manase, lukejaas kiboro lukiponesio luipu lujiis ilukumin akwatat ka ilukumin akaisaarei.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋul kere, ituŋa lukajiok, luapedorete aiderakin ejie, apotu kopotu Keburon ketau loetenara, aitaraun Daudi ekabaka loka Isirael kere: luka Isirael ice kere da kejaas ketau ediopet aitaraun Daudi ekabaka, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kejaas nina nepepe ka Daudi apaarasia auni, enyamete, emasete: naarai apotu iinacanakec kitemokis kanukec, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo da nul luedunyas kakes, kiton Isakar ka Sebulun ka Naputali, kibwokut inyamat kasigirian, kakaalai, konyubun, komonin, inyamat luka akiria, alunureta nuka itinin, aibuneta nueokito nuka imusabibun, ka ebino, ka akinyet, ka imoŋin, ka imerekekin, epu noi; naarai kejai aiyalama koIsirae!’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
        }
      ]
    }
  ],
