        },
        {
          "text": " Kosodi emoyo abunokin Amasai lokerai lokapolon loka akaisauni, kotema atiar,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        }
      ]
    },
