                "loc": "JDG.20.16"
              },
              "items": [
                {
                  "text": "Tub 20:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokapitos akabwai, apedorete aitwasam akan nakoteten ka nakokediany da aporoeanaria alica, ka agumanaria imalia da kakabwa; koraas luka iinaean luka Saul luka Benyamin, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
              "1CH.12.2"
            ]
          }
        },
        {
