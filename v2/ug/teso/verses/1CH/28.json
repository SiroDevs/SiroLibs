              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.24.1"
              },
              "items": [
                {
                  "text": "1 Siit 24:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.25.1"
              },
              "items": [
                {
                  "text": "25:1",
