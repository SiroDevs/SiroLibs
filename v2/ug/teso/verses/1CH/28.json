              "items": [
                {
                  "text": "1 Ika 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Daudi ainakin Solomon okokuke aput naka alomaret naka eyekalu, ka naka itogoike, ka aiŋadisiake, ka agolaike nukokuju, ka agolaike nukotoma, ka aibois naka eicoloŋ-lokaitim: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.11",
            "verseOrgIds": [
              "1CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.20"
              },
              "items": [
                {
                  "text": "1 Siit 26:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka aput naka nukejaas omoyoke kere, nuka alaroi nuka etogo loka EJAKAIT, ka agolai kere nuelukunito, naka aiŋadisia nuka etogo loka Edeke, ka naka aiŋadisia nuka iboro luatiakunitai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.12",
            "verseOrgIds": [
              "1CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babo da nuka abeanakineta nuka isasedotin ka Ilebin, ka aswam kere naka aijaanakin kotogo loka EJAKAIT, ka iboro kere luka aijaanakin kotogo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.13",
            "verseOrgIds": [
              "1CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esabu loitemitoi loka iboro luka esabu, iboro kere luka nolipone loka aijaanakin; epuesa loitemitoi loka iboro kere luka epuesa, iboro kere luka ŋolipone loka aijaanakin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.14",
            "verseOrgIds": [
              "1CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itemem da esabu loka ipirin luka atalai, loka atalaike, nuka esabu, loetemem loka nolipir loka atala ka atalaike: ido loka ipirin luka atalai luka epuesa, epuesa loetemem loka nolipir loka atala, ka atalaike, kwape kejaar aijaanakin naka nolipir loka atala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.15",
            "verseOrgIds": [
              "1CH.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.23"
              },
              "items": [
                {
                  "text": "Any 25:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.48"
              },
              "items": [
                {
                  "text": "1 Ika 7:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.8"
              },
              "items": [
                {
                  "text": "2 Siit 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Etemem da esabu loka imesan luka imugatin luka aitodikin, kaŋolimesa; epuesa da loka imesan luka epuesa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.16",
            "verseOrgIds": [
              "1CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka igolun luka akiriŋ, ka atanya, ka akolin, nuka esabu loelai: etemem da esabu loka atuba, kaninituba; etemem da epuesa loka atuba, ka ninituba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.17",
            "verseOrgIds": [
              "1CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
