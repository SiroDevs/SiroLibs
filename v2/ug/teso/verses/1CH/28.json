                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.8"
              },
              "items": [
                {
                  "text": "Yak 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ŋo da, Solomon okokuka, kojenu Edeke loka papakon, kiiaanakinenei ŋes ketau loedolit ka aomisio nuekotosi: naarai enici EJAKAIT itauon kere, ejeŋi aitetemonor kere nuka aomisio: arai imoenenei ŋes, kitakananakini jo: konye arai iialenenei ŋes, kirenei jo ikar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.9",
            "verseOrgIds": [
              "1CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.16"
              },
              "items": [
                {
                  "text": "1 Siit 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.23"
              },
              "items": [
                {
                  "text": "Awa 4:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso koeoite; naarai kiseu EJAKAIT jo adukokin aibois nakalaunan etogo: aso kicat, kiswama.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.10",
            "verseOrgIds": [
              "1CH.28.10"
            ]
          }
        }
      ]
