                  "text": "36:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido koany, ejaas abeanakineta nuka isasedotin ka Ilebin, nuka aijaanakin kere nakaetogo loka Edeke: ejaun kajo nolitunanan loekoto loepiriana, kanolipone loka aijaanakin kotoma aswam naka ŋolipone: erimakinete da eut ikapolok ka ituŋa kere aicorakinetekon.’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.21",
            "verseOrgIds": [
              "1CH.28.21"
            ]
          }
        }
