              "items": [
                {
                  "text": "Bur 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Daudi Solomon okokuke atiar, “Kicat, kotitinior, kiswama nun; sirikikurianar, karaida aiyaloŋoŋ: naarai EJAKAIT Edeke, ŋes Ekadeke ejaenena kajo; mam ŋes isokori kamakon, mam kijali jo, aitodol needaunor aswam kere naka aijaanakin naka etogo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.20",
            "verseOrgIds": [
              "1CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 28:21"
          },
          "items": [
