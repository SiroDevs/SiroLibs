              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koseut Ilebin Keman okoku loka Yoel; ka lokiinacanake, Asap okoku loka Berekaia; ka lokodwe luka Merari iinaeanakec, Etan okoku loka Kusaia; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ikeceinacan luka atukot nakiareit, Sekaria, ka Ben, ka Yaasiel, ka Semiramot, ka Yekiel, ka Uni, ka Eliab, ka Benaia, ka Maaseia, ka Matitia, ka Elipeleku, ka Mikeneia, ka Obed-edom, ka Yeiel, ikagolok luka ekek, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi koseunai ikayook, Keman, ka Asap, ka Etan, kikaewi luka aisinin aituru; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Sekaria, ka Asiel, ka Semiramot, ka Yekiel, ka Uni, ka Eliab, ka Maaseia, ka Benaia, kisabulin koporoto loka Alamot; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Matitia, ka Elipeleku, ka Mikeneia, ka Obed-edom, ka Yeiel, ka Asasia, aiŋarenikin kadeudeun koporoto loka Iseminit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopolokinit Kenania, ekapolon loka Ilebin ekosio: kituutoor ŋesi ekosio, naarai kepiriana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
            "verseOrgIds": [
              "1CH.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Berekia ka Elukana kes ikagolok luka asaduku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.23",
            "verseOrgIds": [
              "1CH.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
