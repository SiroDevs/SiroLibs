                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolimok Daudi ikapolok luka Ilebin aseun iinacanakec ikayook, koiaas kalueruos, isabulin, ka adeudeun, ka ikaewi, koramata, koborianata kaiyalama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.16",
            "verseOrgIds": [
              "1CH.15.16"
            ]
          }
        },
        {
