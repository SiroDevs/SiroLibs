              "items": [
                {
                  "text": "Mar 26:58",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lukodwe luka Keburon; Eliel lokapolon, ka ikeinaean akaisakanykauni: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.9",
            "verseOrgIds": [
              "1CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukodwe luka Usiel; Aminadab lokapoion, ka ikeinaean akwatat ka itomon ka luarei. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyarau Daudi Sadok ka Abiatar isasedotin, ka Ilebin, kes Uriel, ka Asaia, ka Yoel, ka Semaia, ka Eliel, ka Aminadab, ",
          "type": "text",
          "attrs": {
