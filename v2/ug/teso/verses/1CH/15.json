                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.42.8"
              },
              "items": [
                {
                  "text": "Yob 42:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, kinarak Edeke Ilebin luadakete asaduku naka aitutuket naka EJAKAIT, apotu koinakis imoŋin lutoba ikanykaarei ka imerekekin ikanykaarei araun asuban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenapit Daudi ekaso loka ebaputa loejok, ka Ilebin kere luadakito asaduku, ka ikayook, ka Kenania ekapolon loka ekosio kikayook: konapit Daudi epod loka ebaputa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.13.8"
              },
              "items": [
                {
                  "text": "1 Siit 13:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwaŋin kitodoku Isirael kere asaduku naka aitutuket naka EJAKAIT keibwon, ka eporoto loka apeen, ka arupepen, ka ikacwi, koramata da isabulin ka adeudeun.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        }
