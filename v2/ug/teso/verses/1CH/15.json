            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu Daudi kolot, ka imakio luka Isirael, ka ikapolok luka ilukumin, aitodokun asaduku naka aitutuket naka EJAKAIT alemun kotogo loka Obededom kaiyalama: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
