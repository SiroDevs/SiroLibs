              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam ipotu kisiautu adakar ŋes, ŋes kecilia EJAKAIT Ewokodeke kamawok, naarai mam kipou kamootos ŋes kwape ajaar aicorakinet.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.13",
            "verseOrgIds": [
              "1CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
