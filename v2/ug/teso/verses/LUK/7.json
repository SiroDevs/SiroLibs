              "LUK.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.5+MAT.8.6+MAT.8.7+MAT.8.8+MAT.8.9+MAT.8.10+MAT.8.11+MAT.8.12+MAT.8.13"
              },
              "items": [
                {
                  "text": "Mat 8:5-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakedaunia akekiro kere kopupete ituŋa, koloma Kaparanaum, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.1",
            "verseOrgIds": [
              "LUK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.47"
              },
              "items": [
                {
                  "text": "Yok 4:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keiai ekapolokiton-erioŋet ekebulesit lokemina noi, lokedeka eapikinit airidakin, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.2",
            "verseOrgIds": [
              "LUK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakiiraria ŋol eemut loka Yesu, kiyakia imakio luka Iyudayan ailip ŋes abunore aitaŋaleun ekebulesit. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.3",
            "verseOrgIds": [
              "LUK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakedolioto kesi mama ejai Yesu, kiŋaiŋaata noi, kobalas ebe, “Ibus ŋesi, kiswamaki nu: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.4",
            "verseOrgIds": [
              "LUK.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "naarai emin awokoteker, kidukok sio akositukos.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.5",
            "verseOrgIds": [
              "LUK.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kouparos Yesu kakes, Nakeapikinia etogoke, kiyakik ekapolokiton ikepapero kotema atiar, “Ejakait, sirikitaar: naarai mam eoŋ kebusakinit jo alomun kwap kekaswi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.6",
            "verseOrgIds": [
              "LUK.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋes mam aomitor aibusakin abunore mamakon: konye kolim akirot bon, eŋaleuni ekatelepat. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.7",
            "verseOrgIds": [
              "LUK.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai eoŋ da arai etuŋanan lokayaitai, ejaas iserikalei luayait eoŋ: ido alimokini ediopet ebe, ‘Kolot’, elosi; ece da ebe, ‘Bia,’ ebuni; ekabulesit da ebe, ‘Kiswama na,’ ido iswamai.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.8",
            "verseOrgIds": [
              "LUK.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakiiraria Yesu akiro ŋun, koumok kanukeŋ, kibelokin kolimok ekodet loketupit ŋes ebe, “Katemari yes atiar, Mam lem adumunit aiyuun naepol naetia na, karaida toma Isirael kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.9",
            "verseOrgIds": [
              "LUK.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakeboŋoriata lueyakunitai ore, kodumut ebulesit keŋaleu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.10",
            "verseOrgIds": [
              "LUK.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.10",
            "verseOrgIds": [
              "LUK.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen ketubor apak naedit kolot ore loenyaritai Nain, koupas ikekesisiak kaŋes ka ekodet loepol. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.11",
            "verseOrgIds": [
              "LUK.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.42"
              },
              "items": [
                {
                  "text": "Luk 8:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.17"
              },
              "items": [
                {
                  "text": "1 Ika 17:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakeapiaria orute loka ere, koany, kibwokunitai lokatwan kiŋa, lokerai loteluna, totoke da kerai apuserut: kejaas ituŋa luipu lukore nenipe kaŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.12",
            "verseOrgIds": [
              "LUK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakeanyunia Ejakait ŋin kitim, kotema ŋes atiar, “Sirikimony.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.13",
            "verseOrgIds": [
              "LUK.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikunyak kotiro ekirigi lokibwokitere, kobwout lukibwokito. Kotema atiar, “Etelepat, katemari jo atiar, Konyou.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.14",
            "verseOrgIds": [
              "LUK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.23"
              },
              "items": [
                {
                  "text": "1 Ika 17:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.36"
              },
              "items": [
                {
                  "text": "2 Ika 4:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiboikin lokatwan kogeu einer. Koinak ŋes totoke, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.15",
            "verseOrgIds": [
              "LUK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.68"
              },
              "items": [
                {
                  "text": "Luk 1:68",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.44"
              },
              "items": [
                {
                  "text": "19:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokuriakaros kere; kitopoloosi Edeke, kobalas ebe, “Atakanu cama enabi lokapolon kamawok!” ebe da, “Aanyana Edeke iketuŋol” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.16",
            "verseOrgIds": [
              "LUK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisiarakinos akiro ŋun toma Yudaya kere, ka akwap kere naidunyatar.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.17",
            "verseOrgIds": [
              "LUK.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.17",
            "verseOrgIds": [
              "LUK.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 7:18"
          },
          "items": [
            {
              "text": "18",
