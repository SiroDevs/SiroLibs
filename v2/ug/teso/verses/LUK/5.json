                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.1"
              },
              "items": [
                {
                  "text": "4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen nakeridakiniata ŋes ikodeta iirarete akirot naka Edeke, kebwoi ŋesi kariri kaŋolol naka Genesaret. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.1",
            "verseOrgIds": [
              "LUK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koany atakerin aarei nukeiaas oitolima loka aŋolol; konye kedokunito ikalokak ilosete iboyanakec. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.2",
            "verseOrgIds": [
              "LUK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodoka ataker adiopet, nakerai naka Simon, kilip ŋes aisukunyar nediokasilon anyoun koitolima, Kiboikin kisisianak ikodeta kojai ataker. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.3",
            "verseOrgIds": [
              "LUK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.6"
              },
              "items": [
                {
                  "text": "Yok 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakedau einer, kotema ŋesi Simon atiar, “Koremo ataker kiton ataro, kocakakis iboyanakus aikamia lukecor.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.4",
            "verseOrgIds": [
              "LUK.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.3"
              },
              "items": [
                {
                  "text": "Yok 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋok Simon kotema atiar, “Ejakait, kipou ketaaritos akuare kiya, komam kidumuni idiobore: konye kanuka akonikirot, acakakini bo iboyan.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.5",
            "verseOrgIds": [
              "LUK.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.6"
              },
              "items": [
                {
                  "text": "Yok 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kedaut aswam ŋun, kipokata iboro lukecor luipu noi: kokotosi ikeceboyan aŋed; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.6",
            "verseOrgIds": [
              "LUK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kokwetut lukaupakec lukejaas ataker ace aponare aiŋarakin kes. Kopotu, kisilelebata atakerin kere aarei kiton neebuciata alumor. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.7",
            "verseOrgIds": [
              "LUK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye keanyu Simon Petero ŋun, kibirokin kwap akuŋin nuka Yesu, kobala ebe, “Wu Ejakait, kinyeinai, naarai arai eoŋ ekadiakanaran.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.8",
            "verseOrgIds": [
              "LUK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai koumok ŋesi, ka ŋul kere lukejaas kaŋes, kanuka aipues naka lukecor lukikamunete: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.9",
            "verseOrgIds": [
              "LUK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.47"
              },
              "items": [
                {
                  "text": "Mat 13:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " koumokis da Yakob ka Yokana, odwe luka Sebedayo, lukemoranara ka Simon. Kotema Yesu Simon atiar, “Sirikikurianar; amear natikwana iraun ekalokan ituŋa.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.10",
            "verseOrgIds": [
              "LUK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.27"
              },
              "items": [
                {
                  "text": "Mat 19:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakedauniata aitodokun atakerinikec oitolima, kinyeis kere, kotupasi ŋes.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.11",
            "verseOrgIds": [
              "LUK.5.11"
            ]
          }
        }
      ]
    },
    {
