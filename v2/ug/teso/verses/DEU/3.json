              },
              "items": [
                {
                  "text": "Amo 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (Naarai Og ekabaka loka Basan, ŋes bon asalit kotoma kaluedeuna luka Irepaim; koany, eitadake kerai eitada loka asuat; mere ejai Raba neejaas idwe luka Amon? Aojauke kerai ikubitin Ikanykaoŋon ka alalauke ikubitin iwoŋon, kwape ejaar ekubit ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.11",
            "verseOrgIds": [
              "DEU.3.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:11",
              "type": "text"
            },
            {
              "text": "Ekubit itemi aojau bala l’ 6’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " loka etuŋanan.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.11",
            "verseOrgIds": [
              "DEU.3.11"
            ]
          }
        }
      ]
