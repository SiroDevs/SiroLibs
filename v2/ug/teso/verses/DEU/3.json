              },
              "items": [
                {
                  "text": "Yos 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aitodol naisiyeŋunia EJAKAIT ikusiinacan, kwape yes, aitodol nairumiata akwap naeinakinit EJAKAIT Ekusideke kes kokekwa loka Yorodan: ŋes konyet iboŋunioto yesi ŋinituŋanan alupoke nukainak yes.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        },
        {
          "name": "verse",
