              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye esalete akusiŋor, ka ludidikikus, ka ibarenekus oreriakus lukainak yes, (ajeni ebe ipu yes ibaren); ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
              "DEU.3.19"
            ]
          }
        },
        {
          "name": "verse",
