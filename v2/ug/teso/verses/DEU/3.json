            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.39+NUM.32.40+NUM.32.41+NUM.32.42"
              },
              "items": [
                {
                  "text": "Mar 32:39-42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.29"
              },
              "items": [
                {
                  "text": "Yos 13:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka Gilead naedeuna ka Basan kere, ajakanut naka Og abu eoŋ kainak atutubet naka ateker naka Manase; akwap kere naka Arugob, ŋes Basan kere. (Emaikinitai ŋipeŋin akwap naka Irepaim. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.13",
            "verseOrgIds": [
              "DEU.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 3:14"
