              "items": [
                {
                  "text": "1 Siit 5:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (Kerumon loenyarito Isidonin Sirion, enyarito da Imorain ŋes Senir:) ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.9",
            "verseOrgIds": [
              "DEU.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.49"
              },
              "items": [
                {
                  "text": "Ikis 4:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.12.5"
              },
              "items": [
                {
                  "text": "Yos 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.11"
              },
              "items": [
                {
                  "text": "13:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ireria kere luka apuuton, ka Gilead kere, ka Basan kere, kiton Saleka ka Ederei ireria luka ajakanut naka Og koBasan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.10",
            "verseOrgIds": [
              "DEU.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 3:11"
          },
          "items": [
            {
