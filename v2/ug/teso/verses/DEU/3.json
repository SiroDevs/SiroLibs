                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu Yair okoku loka Manase koyaŋa akwap kere naka Arugob, kiton oikor loka Igesurin ka Imaacatin; abu komaik kes, ŋes Basan, ekekiror elopet, Kabot-yair, kiton lolo.) ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.14",
            "verseOrgIds": [
              "DEU.3.14"
            ]
          }
        },
