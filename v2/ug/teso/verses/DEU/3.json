            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kipou kerumata akwap ŋin kapak kaya: anyoun koAroer, naejai ariri naka aditot naka Arunon, ka atutubet naka akwap nakiukon naka Gilead, ka ireriake, abu eoŋ kainak Ireubenin ka Igadin: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.12",
            "verseOrgIds": [
              "DEU.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
