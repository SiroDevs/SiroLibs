            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.50"
              },
              "items": [
                {
                  "text": "50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Etonyoikini kes rwaru enabi koinacanakec loeputos kajo: ido ebwaikini akakiro aitukuke, ido kilimokini yes kere nuecorakini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.18",
            "verseOrgIds": [
              "DEU.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 18:19"
          },
          "items": [
