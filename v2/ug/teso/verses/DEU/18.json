        },
        {
          "text": " “Kitonyoikini rwaru EJAKAIT Ekonideke enabi kokidiŋikon, koinacanakon, loeputos keoŋ; ŋol ŋes iirarete rwaru; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.15",
            "verseOrgIds": [
              "DEU.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwape ejaatar kere nuibu kilip EJAKAIT Ekonideke koKoreb, kapaaran naka atukonokin, kobala ebe, ‘Kenyek akiirar bobo eporoto loka EJAKAIT Ekadeke, ido kenyek aanyun bobo akim na naepol, kenyek atwanare.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.16",
            "verseOrgIds": [
              "DEU.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katema EJAKAIT eoŋ atiar, ‘Enerata ejok ŋun nualimut. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.17",
            "verseOrgIds": [
              "DEU.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
