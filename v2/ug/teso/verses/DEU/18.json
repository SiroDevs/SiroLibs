                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.29"
              },
              "items": [
                {
                  "text": "Ikis 12:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kidau adolore akwap nakiinakini EJAKAIT Ekonideke, sirikisisiau aswam kwape ejaatar italesio luka atekerin kwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.9",
            "verseOrgIds": [
              "DEU.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.26"
              },
              "items": [
                {
                  "text": "Leb 19:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.18"
              },
              "items": [
                {
                  "text": "Any 22:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Siriketakanu kaneijai ijo ituŋanan kere yenitotori okokuke arai akokuke akim, karaida yeniswamai nuka airo, karaida yeneŋici aanyuneta, karaida yenikalemeleman, karaida ikacudan, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.10",
            "verseOrgIds": [
              "DEU.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.31"
              },
              "items": [
                {
                  "text": "Leb 19:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Karaida ikaroan, karaida yenikeŋitan aiokin, karaida ikepiedan, karaida yenikenitan lukatwak. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.11",
            "verseOrgIds": [
              "DEU.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.24"
              },
              "items": [
                {
                  "text": "Leb 18:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ŋinituŋanan yeniswamai ŋun erai yeniketal mama ejai EJAKAIT; ido kanuka italesio kaŋul, ŋes ireŋearia EJAKAIT Ekonideke kes kakonyenekon. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.12",
            "verseOrgIds": [
              "DEU.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.48"
              },
              "items": [
                {
                  "text": "Mat 5:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.1"
              },
              "items": [
                {
                  "text": "Age 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Korai ijo loidolit kaneejai Ekonideke. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.13",
            "verseOrgIds": [
              "DEU.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.6"
              },
              "items": [
                {
                  "text": "2 Ika 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai atekerin nu nuirumi ijo, epupete ŋul lueŋicete aanyuneta ka ikaroak; konye ijo, mam kicamakinit Ekonideke aiswamaenen kwaŋin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.14",
            "verseOrgIds": [
              "DEU.18.14"
            ]
          }
        }
      ]
    },
