              "items": [
                {
                  "text": "Yer 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye enabi loiilokini einer akiro kokirorika numam ecorakinit ŋes einer, arai ŋol loinera kokiror loka idekesio ice, eario enabi ŋol.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.20",
            "verseOrgIds": [
              "DEU.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai kitema ijo kotaukon ebe, ‘Kijenuni oni biai akirot namam EJAKAIT elimunit?’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.21",
            "verseOrgIds": [
              "DEU.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 18:22"
          },
          "items": [
