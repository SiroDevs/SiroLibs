                "loc": "ACT.3.23"
              },
              "items": [
                {
                  "text": "Asw 3:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, ŋinituŋanan yenimam iirari akakiro nuinera ŋesi kokirorika, etepeseni kanuka ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.19",
            "verseOrgIds": [
              "DEU.18.19"
            ]
          }
        },
