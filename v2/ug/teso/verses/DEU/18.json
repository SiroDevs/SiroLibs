              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.28.9"
              },
              "items": [
                {
                  "text": "Yer 28:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nainerar enabi kokiror loka EJAKAIT, arai mam akirot etakanunit, karaida adolore, ŋin ŋes akirot namam EJAKAIT elimunit: eilokini enabi einer, sirikikurianar ŋes.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.22",
            "verseOrgIds": [
              "DEU.18.22"
            ]
          }
        }
