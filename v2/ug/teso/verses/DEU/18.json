                "loc": "1CO.9.13"
              },
              "items": [
                {
                  "text": "1 Kor 9:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mam isasedotin Ilebin, kes ateker kere naka Lebi, ejaunos kakorakinet karaida airumet koIsirael: enyamenenete ainakineta nueinakinere kakim nuka EJAKAIT, ka airumeteke. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.1",
            "verseOrgIds": [
              "DEU.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.20"
              },
              "items": [
                {
                  "text": "Mar 18:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam kes ejaunos kairumet kama ejaas iinacanakec; EJAKAIT ŋes airumetekec kwape alimokinia ŋesi kes. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.2",
            "verseOrgIds": [
              "DEU.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.30"
              },
              "items": [
                {
                  "text": "Leb 7:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lu kes luitebeitai isasedotin kaneejaas ituŋa, kaneejaas ŋul lueinakinete asubanit, arai emoŋ arai amerekek, einanakinete esasedoti akuat, ka iitinyo iarei ka aboi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.3",
            "verseOrgIds": [
              "DEU.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.29"
              },
              "items": [
                {
                  "text": "Any 22:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.12"
              },
              "items": [
                {
                  "text": "Mar 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iinakini ŋes nuegeete nuka akimakon, ka ebinokon, ka akinyetekon, ka nusodit nuka ajul nuka amerekekinikon. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.4",
            "verseOrgIds": [
              "DEU.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.8"
              },
              "items": [
                {
                  "text": "Ikis 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai aseu EJAKAIT Ekonideke ŋes katekerinikon kere abwoenen aijaanakin kokiror loka EJAKAIT, ŋes ka odweke ikar kere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.5",
            "verseOrgIds": [
              "DEU.18.5"
            ]
          }
        }
      ]
    },
