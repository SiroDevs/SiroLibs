              "type": "tag",
              "attrs": {
                "loc": "DEU.3.23+DEU.3.24+DEU.3.25+DEU.3.26+DEU.3.27"
              },
              "items": [
                {
                  "text": "Ikis 3:23-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema EJAKAIT Musa kapaaran kaŋin ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kodoka ijo oroŋat lo Abarim, moru Nebo loejai akwap naka Moab, naitei Yeriko; koseseni akwap naka Kanaan, naainakinit idwe luka Isirael araun airumet: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotwanik moru loidokari ijo, koyanaar mama ejaas ikonituŋa; kwape atwanikinia onaeekon Aaron moru Kor, koyaŋaarai mama ejaas iketuŋa: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.11"
              },
              "items": [
                {
                  "text": "Mar 20:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ipotu kibuceasi kama ajai kokidiŋ kidwe luka Isirael kakipi nuka Meriba naka Kades, kamodiŋ naka Sin; naarai mam ipotu kitalaut eoŋ kokidiŋ kidwe luka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ianyuni akwap kakonyenekon; konye mam ilomari akwap naainakinit idwe luka Isirael.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
      ]
    }
