            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kocoite sirikiimurwok EJAKAIT Ekonideke, kotoma amamus aricrt aicorakinetake, ka itubesiake, ka ikisilake, lukeeorak jo lolo: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
