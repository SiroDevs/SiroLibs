                {
                  "text": "1 Tim 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inyami kimonikin, ituri EJAKAIT Ekonideke, kanuka akwap naejok nakiinak jo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
