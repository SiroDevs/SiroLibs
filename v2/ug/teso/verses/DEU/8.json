                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iwomoomoi ijo kotaukon ebe, kwape elecoria ituŋanan okokuke, kilecori EJAKAIT Ekonideke jo kwaŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irici ijo aicorakineta nuka EJAKAIT Ekonideke, alosenen korotinike, ka ayoŋit ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kiyaŋaarit EJAKAIT Ekonideke jo akwap naejok, akwap naka aguurun nuka akipi, naka akonye nuka atanin ka aidules, nuibulubulununos kaditon ka iukon; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwap naka akima ka esairi, ka imusabibun, ka itinin ka ikamamagan; akwap naka iseitunin luka akinyet, ka esik; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.8",
            "verseOrgIds": [
              "DEU.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwap nainyamiata atap naidila, emameun ibore yenipudakinos kaŋina; akwap naeraas akemor asuat, naibokuniata aisinit koukonoke. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.9",
            "verseOrgIds": [
              "DEU.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
