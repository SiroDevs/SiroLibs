              "type": "text"
            }
          ]
        },
        {
          "text": "Ikamunete do ŋes papake ka totoke, eyaŋaunete mama ejaas imakio luka ereke, kiton orute loka aiboisike; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.19",
            "verseOrgIds": [
              "DEU.21.19"
            ]
          }
        },
        {
          "name": "verse",
