              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etemarete kesi imakio luka ereke ebe, ‘Eninik okokukosi lo, ipaliono da, eŋerit arimar eporotokosi; erai otaupe, emerana da.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.20",
