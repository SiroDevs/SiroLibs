            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Arai ejaas etuŋanan aŋor aarei, komina adiopet, kolaite da adiopet, kourikinito da ŋes idwe, kesi aarei, naminat, ka naelaitai; ido arai erai ekiyai losapat loka ŋin naelaitai; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.15",
            "verseOrgIds": [
              "DEU.21.15"
            ]
          }
        },
