                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Italauni ikiyaik kere lukiliok lueuriete isipaninikon luka aituk ka amerekekin mama ejai EJAKAIT Ekonideke; siritwasamaenenei ikiyaikikon lumoŋin adioswam, karaida aitub ajul nuka ikiyaik luka esipanikon loka amerekekin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.19",
            "verseOrgIds": [
              "DEU.15.19"
            ]
          }
        },
