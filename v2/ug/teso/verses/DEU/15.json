            }
          ]
        },
        {
          "text": " “Arai ejai yenikican kajo, ediopet koinacanakon, koreriakon kere kakwapukon nakiinakinit jo EJAKAIT Ekonideke, sirikitininik ekonitau, karaida abunakin akonikan kaneejai onacekon lokican: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "verse",
