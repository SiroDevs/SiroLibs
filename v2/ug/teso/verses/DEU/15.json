                  "text": "16:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inyamanakini ŋes akonyen nuka EJAKAIT Ekonideke ŋolikaru kaibois naeseuni EJAKAIT, ijo ka ekonikal, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
