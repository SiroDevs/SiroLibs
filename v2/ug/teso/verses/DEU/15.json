            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.1"
              },
              "items": [
                {
                  "text": "Ikis 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai eŋwalit ŋesi adioŋwal kere, arai icoda, arai emudukana, aŋwal kere naerono, sirikiinak araun asubanit mama ejai EJAKAIT Ekonideke. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
