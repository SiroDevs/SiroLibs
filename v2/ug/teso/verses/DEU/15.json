            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye abeit ijaikini ŋes yenejai akanikon, abeit iinakini ŋes luitodolete eipudake koboro luilipit ŋesi. ",
          "type": "text",
          "attrs": {
