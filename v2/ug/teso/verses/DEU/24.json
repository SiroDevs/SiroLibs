                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Naiyuunia eidunyetekon idiobore, sirikiloma togoke aomare aititineteke. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
            "verseOrgIds": [
