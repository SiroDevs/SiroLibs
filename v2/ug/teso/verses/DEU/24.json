          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibwoi kokina eyaŋauni etuŋanan loiyuunit ijo kiborekon aititiŋet kina neijai ijo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.11",
            "verseOrgIds": [
              "DEU.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
