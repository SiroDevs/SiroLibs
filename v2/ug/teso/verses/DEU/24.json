                "loc": "MRK.10.4"
              },
              "items": [
                {
                  "text": "Mk 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Naeyaŋaaria etuŋanan aberu aimany, kosodi arai mam edumunit aminunio kakonyeneke, naarai edumunit ŋesi akirot naka ileic kamake, iwadikakini ŋes ebalua loka aireŋear, kititiŋ ŋes, kosodi aireŋear ŋes kotogoke. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyou ŋin kotogoke, epedori alosit adukokin etuŋanan ece. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai kela ŋes okilenike lokiareit, kosodi aiwadikakin ŋes ebalua loka aireŋear, kititiŋ ŋes, kosodi aireŋear kotogoke; arai da ketwana okilenike lokiareit loamanyit ŋes; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.1"
              },
              "items": [
                {
                  "text": "Yer 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okilenike losodit loereŋeari ŋes, mam emanyi ŋes bobo, naarai amunaun; naarai erai akirot ŋin naketal kakonyen nuka EJAKAIT: sirikitidiaka akwap nakiinakinit EJAKAIT Ekonideke airum.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
    {
