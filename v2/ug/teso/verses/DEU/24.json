            "sid": "DEU 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai erai ŋesi lokican, mam iperio aititineteke: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.12",
            "verseOrgIds": [
              "DEU.24.12"
            ]
