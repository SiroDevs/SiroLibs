          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kiituni ebe irai kolo ebulesit koMisiri, kolaku EJAKAIT Ekonideke jo kaŋina: kanuka ŋun kecorakinit jo aiswamaenen akirot ŋin,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
