            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.5.18"
              },
              "items": [
                {
                  "text": "Awa 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Naemanyia etuŋanan ateran, mam elomari kajore, karaida ainakinio adioswam kere; esalakini ore ekaru ediopet, aitalakar aberuke naamany. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.2"
              },
              "items": [
                {
                  "text": "Isa 47:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mam ituŋanan eyai akaŋas arai atapen araun aititiŋet: naarai eyait aijar naka ituŋanan araun aititiŋet.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
      ]
    },
