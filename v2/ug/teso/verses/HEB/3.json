              "type": "text"
            }
          ]
        },
        {
          "text": " Aso, iinacan lukalaunak, luimorete anyaraunio nakokuju, koomoomata Yesu, Ekiyakia ido Esasedoti lopeti lokilimonori oni. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.1",
            "verseOrgIds": [
