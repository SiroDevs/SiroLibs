              "items": [
                {
                  "text": "Gal 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai arai icasit akirot nakineras imalaikan, tape eropio kadolit ŋiniibucaret ka ŋiniiulanut, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.2",
            "verseOrgIds": [
              "HEB.2.2"
            ]
          }
        },
