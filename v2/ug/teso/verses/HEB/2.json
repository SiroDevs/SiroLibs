              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka ŋun ibusakinit oni aiyatakin noi aibwaikin itauon ŋun nukipupu, kenyeis aikaleleorio kamakec. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.1",
            "verseOrgIds": [
