              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai mam einakinit Edeke akwapin nueponito nukinera, anonokikin imalaikan. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.5",
            "verseOrgIds": [
              "HEB.2.5"
            ]
          }
        },
