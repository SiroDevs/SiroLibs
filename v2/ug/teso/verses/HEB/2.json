                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Edeke da abu kitejen nepepe kakes kotoma aanyuneta ka nukaumokin, ka nukapedor nuka iponesio luegelegela, kotoma akorakineta da nuka Emoyo Lokalaunan, kwape ejaar akoteke elopet.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.4",
            "verseOrgIds": [
              "HEB.2.4"
            ]
          }
        }
      ]
