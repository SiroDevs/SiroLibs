              "items": [
                {
                  "text": "12:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kikwaikini ai kikui oni arai kijali aitajario naetia nen? Abu Ejakait kogeu alimokin ŋin, kosodete lukiirarete ŋes apotu kitogogoŋoto mamawok, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.3",
            "verseOrgIds": [
              "HEB.2.3"
            ]
          }
        },
