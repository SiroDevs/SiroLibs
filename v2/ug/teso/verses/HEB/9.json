            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:19",
              "type": "text"
            },
            {
              "text": "esop eputosi bala emopim.",
              "type": "text"
            }
          ]
        },
        {
          "text": " da, kobwatanak eitabo ka ituŋa kere, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
