              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kobala ebe, “Nu kes aokot nuka aitutuket nukiicorakini yes Edeke,” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.20",
            "verseOrgIds": [
