            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun erai ekadiekan loka aitutuket nakitetet, tetere edumunete ŋul lukenyaraunitai aisumunet naka airumet naka ikar kere, naarai abu atwanare kojau naelakuni kes kotoma apaanareta nukotoma aitutuket nasodit. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai neejai aitutuket naka airum, ibusakinit kojai atwanare naka yenikitutuki ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai icasit aitutuket naka airum nakejaunia atwanare, naarai emamei ŋes agogoŋ arai eroko ejari yenikitutuki. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka ŋun kiton aitutuket nasodit da mam itaŋitai komameete aokot. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.18",
            "verseOrgIds": [
              "HEB.9.18"
            ]
          }
