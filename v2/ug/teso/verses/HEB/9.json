          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabo mere ainanakin bon irwan ipu, kwape elomanaria esasedoti lopeti Aibois Nakalaunan ŋolikaru kaokot numam eraas nuke; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.25",
