            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kedau Kristo abunore, loerai esasedoti lopeti loka akiro nuejok nuejaunete, kotoma owema loepol aitelekarit loitodolikinio jokan, lomam kiswamao kakanin, ŋes atemar ebe, mere loka akwap kana, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.11",
            "verseOrgIds": [
              "HEB.9.11"
            ]
          }
        },
