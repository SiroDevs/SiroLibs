                "loc": "2SA.10.4"
              },
              "items": [
                {
                  "text": "2 Sam 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.1.11"
              },
              "items": [
                {
                  "text": "Mik 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwape kwaŋin emearia ekabaka loka Asuria luijoreoritai koMisiri, ka luereŋearitai koEtiopia, ludidik ka lumoion, kimuialalas, komam enapitos idiobore kakejekec, komam erapap iwoos, aisurum Misiri ileic. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.4",
            "verseOrgIds": [
              "ISA.20.4"
            ]
          }
        },
