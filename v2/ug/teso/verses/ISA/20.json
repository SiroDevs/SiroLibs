              "type": "text"
            }
          ]
        },
        {
          "text": " Eburunete, irumete ileje, kanuka Etiopia amunokee, ka Misiti aibusesukec. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
            "verseOrgIds": [
              "ISA.20.5"
            ]
          }
