                {
                  "text": "Isa 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema EJAKAIT atiar, “Kwape kesakasakator Isaia ekakejaanakinan kimujalal, komam enapit idiobore kakejeke ikar iuni araun aanyunet ka nakaumokin koMisiri ka Etiopia da; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "verse",
