          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.8"
              },
              "items": [
                {
                  "text": "Sek 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.13"
              },
              "items": [
                {
                  "text": "Bur 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, eoŋ ka idwe lukainakinit EJAKAIT kirai aanyuneta, ka nukaumokin koIsirael nuepote kama ejai EJAKAIT loka ajoresio, loiboie komoru Sion.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        }
