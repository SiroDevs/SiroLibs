                "loc": "DAN.12.4"
              },
              "items": [
                {
                  "text": "Dan 12:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koen aitejenunet, kipuc da ikisila mama ejaas ikesisiakaka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.16",
            "verseOrgIds": [
              "ISA.8.16"
            ]
          }
        },
        {
