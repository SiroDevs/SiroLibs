              "items": [
                {
                  "text": "Isa 37:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na ŋes aanyunet mamakon naebuni kama ejai EJAKAIT, ebe iswamai EJAKAIT akirot ŋin naener: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koany, enyakari eoŋ etolim loejai ailameta, loisukunyarit akoloŋ ailameta nuka Akas aitoboŋor kau ailameta atomon.” Aso koboŋo akoloŋ ailameta atomon kailameta nealomaria ŋesi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        }
      ]
    },
