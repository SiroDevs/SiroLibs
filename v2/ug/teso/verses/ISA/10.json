            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen naedaunia rwaru EJAKAIT akeswam kere komoru Sion ka Yerusalem, eticani araito nuka etau loegogoŋ loka ekabaka loka Asuria, ka aiwoŋonut naka akonyeke nueomiara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.12",
            "verseOrgIds": [
              "ISA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
