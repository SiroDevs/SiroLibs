              "items": [
                {
                  "text": "Isa 37:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai atema atiar,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.13",
            "verseOrgIds": [
              "ISA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.19",
            "verseOrgIds": [
              "ISA.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen kapaaran kaŋin, mam bobo aatoŋot naka Isirael, ka ŋul da luideunos luka ekek loka Yakob egoŋakinos kaŋol kaloedanyi kes; konye egoŋakinos ka EJAKAIT, Lokalaunan loka Isirael, kabeit. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.20",
            "verseOrgIds": [
              "ISA.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eboŋuni aatoŋot, aatoŋot naka Yakob, neejai Edeke Lokapedor. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.21",
            "verseOrgIds": [
              "ISA.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.3"
              },
              "items": [
                {
                  "text": "Mik 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.27"
              },
              "items": [
                {
                  "text": "Rom 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai karaida kesubito ituŋakon Isirael bala asiŋe naka aŋolol, eboŋuni aatoŋot bon: inerunio amudiar, nailapara kadolit. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.22",
            "verseOrgIds": [
              "ISA.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.22"
              },
              "items": [
                {
                  "text": "Isa 28:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.27"
              },
              "items": [
                {
                  "text": "Dan 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai itodoli EJAKAIT, EJAKAIT loka ajoresio, amudiar nainerunio, kokidiŋ kakwap kere,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.23",
            "verseOrgIds": [
              "ISA.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.23",
            "verseOrgIds": [
              "ISA.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso inera kwanata EJAKAIT, EJAKAIT loka ajoresio ebe, “Wu yes ikatuŋa luibolete koSion, sirikikuriakaros Eyasuriat: karaida kiile yes kebela, ikiari esuretaiteke asurokin yes, kwape ejaar epone loko Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.24",
            "verseOrgIds": [
              "ISA.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "Dan 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai eriŋa esalit apak edit noi, itodolikinio aisiop ka anyunyuraka kamudiariokec. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.25",
            "verseOrgIds": [
              "ISA.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isidiki EJAKAIT loka ajoresio edaaset asurokin ŋes, kwape kearit loka Midian lokejai komoru Oreb: ejaun ekebela da kaŋolol, ikiari kwape ejaar epone loko Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.26",
            "verseOrgIds": [
              "ISA.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.15"
              },
              "items": [
                {
                  "text": "Sab 105:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen kapaaran kaŋin, enyouni abwokonike kokeperikon, ajookotoke komurisinikon, emudiario da ajookot kanuka ainyonyoikin akinyet.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.27",
            "verseOrgIds": [
              "ISA.10.27"
            ]
          }
        }
      ]
    }
