                "loc": "1KI.21.10"
              },
              "items": [
                {
                  "text": "1 Ika 21:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ketuboros apaarasia nuka epucitikee, kijuka Yob kitalau kes, kodilonokin anyounun tupuruc, koinanak ainakineta nuieweio kwape ketiaikee kere: naarai kobala Yob ebe, “Musiki adiakasi odweka, aiŋer Edeke toma otauonokec.” Kwape kwaŋin abu Yob kirueurue aiswamaenen.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.5",
            "verseOrgIds": [
              "JOB.1.5"
            ]
          }
        }
      ]
    },
