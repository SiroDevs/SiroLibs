          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ido koany, kobu ekwam loepol kamodiŋ, kinom agoria aoŋon nuka etogo, korapak ikatumunak, atwaka da; eoŋ bon aku alimokin jo.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.19",
            "verseOrgIds": [
              "JOB.1.19"
            ]
          }
        }
