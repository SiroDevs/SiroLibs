              "type": "text"
            }
          ]
        },
        {
          "text": "Eroko inera ŋesi, kobu eee da kotema atiar, “Anyamete ikonidwe lusap ka lupesur amasete da ebino kotogo loka onaeekee lokapolon: ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.18",
            "verseOrgIds": [
              "JOB.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
