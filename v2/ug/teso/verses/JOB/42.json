                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.2"
              },
              "items": [
                {
                  "text": "Isa 40:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kibelok EJAKAIT anatario naka Yob, naelipakinia ipaperoke: koinak EJAKAIT Yob irwan aarei adepar nul luaiaatar nasodit. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.19.13"
              },
              "items": [
                {
                  "text": "Yob 19:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete kopotu ikeinaean kere mama ejai, ka akeinaean kere, ka nul kere lukejenete nes sek lukenyamenenete atap kaŋes kotogoke: komonyata, kitalakasi ŋes kotoma aronis kere nakebu EJAKAIT koinu ŋes: ido koinak ŋinituŋanan ŋes atutubet naka epuesa, ka ŋinituŋanan egilut loka esabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.8.7"
              },
              "items": [
                {
                  "text": "Yob 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.3"
              },
              "items": [
                {
                  "text": "1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwaŋin kisireren EJAKAIT awasia naka Yob adepar ageuneteke: kojaunos kamererekekin alukumin atomon kaonon, ka akaalai alukumin akanykape, ka ajookon alukumit nuka imoŋin iareiarei ka asigirian alukumit. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.12",
            "verseOrgIds": [
              "JOB.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido kojaas kidwe lutelepai ikanykaarei ka lupesur iuni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.13",
            "verseOrgIds": [
              "JOB.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasodit komaik ekekiror Yemima; ekiror da loka nakiareit Kesia; ekiror da loka nakiwuniet, Keren-kapuk. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.14",
            "verseOrgIds": [
              "JOB.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotoma akwap kere amameete apesur nuajokuka aitelekar adwe nuka Yob: koinak papakec airumet kama kiinacanakec. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.26"
              },
              "items": [
                {
                  "text": "Yob 5:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokau kanun kobut Yob ikar akwatat ka akaisaoŋon, koany odweke, ka odwe luka odweke, kiton aturio aoŋon. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.8"
              },
              "items": [
                {
                  "text": "Age 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotwana do Yob, emojonit cut, edaunit apaarasia nuipu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
            "verseOrgIds": [
              "JOB.42.17"
            ]
          }
        }
