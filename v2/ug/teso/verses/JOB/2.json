        {
          "text": "Kojai bobo apaaran kopotu odwe luka Edeke aitodiar kakonyen nuka EJAKAIT, kobu Satan da nepepe kakes aitodiar kakonyen nuka EJAKAIT.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        }
