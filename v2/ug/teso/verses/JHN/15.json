              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kiswamakinete yes ŋun kere kanuka ekakiror, naarai mam ejenete lokejukunit, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.21",
            "verseOrgIds": [
              "JHN.15.21"
            ]
          }
