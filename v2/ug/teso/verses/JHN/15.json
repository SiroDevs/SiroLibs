              "type": "text"
            }
          ]
        },
        {
          "text": " Konye itodolikinio akirot naewadikatai kotoma okisilakec ebe, ‘Apotu kalaata atitai.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.25",
