          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai kemam abunit einer kakes, timam ejaas karonis; konye kwana mam eiyaros karonisikec. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.22",
