            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai kiraas lukakwap, tiemina akwap yenerai yenikeŋ; konye naarai mam iraas lukakwap, konye abu kaseu yes kotoma akwap, kanuka ŋun ŋes kilaia yes akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.19",
            "verseOrgIds": [
              "JHN.15.19"
            ]
          }
