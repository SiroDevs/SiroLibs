                {
                  "text": "1 Yok 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2JN.1.5"
              },
              "items": [
                {
                  "text": "2 Yok 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.30"
              },
              "items": [
                {
                  "text": "Mk 12:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Na ŋes akaicorakinet ebe Kominanaros, kwape abu kaminar yes, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.12",
            "verseOrgIds": [
              "JHN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.12"
              },
              "items": [
                {
                  "text": "Yok 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.16"
              },
              "items": [
                {
                  "text": "1 Yok 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emamei yenejaas kamin naepol aitelekarit na, ituŋanan ainakin akeijar kanuka ipaperoke. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.13",
            "verseOrgIds": [
              "JHN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.31"
              },
              "items": [
                {
                  "text": "Yok 8:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.50"
              },
              "items": [
                {
                  "text": "Mat 12:50",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.20"
              },
              "items": [
                {
                  "text": "28:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iraas yesi ikapapero arai iswamaete nukecorakini yes. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.14",
            "verseOrgIds": [
              "JHN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam kanyarit bobo ibulesin, naarai ebulesit mam ejeni nuiswamai ejakaitike, konye kanyara yes ikapapero, naarai ketejenu yes kere nueirarit kama ejai Papaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.15",
            "verseOrgIds": [
              "JHN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.70"
              },
              "items": [
                {
                  "text": "Yok 6:70",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.18"
              },
              "items": [
                {
                  "text": "13:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mere yes kiseunete eoŋ, dimarai eoŋ kaseu yes, kadakak yes tetere ilosete koraata araito, araitokus da kosalito; tetere nuilipete Papa kere kokirorika, kiinakini. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.16",
            "verseOrgIds": [
              "JHN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kecorakini yes ŋun tetere iminanaros.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.17",
            "verseOrgIds": [
              "JHN.15.17"
            ]
          }
        }
      ]
