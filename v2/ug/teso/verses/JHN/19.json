              "items": [
                {
                  "text": "18:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokau kaŋun, kojeni Yesu ebe aŋetakinos kere, tetere itodolikini nakiwadikatai kobala ebe, “Kajak akur.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "Sab 69:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kejai nen amot naeleleba ebino loedwar; kibwaikis acago naileleba ebino ŋol loedwar kuju akwara, kikiasi kiton aitukuke. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedau Yesu aijaikinio ebino loedwar, kobala ebe, “Aŋetakinos.” Kitulur akekou, kijaik ekemoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
      ]
    },
    {
