              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ediopet ka lutomon kaarei, ŋes Tomas lokenyaritai Didumo",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.24",
            "verseOrgIds": [
