            {
              "text": "20:24",
              "type": "text"
            },
            {
              "text": "Didumo apolouke Emuut.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mam kejaas kakes nakebunio Yesu. ",
          "type": "text",
