          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.1+GEN.22.2+GEN.22.3+GEN.22.4+GEN.22.5+GEN.22.6+GEN.22.7+GEN.22.8+GEN.22.9+GEN.22.10+GEN.22.11+GEN.22.12+GEN.22.13+GEN.22.14"
              },
              "items": [
                {
                  "text": "Age 22:1-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam kereka aponi kitojokai Aburaam papaawok araun loedolit kanuka aswamisio, naainakinia okokuke Isaaka kotem? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.21",
            "verseOrgIds": [
              "JAS.2.21"
            ]
          }
        },
        {
