      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitodikinai cani aiyuunikon komameete aswamisio, eoŋ da ketodikini jo akaiyuun kotoma aswamisio. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.18",
            "verseOrgIds": [
              "JAS.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JAS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.5.7"
              },
              "items": [
                {
                  "text": "Mk 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iyuunit ijo ebe erai Edeke ediopet; iswamai ejok. Iyuunete ajokin da, komaranete. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.19",
            "verseOrgIds": [
              "JAS.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijo etuŋanan lotai, ikoto kereka ajenun ebe aiyuun komameete aswamisio erai arakan? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.20",
            "verseOrgIds": [
              "JAS.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
