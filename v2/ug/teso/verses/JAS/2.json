                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai etube mam itimi ŋin yenimam iswamai nukaitim; naarai eoloboboi aitim kotube.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.13",
            "verseOrgIds": [
