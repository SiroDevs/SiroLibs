              "items": [
                {
                  "text": "Gal 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye inera idiotuŋanan ebe, “Ejai jo aiyuun, eoŋ da kija kaswamisio.”",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.18",
            "verseOrgIds": [
              "JAS.2.18"
            ]
          }
        }
