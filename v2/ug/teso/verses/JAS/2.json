                  "text": "Bur 11:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iany aiyuun kwape iswamaa nepepe kaswamisioke, ido etopoloor aiyuun kanuka aswamisio; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.22",
            "verseOrgIds": [
              "JAS.2.22"
            ]
          }
