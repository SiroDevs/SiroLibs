                "loc": "DEU.5.17"
              },
              "items": [
                {
                  "text": "Ikis 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ŋol loabu kiner ebe, “Siridote,” abu kiner da ebe, “Siriari.” Arai mam idotei, konye iari, iraun do ijo yenibili ikisila. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.11",
            "verseOrgIds": [
              "JAS.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.25"
              },
              "items": [
                {
                  "text": "Yak 1:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinerasi kwaŋin, kiswamata da kwaŋin, kwape luepote atubokinio akiro kokisila luka aosikinio. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.12",
            "verseOrgIds": [
              "JAS.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 2:13"
          },
          "items": [
