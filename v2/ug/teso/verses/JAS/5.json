                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ejai kereka yeniticanio kotomakus? Kilip. Ejai bo yenelakara? Koye nukaiturit. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.13",
