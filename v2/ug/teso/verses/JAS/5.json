            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.31.38+JOB.31.39+JOB.31.40"
              },
              "items": [
                {
                  "text": "Yob 31:38-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, iworoi eropit loka ikeswamak luasakata imanikoriakus, loimikitos yesi; aloma aimony naka ikadwenyak aki nuka Ejakait loka ajoresio. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.4",
            "verseOrgIds": [
              "JAS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.19"
              },
              "items": [
                {
                  "text": "Luk 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.12.3"
              },
              "items": [
                {
                  "text": "Yer 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ipotu kisiyalamikinos kakwap, kominakinito aboliasio; kitutumata ikusitauon kotoma apaaran naka aario. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.5",
            "verseOrgIds": [
              "JAS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipotu kitetelekasi akiro ekadoliton, koarata da; mam ŋes itepega yesi.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.6",
            "verseOrgIds": [
              "JAS.5.6"
            ]
          }
        }
      ]
    },
