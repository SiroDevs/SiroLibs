                  "text": "Mat 5:34-37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye nuitelekarito kere, ikainacan, siriyapoenenete, karaida alimit akuj, karaida akwap, karaida aiyaposit ace kere, konye akusikirot, “eebo,” korai eebo, ka “mam” da korai mam, kinyeis aibirokin atubokinio.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.12",
            "verseOrgIds": [
              "JAS.5.12"
            ]
          }
        }
      ]
    },
