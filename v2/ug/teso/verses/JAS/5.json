                "loc": "DAN.12.12"
              },
              "items": [
                {
                  "text": "Dan 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, kinyarit luetitiŋikinete luisirereŋitoi. Ipotu kiirasi nuka atitiŋikin naka Yob, ido ipotu koanyut kwape kiswamakinia Ejakait ŋes kawasia, kwape eraar Ejakait lokasianut naepol ka aitim.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.11",
            "verseOrgIds": [
              "JAS.5.11"
            ]
          }
        }
      ]
    },
