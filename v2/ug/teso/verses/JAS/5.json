                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.36"
              },
              "items": [
                {
                  "text": "Bur 10:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso iinacan, kotitiŋonokinete, kiton abunore naka Ejakait. Koany, idarit ekakorion araito nuka akwap nuketiai loepol, etitiŋikinit kes kiton ainakinio akiru naka aiporo ka naka akamu da. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.7",
            "verseOrgIds": [
              "JAS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.25"
              },
              "items": [
                {
                  "text": "Bur 10:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.2.16"
              },
              "items": [
                {
                  "text": "1 Ses 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.3.13"
              },
              "items": [
                {
                  "text": "3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotitiŋonokinete yesi da, kiticata itauonokus, naarai eapie abunore naka Ejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.8",
            "verseOrgIds": [
              "JAS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iinacan, siriŋuurianakinos, kinyeis atubokinio; koany, ebwoi ekatubon kokek. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.9",
            "verseOrgIds": [
              "JAS.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.12"
              },
              "items": [
                {
                  "text": "Mat 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iinacan, koyaŋaasi inabin araut aanyunet naka aiticanio ka atitiŋikin, luapotu kinerasi kokiror loka Ejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.10",
            "verseOrgIds": [
              "JAS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 5:11"
          },
          "items": [
