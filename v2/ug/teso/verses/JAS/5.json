              "items": [
                {
                  "text": "Luk 6:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso ca yes ikabarak, komonyata kibwololoto kanuka ican lukiponikinete yes, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.1",
            "verseOrgIds": [
              "JAS.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JAS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.19"
              },
              "items": [
                {
                  "text": "Mat 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abos abarakus, anyama ikajekel akusinapito. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.2",
            "verseOrgIds": [
              "JAS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JAS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.27"
              },
              "items": [
                {
                  "text": "Awa 16:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amasiki esabukus ka epuesakus, amasikinikec da eraun ajenanut mamakus, enyami awatekus kwape kakim. Ipotu kidiata iborokus luka akais nuipu toma apaarasia nukawasia. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.3",
            "verseOrgIds": [
              "JAS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.14+DEU.24.15"
              },
              "items": [
                {
                  "text": "Ikis 24:14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
