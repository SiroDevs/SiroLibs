              "attrs": {
                "loc": "MAL.3.5"
              },
              "items": [
                {
                  "text": "Mal 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.9"
              },
              "items": [
                {
                  "text": "Isa 5:9",
