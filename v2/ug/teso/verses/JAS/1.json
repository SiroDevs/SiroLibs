            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Isirereŋitoi etuŋanan loetitiŋikin acodunio, naarai kedau acamunio, edumuni aboko naka aijar naisumunikinit Ejakait lueminasi ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.12",
            "verseOrgIds": [
              "JAS.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyek yenecodunio einer ebe, “Edeke kacoduni eoŋ” naarai mam epedori Edeke acodunio kanukaronok, ido ŋes elopet mam ecoduni ituŋanan kere. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.13",
            "verseOrgIds": [
              "JAS.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.7+ROM.7.8+ROM.7.9+ROM.7.10"
              },
              "items": [
                {
                  "text": "Rom 7:7-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ŋinituŋanan ecodunio kiriite ekeimiel elopet kaijodijodio, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.14",
            "verseOrgIds": [
              "JAS.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kepotuu eimiel euriei adiakar, adiakar ŋin da kepoloor idouni atwanare.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.15",
            "verseOrgIds": [
              "JAS.1.15"
            ]
          }
        }
