            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.24"
              },
              "items": [
                {
                  "text": "1 Pet 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " koolobob lokabaran da kanuka aitisilioke, naarai eraraar kwape aturot naka inya. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.10",
            "verseOrgIds": [
              "JAS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai elomuni akoloŋ isirinyori amwanis inya, edoi aturotoke, eoliori da ajokis naka aputoke. Isokokoi lokabaran da kwape kwaŋin kotoma alositeke.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
            ]
