        },
        {
          "text": " Iinacanaka, koomitos kere araut nukaiyalama, naidoioto toma acodunio nakiponesio luipu, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.2",
            "verseOrgIds": [
