            }
          ]
        },
        {
          "text": " Arai ejai kayes yenewolikinit acoa, kilip Edeke loeinakini kere kajalit, kwabo mam itoroni, ŋes da einakinio. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
