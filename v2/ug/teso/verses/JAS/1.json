              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye koolobob onace loitisilitoi kanuka aitopoloorioke, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.9",
            "verseOrgIds": [
              "JAS.1.9"
