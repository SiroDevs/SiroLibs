          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti ibusakinit ijo ainakin akapesan mama ejaas ikeŋadak arupian, eoŋ da kabu tikadum nuaraas nukaŋ ka amedakec da. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.27",
            "verseOrgIds": [
              "MAT.25.27"
            ]
          }
        },
