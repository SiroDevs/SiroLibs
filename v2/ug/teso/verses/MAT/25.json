          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi etemari ekabaka lukakanike nakoteten atiar, ‘Kopotu yesi lukisirereŋit Papaka, kirumata ajakanut nakitemonokinitoi ameun kaisub akwapin; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
