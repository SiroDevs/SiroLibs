          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso kodemasi ŋes atalat, koinakis ŋol loeiaas atalatan atomon. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
