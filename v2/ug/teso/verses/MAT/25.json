                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanen eboŋokini ekabaka ebe, ‘Abeit katemari yes atiar, Kwape kiswamakiniata idiopet kalu iinacanaka ludidik, ipotu kiswamakis eoŋ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.40",
            "verseOrgIds": [
              "MAT.25.40"
            ]
          }
        },
        {
