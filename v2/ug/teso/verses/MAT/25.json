              "type": "text"
            }
          ]
        },
        {
          "text": "Konye Koboŋok ejakaitike kotema atiar, ‘Ebulesit ijo loerono loeloŋwana! Ibu kojen ebe adwenyi kama nemam ayeikinit, atukonokini da kanemam esiarakinit; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
