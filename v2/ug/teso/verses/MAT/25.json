                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " etukonokinos atekerin kere akonyeneke, etiakatiakai ŋesi kes kwape etiakatiakaa ekecokon amerekekin ka akinei: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
