                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.15+JHN.6.16+JHN.6.17+JHN.6.18+JHN.6.19+JHN.6.20+JHN.6.21"
              },
              "items": [
                {
                  "text": "Yok 6:15-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atipet kitiŋaik ikekesisiak adokar ataker aiŋarenikin ŋes okekwa juwai, naarokor ŋesi etwari ikodeta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.22",
            "verseOrgIds": [
              "MAT.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.12"
              },
              "items": [
                {
                  "text": "Luk 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.18"
              },
              "items": [
                {
                  "text": "9:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kedau ŋesi aitwar ikodeta, kodoka oroŋat neejaikinor bon ailip. Kitiboŋ akwap, kojai ŋina bon. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.23",
            "verseOrgIds": [
              "MAT.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kedaunit ataker aikwaŋar neelwana koitolima kibukete akailan; naarai kekutunit ekwam kakonyen, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.24",
            "verseOrgIds": [
              "MAT.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakwenyunet nakiwoŋonet naka akuar kobu Yesu mama ejaas, kicakacakai aŋolol, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.25",
            "verseOrgIds": [
              "MAT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.37"
              },
              "items": [
                {
                  "text": "Luk 24:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye nakeanyuniata ikesisiak ŋes icakacakai aŋolol, kiyaloŋoŋoto, kotemasi atiar, “Erai etoil” Kiworoto kanuka akurian. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.26",
            "verseOrgIds": [
              "MAT.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atipet kiner Yesu kakes kotema atiar, “Kotitiŋioros! Eoŋ lo, sirikikuriakaros.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.27",
            "verseOrgIds": [
              "MAT.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.27",
            "verseOrgIds": [
              "MAT.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok Petero kotema ŋes atiar, “Ejakait, arai erai jo ŋol, kicorakinai kabu mama ijai kokuju akipi.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.28",
            "verseOrgIds": [
              "MAT.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema atiar, “Bia,” Kodoku Petero kataker, kicakacakai akipi alosit mama ejai Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye nakeanyunia ekwam, kokurianar, kogeu alumor, kiworo ebe, “Ejakait, kitajarai.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.30",
            "verseOrgIds": [
              "MAT.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.26"
              },
              "items": [
                {
                  "text": "Mat 8:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atipet korio Yesu akekan kitiŋ ŋes, kotema atiar, “Ijo loedit aiyuun, kanukinyo ibuonokinor?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.31",
            "verseOrgIds": [
              "MAT.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedokasi kesi ataker kopala ekwam. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.32",
            "verseOrgIds": [
              "MAT.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komaata ŋes lukejaas toma ataker kotemasi atiar, “Abeit irai ijo Okoku Ioka Edeke.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.33",
            "verseOrgIds": [
              "MAT.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.33",
            "verseOrgIds": [
              "MAT.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedaut aikwaŋar juwai, kodoloto akwap naka Genesaret. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.34",
            "verseOrgIds": [
              "MAT.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kejenut ituŋa luka aibois kaŋin, koramata luka akwap ŋin kere, koinut ŋes lukadekak kere. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.35",
            "verseOrgIds": [
              "MAT.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.21"
              },
              "items": [
                {
                  "text": "Mat 9:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.19"
              },
              "items": [
                {
                  "text": "Luk 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiŋaiŋaata ŋes acamakin kes atironor atwele naka anapitoke bon; koŋaleutu kere luketirorete.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.36",
            "verseOrgIds": [
              "MAT.14.36"
            ]
          }
