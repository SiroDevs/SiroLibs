                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.10+LUK.9.11+LUK.9.12+LUK.9.13+LUK.9.14+LUK.9.15+LUK.9.16+LUK.9.17"
              },
              "items": [
                {
                  "text": "Luk 9:10-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.1+JHN.6.2+JHN.6.3+JHN.6.4+JHN.6.5+JHN.6.6+JHN.6.7+JHN.6.8+JHN.6.9+JHN.6.10+JHN.6.11+JHN.6.12+JHN.6.13"
              },
              "items": [
                {
                  "text": "Yok 6:1-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiira Yesu ŋun, konyou kanen kotoma ataker, kolot amodiŋ neejaikinor bon, Kiirasi ikodeta, kotupasi ŋes itorito kaneeonit anyoun koreria, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.13",
            "verseOrgIds": [
              "MAT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.36"
              },
              "items": [
                {
                  "text": "Mat 9:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kelom Yesu koany ekodet loepol; kitim kes, kitaŋaleu lukadekakakec. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.14",
            "verseOrgIds": [
              "MAT.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiboŋ akwap, kopotu ikekesisiak mama ejai, kotemasi ŋes atiar, “Aibois na erai amodiŋ, atuboto isawan; aso, kotwar ikodeta tetere elomanarete okialon agwel inyamat.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.15",
            "verseOrgIds": [
              "MAT.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Yesu atiar, “Mam ipudasi alosit; koinakis yesi kes lunyaman.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.16",
            "verseOrgIds": [
              "MAT.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotemasi ŋes atiar, “Emamei sio idiobore kane dimarai imugatin ikany ka lukecor iarei.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.17",
            "verseOrgIds": [
              "MAT.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema atiar, “Koinunai.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.18",
            "verseOrgIds": [
              "MAT.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicorak ikodeta aiboikin anya; kolem imugatin lukany, ka lukecor luarei, kosesen akuj, kisirereŋ, kobilibil imugatin, koinak ikesisiak, koinakis ikesisiak da ikodeta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.19",
            "verseOrgIds": [
              "MAT.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.44"
              },
              "items": [
                {
                  "text": "2 Ika 4:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyama kere kimonikinos. Kotukonokinai atutubeta nuabilibila nuasalete iditai itomon ka luarei ileleba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.20",
            "verseOrgIds": [
              "MAT.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukenyamete emwaasi bala ikiliok ilukumin ikany, kilema aŋor ka idwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.21",
            "verseOrgIds": [
              "MAT.14.21"
            ]
          }
        }
      ]
    },
