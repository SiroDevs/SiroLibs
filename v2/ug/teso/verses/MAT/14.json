        },
        {
          "text": " Kapaarasia kaŋun kiira ekabaka Kerode eemut loka Yesu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.1",
            "verseOrgIds": [
              "MAT.14.1"
            ]
          }
        },
        {
