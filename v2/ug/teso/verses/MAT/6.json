            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kiŋadanakinete kanukus abar akuj, nemam emunaariata ikajekel ka amasikin, ido nemam ebokiata ikokolak ka akokwaar da. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.20",
            "verseOrgIds": [
              "MAT.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
