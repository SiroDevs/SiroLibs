          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai nepejai akonibar, nepenen ejaikin ekonitau da.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.21",
            "verseOrgIds": [
              "MAT.6.21"
