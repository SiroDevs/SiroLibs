            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Siriŋadanakinete kanukus abar akwapin, neemunaariata ikajekel ka amasikin da, ido neebokiata ikokolak ka akokwaar. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
