                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ido nailipiata sirinyogonyogoete akiro atai, kwape ka Imo; naarai eomitos ebe iirario kanuka akirokec nuipu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.7",
            "verseOrgIds": [
              "MAT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.32"
              },
              "items": [
                {
                  "text": "Mat 6:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso sirikiputokinos kaŋul: naarai ejeŋi Papakus nuipudasi yesi, eriŋa kilipa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.8",
            "verseOrgIds": [
              "MAT.6.8"
            ]
          }
        }
