        },
        {
          "text": "“Atala naka akuan ŋes akoŋu: aso arai eteni akonikoŋu, akonikuan kere ecauni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.15"
              },
              "items": [
                {
                  "text": "Mat 20:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai erono akonikoŋu, akonikuan kere emutono. Aso arai emutono aica naejai kotomakon, epol ca ma amuton ŋin! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.23",
            "verseOrgIds": [
              "MAT.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
