            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bobo da nailuŋiata, siriraas kwape lukesoswai luinyorididos ireeta; naarai emunaunete ireetakec, tetere etakanete kotuŋa ebe eluŋete. Abeit katemari yes atiar, Adaut adumun eropitikec. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye jo, nailuŋia, kinyonyoenenei akinyet akoukon, kilosi da akonikonyen, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "tetere mam itakanuni kotuŋa ebe iluŋi, dimarai Papakon lokaiyeiyea: Papakon da loeseseni kaiyeiyea, kiropi jo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.18",
            "verseOrgIds": [
              "MAT.6.18"
            ]
          }
        }
      ]
    },
