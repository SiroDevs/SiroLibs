                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolomasi Musa ka Aaron mama ejai Parao, kiswamata kwaŋin kwape kicorakinia EJAKAIT: kocakak Aaron ekebela akonyen nuka Parao, akonyen da nuka ikekejaanakinak, koluor emun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.10",
            "verseOrgIds": [
              "EXO.7.10"
            ]
