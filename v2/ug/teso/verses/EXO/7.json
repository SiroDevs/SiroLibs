          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kocakak ninitunanan ekebela koluonoros imunwo: konye kilikono ebela loka Aaron ibelaikec. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.12",
            "verseOrgIds": [
