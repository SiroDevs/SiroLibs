              "type": "text"
            }
          ]
        },
        {
          "text": " Ejenunete Imisirian ebe Eoŋ EJAKAIT, naarioria akakan Misiri, aitolomar idwe luka Isirael kamakec.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.5",
            "verseOrgIds": [
              "EXO.7.5"
            ]
          }
