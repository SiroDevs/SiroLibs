          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswamata Musa ka Aaron kwaŋin; kwape kicorakinia kes EJAKAIT, kiswamata kwaŋin, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.6",
