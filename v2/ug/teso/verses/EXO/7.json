        },
        {
          "text": " Kosodi Parao da anyaraun lukacoa ka ikacudak; kes imurwok luka Misiri, kiswamata kesi da kwaŋin kakececoa nakaiyeiyea. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.11",
            "verseOrgIds": [
              "EXO.7.11"
            ]
          }
        },
