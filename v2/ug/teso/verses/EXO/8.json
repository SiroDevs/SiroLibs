            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atiakuni da kapaaran kaŋin akwap nako Gosen, naiboioto ikatuŋa, kinyeis icuc luipu noi ajaut nina; tetere ijenuni ebe Eoŋ EJAKAIT loajai kidin kakwap, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
