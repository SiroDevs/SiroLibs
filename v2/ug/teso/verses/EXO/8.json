          ]
        },
        {
          "text": "Kosodi Parao anyaraun Musa ka Aaron, kobala ebe, “Koloto yesi, koinakis Ekusideke asuban kotoma akwap.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
