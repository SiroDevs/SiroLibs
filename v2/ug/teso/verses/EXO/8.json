          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyou Musa kaneaiai Parao, kilip EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.30"
            ]
          }
