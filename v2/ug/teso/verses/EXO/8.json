              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Parao ebe, “Kesiikini yes alosit, ainakin EJAKAIT Ekusideke asuban kamodiŋ; konye mam ilosete neelwana: kilipakinai eoŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
              "EXO.8.28"
            ]
          }
        },
        {
