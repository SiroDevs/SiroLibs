                  "text": "Awa 21:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye keanyu Parao ebe ejai apak nakibworaret, kitogogon eketau, komam iirari kes; kwape abalar EJAKAIT.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
