              "type": "text"
            }
          ]
        },
        {
          "text": "Ebwaikini atiaket kidin otunaka ka ituŋakon: ejaun aanyunet na moi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
