              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kilosi alosit naka apaarasia auni modiŋ, ainakin asuban mama ejai EJAKAIT Ekosideke, kwape kicorakinia ŋesi sio.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
