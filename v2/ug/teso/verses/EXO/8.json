            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyout Musa ka Aaron kama ka Parao: komony Musa mama ejai EJAKAIT kanuka aidodokai nuainunit Parao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.12",
            "verseOrgIds": [
              "EXO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosub EJAKAIT kwape ajaar akirot naka Musa; kotwakikis aidodokai otogoi, alaroi, ka amanat. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.13",
            "verseOrgIds": [
              "EXO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotukonoroi atukon: kouru akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.14",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        },
        {
