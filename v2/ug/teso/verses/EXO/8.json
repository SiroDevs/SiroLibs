          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Musa atiar, “Koany, alomari kaneijai, elipi EJAKAIT konyout ieuc moi kaneejai Parao, ka ikejaanakinakake, ka iketuŋa: konye kinyek Parao aiŋal bobo aiŋer aisiikin ituŋa alosit ainakin EJAKAIT asuban.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
