              "items": [
                {
                  "text": "Apu 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiner bobo ebe, “Eoŋ Edeke loka papakon, Edeke loka Aburaam, Edeke loka Isaak, Edeke loka Yakob da.” Kibwa Musa akekonyen; naarai abu koyoŋ asesen Edeke.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.6",
            "verseOrgIds": [
              "EXO.3.6"
            ]
          }
        }
      ]
