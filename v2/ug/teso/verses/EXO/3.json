              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.5"
              },
              "items": [
                {
                  "text": "Age 11:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.51"
              },
              "items": [
                {
                  "text": "Any 12:51",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.25"
              },
              "items": [
                {
                  "text": "Ikis 1:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.27"
              },
              "items": [
                {
                  "text": "Mar 13:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Adokunit ayuun kes kakan naka Imisirian, aitonyoun kes kakwap kaŋin aitolomar akwap naejok, naelal, akwap naeleleete akile ka esik; aibois naka Ekanaanit, ka Ekitit, ka Emorait, ka Eperisit, ka Ekibit, ka Eyebusit. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.8",
            "verseOrgIds": [
              "EXO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.11"
              },
              "items": [
                {
                  "text": "Any 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso koany, kadoloki aimony naka idwe luka Isirael: bobo da aany aroikinit naeroikinitotor Imisirian kes. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.9",
            "verseOrgIds": [
              "EXO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.26"
              },
              "items": [
                {
                  "text": "Sab 105:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.6.4"
              },
              "items": [
                {
                  "text": "Mik 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bia do, keyakia neejai Parao, kitolom ikatuŋa idwe luka Isirael koMisiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.10",
            "verseOrgIds": [
              "EXO.3.10"
            ]
          }
