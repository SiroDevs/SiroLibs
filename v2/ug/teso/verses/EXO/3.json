            }
          ]
        },
        {
          "text": " Kiner EJAKAIT ebe, “Aany eut aiticanio naka ikatuŋa luejaas Misiri, eira akeceimony kanuka ŋul kaluitwasamacte kes; naarai ajeni ikececan: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.7",
            "verseOrgIds": [
              "EXO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 3:8"
          },
          "items": [
