            }
          ]
        },
        {
          "text": " Kobala Musa Edeke ebe, “Iŋai bo eoŋ, loalosi neejai Parao? aitolomun idwe luka Isirael koMisiri?’’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.11",
            "verseOrgIds": [
              "EXO.3.11"
            ]
          }
        },
