              "items": [
                {
                  "text": "21:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do kolot, ajaenena eoŋ kakoniituk, kesisianakini nuinera.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.12",
            "verseOrgIds": [
              "EXO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.3"
              },
              "items": [
                {
                  "text": "Yok 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema atiar, “Wu EJAKAIT, keŋaiŋait, kijuka ŋol loikoto aijukar.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.13",
            "verseOrgIds": [
              "EXO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinep anyunyura naka Edeke aluikin Musa, kiner atiar, “Emamei Aaron onacekon Elebit? Ajeni ebe epedori ener ejok. Ido koany, ebunit airiamun kajo; kiiany jo iyalamikin kotauke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.14",
            "verseOrgIds": [
              "EXO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.23.12"
              },
              "items": [
                {
                  "text": "Mar 23:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.18"
              },
              "items": [
                {
                  "text": "Ikis 18:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.51.16"
              },
              "items": [
                {
                  "text": "Isa 51:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.9"
              },
              "items": [
                {
                  "text": "Yer 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.31"
              },
              "items": [
                {
                  "text": "Ikis 5:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ineri ijo kaŋes, ipiikini da akiro aitukuke: eoŋ da ajaenena kakoniituk, ka akeituk, kesisianakinete nuiswamaete. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.15",
            "verseOrgIds": [
              "EXO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.1"
              },
              "items": [
                {
                  "text": "Any 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.18.19"
              },
              "items": [
                {
                  "text": "18:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eraun ŋesi ekeneranikon kama ejaas ituŋa; kosodi eraun ŋesi akoniituk, iraun ijo da kamake kwape Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.16",
            "verseOrgIds": [
              "EXO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itiŋi ijo ebela lo kakanikon, aiswamaa aanyuneta.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.17",
            "verseOrgIds": [
              "EXO.4.17"
            ]
          }
        }
      ]
    },
