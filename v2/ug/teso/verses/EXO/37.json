        },
        {
          "text": " Abu kiswamau etem lokisupuruunet lukisupurununo loka akito nuka sita: aojauke ekubit, alalauke da ekubit, loka agoria aoŋon nueriakanara; amukururuke ikubitin iarei; amumwarake araas nuka ibore idiopet kaŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.25",
            "verseOrgIds": [
              "EXO.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
