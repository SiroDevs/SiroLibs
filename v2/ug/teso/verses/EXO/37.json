              "items": [
                {
                  "text": "Any 25:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kiswamau eicolon-Iokaitim loka esabu loelai, aojauke ikubitin iarei ka atutubet, alalauke ekubit ka atutubet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.6",
            "verseOrgIds": [
              "EXO.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kiswamau ikerubin iarei luka esabu: aswam naerukuk ŋes eswamaunia, kosaneta iarei luka eicoloŋ-lokaitim. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.7",
            "verseOrgIds": [
              "EXO.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekerubi ediopet osaŋe ediopet, ka ekerubi ece da osaŋe ece: kiswamau eicoloŋ-lokaitim ka ikerubinike koraas luka ibore idiopet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.8",
            "verseOrgIds": [
              "EXO.37.8"
            ]
          }
