                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kiswamau iboro luajaas omesa, atubaake, ka akaaleike, ka atanyake, ka amotiike, abukununio, nuka esabu loelai.",
          "type": "text",
          "attrs": {
