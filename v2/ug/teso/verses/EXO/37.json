                "loc": "REV.4.5"
              },
              "items": [
                {
                  "text": "4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kiswamau atalaike, akanykaarei, ka aitudeŋetake ka asaninike nuka ekurwon, nuka esabu loelai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.23",
            "verseOrgIds": [
