              "items": [
                {
                  "text": "Esk 9:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, napadwari, kotwana Pelatia okoku loka Benaia. Kasodi kebiror ebuburia, keworo keporoto loepol kabala ebe, “Wu okwe, Ejakait EDEKE! Itanani teni ijo eut aatoŋot naka Isirael?”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.13",
            "verseOrgIds": [
              "EZK.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.13",
            "verseOrgIds": [
              "EZK.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.14",
            "verseOrgIds": [
              "EZK.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoku loka etuŋanan, iinaeanakon, eeba, iinacanakon, ituŋa luka atekerikon, ka ekek kere loka Isirael, kes ŋul luapotu luibojete koYerusalem kolimokis ebe, ‘Kikunyasi kaneejai EJAKAIT; kiinakinitai sio akwap na araun airumet.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.15",
            "verseOrgIds": [
              "EZK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.31.20"
              },
              "items": [
                {
                  "text": "Sab 31:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
