                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bobo da kadaku Emoyo, kayau orute lokokide loka etogo loka Ejakait, loaseseni kide, Ido koany, okirigi loka erute ajaas ituŋa akaisaarei kalukany; kaany kokidinikec Yaasania okoku loka Asur, ka Pelatia okoku loka Benaia, ikapolok luka ituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.1",
            "verseOrgIds": [
              "EZK.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katema eoŋ atiar, “Okoku loka etuŋanan, lu kes ituŋa luepwakete numam adolit, lueinakinete ainerun naerono kore kalo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.2",
            "verseOrgIds": [
              "EZK.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.13"
              },
              "items": [
                {
                  "text": "Yer 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Luebalas ebe, ‘Eroko apak edolo aiduk itogoi: ere lo ŋes amot, oni da kirai akiriŋ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.3",
            "verseOrgIds": [
              "EZK.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso kodwarak kes, kodwar, ijo okoku loka etuŋanan.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.4",
            "verseOrgIds": [
              "EZK.11.4"
            ]
          }
        }
      ]
    },
