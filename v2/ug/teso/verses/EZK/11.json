              "items": [
                {
                  "text": "Bur 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kadoik emoyo loka EJAKAIT, katema eoŋ atiar, “Kiner ebe, Inera EJAKAIT kwanata ebe: Ibu kiner kwanata ijo ekek loka Isirael; naarai aleni akiro nuelomarete otauonokus. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.5",
            "verseOrgIds": [
              "EZK.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itupuata iaranakus kore kalo, ilelebata da irotinike iaran. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.6",
            "verseOrgIds": [
              "EZK.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.3"
              },
              "items": [
                {
                  "text": "Mik 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do inera EJAKAIT EDEKE kwanata ebe: Iaranakus luiperionokinito kidinike, kes akiriŋ, ere lo da amot: konye kilemario yes anyoun kotomaken, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.7",
            "verseOrgIds": [
              "EZK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.24"
              },
              "items": [
                {
                  "text": "Awa 10:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iyonito ekileŋ; konye ebala Ejakait EDEKE ebe, Kainunete ekileŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.8",
            "verseOrgIds": [
              "EZK.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.30"
              },
              "items": [
                {
                  "text": "Sab 106:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kalemari yes kokidinike, keiaikini yes akanin nuka imo, etodolikini da itubesia kamakus. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.9",
            "verseOrgIds": [
              "EZK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.6"
              },
              "items": [
                {
                  "text": "Yer 39:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.25"
              },
              "items": [
                {
                  "text": "2 Ika 14:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.9.16"
              },
              "items": [
                {
                  "text": "Sab 9:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kibirori ekileŋ; katubokini yes koikor loka Isirael; ijenunete da ebe arai eoŋ EJAKAIT, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.10",
            "verseOrgIds": [
              "EZK.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.6"
              },
              "items": [
                {
                  "text": "Yer 39:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam ere lo eraun akusimot, ido mam iraunete akiriŋ kotomake; katubokini yes koikor loka Isirael; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.11",
            "verseOrgIds": [
              "EZK.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.30"
              },
              "items": [
                {
                  "text": "Ikis 12:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.10"
              },
              "items": [
                {
                  "text": "Esk 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iienunete da ebe arai eoŋ EJAKAIT: naarai mam ipotu kolosenenoto kokisilaka, ido mam itodolito ikatubesia, konye iswamata kwape ejaatar itubesia luka atekerin nukirimorito.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.12",
            "verseOrgIds": [
              "EZK.11.12"
            ]
          }
        }
      ]
    },
