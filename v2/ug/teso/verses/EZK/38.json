                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.13"
              },
              "items": [
                {
                  "text": "Esk 34:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.1"
              },
              "items": [
                {
                  "text": "36:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.6"
              },
              "items": [
                {
                  "text": "Yer 23:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akaulo kapaarasia nuipu kianyanario: ikar lukawasia ibuni kiton akwap naenyakunio kairum naka ekileŋ, akwap nakitukonokinere ituŋa anyoun katekerin nuipu, oroŋan luka Isirael, luaraas lueswapito due: konye itolomunio iketuŋa katekerin, iboikinos iyamakina, kes kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.8",
            "verseOrgIds": [
              "EZK.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.2"
              },
              "items": [
                {
                  "text": "Isa 28:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.13"
              },
              "items": [
                {
                  "text": "Yer 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Idokari, ibuni bala ekwam loepol, iraun bala edou arapakin akwap, ijo ka ikonikodeta kere, ka ituŋa luipu luejaas kajo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.9",
            "verseOrgIds": [
              "EZK.38.9"
            ]
          }
        }
      ]
