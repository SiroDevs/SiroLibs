            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kitemokin, eebo kitemokin ijo ka atukon kere nuetukokina mamakon, koraun ijo ekedaranikec, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.7",
            "verseOrgIds": [
