                "loc": "DEU.4.30"
              },
              "items": [
                {
                  "text": "Ikis 4:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.6"
              },
              "items": [
                {
                  "text": "Isa 29:6",
