          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido etopoloor ketalaun da, eteienun bon kakonyen nuka atekerin nuipu. Ejenunete do ebe arai eoŋ EJAKAIT.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.23",
