          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala Ejakait EDEKE ebe, Kosodi kanen kapaaran kaya, naebunio Gog asurokin akwap naka Isirael, elomari akadedeŋ okumesika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.18",
            "verseOrgIds": [
