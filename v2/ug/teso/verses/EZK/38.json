              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.8"
              },
              "items": [
                {
                  "text": "Apu 20:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoku loka etuŋanan, kite Gog, loka akwap naka Magog, ekapolon loka Ros, ka Mesek ka Tubal, kodwarak ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.2",
            "verseOrgIds": [
              "EZK.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiner ebe, Inera kwanata Ejakait EDEKE ebe: Koany, arai lokasurupikon, ijo Gog, ekapolon loka Ros, ka Mesek ka Tubal. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.3",
            "verseOrgIds": [
              "EZK.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.4"
              },
              "items": [
                {
                  "text": "Esk 29:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.12"
              },
              "items": [
                {
                  "text": "23:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kebelokini jo, kebwaikini igolun abokonyakon, ketolomuni jo ka akonijore kere, ibalasin ka ikebwanenok, kere luenapitos lujiis luilosikino, atukot naepol naejaas iupalin, ka ibukwi, ekapito kere ikileŋa: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.4",
            "verseOrgIds": [
              "EZK.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perusia, ka Kus, ka Put nepepe kakes; ejaas kere ibukwi ka akopiran. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.5",
            "verseOrgIds": [
              "EZK.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.2"
              },
              "items": [
                {
                  "text": "Age 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.14"
              },
              "items": [
                {
                  "text": "Esk 27:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gomer, ka ikekodeta kere; ekek loka Togarama owaitin lukosane loka agolitomei, ka ikekodeta kere: ituŋa luipu luejaas kajo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.6",
            "verseOrgIds": [
              "EZK.38.6"
            ]
          }
        }
      ]
