        },
        {
          "text": "Kobu akirot naka EJAKAIT mama ajai ebc: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.1",
            "verseOrgIds": [
              "EZK.38.1"
            ]
          }
