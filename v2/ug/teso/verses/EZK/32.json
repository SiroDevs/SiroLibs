              "items": [
                {
                  "text": "Esk 27:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ejai nen Mesee, ka Tubal, ka ekeeekodet kere; irimorito kes akeeeilin: kes kere lumam ekepitai lueari ekileŋ: naarai ayaunete etasurokee akwap naka ikajarak. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.18"
              },
              "items": [
                {
                  "text": "Isa 14:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido mam eperete nepepe kalukapedor luebiroros lumam ekepitai luejesaros Okatwak ekapito luiiisikec, ibwaikinito ikileŋakec aicolon kakwesikee, ejaas numam adolitekec akoiokec; naarai keiai etasuro loka lukapedor kakwap naka ikajarak. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kibilakinio kidin kalumam ekepitai, iperi nepepe kanul kalueari ekileŋ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        }
      ]
    },
