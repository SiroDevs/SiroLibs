                "loc": "EZK.34.18"
              },
              "items": [
                {
                  "text": "34:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Okoku loka etuŋanan, kokuudianik Parao ekabaka loko Misiri, kolimok ŋes ebe:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
