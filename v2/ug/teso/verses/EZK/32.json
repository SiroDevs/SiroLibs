        },
        {
          "text": "Kosodi kanen kokaru lokitomonet kaarei, kolap lokitomonet kaarei, kapaaran nasodit naka elap, kobu akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
