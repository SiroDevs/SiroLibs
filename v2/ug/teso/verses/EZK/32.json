            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.17"
              },
              "items": [
                {
                  "text": "Esk 26:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala Ejakait EDEKE ebe, Na ŋes akuudian rtaekuudianete; ekuudianete apesur nuka atekerin; ekuudianikinete Misiri ka ekekodet kere.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        }
