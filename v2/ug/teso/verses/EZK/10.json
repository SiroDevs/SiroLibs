                "loc": "REV.4.2"
              },
              "items": [
                {
                  "text": "Apu 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi kete, ido koany, kapak nakeiai kuju kakwes nuka ikerubin, kotakan kokujukec, naasubit bala amoru naka asapiro, bala atakan naka aput naka eicoloŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
