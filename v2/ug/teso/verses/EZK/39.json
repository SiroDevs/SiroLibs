            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iŋinyete awat nuka ikagogoŋok, idiŋaete da aokot nuka ikapolok luka akwap, nuka imerekekin, ka imerekekin ludidik, ka nuka akinei, ka imoŋin lutoba, kes kere luetarioko luko Basan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.18",
            "verseOrgIds": [
              "EZK.39.18"
            ]
          }
        },
        {
