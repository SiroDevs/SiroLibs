            "sid": "EZK 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ininyete atarion kimonikinos, idiŋaete da aokot komerikinos, kasubanit naetemokinit yes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
