            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi abunore mama ejaas lukijoreoritono Tel-abib, lueboiete kariri naka ecor Kebar, neiboioto, Keboikin mamakee etirirai apaarasia akanykaarei,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
