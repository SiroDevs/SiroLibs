            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kadaka eoŋ Emoyo, keira kokauka eporoto loka aunya naepol, inera ebe, Kituritete aibuses naka EJAKAIT kaiboisike. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.12",
            "verseOrgIds": [
              "EZK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keira eporoto loka abebenoka nuka isuban lukajarak eretonokinos, ka eporoto loka akokoron kosiepikee, eporoto loka aunya naepol. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
