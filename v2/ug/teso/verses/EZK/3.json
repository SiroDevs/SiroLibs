                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai ikwenyari ikaronon, kogiri aibelokin ainyein akeronis, karaida anyoun korotoke loerono, etwanikini toma numam adoliteke; konye kitajarite ijo akoniiiar. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.19",
            "verseOrgIds": [
