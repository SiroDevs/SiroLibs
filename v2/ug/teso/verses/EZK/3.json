                "loc": "2KI.3.15"
              },
              "items": [
                {
                  "text": "2 Ika 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kadaka eoŋ Emoyo, kayana: kalot kakadakinit, komulai ekatau, kicasite da akan naka EJAKAIT kamakaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.14",
            "verseOrgIds": [
              "EZK.3.14"
            ]
          }
        },
