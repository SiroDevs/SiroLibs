                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naelomanariata isasedotin aibois nakalaunan, mam bobo elomunete alaro nakokina koroko elaeara inapenekee luejaanakiniata; naarai eraas lukalaunak: asa enapenenete inapen ice tetere ikunyakinete ŋin naka ituŋa.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        }
      ]
