        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erot lokeiai kinarenikec aputos bala atakanu naka erot loka agolai nuetereildna agolitomei; kwape ajaar aojaukee, ekoni nen alalaukec ido alomaretakee kere aputos kotoma asubuniokee, ka ikiriginikec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido kwape ikekia luka agolai nuetereikina eŋalakimak, kejai ekek kageunet naka erot, ŋes erot loajai kiŋaren karwatat, atereikina kide arai ilomari tomakec.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        }
      ]
    },
