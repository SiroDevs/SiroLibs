              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.18"
              },
              "items": [
                {
                  "text": "Sab 83:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.20"
              },
              "items": [
                {
                  "text": "Isa 37:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.25.5"
              },
              "items": [
                {
                  "text": "Esk 25:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eario apesuruke nuejaas orony kekilen, Ejenunete do ebe arai eoŋ EJAKAIT,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        }
      ]
    },
