                  "text": "Yok 3:4-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoku loka etuŋanan, naarai enerak Turo Yerusalem ebe, ‘Uus, abila nol Iokerai erute loka ituŋa; ebelokin neaiai: elelebun do, naarai kwana eswap ŋesi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.2",
            "verseOrgIds": [
              "EZK.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso inera kwanata Ejakait EDEKE ebe: Koany, ijo Turo, kasurokini jo, ketonyoikini atekerin nuipu, kwape itonyounio aŋolol akekailan, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.3",
            "verseOrgIds": [
              "EZK.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emudiarete kesi arwatatin nuka Turo, ka atiyatiya itogoike lueojak; ekisari apuake, etuluori atiiba naelapat. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.4",
            "verseOrgIds": [
              "EZK.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.32"
              },
              "items": [
                {
                  "text": "Esk 27:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.19+MAT.4.20+MAT.4.21"
              },
              "items": [
                {
                  "text": "Mat 4:19-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala Ejakait EDEKE ebe, Eraun aibois naeterarere iboyan kokidin aŋolol: naarai eoŋ ŋes ener: eraun ŋesi enatat loka atekerin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.5",
            "verseOrgIds": [
              "EZK.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 26:6"
          },
          "items": [
