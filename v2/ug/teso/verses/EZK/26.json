                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido etanaŋi eoŋ eporoto loka ikososiokon; mam iirario bobo aruo naka adeudeunokon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.13",
            "verseOrgIds": [
              "EZK.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido ketuluori atiiba naelapat: iraun aibois naeterarere iboyan; mam kidukio bobo, Naarai ebala Ejakait EDEKE ebe, Eoŋ EJAKAIT ener.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        }
      ]
    },
