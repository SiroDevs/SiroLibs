        },
        {
          "text": "Kosodi kanen kokaru lokitomonet kadiopet, kapaaran nasodit naka elap, kobu akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
