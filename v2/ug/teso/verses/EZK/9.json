              "attrs": {
                "loc": "ISA.29.15"
              },
              "items": [
                {
                  "text": "Isa 29:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi katema atiar, “Ipu noi numam adolit nuka ekek loka Isirael ka Yuda, elelebun akwap da aokot, elelebun ere da etube loerii: naarai ebalasi ebe, ‘Enyek EJAKAIT akwap, ido mam EJAKAIT eanyuni.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.9",
            "verseOrgIds": [
              "EZK.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.41"
              },
              "items": [
                {
                  "text": "Ikis 32:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eoŋ da, mam akakoŋu isionie, ido mam etimi, konye etebei akeeeswamisio akwesikee.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        }
      ]
