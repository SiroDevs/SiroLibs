              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu bobo akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.1",
            "verseOrgIds": [
              "EZK.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.6"
              },
              "items": [
                {
                  "text": "Isa 13:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoku loka etuŋanan, kodwar, kiner ebe, Inera kwanata Ejakait EDEKE ebe:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.19",
            "verseOrgIds": [
              "EZK.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen kokaru lokitomonet kadiopet, kolap losodit, kapaaran nakikanyetekaarei naka elap, kobu akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.20",
            "verseOrgIds": [
              "EZK.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.25"
              },
              "items": [
                {
                  "text": "Yer 48:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.11"
              },
              "items": [
                {
                  "text": "46:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoku loka etuŋanan, abil eoŋ akan naka Parao ekabaka loko Misiri; ido koany, mam eenitai aisutakin ekia, karaida aider, tetere ejaun agogoŋ aitin ekileŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.21",
            "verseOrgIds": [
              "EZK.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.37.17"
              },
              "items": [
                {
                  "text": "Sab 37:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.7"
              },
              "items": [
                {
                  "text": "2 Ika 24:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do inera kwanata Ejakait EDEKE ebe: Koany, arai eoŋ lokasurup loka Parao ekabaka loko Misiri, ido abili akekanin kere, ŋin naegogon, ka nin da naebilil; etodoi ekileŋ kotoma akanike. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.22",
            "verseOrgIds": [
              "EZK.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.12"
              },
              "items": [
                {
                  "text": "Esk 29:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido esiarisiari Imisirian toma atekerin, eweliweli da anatar akwapin, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.23",
            "verseOrgIds": [
              "EZK.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etogogoŋi akanin nuka ekabaka loko Babulon, ebwaikini ekakileŋ toma akanike: konye abili akanin nuka Parao, idinya ŋesi kakonyeneke kwape etuŋanan loimusunitai noi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.24",
            "verseOrgIds": [
              "EZK.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.5"
              },
              "items": [
                {
                  "text": "Any 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.30"
              },
              "items": [
                {
                  "text": "Yer 44:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.9.16"
              },
              "items": [
                {
                  "text": "Sab 9:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.59.13"
              },
              "items": [
                {
                  "text": "59:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido egaŋi akanin nuka ekabaka loko Babulon, ibiroros do akanin nuka Parao; ejenunete do ebe arai eoŋ EJAKAIT, Naebwaikinia ekakileŋ toma akan naka ekabaka loko Babulon, edakakini ŋesi asurokin akwap nako Misiri, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.25",
            "verseOrgIds": [
              "EZK.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esiarisiari Imisirian toma atekerin, eweliweli da anatar akwapin. Ejenunete do ebe arai eoŋ EJAKAIT.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.26",
            "verseOrgIds": [
              "EZK.30.26"
            ]
          }
        }
      ]
    }
