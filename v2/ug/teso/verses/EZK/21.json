                "loc": "AMO.1.3+AMO.1.4+AMO.1.5+AMO.1.6+AMO.1.7+AMO.1.8+AMO.1.9+AMO.1.10+AMO.1.11+AMO.1.12+AMO.1.13+AMO.1.14+AMO.1.15"
