      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolac egoe lokienieni akou, koou aboko: mam bobo ejaunos ŋun kwaŋin: kitopoloo yenejai kwap, kitisil yenejai kuiu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.26",
            "verseOrgIds": [
              "EZK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.10"
              },
              "items": [
                {
                  "text": "Age 49:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abuburiari, abuburiari, abuburiari: mam bobo nun ejaunete, aitodol neabunio elopet: ido ainakini ŋes.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.27",
            "verseOrgIds": [
