                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.12"
              },
              "items": [
                {
                  "text": "Esk 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aso do ijo okoku loka etuŋanan, kodwar, kibap akanin; kitetemono ekileŋ irwan aarei, eebo irwan auni, ekileŋ loka nul kalueario; ŋes ekileŋ loka earit loepol, loiriamarit kes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebwaik emidet loka ekileŋ oruteikec kere, tetere eburunete ikecetauon, kiyatanakinete aiguikin. Wu okwe! etusubi bala eimilia, eisitai aaria, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.15",
            "verseOrgIds": [
              "EZK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.17"
              },
              "items": [
                {
                  "text": "Esk 14:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitemokin, kojep teten; kiderakin, kojep kediany; nen kere neebeit akwanisikon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.16",
            "verseOrgIds": [
              "EZK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.22.13"
              },
              "items": [
                {
                  "text": "Esk 22:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.16.42"
              },
              "items": [
                {
                  "text": "16:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.63"
              },
              "items": [
                {
                  "text": "Ikis 28:63",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.24"
              },
              "items": [
                {
                  "text": "Isa 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebapi eoŋ da akakanin, esimoni akanyunyura: eoŋ EJAKAIT ener.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu bobo akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.18",
            "verseOrgIds": [
              "EZK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ijo da, okoku loka etuŋanan, kitodik irotin iarei, luebunio ekileŋ loka ekabaka loko Babulon; elomunete nul iarei kakwap adiopet. Kigir aibois, kigir neegeunitor eror loebei ore. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.19",
            "verseOrgIds": [
