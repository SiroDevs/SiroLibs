          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.20.30"
              },
              "items": [
                {
                  "text": "1 Ika 20:30",
