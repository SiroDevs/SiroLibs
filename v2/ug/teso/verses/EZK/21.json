                  "text": "Age 13:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋo da, lokaronon Ioimusuŋitai cut, ekapolon loka Isirael, kidolok apaaranikon, apak naka aiticaniokon nakawasia; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.25",
            "verseOrgIds": [
              "EZK.21.25"
            ]
          }
        },
