            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.1",
            "verseOrgIds": [
              "EZK.21.1"
            ]
          }
        },
        {
