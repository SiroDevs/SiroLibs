                {
                  "text": "Yer 49:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitodik erot loka ekileŋ abunore Raba loka idwe luka Amon, ka Yuda kotoma Yerusalem loebwaitai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.20",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ebwoi ekabaka loko Babulon kaneetiakar erot, neegeunitotor irotin iarei, airo: ilamilami imalia, kinit iterapim,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.21",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:21",
              "type": "text"
            },
            {
              "text": "iterapim kes aputosia nuka idekesio.",
              "type": "text"
            }
          ]
        },
        {
          "text": " koro emany. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.21",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
