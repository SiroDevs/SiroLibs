              "items": [
                {
                  "text": "Yer 51:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.4.2"
              },
              "items": [
                {
                  "text": "Esk 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kakanike nakoteten eroet loka Yerusalem, aitemokin akuta nutiyanakinet, awoon aituk aiar, aikeseun eporoto keibwon, aitemokin akuta nutiyanakinet orutei, aitut itutio, aiduk arwatatin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.22",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.13"
              },
              "items": [
                {
                  "text": "Esk 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eraun kamakec bala aidwar naatai kakonyenekec, luiyapoikinete aiyaposio: konye isiituni kes numam adolit, tetere ikamunio.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        }
