                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.42.6"
              },
              "items": [
                {
                  "text": "Yob 42:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keitunete ŋul luekuete kayes kotoma atekerin kama ijoreoritai, kadau aibil itauonokec ludotea luanyoutu kamakaŋ, ka aitumudak akonyenekec nuelosete eporo kaputosiakec; ekadakinete kesi kanuka aronisio nueswamata, ka italesiakec kere, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.9",
            "verseOrgIds": [
              "EZK.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejenunete ebe arai eoŋ EJAKAIT: mam ener atai ebe eswamakini kes aronis nin.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.10",
            "verseOrgIds": [
              "EZK.6.10"
            ]
          }
        }
      ]
    },
