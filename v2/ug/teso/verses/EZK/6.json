                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inera kwanata Ejakait EDEKE ebe: “Kodip kakanikon, kopet kakejekon, kinera ebe, Wu okwe! Kanuka italesia kere lueroko luka ekek loka Isirael: naarai ibiroros kekileŋ, ka eteŋei, ka atular da. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.11",
            "verseOrgIds": [
              "EZK.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenelwana etwani atular; yeneapie eari ekileŋ; ka yenesali irigaunitai etwani eteŋei. Kwaŋin etodolikini akadedeŋ mamakec, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.12",
            "verseOrgIds": [
              "EZK.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
