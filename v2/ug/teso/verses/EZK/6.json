          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Konye do etasali aatoŋot, Naarai ijaunete kice luekuete ekileŋ kotoma atekerin, nakisiarakinere akwapin, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.8",
            "verseOrgIds": [
              "EZK.6.8"
            ]
          }
        },
