              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.1",
            "verseOrgIds": [
              "EZK.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.1"
              },
              "items": [
                {
                  "text": "Esk 36:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoku loka etuŋanan, kite ironan luka Isirael, kodwarak kes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.2",
            "verseOrgIds": [
              "EZK.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.30"
              },
              "items": [
                {
                  "text": "Leb 26:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiner atiar, Yes ironan luka Isirael, kiiras akirot naka Ejakait EDEKE! Inera kwanata Ejakait EDEKE ironan ka iukon, isama ka aditon da ebe: Koany, eoŋ, eoŋ obe, kainuni yes ekileŋ, amudiari aiboisiokus nuiceleleete. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.3",
            "verseOrgIds": [
              "EZK.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.28"
              },
              "items": [
                {
                  "text": "Yer 44:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.5.2"
              },
              "items": [
                {
                  "text": "Esk 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.5.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Itisilio itemwanakus, ebilibilio aputosiakus nuka akoloŋ: acakakini ituŋakus lueario akonyen nuka aputosiakus. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.4",
            "verseOrgIds": [
              "EZK.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido eperikini atesin nuka idwe luka Isirael akonyen nuka aputosiakee; esiarisiari da akojokus airimor itemwanakus. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.5",
            "verseOrgIds": [
              "EZK.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iswapete ireriakus kotoma aiboisiokus kere, itisilio aiboisio nuiceleleete; tetere iswapete itemwanakus, itisilio, ebilibilio aputosiakus edaunos, ejepejepeo aputosiakus nuka akoloŋ, emwatario da akusiswamisio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.6",
            "verseOrgIds": [
              "EZK.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibirokinos lueario kidiŋikus, ijenunete da ebe arai eoŋ EJAKAIT.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.7",
            "verseOrgIds": [
              "EZK.6.7"
            ]
          }
        }
      ]
    },
