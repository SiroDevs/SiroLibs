            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.141.7"
              },
              "items": [
                {
                  "text": "Sab 141:7",
