            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Konye naeponenenata ituŋa luka akwap kakonyen nuka EJAKAIT kopucin lueseunitai, ŋol loelomanari korot lokorute loka agolitomei aima, elomununei korot lokorute loka eŋalakimak; ŋol da loelomanari korot lokorute loka eŋalakimak, elomununei korot lokorute loka agolitomei: mam ebononori korot lokorute loalomaria, konye itori lokoinarenike, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.9",
            "verseOrgIds": [
              "EZK.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naelomanariata ituŋa, elomanari ekapolon da kakes, ido naelomununiata, elomununei ŋesi da.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.10",
            "verseOrgIds": [
              "EZK.46.10"
            ]
          }
        }
