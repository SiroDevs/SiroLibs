            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido naitemonokinia ekapolon ainakinet naka akote, ainakinet naicweio, arai ainakineta nuka ainapakin araut ainakinet naka akote mama ejai EJAKAIT, eŋaanakinio erute loeseseni kide, itemonokini da ainakineteke naicweio ka ainakinetake nuka ainapakin, kwape iswamaenenaa kasabaton. Kosodi do elomuni, kedau alomun egolenenoo erute.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.12",
            "verseOrgIds": [
              "EZK.46.12"
            ]
          }
        }
