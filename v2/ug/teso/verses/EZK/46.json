        },
        {
          "text": "Kosodi ketolom alaro nakokina ketotor agoria aoŋon nuka alaro; ido koany, kojai alaro toma ŋinigor. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.21",
