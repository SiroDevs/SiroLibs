          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kagoria aoŋon nuka alaro, kejaas alaroi nuedisiak nukebwaitai, aoiaukec ikubitin akaisaoŋon, alalaukec da ikubitin akaisauni: ŋun aoŋon nukejaas agoria keraas nuka aitemisioit adiopet. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
