        },
        {
          "text": " “Inera kwanata Ejakait EDEKE ebe: Egolio erute loka alaro nakotoma loeseseni kide apaarasia akanykape nuka aswam; konye eŋaanario kasabato, kapaaran da nailamunia elap eŋaanario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.1",
            "verseOrgIds": [
              "EZK.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
