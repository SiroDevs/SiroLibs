          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.1.21"
              },
              "items": [
                {
                  "text": "2 Pet 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.3.15"
              },
              "items": [
                {
                  "text": "2 Ika 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kobu teni akirot naka EJAKAIT mama ejai Esekiel esasedoti, okoku loka Busi, kakwap naka Ikaludean, kariri naka ecor Kebar; kojau akan naka EJAKAIT mamakeŋ kaŋina.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        }
      ]
