                  "text": "Dan 10:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atakan naka akokoron ka aswamukee asubit bala ejese loka aberulo: ido kere aoŋon araas nuka aput adiopet: asubit atakanukec ka aswamukec bala akokoro kotoma akokoro, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "name": "verse",
