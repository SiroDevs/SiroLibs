            }
          ]
        },
        {
          "text": " Kosodi napaseseni isuban lukajarak, abu kaany akokoro kalup kosiep kisuban lukajarak, akokoro kaninidiopet kakesi luonon. ",
          "type": "text",
          "attrs": {
