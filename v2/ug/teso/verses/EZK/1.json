            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido naalosenenoto isuban lukajarak, kolosencnete akokoron kosiepikee: ido naetonyoununere isuban lukaiarak kalup, kitonyoununio da akokoron. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
