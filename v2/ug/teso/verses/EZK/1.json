            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kidiŋ kisuban lukajarak kojai ibore yenesubit bala atotol nuesaranete akim, bala akalasia; kirimi kokidiŋ kisuban lukajarak: asarani akim, kolom eimilia kakim. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.13",
