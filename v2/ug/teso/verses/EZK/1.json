            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ajaas akokoron ireren, ajaas da ipirin; kileleba akonye airimor ireren nul iwoŋon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.18",
