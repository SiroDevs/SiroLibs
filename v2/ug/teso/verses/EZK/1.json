              "attrs": {
                "loc": "EZK.10.14"
              },
              "items": [
                {
                  "text": "Esk 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Apu 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Asubito ireetakee kwanata, ajai ŋillidiopet ereet loka etuŋanan; ido ŋul luoŋon ajai ŋinidiopet ereet loka eŋatuny kosiep lokoteten; ido ŋul luoŋon ajai ŋinidiopet ereet loka emoŋ kosiep lokokediany; ŋul luoŋon da ajai ŋinidiopet creet loka emorukaalet. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 1:11"
          },
          "items": [
