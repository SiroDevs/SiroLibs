                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikubitin ilukumin ikany luideuna kalalau, ka akaisaarei ka lukany kaoiau, eraunos luebeete ituŋa kere, luka ere, aiboienenoo ka araut ironyia. Ejaun ere kidinike; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nu kes aitemisioke; kowai loka agolitomei ikubitin ilukumin iwonon ka akwat akany, kowai loka eŋalakimak ilukumin iwonon ka akwat akany, kowai lokokide ilukumin iwonon ka akwat akany, kowai da loko to ilukumin iwonon ka akwat akany. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eiaunete ere ironyia; kari naka agolitomei ikubitin akwat aarei ka akaisakany, kari naka eŋalakimak akwat aarei ka akaisakany, kari nakokide akwat aarei ka akaisakany, kari nakoto da akwat aarei ka akaisakany. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luideuna kaoiau kowai loka ainakinet nakalaunan ikubitin ilukumin itomon kide, ka ilukumin itomon to; idunyasi kainakinet nakalaunan. Amioke da eraunos inyamat luka nul luiswamaete kore. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.5"
              },
              "items": [
                {
                  "text": "Apu 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋul da luiswamaete kore, luka atekerin kere nuka Isirael ekorienenete. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
