            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.12"
              },
              "items": [
                {
                  "text": "Apu 21:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " emaikinio irutei luka ere ikiroria luka atekerin nuka Isirael; irutei iuni kari naka agolitomei; erute loka Reuben, ka erute loka Yuda, ka erute loka Lebi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kari nakokide ikubitin ilukumin iwonon, ka akwat akany; ka irutei iuni; erute loka Yosep; ka erute loka Benyamin; ka erute loka Dan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kari naka eŋalakimak, ikubitin ilukumin iwonon, ka akwat akany; ka irutei iuni; erute loka Simeon; ka erute loka Isakar; ka erute loka Sebulun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kari nakoto ikubitin ilukumin iwoŋon, ka akwat akany; ka iruteikec iuni; erute loka Gad; ka erute loka Aser; ka erute loka Naputali. ",
          "type": "text",
          "attrs": {
