            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nu kes alomanareta nuka ere; kari naka agolitomei ikubitin ilukumin iwonon, ka akwat akany kaitemisioit: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
