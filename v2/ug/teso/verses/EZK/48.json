          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koikor loka Simeon, ageun kokide kiton to; Isakar, akorakinet adiopet. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
