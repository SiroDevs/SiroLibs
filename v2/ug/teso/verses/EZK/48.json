          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koikor loka Isakar, ageun kokide kiton to; Sebulun, akorakinet adiopet. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
