          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibwokete da aitieanet naka numam adolitekec: aitieanet naka enabi erianakin cut kaiticanet naka nol kalokiŋisit ŋes. ",
          "type": "text",
          "attrs": {
