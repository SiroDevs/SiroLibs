                {
                  "text": "Yud 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ninitunanan yenikokek loka Isirael, arai ycnika imo luibojete kotoma Isirael, yenegitar kama ajai, koyana akeputosia kota uke, kibwaik ekomyo loka numam adoliteke kakonyeneke, kobu mama ejai enabi aiŋitun eoŋ: eoŋ EJAKAIT elopet ŋes aboŋokini; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.7",
            "verseOrgIds": [
              "EZK.14.7"
            ]
          }
        },
        {
          "name": "verse",
