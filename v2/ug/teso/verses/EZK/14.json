        },
        {
          "text": " ido etogogoŋi akakonyen mama ejai ituŋanan nin, etuluori da aumokinet, araun aanyunet ka awaragan, agelari da kokidin otunaka; iienunete do ebe arai eoŋ EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.8",
            "verseOrgIds": [
              "EZK.14.8"
            ]
          }
        },
