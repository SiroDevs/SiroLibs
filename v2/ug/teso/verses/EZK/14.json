            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete kopotu ice komakio luka Isirael mama ajai, kiboikinos kakonyeneka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.1",
            "verseOrgIds": [
