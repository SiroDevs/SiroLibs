              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyilununei da itabalanakus, ayuuni ikatuŋa kakanikus, mam bobo eiaunete akaninikus amejao; ijenunete do ebe arai eoŋ EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.21",
            "verseOrgIds": [
