            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naasesenia da, koany, koriunoi akan mama ajai; ido koany, kojai anunuket naka eitabo toma; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.9",
