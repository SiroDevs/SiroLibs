                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kalimok eoŋ atiar, “Okoku loka etuŋanan, keiukari jo mama ejaas idwe luka Isirael, mama ejaas atekerin nuipalioko, nukepaliikis eoŋ: kes ka lukapapaakec da apaasi kamakaŋ, kiton lolo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.3",
            "verseOrgIds": [
              "EZK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
