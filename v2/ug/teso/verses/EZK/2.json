              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.7"
              },
              "items": [
                {
                  "text": "Esk 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elepaakata idwe da, ido aninikata itauon; kejukari mama ejaas nul: kolimok kes atiar, ‘Inera kwanata EJAKAIT EDEKE.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.4",
            "verseOrgIds": [
              "EZK.2.4"
            ]
          }
        },
