            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kes da, arai iirarete, arai eŋerete akiirar, (naarai eraas ekek lokepali) ejenunete kereka kwape ajaar enabi kidinikec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.5",
            "verseOrgIds": [
              "EZK.2.5"
            ]
          }
