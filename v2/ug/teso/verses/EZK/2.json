              "type": "text"
            }
          ]
        },
        {
          "text": " Koloma emoyo tomaka nakinerar keoŋ, kesibwo kakakeje; keira ŋol lokinera keoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.2",
            "verseOrgIds": [
