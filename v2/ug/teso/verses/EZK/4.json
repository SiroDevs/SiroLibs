              "items": [
                {
                  "text": "Yok 4:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kolem aiwowas naka asuat, kibwaik araun arwatat naka asuat kidiŋikon ka ere: kotereik akonikonyen neejai, asa irigaunio do, ijo da irigauni ŋes, Eraun nin aanyunet mama ejai ekek loka Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.3",
            "verseOrgIds": [
              "EZK.4.3"
            ]
          }
        }
