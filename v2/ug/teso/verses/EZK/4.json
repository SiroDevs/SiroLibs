        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.8",
            "verseOrgIds": [
              "EZK.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kolem da enano, ka esairi, ka imare, ka ekao, ka akima, ka imumwa da, kibwaik kes obore idiopet, kono atap; inyamenenei nin apaarasia kere nuiperenenoo kosiepikon, kes apaarasia akwat auni ka akaisakanykaoŋon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.9",
            "verseOrgIds": [
              "EZK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itemenenoo ŋinipaaran inyamat luinyamenenei isekelin ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.10",
            "verseOrgIds": [
              "EZK.4.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:10",
              "type": "text"
            },
            {
              "text": "esekel ŋes apesa, konye itemi da alaŋir",
              "type": "text"
            }
          ]
        },
        {
          "text": " akaisaarei: inyamenenel irwan atipet ninipaeran. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.10",
            "verseOrgIds": [
              "EZK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imasenenei akipi nuitemio, idiopet kokanykape yenika ekin: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.11",
            "verseOrgIds": [
              "EZK.4.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:11",
              "type": "text"
            },
            {
              "text": "ekin itemi nueliyak.",
              "type": "text"
            }
          ]
        },
        {
          "text": " imasenenei irwan atipet ninipaaran. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.11",
            "verseOrgIds": [
              "EZK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyamenenei bala aluŋuren nuka esairi, ipei da kacin nuka ituŋa kakonyenekec.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.12",
            "verseOrgIds": [
              "EZK.4.12"
            ]
          }
        },
