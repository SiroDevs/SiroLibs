            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi eoŋ atemar atiar, “Wu okwe Ejakait EDEKE! Koany, mam lem akaijar emunaaritai; naarai ameun koiditeuka kiton kwana mam anyamenenei ŋin yenetwani, karaida yenepoopoot etiaŋ; akiriŋ da naketal mam elomanari aitukuka.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
