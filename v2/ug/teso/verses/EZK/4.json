        },
        {
          "text": "“Tio da, okoku loka etuŋanan, kolem amatapalit, kibwaik akonyenekon, kigir aput naka ere Yerusalem: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.1",
            "verseOrgIds": [
              "EZK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kirigau, koduk arwatatin asurokinia, kitutu itutio; kiswama iidukurun asurokinia, kibwaik akuta nutiyanakinet airimor. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.2",
            "verseOrgIds": [
              "EZK.4.2"
            ]
          }
        },
