              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.5.3"
              },
              "items": [
                {
                  "text": "Sek 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.5.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.5"
              },
              "items": [
                {
                  "text": "Mal 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswamakini kes nu, ketajarata kes; kinyek anyunyura abunokin oni, kanuka aiyaposit nakipou keyapoikis kes.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.20",
            "verseOrgIds": [
              "JOS.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.11"
              },
              "items": [
                {
                  "text": "Ikis 29:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotemasi ikapolok kes atiar, “Ketaiarata kes:” kwaŋin koraunos ikebetak akito ka ikeritok akipi nuka ekodet kere; kwape alimokinitotor ikapolok kes.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.21",
            "verseOrgIds": [
              "JOS.9.21"
            ]
          }
        }
      ]
