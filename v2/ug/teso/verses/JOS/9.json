                {
                  "text": "38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswamata kesi da kapirianut, koloto kijoseikis bala araas ikiyakia, koyaŋaasi ipukoi lumoion kasigirianakee, ka imukulen luka ebino, lumoion ka lueeilieila luedonyodonyo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.4",
            "verseOrgIds": [
              "JOS.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka amuk numoion nuepedepedo kakejekee, konapitos inapen lumojon; inyamat kere da luajaatar aokito kirourounito. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.5",
            "verseOrgIds": [
              "JOS.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.5.10"
              },
              "items": [
                {
                  "text": "Yos 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloto neajai Yosua Giligal oidukurun, kotemasi ŋes ka ituŋa luka Isirael atiar, “Kiponi isio kakwap naelwana: asa kitutukoto do yesi kasio.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.6",
            "verseOrgIds": [
              "JOS.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.32"
              },
              "items": [
                {
                  "text": "Any 23:32",
                  "type": "text"
                }
              ]
            },
