                "loc": "2SA.21.2"
              },
              "items": [
                {
                  "text": "2 Sam 21:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisumun Yosua kes ainapakin, kitutuk kakes, aitaiar kes: kiyapoikis ikapolok luka ekodet kes.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.15",
            "verseOrgIds": [
              "JOS.9.15"
            ]
          }
        }
      ]
    },
    {
