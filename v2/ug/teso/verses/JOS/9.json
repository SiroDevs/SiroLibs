              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.15",
            "verseOrgIds": [
              "JOS.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen ketuboros apaarasia auni kedaut kesi aitutuk kakes, apotu kesi kopuput ebe eraas nul iidunyetakee, ebe da eapie bukee kakes. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.16",
            "verseOrgIds": [
              "JOS.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.25"
              },
              "items": [
                {
                  "text": "Yos 18:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.2.25"
              },
              "items": [
                {
                  "text": "Esr 2:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolototo idwe luka Isirael, kodoloto oreriakee apaaran nakiwuniet. Ireriakec kes lu, Gibeon, ka Cepira, ka Beerot, ka Kiriat-yearim, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.17",
            "verseOrgIds": [
              "JOS.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.15.4"
              },
              "items": [
                {
                  "text": "Sab 15:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam apotu idwe luka Isirael kodanyata kes, naarai apotu ikapolok luka ekodet kiyapoikis kes kolimito EJAKAIT, Edeke loka Isirael. Kirurumak ekodet kere ikapolok. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.18",
            "verseOrgIds": [
              "JOS.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kotemasi ikapolok kere ekodet kere ebe, “Kipou keyapoikis kes kalimito EJAKAIT, Edeke loka Isirael: kanuka ŋun mam kipedori atiror kes. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.19",
            "verseOrgIds": [
              "JOS.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.21.1"
              },
              "items": [
                {
                  "text": "2 Sam 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.13+EZK.17.14+EZK.17.15+EZK.17.16+EZK.17.17+EZK.17.18"
              },
              "items": [
                {
                  "text": "Esk 17:13-18",
                  "type": "text"
                }
              ]
            },
