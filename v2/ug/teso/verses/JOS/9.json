              "items": [
                {
                  "text": "Tub 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotemasi ituŋa luka Isirael Ikibin atiar, “Musiki eapie bukus kasio; kikwaikini isio ai kitutuki kayes?” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.7",
            "verseOrgIds": [
              "JOS.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.11"
              },
              "items": [
                {
                  "text": "Ikis 20:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.5"
              },
              "items": [
                {
                  "text": "2 Ika 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotemasi Yosua atiar, “Kirai isio ikonikejaanakinak.” Kotema Yosua kes atiar, “Lukanai yesi? Ido lali bo kiponiata?” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.15"
              },
              "items": [
                {
                  "text": "Ikis 20:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.14"
              },
              "items": [
                {
                  "text": "Any 15:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.10"
              },
              "items": [
                {
                  "text": "Yos 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotemasi ŋes atiar, “Apote ikonikejaanakinak kakwap naelwana noi kanuka ekiror loka EJAKAIT Ekonideke: naarai kipupu eemutuke, kanun kere nuabu ŋesi kiswama koMisiri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.9",
            "verseOrgIds": [
              "JOS.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.21+NUM.21.22+NUM.21.23+NUM.21.24+NUM.21.25+NUM.21.26+NUM.21.27+NUM.21.28+NUM.21.29+NUM.21.30+NUM.21.31+NUM.21.32+NUM.21.33+NUM.21.34+NUM.21.35"
              },
              "items": [
                {
                  "text": "Mar 21:21-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kere da nuabu ŋesi kiswamak ikabakan iarei luka Imorain, luajaas okekwa loka Yorodan, Sikon ekabaka loka Kesibon, ka Og ekabaka loka Basan loajai Asitarot. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.10",
            "verseOrgIds": [
              "JOS.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu imakiokosi kere ka luibojete kere kakwapukosi kotemasi sio atiar,, Koyaŋaasi inyamat luka erot, koloto airiamun kakes, kolimokis kes ebe, “Kirai isio ikonikejaanakinak: asa kitutukoto kasio.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.11",
            "verseOrgIds": [
              "JOS.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyanauni isio inyamatakosi lu komwaka kotogoikosi kapaaran nakilomunia aponare mamakus; konye kwana, koany, aokoto, erourooto da: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.12",
            "verseOrgIds": [
              "JOS.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka imukulen lu luka ebino luapotu kelelebata, etetiak; ido koany, eeilieila: amoionata ikosinapen lu ka akosimuk kanuka alosit naelwana noi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.13",
            "verseOrgIds": [
              "JOS.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
