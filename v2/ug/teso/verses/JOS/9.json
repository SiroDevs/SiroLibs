        },
        {
          "text": " Konye kepuputu lueboienenete koGibeon nuabu Yosua kiswamak Yeriko ka Ai, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.3",
            "verseOrgIds": [
