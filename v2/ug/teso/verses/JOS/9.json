        },
        {
          "text": " Kijaut ituŋa inyamatakec, komam initunito akirot kama ejai EJAKAIT, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.14",
            "verseOrgIds": [
              "JOS.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
