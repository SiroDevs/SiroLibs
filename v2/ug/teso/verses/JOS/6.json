              "items": [
                {
                  "text": "Yos 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolomasi ikatumunak lukarotak, kitolomut Rakab ka papake, ka totoke, ka iinacanake, ka Iuajaatar kere; kitolomut da lukokekike kere; kibwaikis kes kiŋa kiidukurun luka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.23",
            "verseOrgIds": [
              "JOS.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicweikis ere, ka luejaas toma kere: dimarai epuesa ka esabu, ka amoti nuka aisinit ka asuat, apotu kesi kibwaikis ŋul aiŋadis naka etogo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.24",
            "verseOrgIds": [
              "JOS.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
