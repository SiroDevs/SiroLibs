                  "text": "Mat 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye Rakab naadote, ka ekal loka papake, ka luajaatar kere abu Yosua kitajar; kiboikin mama ejai Isirael, kiton lolo; naarai abu ŋesi kibwa ikiyakia luejukarit Yosua airot Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.25",
            "verseOrgIds": [
              "JOS.6.25"
            ]
          }
