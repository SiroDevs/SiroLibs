                "loc": "DEU.31.25"
              },
              "items": [
                {
                  "text": "Ikis 31:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodilok Yosua anyoun tupuruc, kodakata isasedotin asaduku naka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.12",
            "verseOrgIds": [
              "JOS.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.26"
              },
              "items": [
                {
                  "text": "1 Siit 15:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.9"
              },
              "items": [
                {
                  "text": "Gal 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolosenenete isasedotin ikanykaarei luetiŋito arupepen akanykaarei nuka amumwara nuka imerekekin koiŋaren kasaduku naka EJAKAIT, kokusete arupepen: kiŋarenikinitos ituŋa luakapakina lujiis kes; kotupata lukokau asaduku naka EJAKAIT, kokusete isasedotin arupepen elosete. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.13",
            "verseOrgIds": [
              "JOS.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapaaran nakiareit da kirimosi ere irwan atipet, koboŋosi oidukurun: kiswamata kwaŋin apaarasia akanykape.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.14",
            "verseOrgIds": [
              "JOS.6.14"
            ]
          }
        }
      ]
    },
    {
