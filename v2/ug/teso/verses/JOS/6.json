          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen kapaaran nakikanyetekaarei, kodilokis anyoun ecila kide, kirimosi ere kwape ejaar epone ŋol irwan akanykaarei: konye kapaaran kaŋin apotu kirimosi ere irwan akanykaarei, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.15",
            "verseOrgIds": [
              "JOS.6.15"
            ]
          }
        },
        {
