            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.2"
              },
              "items": [
                {
                  "text": "33:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
