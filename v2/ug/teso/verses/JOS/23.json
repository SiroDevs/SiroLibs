              "items": [
                {
                  "text": "2 Sam 23:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ediopetunanan kayesi erukoria elukumit: naarai EJAKAIT Ekusideke, ŋes nol lokijiik yes, kwape kilimokinitor. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.10",
            "verseOrgIds": [
              "JOS.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kocoito do noi yesi, kominenenas EJAKAIT Ekusideke. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
