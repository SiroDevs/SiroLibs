                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.1"
              },
              "items": [
                {
                  "text": "1 Siit 28:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu Yosua konyarau Isirael kere, imakiokee ka ikapolokokec, ikatubokokec, ka ijakakec, kotema kes atiar, “Amoion eoŋ akokosanit da noi: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.2",
            "verseOrgIds": [
              "JOS.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ianyut yesi kere nuabu EJAKAIT Ekusideke kiswamak atekerin nu kere kanukus; naarai EJAKAIT Ekusideke ŋes nol Iokiiiik yes. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koany, kainak yes atekerin nu nuideuna, araun airumet naka atekerinikus, ageun koYorodan, katekerin kere nuamudia eoŋ, kiton aŋolol nakapolon kari naelomaria akoloŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.4",
            "verseOrgIds": [
              "JOS.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
