            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.53"
              },
              "items": [
                {
                  "text": "Mar 33:53",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eremori EJAKAIT Ekusideke kes kakonyenekus, ireneari kes kakonyenekus; irumete yesi akecekwap, kwape kilimokinitor EJAKAIT yes, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.5",
            "verseOrgIds": [
              "JOS.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.32"
              },
              "items": [
                {
                  "text": "Ikis 5:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.14"
              },
              "items": [
                {
                  "text": "28:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kotitinioto noi aidar aiswamaenen kere nuiwadikatai oitabo loka ikisila luka Musa, kinyeis apaar teten arai kediany; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.6",
            "verseOrgIds": [
              "JOS.23.6"
            ]
          }
        },
