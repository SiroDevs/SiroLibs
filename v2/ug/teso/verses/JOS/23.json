          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.3"
              },
              "items": [
                {
                  "text": "Tub 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.4"
              },
              "items": [
                {
                  "text": "1 Ika 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojenutu eut ebe mam bobo EJAKAIT ireneari atekerin nu kakonyenekus; konye eraunos atacit ka eic kamakus, ka edoi kosiepionokus, ka ikukwa kakonyekus, aitodol nakimudiarere yes kakwap kana naejok nakiinak yes EJAKAIT Ekusideke.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        }
      ]
    },
