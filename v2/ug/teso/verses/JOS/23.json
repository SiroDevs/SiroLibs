              "items": [
                {
                  "text": "2 Pet 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai arai kibonosi yesi, aimorikikin kaluideuna luka atekerin kanu, kes luideuna kamakus, kosodete amanyanakin kakes, kolomasi da mamakee, kes da mamakus: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.12",
            "verseOrgIds": [
              "JOS.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 23:13"
          },
