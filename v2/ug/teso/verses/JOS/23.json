                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tetere mam imorikikinos katekerin nu, nuideuna kamakus; karaida alimit ekiror loka idekesiokec, karaida aiyap kolimito kes, karaida aiiaanakin kes, karaida akukonokin kes: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.7",
            "verseOrgIds": [
              "JOS.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.20"
              },
              "items": [
                {
                  "text": "Ikis 10:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.22"
              },
              "items": [
                {
                  "text": "11:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kimorikikinos ka EJAKAIT Ekusideke, kwape kiswamaata kiton lolo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
            "verseOrgIds": [
              "JOS.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.5"
              },
              "items": [
                {
                  "text": "Yos 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ereŋea EJAKAIT atekerin nukapolok nukagogon da kakonyenekus: konye yes, emamei etuŋanan lokibwoikinit yes kiton lolo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.9",
            "verseOrgIds": [
              "JOS.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 23:10"
