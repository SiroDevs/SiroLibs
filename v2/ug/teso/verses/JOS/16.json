              "items": [
                {
                  "text": "Yos 17:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kirumata idwe luka Yosep, Manase ka Epuraim, airumetekec. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.4",
            "verseOrgIds": [
              "JOS.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.13"
              },
              "items": [
                {
                  "text": "Yos 18:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.8.5"
              },
              "items": [
                {
                  "text": "2 Siit 8:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eikor loka idwe luka Epuraim kwape ejaatar ikekiakee ŋes lo: eikor loka airumetekee kari nakokide korai Atarot-adar, kiton Bet-koron luimukurur; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.5",
            "verseOrgIds": [
              "JOS.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.7"
              },
              "items": [
                {
                  "text": "Yos 17:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobe eikor ari nakoto koMikimetat kari naka agolitomei; kokudo eikor ari nakokide kiton Taanat-silo, kiriria ŋes kari nakokide naka Yanoa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.6",
            "verseOrgIds": [
              "JOS.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.7.28"
              },
              "items": [
                {
                  "text": "1 Siit 7:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijesar anyoun koYanoa kiton Atarot, kiton Naara da, kodol Yeriko, kosan Yorodan, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.7",
            "verseOrgIds": [
              "JOS.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.9"
              },
              "items": [
                {
                  "text": "Yos 17:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.28"
              },
              "items": [
                {
                  "text": "19:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ageun koTapua kitor eikor ari nakoto kiton oeilet loka Kana; kosan aŋolol. Ŋin ŋes airumet naka ateker naka idwe luka Epuraim, kwape ejaatar ikekiakee. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.8",
            "verseOrgIds": [
              "JOS.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepepe kireria luatiakunitai kanuka idwe luka Epuraim kokidin kairumet naka idwe luka Manase, ireria lukapolok kere ka ireriakee ludidik. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.9",
            "verseOrgIds": [
              "JOS.16.9"
            ]
          }
        },
