              "items": [
                {
                  "text": "Tub 1:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitor Bet-el kiton Lus, kobe oikor loka Irikain kiton Atarot; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.2",
            "verseOrgIds": [
              "JOS.16.2"
            ]
          }
        },
