                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijesar ari nakoto oikor loka Iyapeletin, kiton oikor loka Bet-koron loiiesara, kiton Geser; kosan aŋolol,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.3",
            "verseOrgIds": [
              "JOS.16.3"
            ]
          }
        }
