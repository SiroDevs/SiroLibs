            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobe eroet loka idwe luka Yosep ageun koYorodan koYeriko, kakipi nuka Yeriko kari nakokide, ŋes amodiŋ, anyoun koYeriko kitor akwap nakiukon kiton Bet-el: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.1",
            "verseOrgIds": [
              "JOS.16.1"
            ]
          }
        },
