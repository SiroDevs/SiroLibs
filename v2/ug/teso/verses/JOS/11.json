                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolomasi kesi ka ajoresiokee kere nepepe kakes, ituŋa luipu, aipuesukee kwape kasine naejai ariri naka aŋolol, koiaas kibalasin ka agalin nuipu noi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.4",
            "verseOrgIds": [
              "JOS.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriamunos ikabakan nul kere; kopotu kidukuroto nepepe ariri naka akipi nuka Merom, aitiji Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.5",
            "verseOrgIds": [
              "JOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
