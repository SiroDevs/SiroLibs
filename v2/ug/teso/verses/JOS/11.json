        },
        {
          "text": " Mama ejai Ekanaanit loejai ari nakokide ka nakoto, ka Emorait, ka Ekitit, ka Eperisit, ka Eyebusit kakwap nakiukon, ka Ekibit kwap ka Kerumon kakwap naka Misipa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.3",
            "verseOrgIds": [
              "JOS.11.3"
            ]
          }
        },
        {
          "name": "verse",
