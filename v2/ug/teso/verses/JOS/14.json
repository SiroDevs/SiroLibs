        },
        {
          "text": " Kwape ajaar ailamilam eroet kanuka airumetakee, kwape ecorakinitor EJAKAIT kama ka Musa, kanuka atekerin akanykaouon, ka atutubet naka ateker. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
