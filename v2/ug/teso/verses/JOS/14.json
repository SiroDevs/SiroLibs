                  "text": "Mar 13:1-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolo arai eoŋ loka ikar akaisaoŋon nakejukaria Musa ekejaanakinan loka EJAKAIT eoŋ anyoun koKades-barunea airot akwap; kasodi ainun ŋes akirot kwape ajaar otauka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
