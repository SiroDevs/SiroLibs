                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye apotu ikainaean lukiupara keoŋ kipirisiasi itauon luka ituŋa; kouye abu eoŋ katup eut EJAKAIT Ekadeke. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
