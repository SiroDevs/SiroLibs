            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwonyasi ituŋa kotuboros. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen ketuboros cut ituŋa kere, kotubor asaduku naka EJAKAIT, ka isasedotin, kiŋaren kituŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
              "JOS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.20"
              },
              "items": [
                {
                  "text": "Mar 32:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotuboros da idwe luka Reuben, ka idwe luka Gad, ka atutubet naka ateker naka Manase, kokapitos lujiis, kiŋaren kidwe luka Isirael, kwape alimokinitor Musa kes. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.12",
            "verseOrgIds": [
              "JOS.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotuboros kwaka ilukumin akaisaoŋon kokapakina ejie kakonyen nuka EJAKAIT, kiton apuutona nuka Yeriko, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        },
        {
