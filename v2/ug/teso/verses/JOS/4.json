        },
        {
          "text": "“Kicorak isasedotin luedakito asaduku naka aitejenunet kodokut koYorodan.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.16",
            "verseOrgIds": [
              "JOS.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicorak do Yosua isasedotin ebe, “Kodokutu yesi koYorodan.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.17",
            "verseOrgIds": [
              "JOS.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen nakedokuniata isasedotin luadakito asaduku naka aitutuket naka EJAKAIT kokidiŋ Yorodan, kicakata da akeje nuka isasedotin akwap naeonit, koboŋokis akip nuka Yorodan aiboisikec, kilelebun kiton aririke kwape lem sek.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        }
      ]
