        },
        {
          "text": "Asalito atekerin akanykaarei kodwe luka Isirael numam ber akorokoroto airumetekee. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.2",
            "verseOrgIds": [
              "JOS.18.2"
            ]
          }
        },
        {
