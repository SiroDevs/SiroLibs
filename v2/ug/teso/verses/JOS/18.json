          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriria eikor osiep loka Bet-kogila kari naka agolitomei agor naka Aŋolol naka Abalaŋ, osaŋe loka Yorodan kari naka eŋalakimak: nol ŋes eikor loka ari naka eŋalakimak, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.19",
            "verseOrgIds": [
              "JOS.18.19"
            ]
          }
        },
        {
