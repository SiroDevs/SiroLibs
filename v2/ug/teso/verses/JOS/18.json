              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriria osiep loka Araba kari naka agolitomei kiiesar kiton Araba: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.18",
            "verseOrgIds": [
