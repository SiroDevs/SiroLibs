                  "text": "Bur 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " tetere mam kirai bobo imukerun luiriaŋiriaŋas, lukiyaŋanari ŋolikwam loka aisisianakin kotoma aimod naka ituŋa, kotute lokibotei luitapaarete. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.14",
            "verseOrgIds": [
              "EPH.4.14"
            ]
          }
        },
