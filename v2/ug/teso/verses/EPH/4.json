        },
        {
          "text": " Aso eoŋ eenat kotoma Ejakait, keŋaiŋait yes alosenen kwape ibusakinitor anyaraunio nakinyaraunere, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.1",
