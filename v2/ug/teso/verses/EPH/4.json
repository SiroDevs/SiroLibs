                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye karicata abeit kotoma amin, kapolooros da adolore tomakeŋ kakiro kere, loerai akou, ŋes Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.15",
