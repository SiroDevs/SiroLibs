                {
                  "text": "Asw 21:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋol da abu koinak ice araun ikiyakia, ka ice inabin, ka ice ikalimonokinak Akiro Nukajokak, ka ice ikecokok, ka ice da ikesisianakinak, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.11",
            "verseOrgIds": [
              "EPH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 4:12"
          },
          "items": [
