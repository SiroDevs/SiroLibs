            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akirot ŋin ebe, “Abu kodoka”, ŋes atemar ai dimarai ebe abu kijesar da ariino nukokwap noi nuka akwap? ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.9",
            "verseOrgIds": [
              "EPH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋol loabu kijesar ŋes ŋopeŋol loabu kodoka kuju noi adepar akuj kere, tetere itekori iboro kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.10",
            "verseOrgIds": [
              "EPH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
