                {
                  "text": "Kol 3:12-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kaitasono kere ka aiyapepera da, katitiŋikin, koŋirionokinos kotoma amin, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.2",
            "verseOrgIds": [
              "EPH.4.2"
            ]
          }
        },
