                  "text": "Kol 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kiton nepekidolio oni kere oipeone loka aiyuun, ka ajenun da Okoku loka Edeke, kiton nekidolio okiliokone loibecokino, kiton aitemis naka apolou naka aitekoro naka Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.13",
            "verseOrgIds": [
              "EPH.4.13"
            ]
          }
        },
