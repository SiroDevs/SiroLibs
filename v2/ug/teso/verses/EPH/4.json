              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.3.17"
              },
              "items": [
                {
                  "text": "2 Tim 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " aitodolikinio lukalaunak kanuka aswam naka aijaanakin, kosodi akuan naka Kristo adukio; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.12",
            "verseOrgIds": [
              "EPH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
