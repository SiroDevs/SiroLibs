              "items": [
                {
                  "text": "1 Kor 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye aponi koinakinai ŋinidiopet kaoni asianut kwape ejaar aitemis naka ainakinet naka Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.7",
            "verseOrgIds": [
              "EPH.4.7"
            ]
          }
        },
