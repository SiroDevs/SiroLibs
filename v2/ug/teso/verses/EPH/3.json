            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwape ketejenikinere kapukokinio aiyeiyea kwape abu kewadikaa sek kanuesupaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.3",
            "verseOrgIds": [
              "EPH.3.3"
            ]
          }
