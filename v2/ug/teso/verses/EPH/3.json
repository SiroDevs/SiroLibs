            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naisiomiata nu ipedorete ajenun akamisianut nakotoma aiyeiyea naka Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.4",
            "verseOrgIds": [
              "EPH.3.4"
            ]
