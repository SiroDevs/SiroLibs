          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "namam apotu odwe luka ituŋa kojenut katurio ace, kwape apukorere kwana mama ejaas ikekiyakia lukalaunak ka inabin da kotoma Omoyo; ",
          "type": "text",
