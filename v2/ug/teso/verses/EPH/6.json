            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yes ibulesin, korimasi ŋul lueraas ijakakus kwape ejaar akuan, kakurian ka amaran kaipioror naka itauonokus, kwape irimatar Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.5",
            "verseOrgIds": [
              "EPH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mere bala kaijaanakin nakokuju kwape luitoiokito ituŋa, konye kwape ibulesin luka Kristo iswamaenenete nuekot Edeke kotauon, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.6",
            "verseOrgIds": [
              "EPH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ijaanakinete kaiyalama, bala ijaanakinete Ejakait, kwabo mere ituŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.7",
            "verseOrgIds": [
              "EPH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.10"
              },
              "items": [
                {
                  "text": "2 Kor 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kojenete ebe nuejok nuiswamai ituŋanan, ŋes einakinio bobo kama ejai Ejakait, arai erai ebulesit, arai bo erai loijakakai. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.8",
            "verseOrgIds": [
              "EPH.6.8"
            ]
          }
        },
        {
