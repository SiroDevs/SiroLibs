                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yes da ijaka, kiswamanakinete kes kwape kwaŋin, kinyeis aitukurian, naarai ijenete ebe ejai Ejakaitikec ka lokus toma akuj, kwabo emamei atiakit ituŋa kamakeŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        }
