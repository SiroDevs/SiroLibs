              "type": "text"
            }
          ]
        },
        {
          "text": " Nukawasia, kojaas kagogoŋ toma Ejakait, kotoma ailerit naka agogoŋuke. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.10",
            "verseOrgIds": [
              "EPH.6.10"
            ]
          }
        },
