                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kirai oni akeswamisio, nuesubunitai kotoma Kristo Yesu aswam aswamisio nuejok nukegeunia Edeke aitemonokin tetere kilosenenei kotomakec.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.10",
