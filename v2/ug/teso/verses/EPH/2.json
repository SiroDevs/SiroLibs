              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " tetere kokar luepote itodikini abar naedeparit naka akesianut kotoma ajokis naejai mamawok kotoma Kristo Yesu. ",
          "type": "text",
          "attrs": {
