            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nakitwakitor kanuka aibucanaretawok, abu kituluo oni ikajarak nepepe ka Kristo, (itajarunitai kanuka asianut,) ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.5",
