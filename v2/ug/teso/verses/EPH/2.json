                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kipou isio da kere kekonenenete nen kolo kotoma aiŋobel naka awatekosi, keswamaenenete nuekoto akuan ka aomisio, kirai koinono idwe luka anyunyura kwape kaluce da kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.3",
            "verseOrgIds": [
              "EPH.2.3"
            ]
          }
        },
        {
