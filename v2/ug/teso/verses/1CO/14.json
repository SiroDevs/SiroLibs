            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso iinacan, anyoika bo? Nakitukokinotor, ejai ŋinidiopet ekosio, arai aisisianakin, ejai apukokinio, arai aŋajep, arai aijul. Kiswamas akiro kere kanuka aiduk. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.26",
            "verseOrgIds": [
              "1CO.14.26"
            ]
          }
        },
        {
          "name": "verse",
