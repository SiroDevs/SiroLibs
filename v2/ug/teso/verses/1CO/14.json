          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai ekotos aisisiaun akirot kere, kiŋita ikiliokokec koreriakec, Naarai mam ibus aberu einer kokanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
