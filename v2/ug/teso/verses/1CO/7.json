              "items": [
                {
                  "text": "Plm 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai lokenyaraunio erai ebulesit, erai loeosikinitai loka Ejakait; kwape kwaŋin da lokenyaraunio erai loeosikinitai erai ebulesit loka Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.22",
            "verseOrgIds": [
              "1CO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi kogweli yes kakais nuipu; sirikiraut ibulesin luka ituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.23",
            "verseOrgIds": [
              "1CO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso iinacan, kosal ŋinidiopet nepepe ka Edeke kwape kenyaraunere,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.24",
            "verseOrgIds": [
              "1CO.7.24"
            ]
          }
        }
      ]
    },
