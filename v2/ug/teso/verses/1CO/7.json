              "1CO.7.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.32"
              },
              "items": [
                {
                  "text": "Mat 5:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.9"
              },
              "items": [
                {
                  "text": "19:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.11+MRK.10.12"
              },
              "items": [
                {
                  "text": "Mk 10:11-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.18"
              },
              "items": [
                {
                  "text": "Luk 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ecorakini luedukokina, kwabo mere eoŋ, dimarai Ejakait, ebe, kinyek aberu aisac okilenike. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.10",
            "verseOrgIds": [
              "1CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai esaci, kosal mam edukokina, arai bo kopuco kokilenike. Bobo da kinyek ekiliokit aireŋear akeberu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.11",
            "verseOrgIds": [
              "1CO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.11",
            "verseOrgIds": [
              "1CO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimokini ice, eoŋ mere Ejakait, ebe, arai ejaas onace kaberu namam iyuunit, ecamuni ŋin da aiboienen kaŋes, kinyek aireŋear ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.12",
            "verseOrgIds": [
              "1CO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai da ejaas aberu kekiliokit lomam iyuunit, ŋes da ecamuni aiboienen kaŋin, kinyek anyoun kama kokilenike. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.13",
            "verseOrgIds": [
              "1CO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.16"
              },
              "items": [
                {
                  "text": "Rom 11:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai italaunitai ekiliokit lomam iyuunit kanuka akeberu, aberu da namam iyuunit italaunitai kanuka okilenike. Arai mere kwaŋin tieraas ikusidwe lumam elaete, konye kwana eraas lukalaunak ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.14",
            "verseOrgIds": [
              "1CO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.19"
              },
              "items": [
                {
                  "text": "Rom 14:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai enyouni lomam iyuunit, konyou do ŋesi; kakiro nuikote nen mam onac arai kinac eenitai. Naarai abu Edeke konyarau oni toma ainapakin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.15",
            "verseOrgIds": [
              "1CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.1"
              },
              "items": [
                {
                  "text": "1 Pet 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ijo aberu, ijenuni biai, wolo bo itajari okilenikon? Ijo da ekiliokit, ijenuni biai, wolo bo itajari akoniberu?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.16",
            "verseOrgIds": [
              "1CO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
