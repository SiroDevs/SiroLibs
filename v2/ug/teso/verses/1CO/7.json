        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.16",
            "verseOrgIds": [
              "1CO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
