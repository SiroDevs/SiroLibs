                  "text": "Rom 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Irotakinio aberu kokilenike apak kere naejaria ŋol. Konye arai ketwana okilenike, eosikinitai adukokin loekot, konye toma Ejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye aomit eoŋ ebe iyalama aitelekarit arai esali kwaŋin, Ido aomit ebe ajai kEmoyo loka Ejakait.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
