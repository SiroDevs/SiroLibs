            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.3"
              },
              "items": [
                {
                  "text": "1 Yok 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Erai Edeke lomunot, lokinyarauni yes alomun oidicane loka Okokuke, Yesu Kristo Ejakaitiwok.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
