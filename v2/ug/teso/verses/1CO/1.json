                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso iinacan, keŋaiŋait yes, kokiror loka Ejakaitiwok Yesu Kristo, ebe kinerata kere adiopekirot, kinye atiakatiakaun ajaun kidiŋikus, konye kidicakina ketau ediopet ka ainerun da adiopet. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.10",
            "verseOrgIds": [
              "1CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai, ikainacan, kalimokis eoŋ lukokale loka Kloe, ebe ejai aŋolopa kidiŋikus. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.11",
            "verseOrgIds": [
              "1CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 1:12"
