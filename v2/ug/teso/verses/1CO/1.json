                {
                  "text": "1 Kor 16:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (Abu kebatis da lukokale loka Sitepan, Alemar ŋul mam ajeni arai abu kebatis ice kere.) ",
