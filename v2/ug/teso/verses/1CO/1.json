            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojai asianut mama ijaas, ka ainapakin nuepote kama ejai Edeke Papawok ka Ejakait Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
