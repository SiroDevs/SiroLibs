              "items": [
                {
                  "text": "Rom 16:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emalai naarai mam ebatisat idio kayesi dimarai Keresipo ka Gaio; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kinyek idiotuŋanan atemar ebe aponi kibatisai kokirorikaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.15",
            "verseOrgIds": [
              "1CO.1.15"
            ]
          }
        },
        {
