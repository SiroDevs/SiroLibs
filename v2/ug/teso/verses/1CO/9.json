                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso enyoin kereka ekaropit? Ŋes lota, ebe, kalimonok Akiro Nukajokak atai, komam etwasamai akapedor kere nakijaar kotoma Akiro Nukajokak,",
          "type": "text",
          "attrs": {
