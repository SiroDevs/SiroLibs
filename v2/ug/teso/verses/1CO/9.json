            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu karau ekalany kama ka luekalanyaka, tetere eriuni luekalanyaka. Karau lokiponesio kere kotuŋa kere, tetere korotin kere ketajar ice. ",
          "type": "text",
          "attrs": {
