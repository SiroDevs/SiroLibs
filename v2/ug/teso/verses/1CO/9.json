            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai arai alimonokini Akiro Nukajokak, emamei eoŋ naaolobobotor. Naarai ketiŋaikinitai. Itukwi eoŋ arai mam eoŋ alimonokini Akiro Nukajokak! ",
          "type": "text",
          "attrs": {
