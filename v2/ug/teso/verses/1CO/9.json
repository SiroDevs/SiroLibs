                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai arai eswamai ŋun kakoteka, ejai aropio, konye arai mere akoteka, kamunoi kotoma ajokon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.17",
