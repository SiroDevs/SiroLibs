            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kwana kewadikakini yes ebe sirikimorianakinos kaloenyaritai onac arai erai edote, arai ekeraŋan, arai loemai aputosia, arai ekamoromoron, arai ekameran, arai ekaŋatan; etuŋanan loikoni kwaŋin mam acamunit yes karaida aimor kaŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.11",
            "verseOrgIds": [
              "1CO.5.11"
            ]
          }
        },
