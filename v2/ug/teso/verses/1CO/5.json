              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kewadikak yes kotoma obaluaka ebe sirikimorianakinos kidotea; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.9",
            "verseOrgIds": [
