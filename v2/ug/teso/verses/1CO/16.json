            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apaaran nasodit naka asabato kiŋadak ŋinituŋanan kayesi kidiat, kwape ekerianar, kinyeinai atukonokin naabunio eoŋ, ",
          "type": "text",
          "attrs": {
