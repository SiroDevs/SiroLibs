                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eoŋ da, iinacan, naabunio mamakus, mam abunit alimonokin yes nukaiyeiyea nuka Edeke kakiro nuejijim karaida kacoa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.1",
            "verseOrgIds": [
