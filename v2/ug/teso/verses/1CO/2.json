                {
                  "text": "Rom 16:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye kinera acoa naka Edeke kotoma nukaiyeiyea, acoa naibwaitai, nakicorakinit Edeke eriŋa ikar ejauna, kanuka aibusesuwok. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.7",
            "verseOrgIds": [
              "1CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
