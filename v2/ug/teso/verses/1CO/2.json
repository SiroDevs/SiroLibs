                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kipukok Edeke oni kanuka Emoyo. Naarai irerei Emoyo kere, kiton nuidulok nuka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.10",
            "verseOrgIds": [
              "1CO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai iŋai tope kotuŋa yenejeni aomisio nuka ituŋa, dimarai emoyo loka ituŋanan loejai kotomakeŋ? Kwape kwaŋin emamei yenejeni aomisio nuka Edeke dimarai Emoyo loka Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.11",
            "verseOrgIds": [
              "1CO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 2:12"
