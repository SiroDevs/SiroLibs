            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.4"
              },
              "items": [
                {
                  "text": "1 Kor 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinera ŋun mere kakiro nuisisianakini acoa naka etuŋanane, dimarai nuisisianakini Emoyo, kitiiriani nuka emoyo kanuka emoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.13",
            "verseOrgIds": [
              "1CO.2.13"
            ]
          }
        }
