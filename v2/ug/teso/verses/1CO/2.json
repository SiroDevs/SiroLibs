            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.13"
              },
              "items": [
                {
                  "text": "Yok 16:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye oni, mam kidumunit emoyo loka akwap, dimarai Emoyo loebuni kama ejai Edeke, tetere kijenuni ainakineta nukiinakini Edeke oni atitai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.12",
            "verseOrgIds": [
              "1CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
