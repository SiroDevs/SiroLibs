                {
                  "text": "Kol 1:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam ikayaitok luka ikar kalu apotu kojenut ŋin; naarai arai kejenete timam kibubukis Ejakait lokaibuses. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.8",
            "verseOrgIds": [
              "1CO.2.8"
            ]
          }
        },
