                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ituŋanan kauruuneteke mam ecamuni akiro nuka Emoyo loka Edeke, naarai eraas nukabaŋaanut mamakeŋ, kwabo mam epedori ajenun kes naarai emisiikinio kanuka emoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.14",
            "verseOrgIds": [
              "1CO.2.14"
            ]
          }
        },
        {
