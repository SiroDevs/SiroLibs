              },
              "items": [
                {
                  "text": "Nwo 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ka dano mo otimo abor ki dako pa lawote, laco ki dako ma gutimo abor-ri gibinekogi woko. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.8"
              },
              "items": [
                {
                  "text": "Levi 18.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.30"
              },
              "items": [
                {
                  "text": "Nwo 22.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.20"
              },
              "items": [
                {
                  "text": "27.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dano ma obuto ki ci-wonne, noŋo oketo lewic i kom wonne; gibineko gin aryo ducu, remogi dok i wigi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.15"
              },
              "items": [
                {
                  "text": "Levi 18.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka dano mo obuto ki ci-wode, gibineko gin aryo ducu, pien gutimo k ir, remogi dok i wigi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.22"
              },
              "items": [
                {
                  "text": "Levi 18.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka dano mo obuto ki laco macalo dako, gin aryo ducu gutimo gwok, gibinekogi woko, remogi dok i wigi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.17"
              },
              "items": [
                {
                  "text": "Levi 18.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.23"
              },
              "items": [
                {
                  "text": "Nwo 27.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka dano mo onyomo dako ci ododo ki bedoki minne bene, meno kipyeda; gibiwaŋogi woko ki mac, en ki gin mon aryo ducu, wek kipyeda pe obed i kinwu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.19"
              },
              "items": [
                {
                  "text": "Nia 22.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.23"
              },
              "items": [
                {
                  "text": "Levi 18.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.21"
              },
              "items": [
                {
                  "text": "Nwo 27.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka dano mo obuto ki lee, gibineko woko, dok wubineko lee meno bene, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
              "LEV.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dako mo onyiko cok ki lee ce obedo kwede, wubineko dako-nu ki lee meno; gibinekogi woko, remogi dok i wigi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        }
      ]
