          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Laco nyo dako mo ma lakor tipo nyo ma min jok gibineko woko; gibicelo woko ki got, remogi bidok i wigi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.27",
            "verseOrgIds": [
              "LEV.20.27"
            ]
          }
        }
      ]
