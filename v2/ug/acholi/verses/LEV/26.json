          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi aye cik ki gin ma Rwot oŋolo, ki cik ma en oketo i kin en ki jo Icrael i wi got Cinai ki i dog Moses.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
