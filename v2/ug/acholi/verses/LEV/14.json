          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aye cik ma mako two dobo ducu: pi two akukuc, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 14:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "pi two dobo ma i kom ginaruka nyo i kom ot, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55",
            "verseOrgIds": [
              "LEV.14.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 14:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo pi gin ma okwot, nyo orugo, nyo orobo del kom dano, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
            "verseOrgIds": [
              "LEV.14.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 14:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "pi nyuto ka obedo keni nyo ma olony. Man aye cik ma mako dobo,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.57",
            "verseOrgIds": [
              "LEV.14.57"
            ]
          }
        }
      ]
