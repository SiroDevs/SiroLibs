              "NUM.21.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.40"
              },
              "items": [
                {
                  "text": "Wel 33.40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kabaka me Arad, ma en Lakanaan ma bedo i Negeb, owinyo ni jo Icrael gibibino ki i yo Atarim, ci olwenyo komgi, oyako jo mogo woko ki i kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.1",
            "verseOrgIds": [
              "NUM.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci jo Icrael gukwoŋo kwoŋ bot Rwot kun giwaco ni, “Ka ibimiyo jo man i cinwa ada, ci wan wabidyerogl i ciŋi, wabijwero gaŋigi woko liweŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owinyo lega pa jo Icrael, omiyo guloyo Lukanaan, ci gin gudyerogi i cin Rwot kacel ki gaŋigi, gujwero woko; mumiyo nyiŋ kabedo meno gilwoŋo ni Korma",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21.3",
              "type": "text"
            },
            {
              "text": "Korma te lokke",
              "type": "text"
            },
            {
              "text": "Dyero ine aneka.",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
