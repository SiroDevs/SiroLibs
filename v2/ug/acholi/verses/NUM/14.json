            "verseId": "NUM.14.12",
            "verseOrgIds": [
              "NUM.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 14:13"
          },
          "items": [
