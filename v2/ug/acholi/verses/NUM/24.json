        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.24",
            "verseOrgIds": [
              "NUM.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lacen Balaam oa malo odok cen ka ma en bedo iye; ki Balak bene ocito woko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.25",
            "verseOrgIds": [
              "NUM.24.25"
            ]
