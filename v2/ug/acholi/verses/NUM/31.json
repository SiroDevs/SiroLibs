          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom nucu ma tuŋ bot jo Icrael ibikwanyo iye acel i kom pyerabic ki kom dano, ki twoni, ki kana, ki romi nyo dyegi, ki i kom lim makwo ducu, ci imi bot Lulevi ma gigwoko kema pa Rwot.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.30",
            "verseOrgIds": [
              "NUM.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Moses ki Eleajar gutiyo kit ma Rwot ociko ki Moses.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.31",
            "verseOrgIds": [
              "NUM.31.31"
            ]
          }
        }
      ]
