            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano guromo alip apar wiye abicel; dano ma gijogo pi Rwot guromo pyeradek wiye aryo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
