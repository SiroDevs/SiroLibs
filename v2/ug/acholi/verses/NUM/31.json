          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guwacci, “Wan luticci watyeko kwano Wel lumony ma gitye i te locwa, ci onen ni pe tye dano acel mo ma orwenyo ki i kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
            "verseOrgIds": [
              "NUM.31.49"
            ]
          }
        },
        {
