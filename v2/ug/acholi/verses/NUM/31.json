              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ ludito ma giloyo lumony ducu, lulo dano alip ki lulo dano miya, gubino bot Moses. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
