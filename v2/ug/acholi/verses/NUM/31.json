              "type": "text"
            }
          ]
        },
        {
          "text": "Jami ma lulweny guyako, ma odoŋ, onoŋo obedo romi alip miya abicel ki pyerabiro wiye abic, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32",
