            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dyaŋi guromo alip pyeradek wiye abicel; dyaŋi ma gijogo pi Rwot guromo pyerabiro wiye aryo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
