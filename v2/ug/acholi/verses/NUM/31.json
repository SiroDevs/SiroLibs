          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana gubedo alip pyeradek, ki miya abic; gin ma gijogo pi Rwot guromo pyerabicel wiye acel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
