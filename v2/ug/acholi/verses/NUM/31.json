              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses omiyo dul ma gijogo me gityer pa Rwot bot ajwaka Eleajar, macalo Rwot ocike.",
          "type": "text",
          "attrs": {
