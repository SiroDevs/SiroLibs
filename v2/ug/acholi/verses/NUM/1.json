              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot oloko ki Moses i tim Cinai; i kema me rwatte, i kom nino dwe mukwoŋo me dwe me aryo, i mwaka me aryone nia i kare ma doŋ gua woko ki i lobo Ejipt. Owacci, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwan wel lwakjo Icrael ducu, kun ilubo doggolagi ki dog odi pa kwarogi kit ma Wel nyiŋgi tye kwede, kun ikwano co ducu ki acel acel, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.2",
            "verseOrgIds": [
              "NUM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "cakke ki i kom jo ma ditogi romo mwaka pyeraryo dok kwede malo, jo Icrael ducu ma romo cito ka lweny; wubikwanogi wun ki Aron ki bucagi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.3",
            "verseOrgIds": [
              "NUM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.3",
            "verseOrgIds": [
              "NUM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok wubibedo ki dano acel ma oa ki i kaka acel acel, ma ŋat acel acel bibedo ladit wi kaka ki i ot pa kwarogi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.4",
            "verseOrgIds": [
              "NUM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gin aye nyiŋ jo ma gibicuŋ ka konyowu:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5",
            "verseOrgIds": [
              "NUM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo pa Reuben, Elijur wod pa Cedeur; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5",
            "verseOrgIds": [
              "NUM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo pa Cimeon, Celumiel wod pa Juricadai; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.6",
            "verseOrgIds": [
              "NUM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo pa Juda, Nakucon wod pa Aminadab; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.7",
            "verseOrgIds": [
              "NUM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo pa Icakar, Netanel wod pa Juar; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.8",
            "verseOrgIds": [
              "NUM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo pa Jabulon, Eliab wod pa Kelon; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.9",
            "verseOrgIds": [
              "NUM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "i awobe pa Yucepu, jo pa Epraim, Elicama wod pa Amikud, jo pa Manace, Gamaliel wod pa Pedajur; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.10",
            "verseOrgIds": [
              "NUM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo pa Benjamin, Abidan wod pa Gideoni; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.11",
            "verseOrgIds": [
              "NUM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo pa Dan, Akiejer wod pa Amicadai; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.12",
            "verseOrgIds": [
              "NUM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo pa Acer, Pagiel wod pa Okoran; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.13",
            "verseOrgIds": [
              "NUM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo pa Gad, Eliacap wod pa Deuel; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.14",
            "verseOrgIds": [
              "NUM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo pa Naputali, Akira wod pa Enan,” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.15",
            "verseOrgIds": [
              "NUM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gin aye dano ma giyero ki i lwak, ma gin aye lutel wi kaka pa kwarogi, gin ludito ma i kaka pa jo Icrael.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.16",
            "verseOrgIds": [
              "NUM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
