              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "welgi ducu onoŋo oromo alip miya abicel ki adek, ki miya abic ki pyerabic noŋo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.46",
            "verseOrgIds": [
