          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien onoŋo Rwot owaco ki Moses ni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.48",
            "verseOrgIds": [
              "NUM.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
