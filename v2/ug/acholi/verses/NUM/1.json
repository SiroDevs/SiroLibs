          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo pa Cimeon. Ka gikwano wel likwayone kun gicoyo nyiŋgi ki acel acel ma lubo doggolagi ki dog odi pa kwarogi, co ducu cakke ki i kom jo ma mwaka me ditogi romo pyeraryo dok kwede malo, jo ducu ma giromo cito ka lweny, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "wel-jo ma i kaka pa Cimeon oromo alip pyerabic wiye aboŋwen, ki miya adek.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        }
      ]
    },
