          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboam dok ogero odi me woro Lubaŋa i wi godi, kun keto iye ajwagi ma okwanyogi ki i kin lwak ata, ma pe gin jo Levi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
