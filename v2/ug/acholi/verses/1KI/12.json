            }
          ]
        },
        {
          "text": "Lok man odoko bal, pien jo Icrael gucako mol gicito bot wod twon acel ma tye i Betel, ki bot mukene ma tye i Dan, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.30",
            "verseOrgIds": [
              "1KI.12.30"
            ]
          }
        },
