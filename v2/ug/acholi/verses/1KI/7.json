                "loc": "EXO.30.1+EXO.30.2+EXO.30.3"
              },
              "items": [
                {
                  "text": "30.1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kit meno bene Solomon omiyo gitiyo jami ducu ma mitte i ot pa Rwot, gin ene: keno tyer me jabu, meja me jabu pi mugati me aketa i nyim Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
