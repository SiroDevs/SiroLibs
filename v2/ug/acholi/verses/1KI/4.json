        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka Solomon obedo kabaka ma loyo jo Icrael ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.1",
            "verseOrgIds": [
              "1KI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano magi aye gubedo ludito wi ticce:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.2",
            "verseOrgIds": [
              "1KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajaria wod pa Jadok obedo ajwaka pa Lubaŋa; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.2",
            "verseOrgIds": [
              "1KI.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elikorep ki Akija ma awobe pa Cica gubedo lukarani, Yekocapat wod pa Akilud obedo laco lok ma timme; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.3",
            "verseOrgIds": [
              "1KI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya wod pa Yekoyada obedo ladit me mony; Jadok ki Abiatar gubedo ajwagi pa Lubaŋa; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.4",
            "verseOrgIds": [
              "1KI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajaria wod pa Natan obedo ladit ma loyo lulo dul lobo; Jabud wod pa Natan obedo ajwaka ki larem kabaka; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.5",
            "verseOrgIds": [
              "1KI.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akica obedo ladit ma gwoko gaŋ kai; ki Adoniram wod pa Abda obedo ladit ma loyo tic muroni,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
            "verseOrgIds": [
              "1KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
            "verseOrgIds": [
              "1KI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon obedo ki lulo dul lobo apar wiye aryo ma giloyo wi Icrael ducu, ma ticgi obedo me coko cam pi kabaka ki jone ducu; dano acel acel miyo cam tyeko dwe acel i mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.7",
            "verseOrgIds": [
              "1KI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiŋgi ene: Ben-kur onoŋo loyo lobo godi me Epraim; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.8",
            "verseOrgIds": [
              "1KI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-deker onoŋo loyo Makaj, Caalbim, Bet-cemec ki Elon-bet-kanan; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.9",
            "verseOrgIds": [
              "1KI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-keced oloyo Arubot ki Coko ki lobo Keper ducu; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.10",
            "verseOrgIds": [
              "1KI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-abinadab oloyo Napat-dor ducu. (Onoŋo dakone obedo Tapat ma nya pa Solomon.) ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.11",
            "verseOrgIds": [
              "1KI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana wod pa Akilud oloyo Taanak, Megido ki Bet-cean ducu ma tye ka ŋet Jaretan ma i luŋ me Jejreel, ki cakke i Bet-cean nio i Abel-mekola ki nio kwede wa ka ŋet Jokmeam tuŋcel; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.12",
            "verseOrgIds": [
              "1KI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-geber oloyo Ramot-gilead, ki gaŋi matino pa Jair wod pa Manace ma gitye i lobo Gilead, kacel ki lobo Argob ma i Bacan ma tye iye gaŋi madito pyerabicel ma gicelo ki cel, ma dogcelgi gicego ki rii mola; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.13",
            "verseOrgIds": [
              "1KI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akinadab wod pa Iddo oloyo Makanaim; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.14",
            "verseOrgIds": [
              "1KI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akimaj oloyo lobo Naputali. En onoŋo onyomo Bacemat ma nya pa Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.15",
            "verseOrgIds": [
              "1KI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana wod pa Kucai oloyo Acer ki Bealot; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.16",
            "verseOrgIds": [
              "1KI.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yekocapat wod pa Parua oloyo lobo Icakar; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.17",
            "verseOrgIds": [
              "1KI.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cimei wod pa Ela oloyo lobo Benjamin; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.18",
            "verseOrgIds": [
              "1KI.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geber wod pa Uri oloyo dul lobo Gilead ma yam obedo lobo pa Cikon kabaka pa jo Amor ki pa Og kabaka me Bacan. Dok onoŋo tye lalo lobo acel ma loyo lobo Juda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Juda ki jo Icrael yam gidwoŋ ma rom ki kweyo ma i dog nam; gubedo ka cam ki ka mat ki yomcwiny. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.20",
            "verseOrgIds": [
              "1KI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Acak 15.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.26"
              },
              "items": [
                {
                  "text": "2 Tek 9.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Solomon obedo ka loyo ker mapatpat ducu cakke ki i kulu Euprate nio wa i lobo pa jo Piliciti, ki nio wa i lobo Ejipt. Jo me ker meno gubedo ka tyero mot bot Solomon kun gitiyo bote i kare me kwone ducu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.21",
            "verseOrgIds": [
              "1KI.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.21",
            "verseOrgIds": [
              "1KI.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cam ma gimiyo bot Solomon pi nino acel acel onoŋo romo moko kwon mapwotte guniya miya acel, moko kwon mukene guniya miya aryo, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.22",
            "verseOrgIds": [
              "1KI.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "twoni mucwe apar, dyaŋi pyeraryo ma gikwayogi i-olet, romi miya acel, ma pe iribo iye til ki bure ki abur, ki gweni mucwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.23",
            "verseOrgIds": [
              "1KI.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "En onoŋo bwoyo lobo ducu cakke ki i kulu Euprate dok kwede yo tuŋ potoceŋ, en aye cakke ki i Tipica nio wa i Gaja, kun loyo ki luker ducu cakke ki i kulu Euprate dok kwede yo tuŋ potoceŋ; obedo ki kuc i kabedo ducu murumo lobone. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.24",
            "verseOrgIds": [
              "1KI.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juda ki Icrael bene gubedo mot ki kuc cakke ki i Dan nio kwede wa i Beer-ceba, kun dano acel acel bedo gire i te olokke ki i te odurone i kare pa Solomon ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.25",
            "verseOrgIds": [
              "1KI.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.26"
              },
              "items": [
                {
                  "text": "1 Luker 10.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.14"
              },
              "items": [
                {
                  "text": "2 Tek 1.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.25"
              },
              "items": [
                {
                  "text": "9.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Solomon obedo ki kabedo me gwoko aguragurane ma giromo gwoko iye aguragura alip pyeraŋwen pi ywayo gadigadine me lweny, ki lulweny alip apar wiye aryo ma giriŋo ki aguragura. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.26",
            "verseOrgIds": [
              "1KI.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lulo dul lobo mapatpat gubedo ka miyo cam bot kabaka Solomon ki pi jo ducu ma gicito ka cam bote, kun dano acel acel miyo i dwene; pe gimiyo gin mo rem. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.27",
            "verseOrgIds": [
              "1KI.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki bel cayiri bene ki Teŋ kal pi cam pa aguragura ki pi aguragura madwirre gitero ducu i kabedo ma gimitogi iye, kun ŋat acel acel kelo kit ma giciko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
