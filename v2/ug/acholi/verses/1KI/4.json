              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubaŋa omiyo Solomon obedo ki ryeko ki niaŋ matut mada; tamme lac ma rom ki kweyo ma oyarre i dog namo ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno ryeko pa Solomon okato ryeko pa jo ducu ma yo’ tuŋ wokceŋ, wa ki ryeko pa jo Ejipt ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 4:31"
          },
          "items": [
