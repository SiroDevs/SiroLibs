                  "text": "Jab 89",
                  "type": "text"
                }
              ]
            },
            {
              "text": "(Title)",
              "type": "text"
            }
          ]
        },
        {
          "text": "En onoŋo ryek makato jo mu kene ducu, en laryeko makato Etan ma jo Jera, ki Eman, ki Kalkol ki Darda ma gin awobe pa Makol; ci nyiŋ Solomon oywek oromo i rok ducu ma orumogi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.31",
            "verseOrgIds": [
              "1KI.4.31"
            ]
          }
        },
        {
