                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "En bene obolo carolok ma romo alip adek; ki wer ma en ocako oromo alip acel ki abic. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oloko i komi yadi ocako ki i kom yat cedar ma tye i Lebanon nio kwede wa i kom anyero ma twi doŋo i kom cel got; oloko i kom lee tim bene, ki i kom winyo-gu, ki i kom gin ma lakalaka piny-gu, ki i kom rec-gu: ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci dano ma i rok ducu gubino ka winyo ryeko pa Solomon, dok gua ki bot luker ducu ma i wi lobo, ma guwinyo pi ryekone.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
