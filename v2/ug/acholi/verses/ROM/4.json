            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.29"
              },
              "items": [
                {
                  "text": "Gal 3.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Cikke ma onoŋo yam Lubaŋa ociko bot Abraim ki likwaye, ni, wi lobo ducu bibedo megi, gin mumiyo ociko, pe ni Abraim yam ocobo cik, ento pein en onoŋo oye Lubaŋa, ka doŋ gikwane ni kite atir. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.18"
              },
              "items": [
                {
                  "text": "Gal 3.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ka ce jo ma cobo cik gin aye jo ma wi lobo-ni ducu bedo megi, kono niye doŋ konnye pe, ki cikke bene kono konnye pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien cik miyo akemo mako Lubaŋa i kom dano, ento ka ma cik pe iye, turo cik bene pe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        }
      ]
    },
