          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aye gin mumiyo ayelle matek, kun acukke ki tekone madwoŋ ma tye ka tic i iya.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.29",
