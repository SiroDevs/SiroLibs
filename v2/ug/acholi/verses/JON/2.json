            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona olego Rwot Lubaŋane ki ii rec ",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.1",
            "verseOrgIds": [
              "JON.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kun wacci,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ceŋ akok bot Rwot i canna, ci en ogamo doga; ceŋ akok ki i i lyel, ci iwinyo dwana.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pien onoŋo ibola ka matut, i cwiny dye nam, pii ma mol oruma woko dyere; tagge me pii ki correne, omol okato ki i wiya.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok awacci, ‘Giryema woko ki i nyimi; abineno dok ot meri maleŋ niŋniŋ?’",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pii omwonya woko, kut matut oruma dyere; tiro okadde woko i wiya; ",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kun alwiny piny i te godi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alor acito piny wa i lobo ca, giloro dogganne i wi ya woko matwal.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bed kumeno idwoko kwona nia ki i bur, in Rwot Lubaŋana.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka tipo koma ool woko ci doŋ apo i kom Rwot; ki legana owinnye boti i ot meri maleŋ,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo ma giworo cal jogi mamwa-ni gibalo mar me ada.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.8",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
