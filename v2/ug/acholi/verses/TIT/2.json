          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tit botgi lok magi; cuk cwinygi dok ijukgi ki twer ducu ma itye kwede. Pe imi ŋat mo ocayi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
            "verseOrgIds": [
              "TIT.2.15"
            ]
          }
