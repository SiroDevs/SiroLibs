                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " En yam omine kene piwa me kokowa woko ki i bal ducu, ki me lonyowa wabed jone kikome, ma watye ki miti madwoŋ me tiyo tic mabeco.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
