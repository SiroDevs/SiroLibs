                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bot Tito, latinna me ada ma wanywako niye acel:",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
