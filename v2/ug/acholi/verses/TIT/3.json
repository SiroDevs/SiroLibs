                  "text": "2 Tem 4.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ka abioro Artema nyo Tukiko boti, ket tek ibin bota i Nikopoli, pien doŋ atyeko moko tamma me bedo kunnu i kare me koyo. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.24"
              },
              "items": [
                {
                  "text": "Tic 18.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.12"
              },
              "items": [
                {
                  "text": "1 Kor 16.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ket tek me konyo Jena ma en dano ma ŋeyo cik, gin ki Apolo, i wotgi, nen ni gin mo pe orem botgi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danowa bene myero gummine kengi i tic mabeco wek gubed ki yo me konyo luwotgi ma can mo odiyo; pe gubed macalo yat ma pe nyak.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        }
      ]
    },
