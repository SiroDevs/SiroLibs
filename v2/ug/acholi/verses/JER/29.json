                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Jer 25.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.2"
              },
              "items": [
                {
                  "text": "Dan 9.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Rwot owaco kuman ni, Ka mwaka pyerabiro ma gimiyo ki Babilon doŋ otum, ci an abilimowu, abicobo cikkena piwu ci abikwanyowu adwokowu cen i kabedo man. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "An keken aye aŋeyo yub ma atye kwede piwu, man Rwot ma owaco, yub me berbedo ento pe yub pi gin marac, yub pi kelo botwu kare me anyim ma wutye ki gen pire-ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci wubibino bota wulega, an abiwinyo legawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
              "JER.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.29"
              },
              "items": [
                {
                  "text": "Nwo 4.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wubiyenya ci wubinoŋa bene, ka ce onoŋo wuyenya ki cwinywu ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo, awacci wubinoŋa ci abidwoko gumwu botwu kun acokowu woko ki i rok ducu ki i kabedo ducu ka ma yam aryemowu wucito iye, ci abikelowu adwokowu cen i kabedo ka ma yam akwanyowu ki iye giterowu i opii-ni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pien wun doŋ onoŋo wuwaco ni, Rwot doŋ omiyowu lunebi ki i Babilon, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "koŋ wuwiny lok ma Rwot owaco i kom kabaka ma tye ka loc kun obedo i wi komker pa Daudi, ki dok lok ma okemo jo me gaŋ man, ki lutuwu ma yam pe gucito kacel kwedwu i opii-ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot me mony owaco kit man ni, ‘Abekelo lweny, kec ki two gemo, ci abimiyo gibedo calo nyig oduro mutop ma doŋ rac adada ma pe gitwero camone. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abilubo korgi ki lweny, kec ki two gemo, abimiyo gibedo ginacaya bot jo me rok me wi lobo ducu, gibitic ki nyiŋgi macalo lok lacen dano, gibibedo gin ma miyo lworo bot dano, ma kelo jwat matek, ki lok me cac i kin rok ducu ka ma onoŋo aryemogi gucito iye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man bitimme i komgi pien gin pe gubedo ka keto cwinygi me lubo lok ma onoŋo acwalo botgi teretere kun wok ki bot luticca lunebi; ento gukwero winyo lokka woko. Man Rwot ma owaco.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuwiny lok pa Rwot, wun jo ducu ma yam gimakowu ki i Jerucalem giterowu woko i opii I Babilon-ni: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Rwot me mony, Lubaŋa pa Icrael, owaco lok ma okemo Akab wod pa Kolaya ki Jedekia wod pa Maceya ma gitito lok me goba botwu ki nyinani. En owaco ni ebimiyogi woko i ciŋ Nebukadnejar kabaka me Babilon, ci en binekogi woko ka maleŋ i nyimwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka inen jo ma yam gikwanyogi ki i Jerucalem giterogi i opii i Babilon gimito ceno ŋat mo, ci gibiwaco ni, “Rwot myero oti kwedi kit macalo en otiyo kwede ki Jedekia gin ki Akab, ma kabaka me Babilon obulogi woko makwo ki mac-ci.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aye bibedo can ma bipoto i komgi pien gubedo ka timo tim mogo ma pe myero, gutimo abor ki mon pa luwotgi, dok bene gubedo ka loko lok goba ki nyiŋa ma kun an pe acikogi ni guloki. An aye ma aŋeyo, dok bene atye macalo caden, man Rwot ma owaco.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot me mony, Lubaŋa pa Icrael owaco bot Jeremia me tito bot Cemaya me Nekelam ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.24",
            "verseOrgIds": [
              "JER.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“In icwalo waraga i nyiŋi keni bot jo Jerucalem ducu, ki bot Jepania wod pa ajwaka Maceya, ki bot ajwagi mukene-gu ducu kun iwacci, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Rwot oketi ibedo ajwaka ma ka ajwaka Yekoyada, wek ibed ladit ma loyo ot pa Rwot kun ineno lupoya ducu ma gitito lok, ci imakgi itwegi ki okol kun iroyo irwako ogul nyonyo i ŋutgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŋo pe ijuko Jeremia ma en dano me Anatot ma tye ka tito lok botwu-ni? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.27",
            "verseOrgIds": [
              "JER.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien en onoŋo ocwalo lok botwa i Babilon ma wacci, Kare me bedowu i opii bibedo dwoŋ; wuger odi ci wubed iye. Wupur poto ci wucam gin ma ocek iye.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajwaka Jepania okwano waraga man bot lanebi Jeremia wek en owiny. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot dok owaco bot Jeremia ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.30",
            "verseOrgIds": [
              "JER.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cwal lok bot jo ma giterogi i opii, kun iwacci, ‘Rwot owaco lok ma okemo Cemaya dano me Nekelam kuman ni, Kit macalo Cemaya doŋ otito lok botwu ma onoŋo an pe acwalo en-ni, dok bene omiyo doŋ wuketo genwu i lok me goba, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.31",
            "verseOrgIds": [
              "JER.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "pi meno Rwot owaco kuman ni, Nen, abiketo can i kom Cemaya dano me Nekelam kacel ki likwayone. Pe bidoŋ ki ŋat mo makwo ki i kom lwak man ma bineno gin maber ma abitimo bot jona, pien en oloko lok ma omiyo dano gujemo i kom Rwot. Man Rwot ma owaco.’’’",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        }
