                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2 Luker 23.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.30+JER.7.31"
              },
              "items": [
                {
                  "text": "Jer 7.30-31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.19.1+JER.19.2+JER.19.3+JER.19.4+JER.19.5+JER.19.6"
              },
              "items": [
                {
                  "text": "19.1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guketo cal lubaŋagi ma en gin me kwer-ri i ot ma gilwoŋo ki nyina, pi balone woko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Levi 18.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2 Luker 23.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "Jer 7.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gugero waŋ jogi mapol me woro Baal i nota pa wod pa Kinom ka ma gityero iye awobegi ki anyiragi bot jok Molek. Pe awaco botgi ni gutim man, dok bene gin ma kit meno onoŋo pe odonyo i tamma ni gibitimo gin macalo meno ma bimiyo jo Juda timo bal.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot, ma en Lubaŋa pa Icrael, owaco lok mukemo gaŋ man kuman ni, “Jeremia, in doŋ itito bot lwak man ni lweny, kec ki two gemo biweko gimiyo gaŋ man woko i ciŋ kabaka me Babilon. Kombeddi winy lok mukene ma an aewaco. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.36",
            "verseOrgIds": [
              "JER.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen, abecito ka coko lwak man woko ducu ki i lobo ducu ka ma yam aryemogi gucito iye i kare ma onoŋo kiniga ki akemo ki akeca omaka i komgi; abidwokogi i kabedo man, abimiyo gibedo maber ki kuc. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.37",
            "verseOrgIds": [
              "JER.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin gibibedo jona, ki an bene abibedo Lubaŋagi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.38",
            "verseOrgIds": [
              "JER.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimiyo gibedo ki cwiny acel ki kit acel, wek gubed ka wora matwal, wek gin ki litinogi ma gi bilubogi i anyim gubed maber. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.39",
            "verseOrgIds": [
              "JER.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiketo gicikke ma bedo nakanaka kwedgi, ni pe abilokke aweko timo gin maber botgi, dok bene abimiyo gibedo ka lwora ki i cwinygi, wek pe gulokke gubwota woko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.40",
            "verseOrgIds": [
              "JER.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cwinya bibedo yom ka timo gin maber botgi, dok abiketogi gibedo i lobo man matwal ki gen madit kun aketogi ki cwinya ducu ki tipona ducu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kit macalo akelo can man aketo i kom lwak man, pi meno bene abecito ka miyogi jami ducu mabeco ma yam acikke ni abimiyo botgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 32:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibiwilo potti ki i lobo man ma iwacci, doŋ odoko tim aroo ka ma dano ki lee doŋ pe gibedo iye, dok bene iwaco ni gibimiyo woko i cin jo Kaldaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.43",
            "verseOrgIds": [
              "JER.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Potti gibiwilo pi lim, ki waraga me wilo lobo bene gibiketo iye cin ci gimwono woko kun caden bene noŋo tye i lobo pa Benjamin, i kabedo ducu ma gurumo Jerucalem, ki i gaŋi me Juda, i gaŋi me lobo godigodi, i gaŋi me Cepela ki i gaŋi me Negeb, Abidwoko gum pa jo man botgi kun adwokogi cen i lobogi kikome. Man Rwot ma owaco.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        }
      ]
    }
