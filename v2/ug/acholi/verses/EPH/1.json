                  "text": "19.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waraga man oa ki bot Paulo ma en lakwena pa Kricito Yecu pi mit pa Lubaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
            "verseOrgIds": [
