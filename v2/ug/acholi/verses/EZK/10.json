              },
              "items": [
                {
                  "text": "Yabo 4.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aneno pete ma tye malo ka wi lukerubi, ci aneno gin mo ma tye ka wigi ma obedo calo komker ma gitiyo ki got capir ma bulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Yabo 8.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ci owaco ki dano ma oruko ooŋo camaniŋi-ni ni, “Wot idony wa i kin lawala ma tye ka wirre-ni, ki piny ka tyen lukerubi-ni, ci ijob bilo poŋ ciŋi ki i kin lukerubi, ci iket woko atata i dye gaŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aneno en ka cito gire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare meno onoŋo lukerubi gueun i ŋet ot yo tuŋ acuc, ka dano-nu doŋ odonyo i ot; ci pol ocako poŋo dyekal me ot woko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci deyo pa Rwot oa woko ki i kom lukerubi ocito wa i doggola me ot pa Rwot. Ci pol opoŋo ot pa Rwot woko, ki dyekal bene opoŋ woko ki deyo pa Rwot ma meny amenya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mor pa bwom lukerubi owinnye wa i dyekal ma tye woko, calo dwan Lubaŋa Matwero Ducu ma onoŋo tye ka loko",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ ociko dano ma oruko boŋo camaniŋi-ni ni. “Kwany mac ki i kin lawala ma tye ka wirre-ni, ki i kin lukerubi,” dano-ni ocito odonyo i kin lawala ci ocun ka ŋet lawala mo acel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci I akerubi mo oryeyo ciŋe ki i kin lukerubi wadigi okemo mac ma onoŋo tye i kin lukerubi, ci okwanyo lodi mac mogo, ka oketo i ciŋ dano ma oruko boŋo camaniŋi-ni; dano-nu ogamo ci okato kwede woko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakerubi acel acel onoŋo tye ki gin mo i te bwome ma nen calo ciŋ dano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.15+EZK.1.16+EZK.1.17+EZK.1.18+EZK.1.19+EZK.1.20+EZK.1.21"
              },
              "items": [
                {
                  "text": "Ejek 1.15-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dok bene aneno ni i ŋet lukerubi onoŋo tye iye lawala aŋwen, ka ŋet lakerubi acel acel onoŋo tye iye lawala acel. Lawala ducu onoŋo giryeny calo kidi me wel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.9",
            "verseOrgIds": [
              "EZK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ducu onoŋo ginen rom, calo onoŋo lawala acel acel giroyo odonyo ki i kin lawala wadi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.10",
            "verseOrgIds": [
              "EZK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ gucako wot, gicito ma gukemo yo aŋwen mapatpat ma kun pe gilokke ka mo, kit yo mo keken ma lawala ma anyim okemo ci lawala mukene-gu ducu gilubo ma pe gilokke ka mo ma noŋo gitye ka wot. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.11",
            "verseOrgIds": [
              "EZK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Yabo 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin lawala magi aŋwen-ni yam doggi tye, cili bene onoŋo tye i komgi, kun Waŋ mapol orumo doggi woko ducu litit. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.12",
            "verseOrgIds": [
              "EZK.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawala magi awinyo ka gilwoŋo ni lawala ma wirre calo yamo lapiru.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.13",
            "verseOrgIds": [
              "EZK.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
