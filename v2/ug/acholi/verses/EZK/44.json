          ]
        },
        {
          "text": "“Dul pa ajwagi i kom gin ma amiyo bot jo Icrael me aleyagi en aye ticgi me bedo ajwagina, Gin ajwagi pe gibibedo ki kit jami mo i Icrael; lonyo ma gimiyo pigi me agwoka aye an, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 44:29"
          },
          "items": [
