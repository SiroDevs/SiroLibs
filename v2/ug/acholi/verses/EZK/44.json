        },
        {
          "text": "“Gibipwonyo jona me ŋeyo apokapoka ma tye i kin jami maleŋ ki jami me nino ducu-gu, kun ginyuto botgi bene kit ma myero gupok kwede kin gin ma keni ki gin ma pe keni, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.23",
            "verseOrgIds": [
              "EZK.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce lok daa nyo pido mo tye, ci gin ajwagi gibibedo luŋolkop, ci giŋolo kop kun gilubo kit ma an aŋolo kwede kop, Gibigwoko cikka ki gin ma an aciko, i kwero nino madito ma giciko ducu, dok bene gibigwoko ceŋ cabitta ducu bedo nino maleŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.24",
            "verseOrgIds": [
              "EZK.44.24"
            ]
          }
        }
