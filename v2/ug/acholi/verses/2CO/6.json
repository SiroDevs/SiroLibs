              },
              "items": [
                {
                  "text": "Ejek 37.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ot pa Lubaŋa kono twero ribbe niŋniŋ ki cal jogi? Pien wan aye wabedo ot pa Lubaŋa makwo; macalo en Lubaŋa doŋ owaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    }
