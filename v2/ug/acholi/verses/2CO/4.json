              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.12",
            "verseOrgIds": [
              "2CO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.13",
            "verseOrgIds": [
              "2CO.4.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.116.10"
              },
              "items": [
                {
                  "text": "Jab 116.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wan watye ki kit cwiny acel-lu me niye ma yam omiyo gicoyo ni, “Aye, en mumiyo aloko.” Wan bene waye, mumiyo watye ka lok. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.13",
            "verseOrgIds": [
              "2CO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waŋeyo ni, ŋat mucero Rwotwa Yecu bicerowa bene kacel ki Yecu, ci bikelowa i nyime kacel kwedwu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.14",
            "verseOrgIds": [
              "2CO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien meno ducu otimme piwu, wek kica pa Lubaŋa omedde bot jo mapol, wek gin bene gumedde ki pwoc madwoŋ ma kelo deyo bot Lubaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "En aye gin mumiyo cwinywa dok pe tye ka dok cen. Kadi bed kwowa ma woko tye ka balle, ento kwo ma i iwa tye ka roc, doko nyen nino ki nino. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.16",
            "verseOrgIds": [
              "2CO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien un ma giunowa kwede pe pek, bedo pi kare manok mo keken, dok bene tye ka yubo botwa deyo mapek ma pe tum, ma dit matek makato; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.17",
            "verseOrgIds": [
              "2CO.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien pe waciko waŋwa i kom gin ma nen, ento i kom gin ma pe nen. Gin ma nen bedo pi kare manok mo keken, ento gin ma pe nen ri nakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.18",
            "verseOrgIds": [
              "2CO.4.18"
            ]
          }
        }
      ]
    }
  ],
