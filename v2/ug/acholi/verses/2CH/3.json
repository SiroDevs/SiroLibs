              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.33+EXO.26.34"
              },
              "items": [
                {
                  "text": "Nia 26.33-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "En dok otiyo kabedo maleŋ makato ducu; borre futi pyeradek, ma rom ki lac me kicika ot maditte, ki lacce bene futi pyeradek. Omwono kome woko ki jabu maberre ma romo talanta miya abicel. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pek me mucumar me jabu ma giguro kwede obedo cekel pyerabic. En dok omwono kicika ma malo ducu ki jabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
