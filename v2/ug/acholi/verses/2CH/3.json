              "2CH.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.18+EXO.25.19+EXO.25.20"
              },
              "items": [
                {
                  "text": "Nia 25.18-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kabedo maleŋ makato ducu en oketo iye cal lukerubi aryo me bao ma gipayo, ci omwono komgi woko ki jabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.10",
            "verseOrgIds": [
              "2CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwom lukerubi ducu borre muyarre romo futi pyeradek. Bwomgi acel acel borre romo futi abiro ki nucu. Wi bwom lakerubi acel ogudo kor ot, kun bwome tuŋcel ma borre futi abiro ki nucu, wiye ogudo wi bwom lakerubi wadi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki bwom lakerubi man bwome acel ma borre futi abiro ki nucu-ni, wiye bene ogudo kicika ot, ki bwome mukene, ma romo futi abiro ki nucu-ni, wiye orwatte ki bwom lakerubi mukwoŋo-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.12",
            "verseOrgIds": [
              "2CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwom cal lukerubi magi borgi muyarre oromo futi pyeradek. Gucuŋ ki tyengi ma gineno tuŋ kicika ot maditte. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31"
              },
              "items": [
                {
                  "text": "Nia 26.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Okwoyo boŋo kicika ki boŋo ma bulu ki ma lamar lamar ki makwarre, ki boŋo camanini maberre, ma odero ki callukerubi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "En dok otiyo wir aryo ma bocogi romo futi pyerabic wiye aryo, ki lalukana i wigi ma bocogi romo futi abiro ki nucu, ci oketogi i nyim ot. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok otiyo nyor macalo tiko nut, ci oketogi i wi wir aryo ducu, ka dok otimo cal nyig okwer pomegranat miya acel, ci oketogi i kom nyor. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ocibo wir magi i nyim ot pa Lubaŋa, acel yo tuŋ acuc, ki mukene yo tuŋ acam. Ocako nyiŋ ma yo tuŋ acuc-ci ni, Jakin, ki ma yo tuŋ acam-mi olwoŋo ni Boaj,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        }
      ]
    }
