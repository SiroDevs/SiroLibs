              "2CH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
