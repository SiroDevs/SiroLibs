              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon wod pa Daudi omoko kerre matek, kun Rwot Lubaŋane bene onoŋo tye ‘kwede, ma omiyo en obedo madit twatwal.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        }
      ]
    },
    {
