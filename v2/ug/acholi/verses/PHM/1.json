                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Epapira mabuc wadiwa i Kricito Yecu omoti, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.23",
            "verseOrgIds": [
              "PHM.1.23"
            ]
