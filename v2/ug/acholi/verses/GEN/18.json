            "number": "33",
            "style": "v",
            "sid": "GEN 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci doŋ Rwot ocako cito, ka doŋ otyeko lok ki Abraim; ci Abraim odok gire i kabedone.",
          "type": "text",
