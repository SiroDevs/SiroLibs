          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno nino me kwo pa Metucela ducu oromo mwaka miya aboŋwen ki pyerabicel wiye aboŋwen; ka doŋ oto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.27",
