          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ceji ori i ŋe nywalo Enoci mwaka miya aboro ki abiro, dok omedde ki nywalo awobe ki anyira bene. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
