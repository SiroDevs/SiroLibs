        },
        {
          "text": "Kit meno nino me kwo pa Ceji ducu oromo mwaka miya aboŋwen ki apar wiye aryo; ka doŋ oto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.8",
