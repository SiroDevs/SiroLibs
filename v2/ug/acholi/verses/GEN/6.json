            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.37"
              },
              "items": [
                {
                  "text": "Mat 24.37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.26"
              },
              "items": [
                {
                  "text": "Luka 17.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.20"
              },
              "items": [
                {
                  "text": "1 Pet 3.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot oneno ni bal pa dano odoko dit woko i wi lobo, dok tam ducu ma cwinygi lwodo kare ducu kemo bal keken. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.5",
            "verseOrgIds": [
              "GEN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot oŋut pi cweyo dano i lobo, ocwero cwinye matek. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owacci, “Abijwero dano woko ma yam aketo-ni ki wi lobo, dano ki lee ki gin ma lak alaka ki winyo me polo, pien doŋ atyeko ŋut pi cweyogi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Nua aye onoŋo yomo cwiny Rwot.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        }
      ]
    },
