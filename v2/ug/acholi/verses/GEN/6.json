              },
              "items": [
                {
                  "text": "2.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka dano gucako medde wi lobo, ci gunywalo anyira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka awobe pa Lubaŋa guneno anyira pa dano beco, gucako yero me anyoma ki i kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Rwot owacci, “Cwinya pe doŋ bibedo i dano matwal, pien en kom mamwa, ento kare me kwone bibedo mwaka miya acel ki pyeraryo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.33"
              },
              "items": [
                {
                  "text": "Wel 13.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jo Nepil onoŋo gitye i lobo i kare meno, ki lacen bene, i kare ma awobe pa Lubaŋa guyabo wi anyira pa dano, gunywalo kwedgi litino. Gin aye cog jo matego mukwoŋo i lobo, ma nyiŋgi ŋene matek.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
