              "type": "text"
            }
          ]
        },
        {
          "text": "Litino awobe pa Lakeri gin aye Yucepu ki Benjamin. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
