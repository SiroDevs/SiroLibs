            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.21",
            "verseOrgIds": [
              "GEN.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.4"
              },
              "items": [
                {
                  "text": "Acak 49.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare ma Icrael tye i lobo meno, ci wode Reuben otimo caro, obuto ki ci-wonne Bila ma aŋeca; ci wonne owinyo pire bene.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yam tye ki awobene apar wiye aryo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litino awobe pa Lea gin aye Reuben, latin kayo pa Yakobo, Cimeon, Levi, Juda, Icakar ki Jabulon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
