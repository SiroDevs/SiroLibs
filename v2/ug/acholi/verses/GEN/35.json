          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litino awobe pa Bila, aŋeca: pa Lakeri, gin aye Dan ki Naputali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
