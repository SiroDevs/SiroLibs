        },
        {
          "text": "Yakobo obino bot wonne Icaka i Mamre, i Kiriat-arba, en aye Kebron ka ma yam Abraim ki Icaka gubedo iye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
