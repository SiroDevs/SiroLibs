              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icaka yam ori wi lobo mwaka miya acel ki pyeraboro, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
