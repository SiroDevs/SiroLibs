            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwir mukwoŋo opoto i kom Yucepu, ma jo pa Acap; me aryone opoto i kom Gedalia, ci okwako en ki omegine, ki litino awobene, gin ducu apar wiye aryo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
