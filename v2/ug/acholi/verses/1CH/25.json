      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ki ludito ma loyo tic gubolo tic ki jo mogo ma i kin likwayo pa Acap, pa Eman ki pa Jedutun, wek gutit lok pa Lubaŋa macalo lunebi ki opuk ki naŋa ki atego agoya-gu, Nyiŋ jo ma yam gitiyo tic man, ki dog ticgi gin ene: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "i kin litino pa Acap, Jakur, Yucepu, Netania ki Acarela, ma litino pa Acap, Acap aye telogi i wer, kun tito lok ma a ki bot Lubaŋa, i te cik pa kabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litino pa Jedutun gin Gedalia, Jeri, Jecaya, Cimei, Kacabia ki Matitia, gin abicel, ma wongi Jedutun aye telogi i wer, kun tito lok a ma ki bot Lubaŋa ki opuk pi miyo pwoc bot Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litino pa Eman gin Bukia, Matania, Ujiel, Cebuel, ki Jerimot, Anania, Kanani, Eliata, Gidalti, ki Romamtiejer, Jocebekaca, Maloti, Kotir ki Makajiot. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi ducu aye litino pa Eman ma lanen pa kabaka, macalo Lubaŋa yam ociko bote ni ebipilo wiye; pien Lubaŋa omiyo ki Eman litino awobe apar wiye aŋwen ki anyira adek. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ducu yam wongi aye telogi i wer i ot pa Rwot, kun giwero ki atego agoya, naga ki opuk pi konyo lega ma i ot pa Lubaŋa, Acap, Jedutun ki Eman yam gitiyo i te loc pa kabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wei jo man giribo ki utmegigi ma yam gipwonyogi ki wer bot Rwot, jo ducu ma yam luryeko, giromo miya aryo ki pyeraboro wiye aboro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ducu gipokogi i dog tic kun gibolo kwir, kun jo matino ki jo madito, lupwony ki jo ma gipwonyogi, gitimogi ducu marom.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        }
      ]
    },
    {
