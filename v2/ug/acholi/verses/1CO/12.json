          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuket cwinywu i noŋo mot ma pigi dito.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
