              "items": [
                {
                  "text": "Nwo 32.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pe, gin ma awaco en ene ni, gitum ma jo ma pe ŋeyo Lubaŋa gutyero, gityero bot jogi, ento pe gityero bot Lubaŋa. Pe amito wuribbe ki jogi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.20",
            "verseOrgIds": [
              "1CO.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe wutwero mato ki kikopo pa Rwot ki pa jogi. Pe wutwero cam i meja pa Rwot ki dok i meja pa jogi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.21",
            "verseOrgIds": [
              "1CO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.21"
              },
              "items": [
                {
                  "text": "Nwo 32.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wamito omo cwiny Rwot wek nyeko omake? Wan mono watye ki tek wakato en?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.22",
            "verseOrgIds": [
              "1CO.10.22"
            ]
          }
        }
