              "type": "text"
            }
          ]
        },
        {
          "text": " Utmegina, amito wuŋe ni, kwarowa ducu yam gubedo i te pol, gin ducu guwok ki i dye nam, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.1",
            "verseOrgIds": [
              "1CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "gin ducu bene yam gibatijagi i i pol ki i nam, wek doŋ gubed jo pa Moses. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.2",
            "verseOrgIds": [
              "1CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.35"
              },
              "items": [
                {
                  "text": "Nia 16.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin ducu yam gucamo cam acel me cwiny, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.3",
            "verseOrgIds": [
              "1CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.6"
              },
              "items": [
                {
                  "text": "Nia 17.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.11"
              },
              "items": [
                {
                  "text": "Wel 20.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " gin ducu bene gumato ginamata acel me cwiny. Pien gumato pii mua ki i kom got me cwiny ma woto kacel kwedgi, got meno yam en Kricito. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.4",
            "verseOrgIds": [
              "1CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.29"
              },
              "items": [
                {
                  "text": "Wel 14.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kadi bed kumeno, Lubaŋa pe opwoyo pol jo mogo ma i kingi; pien guto gutum woko liweŋ i tim.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
