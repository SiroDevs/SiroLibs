          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka laro kop mo tye ikin dano, ka gubino ka ma gipido iye, ce luŋolkop guŋolo kop i kingi kun gituco dano ma pe ki bal, ka giŋolo kop loyo latim bal, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.1",
            "verseOrgIds": [
              "DEU.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka dano ma labalo romo agoya, ci laŋolkop miyo en buto piny ci gigoye ki i nyime ki wel odoo muporo kit balle. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.24"
              },
              "items": [
                {
                  "text": "2 Kor 11.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wel odoo twero bedo pyeraŋwen, ento pe okat kenyo, wek pe gigoye ki lwak goco makato meno miyo wucayo ominwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        }
      ]
    },
