            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.8+EXO.17.9+EXO.17.10+EXO.17.11+EXO.17.12+EXO.17.13+EXO.17.14"
              },
              "items": [
                {
                  "text": "Nia 17.8-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Cam 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Wupo gin ma yam jo Amalek gutimo i komwu i yo i kare ma wua woko ki i Ejipt, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kit ma yam gulwenyo kwede i komwu i yo ca, i kare ma onoŋo wuder, ma komwu ducu oloc woko, kit ma gin guŋolo kwede wi jo ma gudoŋ i ŋewu ma gi goro; gin yam pe gulworo Lubaŋa wacel. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce Rwot Lubaŋawu doŋ omiyo wuywe ki lweny ki merokwu ducu ma orumowu dyere-ni, ki i lobo ma Rwot Lubaŋawu bimiyo wucamo me aleyawu, ci wubijwayo jo Amalek woko ki i tam pa dano ducu ma gitye piny i te polo. Wukan lok man i cwinywu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.19",
            "verseOrgIds": [
              "DEU.25.19"
            ]
          }
        }
      ]
    }
