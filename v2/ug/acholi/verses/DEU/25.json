            "number": "11",
            "style": "v",
            "sid": "DEU 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ce co gitye ka lweny kekengi, ka dako pa ŋat acel onyiko cok ka laro cware ki i ciŋ dano ma tye ka goye-ni, ce ocwalo ciŋe omako kom me co pa laco-ni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci ibitoŋo ciŋ dako iŋolo woko, ma kica pe maki i kome.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        }
      ]
    },
