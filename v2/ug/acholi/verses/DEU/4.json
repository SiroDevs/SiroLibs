              },
              "items": [
                {
                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento yam Rwot okwanyowu ci okelowu woko ki i lobo Ejipt, en lobo ma obedo calo buk mac me teto nyonyo ma otwak me waŋowu, wek wubed jone kikome macalo i kare man. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.20",
            "verseOrgIds": [
              "DEU.4.20"
            ]
          }
        },
