                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.15"
              },
              "items": [
                {
                  "text": "27.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pi meno wugwokke wek pe wuballe pi payo cal mo piwu kenwu, kadi cal kom gin mo-ni muporo laco nyo dako, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.16",
            "verseOrgIds": [
              "DEU.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.23"
              },
              "items": [
                {
                  "text": "Rom 1.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nyo muporo lee mo ma tye i wi lobo, nyo winyo mo ma tuk ki bwome i dye yamo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.17",
            "verseOrgIds": [
              "DEU.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo gin mo ma lak alaka i nom, nyo rec mo ma bedo i pii ma i te lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.18",
            "verseOrgIds": [
              "DEU.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok wugwokke wuwek tiŋo waŋwu malo i polo; miyo ka wuneno iye cen ki dwe ki lwak lakalatwe, ma gin ducu mony ma i polo, ci cwinywu biterowu ka ryebbe piny i nyimgi ka worogi, kun noŋo Rwot Lubaŋawu omiyogi bot rok ducu ma gitye piny i te polo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.19",
            "verseOrgIds": [
              "DEU.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 4:20"
          },
          "items": [
