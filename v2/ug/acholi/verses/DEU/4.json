                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.1"
              },
              "items": [
                {
                  "text": "Levi 26.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
