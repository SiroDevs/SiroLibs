              "DEU.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Myero doŋ wugwokke kenwu matek. Yam pe wuneno kom mo i kare ma Rwot oloko iye botwu i Koreb ki i dye mac ca; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.15",
            "verseOrgIds": [
              "DEU.4.15"
            ]
          }
        },
        {
          "name": "verse",
