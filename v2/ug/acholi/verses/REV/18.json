          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "cinamon ki gin mogo mukene ma ŋwecgi kur, odok eceta me awaŋa, murra, odok luban, koŋo vino, moo jeituni, moko mapwot ki ŋano, dyaŋi ki romi, aguragura, ki gadigadi lweny, opii, kadi wa kwo pa dano kikome.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        }
