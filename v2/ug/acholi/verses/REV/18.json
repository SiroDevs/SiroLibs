                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " jabu, ryal, litino kidi me wel, tiko matar me wel, boŋo camanini maberre, boŋŋi ma obedo lamar lamar, boŋŋi aridi ki makwar, ki kit bao mapatpat ducu ma ŋwecgi kur, jami ducu ma gitiyo ki lak lyec-gu, jami ducu ma gitiyogi ki bao ma welgi malo twatwal, mola, nyonyo, ki got me gedo ma giliyo aliya maber twatwal, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
        {
          "name": "verse",
