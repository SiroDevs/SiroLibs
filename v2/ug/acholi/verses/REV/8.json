              "items": [
                {
                  "text": "Ic 14.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lamalaika me adekke okuto tumme, ci lakalatwe madit oa ki i polo opoto piny, ma lyel calo mac dog raa, opoto i kom dul acel me adek me kulu ducu, ki i waŋ it ducu ma piine gunnye agunya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
