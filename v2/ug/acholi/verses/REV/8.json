          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cutcut lumalaika abiro ma onoŋo gitye ki tum abiro-ni guyubbe doŋ me kutone.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
            ]
          }
        }
