              "items": [
                {
                  "text": "Ejek 38.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ci lamalaika mukwoŋo okuto tumme, omiyo pee ki mac ma orubbe ki remo ocorre i lobo. Meno omiyo acel me adek me lobo owaŋ woko, ki acel me adek me yadi bene, ki lum madyak ducu bene owaŋ wok licwic.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        }
