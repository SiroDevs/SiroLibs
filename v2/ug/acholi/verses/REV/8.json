                "loc": "LEV.16.12"
              },
              "items": [
                {
                  "text": "Levi 16.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.2"
