                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.19"
              },
              "items": [
                {
                  "text": "Yabo 11.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.18"
              },
              "items": [
                {
                  "text": "16.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lacen doki lamalaika okwanyo atabo me waŋo odok eceta, otoko lodi mac ki i keno tyer poŋ atabo meno, ci obolo woko piny i lobo; cutcut kot ocako mor kun mwoc matek adada, ma noŋo lutkot wil awila, ki oyeŋyeŋ bene oyeŋo piny.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
