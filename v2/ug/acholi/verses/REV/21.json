                  "text": "Ic 60.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pe gibiloro dogcelle i dyeceŋ, ki dyewor bene bibedo pe kunnu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
              "REV.21.25"
            ]
