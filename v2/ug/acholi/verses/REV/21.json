          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibitero iye deyo ki lonyo pa rok ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.26",
            "verseOrgIds": [
