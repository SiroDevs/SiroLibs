          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe aneno ot mo me woro Lubaŋa i gaŋ meno, pien ot me woro Lubaŋa ki kunnu en aye Rwot Lubaŋa Won Twer Ducu kikome, ki Latin romo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.22",
            "verseOrgIds": [
              "REV.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
