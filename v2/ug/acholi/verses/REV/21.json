              "items": [
                {
                  "text": "Ic 60.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Leŋo ma tye iye bimiyo rok ducu giwoto maber; ki luker ducu ma i wi lobo gibikelo deyogi iye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.24",
