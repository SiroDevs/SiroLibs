                "loc": "ISA.60.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ceŋ nyo dwe pe bimitte i gaŋ meno me ryeny iye, pien deyo pa Lubaŋa aye leŋo ma tye kunnu, ki tarane en aye Latin romo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
            "verseOrgIds": [
              "REV.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
