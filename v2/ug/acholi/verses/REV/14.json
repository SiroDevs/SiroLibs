                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Yabo 7.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lacen dok aneno Latin romo ma ocuŋ i wi got Cion; onoŋo jo alip miya acel ki pyeraŋwen wiye aŋwen tye kacel kwede, ma doŋ onoŋo gicoyo nyiŋe ki nyiŋ Wonne woko i tur nyimgi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.1",
            "verseOrgIds": [
              "REV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci awinyo dwan mo oa ki i polo ma mor calo pii ma tye ka curre, ki dok calo kot ma tye ka mor matek. Dwan ma awinyo ca onoŋo obedo calo dwan lugo-naŋa ma tye ka goyo naŋagi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.2",
            "verseOrgIds": [
              "REV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoŋo gitye ka wero wer manyen i nyim komker, ki i nyim lee makwo aŋwen-ni, ki i nyim ludoŋo-gu bene. Pe tye ŋat mo ma onoŋo twero pwonyo wer meno, kono jo alip miya acel ki pyeraŋwen wiye aŋwen ca keken ma doŋ gikokogi woko ki i lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.3",
            "verseOrgIds": [
              "REV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi gin aye jo ma pe gubalo komgi ki timo tim tarwaŋ ki mon, pien gugwokke gubedo jo maleŋ; dok bene gin jo ma lubo Latin romo ka ma en woto iye ducu. Jo magi aye gin jo ma gikokogi ki i kin dano ducu, wek gubed calo cam mukwoŋo cek ma giyubo pi Lubaŋa ki Latin romo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.4",
            "verseOrgIds": [
              "REV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.13"
              },
              "items": [
                {
                  "text": "Jep 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pe giwinyo lok goba mo i doggi; gubedo laboŋo roc mo i komgi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok aneno lamalaika mukene tye ka tuk wirre i dye polo; onoŋo tye ki lok me kwena maber me atita bot jo ma gibedo i wi lobo, bot rok ducu ki kaka ki leb-gu ki jo mapatpat ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.6",
            "verseOrgIds": [
              "REV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci oloko ki dwan maloŋo ni, “Wulwor Lubaŋa, wumi deyo bote, pien karene me ŋolo kop doŋ oromo. Wuwor en ŋat ma oketo polo ki lobo ki nam ki waŋ it-gu.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.7",
            "verseOrgIds": [
              "REV.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
