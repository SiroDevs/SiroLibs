                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.2"
              },
              "items": [
                {
                  "text": "Yabo 18.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lamalaika mukene me aryone dok olubo kor lawote, kun wacci, “Babilon madit doŋ opoto, opoto gire woko, en gaŋ ma yam omiyo rok ducu mato koŋo vino me timme me tarwaŋ-ŋi.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.8",
            "verseOrgIds": [
              "REV.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.8",
            "verseOrgIds": [
              "REV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamalaika mukene me adekke dok olubo korgi, kun loko ki dwan maloŋo ni, “Ka ce ŋat mo oworo lee-nu ki calle, ma noŋo giketo poyo i tur nyime nyo i ciŋe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.9",
            "verseOrgIds": [
              "REV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.51.17"
              },
              "items": [
                {
                  "text": "Ic 51.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Acak 19.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.22"
              },
              "items": [
                {
                  "text": "Ejek 38.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ci en bimato koŋo vino me akemo pa Lubaŋa, ma oonyo i kikopo me kinigane ma pe girubo ki pii, gibibedo ka une ki mac ki gweŋ calfa ma mac oliyo woko, i nyim lumalaika maleŋ ki i nyim Latin romo bene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.10",
            "verseOrgIds": [
              "REV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.10"
              },
              "items": [
                {
                  "text": "Ic 34.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yito mac ma giunogi kwede bedo ka duny nakanaka cito malo, kun pe giywe i dyeceŋ wa i dyewor bene, gin jo ma giworo lee-nu ki calle, kadi wa ŋat ma doŋ giketo poyo me nyiŋ lee meno i kome.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.11",
            "verseOrgIds": [
              "REV.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.11",
            "verseOrgIds": [
              "REV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meno aye ka ma jo pa Lubaŋa myero gunyut iye kit ma giciro kwede can, gin jo ma gwoko cik pa Lubaŋa ki niyegi i kom Yecu Kricito.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.12",
            "verseOrgIds": [
              "REV.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.12",
            "verseOrgIds": [
              "REV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok awinyo dwan mo oa ki i polo ma wacci, “Co lok man ni, Cakke kombeddi jo ma to ma noŋo gitye i Rwot tye ki gum.” Cwiny Maleŋ bene omoko lok man kun wacci, “Adada kit meno, doŋ gibiywe ki i tic matek ma yam gubedo ka tiyone, pien ticgi ma yam gutiyo-ni lubo korgi.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.13",
            "verseOrgIds": [
              "REV.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.13",
            "verseOrgIds": [
              "REV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.14",
            "verseOrgIds": [
              "REV.14.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Dan 7.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lacen doki aneno pol matar, ki ŋat mo obedo i wi pol ma cal ki wod pa dano. Lalukana jabu onoŋo tye i wiye, ki pala kac mabit bene onoŋo tye i ciŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.14",
            "verseOrgIds": [
              "REV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Joel 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ka dok lamalaika mukene okatti ki i ot pa Lubaŋa, kun daŋŋe matek bot ŋat ma onoŋo obedo i wi pol-li ni, “Cwal ciŋi ika kac ki pala kacci, pien kare me kac doŋ oromo, ki gin ma gikayo i lobo bene doŋ ocek woko.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.15",
            "verseOrgIds": [
              "REV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno ŋat ma onoŋo obedo i wi pol-li oryeyo ciŋe i lobo ki pala kac, ci okayo gin mucek i lobo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamalaika mukene doki okatti ki i ot pa Lubaŋa ma tye i polo, en bene onoŋo omako pala kac mabit. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.17",
            "verseOrgIds": [
              "REV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
