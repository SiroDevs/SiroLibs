              "REV.10.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Ejek 2.8–3.3\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Doki awinyo ka dwan ma onoŋo oa ki i polo-ni tye ka lok kweda tyen me aryo kun wacci, “Cit ikwany buk adola ma oyabbe ma tye i ciŋ lamalaika ma ocuŋ i wi nam ki i lobo-ni.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci acito bot lamalaika meno, atitte ni omiya buk adola matidi-nu; ci en ogamo owacca ni, “Gam icam woko. Bibedo kec i ii, ento bibedo lim i dogi calo moo kic.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.9",
            "verseOrgIds": [
              "REV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cutcut agamo buk adola matidi ca woko ki i ciŋ lamalaika ci acamo woko. Obedo lim i doga calo moo kic, ento i kare ma doŋ atyeko camone, obedo makec i iya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.10",
            "verseOrgIds": [
              "REV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ giwacca ni, “In myero doki itit lok pa Lubaŋa, i kom lwak dano mapatpat ki rok ki leb ki luker ducu.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.11",
            "verseOrgIds": [
              "REV.10.11"
            ]
          }
        }
      ]
    }
