      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok aneno lamalaika mukene matek twatwal oa ki i polo kun lor bino piny. Orukke woko ki pol, ma onoŋo danyu tye i wiye, waŋe onoŋo obedo calo ceŋ, ki tyene onoŋo obedo calo wir mac. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.1",
            "verseOrgIds": [
              "REV.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoŋo buk adola matidi tye i ciŋe ma iye oyabbe woko. Oketo tyene tuŋ lacuc i nam ki tyene lacam oketo i wi lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.2",
            "verseOrgIds": [
              "REV.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odaŋŋe ki dwan maloŋo calo labwor ma moro dwane; ka odaŋŋe, ci mor pa kot omwoc amwoca ma romo tyen abiro kulu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.3",
            "verseOrgIds": [
              "REV.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kot doŋ omor omwoc tyen abiro, ci ayubbe ka coc, cutcut acako winyo dwan ma a ki i polo kun wacci, “Mwon lok ma mor kot abiro-ni guwaco woko, pe ico acoya.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.4",
            "verseOrgIds": [
              "REV.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.11"
              },
              "items": [
                {
                  "text": "Nia 20.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.40"
              },
              "items": [
                {
                  "text": "Nwo 32.40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.7"
              },
              "items": [
                {
                  "text": "Dan 12.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.3.7"
              },
              "items": [
                {
                  "text": "Amoc 3.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ci lamalaika ma onoŋo aneno ocuŋ i nam ki i lobo-ni otiŋo ciŋe lacuc malo i polo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka okwoŋo kwoŋ ki nyiŋ ŋat ma bedo nakanaka, ma oketo polo ki jami ducu ma tye iye, ki lobo ki jami ducu ma tye iye, kacel ki nam ki jami ducu ma tye iye kun wacci, “Agalagala mo doŋ pe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.6",
            "verseOrgIds": [
              "REV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento ka kare oromo ma lamalaika me abiro bikuto tumme, Lubaŋa bicobo tamme ma tye i muŋ kit macalo yam otito bot luticce lunebi.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
