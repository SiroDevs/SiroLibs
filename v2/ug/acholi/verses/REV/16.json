            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.3"
              },
              "items": [
                {
                  "text": "Yabo 3.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (Nen, abebino macalo lakwo! Dano ma bedo ma waŋe twolo kun kiyo piny tye ki gum, ma kun noŋo gwoko boŋŋine, wek pe ewot munero, ma dano gineno kome ma pe eruko iye boŋo!) ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.29"
              },
              "items": [
                {
                  "text": "2 Luker 23.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.11"
              },
              "items": [
                {
                  "text": "Jek 12.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gucoko luker kacel i kabedo ma gilwoŋo i leb Ibru ni Armagedon.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
              "REV.16.16"
            ]
          }
        }
      ]
    },
    {
