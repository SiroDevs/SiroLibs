            "number": "16",
            "style": "v",
            "sid": "REV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
              "REV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamalaika me abirone doŋ oonyo gin ma tye i atabone i dye yamo, ci dwan mo madit oa ki i ot pa Lubaŋa, ki i wi komker kun wacci, “Doŋ otimme!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.17",
            "verseOrgIds": [
              "REV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Yabo 8.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.13"
              },
              "items": [
                {
                  "text": "11.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ci lutkot ocako wil awila, mor winnye matek, ki mwoc pa kot, ki oyeŋyeŋ madit oyeŋo piny, kit oyeŋyeŋ mo ma peya yam onen cakke ma dano gubedo i lobo; oyeŋyeŋ meno obedo dit adada. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.18",
            "verseOrgIds": [
              "REV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
