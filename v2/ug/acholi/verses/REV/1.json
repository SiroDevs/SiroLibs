              "items": [
                {
                  "text": "Yabo 5.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ka doŋ olokowa wadoko lwak ma en loyo, kun wadoko ajwagi pa Lubaŋane ma Wonne bene. Deyo ki twero me loc obed bote nakanaka. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
