                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.27"
              },
              "items": [
                {
                  "text": "Jab 89.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ki ma a bene ki bot Yecu Kricito, lacaden ma genne, latin kayo i kin jo muto, kabaka madit ma loyo luker ducu ma i wi lobo-ni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
