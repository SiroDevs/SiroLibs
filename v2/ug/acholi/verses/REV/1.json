          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deyo obed bot ŋat ma marowa, ma nene ogonyowa woko ki i twec me balwa ki remone, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
