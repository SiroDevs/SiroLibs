              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kica ki kuc obed botwu, ma oa ki bot Lubaŋa ma tye, ma yam obedo tye wa con, dok ma bibino, kun a ki bot cwiny abiro ma gitye i nyim komkerre, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
