          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki i ŋe lok meno ducu Yocwa wod pa Nun ma latic pa Rwot oto woko ma onoŋo mwaka me ditte oromo miya acel ki apar. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.49+JOS.19.50"
              },
              "items": [
                {
                  "text": "Yoc 19.49-50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guyiko kome i lobone kikome, i ginaleya ma yam gimiyo bote, i Timnat-cera i lobo godi pa jo Epraim i ŋet got Gaac, yo tuŋ acam.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
