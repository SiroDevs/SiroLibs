          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "I lobo me ginaleyagi onoŋo tye iye gaŋi magi Jora, Ectaol, Ir-cemec, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
            ]
          }
        },
