              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ gutyeko poko lobo i dul mapatpat me bedo ginaleyagi, jo Icrael gumiyo dul lobo bot Yocwa wod pa Nun obed ginaleyane i kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumiyo bote gaŋ ma en olego ki botgi kit ma Rwot ocikogi kwede, en aye Timnatcera ma i lobo godi pa jo Epraim. En dok ogero gaŋŋ eodoco ci obedo iye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
