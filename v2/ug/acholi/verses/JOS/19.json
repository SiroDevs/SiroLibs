              "type": "text"
            }
          ]
        },
        {
          "text": "Kwir, ma gibolo me abiro opoto i kom kaka pa jo Dan muporo doggolagi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.40",
            "verseOrgIds": [
              "JOS.19.40"
            ]
