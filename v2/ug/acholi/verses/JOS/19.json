          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meno aye ginaleya pa jo Dan ma oporo doggolagi, gaŋi magi ki gaŋi matino ma i ŋetgi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        }
