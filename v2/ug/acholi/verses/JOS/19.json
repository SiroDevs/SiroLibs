                "loc": "JDG.18.27+JDG.18.28+JDG.18.29"
              },
              "items": [
                {
                  "text": "Luŋol 18.27-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento ka lobo pa jo Dan orwenyo woko ki i ciŋgi, gucito gulwenyo i kom gaŋ mo ma nyiŋe Lecem, gumayo, guneko dano ma gubedo iye ducu ki pala lucwan, guloko gaŋ meno odoko megi, gucako bedo iye. Guloko nyiŋ Lecem gucako ni, Dan macalo nyiŋ kwarogi Dan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.47",
            "verseOrgIds": [
              "JOS.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
