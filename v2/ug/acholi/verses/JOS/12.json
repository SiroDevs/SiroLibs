          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kabaka me Dor ma i Napat-dor, kabaka me Goyim ma i Galilaya; ",
          "type": "text",
          "attrs": {
