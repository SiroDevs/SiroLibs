              "JOS.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.20",
            "verseOrgIds": [
              "JOS.6.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.30"
              },
              "items": [
                {
                  "text": "Ibru 11.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno lumony gudaŋŋe ki woo ki ajwagi gukuto tum obute, Tekki lumony guwinyo dwan obute ci gutugi daŋŋe ki woo matek, ci cel me gaŋ omuk opoto woko piny ducu, ka doŋ lumony gudonyo i gaŋ kun dano acel acel woto tiko nyime atir, gumako gaŋ woko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.20",
            "verseOrgIds": [
              "JOS.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gujwero co wa ki mon, litino ki ludoŋo ducu, ki dyaŋi ki romi ki kana-gu; gin ducu gutum woko kun gineko ki pala lucwan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Yocwa owaco bot jo aryo ma yam guroto lobo ni, “Wucit i ot pa dako ma lakwele-ni, wukele woko ki jone ducu, kit ma yam wukwoŋo boteni,” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.22",
            "verseOrgIds": [
              "JOS.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno awobe ma yam guroto lobo gudonyo i ot, gukelo Rakab woko kacel ki wonne ki minne ki omegine ki jone ducu. Gutero ludoggolane ducu, guketogi woko i ŋe gony pa jo Icrael. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.23",
            "verseOrgIds": [
              "JOS.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lacen lumony guwaŋo gaŋ woko ki mac, ki gin ducu ma tye iye; ento guweko ryal ki jabu ki jami me mola ki me nyonyo-gu, guketogi i ot ma gikano iye lim pa Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.24",
            "verseOrgIds": [
              "JOS.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.31"
              },
              "items": [
                {
                  "text": "Ibru 11.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento Rakab ma lakwele-ni ki jo me ot pa wonne kacel ki jone ducu, Yocwa owekogi makwo. Gibedo i kin jo Icrael nio wa onyoo, pien Rakab yam okano lukwena ma Yocwa onoŋo ocwalogi ka roto Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.25",
            "verseOrgIds": [
              "JOS.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
