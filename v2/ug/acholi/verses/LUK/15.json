              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento latinni man obino ma olanyo limmi ducu i kom mon ma lucoco, in inekke wod twon mucwe!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.30",
            "verseOrgIds": [
              "LUK.15.30"
            ]
          }
