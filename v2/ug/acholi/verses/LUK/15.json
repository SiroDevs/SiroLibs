          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ber wacam kun wabedo ki yomcwiny, pien omeruni yam oto, koni doŋ kwo, yam orwenyo, doŋ ginoŋe.’ ”",
          "type": "text",
          "attrs": {
