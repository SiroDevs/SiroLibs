          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonne ogamo doge ni, ‘Latinna, in nino ducu itye kweda, jamina ducu meri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.31",
            "verseOrgIds": [
              "LUK.15.31"
            ]
          }
        },
