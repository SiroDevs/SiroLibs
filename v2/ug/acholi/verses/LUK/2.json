              "type": "text"
            }
          ]
        },
        {
          "text": " Ka lunyodone doŋ gutyeko cobo lok ducu ma tye i cik pa Rwot, ci gudok i Galilaya, i gaŋgi Najaret. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
