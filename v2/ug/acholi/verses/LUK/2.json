              "items": [
                {
                  "text": "Luka 1.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka nino aboro doŋ oromo me liro latin, gicako nyiŋe Yecu, nyiŋ ma lamalaika yam ocako ka en pud peya tye i ic.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
