              "type": "text"
            }
          ]
        },
        {
          "text": "Cimeon otiŋe i bade, opwoyo Lubaŋa kun waco ni,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.28",
            "verseOrgIds": [
