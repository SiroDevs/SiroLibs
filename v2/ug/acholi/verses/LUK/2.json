          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Latin odoŋo odoko matek, kun opoŋ ki ryeko; cwiny Lubaŋa obedo yom i kome.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
