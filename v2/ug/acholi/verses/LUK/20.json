                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Jab 110.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien Daudi kikome bene owaco i buk me Jabuli ni",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.42",
            "verseOrgIds": [
              "LUK.20.42"
            ]
          }
        }
