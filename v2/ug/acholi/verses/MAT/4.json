              },
              "items": [
                {
                  "text": "Jon 2.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " oweko Najaret, ci ocito obedo i Kapernaum ma tye i dog nam, i lobo Jabulon ki Naputali, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
