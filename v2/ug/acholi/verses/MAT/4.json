              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Cutcut ka Yecu owinyo ni gimako Jon gitweyo woko i mabuc, oa obino i Galilaya; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
          }
        },
        {
