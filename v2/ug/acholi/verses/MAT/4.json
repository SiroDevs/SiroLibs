          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwak dano mapol ata ma gua ki i Galilaya, Dekapoli, Jerucalem, Judaya ki loka Jordan ducu gulube.",
          "type": "text",
          "attrs": {
