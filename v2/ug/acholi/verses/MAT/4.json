            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Cakke i kare meno Yecu ocako tito lok kun wacci, “Wuŋuti, pien ker me polo doŋ onyiko cok.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
              "MAT.4.17"
            ]
          }
        }
