              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yecu dok ogamo doge owacci, “Yam bene gicoyo ni, ‘Pe iom i Rwot Lubaŋani.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.7",
            "verseOrgIds": [
              "MAT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Catan dok otere malo i wi got mabor adada, ci onyutte ker ducu ma i wi lobo ki deyogi ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.8",
            "verseOrgIds": [
              "MAT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Catan owacce ni, “Magi ducu abimiyo boti, ka iryebbe iwora.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.9",
            "verseOrgIds": [
              "MAT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.13"
              },
              "items": [
                {
                  "text": "Nwo 6.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ci Yecu owacce ni, “Nyik icit cen, Catan, pien yam gicoyo ni,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.10",
            "verseOrgIds": [
              "MAT.4.10"
            ]
          }
        }
      ]
