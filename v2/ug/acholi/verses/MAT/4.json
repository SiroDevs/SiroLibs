          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "wek lok ma yam lanebi Icaya oloko ocobbe kakare ni,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.14",
            "verseOrgIds": [
              "MAT.4.14"
            ]
          }
