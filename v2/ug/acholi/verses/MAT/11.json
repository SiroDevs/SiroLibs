                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ento atitti ni, can pa Codom bibedo tworatwora i nino me ŋolo kop, makato can ma bipoto i komi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.24",
