                "loc": "JOL.3.4+JOL.3.5+JOL.3.6+JOL.3.7+JOL.3.8"
              },
              "items": [
                {
                  "text": "Joel 3.4-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.9"
              },
              "items": [
                {
                  "text": "Amoc 1.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.2+ZEC.9.3+ZEC.9.4"
              },
              "items": [
                {
                  "text": "Jek 9.2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ibikoko aŋee, in Korajin! Ibikoko aŋee, in Betecaida! Kono yam tic madito ma gitiyo i ii gitiyo i Turo ki Cidon, kono onoŋo jone guŋut wa con, kun giruko boŋo cola, ma gibedo i buru bene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento atitti ni, can pa Turo ki Cidon bibedo tworatwora i nino me ŋolo kop, makato can ma bipoto i komi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.22",
            "verseOrgIds": [
              "MAT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 11:23"
          },
          "items": [
            {
