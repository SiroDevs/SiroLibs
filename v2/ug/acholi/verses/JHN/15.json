                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.17"
              },
              "items": [
                {
                  "text": "15.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.23"
              },
              "items": [
                {
                  "text": "1 Jon 3.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2JN.1.5"
              },
              "items": [
                {
                  "text": "2 Jon 5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Man aye cikka, ni wumarre kekenwu macalo ceŋ amarowu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.12",
            "verseOrgIds": [
              "JHN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe tye ŋat mo ma tye ki mar madit makato man, ni dano miyo kwone pi lureme. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.13",
            "verseOrgIds": [
              "JHN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun lurema ka wutiyo gin ducu ma acikowu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.14",
            "verseOrgIds": [
              "JHN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe dok alwoŋowu lutic, pien latic pe ŋeyo gin ma laditte tiyo; ento alwoŋowu lurema, pien gin ducu ma yam awinyo ki bot Wora doŋ atyeko nyuttiwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.15",
            "verseOrgIds": [
              "JHN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe wun aye wuyera, ento an aye ayerowu, dok aketowu wek wuciti, wunyak nyigwu, dok wek nyigwu ori; wek gin ducu ma wubilego ki bot Won i nyiŋa, en omiwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.16",
            "verseOrgIds": [
              "JHN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ma acikowu en ene ni, wumarre kekenwu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.17",
            "verseOrgIds": [
              "JHN.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.17",
            "verseOrgIds": [
              "JHN.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka lobo okwerowu, wuŋe ni yam okwoŋo kwera ma kun peya okwerowu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.18",
            "verseOrgIds": [
              "JHN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kono wun jo me lobo, kono lobo omaro wun jone; ento wun pe me lobo, ento ayerowu ki i lobo; pi meno lobo kwerowu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.19",
            "verseOrgIds": [
              "JHN.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.24"
              },
              "items": [
                {
                  "text": "Mat 10.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.40"
              },
              "items": [
                {
                  "text": "Luka 6.40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.16"
              },
              "items": [
                {
                  "text": "Jon 13.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wupo i lok ma yam atito botwu ni, ‘Latic pe bedo dit makato laditte.’ Ka yam giliba, wun bene gibilibowu; ka yam gimako lokka, gibimako mewu bene. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.20",
            "verseOrgIds": [
              "JHN.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin magi ducu gibitimo i komwu pi nyiŋa, pien pe giŋeyo ŋat ma yam oora. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.21",
            "verseOrgIds": [
              "JHN.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kono pe nene abino, aloko botgi, kono pe gitye ki bal; ento koni doŋ pe gitye ki lok ma gibipido pi balgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.22",
            "verseOrgIds": [
              "JHN.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat ma kwera, okwero Wora bene. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.23",
            "verseOrgIds": [
              "JHN.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kono yam pe atiyo i kingi tic ma dano mo mukene pe otiyo, kono pe gitye ki bal, ento koni doŋ guneno dok gukwero an ki Wora. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.24",
            "verseOrgIds": [
              "JHN.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.35.19"
              },
              "items": [
                {
                  "text": "Jab 35.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.4"
              },
              "items": [
                {
                  "text": "69.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ento man otimme wek lok ma gicoyo i cik megi ocobbe kakare, ni, ‘Gikwera nono.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.25",
            "verseOrgIds": [
              "JHN.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka Lacuŋudwar bibino, ma abioro botwu nia ki bot Won, ma en aye Cwiny me ada ma a ki bot Won, en bibedo cadenna. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.26",
            "verseOrgIds": [
              "JHN.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun bene wucaden, pien wubedo bota nia i acakki.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.27",
            "verseOrgIds": [
              "JHN.15.27"
            ]
          }
        }
      ]
    }
  ],
