          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.16",
            "verseOrgIds": [
              "ZEC.14.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.39+LEV.23.40+LEV.23.41+LEV.23.42+LEV.23.43"
              },
              "items": [
                {
                  "text": "Levi 23.39-43",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat acel acel ma obwot ki i kom rok ducu ma gubino ka lweny i kom Jerucalem, bibedo ka wot i Jerucalem mwaka ki mwaka ka woro Kabaka, ma en Rwot me mony, ki pi kwero nino madito me bolo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.16",
            "verseOrgIds": [
              "ZEC.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce jo me kaka mo me wi lobo pe bicito i Jerucalem ka woro Kabaka, Rwot me mony, kot pe bicwe botgi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.17",
            "verseOrgIds": [
              "ZEC.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce jo me doggola me Ejipt pe ocito, ma pe onen kunnu, gemo ma yam Rwot ouno ki rok ma pe gucito ka kwero nino madito me bolo-ni bipoto i komgi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.18",
            "verseOrgIds": [
              "ZEC.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aye kit ma gibiculo ki bal me Ejipt, ki kit ma gibiculo ki bal pa rok ducu ma pe gucito ka kwero nino madito me bolo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        }
      ]
    },
