              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nino meno gibigoro coc i kom olaŋ pa aguragura ni, “Maleŋ pi Rwot.” Agulu ma tye i ot pa Rwot bibedo macalo becen ma tye i nyim keno tyer, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.20",
            "verseOrgIds": [
              "ZEC.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agulu ducu ma tye i Jerucalem ki Juda gibikwerogi bedo maleŋ pi Rwot me mony, wek jo ducu ma gityero gitum bot Lubaŋa gubin gukwany ki i kingi, guted ki riŋo lee ma gityero bot Lubaŋa, Lacat-wil mo pe dok binen i ot pa Rwot me mony i nino meno.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.21",
            "verseOrgIds": [
              "ZEC.14.21"
            ]
          }
        }
      ]
    }
  ],
