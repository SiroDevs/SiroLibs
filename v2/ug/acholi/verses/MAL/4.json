        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wupo pi cik pa laticca Moses, cik ki gin ma yam acike kwede i Koreb pi jo Icrael ducu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.4.4"
            ]
          }
        }
