                }
              ]
            }
          ]
        },
        {
          "text": "“Nen, abicwalo lanebi Elia botwu” ma peya nino pa Rwot oo, nino madit ki ma kelo lworo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
