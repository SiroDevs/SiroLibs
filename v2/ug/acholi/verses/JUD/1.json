              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bot jo ma Lubaŋa olwoŋogi ma gibedo i mar pa Lubaŋa Won, ma Yecu Kricito tye ka gwokogi.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        }
      ]
