          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
