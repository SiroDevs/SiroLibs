              "attrs": {
                "loc": "JOS.5.12"
              },
              "items": [
                {
                  "text": "Yoc 5.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jo Icrael gucamo manna gutyeko kwede mwaka pyeraŋwen kulu, nio ka guo i lobo ma giromo bedo iye; gucamo manna nio ka guo i waŋ lobo Kanaan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwata moko kwon ma yam gipimo kwede i kar onoŋo romo acel me abic me debe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.36",
            "verseOrgIds": [
              "EXO.16.36"
            ]
