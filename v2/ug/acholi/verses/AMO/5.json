          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe kumeno, ento koni doŋ wutibino Cakkut ma kabakawu, ki Kaiwan, lubaŋawu ma lakalatwe, ki cal jogiwu ducu ma wupayo piwu kenwu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.26",
            "verseOrgIds": [
              "AMO.5.26"
            ]
          }
        },
        {
          "name": "verse",
