        },
        {
          "text": "“Yam wubedo ka kela bota gitum ki gityer i tim pi mwaka pyeraŋwen, wun jo me ot pa Icrael? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.25",
