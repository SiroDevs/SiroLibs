        },
        {
          "text": "Ebitebe by'abaikiriza Ruhanga ab'omu Asiya babaramukize. Akwila na Pirisika, hamu n'ekitebe ky'abaikiriza abeesorooleza omunju yabo babaramukize muno omu MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.19",
            "verseOrgIds": [
              "1CO.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda boona babaramukize. Muramukyangane nimugwangana omu kifuba nk'abantu ba Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyowe Paulo, okuramukya kunu nkwehandikiire nyenka n'omukono gwange. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.21",
            "verseOrgIds": [
              "1CO.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu haraaba haroho weena atarukugonza MUKAMA, ogu akyenwe. Ija, Ai MUKAMA! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.22",
            "verseOrgIds": [
              "1CO.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embabazi za MUKAMA waitu Yesu Kristo ziikale na inywe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.23",
            "verseOrgIds": [
              "1CO.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywena nimbagonza omu Kristo Yesu. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.24",
            "verseOrgIds": [
              "1CO.16.24"
            ]
