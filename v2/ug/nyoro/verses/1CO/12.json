            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga, omu kitebe ky'abaikiriza, akabanza kutamu abakwenda, yagarraho abarangi, yayongeraho ebeegesa, hanyuma abakozi b'ebyamahano, yataho n'abakiza endwara, n'abakoonyezi, n'abalemi, n'abarukubaza endimi ezitali zimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boona bakwenda? Boona barangi? Boona beegesa? Boona bakora ebyamahano? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.29",
            "verseOrgIds": [
              "1CO.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boona baina ebisembo by'okutamba endwara? Boona babaza endimi? Boona basoborra amakuru g'endimi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.30",
            "verseOrgIds": [
              "1CO.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu mute emitima yanyu ha kuserra ebisembo ebirukukira oburungi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
            "verseOrgIds": [
              "1CO.12.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
