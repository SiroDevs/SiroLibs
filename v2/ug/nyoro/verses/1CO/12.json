          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanyowe ninyija kubooleka omuhanda ogurukukirra kimu endi yoona.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
            "verseOrgIds": [
              "1CO.12.31"
            ]
          }
        }
