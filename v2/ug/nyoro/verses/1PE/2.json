                "loc": "ISA.28.16"
              },
              "items": [
                {
                  "text": "Is 28:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebihandiiko Ebirukwera nibigamba biti:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
