              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebindi Rehobbowamu ebi yakozire, bikahandiikwa omu kitabu eky'obusinge obw'abakama aba Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasumi ako koona, Rehobbowamu na Yerobbowamu, baikaraga nibarwanisangana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobbowamu akafa nka baisenkuru oku baafiire yaziikwa omu rubuga rwa Daudi. Ibara lya nyina nuwe akaba ali Naama, Omwamooni mutabani we Abiyamu, yateera engoma omu kiikaro kye.",
          "type": "text",
