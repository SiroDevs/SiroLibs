              "1KI.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki noobu kyabaireho, omukama Yerobbowamu, atacwe ngeso ze embi, baitu akongera okukoma banyakatagara ab'okukora omu biikaro eby'okuramizaamu; boona abaagonzaaga akabakoma yabeeza babe banyakatagara ab'ebiikaro ebi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.33",
            "verseOrgIds": [
              "1KI.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekintu eki ha nju ya Yerobbowamu kikaba kibi muno, nikyo kyagirugiiremu kuhwerekerra ekahwa omunsi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.34",
            "verseOrgIds": [
              "1KI.13.34"
            ]
          }
        }
