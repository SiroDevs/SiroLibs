                "loc": "1SA.22.20+1SA.22.21+1SA.22.22+1SA.22.23"
              },
              "items": [
                {
                  "text": "1 Sam 22:20-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama yagambira Abyasara nyakatagara ati: “Ogende Anasosi omu itaka lyawe; habwokuba osemeriire kufa. Baitu tindukwija kukwita omu kasumi kanu habwokuba obu okaba okyali na isenyowe Daudi, okeetweka Esanduuko ey'Endagaano ya MUKAMA, kandi okabonabona nkooku yabonaboine.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.26",
            "verseOrgIds": [
              "1KI.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.27+1SA.2.28+1SA.2.29+1SA.2.30+1SA.2.31+1SA.2.32+1SA.2.33+1SA.2.34+1SA.2.35+1SA.2.36"
              },
              "items": [
                {
                  "text": "1 Sam 2:27-36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Solomooni yabinga Abyasara aleke kwongera kuba nyakatagara wa MUKAMA, nukwo yahikiriza ati MUKAMA eki yagambire hali Eli nyakatagara omu kiikaro Siiro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabbu obu yahuliire amakuru ago habwokuba akaba asagikire Adoniya, baitu atasagike Abusalomu, yakwata ogurukutwara ha heema ya MUKAMA, yakwata amahembe g'itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.28",
            "verseOrgIds": [
              "1KI.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Solomooni obu yahuliire Yowabbu nkooku airukire yagenda ha heema ya MUKAMA, kandi nkooku ali haihi n'itambiro, yatuma Benaaya mutabani wa Yehoyaada, yamugambira ati: “Genda omwite.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.29",
            "verseOrgIds": [
              "1KI.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaaya yahika ha heema ya MUKAMA, yagambira Yowabbu ati: “Omukama aragiire ngu: Turuka.” Yowabbu yagarukamu ati: “Nangwa, kangwe hanu.” Nubwo Benaaya yagarukireyo yagambira omukama ati: “Ebi nibyo Yowabbu arukugamba, nukwo angarukiremu ati:” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama yagarukamu Benaaya ati: “Kora nkooku agambire genda omwite omuziike; nukwo onyiheho oti, kandi nukwo oiheho oti enju ya isenyowe omusango ogw'okuseesa esagama, Yowabbu ei yaseesire hataroho bulyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.31",
            "verseOrgIds": [
              "1KI.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA alifubira Yowabbu habw'abantu abo aba yaisire, habwokuba akaseesira kandi yaisa ekitara abantu babiri abarukumukira obuhikiriire n'oburungi, nubo: Abbuneeri mutabani wa Neri, engabwa y'ihe erya Isirairi, n'Amasa mutabani wa Yeseri, engabwa y'ihe ery'oruganda rwa Yuda, atamanyisize isenyowe Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.32",
            "verseOrgIds": [
              "1KI.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esagama yabo eraikaraga neerurumira Yowabbu n'abaijukuru be obusinge bwona; baitu Daudi, abaijukuru be, n'enju ye, MUKAMA araabahaga obusinge ebiro byona.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.33",
            "verseOrgIds": [
              "1KI.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Benaaya mutabani wa Yehoyaada, yagenda yamwita, baamuziika omunju ye omwirungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.34",
            "verseOrgIds": [
              "1KI.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama, Benaaya mutabani wa Yehoyaada, nuwe yafoora ngabwa y'ihe omu kiikaro kya Yowabbu, kandi Zadoki nyakatagara yamugarra omu kiikaro ky'Abyasara ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "nubwo omukama yatumire bamwetere Simeyi, obu yaizire, yamugambira ati: “Ogende oyeyombekere enju Yerusaalemu, nuho oikale, otaliruga oku okagenda omu kiikaro ekindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.36",
            "verseOrgIds": [
              "1KI.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba ha kiro eki oliturukiraho okambuka akasaaru Kidironi, omanyire kimu nkooku olifa; ogu guliba musango gwawe?” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.37",
            "verseOrgIds": [
              "1KI.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simeyi yakaguza omukama ati: “Eki ogambire ninkisiima; iwe MUKAMA nkooku ogambire, na nyowe omwiru wawe nukwo ndaakora.” Simeyi nukwo kwikara Yerusaalemu omwanya mukooto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu obu haahoireho emyaka esatu, ababiri ha bairu ba Simeyi bakairuka baagenda omba Akisi mutabani wa Maaka, omukama wa Gaasi obu baagambiire Simeyi ngu: “Abairu bawe bali Gaasi”, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.39",
            "verseOrgIds": [
              "1KI.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaimuka yatandiika endogoyi, yagenda Gaasi omba Akisi kuserra abairu be; yabaihayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.40",
            "verseOrgIds": [
              "1KI.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu baagambiire Solomooni Simeyi nkooku yarugire Yerusaalemu yagenda Gaasi kandi ngu agarukire, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.41",
            "verseOrgIds": [
              "1KI.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "yayeta Simeyi yamukaguza ati: “Ntakurahize nakukomeeetereza nti: omanyire kimu ha kiro eki oliturukiraho okagenda omu kiikaro ekindi olifa? Wangarukamu oti: ‘Eki ogambire kirungi ndikora nkooku ogambire.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.42",
            "verseOrgIds": [
              "1KI.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati kiki ekyakuliisize endahiro ei warahiire MUKAMA, tiwahikiriza kiragiro eki nakuteereriire?” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.43",
            "verseOrgIds": [
              "1KI.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama yayongera yakaguza Simeyi ati: “Omanyire kurungi ebibi byona ebi wakozire isenyowe Daudi; habweki, MUKAMA naija kubikusasura. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Solomooni alihebwa omugisa, kandi MUKAMA aligumya obukama bwa Daudi obusinge bwona.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.45",
            "verseOrgIds": [
              "1KI.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo omukama yaragiire Benaaya mutabani wa Yehoyaada; yagenda yaita Simeyi, obukama nukwo kufookera kimu bwa Solomooni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.46",
            "verseOrgIds": [
              "1KI.2.46"
            ]
          }
        }
      ]
    }
