{
  "id": "1KI.1",
  "number": "1",
  "bookId": "1KI",
  "reference": "1 Bakam 1",
  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
