            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA obu yabandize kubaliza Isirairi naaraba omuli Hoseya, akamugambira ati: “Genda oswere omukazi ensiihani, omuzaaleho abaana ab'obusiihani, habwokuba ensi habw'okweha obusiihani, nikyo efurukiire MUKAMA.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoseya nukwo kugenda, yaswera omukazi muhara wa Diburaimu, ibara lye Gomere, omukazi yatwara enda, yazarra Hoseya omwana w'obwojo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        }
      ]
    },
    {
