            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.26"
              },
              "items": [
                {
                  "text": "Bar 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki noobu kiraba kiri kiti, omuhendo ogw'abantu ba Isirairi gulisisana nk'omusenyi ogw'enyanja, nugwo gutasobora kulengwa rundi kubarwa; hati Ruhanga naabagamba ati: “Timuli bantu bange,” baitu ekiro kirihika eki alibagambiraho ati: “Muli baana ba Ruhanga omwomeezi!” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ba Yuda n'aba Isirairi, baligaruka bateerane beekomere omwebembezi omu, bagaruke bakule bagwagwane baikale omunsi yabo. Mazima kwo, ekiro kya Yezereeri, kiriba kiro kikuru mali!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
