            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ogu obu yamazire kuheebwayo, entegeka ya Ruhanga nkooku ekaba eri kara koona ebintu binu bitakabaireho, mukamubamba ha musaraba, mwamwisa emikono y'abantu abatalemwa Biragiro byaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.23",
            "verseOrgIds": [
              "ACT.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
