                "loc": "PSA.16.8+PSA.16.9+PSA.16.10+PSA.16.11"
              },
              "items": [
                {
                  "text": "Zab 16:8-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Daudi akamugambaho ati:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
          }
        }
      ]
