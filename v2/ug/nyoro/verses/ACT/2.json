                  "text": "Luk 24:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu Ruhanga akamuhumbuura, yamwiha omu busaalizi bw'orufu, habwokuba kikaba kitarukusoboka uwe kwikara omumaino garwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.24",
            "verseOrgIds": [
              "ACT.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
