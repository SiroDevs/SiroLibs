              "items": [
                {
                  "text": "Ebik 7:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ruhanga ayahangire ensi na byona ebirumu nkooku ali MUKAMA w'iguru n'ensi, taikara mu maramizo agombekerwe abantu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.24",
            "verseOrgIds": [
              "ACT.17.24"
            ]
          }
        },
        {
