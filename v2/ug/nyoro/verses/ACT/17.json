                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi takonyerwa bantu nk'anyakwina eki abuzirwe, habwokuba nuwe wenka aha boona obwomeezi, n'okwikya orwoya, na buli kintu kyona. ",
          "type": "text",
