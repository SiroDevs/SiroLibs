          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "okurugirra Yohaana obu akaba naabatiza, okuhika ha kiro Yesu eki yatwihiirweho yatwarwa omu iguru. Leka omuntu ogu afooke kaiso hamu na itwe, agumye eby'okuhumbuuka kwa Yesu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.22",
            "verseOrgIds": [
              "ACT.1.22"
            ]
          }
        }
