                "loc": "LUK.1.1+LUK.1.2+LUK.1.3+LUK.1.4"
              },
              "items": [
                {
                  "text": "Luk 1:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kitabu eky'okubanza eki nakuhandiikiire, Teofilo, nkahandiikamu byona Yesu ebi yakozire n'ebi yayegeseze okuruga ha kubanza ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.1",
            "verseOrgIds": [
              "ACT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuhika ha kiro eki yatwaliirweho omwiguru, amazire kuraganiza abakwenda aba yayekomiire kubatwekera Mwoyo Ahikiriire. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.2",
            "verseOrgIds": [
              "ACT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu yamazire kufa ha musaraba, akabeeyoleka ayomiire, naakigumya n'ebirukuhuniriza bingi. Kandi akamara ebiro makumi ana naababonekera, naabagambira eby'Obukama bwa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.3",
            "verseOrgIds": [
              "ACT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.49"
              },
              "items": [
                {
                  "text": "Luk 24:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu akaba akyali nabo ha meeza, akabaragira kutaruga Yerusaalemu, baitu baikaleyo bategeriize Ise eki yaraganiize. Eki nikyo mwahuliire nimbazaaho nti: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.4",
            "verseOrgIds": [
              "ACT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.11"
              },
              "items": [
                {
                  "text": "Mat 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.8"
              },
              "items": [
                {
                  "text": "Mar 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.16"
              },
              "items": [
                {
                  "text": "Luk 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.33"
              },
              "items": [
                {
                  "text": "Yoh 1:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yohaana akabatiza n'amaizi; baitu inywe, omu biro ebitali bingi, nimwija kubatizibwa Mwoyo Ahikiriire.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.5",
            "verseOrgIds": [
              "ACT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naatwarwa omwiguru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.5",
            "verseOrgIds": [
              "ACT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakwenda obu bakaba beesoroize hamu, bakakaguza Yesu bati: “Mukama, kanu nuko kasumi oraagarurramu Isirairi obukama?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.6",
            "verseOrgIds": [
              "ACT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe yabagarukamu ati: “Tikiri kyanyu kumanya akasumi rundi ebiro Isenyowe ebi yataireho habw'obusobozi bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.7",
            "verseOrgIds": [
              "ACT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.19"
              },
              "items": [
                {
                  "text": "Mat 28:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.15"
              },
              "items": [
                {
                  "text": "Mar 16:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.47"
              },
              "items": [
                {
                  "text": "Luk 24:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.48"
              },
              "items": [
                {
                  "text": "48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu muliheebwa amaani, Mwoyo Ahikiriire obu alibaijaho; kandi muliba bakaiso bange omu Yerusaalemu, n'omu Buyudaaya yoona, n'omu Samaliya, n'okuhika ha mpero y'ensi.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.8",
            "verseOrgIds": [
              "ACT.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
