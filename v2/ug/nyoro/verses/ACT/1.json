              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo baaleeta amabara abiri: Yosefu arukwetwa Barasaba, abamu ou baayetaga Yusito, hamu n'ondi arukwetwa Matiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
            "verseOrgIds": [
              "ACT.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo boona kusaba nibagamba bati: “Ai MUKAMA, iwe arukumanya emitima y'abantu boona, hali banu bombi otwoleke ou okomere, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
            "verseOrgIds": [
              "ACT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutwara obuheereza bunu n'obukwenda Yuda obu yanagire yayegendera.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
              "ACT.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baabaterra itomo, lyakwata Matiya; yabalirwa omu bakwenda ikumi n'omu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.26",
            "verseOrgIds": [
