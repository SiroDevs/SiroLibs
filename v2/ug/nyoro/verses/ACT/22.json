              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyenkya obu bwakiire, habw'okwenda kumanya Abayudaaya ebi barukumujunaana, omukuru w'amahe yabohorra Paulo kandi yaragira abanyakatagara abakuru n'orukurato rwona kwesorooza. Yaleeta Paulo yamwemereza omumaiso gaabo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.30",
            "verseOrgIds": [
              "ACT.22.30"
            ]
          }
