{
  "id": "ACT.22",
  "number": "22",
  "bookId": "ACT",
  "reference": "Ebik 22",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
