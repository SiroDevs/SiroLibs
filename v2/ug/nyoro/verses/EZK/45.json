              "attrs": {
                "loc": "NUM.28.16+NUM.28.17+NUM.28.18+NUM.28.19+NUM.28.20+NUM.28.21+NUM.28.22+NUM.28.23+NUM.28.24+NUM.28.25"
              },
              "items": [
                {
                  "text": "Kubar 28:16-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ha kiro ekya ikumi na bbina eby'okwezi okw'okubanza, musemezeege, ekiro kikuru eky'okwijuka Okuhingurwaho mumale ebiro musanju, nimulya emigaati etatumbisiibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.21",
            "verseOrgIds": [
              "EZK.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki, omulemi aleete enimi ento, ey'ekihongwa eky'okuganyiza ebibi, habwe na habw'abantu ab'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.22",
            "verseOrgIds": [
              "EZK.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kiro, ha biro musanju ebi eby'obugenyi, aleetere MUKAMA enimi ento musanju, n'empaya z'entaama musanju ezitaina kamogo, zibe kihongwa eky'okwokya, buli, kiro ha biro ebi omusanju; n'empaya y'embuzi emburabuzi, ey'ekihongwa eky'okuganyiza ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.23",
            "verseOrgIds": [
              "EZK.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aleete habw'ekihongwa eky'ebyokulya lita ikumi na musanju n'ekicweka habwa buli nimi lita ikumi na musanju n'ekicweka habwa buli mpaya y'entaama, na lita isatu z'amagita. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.24",
            "verseOrgIds": [
              "EZK.45.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
