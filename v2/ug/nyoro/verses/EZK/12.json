            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akangambira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.1",
            "verseOrgIds": [
              "EZK.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
