                "loc": "ISA.6.9"
              },
              "items": [
                {
                  "text": "Is 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.21"
              },
              "items": [
                {
                  "text": "Yer 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.18"
              },
              "items": [
                {
                  "text": "Mar 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iwe omwana w'omuntu, oikara n'abantu abaayemere, abanyakwina amaiso ag'okurora, baitu tibarukurora, abanyakwina amatu ag'okuhurra, baitu tibarukuhurra; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.2",
            "verseOrgIds": [
              "EZK.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwokuba bantu beereme. Habweki nu, iwe omwana w'omuntu oyeteekanirize ebintu byona omuntu enzaahisibwa ebi atwara, ogende ozaahe nyamusana abantu nibarora; oruge omu kiikaro kyawe ogende omu kiikaro ekindi nk'enzaahisibwa, ogende abantu nibarora, noobu baraaba bali bantu beereme, rundi balikenga. Ebintu byawe, nk'ebintu eby'omuntu enzaahisibwa, obiturukye nyamusana abantu nibarora, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.3",
            "verseOrgIds": [
              "EZK.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi oturuke wenka omu kairirizi, nk'abantu abarukugenda kuzaaha oku bakora. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.4",
            "verseOrgIds": [
              "EZK.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odubule ekisiika bakuroleriire, orabe omu kihuru eki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.5",
            "verseOrgIds": [
              "EZK.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohimbe ebintu byawe obyete ha ibega nibarora, obiturukye aheeru omu mwirima; oyeswekerre ha maiso nukwo oleke kurora ensi; habwokuba, nkufoire karorwaho k'enju ya Isirairi.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.6",
            "verseOrgIds": [
              "EZK.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.6",
            "verseOrgIds": [
              "EZK.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkakora MUKAMA eki yandagiire, naturukya ebintu byange omu bwire bwa nyamusana, nk'ebintu eby'omuntu arukuzaaha kandi omu kairirizi, nadubura ekisiika n'emikono yange; naturuka ekiro, natwara ebintu byange, abantu nibarora.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.7",
            "verseOrgIds": [
              "EZK.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.7",
            "verseOrgIds": [
              "EZK.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyenkya obu bwakiire MUKAMA akankaguza ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.8",
            "verseOrgIds": [
              "EZK.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iwe omwana w'omuntu, enju ya Isirairi, abantu abo abeemi, batakukaguze eki okaba nookora? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.9",
            "verseOrgIds": [
              "EZK.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obagambire oti: ‘MUKAMA naagamba ati: Ebigambo binu, nibikwata hali Yerusaalemu, na hanju ya Isirairi yoona enyakuli omurubuga oru.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.10",
            "verseOrgIds": [
              "EZK.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obagambire oti: ‘Eki nkozire, nikimanyisa ekiribahikaho, nkooku nkozire, nainywe nukwo mulikora; mulizaaha kandi mulinyagwa.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.11",
            "verseOrgIds": [
              "EZK.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubiito arukubalema, alihimba ebintu bye abyete ha ibega ekiro, aturuke; alidubura ekisiika nikyo arabemu; alyeswekerra amaiso, nukwo aleke kurora ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.12",
            "verseOrgIds": [
              "EZK.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.7"
              },
              "items": [
                {
                  "text": "2 Bakam 25:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.11"
              },
              "items": [
                {
                  "text": "Yer 52:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimutega omuguha omutego gwange ogu gulimukwata, ndimuleeta Bbabbulooni omunsi ey'Abakalidaaya, nayo taligirora; kandi niyo aligwamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.13",
            "verseOrgIds": [
              "EZK.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boona abamuheriire, ndibararangya buli hantu, abakoonyezi be, n'amahe ge; ndibaronza nkwasire empirima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.14",
            "verseOrgIds": [
              "EZK.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu ndibataabaaniza omu mahanga nkabararangya omunsi enyingi, nubwo balimanya nkooku ndi MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.15",
            "verseOrgIds": [
              "EZK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu abamu hali bo, ndibatabura okwitwa empirima, enjara na kiihe, nukwo beegarukemu ebikorwa byabo byona ebibi omu mahanga nembere bagenda kandi bamanye ngu ninyowe MUKAMA.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA kandi akangambira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.17",
            "verseOrgIds": [
              "EZK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe omwana w'omuntu, lya ebyokulya byawe nootukumira, nywa amaizi gawe nookankana, kandi nootiina muno; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.18",
            "verseOrgIds": [
              "EZK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ogambire abantu ab'ensi enu oti: “Binu MUKAMA nibyo arukugambaho abasi ba Yerusaalemu, abanyakuli omunsi ya Isirairi: balirya ebyokulya byabo nibatiina muno, balinywa amaizi bamazirweho enkizi, habwokuba, ensi yabo eriihwaho ebintu byayo byona ebigirumu, habw'ebibi ebinyakukorwa abo boona abanyakugiikaramu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.19",
            "verseOrgIds": [
              "EZK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi embuga ezinyakurumu abantu, zirihwerekerezibwa, kandi ensi erifooka kifuruka; nubwo mulimanya nkooku ndi MUKAMA.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA akangambira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.21",
            "verseOrgIds": [
              "EZK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iwe omwana w'omuntu rufumo ki runu, oru ohurra nirucwibwa omunsi yoona eya Isirairi, orunyakugamba ngu: ‘Ebiro bihingura, ebyarozirwe bihwaho’? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.22",
            "verseOrgIds": [
              "EZK.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, ogambire abantu oti: ‘MUKAMA naagamba ati: orufumo runu, ninyija kurudibya tibaligaruka kurucwa omu Isirairi.’ Baitu obagambire oti: Akasumi kahikire, kandi ebyarangirwe nibiija kuhikirra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.23",
            "verseOrgIds": [
              "EZK.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba okuruga hati omunju ya Isirairi tihaligaruka kuzookamu eby'ebisuba n'okurangamu eby'obugobya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
              "EZK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu nyowe MUKAMA, ninyowe ndaabazaaga ekigambo, eki ndukwenda kubaza, kandi eki mbalize kiraakorwaga. Tikirigaruka kukeererezibwa, MUKAMA Ruhanga naagamba ati: Omubiro byanyu, inywe ab'enju enyereme, ndigamba ekigambo kandi nkikole.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
