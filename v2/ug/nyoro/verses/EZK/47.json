                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.38"
              },
              "items": [
                {
                  "text": "Yoh 7:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Kus 22:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma yangarra ha mulyango ogw'Enju ya Ruhanga, narora amaizi nigaruga hansi y'ekiti ky'omulyango, ha bukiizi obwa Burugaizooba, habwokuba Enju ya Ruhanga nuho ekaba eroleriire; amaizi nigagera nigasirimuka, nigaruga hansi y'obukiizi obw'obulyo, na hansi y'ekiti ky'omulyango ogw'Enju ya Ruhanga, habukiizi bw'obulyo obw'itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.1",
            "verseOrgIds": [
              "EZK.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, yandabya irembo erya ha bukiizi obw'emoso, yanturukya ha irembo ery'aheeru, erinyakuroleriire Burugaizooba, oku nuho hakaba hali amaizi agakaba nigagera ha bukiizi bw'obulyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaija yagenda ha rubaju orwa Burugaizooba akwasire omuguha gwe ogw'okulengesa, yalenga mita bitaano, yaanyambura amaizi ago, gakampika omu bujwarro bw'enkwanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yagaruka yalenga mita bitaano ezindi n'ago yaganyambura; ago gampika omu maju. Yayongera yalenga mita bitaano, n'ago yaganyambura; gangarukira omunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.4",
            "verseOrgIds": [
              "EZK.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayongera yalenga mita bitaano ezindi, lero ago, kikaba kisaaru eki nkaba ntarukusobora kwambuka, amaizi gakaba geeyongiire, maingi muno, omuntu agaakaba atarukusobora kwambuka, rundi buli naaziha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho yankaguza ati: “Wewe mwana w'omuntu, eki okiboine?” Hanyuma yandabya ha musa gw'ekisaaru, yangarrayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu nkaba ningarukayo, ha musa gw'ekisaaru eki, nabonaho emiti nyingi, eri ha mbaju zombi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.7",
            "verseOrgIds": [
              "EZK.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangambira ati, “amaizi ganu nigagera nigatoma omunsi ya Burugaizooba, kandi nigataaha Arabba: kandi obu garaataaha omu maizi g'enyanja gali agateekere, nigaija kugasemeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoonahoona ekisaaru kinu nambere kiraagenda, buli kihangwa kyona ekyomeezi ekinyakwetengeesa, kiryomeera, amaizi ganu habw'okugendayo nukwo gasemeze ag'enyanja encu zirikanya muno; habweki, hoona ekisaaru kinu nambere kirigenda, buli kintu kiryomeera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.9",
            "verseOrgIds": [
              "EZK.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasohi b'encu baraayemerraga ha rubaju rw'enyanja, okuruga Eni-geedi okuhika Enegilaimu, kiraabaga kiikaro eky'okwanjurramu obutimba; encu zakyo, ziriba z'emiringo nyingi muno, zirisisana nk'encu ez'enyanja enkooto. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.10",
            "verseOrgIds": [
              "EZK.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu amaizi ag'ebisaaru n'ag'ebiijongo, tigaliba marungi; ago galirekwayo, gaihwemuga ekisura. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.11",
            "verseOrgIds": [
              "EZK.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Kus 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ha misa y'ekisaaru eki orubaju n'orubaju, halimerayo emiti ey'emiringo yoona enyakwana ebijuma ebiribwa. Amababi gaayo tigalihotoka, kandi terihoisa, baitu buli kwezi, eraayanaga ebijuma ebirungi, habwokuba amaizi agagiitirra, garuga omukiikaro ekirukwera. Ebijuma byayo, biraabaga byokulya, amababi gaayo mubazi gw'okutamba.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okubagana ensi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA Ruhanga naagamba ati: Enu niyo mitaano eyi mulikuraatira okubaganiriza enganda ikumi na ibiri eza Isirairi, ensi ey'obugwetwa bwabo. Yosefu atunge ebicweka bibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.13",
            "verseOrgIds": [
              "EZK.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugigabe omu bwinganiza; habwokuba ensi enu eyi murukutuunga ebe bugwetwa bwanyu, nkaginihiza baisenkuru inywe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.14",
            "verseOrgIds": [
              "EZK.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.14",
            "verseOrgIds": [
              "EZK.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gunu nugwo omutaano gwayo: Ha rubaju orw'emoso, nigutandikira ha Nyanja Enkooto, gugenda n'omuhanda ogwa Heselooni okuhika ha ntaaho ya Hamasi, gweyongereyo okugarukira Zedadi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.15",
            "verseOrgIds": [
              "EZK.47.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Berosa, Sibburaimu (enyakuli ha mutaano, hagati ya Damasiko na Hamasi) okuhika Hazeri-hatikooni, enyakuli ha mutaano gwa Hahuraani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.16",
            "verseOrgIds": [
              "EZK.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, omutaano guruge ha nyanja, gugarukire Hazalenooni, enyakuli ha mutaano ogwa ha bukiizi bw'emoso obwa Damasiko, n'ogwa Hamasi. Oru nurwo orubaju orw'emoso.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ha rubaju orwa Burugaizooba, guruge Hazalenooni hagati ya Hahuraani na Damasiko; nigugenda n'ekisaaru Yorudaani, hagati ya Giryadi n'ensi ya Isirairi; okuhika ha nyanja eya Burugaizooba n'okweyongerayo Tamari. Oru nurwo orubaju orw'emoso. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi harubaju rw'obukiizi bw'obulyo kuruga Tama kuhika ha maizi ga Kadesi-meribba. Ha bukiizi bw'obulyo kutaana n'obusaaru bwa Misiri kuhika ha Nyanja Enkoto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ha rubaju orwa Bugwaizooba, Enyanja Enkooto nugwo gube mutaano, okugarukira omumaiso g'entaaho ya Hamasi honyini. Oru nurwo orubaju orwa Burugaizooba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.20",
            "verseOrgIds": [
              "EZK.47.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.20",
            "verseOrgIds": [
              "EZK.47.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 47:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ensi enu, nukwo mugyegabire muti, nimurorra ha nganda za Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.21",
            "verseOrgIds": [
              "EZK.47.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 47:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugyegabire, bube bugwetwa bwanyu, kandi bw'abanyamahanga abaikaire nainywe ababazaaliremu, abaana. Hali inywe basisane nk'abaana abaazairwe Isirairi. Nabo, bahebwe obugwetwa hamu nainywe, omu nganda za Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.22",
            "verseOrgIds": [
              "EZK.47.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 47:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA Ruhanga naagamba ati: Omuruganda rwona omunyaihanga oru araabamuga, oku nuho mumuheereze obugwetwa bwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.23",
            "verseOrgIds": [
              "EZK.47.23"
            ]
          }
