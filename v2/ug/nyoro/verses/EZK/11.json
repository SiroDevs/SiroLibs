          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.2+EZK.43.3+EZK.43.4+EZK.43.5"
              },
              "items": [
                {
                  "text": "Ezek 43:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo bakerubbi baahurrukire, hamu n'enyamuziga ezikaba zibali ha rubaju; ekitiinisa kya Ruhanga owa Isirairi kyabahikaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitiinisa kya MUKAMA kyaruga hagati y'orubuga kyayemerra ha rusozi orunyakuli ha bukiizi obw'emoso obw'orubuga: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.23",
            "verseOrgIds": [
              "EZK.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo wa Ruhanga yanyeyoleka nkooku ampimbire, yantwaara Kalidaaya, hali enzaahisibwa. Nubwo ebi nkaba nindora byambuzireho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.24",
            "verseOrgIds": [
              "EZK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabagambira byona MUKAMA ebi yanyolekere.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.25",
            "verseOrgIds": [
              "EZK.11.25"
            ]
          }
        }
      ]
    }
