          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaba haroho amadirisa ag'ehinguliriize irembo eri n'ekisasi kyalyo, ebirukusisana amadirisa ag'amalembo agandi; obura bwalyo mita abiri na itano, obugazi mita ikumi na ibiri n'ekicweka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.25",
            "verseOrgIds": [
              "EZK.40.25"
            ]
          }
        },
        {
          "name": "verse",
