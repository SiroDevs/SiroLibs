          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaba haroho amatembero musanju agarukutwara hairembo eri, kandi omukumiirro gwalyo, gukaba guli harubaju orw'omunda; ha mikumirro yalyo, hakaba haroho emikindo, omukindo gumu orubaju n'orubaju. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.26",
            "verseOrgIds": [
              "EZK.40.26"
            ]
          }
        },
        {
