          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekisasi kyalyo kikaba kiroleriire ezigati ey'aheeru, emikumirro yalyo, ekaba eroho emikindo, omuhanda ogwatwarayoga, gukaba guroho amatembero munaana.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.31",
