            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma yanyiha aheeru, yantahya omu zigati ey'omunda, oku omu zigati ey'omunda, hakaba haliyo ebisiika bibiri, ekimu kiri ha rubaju orw'obukiizi obw'emoso obw'irembo, kiroleriire obukiizi obw'obulyo, ekindi ha rubaju orw'obulyo, kiroleriire obukiizi obw'emoso. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.44",
            "verseOrgIds": [
              "EZK.40.44"
            ]
          }
        },
        {
