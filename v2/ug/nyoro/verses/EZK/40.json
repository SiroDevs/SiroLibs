          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaba haroho ebisasi ebiryehinguliriize, obura bwabyo mita abiri na itano, obugazi ikumi na ibiri n'ekicweka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.30",
            "verseOrgIds": [
              "EZK.40.30"
            ]
          }
        },
        {
