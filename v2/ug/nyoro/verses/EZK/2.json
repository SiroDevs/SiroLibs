        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.7",
            "verseOrgIds": [
              "EZK.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baitu iwe omwana w'omuntu, ohurre eki ndukukugambira; otalyema nk'enju egi eyayemere; wesame olye ekindukukuha.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.8",
            "verseOrgIds": [
              "EZK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 2:9"
          },
          "items": [
