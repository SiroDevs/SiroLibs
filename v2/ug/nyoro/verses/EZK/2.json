                "loc": "REV.5.1"
              },
              "items": [
                {
                  "text": "Kus 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu namagamagire narora omukono ogugoroliirwe nambere ndi kwija kurora, dara omuzingo gw'ekitabu oguhandiikirwe guli omu mukono ogu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.9",
            "verseOrgIds": [
              "EZK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuntu ogu yakinyanjururra, kikaba kihandiikirweho omu maiso n'enyuma, kikaba kihandiikirweho ebigambo eby'okurra, eby'empamo kandi eby'enaku.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.10",
            "verseOrgIds": [
