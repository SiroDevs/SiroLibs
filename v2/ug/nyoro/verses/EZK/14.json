              "EZK.14.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.8"
              },
              "items": [
                {
                  "text": "Kus 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MUKAMA Ruhanga naagamba ati: Lero, kiriba kita, obu ndikorra Yerusaalemu ebintu bbina ebirukusaaliza eby'okugicwera omusango. Empirima, enjara, enyamaiswa ez'omu kisaka, na kagingo, biite abantu n'ebisoro bibimaleho! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.21",
            "verseOrgIds": [
              "EZK.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba omunsi egi habaho abasigaireho ab'okwihamu batabani baabu na bahara baabu obu balikuhikaho, mukarora engeso zaabo n'ebikorwa byabo mulinanuka, ekifubiro eki nahaire Yerusaalemu nkooku kyagisemeriire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.22",
            "verseOrgIds": [
              "EZK.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwolirora engeso zaabo n'ebikorwa byabo, mulimanya, byona ebi nagikozire, nkooku nabikozire nyina obulyo.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.23",
            "verseOrgIds": [
              "EZK.14.23"
            ]
          }
        }
      ]
    }
