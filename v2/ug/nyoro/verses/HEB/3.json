      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki ab'oruganda abarukwera, inywe abaayesirwe kubagana obwomeezi obw'omwiguru, mute ebiteekerezo byanyu hali Yesu omukwenda wa Ruhanga kandi nyakatagara omukuru ow'enyikiriza yaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.1",
            "verseOrgIds": [
              "HEB.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.7"
              },
              "items": [
                {
                  "text": "Kubar 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaba ali mwesigwa hali Ogu ayamutaireho, nka Musa nawe oku yabaire mwesigwa omunju ya Ruhanga yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.2",
            "verseOrgIds": [
              "HEB.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu Yesu akaba asemeriire kuheebwa ekitiinisa kingi okukira Musa, omwombeki w'enju nkooku aheebwa akitiinisa okukira enju enyakwombekwa. [ ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.3",
            "verseOrgIds": [
              "HEB.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba buli nju yoona egira anyakugyombeka, baitu omwombeki w'ebintu byona nuwe Ruhanga.] ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.4",
            "verseOrgIds": [
              "HEB.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akaba ali mwesigwa omu nju ya Ruhanga nk'omuheereza kandi kaiso w'okugumya ebintu Ruhanga akaba ali w'okusoborra hanyuma; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.5",
            "verseOrgIds": [
              "HEB.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu Kristo akaba ali mwesigwa omunju ya Ruhanga nk'omutabani. Na itwe tuli nju ya Ruhanga obu turaaba nitugumiza kimu obwesige bwaitu kandi nitwenyumiza habw'ebi tunihira kutunga.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.6",
            "verseOrgIds": [
              "HEB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuhuumuro bw'abantu ba Ruhanga",
          "type": "text"
        }
      ]
