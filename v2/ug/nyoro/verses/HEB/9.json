            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaba haroho eheema. Omu rwemo rwayo orw'omu maiso nuho haikaraga ekikondo ky'etaara, emeeza, hamu n'omugaati ogw'Empongano. Orwemo oru rwayetwaga Ekiikaro Ekirukwera. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 9:3"
          },
          "items": [
