              "type": "text"
            }
          ]
        },
        {
          "text": "rurumu ekiswa kya zaabbu eky'okwoterraho omugaju, n'esanduuko ey'endagaano ehunzirwe zaabbu embaju zoona, nambere haikaraga ekibindi kya zaabu ekirumu maanu,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:4",
              "type": "text"
            },
            {
              "text": "Maanu",
              "type": "text"
            },
            {
              "text": "nibyo byokulya Ruhanga yahaire Abaisirairi bali omu irungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " omwigo gw'Arooni ogwarokiire, kandi ebibbali by'amabaale ag'endagaano. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
