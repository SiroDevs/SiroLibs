                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi obu byamazire kuteekanizibwa biti, banyakatagara baikaraga nibataaha omu rwemo orw'okubanza, nibakoramu emirwa yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.2+LEV.16.3+LEV.16.4+LEV.16.5+LEV.16.6+LEV.16.7+LEV.16.8+LEV.16.9+LEV.16.10+LEV.16.11+LEV.16.12+LEV.16.13+LEV.16.14+LEV.16.15+LEV.16.16+LEV.16.17+LEV.16.18+LEV.16.19+LEV.16.20+LEV.16.21+LEV.16.22+LEV.16.23+LEV.16.24+LEV.16.25+LEV.16.26+LEV.16.27+LEV.16.28+LEV.16.29+LEV.16.30+LEV.16.31+LEV.16.32+LEV.16.33+LEV.16.34"
              },
              "items": [
                {
                  "text": "Lev 16:2-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omu rwemo orwa kabiri hataahamuga omukuru w'abanyakatagara wenka, kandi yataahamuga omurundi gumu omu mwaka gwona, naatwara esagama ei yahayoga habwe na habw'ebibi by'abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu ntegeka ezi ibiri, Mwoyo Ahikiriire naayoleka omuhanda ogurukutaaha omu kiikaro ekirukwera nkooku gutakabaire kukingurwa, orwemo orw'okubanza rukyaroho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nurwo rumanyisa obusinge oburoho.) Entegeka egi nkooku ekaba eri, haaheebwayo ebisembo n'ebyonzira ebikaba bitarukusobora kuhikiriza omutima gw'omuntu arukuramya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
            "verseOrgIds": [
              "HEB.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo kugamba, emirwa egi yakwataga ha byokulya, na ha byokunywa, na ha kunaaba okw'okweyeza okutali kw'omulingo gumu. Niyo mirwa eyatairweho kulinda emibiri yaitu okuhika ha kasumi ak'okugarra byona buhyaka obu kalihika.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristo akeehayo ali kyonzira",
          "type": "text"
        }
