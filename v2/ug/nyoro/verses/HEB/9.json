        {
          "text": "Endagaano eya ira nayo ekaba ina emigenzo ey'okuramya, hamu n'ekiikaro kyayo ekirukwera omunsi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
