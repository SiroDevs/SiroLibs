                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abasiisi okubamiisira esagama y'embuzi, n'ey'enimi, rundi iju ery'ekyonzira ky'enyana, obu kuraaba nikweza omubiri, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "esagama ya Kristo ayarabire omu Mwoyo Atahwaho kwehayo hali Ruhanga ataina kamogo, terikira muno kweza emitima yanyu okugiiha omu bikorwa ebifiire, nukwo muheereze Ruhanga Atafa!",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristo akagumya Endagaano Empyaka naaseesa esagama ye",
          "type": "text"
        }
      ]
