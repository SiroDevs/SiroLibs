              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "naakirra kimu bamalaika obukuru, nk'ibara yarukirwe oku lirukukira agaabo ekitiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
