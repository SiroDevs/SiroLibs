              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbamanyisa mugenzi waitu Timoteho nkooku alekiirwe. Obu alimpikaho bwango, ndija nawe tubarole.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.23",
