            }
          ]
        },
        {
          "text": "Ab'oruganda, nimbeesengereza, ebigambo byange eby'okubahabura mubiikirize n'omutima gumu, habwokuba mbifundize. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.22",
