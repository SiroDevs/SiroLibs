                "loc": "2SA.6.12+2SA.6.13+2SA.6.14+2SA.6.15"
              },
              "items": [
                {
                  "text": "2 Sam 6:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.25+1CH.15.26+1CH.15.27+1CH.15.28"
              },
              "items": [
                {
                  "text": "1 Byok 15:25-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, Esanduuko y'Endagaano n'ereetwa omunju ya MUKAMA yasorooza abakuru ba Isirairi, n'abakuru b'enganda, abeebembezi b'amaju ga baisenkurubo, abantu ba Isirairi, bagende Yerusaalemu, baihe Esanduuko y'Endagaano ya MUKAMA omurubuga rwa Daudi, orwetwa Siyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro kikuru eky'Obugenyi, ekinyakuhika omukwezi kwa musanju, abantu ba Isirairi boona bakeesorooleza omumaiso g'omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru ba Isirairi boona baija. Abaleevi baahimba Esanduuko y'Endagaano. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaleeta Esanduuko, eheema ey'okutangatanganiramu, n'ebikwato ebirukwera byona ebikaba biri omu heema; banyakatagara n'Abaleevi nubo baabireesire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Solomooni n'ekitebe ky'Abaisirairi boona abakaba bali hamu na uwe, bakeesoroza omumaiso g'Esanduuko y'Endagaano, bakatamba entaama, n'ente enyingi muno ezihinguraine kandi ezitasobora kubarwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baanyakatagara nubwo baalesire Esanduuko ey'Endagaano ya MUKAMA omukiikaro kyayo, baagitaahya omu kiikaro eky'omunda ekirukwera, ekirukwerra kimu kukira byona, yaswekererwa amapapa g'abakerubbi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba abakerubbi bakanjurra amapapa gaabo, eruguru y'ekiikaro ekikaba kirumu Esanduuko, nukwo bagiswekerre n'enyomyo zaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyomyo, zikaba ziraihire muno, omuntu ayabaga ali omukiikaro ekirukwera omumaiso g'ekiikaro ekirukwera eky'omunda, yasoboraga kwirora; baitu ayabaga aheeru, tiyasoboraga; zikyaroho okuhika na hati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.5"
              },
              "items": [
                {
                  "text": "Bir 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu Sanduuko y'Endagaano, hakaba hatarumu kintu kindi okwihaho ebyasi by'amabaale bibiri, MUKAMA ebi yakoliireho endagaano n'abantu ba Isirairi nibaruga Misiri, Musa ebi yateeriiremu ha rusozi Horebbu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekitiinisa kya MUKAMA",
          "type": "text"
        }
      ]
