              "items": [
                {
                  "text": "1 Byok 18:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulimo gwona Solomooni ogu yakozire ha Nju ya MUKAMA, nukwo gwahoire guti. Ebintu Daudi ise ebi akaba ahongere: efeeza, ezaabbu, n'ebikwato byona, yabitaahya, yabyahura omu maahurro g'Enju ya MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomooni nataahya Esanduuko y'Endagaano omunju ya Ruhanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
