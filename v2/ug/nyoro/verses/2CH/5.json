            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baanyakatagara obu baarugire omu kiikaro ekirukwera, (habwokuba banyakatagara boona abakaba bali aho, hatali kutondooza ebihanda byabo, bakaba beeyereze; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abazini Abaleevi boona, Asafu, Hemani na Yedusuuni, batabani baabo na beene baabo, bajwaire engoye eza kitaani enungi, bakeemerra ha rubaju rw'itambiro orwa Burugaizooba nibateera ebitaasa, endongo n'enanga, bali hamu na banyakatagara kikumi mu abiri abakaba nibateera amakondere); ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "abateezi b'amakondere n'abazini eki baakikoraga! Nukwo kihulirwe nkooku bateeraine hamu omu kuhaisaniza n'omu kusiima MUKAMA kandi ekizina obu kyaimukibwaga, nabwo nukwo baakoraga, nibagamba bati: “Muhaise MUKAMA habwokuba murungi, habwokuba embabazi ze z'ebiro n'ebiro,” Enju ya MUKAMA yaijura ekicu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "habw'ekicu banyakatagara nukwo kulemwa kukora omulimo gwabo; habwokuba ekitiinisa kya MUKAMA, kikaijuza enju ya Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        }
      ]
