                "loc": "EXO.26.33"
              },
              "items": [
                {
                  "text": "Kurug 26:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, yayombeka ekiikaro ekirukwerra kimu kukira byona; oburaiha bwakyo nibwingana obugazi bw'enju mita mwenda n'obugazi mwenda, yakisiiga ezaabbu enungi erukuhika tani rukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emisumaali ekakorwa ezaabbu erukuhika guraamu bitaano n'ensanju, ebisiika eby'omu kainaabiri, nabyo akabisiiga ezaabbu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
