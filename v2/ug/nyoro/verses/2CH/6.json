        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abantu bawe obu baraabaga nibaramagira abanyanzigwa baabo, bakwasire omuhanda gwona ogu oliba obarabizeemu, bakakusaba baroleriire orubuga runu oru wakomere n'Enju enu ei nakwombekiire, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ohurrege kusaba n'okwesengereza kwabo, nooyema omwiguru, kandi osagike ebigambo byabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
