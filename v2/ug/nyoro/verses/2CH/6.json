              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.8+PSA.132.9+PSA.132.10"
              },
              "items": [
                {
                  "text": "Zab 132:8-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai MUKAMA Ruhanga, hati imuka ogende omubwikaro bwawe, iwe n'Esanduuko ey'Endagaano ey'amaani gawe. Ai MUKAMA Ruhanga, banyakatagara bawe bajunwe, kandi abahikiriire bawe benyumirize omu burungi bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.41",
            "verseOrgIds": [
              "2CH.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2CH 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai MUKAMA Ruhanga, omukama ou wayekomiire, otamunagaija; oijukege engonzi zawe ezitayuga ezi wayolekere omuheereza wawe Daudi.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.42",
            "verseOrgIds": [
              "2CH.6.42"
            ]
          }
        }
