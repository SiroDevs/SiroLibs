        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.23+LEV.9.24"
              },
              "items": [
                {
                  "text": "Lev 9:23-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomooni obu yamazire kwesengereza, omurro gwaruga omwiguru gwacwekereza ebihongwa n'ebyonzira, ekitiinisa kya MUKAMA kyaijuza Enju ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitiinisa kya MUKAMA, habwokwijuza Enju, Baanyakatagara nukwo kulemwa kugitaaha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.34"
              },
              "items": [
                {
                  "text": "1 Byok 16:34",
                  "type": "text"
                }
              ]
            },
            {
