              "items": [
                {
                  "text": "118:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.136.1"
              },
              "items": [
                {
                  "text": "136:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.11"
              },
              "items": [
                {
                  "text": "Yer 33:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana ba Isirairi boona obu baaboine omurro nigusirimuka, kandi ekitiinisa kya MUKAMA nikihika ha Nju ye, bainama baajuumarra kimu ha itaka, baaramya kandi baasiima MUKAMA nibagamba bati,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma omukama n'abantu boona, nubwo baahongiire MUKAMA ebyonzira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyonzira ky'omukama Solomooni, akahonga enimi emitwaro ebiri n'enkumi ibiri, n'empaya z'entaama emitwaro ikumi n'ebiri. Omukama n'abantu boona, enju ya Ruhanga, nukwo baagihongere bati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baanyakatagara bakemerra omubiikaro byabo; Abaleevi nabo baayemerra omubyabo nibateera ebintu ebirukugamba eby'okuzinira MUKAMA, omukama Daudi ebi akaba akozire kusiimisa MUKAMA, nibazina ekizina kinu, “Engonzi ze, z'obusinge n'obusinge.” Daudi nkooku akaba abaragiire, Baanyakatagara obu baabaga nibateera amakondere, kunu abantu boona beemeriire.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomooni yayeza hagati y'ekikaali ekikaba kiri omumaiso g'Enju ya MUKAMA; habwokuba aho, nuho yahongeraga ekihongwa eky'okwokya n'ebisajwa eby'Ebihongwa eby'okusaba obusinge, habwokuba itambiro ery'omulinga eri akaba akozire, likaba liri litoito, litarukuhikwaho ekihongwa eky'okwokya, ekihongwa eky'ebyokulya n'ebisajwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi ako, Solomooni hamu n'Abaisirairi boona, ekitebe eky'abantu abaingi muno, okuruga ha ntaaho ya Hamasi okugarukira ha kasaaru ka Misiri, nubwo yacumbire obugenyi obwamazire ebiro musanju. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaba bamazire ebiro musanju ha mukoro ogw'okweza itambiro, kandi baamara ebiro musanju ebindi eby'ekiro kikuru ha kiro eky'okumalirra, nubwo habaireho ekijaguzo eky'okuherruka, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha kiro ekyakurasireho nikyo eky'amakumi abiri na bisatu eby'okwezi kwa musanju, yaraga abantu baataaha, baina omuhimbo, basemeriirwe, habw'ebirungi MUKAMA ebi yahaire abantu be Abaisirairi, Daudi ma Solomooni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruhanga nagaruka okweyoleka Solomooni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Solomooni obuyamazire Enju ya MUKAMA na Karuziika, amaliriize byona, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akamubonekera ekiro yamugambira ati: “Mpuliire okusaba kwawe, ekiikaro kinu nkyekomiire, ebege Nju ey'okutambiramuga ebyonzira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu ndaakingaga iguru, enjura ekalema kugwa, rundi nkaragira enzige kusiisa ebyokulya, rundi abantu bange obu ndaabanagamuga kagingo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "obu baranyesengerezaaga bakazira, bakafuhya obubi obu babaire nibakora, ndaayemaga omwiguru mbahurre, mbaganyire ebibi byabo, ensi yabo ngigarurre obusinge. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaikaraga ndoleriire ekiikaro kinu, kandi ndaahulirizaaga byona ebirukusabirwa omu kiikaro kinu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.15",
            "verseOrgIds": [
              "2CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba nkomere Enju enu, kandi nagyeza niyo ndamizibwemuga obusinge bwona; ndaagirindaga kandi ndaagitahoga omutima obwire bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.16",
            "verseOrgIds": [
              "2CH.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi iwe obu olikora ebi ngonza, nka Sso Daudi oku yakozire, okakora byona ebi nkuragiire, okakwata ebiragiro n'ebigambo byange, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.17",
            "verseOrgIds": [
              "2CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.4"
              },
              "items": [
                {
                  "text": "1 Bakam 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "obu nubwo ndigumya ekitebe eky'obukama bwawe, nkooku naragaine na Sso Daudi ningamba nti, ‘Toliburwa muntu ow'okulema Isirairi.’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baitu obu olyehugura okaleka ebiragiro byange nakuteeriireho, n'ebigambo nakugambiire, okagenda kuheereza baaruhanga abandi n'okubaramya, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.19",
            "verseOrgIds": [
              "2CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ensi ei nkuhaire enu ndigibamenyamu; kandi Enju enu ei nayereze habw'ibara lyange, ndigiseesa enduge omumaiso, ngifoole rufumo oruraacwibwaga, kintu ekiraikaraga nikisekerezibwa omu mahanga goona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.20",
            "verseOrgIds": [
              "2CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena araarabaga ha Nju enu erukunyumizibwa eti, araahunirraga agambe ati, ‘Kiki MUKAMA eki yakoliire ati ensi enu, n'Enju enu?’ ",
          "type": "text",
