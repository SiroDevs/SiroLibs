              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi nukwo kyabaire n'omu biro bya Loti. Abantu baalyaga, baanywaga, baaguraga, baatundaga, baabyaraga, kandi baayombekaga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu ha kiro Loti eki yarugiremu Sodomu, omurro n'obuganga bikaruga omwiguru byagwa, byahwerekereza abantu boona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
            "verseOrgIds": [
              "LUK.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo kiriba kiti na ha kiro Omwana w'omuntu eki alibonekeramu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.30",
            "verseOrgIds": [
              "LUK.17.30"
            ]
          }
        }
