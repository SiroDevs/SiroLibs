                  "text": "Kub 7:6-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baalyaga, baanywaga, kandi baasweranganaga okuhika ha kiro Noha eki yataahiiremu omu lyato erikooto, okusandaara kw'amaizi kukaija kwahwerekereza abantu boona.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.27",
