            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Weena anyakugonza kujuna obwomeezi bwe, alibufeerwa; kandi anyakufeerwa obwomeezi bwe, alibujuna. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
            "verseOrgIds": [
              "LUK.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
