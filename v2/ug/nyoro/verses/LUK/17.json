            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nkooku kyabaire omu biro bya Noha, nukwo kiriba kiti n'omu biro by'Omwana w'omuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
