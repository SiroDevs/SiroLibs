          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajuna kandi asahura, akora eby'amahano kandi ebihuniiriza omwiguru n'omunsi, ogu nuwe yajunire Daneeri entale.” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.27",
            "verseOrgIds": [
              "DAN.6.27"
            ]
          }
        },
