              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka ogwa kasatu ogw'engoma ya Yehoyakimu omukama wa Yuda, Nebbukadaneeza omukama wa Babbulooni, nubwo yaseesiire orubuga Yerusaalemu yarugota. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
