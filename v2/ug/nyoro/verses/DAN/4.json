        },
        {
          "text": "Habweki iwe omukama, oikirize ebi ndukukugambira; ofuuhye ebibi okole ebirungi, ogirre abanaku embabazi, obu nubwo olihangaara kandi ogwagwane.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
