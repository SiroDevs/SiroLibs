{
  "id": "DAN.4",
  "number": "4",
  "bookId": "DAN",
  "reference": "Dan 4",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
