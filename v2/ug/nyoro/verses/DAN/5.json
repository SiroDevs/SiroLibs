          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho, Berisaza yaragira, Daneeri yajwekwa engoye eza kahuukya, n'omukuufu ogwa zaabbu; gwamugya omu bikya yarangirirwa ngu nuwe mulemi owa kasatu omu bukama obu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.29",
            "verseOrgIds": [
              "DAN.5.29"
            ]
          }
        },
        {
          "name": "verse",
