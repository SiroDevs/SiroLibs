              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daliyo Omumeedi omu kasumi ako akaba naahikya emyaka nka nkaaga n'ebiri ey'obukuru, nuwe yateera engoma.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.31",
