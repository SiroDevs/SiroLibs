                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omu kasumi ako Mikairi malaika omukuru anyakurolerra abantu bawe, alyemerra agambe ati: Halibaho akasumi ak'omuhito ogutakabahoga, amahanga gaakaba kuhangwa; baitu omu kasumi ako, abantu bawe boona abaliba bahandiikirwe omu kitabu kya Ruhanga balijunwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.1",
            "verseOrgIds": [
              "DAN.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.19"
              },
              "items": [
                {
                  "text": "Is 26:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2MA.7.9+2MA.7.10+2MA.7.11"
              },
              "items": [
                {
                  "text": "2Mak 7:9-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2MA.7.14"
              },
              "items": [
                {
                  "text": "14",
