              "NUM.5.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.6.1+LEV.6.2+LEV.6.3+LEV.6.4+LEV.6.5+LEV.6.6+LEV.6.7"
              },
              "items": [
                {
                  "text": "Lev 6:1-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagaruka yagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.5",
            "verseOrgIds": [
              "NUM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gambira abantu ba Isirairi ngu: ‘Omusaija rundi omukazi, kakuba akora ekimu ha bibi abantu ebi bakora, bakasiisa obwesige hali MUKAMA, omuntu ogu ajunaanwege omusango. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.6",
            "verseOrgIds": [
              "NUM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayatule ekibi kye eki akozire, kandi aheyo endehwa enyakuhikire habw'ensobi ye, naayongeraho kimu kya kataano, nukwo agihe oli ou yasobezeeho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.7",
            "verseOrgIds": [
              "NUM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu kakuba hatabaho muntu ayasobezibwe ow'okulehera, endehwa egendege hali MUKAMA, ekonyere nyakatagara, eyongerweho entaama empaya ey'okusabiraho ekiganyiro nyakatagara eki alimusabira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.8",
            "verseOrgIds": [
              "NUM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi buli kihongwa kyona, ebintu byona ebirukwera, abantu ba Isirairi ebi baraaleeteraga nyakatagara, bibege bye; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.9",
            "verseOrgIds": [
              "NUM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "buli kintu kyona ekirukwera, kibege kye.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekiragiro ekirukukwata ha bufuuhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagaruka yagamba Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.11",
            "verseOrgIds": [
              "NUM.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gambira abantu ba Isirairi ngu: Kakuba muka musaija ayecwamu obugangaale akatandika kugobeza iba, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.12",
            "verseOrgIds": [
              "NUM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "omusaija ondi kakuba abyama n'omukazi ogu, eki, iba atakimanyire, omukazi ogu tasobora kwomerizibwa ekibi noobu araaba akikozire, habwokuba tiharoho bwakaiso oburukumurumiriza, habwokuba busaho ayamukwasire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.13",
            "verseOrgIds": [
              "NUM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba iba atandika kuteekereza kubi hali mukazi we ogu anyakukozire ekibi, rundi akamuteekerezaaho kubi, kandi kunu ekibi atakikozire, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.14",
            "verseOrgIds": [
              "NUM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "omusaija aleete mukazi we hali nyakatagara. Aleete n'ekihongwa ekirukumusabwa, niyo kiloguraamu eya sairi, atalikiseesaho amagita kandi atalikitaho enkwasi habwokuba, kihongwa eky'ebyokulya ekinyakuleesirwe omusaija arukuteekerezaaho kubi mukazi we, ekinyakuhairweyo okuzoora amazima.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omukazi ogu, nyakatagara amwirize haihi, amute omumaiso g'itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.16",
            "verseOrgIds": [
              "NUM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo nyakatagara akwate ha maizi aganyakuli omu kibindi, akwate ecuucu enyakuli omu Heema, agite omu maizi ago. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.17",
            "verseOrgIds": [
              "NUM.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Airize haihi omukazi omumaiso g'itambiro, amusumurre isoke, amukwase ekihongwa eky'ebyokulya eky'ekiijukyo, eki nikyo ekihongwa eki nyakuhairweyo habw'obufuuhi. Nyakatagara akwate amaizi agarukusarra aganyakuleeta omukyeno. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arahize omukazi ogu ati: ‘Obu haraaba hataroho musaija ayakwiriire haihi, rundi obu oliba otarayenagire omu ngeso mbi obu okaba okyali omu mikono ya baro, amaizi ganu agarukusarra, aganyakuleeta omukyeno, gatakukoraho akabi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.19",
            "verseOrgIds": [
              "NUM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu obu oliba wayenagiriize noobu okaba okyali omwa baro, wayesiisa, rundi omusaija ondi atali baro, obu aliba yatembere ekitabu kyawe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.20",
            "verseOrgIds": [
              "NUM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akusende kandi akukyene. Obe ky'okurorraho kya boona omu bantu b'owanyu, akwomye ekibero, akuzimbye omubiri gwona; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "amaizi ganu aganyakuleeta omukyeno, gakutaahe omunda, gakuzimbye omubiri gwona, gakwokye ekibero.’ Omukazi agambe ati: ‘Ego, MUKAMA nukwo akole.’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nubwo nyakatagara, ebigambo ebi eby'okukyena emikyeno egi, abihandiike omu kitabu, abyogyemu n'amaizi ago agarukusarra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.23",
            "verseOrgIds": [
              "NUM.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaizi ago kaleeta mukyeno, aganywise omukazi ogu, gamutaahe omunda gamurumye enjoka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.24",
            "verseOrgIds": [
              "NUM.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwiheho ekihongwa eky'ebyokulya ekinyakuhairweyo habw'obufuuhi, akiimukyaimukye omumaiso ga MUKAMA, nukwo akireete ha itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.25",
            "verseOrgIds": [
              "NUM.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwate orucumite orw'ekihongwa eky'ebyokulya, kibe kiijukyo kyakyo, arwokeze ha itambiro, aruhyange omu maizi, amaizi ago aganywise omukazi ogu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.26",
            "verseOrgIds": [
              "NUM.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazire kumunywisa amaizi ago, omukazi obu aliba yakozire ekibi, agobiize iba, amaizi ago kaleeta mukyeno, galimutaaha omunda, gamurumye enjoka, azimbe wena ayome ekibero abe musendwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.27",
            "verseOrgIds": [
              "NUM.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 5:28"
          },
          "items": [
            {
