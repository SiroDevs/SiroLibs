    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abarukuzirwa nibabingwa omu rukande",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.1",
            "verseOrgIds": [
              "NUM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ragira abantu ba Isirairi baihe abagenge boona omu rukande, buli muntu arukurugwa amasira omu mubiri na buli muntu weena arukuzirwa ayakwasire ha mutumbi gw'omuntu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.2",
            "verseOrgIds": [
              "NUM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "abasaija n'abakazi boona mubaturukye, mubaihe omu rukande, baleke kusiisa orukande oru nyikaramu ndi hagati yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.3",
            "verseOrgIds": [
              "NUM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisirairi nukwo baakozire, abantu abo boona baabaiha omu rukande; MUKAMA nkooku yaragiire Musa, n'abantu ba Isirairi nukwo baakozire.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekiragiro eky'okuleha habw'ensobi enyakukozirwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 5:5"
          },
          "items": [
