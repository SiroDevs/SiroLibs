            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ha bukiizi obw'emoso, harabayoga ebendera ey'orukande orwa Daani nkooku baategekerwe omu mahe gaabo, omwebembezi ow'abantu be nuwe Ahyezeri mutabani wa Amisadai, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.25",
            "verseOrgIds": [
              "NUM.2.25"
            ]
          }
        },
        {
