            "sid": "NUM 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurataho oruganda rwa Nafutaali, omwebembezi w'abantu be nuwe Ahira mutabani wa Enani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.29",
            "verseOrgIds": [
              "NUM.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ihe rye obu lyabazirwe likahikya emitwaaro etaano nkumi isatu n'ebbina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.30",
            "verseOrgIds": [
              "NUM.2.30"
            ]
          }
        },
