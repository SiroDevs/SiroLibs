          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nubwo haimukyege Eheema ey'okutangatanganiramu, oruganda orw'Abaleevi ruli hagati y'enkande ezindi nkooku bateera enkande, nukwo baraimukyaga kugenda, buli ruganda niruhondera ebendera yarwo.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
            "verseOrgIds": [
              "NUM.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
            "verseOrgIds": [
              "NUM.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
