        "style": "s1"
      },
      "items": [
        {
          "text": "Koora, Dasani na Abiraamu nibeema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 16:1"
          },
          "items": [
