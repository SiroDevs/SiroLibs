          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nubo Musa na Arooni aba baabazire nibakonyerwa abeebembezi ba Isirairi, abasaija ikumi na babiri, omu ali ngabwa y'orugandarwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.44",
            "verseOrgIds": [
              "NUM.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, omuhendo gwona ogw'abasaija aba Isirairi, omu bitabu ebya baisenkurubo, okuruga hab'emyaka amakumi abiri ey'obukuru n'okweyongerayo, buli musaija ow'akaba naasobora kuramaga ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
              "NUM.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuhendo gwabo gwona gukaba guli emitwaro nkaaga, nkumi isatu, bitaano n'ataano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.46",
            "verseOrgIds": [
              "NUM.1.46"
            ]
          }
        }
      ]
    },
