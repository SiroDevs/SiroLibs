              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ba Isirairi nukwo baakozire; baakora byona nibahondera MUKAMA ebi yaragiire Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.54",
