          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuhendo gwabo gukahika emitwaaro etaano nkumi isatu n'ebbina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.43",
            "verseOrgIds": [
