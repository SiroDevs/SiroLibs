          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhendo ogw'abantu aba Simyoni ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "bbo bakahika emitwaro etaano nakenda n'ebisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Gaadi ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.24",
            "verseOrgIds": [
              "NUM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuhendo gwabo gukahika emitwaaro ena enkumi itaano rukaaga n'ataano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.25",
            "verseOrgIds": [
              "NUM.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Yuda ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.26",
            "verseOrgIds": [
              "NUM.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuhendo gwaabo gukahika emitwaaro musanju, mu nkumi ina n'orukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.27",
            "verseOrgIds": [
              "NUM.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Isakara ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.28",
            "verseOrgIds": [
              "NUM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuhendo gwaabo gukahita emitwaaro etaano enkumi ina n'ebbina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.29",
            "verseOrgIds": [
              "NUM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Zebburuni ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.30",
            "verseOrgIds": [
              "NUM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuhendo gwaabo gukahika emitwaaro etaano kasanju n'ebbina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.31",
            "verseOrgIds": [
              "NUM.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Efuraimu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.32",
            "verseOrgIds": [
              "NUM.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuhendo gwaabo gukahika emitwaaro ena n'ebitaano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.33",
            "verseOrgIds": [
              "NUM.1.33"
            ]
          }
