                "loc": "NUM.26.1+NUM.26.2+NUM.26.3+NUM.26.4+NUM.26.5+NUM.26.6+NUM.26.7+NUM.26.8+NUM.26.9+NUM.26.10+NUM.26.11+NUM.26.12+NUM.26.13+NUM.26.14+NUM.26.15+NUM.26.16+NUM.26.17+NUM.26.18+NUM.26.19+NUM.26.20+NUM.26.21+NUM.26.22+NUM.26.23+NUM.26.24+NUM.26.25+NUM.26.26+NUM.26.27+NUM.26.28+NUM.26.29+NUM.26.30+NUM.26.31+NUM.26.32+NUM.26.33+NUM.26.34+NUM.26.35+NUM.26.36+NUM.26.37+NUM.26.38+NUM.26.39+NUM.26.40+NUM.26.41+NUM.26.42+NUM.26.43+NUM.26.44+NUM.26.45+NUM.26.46+NUM.26.47+NUM.26.48+NUM.26.49+NUM.26.50+NUM.26.51"
              },
              "items": [
                {
                  "text": "Kubar 26:1-51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eky'okubanza eky'okwezi kwa kabiri omu mwaka ogwa kabiri, Abaisirairi bamazire kuruga omunsi Misiri, MUKAMA akagambira Musa ali omu Heema ey'okutangatanganiramu omwirungu lya Sinai ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bara abantu boona ab'ekitebe kya Isirairi, obabarre omu nganda zaabo, omu bitabu bya ba isenkuru bo nkooku amabara gaabo gali, buli musaija, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.2",
            "verseOrgIds": [
              "NUM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuruga habw'emyaka amakumi abiri ey'obukuru n'okweyongerayo abantu boona omu Isirairi abarukusobora kuramaga, iwe na Arooni mubabale, mwoleke ihe erya buli ruganda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.3",
            "verseOrgIds": [
              "NUM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obe n'omusaija omu anyakurugire omu buli ruganda, buli musaija ali mukuru w'ekitebe kye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.4",
            "verseOrgIds": [
              "NUM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganu nugo mabara g'abasaija abaraakora na iwe. Arukuruga omu ruganda orwa Rubbeni, nuwe Erizuura, mutabani wa Sedura ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5",
            "verseOrgIds": [
              "NUM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "arukuruga omu ruganda rwa Simyoni, nuwe Serumyeri mutabani wa Zulusadai; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.6",
            "verseOrgIds": [
              "NUM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "arukuruga omu ruganda rwa Yuda, nuwe Nahasooni, mutabani wa Aminadabbu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.7",
            "verseOrgIds": [
              "NUM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "arukuruga omu ruganda rwa Isakara, nuwe Nasanairi mutabani wa Zuhara, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.8",
            "verseOrgIds": [
              "NUM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "arukuruga omu ruganda rwa Zabbulooni, nuwe Eryabu mutabani wa Heroni; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.9",
            "verseOrgIds": [
              "NUM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "abarukuruga omu batabani ba Yosefu, arukuruga omu ruganda wa Efuraimu, nuwe Erisama, mutabani wa Amihudi, kandi arukuruga omu ruganda rwa Manaase, nuwe Gamalyeri, mutabani wa Pedazura; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.10",
            "verseOrgIds": [
              "NUM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "arukuruga omu rwa Benyamiini, nuwe Abidaani mutabani wa Gidyoni; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.11",
            "verseOrgIds": [
              "NUM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "arukuruga omu rwa Daani, nuwe Ahyezeri mutabani wa Amisadai; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.12",
            "verseOrgIds": [
              "NUM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "arukuruga omu rw'Aseeri, nuwe Pagyeri mutabani wa Ocurani; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.13",
            "verseOrgIds": [
              "NUM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "arukuruga omu rwa Gaadi, nuwe Eriasaafu mutabani wa Dehuli, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.14",
            "verseOrgIds": [
              "NUM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "arukuruga omu rwa Nafutaali, nuwe Ahira mutabani wa Enani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.15",
            "verseOrgIds": [
              "NUM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nubo abaakomerwe nibaihwa omu kitebe ky'abantu, abeebembezi ab'ebika ebya baisenkurubo, bakuru b'enganda za Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.16",
            "verseOrgIds": [
              "NUM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Arooni baatwara abasaija abo abanyakugambirweho, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ha kiro eky'okubanza eky'okwezi kwa kabiri, baayeta ekitebe kyona eky'abaayehandikisize omu bika, omu bitabu ebya baisenkurubo, boona abakaba nibahikya emyaka amakumi abiri ey'obukuru n'okweyongerayo nkooku amabara gaabo gali, abakuru nibahonderana, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkooku MUKAMA yaragiire Musa. Nukwo yababazire ati, bali omwirungu lya Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhendo ogw'abantu ba Rubbeni omuzigaijo gwa Isirairi, obwijukuru bwabo, ebika byabo, ebitabu ebya baisenkurubo noororra ha muhendo ogw'amabara, buli musaija okurugirra ha w'emyaka amakumi abiri ey'obukuru n'okweyongerayo, boona abakaba nibasobora kuramaga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuhendo gwabo gwahika emitwaro ena, mukakaaga n'ebitaano.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
