            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni nyakatagara akatemba ha rusozi Hora, MUKAMA nkooku yamuragiire, oku nuho yagwire, ha kiro eky'okubanza eky'okwezi okwa kataano, omu mwaka ogw'amakumi ana, Abaisirairi bamazire kuruga Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.38",
            "verseOrgIds": [
              "NUM.33.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 33:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni kufeera ha rusozi Hora, akaba ahikize emyaka kikumi mu abiri n'esatu ey'obukuru.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.39",
            "verseOrgIds": [
              "NUM.33.39"
            ]
          }
        }
      ]
