                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyakanaani omukama w'Aradi, ayaikaraga obukiizi bw'obulyo bw'ensi Kanaani, akahurra Abaisirairi nkooku bakaba nibaija.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
