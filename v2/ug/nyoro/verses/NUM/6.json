            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki nikyo kiragiro eky'Omunaziri anyakukora ekiragaano. Ekihongwa eki arukuhongera MUKAMA, kinganaingane n'ekiragaano kye, otataireho ebindi byona ebi asobora kuleeta; ebi akora obu aba naaragaana, nibyo akole, ha kusoroorwa kwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ogambire Arooni n'abatabani ebigambo binu, ebi baraagambaga nibasabira abantu ba Isirairi omugisa, bati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
            "verseOrgIds": [
              "NUM.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘“MUKAMA abahe omugisa kandi abalinde, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.24",
            "verseOrgIds": [
              "NUM.6.24"
            ]
          }
        },
        {
