          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakaba bahikize emyaka asatu ey'obukuru okuhika ha myaka amakumi ataano, buli muntu arukusobora kutaaha omu mulimo ogw'okukora omu Heema ey'okutangatanganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.35",
