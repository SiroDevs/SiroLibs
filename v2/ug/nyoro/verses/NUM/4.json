              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuhendo gwabo omubika byabo n'omu bitabu ebya baisenkurubo, gukaba guli enkumi ibiri rukaaga n'asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.40",
            "verseOrgIds": [
