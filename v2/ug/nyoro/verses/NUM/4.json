              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa, Arooni n'abeebembezi b'ekitebe, baabara batabani ba Kohati omu bika byabo n'omu bitabu ebya baisenkurubo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.34",
            "verseOrgIds": [
              "NUM.4.34"
            ]
          }
        },
