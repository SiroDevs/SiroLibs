          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu baabazirwe omu bika byabo, omuhendo gwahika enkumi ibiri rusanju n'ataano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.36",
            "verseOrgIds": [
              "NUM.4.36"
            ]
          }
        },
