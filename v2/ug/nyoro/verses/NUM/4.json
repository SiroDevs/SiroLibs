              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuruga hab'emyaka amakumi asatu okuhika ha b'emyaka amakumi ataano ey'obukuru, buli muntu ayasoboire kutaaha omu mulimo omu Heema ey'okutangatanganiramu, ",
          "type": "text",
          "attrs": {
