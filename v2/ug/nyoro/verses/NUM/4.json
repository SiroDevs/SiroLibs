          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhendo ogw'ebika ebya batabani ba Merali obu baabazirwe omu bika byabo n'omu bitabu ebya baisenkurubo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.42",
