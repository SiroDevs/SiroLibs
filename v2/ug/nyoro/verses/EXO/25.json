          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hansi ya buli gumu ha migogo esatu ey'amataagi asatu, habeho ekitutu kimu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.35",
            "verseOrgIds": [
              "EXO.25.35"
            ]
