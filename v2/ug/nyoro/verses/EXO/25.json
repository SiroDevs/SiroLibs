  "reference": "Kurug 25",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "EXO 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebisembo eby'okwombeka ekiikaro ekirukwera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagambira Musa ati, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.1",
            "verseOrgIds": [
              "EXO.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gambira abaana ba Isirairi, bandeetere ebihongwa, weena anyakwina omutima ogw'engonzi, omwiheho ekintu okindeetere. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.2",
            "verseOrgIds": [
              "EXO.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binu nibyo bintu ebi baraakuha: Zaabbu, efeeza, n'omulinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.3",
            "verseOrgIds": [
              "EXO.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engoye ez'erangi eya kaneke, eya kahukya, eya kagaaju, n'eza kitaani enyakurangirwe kurungi ebyoya by'embuzi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.4",
            "verseOrgIds": [
              "EXO.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "empu ezisemeziibwe kurungi ez'entaama, ez'engonge, embaaho ez'emiti emisisa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.5",
            "verseOrgIds": [
              "EXO.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "amagita ag'okuta omu taara, ebiboya eby'okuta omu magita ag'okwesiiga n'eby'okwongera kuboyesa eseeta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.6",
            "verseOrgIds": [
              "EXO.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabaale ag'erangi ezitali zimu, n'obubaale obw'okuhunda, obw'okuhunda ekanzu ey'okuheererezaamu n'ekya ha kifuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.7",
            "verseOrgIds": [
              "EXO.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obagambe bankorre ekiikaro ekirukwera, nukwo mbaikale hagati. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.8",
            "verseOrgIds": [
              "EXO.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Byona eby'okukozesa Eheema hamu n'ebikwato byamwo, ebirukukwata ha nsisana yayo, ebi ndukukwoleka, obikole nkooku mbikwolekere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esanduuko y'endagaano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bankorre esanduuko ey'okwahuramu endagaano, bagikole omu mbaaho ez'emiti emisisa, obura bwayo mita emu, obugazi bwayo kicweeka kya mita, n'obwemi bwayo kicweeka kya mita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.10",
            "verseOrgIds": [
              "EXO.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogisiige na zaabbu enungi omunda n'aheeru, yoona ogyehingulirize n'omugoma gwa zaabbu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.11",
            "verseOrgIds": [
              "EXO.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogihesire empeta ina eza zaabbu, ozite ha maguru gayo ana; ibiri ha rubaju orumu, n'ibiri ha rubaju orundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.12",
            "verseOrgIds": [
              "EXO.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obaije emango ez'omuti omusisa, ozisweke na zaabbu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.13",
            "verseOrgIds": [
              "EXO.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emango ezi, ozisomeke omu mpeta ezinyakuli ha mbaju zaayo, nizo muraahimbirahoga esanduuko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.14",
            "verseOrgIds": [
              "EXO.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emango ezi, ziikaleho isomekerwe omu mpeta ez'esanduuko, italisomorwamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.15",
            "verseOrgIds": [
              "EXO.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu sanduuko egi, nuho ote endagaano ei ndaakuha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.16",
            "verseOrgIds": [
              "EXO.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.5"
              },
              "items": [
                {
                  "text": "Baheb 9:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, okole ekitebe eky'okuganyirirraho, ekya zaabbu enungi, obura bwakyo, kibe sentimita kikumi mwikumi, obugazi bwakyo sentimita nkaaga na mukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.17",
            "verseOrgIds": [
              "EXO.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okole ebihange bibiri ebyamapapa ebya zaabbu ebiheesirwe n'enyondo, obite orubaju n'orubaju. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.18",
            "verseOrgIds": [
              "EXO.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekihange ekimu kibe ha rubaju orumu n'ekindi ha rundi. Zaabbu ei wakozeseze ekitebe eky'okuganyirirraho, niyo okozese ebihange ebi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.19",
            "verseOrgIds": [
              "EXO.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebihange ebi, byanjurre amapapa gaabyo, bisiikirize ekitebe eky'okuganyirirraho, buli kihange kihindukire kitaahi kyaakyo, biroleriire ekitebe eky'okuganyirirraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.20",
            "verseOrgIds": [
              "EXO.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitebe eky'okuganyirriraho, okite ha ruguru y'esanduuko kandi omu sanduuko omunda, otemu endagaano ei ndaakuha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.21",
            "verseOrgIds": [
              "EXO.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu nuho turaatangatanganiraga, kandi ha ruguru y'ekitebe eky'okuganyirirraho ekinyakuli hagati y'ebihange bibiri ebinyakuli ha sanduuko ey'endagaano, nuho ndaabalizaaga na iwe, ha byona ebinyakuli omu biragiro ebi mpaire abaana ba Isirairi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emeeza ey'Okutaho Omugaati Oguhongiirwe Ruhanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okole emeeza ey'omuti ogw'omusisa; obura bwayo mita emu, obugazi, kicweeka kya mita n'obwemi kicweeka kya mita.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.23",
            "verseOrgIds": [
              "EXO.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.23",
            "verseOrgIds": [
              "EXO.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogisiige zaabbu enungi mali, kandi ogiteho omugoma ogw'ezaabbu okugyehinguliriza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.24",
            "verseOrgIds": [
              "EXO.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.24",
            "verseOrgIds": [
              "EXO.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogiteho orubbalaza orukuhika ekiganja kimu obugazi, okugyehinguliriza, kandi ogukugire na zaabbu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.25",
            "verseOrgIds": [
              "EXO.25.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.25",
            "verseOrgIds": [
              "EXO.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogikorre empeta za zaabbu ina, ozibohe ha nsonda zaayo ina, ezinyakuli ha maguru gaayo ana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.26",
            "verseOrgIds": [
              "EXO.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.26",
            "verseOrgIds": [
              "EXO.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empeta ez'okukwata emango ez'okwetwekeraho emeeza, ziteebwe haihi n'orubbalaza.",
          "type": "text",
          "attrs": {
