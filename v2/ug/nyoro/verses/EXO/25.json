          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emitwe, amataagi n'ekikondo, byona bikorwe omu kintu kimu ekya zaabbu enungi eheserwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.36",
            "verseOrgIds": [
