              "items": [
                {
                  "text": "27:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otalyekorra ekisisani eky'omulingo gwona, ekirukusisana ekintu kyona ekinyakuli haiguru omu mwanya, ekinyakuli hansi omwitaka, rundi ekinyakuli omu maizi hansi y'itaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.4",
            "verseOrgIds": [
              "EXO.20.4"
            ]
          }
        },
