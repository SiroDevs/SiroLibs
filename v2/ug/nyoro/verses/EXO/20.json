            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga akagamba ebigambo binu byona ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.1",
            "verseOrgIds": [
              "EXO.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ninyowe MUKAMA Ruhanga wawe, ayakwihire omunsi Misiri, nambere walemerwaga nk'omwiru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.2",
            "verseOrgIds": [
              "EXO.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaliramya ruhanga ondi weena kunu nyowe ndoho.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.3",
            "verseOrgIds": [
              "EXO.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 20:4"
          },
          "items": [
