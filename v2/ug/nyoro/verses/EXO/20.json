            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otalibiinamira rundi kubiramya; habwokuba, nyowe MUKAMA Ruhanga wawe, mba Ruhanga ow'ihali, nfubira abaana ab'obwijukuru obw'enyakasatu n'obwenyakana obw'abo abanyakuunoba, nimbatura obubi obwa baisenkurubo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu enkumi n'enkumi ez'abo abanyakungonza, bakakwata ebiragiro byange, mbagirra embabazi nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
