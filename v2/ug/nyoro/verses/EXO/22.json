              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba obabonabonesa bakanterra omuranga, mazima ndihurra okutaabaana kwaabo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
