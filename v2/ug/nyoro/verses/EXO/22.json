            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba omusaija asoonasoona omwisiki atamanyire musaija akabyama na uwe, amujuge amuswerre kimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba ise omwisiki ayanga kumumuha, omusaija naasemerra alehesibwe sente ezi bajuga abaisiki abatamanyire basaija.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
