              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA Ruhanga yagambira Musa ati: “Hati, noija kurora eki ndaakora Faraaho. Ndaamuhambiriza abaleke bagende, obu ndaamuhambiriza muno, naija kubabinga omunsi ye.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruhanga naayeta Musa obwakabiri",
          "type": "text"
        }
      ]
    },
