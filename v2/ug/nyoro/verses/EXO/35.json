      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebiragiro eby'ekiro kya Sabbato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yasorooza ekitebe kyona eky'abantu ba Isirairi yabagambira ati: “Binu nibyo bintu MUKAMA abaragiire kukora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.8+EXO.20.9+EXO.20.10+EXO.20.11"
              },
              "items": [
                {
                  "text": "Kurug 20:8-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.12"
              },
              "items": [
                {
                  "text": "23:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.15"
              },
              "items": [
                {
                  "text": "31:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.21"
              },
              "items": [
                {
                  "text": "34:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.3"
              },
              "items": [
                {
                  "text": "Lev 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Bir 5:12-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukolege emirimo omu biro mukaaga, baitu ekiro ekya musanju hali inywe, eraabaga Sabbato erukwera ehairweyo hali MUKAMA, weena ow'aligikorraho omulimo, ogu w'okwitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki, mutalihemba omurro omu maka ganyu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebyokuhonga habw'enju ya MUKAMA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yagambira ekitebe kyona eky'abantu ba Isirairi ati: “Binu nibyo MUKAMA aragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bintu byanyu ebi mutungire, mwiheho ekintu eky'okuhongera MUKAMA. Anyakwina omutima ogw'obwenda, aleete ekintu eky'okuhongera MUKAMA; ekya zaabbu, efeeza, n'omulinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eky'engoye ez'erangi ya kaneke, kahuukya, n'erukugaajuka, na kitaani erukirwe kurungi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.6",
            "verseOrgIds": [
              "EXO.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "engoye ezinyakurukirwe kurungi mu bwoya bw'embuzi, omu mpu z'entaama empaya n'ez'embuzi ezihindwirwe erangi erukunanata, n'embaaho z'omusisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.7",
            "verseOrgIds": [
              "EXO.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagita ag'etaara, ebiboya eby'okutabura amagita aganyakuseeswaho abantu n'ebintu eby'okwezibwa, n'eby'okwongera kuboyesa eseeta; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.8",
            "verseOrgIds": [
              "EXO.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "amabaale ag'erangi ezitali zimu ag'okuhunda ekanzu n'ekya ha kifuba ekinyakujwarwa nyakatagara obu aba naagenda kwekaguza hali MUKAMA.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.9",
            "verseOrgIds": [
              "EXO.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebintu by'okukozesa Enju ya MUKAMA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.9",
            "verseOrgIds": [
              "EXO.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weena omuli inywe anyakumanyire kukora kurungi omulimo aije tukole byona MUKAMA ebi aragiire: Enju ya MUKAMA, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.10",
            "verseOrgIds": [
              "EXO.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eheema yayo n'eby'okugisweka, ebikwaso n'embaaho zaayo, emango zaayo, enyomyo zaayo, obucuba bwayo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.11",
            "verseOrgIds": [
              "EXO.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "esanduuko y'endagaano n'emango zaayo, ekitebe eky'okuganyirirraho, n'enyigamo ey'okukinga; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.12",
            "verseOrgIds": [
              "EXO.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "emeeza n'emango zaayo na byona ebinyakukwatirwaho; omugaati ogw'okwoleka; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.13",
            "verseOrgIds": [
              "EXO.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekikondo eky'etaara na byona ebinyakukoraho, etaara zaakyo n'amagita ag'etaara; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.14",
            "verseOrgIds": [
              "EXO.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "itambiro ery'okucumiikirirraho obubbani n'emango zaalyo; amagita aganyakuseeswaho abantu n'ebintu eby'okwezibwa; eseeta ey'erukuboya kurungi; orukingyo orunyakukinga omulyango ogurukutaaha omunju ya MUKAMA; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.15",
            "verseOrgIds": [
              "EXO.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "itambiro ery'okwokezaaho ebihongwa n'ekyoma kyalyo eky'omunda ekinyakusungusura amakara, emango zalyo na byona ebinyakulikoraho, ebbeseni n'ekikondo kyayo ekyetebwamu n'orukingyo orw'irembo ery'ezigati; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.16",
            "verseOrgIds": [
              "EXO.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "engoye ez'okutimba omu zigati, enyomyo zaayo n'obucuba bwayo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.17",
            "verseOrgIds": [
              "EXO.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "enkondo ez'Enju ya MUKAMA n'ezigati, obuguha bwazo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.18",
            "verseOrgIds": [
              "EXO.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebijwaro ebinyakubaziirwe kurungi eby'okuheererezamu omu kiikaro ekirukwera, ebijwaro ebirukwera, Arooni nyakatagara n'abatabani ebi baraakorramuga omulimo gwaabo ogw'obunyakatagara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
            "verseOrgIds": [
              "EXO.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abantu nibahayo ebihongwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
            "verseOrgIds": [
              "EXO.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi, abantu boona baaruga omumaiso ga Musa baagenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.20",
            "verseOrgIds": [
              "EXO.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli muntu omutima gwe ou gwagambiire kandi ou gwahambiriize, akaleetera MUKAMA Ruhanga ekihongwa eky'okukora omulimo ogw'Eheema ey'okutangatanganiramu habw'omulimo gwona ogunyakukolerwamu, na habw'ebijwaro byona ebirukwera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.21",
            "verseOrgIds": [
              "EXO.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaija n'abakazi, boona baija: boona abakaba baina omutima ogurukugonza, bakaleeta ebikwaso, empeta ezinyakujwarwa ha matu na ha nkumo, ebikomo n'ebintu byona ebya zaabbu eby'okwekunisa. Buli muntu akaleeta ekintu kyona eki yarozire kisemeriire MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.22",
            "verseOrgIds": [
              "EXO.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli muntu ow'akaba aina orugoye orw'erangi eya kaneke, kahukya n'erukugaajuka, rundi kitaani enungi, obwoya bw'embuzi, empu ezinyakuhazirwe ez'entaama empaya rundi ez'embuzi, akazireeta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.23",
            "verseOrgIds": [
              "EXO.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ayasoboire kuleeta ekintu eky'efeeza rundi eky'omulinga, akakireeta yakihongera MUKAMA; kandi omuntu weena ow'akaba aina omuti omurungi ogw'omusisa, ogunyakusemeriire kukora omulimo, na uwe yaguleeta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.24",
            "verseOrgIds": [
              "EXO.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakazi boona abakaba bamanyire kukora kurungi emirimo y'engaro, baaruka ebintu byona ebi baasoboire, baabireeta, eby'erangi eya kaneke, kahukya n'erukugaajuka na kitaani enyakurukirwe kurungi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.25",
            "verseOrgIds": [
              "EXO.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakazi abakaba bamanyire muno kukora emirimo y'engaro abayegondiize, bakaranga obwoya bw'embuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.26",
            "verseOrgIds": [
              "EXO.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeebembezi b'abantu, baaleeta obubaale obw'erangi zimu obw'okuhundisa ekanzu, n'ekya ha kifuba; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.27",
            "verseOrgIds": [
              "EXO.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebiboya n'amagita ag'etaara n'aganyakuseeswaho abantu n'ebintu eby'okwezibwa, n'ag'okwongera kuboyesa kurungi eseeta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.28",
            "verseOrgIds": [
              "EXO.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaija n'abakazi boona Abaisirairi, abakaba baina omutima ogurukugonza kuhonga ekintu kyona eky'okukora omulimo ogu MUKAMA yaragiire Musa, agambire abantu bagukole, bakakireeta habw'okwegondeza baakihongera MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abafundi abaakomerwe okukora omulimo omu kiikaro ekirukwera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yagambira abantu ba Isirairi ati: “Hati, mumanye MUKAMA akomere Bezaleeri mutabani wa Hura, omwana wa Huuli ow'oruganda rwa Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga amwijwize mwoyo we, amuheeriire kimu okwetegereza n'okumanya kukora emirimo eya buli mulingo ey'engaro, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubaija ebintu omu zaabbu omu feeza n'omu mulinga; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "okubaija obubaale obw'okuhundisa, kubaija ebintu omu miti, n'okukora emirimo yoona ey'amagezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe na Oholiabu mutabani wa Ahisamaki ow'oruganda rwa Daani, abahaire amagezi ag'okutendeka abandi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaheeriire kimu amagezi ag'okukora omulimo ogwa buli mulingo ogunyakukorwa omuntu anyakumanyire muno eby'okusarura amabaale, eby'okuhunda, eby'okuruka engoye ez'ehuuzo y'erangi ya kaneke, kahukya n'ezirukugaajuka hamu n'eza kitaani enyakurukirwe n'ehuuzo enungi n'emirimo ey'omutenzi ow'ebintu ebisobora kukorwa omuntu anyakumanyire muno.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.35",
            "verseOrgIds": [
              "EXO.35.35"
            ]
          }
        }
      ]
    }
