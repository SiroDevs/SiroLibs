                "loc": "ACT.7.23+ACT.7.24+ACT.7.25+ACT.7.26+ACT.7.27+ACT.7.28"
              },
              "items": [
                {
                  "text": "Ebik 7:23-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.11",
            "verseOrgIds": [
              "EXO.2.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.24"
              },
              "items": [
                {
                  "text": "Baheb 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa obu yakuzire, kiro kimu, akagenda kubungira abantu ab'ihanga lye, yarora nkooku bali ha muhito; yarora Omunyamisiri naateera Omuhebburaayo, omu ha bantu ab'ihanga lye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.11",
            "verseOrgIds": [
              "EXO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamagamaga kunu n'oku, obu yaboine hataroho muntu n'omu, yaita Omunyamisiri, yamusereka omu musenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.12",
            "verseOrgIds": [
              "EXO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu yagarukireyo kiro kindi, yarora Abahebburaayo babiri nibarwana. Yakaguza omuntu ayakozire kubi ati: “Mutaahi wawe noomutura ki?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.13",
            "verseOrgIds": [
              "EXO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaija yamugarukamu ati: “Nooha ayakuhaire obusobozi obw'okutulema n'okutucwera emisango? Nooyenda kunyita nkooku waisire Omunyamisiri?” Nubwo Musa yatiina, yagamba ati: “Mazima kwo, ekintu eky'okwita omuntu, kimanyirwe boona”. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.14",
            "verseOrgIds": [
              "EXO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.29"
              },
              "items": [
                {
                  "text": "Ebik 7:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.27"
              },
              "items": [
                {
                  "text": "Baheb 11:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraaho obu yahuliire Musa nkooku aisire omuntu, yacwa amagezi ag'okumwita. Musa yairukaho Faraaho, yagenda kwikara omunsi Midiani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.15",
            "verseOrgIds": [
              "EXO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.15",
            "verseOrgIds": [
              "EXO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa obu akaba aikaliire haiziba rubaju, abaisiki musanju, bahara ba nyakatagara owa Midiani, baija kutaha amaizi, baijuze amaato, beesere amagana ga ise bo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.16",
            "verseOrgIds": [
              "EXO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaliisa abandi baija baababinga; baitu Musa yaimuka yabarwanirra, yabeseerra amagana gaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.17",
            "verseOrgIds": [
              "EXO.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu baataahire omu ka, isebo Rweri yabakaguza ati: “Leero hati, mwanguhire muta?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.18",
            "verseOrgIds": [
              "EXO.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamugarukamu bati: “Haroho Omunyamisiri anyakutujunire abaliisa, yatutahira amaizi, yatweseerra amagana gaitu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.19",
            "verseOrgIds": [
              "EXO.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakaguza bahara be ati: “Omusaija ogu ali nkaha? Kiki ekimubasigisizeyo? Mumwete aije alye ebyokulya.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.20",
            "verseOrgIds": [
              "EXO.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaikiriza kwikara n'omusaija ogu, kandi omusaija ogu, yamuha muhara we Zipora amuswere. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.21",
            "verseOrgIds": [
              "EXO.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zipora yazigaija omwana omwojo, Musa yamuruka ibara Geresomu; habwokuba akagamba ati: “Mbaire ndi munyaihanga omunsi etali y'owaitu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.22",
            "verseOrgIds": [
              "EXO.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu haahingwireho emyaka nyingi, omukama wa Misiri yafa. Abantu ba Isirairi baasinda muno nibasalizibwa obwiru. Baataaga, nibaserra ow'okubakoonyera. Habw'okusaalizibwa obwiru, okutaaga kwabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.23",
            "verseOrgIds": [
              "EXO.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.13"
              },
              "items": [
                {
                  "text": "Kub 15:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga yahurra okutaaga kwabo, yaijuka endagaano ei yaragaine na Abburahamu, Isaaka, na Yakobbo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.24",
            "verseOrgIds": [
              "EXO.2.24"
            ]
          }
        },
        {
          "name": "verse",
