          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ente kakuba ecumita omuntu, omusaija rundi omukazi, ekamwita, ente egi esemeriire eterwe amabaale, kandi enyama yayo ereke kuliibwa, baitu mukama w'ente taabege na musango. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.28",
            "verseOrgIds": [
              "EXO.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu ente egi, obu eraaba esangwa ecumita, eki mukama wayo bakakimugambira, baitu yalema kugirinda, obu eriita omuntu, abe musaija rundi mukazi, ente egi eterwe amabaale kandi mukama wayo, na uwe aitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.29",
            "verseOrgIds": [
              "EXO.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba acwerwa kuleha alehe kyona eki acwerirwe, baitu akize obwomeezi bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.30",
            "verseOrgIds": [
              "EXO.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ente egi kakuba ecumita, ekaita omwana w'omuntu ondi, omwojo rundi omwisiki, mukama w'ente egi afubirwe nkooku ekiragiro kirukuragira. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.31",
            "verseOrgIds": [
              "EXO.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba ente ecumita omwiru w'omuntu rundi omuzaana we, ekamwita, mukama wayo asemeriire kusasura mukama w'omwiru rundi mukama w'omuzaana, ebicweka by'efeeza makumi asatu, kandi ente eterwe amabaale.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
            ]
          }
        }
      ]
    },
