        },
        {
          "text": "Baitu obu aliba atamweserekeriire, bakarwana omu kurwana okwa butoosa akafa, akamugwaho habw'obutandwa, ka mbooleke ekiikaro eki asemeriire kwirukiramu akesereka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
