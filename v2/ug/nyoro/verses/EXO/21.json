              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu kakuba ateera omwiru we rundi omuzaana we, akamuteeza omwigo, omwiru rundi omuzaana akagwerekeera, asemeriire afubirwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
