          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "anyakwokeze ondi, na uwe bamwokye, anyakuhutaize ondi, na uwe ahutaazibwe, anyakutiire omuntu ekifufu, na uwe ateerwe ekifufu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.25",
            "verseOrgIds": [
              "EXO.21.25"
            ]
