          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaija kakuba barwana, omu hali bo akahuumira omukazi aina enda, enda ekarugamu, hateeyongiire kubaho akabi kandi, omusaija ayamuhuumiire asemeriire kuleha kyona iba omukazi eki araamucwera, baitu nasigikira nkooku abacwi b'emisango bacwire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba heeyongera kubaho akabi akandi, ekifubiro kirabaga ky'amaani; omwisi na uwe aitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
          }
        },
