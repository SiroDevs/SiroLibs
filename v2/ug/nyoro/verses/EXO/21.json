          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba ente y'omuntu ehutaaza ey'ondi, hanyuma ekafa, abantu abo bombi, batunde egi enyomeezi, omuhendo ogunyakugirugiremu, bagwinganize, kandi ente enyakufiire, bagibagane orusinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.35",
            "verseOrgIds": [
              "EXO.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ente egi, obu eraaba emanyirwe ngu esangwa ecumita ezindi, baitu mukama wayo yalema kugirinda, ente enyakufiire agirehemu ente endi, uwe atwale enyakufiire.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.36",
            "verseOrgIds": [
              "EXO.21.36"
            ]
          }
