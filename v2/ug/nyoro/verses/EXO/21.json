          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba omuntu aleka embiso eyesamiriire, rundi kakuba alima obuhya akabuleka atabuswekere, ente rundi enkaina y'omuntu ekagwa omu mbiso rundi omu buhya obu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukama w'embiso rundi ow'obuhya obu, alehere mukama w'ekisoro ekinyakufiire, uwe atwale omutumbi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        }
      ]
    },
