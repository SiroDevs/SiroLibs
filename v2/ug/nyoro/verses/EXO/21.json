          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omuntu kakuba aseesira mutaahi we kumwita omu bugobya, mumwihe omu itambiro lyange, agende aitwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
