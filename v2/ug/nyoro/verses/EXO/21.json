          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omwiru rundi omuzaana kakuba amaraho ekiro kimu rundi bibiri atakafiire, omuntu ogu tasemeriire kufubirwa, habwokuba akamuguza sente ze.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
