                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA Ruhanga yagambira Musa ati: “Gorra omukono gwawe, ogwoleke iguru, omwirima kasira guteere omunsi, abantu bahumahume.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.21",
            "verseOrgIds": [
              "EXO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
