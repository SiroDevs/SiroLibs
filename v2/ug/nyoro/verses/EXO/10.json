                "loc": "WIS.17.1+WIS.17.2+WIS.17.3+WIS.17.4+WIS.17.5+WIS.17.6+WIS.17.7+WIS.17.8+WIS.17.9+WIS.17.10+WIS.17.11+WIS.17.12+WIS.17.13+WIS.17.14+WIS.17.15+WIS.17.16+WIS.17.17+WIS.17.18+WIS.17.19+WIS.17.20+WIS.17.21"
              },
              "items": [
