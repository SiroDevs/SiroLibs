        "style": "s1"
      },
      "items": [
        {
          "text": "Omurangi Hananiya naaranga Ebisuba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
