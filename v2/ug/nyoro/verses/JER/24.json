      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oruganikyo rw'ebijuma eby'Emitini, ebirungi n'ebibi",
          "type": "text"
        }
      ]
    },
    {
