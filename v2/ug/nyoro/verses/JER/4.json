              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi ako, abantu ba Yerusaalemu nubwo baligambirwa ngu, “omuyaga ogurukwokya niguteera niguruga omwirungu, nigutwara nambere bali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.11",
            "verseOrgIds": [
              "JER.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
