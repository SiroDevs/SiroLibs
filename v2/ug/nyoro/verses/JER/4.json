            "number": "12",
            "style": "v",
            "sid": "JER 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuyaga ogu, tiguliba muyaga omurungi ogunyakuhuuhuura omusunga gwonka, omuyaga oguliragirwa MUKAMA, guliba gw'amaani okukira ogu. Omu kasumi ako, Nyowe nyenka ninyowe ndibacwera omusango.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.12",
            "verseOrgIds": [
              "JER.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremiya omurangi nasaalirirwa abantu be",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremiya nayolekwa okuhwerekerra okukaba nikwija kubaho",
          "type": "text"
        }
      ]
    }
