            }
          ]
        },
        {
          "text": "MUKAMA ow'amahe, Ruhanga owa Isirairi binu nibyo arukugambaho Mowabbu:",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
            "verseOrgIds": [
              "JER.48.1"
            ]
          }
        }
