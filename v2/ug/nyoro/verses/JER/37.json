        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremiya nibamuta omunkomo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
