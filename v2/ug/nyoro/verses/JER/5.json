        },
        {
          "text": "“MUKAMA naagamba ati, baitu omubiro ebi, nabwo tindibahwerekerereza kimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.18",
            "verseOrgIds": [
              "JER.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
