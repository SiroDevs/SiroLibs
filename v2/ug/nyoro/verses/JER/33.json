                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Habwokuba MUKAMA naagamba ati: “Ebiro n'ebiro, Daudi taliburwa omwijukuru ow'okwikarra ha kitebe eky'obukama eky'enju ya Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 33:18"
          },
          "items": [
