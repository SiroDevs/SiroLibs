              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8+NUM.3.9+NUM.3.10"
              },
              "items": [
                {
                  "text": "Kubar 3:5-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abanyakatagara Abaleevi, ebiro byona tibaliburwa mwijukuru ow'okwemerra omumaiso gange kuhonga ebihongwa eby'okwokya, n'okuntambiraga ebyonzira buli kiro.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
            "verseOrgIds": [
              "JER.33.18"
            ]
          }
        }
      ]
    },
