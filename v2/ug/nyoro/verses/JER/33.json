            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "halihulirwa amaraka ag'abagole abasaija n'abakazi, n'abo abanyakuleeta ebyonzira eby'okusiima omunju ya MUKAMA, balihulirwa nibazina bati “Musiime MUKAMA ow'Amahe, habwokuba MUKAMA murungi, habwokuba engonzi ze z'ebiro n'ebiro.” MUKAMA naakigumiza kimu ati, ensi enu ndigigarurra itungo lyayo, nkooku likaba liri kara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
