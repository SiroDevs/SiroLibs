        "style": "s1"
      },
      "items": [
        {
          "text": "Okwetwa n'okutumwa kwa Yeremiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
