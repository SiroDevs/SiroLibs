              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu yamazire kugambira Yobbu ebigambo ebi, akagambira Erifaazi Omutemaani ati: “Mbabiihiriirwe muno, iwe na banywani bawe ababiri; habwokuba timubalizeeho ebirungi omwiru wange Yobbu nkooku akozire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki nu, hati kwata enimi musanju, n'entaama empaya musanju, ogende mb'omwiru wange Yobbu mwehongerre ekihongwa eky'okwokya; omwiru wange Yobbu abasabire, habwokuba ninyija kuhurra eki arukunsaba, ndeke kubakora ebisemeriire obudoma bwanyu; habwokuba, mutambazeeho ebirungi, omwiru wange Yobbu mwehongerre ekihongwa eky'okwokya; omwiru wange Yobbu abasabire, habwokuba ninyija kuhurra eki arukunsaba, ndeke kubakora ebisemeriire obudoma bwanyu; habwokuba, mutambazeeho ebirungi, omwiru wange Yobbu nkooku yakozire.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho, Erifaazi Omutemaani, Biridaadi Omusuuhi, na Zofaali Omunamasi, baagenda, baakora MUKAMA eki yabagambiire; MUKAMA yaha Yobbu eki yamusabire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
