          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bintu ebi byona, Yobbu atasiise kandi atahyemere Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.22",
            "verseOrgIds": [
              "JOB.1.22"
            ]
          }
        }
      ]
    }
