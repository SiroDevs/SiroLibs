              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki Ekyahandiikirwe kikahikirizibwa ekirukugamba kiti: “Abburahamu akaikiriza Ruhanga, kandi eki kyamurugiramu obuhikiriire”; yayetwa nganjani ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.23",
            "verseOrgIds": [
