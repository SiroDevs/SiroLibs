              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo Ruhanga yabahweriiremu, emitima yabo ekeemaliza ha bubi, bakakora bonka na bonka ebihemura emibiri yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.24",
            "verseOrgIds": [
              "ROM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningira bakaleka amazima agarukumanyisa Ruhanga baatamu ebisuba, baaramya kandi baaheereza ebihangwa okukira Omuhangi, anyakuheebwa ekitiinisa ebiro byona! Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.25",
            "verseOrgIds": [
              "ROM.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
