          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habw'okwanga kwikiriza Ruhanga, nikyo nawe yabalekiire baikale n'omutima oguramaire n'engeso ez'obugwagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijura engeso embi zoona: obubi, okwegomba okubi, hamu n'itima. Baijwire ihali, obwisi, enkungani, obugobya, n'enobi. Baaba ngambigambi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "bahangirizi, abanoba Ruhanga, beereme, abeekuliriza, abenyumiza, abaserra obubi, abatahurra bazaire baabo, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "badoma, abateesigwa, abataganyira, n'abatagira mbabazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo noobu baraaba nibamanya ekiragiro kya Ruhanga ekigamba ngu, abakora ebintu nk'ebi basemeriire kufa, tibagarukira ha kubikora kwonka, baitu basagika n'abandi abarukubikora.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.32",
            "verseOrgIds": [
              "ROM.1.32"
            ]
          }
