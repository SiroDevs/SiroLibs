          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo Ruhanga yabalekiire balemwe okwegomba okurukuswaza. Bakazi baabo bakaleka emibiri yabo eki yahangiirwe, baagikoza eki etarahangiirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.26",
            "verseOrgIds": [
              "ROM.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaija nabo bakaleka kuteerana n'abakazi baatandika kwanjukiranganaho, nibakora ebikorwa eby'obuhemu n'abasaija bataahi baabo, baayereetera bonka ekifubiro ekisemeriire obugwagwa bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
