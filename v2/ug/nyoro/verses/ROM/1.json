        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
