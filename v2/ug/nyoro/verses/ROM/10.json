            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.19.4"
              },
              "items": [
                {
                  "text": "Zab 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leka nyowe nkaguze nti: Abaisirairi batahurre? Mazimakwo bakahurra, habwokuba kikahandiikwa kiti: “Iraka lyabo likahulirwa abantu boona, n'ebigambo byabu bikahika ha mitaano y'ensi.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
    },
