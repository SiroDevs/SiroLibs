                  "text": "Bir 32:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyongera kukaguza nti: Ihanga lya Isirairi litabyetegereze?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.19",
            "verseOrgIds": [
              "ROM.10.19"
            ]
          }
        }
