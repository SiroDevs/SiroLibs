              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.19"
              },
              "items": [
                {
                  "text": "Bir 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.17"
              },
              "items": [
                {
                  "text": "Kurug 20:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.21"
              },
              "items": [
                {
                  "text": "Bir 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Lev 19:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibyo Ebiragiro ebigamba biti: “Otalisiihana, otaliita, otaliiba, otalyegomba kubi” n'ebiragiro ebindi, byona bifunzibwa omu kigambo ekirukugamba kiti: “Ogonzeege mutaahi waawe nkooku oyegonza wenka.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyakwina egonzi takora kubi mutaahi we; nahabweki engonzi nizo ihikiriza Ebiragiro.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwikalege mweteekaniize",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwongera hali eki, mumanyire akasumi nkooku kali haihi kandi kahikiire kimu, inywe kusisiimuka omu turo; habwokuba okujunwa, hati kutwiriire haihi okukira nambere twabandize kwikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.11",
            "verseOrgIds": [
              "ROM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwire buli haihi kukya, n'izooba liri haihi kuturuka. Habweki, tuleke ebikorwa eby'omwirima, tukwate eby'okurwanisa omu musana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
              "ROM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukole kurungi nk'abali omu musana, tutarukurarraana omu magenyi kandi tutarukutamiira, tutarukusiihana n'okukora eby'obugwagwa, tutarukukungana n'okugirrangana ihali. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.13",
            "verseOrgIds": [
              "ROM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu MUKAMA Yesu Kristo nuwe mufoole ngabu yanyu, muleme emibiri yanyu, ereke kukora ebi erukwegomba.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.14",
            "verseOrgIds": [
              "ROM.13.14"
            ]
          }
        }
      ]
    }
