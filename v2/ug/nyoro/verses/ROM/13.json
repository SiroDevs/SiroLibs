                "loc": "EXO.20.14"
              },
              "items": [
                {
                  "text": "Kurug 20:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.18"
