          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embabazi za Ruhanga zikale na inywe inywena.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
