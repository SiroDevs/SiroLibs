            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu ndikutumira Aritemisi rundi Tikiko, okole kyona eki orukusobora okumpikaho bwango, onsange Nikopoli, habwokuba oku nuho ncwiremu kumara ebiro by'obutiti. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.24"
              },
              "items": [
                {
                  "text": "Ebik 18:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.12"
              },
              "items": [
                {
                  "text": "1Kor 16:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okole kyona eki orukusobora kuboherra Zeena Looya hamu n'Apolo omu rugendo rwabu. Ocwe goona batunge ebi barukwetaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baitu leka beege okukora ebikorwa ebirungi, nukwo batungise bagenzi baabu ebi barukwetaaga, baleke kwikara kwonka bataina mugaso.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        }
      ]
    },
