          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boona aba ndi nabo nibakuramukya. Na iwe oturamukize boona abanyakutugonza, abaturukuteerana nabo omu kwikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
              "TIT.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
