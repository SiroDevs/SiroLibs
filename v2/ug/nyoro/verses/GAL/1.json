                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inywe mukahurra eby'obwomeezi bwange obwabandize, nkyali omu diini ey'Ekiyudaaya: nkooku naahiiganiize muno ekitebe ky'abaikiriza Ruhanga, ninyekamba kukihwerekeeza. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 1:14"
          },
          "items": [
