                "loc": "ACT.22.3"
              },
              "items": [
                {
                  "text": "Ebik 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nkeeyongera muno omu diini ey'Ekiyudaaya, nakira baingi omu bantu ab'ihanga lyange aba nainganaga nabo emyaka, nkeekambira muno emirwa ey'abaisenkuru itwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
            "verseOrgIds": [
              "GAL.1.14"
            ]
          }
        },
        {
