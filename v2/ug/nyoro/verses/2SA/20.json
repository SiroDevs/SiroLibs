                "loc": "1KI.12.16"
              },
              "items": [
                {
                  "text": "1 Bakam 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.10.16"
              },
              "items": [
                {
                  "text": "2 Byok 10:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebi, omukiikaro eki, hakaba haliyo omusaija omubi ibara lye Seba mutabani wa Bikiri ow'oruganda rwa Bbenyamiini; akateera engwara naagamba ati: “Itwe titwine mugabo omu ruganda rwa Daudi, kandi titwina bugwetwa omu ruganda rwa mutabani wa Yese; inywe Abaisirairi, buli omu agaruke omu heema ye!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Abaisirairi boona baarugaho Daudi, baahondera Seba mutabani wa Bikiri: baitu abantu ab'oruganda rwa Yuda, bakagumiraho mukama wabo, baamuhondera okuruga Yorudaani okuhika Yerusaalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.22"
              },
              "items": [
                {
                  "text": "2 Sam 16:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi obuyataahire omukikaali kye Yerusaalemu, akakwata abakazi be abandi ikumi, abaakaba asigire barolerre enju ye, yabata omunju nuho balindirwe bali banyankomo, yabahaga byona ebibarukwetaaga, baitu tiyatembaga kitabu kyabo. Bakaikara omunkomo okuhika okufa kwabo bali nk'abafaakati, kandi kunu iba bo aikaire.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo omukama yagambiire Amasa ati: “Onsorooleze ab'oruganda rwa Yuda omumwanya gw'ebiro bisatu, na iwe obeho.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.4",
            "verseOrgIds": [
              "2SA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Amasa yagenda kweta ab'oruganda rwa Yuda; baitu akakeerererwa yahinguza akasumi akayahairwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.5",
            "verseOrgIds": [
              "2SA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akagambira Abisayi ati: “Seba mutabani wa Bikiri, naija kutukora kubi okukira Abusalomu; kwata abaheereza bange nyowe mukama wawe, omuhondere, ataikara kwetungira embuga ziri ezigumire kandi akatuleetera akabi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabbu, Abakeresi, Abapaasa, n'abasaija boona ab'amaani, baahondera Abisayi; bakaruga Yerusaalemu bahondera Seba mutabani wa Bikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.7",
            "verseOrgIds": [
              "2SA.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obubaahikire ha ibaale erikooto erinyakuli Gibbyoni, Amasa yaija kubatangirra. Yowabbu akaba ajwaire ekijwaro eky'omuserikale, haruguru yakyo haroho orukoba n'empirima eri omukiraaro kyaayo, agyeteegere omunda, obwakaba naagenda omumaiso, empirima yaruga omukiraaro yagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.8",
            "verseOrgIds": [
              "2SA.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabbu yaramukya Amasa ati: “Mwana wa Mau, mirembe?” Yowabbu yakwata Amasa omuleju n'omukono gwe ogw'obulyo, amugwe omunda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.9",
            "verseOrgIds": [
              "2SA.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu Amasa atarole mpirima Yowabbu eyakaba akwasire; Yowabbu yatimba Amasa empirima, amara gaabooga haitaka, obwakaba atakamutimbire obwa kabiri, yafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Yowabbu na Abisayi owanyina nubwo baahondiire Seba mutabani wa Bikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu ha basaija ba Yowabbu, yayemerra haihi na Amasa yamugambira ati: “Weena arukugonza Yowabbu, kandi weena anyakuli harubaju rwa Daudi, akurate Yowabbu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.11",
            "verseOrgIds": [
              "2SA.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasa, omutumbi gwe gwona gwijwire esagama, gukaba guli omuruguudo. Weena ayabaga naarabaho obuyamuroraga, yayemerraga; omusaija wa Yowabbu yarora buli muntu nkooku arukwemerra, nukwo kwiha Amasa omuruguudo yamugarra omukisaka, yamusweka orugoye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.12",
            "verseOrgIds": [
              "2SA.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasa obuyamazire kwihwa omuruguudo, abantu boona baakurata Yowabbu, baahondera Seba mutabani wa Bikiri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seba akarabamu enganda za Isirairi zoona, yahika Abberi eya Beesi-maaka; Abaabikiri boona baayesorooza baamukuraatira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.14",
            "verseOrgIds": [
              "2SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaija boona abakaba baina Yowabbu, bakaija baamugotera omurubuga Abberi orwa Beesi-maaka; baatuuma entuumo y'itaka okwehinguliriza orubuga, yatuuma okwingana ekisiika; baatandika kuteera orubuga baruseese. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.15",
            "verseOrgIds": [
              "2SA.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakabaho omukazi omunyamagezi, ayayesire naayema omurubuga, yagamba ati: “Muhurre, muhurre!” Mugambire Yowabbu muti: “Oirre hanu nkugambire.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.16",
            "verseOrgIds": [
              "2SA.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabbu yairirra omukazi ogu, omukazi yakaguza Yowabbu ati: “Niiwe Yowabbu?” Yowabbu yagarukamu ati: “Ninyowe.” Omukazi yagambira Yowabbu ati: “Ohurre nyowe omuzaana wawe ebindukukugambira.” Yowabbu yagarukamu omukazi ati: “Ntegere okutu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi yagamba ati: “Omubiro ebya ira, abantu baagambaga ngu: ‘Mugende mwekaguze hali Abberi’; nukwo baamaraga bati ebigambo byabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.18",
            "verseOrgIds": [
              "2SA.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyowe omu hali abo abaina obusinge, kandi abeesigwa omu Isirairi; nooyenda kuhwerekereza orubuga oruzaara Isirairi yoona; kiki ekyorukwendera kuhwerekereza ebintu bya MUKAMA?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabbu yagarukamu ati: “Nikikafuuhe, nikikafuuhe, nyowe kukora ekintu nkeeki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki tikiri ky'amazima. Baitu omusaija ow'omunsi ey'ensozi eya Efuraimu, ibara lye Seba mutabani wa Bikiri, ayemiire omukama Daudi; omusaija ogu wenka nuwe muheyo, nyowe nukwo nduge omurubuga.” Omukazi yagambira Yowabbu ati: “Omutwe gwe nitwija kugurabya hakisiika eruguru, tugukunagire.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi yahikaho abantu boona yababaliza n'amagezi, nukwo kutemaho Seba mutabani wa Bikiri omutwe, baagunagira Yowabbu. Yowabbu yateera engwara, abasaija boona baaruga omurubuga, buli omu yatoma ogw'owaabo. Yowabbu yagaruka Yerusaalemu omw'omukama.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukasumi ako, Yowabbu nuwe akaba ali ngabwa y'ihe ryona erya Isirairi; Benaaya mutabani wa Yehoyaada, uwe akaba ali ngabwa y'Abakeresi n'Abapaasa; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
