      },
      "items": [
        {
          "text": "Obukwenda bwa Nasani n'okwegarukamu kwa Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
