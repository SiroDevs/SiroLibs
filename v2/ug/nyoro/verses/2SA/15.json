{
  "id": "2SA.15",
  "number": "15",
  "bookId": "2SA",
  "reference": "2 Sam 15",
  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
