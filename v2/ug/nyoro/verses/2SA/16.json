              },
              "items": [
                {
                  "text": "2 Sam 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.9.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi obwakaba ahingwireho kake akatwetwe k'orusozi, yaitirana Ziba omuheereza wa Mefibboseesi, aina endogoyi ibiri zitekaniziibwe, zeetwekere emigaati bikumi bibiri, emigimba kikumi ey'ebijuma by'emizabbibbu, emigimba kikumi ey'ebijuma eby'omu kyanda, n'endyanga ey'amaarwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.1",
            "verseOrgIds": [
              "2SA.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo omukama yakaguza Ziba ati: “Binu obireetiire ki?” Ziba yagarukamu ati: “Endogoyi z'okutembwa abantu ab'enju y'omukama, emigaati n'ebijuma by'okulibwa abantu be, amaarwa g'abo abarukwitwa ensazi omwirungu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.25+2SA.19.26+2SA.19.27"
              },
              "items": [
                {
                  "text": "2 Sam 19:25-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama yakaguza ati: “Kandi mutabani wa mukama wawe araha?” Ziba yagarukamu omukama ati: “Ali Yerusaalemu, habwokuba naagumiza kimu, Abaisirairi nkooku barukwija kumugarra ha bukama bwa Saulo isenkuru.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo omukama yagambiire Ziba ati: “Byona ebikaba biri bya Mefibboseesi, hati byawe.” Ziba yagamba ati: “Iwe mukama wange omukama, ninkutamu ekitiinisa. Akasumi koona ongirrege embabazi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.4",
            "verseOrgIds": [
              "2SA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.4",
            "verseOrgIds": [
              "2SA.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi obuyahikire Bahulimu, hakaija omusaija ow'oruganda rw'enju ya Saulo, ibara lye nuwe Simeyi mutabani wa Gera; obwakaba naija, yakondereza Daudi obutalekerra. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.5",
            "verseOrgIds": [
              "2SA.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamuhungurra amabaale, yagahungurra abaheereza be, abantu boona, n'abasaija boona ab'amaani abakaba bamuli ha mukono ogw'obulyo n'ogw'emoso. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.6",
            "verseOrgIds": [
              "2SA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simeyi obuyabaga nakondereza yagambaga ati: “Rugaho aho, rugaho aho, iwe omwisi, iwe ataina mugaso. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.7",
            "verseOrgIds": [
              "2SA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akuhoire enzigu ey'esagama yoona ey'enju ya Saulo, ou waihireho obukama bwe, obukama obu, hati MUKAMA abuhaire mutabani wawe Abusalomu. Leero nu, okuhwerekerra kukuhikireho; habwokuba oli museesi w'esagama.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.8",
            "verseOrgIds": [
              "2SA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.8",
            "verseOrgIds": [
              "2SA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Abisayi mutabani wa Zeruya yakaguza omukama ati: “Osobora ota kwikiriza embwa enu eyafiire ira kukondereza iwe mukama wange omukama? Nyikiriza ngende mmucweho omutwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.9",
            "verseOrgIds": [
              "2SA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omukama yagamba ati: “Nyowe na inywe batabani ba Zeruya, twina bukwatane ki? Obwaraaba nankondereza, habwokuba MUKAMA amuragiire ati: ‘Kondereza Daudi’, kandi n'oha araamukaguza ngu: ‘Kiki ekirukukukoza kiti?’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.10",
            "verseOrgIds": [
              "2SA.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yagambira Abisayi n'abaheereza be boona ati: “Mutabani wange wonyini obwaraaba naayenda kunyita; kandi leero ow'oruganda rwa Bbenyamiini araasura ki mumuleke akondereze; habwokuba MUKAMA nuwe amuragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.11",
            "verseOrgIds": [
              "2SA.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rundi MUKAMA alirora okusaalizibwa kwange kunu, angarurre ebirungi habw'okukonderezibwa kunu okw'ekiro kya hati.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.12",
            "verseOrgIds": [
              "2SA.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi n'abasaija be baakwata omuhanda baagenda, Simeyi yabahondera ali harubaju rw'orusozi omumaiso ga Daudi, naamukondereza, naamuhungurra amabaale, naamumiisira ecuucu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.13",
            "verseOrgIds": [
              "2SA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama n'abantu be boona abaakaba ainabo, bakahika Yorudaani bajwahire, aho nuho omukama yaruhuukiire.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.14",
            "verseOrgIds": [
              "2SA.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.14",
            "verseOrgIds": [
              "2SA.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukasumi ako, Abusalomu n'abantu ba Isirairi boona baahika Yerusaalemu, na Ahisofeeri abarumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.15",
            "verseOrgIds": [
              "2SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Husayi Omunyaruki munywani wa Daudi obuyahikireho Abusalomu, yamuramya ati: “Hangiriza Agutamba! Hangiriza Agutumba!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.16",
            "verseOrgIds": [
              "2SA.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu yakaguza Husayi ati: “Obu nubwo obwesige obwonyina hali munywani wawe Daudi? Kiki ekikutangire kugenda na uwe?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.17",
            "verseOrgIds": [
              "2SA.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Husayi yagarukamu Abusalomu ati: “Nangwa; habwokuba ogu, mukama, n'abantu Abaisirairi boona ou bakomere, nuwe ndiba nawe, kandi nuwe ndiikara na uwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.18",
            "verseOrgIds": [
              "2SA.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ekindi, nsemeriire kuheereza oha? Tinsemeriire kuheereza mutabani we? Nkooku naheeriize Sso, na iwe nukwo ndukwija kukuhereza.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
            "verseOrgIds": [
              "2SA.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
            "verseOrgIds": [
              "2SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Abusalomu yagambiire Ahisofeeri ati: “Hati banza otuhabule, tukole ki?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.20",
            "verseOrgIds": [
              "2SA.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahisofeeri yagarukamu Abusalomu ati: “Genda otembe ekitabu kya bakaaso, abayasigire kulinda enju; Abaisirairi boona nubwo baraamanya nkooku oyenobeseze Sso, abo boona abanyakuli harubaju rwawe nibaija kweyongera amaani.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.21",
            "verseOrgIds": [
              "2SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.11"
              },
              "items": [
                {
                  "text": "2 Sam 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo baateeriire Abusalomu eheema harusu, Abusalomu yabyama n'abaranga baise, Abaisirairi boona bali aho. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.22",
            "verseOrgIds": [
              "2SA.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukasumi ako, ekigambo Ahisofeeri ekiyagambaga, kyaikirizibwa nk'ekinyakugambirwe Ruhanga; habweki kyona Ahisofeeri ekiyagambaga, Daudi n'Abusalomu, boombi nikyo baahonderaga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.23",
            "verseOrgIds": [
              "2SA.16.23"
            ]
          }
        }
      ]
    }
  ],
