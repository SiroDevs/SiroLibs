          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.40",
            "verseOrgIds": [
              "2SA.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2SA 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Abaisirairi boona baahikireho omukama, baamukaguza bati: “Bagenzi baitu ab'oruganda rwa Yuda bakwibiire ki kukutwara hara, kukutwara neeka yawe, n'abantu bawe bakakwambura Yorudaani.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.41",
            "verseOrgIds": [
              "2SA.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2SA 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Yuda baagarukamu Abaisirairi bati: “Habwokuba omukama w'oruganda rwaitu orwa haihi. Eki kikubiihiriize ki? Omukama nuwe atuguliire ebituliire? Rundi aina ekisembo ekyatuhaire?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.42",
            "verseOrgIds": [
              "2SA.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2SA 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisirairi baagarukamu ab'oruganda rwa Yuda bati: “Omukama tumwinamu emigabo ikumi, kandi Daudi tumwinaho bingi okukira inywe. Mukatugayira ki? Tibali niitwe twabandize kubaza ha kigambo eky'okugarra omukama?” Baitu abantu ab'oruganda rwa Yuda, bakakwatwa ekiniga okukira eky'Abaisirairi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.43",
            "verseOrgIds": [
              "2SA.19.43"
            ]
          }
        }
      ]
    }
