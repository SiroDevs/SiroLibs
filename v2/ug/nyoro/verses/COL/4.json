            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epafura ow'owaanyu, omuheereza wa Kristo Yesu, naabaramukya. Obutoosa abaijuka n'omutima gumu omu kusaba kwe, nukwo musobole kwemerra mugumire, mweheriireyo kimu okukora byona Ruhanga ebi agonza. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
