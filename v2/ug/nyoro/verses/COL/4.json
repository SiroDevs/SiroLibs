              "type": "text"
            }
          ]
        },
        {
          "text": "Mundamukize ab'oruganda abali Layodikeeya. Mundamukize Nimfa, n'ekitebe ky'abaikiriza ab'omu nju ye. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.15",
            "verseOrgIds": [
