              "type": "text"
            }
          ]
        },
        {
          "text": "Muteererre Arakiipo muti: “Oyekambe okuhikiriza obuheereza MUKAMA obu yakuhaire.” ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.17",
