            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe bakama b'abairu, abairu banyu mubakorre eby'obwinganiza kandi ebihikire, nimumanya na inywe nkooku mwina MUKAMA omwiguru.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.1",
            "verseOrgIds": [
              "COL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naabahabura kugira engeso nungi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
