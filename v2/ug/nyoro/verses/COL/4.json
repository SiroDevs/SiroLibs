          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi kaiso arukugumya nkooku yabakoliire n'amaani, inywe hamu n'abo abali Layodikeeya n'abali Hieraapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
