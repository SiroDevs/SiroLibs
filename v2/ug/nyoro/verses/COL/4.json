          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "WIS.8.12"
              },
              "items": [
                {
                  "text": "Ama 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutoosa ebigambo byanyu bibege birungi, binurrege abandi nk'ebirungirwemu ekisura, nukwo musobole kumanya eki musemeriire kugarukamu buli omu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
