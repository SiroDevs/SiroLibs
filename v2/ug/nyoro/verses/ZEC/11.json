            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA Ruhanga wange akangambira ati: “Obe muliisa w'entaama ezirukwija kwitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.4",
            "verseOrgIds": [
              "ZEC.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abanyakuzigura, baziita, beegendera batafubiirwe; kandi abanyakuziguza, bagamba bati, ‘MUKAMA asiimwe, nyowe natunga’; bakama baazo boonyini, tibarukwigirra mbabazi ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.5",
            "verseOrgIds": [
              "ZEC.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati, tindigaruka kuganyira abasi b'ensi enu. Buli muntu ndimuleka alemwe omuliisa we n'omukama we; abaliisa n'abakama abo, balicanza ensi baitu tihalibaho muntu n'omu ou ndijuna nkamubaihaho.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.6",
            "verseOrgIds": [
              "ZEC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.6",
            "verseOrgIds": [
              "ZEC.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki nafooka muliisa w'igana erikaba liri ly'okwitwa nindiisiza abo abaaguraga kandi abaaguzaaga entaama. Nakwata emiigo ebiri; ogumu naguruka ibara Mbabazi ogundi nagweta Obumu. Naliisa entaama. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.7",
            "verseOrgIds": [
              "ZEC.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kwezi kumu abaliisa bali abasatu nkabahwerekereza. Baitu natandika kunoba entaama, nazo zantamwa nkooku nainobere. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.8",
            "verseOrgIds": [
              "ZEC.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma nagambira entaama nti, “Tinkyayongera kubaliisa, entaama ezirukwenda kufa, ka zife; ezirukwenda kuhwerekerra, ka zihwerekerre; kandi ezi eziraasigaraho ka ziryangane!” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.9",
            "verseOrgIds": [
              "ZEC.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo nakwasire omwigo gwange ogurukwetwa “Mbabazi” nagucwamu habiri nukwo ncwe endagaano ei nkaba nkozire n'amahanga goona. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.10",
            "verseOrgIds": [
              "ZEC.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki endagaano eki yacweriirweho abasuubuzi abakaba bandoleriire, nubwo baayetegeriize, eki nkooku kiri kigambo kya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.11",
            "verseOrgIds": [
              "ZEC.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
