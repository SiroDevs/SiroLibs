                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.38"
              },
              "items": [
                {
                  "text": "Yoh 7:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Kus 22:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro eki obukirihika, amaizi amarungi galiruga Yerusaalemu, ekicweka kyago kirigenda omu nyanja eya Burugaizooba, ekicweka ekindi omu ya Bugwaizooba, galiikara nigagera omu kasumi ak'ekyanda n'aky'irumbi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu, MUKAMA aliba mukama ow'ensi yoona; ha kiro eki, aliba omu, n'ibara lye liriba limu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga Geba okugarukira Rrimoni amasirimuka ga Yerusaalemu, ensi yoona erifooka kyeya. Baitu okuruga ha irembo erya Benyamiini okugarukira hakiikaro eky'irembo erikuru, okugarukira ha irembo ery'omu kasonda, n'okuruga ha munaara gwa Hananeeri okugarukira handeeba ezijungirwaho amarwa g'omukama, Yerusaalemu ruliikara ruli haiguru omu kibanja kyarwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.10",
            "verseOrgIds": [
              "ZEC.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.3"
              },
              "items": [
                {
                  "text": "Kus 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruliikarwamu abantu, habwokuba haliba hatakyaroho mukyeno; ruliikara rugwagwaine.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanu nuko akabi, MUKAMA akaalireetera amahanga goona agalirwanisa Yerusaalemu: abantu balijunda bakyali boomeezi; amaiso galibajundira omunteeko yago, n'endimi ziribajundira omu kanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.12",
            "verseOrgIds": [
              "ZEC.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki, MUKAMA alibatiinisa muno; buli muntu akwate omutaahiwe omukono, bateerangane; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.13",
            "verseOrgIds": [
              "ZEC.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nobwakubaire Yuda, erirwanisa Yerusaalemu. Obuguuda obw'amahanga goona agaherraine bulisoroozebwa, ezaabbu, efeeza n'eby'okujwara omu bwingi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabi nkaako, kalihikaho embaraasi, enyumbu, engamiya, endogoyi na ha buli kisoro kyoona ekirisangwa omu nsiisira ezi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
            "verseOrgIds": [
              "ZEC.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
