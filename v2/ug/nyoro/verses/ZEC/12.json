            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Enju ya Daudi n'abasi ba Yerusaalemu, ndibatamu omwoyo ogw'embabazi n'ogw'okwesengereza, obu baraaroraga omuntu ou bacumisire, baraamulirirraga, nkomuntu ayazaire omwana omu wenka nkooku amulirirra, omuntu nkooku aterra ekyoboobo omwana we omuzigaijo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki, empamo eziriba Yerusaalemu, ziriingana ezi baateeriire Hadadi-rimooni, omu kyeya kya Megido. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi yoona eritamu ekyoboobo, buli ruganda rwonka, oruganda orw'enju ya Daudi rwonka; abakazi abaswerwa bonka; oruganda orw'enju ya Nasani rwonka; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "oruganda orw'enju ya Levi rwonka, n'abakazi baabo bonka; oruganda orw'enju ya Simeyi rwonka, n'abakazi baabo bonka; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'enganda zoona ezindi ezisigaireho nukwo ziti, buli ruganda rwonka, n'abakazi baabo bonka.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
