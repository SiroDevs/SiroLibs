              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo baasorooramu embuga: Kedesi orunyakuli Galiraaya omunsi ey'ensozi eya Nafutaali, Sekemu, omunsi ey'ensozi eya Efuraimu, Kiryasi-araba (nurwo Hebburoni) omunsi ey'ensozi eya Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nseeri y'ekyambu Yorudaani Buturukaizooba bwa Yeriko, bakakomayo Bezeri orunyakuli omwirungu, ensi enyakuterekeriire, rukaihwa omunsi ey'oruganda rwa Rubbeni; Ramoosi orwa Giryadi, omunsi ey'oruganda rwa Gaadi, kandi baakoma Gorani orunyakuli Basani, oru rukaruga omu ruganda rwa Manaase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezi nizo embuga ezaakomiirwe abantu ba Isirairi n'omusuuhuuki ayaikaraga nabo nukwo weena ayaitaga omuntu atagenderiire, aleke kwitwa omuhoozi w'enzigu okuhikya obuyakeemerraga kucwerwa omusango omumaiso g'ekitebe ky'abantu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
