          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa yayeyongera omumaiso hamu n'Abaisirairi boona kuruga Libuna baagenda Lakisi, orubuga yarugota yaruseesira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA, orubuga Lakisi, narwo yarubaha kurusingura, Yoswa yaruhamba ha kiro ekya kabiri, yaruseesa, boona abakaba barumu yabaita n'empirima nkooku yakozire Libuna.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
