        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi koona aka Yoswa, naha bw'akabakuru abaayomiire kumukira, kandi abakaba bamanyire byona MUKAMA ebiyakoliire Isirairi, Abaisirairi bakaheereza Mukama.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
