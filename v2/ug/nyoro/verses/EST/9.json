          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiragiro ky'omugo Esiteeri nikyo kyagumize okukuzaaga ebiro ebi ebya Pulimu, ekiragiro eki kyahandiikwa omu kitabu. Obukuru bwa Aswero na Morodekayi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.32",
