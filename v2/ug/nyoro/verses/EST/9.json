          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro ebi, biijukwege kandi bikuzibwege abantu boona, ab'obusinge obuliija, aba buli nju, aba buli isaza kandi aba buli mbuga, kandi ngu Abayudaaya, ebiro binu ebya Pulimu, batalibidibya, kandi n'abaijukuru baabo, batalirekerra kubiijuka.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        }
      ]
