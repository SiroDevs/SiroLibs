                "loc": "SIR.48.10"
              },
              "items": [
                {
                  "text": "Sir 48:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ninyowe MUKAMA, kandi timpinduka. Habweki inywe abaijukuru ba Yakobbo, timukahwerekeriire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.6",
            "verseOrgIds": [
              "MAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga omu businge bwa ba isiinywe, mukarugaho ebiragiro byange, mwayanga kubikwata. MUKAMA ow'amahe naagamba ati, mugaruke nambere ndi, na nyowe nukwo nyije nambere muli. Baitu nimwekaguza muti ‘Turaagarukayo tuta?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbakaguza, kihikire omuntu kunyaga Ruhanga? ‘Tikihikire naakake, baitu inywe nimmunyaga. Baitu nimwekaguza muti nitukunyaga tuta?’ Nimunyagira omu ndoborwa n'omu bihongwa byanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muli bakyenwa, habwokuba nimmunyaga, ihanga lyanyu lyona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.9",
            "verseOrgIds": [
              "MAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
