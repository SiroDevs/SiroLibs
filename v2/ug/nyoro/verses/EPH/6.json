          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.1"
              },
              "items": [
                {
                  "text": "Bak 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Bir 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.25"
              },
              "items": [
                {
                  "text": "Bak 3:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inywe bakama b'abairu nukwo mubakole muti, muleke kubakanga, mumanye ngu, MUKAMA waabo kandi owaanyu ali omwiguru kandi tasoroora.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwejunisa eby'okurwanisa ebya Ruhanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eky'okumalirra mube b'amaani omu MUKAMA, nimugumibwa obusobozi obw'amaani ge. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.10",
            "verseOrgIds": [
              "EPH.6.10"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.10",
            "verseOrgIds": [
              "EPH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "WIS.5.17"
              },
              "items": [
                {
                  "text": "Ama 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujwale eby'okurwanisa byona ebya Ruhanga, nukwo musobole kwemera obugobya bwa Sitaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.11",
            "verseOrgIds": [
              "EPH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itwe titurukurwanisa abantu abaina omubiri n'esagama, baitu niturwanisa amahe ag'emyoyo emibi agali omu biikaro ebya ha iguru, emyoyo ey'abakuru, ey'ab'obusobozi, n'ey'abarukulema ensi enu ey'omwirima. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.12",
            "verseOrgIds": [
              "EPH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki mukwate eby'okurwanisa byona ebya Ruhanga, nukwo musobole kwemera ebiribaho ha kiro ekibi, kandi obu mulimara kukora byona, mwemerre mugumire. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.13",
            "verseOrgIds": [
              "EPH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "WIS.5.18+WIS.5.19+WIS.5.20+WIS.5.21+WIS.5.22+WIS.5.23"
              },
              "items": [
                {
                  "text": "Ama 5:18-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.5"
              },
              "items": [
                {
                  "text": "Is 11:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.17"
              },
              "items": [
                {
                  "text": "Is 59:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki, mwemerre mwetegere amazima omu nda, kandi mujwaire ha kifuba obuhikiriire nk'ekizibaho ky'ekyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.14",
            "verseOrgIds": [
              "EPH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.7"
              },
              "items": [
                {
                  "text": "Is 52:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujwale enkaito omu bigere byanyu, mweteekaniize okurangirra Amakuru Amarungi ag'obusinge. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.15",
            "verseOrgIds": [
              "EPH.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okukira byona, mukwate engabu y'okwikiriza ei musobora kuzimisa emyambi yoona ey'Omubi erukwaka omurro. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.16",
            "verseOrgIds": [
              "EPH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.17"
              },
              "items": [
                {
                  "text": "Is 59:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujwale enkofiira ey'ekyoma ey'okujunwa, kandi mukwate n'empirima eya Mwoyo Ahikiriire, nikyo kigambo kya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.17",
            "verseOrgIds": [
              "EPH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutoosa musabege nimwesengereza Ruhanga okubakoonyera, kandi nimusabira omu Mwoyo Ahikiriire. Eki mukikolege obutalekerra, nimusabira abaikiriza boona, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.18",
            "verseOrgIds": [
              "EPH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi na nyowe munsabirege, nukwo ntunge ebi ndaagamba obu ndaabaga nindangirra n'obumanzi ensita ey'Amakuru Amarungi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.19",
