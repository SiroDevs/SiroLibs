    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naabateererra kuba b'omwoyo gumu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, nyowe omunyankomo habwa MUKAMA, nimbeesengereza: mube n'engeso ezinyakusemeriire omulimo ogu mwayetiirwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.1",
            "verseOrgIds": [
              "EPH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.12"
              },
              "items": [
                {
                  "text": "Bak 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimwebundaaza muno kandi nimuculeera, nimugumiisiriza kandi nimuganyirangana habw'engonzi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.2",
            "verseOrgIds": [
              "EPH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimutaho omutima kugumya obumu bwa Myoyo Ahikiriire anyakututeeraniza omu businge. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.3",
            "verseOrgIds": [
              "EPH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haroho omubiri gumu na Mwoyo omu, nkooku mwina okunihira kumu oku mwayetiirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.4",
            "verseOrgIds": [
              "EPH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA ali omu, enyikiriza eri emu, okubatiza kumu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.5",
            "verseOrgIds": [
              "EPH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga nuwe omu kandi Ise boona, anyakukira boona, anyakukora omu boona kandi anyakuli omu boona.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.6",
            "verseOrgIds": [
              "EPH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.6",
            "verseOrgIds": [
              "EPH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu buli omu omuli itwe akaheebwa ebisembo nkooku Kristo omu mbabazi ze yamulengiire. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.7",
            "verseOrgIds": [
              "EPH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.68.18"
              },
              "items": [
                {
                  "text": "Zab 68:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo kyagambiirwe kiti:",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.8",
            "verseOrgIds": [
              "EPH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwomeezi obuhyaka omu Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.16",
            "verseOrgIds": [
              "EPH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati kinu ninkigamba kandi ninkigumya omu MUKAMA nti: Mutongera kwikara nk'Abanyamahanga oku baikara, omu biteekerezo byabu ebitaina mugaso. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.17",
            "verseOrgIds": [
              "EPH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagezi gaabu gaswekeriirwe omwirima kandi baahukaniziibwe ha bwoomeezi bwa Ruhanga habw'obutamanya obu bainabwo, obunyakuruga omu kugumangana kw'emitima yabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.18",
            "verseOrgIds": [
              "EPH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakagumangana baayeheera kimu obusiihani, nibeegomba kukora ekibi kya buli mulingo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.19",
            "verseOrgIds": [
              "EPH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe, Kristo mutamwege muti, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.20",
            "verseOrgIds": [
              "EPH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "rundi buli mukalemwa kumwetegereza kurungi obu mwayegesiibwe amazima agali omu Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.21",
            "verseOrgIds": [
              "EPH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.9"
              },
              "items": [
                {
                  "text": "Bak 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mucwe engeso zanyu eza ira ezi mwinazo ezisiisirwe okwegomba okubi okurukuhabisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.22",
            "verseOrgIds": [
              "EPH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mufooke bahyaka omu biteekerezo byanyu n'omu mitima yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.23",
            "verseOrgIds": [
              "EPH.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.10"
              },
              "items": [
                {
                  "text": "Bak 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26"
              },
              "items": [
                {
                  "text": "Kub 1:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "WIS.9.3"
              },
              "items": [
                {
                  "text": "Ama 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mube n'obwomeezi obuhyaka Ruhanga obu arukubahangamu oburukuzookwamu obuhikiriire obw'amazima n'oburukwera.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EPH 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.16"
              },
              "items": [
                {
                  "text": "Zek 8:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki mufuuhize kimu ebisuba, buli muntu abazeega amazima na mutaahi we, habwokuba tuli bicweka by'omubiri gumu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.4.4"
              },
              "items": [
                {
                  "text": "Zab 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba mukwatwa ekiniga, nwerinde mutaasiisa; mutalinaga izooba mukyaina ekiniga. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.26",
            "verseOrgIds": [
              "EPH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muteeretereza Sitaani mukamuha omwanya ogw'okuboohya. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.27",
            "verseOrgIds": [
              "EPH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusuma alekere aho kwiba. Haakire akozese emikono ye emirimo y'omugaso, nukwo asobole n'okugabira abaseege. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.28",
            "verseOrgIds": [
              "EPH.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kyona ekibi kitaliruga omu kanwa kanyu. Mubazeege ebirungi byonka ebirukwombeka n'ebirukuhikaana n'ekintu eki muroho, nukwo kireetere omugisa abo abakihurra. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.29",
            "verseOrgIds": [
              "EPH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EPH 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muleke kurumya Mwoyo Ahikiriire wa Ruhanga, habwokuba nuwe manyikirizo ei mwatairweho kwoleka nkooku muli ba Ruhanga okuhika ha kiro ky'okucungurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.30",
            "verseOrgIds": [
              "EPH.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EPH 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunyanzigwa bwona, ekiniga, okubiihirwa, obwogo, okuhangirra n'itima lyona bibarugiremu kimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.31",
            "verseOrgIds": [
              "EPH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EPH 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.13"
              },
              "items": [
                {
                  "text": "Bak 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugirranganege embabazi, mube benda, muganyiranganege nkooku Ruhanga yabaganyiriire omu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.32",
            "verseOrgIds": [
              "EPH.4.32"
            ]
          }
        }
      ]
    }
  ],
