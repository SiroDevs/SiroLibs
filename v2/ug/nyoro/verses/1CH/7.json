        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oruzaaro rwa Isakaara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Runu nurwo oruzaaro rwa Isakaara: Toola, Puwa, Yasubu na Simirooni, boona hamu bbana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Toola: Uzi, Refaaya, Yeryeri, Yahumayi, Ibusaamu na Semweri, nubo bakaba bali bakuru omu maju ga baisebo, nubo Abatoola, abarwani ab'amaani abaabaireho omu businge bwabo, omu businge obw'engoma ya Daudi, baahikaga obukumi bubiri, enkumi ibiri n'orukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzi akazaara omwana omwojo omu, ibara lye Izurahiya. Kandi banu nubo batabani ba Izurahiya: Mikairi, Obadiya, Yoweri na Isiya, boona hamu bataano, boona bakaba bali bantu bakuru, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "obuzaale bwabo nkooku bukuratana, amaju ga baisebo nkooku gakaba gali, bakaba baina ebihanda eby'ihe ery'okugenda ha bulemu erirukuhika obukumi busatu n'akakaaga, habwokuba bakaba baswiire abakazi baingi, kandi bazaire abaana aboojo baingi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.4",
            "verseOrgIds": [
              "1CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beene baabo ab'ebitabu byona ebya Isakaara, bakaba nibahika obukumi munaana n'akasanju, abarwani ab'amaani, abaakahandiikirwe, obuzaale bwabu nkooku bukaba nibukuratana.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.5",
            "verseOrgIds": [
              "1CH.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oruzaaro rwa Benyamiini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.5",
            "verseOrgIds": [
              "1CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Runu nurwo oruzaaro rwa Benyamiini: Beera, Bbekeri na Yedyeri, boona hamu basatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Beera: Ezibooni, Uzi, Uzyeri, Yerimoosi na Iri, boona hamu bataano, bakaba bali bakuru omu maju ga baisebo, barwani b'amaani; kandi omuhendo gwabu ogwahandiikirwe, obuzaale bwabu nkooku bwakurataine, bakahika obukumi bubiri, omu nkumi ibiri, mu asatu na bbana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Bbekeeri: Zenira, Yowaasi, Eryezeeri, Eliwenayi, Omuli, Yeremoosi, Abiya, Anatoosi n'Alemeesi. Abo boona bakaba bali batabani ba Bbekeeri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuhendo gwabu ogwahandiikirwe obuzaale bwabu nkooku bukaba nibukuratana, abakuru ab'amaju ga baisebo, abarwani ab'amaani, bakahika obukumi bubiri, n'ebikumi bibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.9",
            "verseOrgIds": [
              "1CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yedyeri, akazaara omwana omu, ibara lye Biruhaani, kandi Biruhaani akazaara abaana musanju, nubo banu: Yehusi, Benyamiini, Ehudi, Kenaana, Zesaani, Tarasiisi n'Ahisahaali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boona bakaba bali batabani ba Yedyeri, abakuru ab'amaju ga baisebo nkooku bakaba bali, barwani ab'amaani, abarukuhika akakumi kamu omu kasanju, n'ebikumi bibiri, abaikaraga beetekaniiriize obulemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.11",
            "verseOrgIds": [
              "1CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Supimu na Hupimu, batabani ba Iri, kandi Husimu mutabani w'Ahera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oruzaaro rwa Nafutaali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Runu nurwo oruzaaro rwa Nafutaali: Yahaziyeri, Guuni, Yezeri na Saruumu, baijukuru ba Biluha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oruzaaro rwa Manaase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Manaase, nuwe Asiriyeli ou yazaireho mukazi we omuto Omwalemiyakati; omukazi ogu, nuwe Yazaire Makiri ise Giryadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makiri, akaswererra batabani be Hapimu na Supimu. Ibara lya munyanya bo, nuwe Maaka, kandi ery'owa kabiri, nuwe Zelofehaadi; Zelofehaadi akazaara abaana abaisiki bonka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.15",
            "verseOrgIds": [
              "1CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaka muka Makiri, akazaara omwana omwojo, yamuruka ibara Paasa; kandi owayina ogu nuwe Seresi; batabani be, nubo Ulamu na Rekemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.16",
            "verseOrgIds": [
              "1CH.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulamu akazaara omwana omwojo, ibara lye Bedani. Abo boona baijukuru ba Giryadi, mutabani wa Makiri, mwijukuru wa Manaase. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi munyaanya Homolekesi, akazaara Isihoodi, Abyezeri na Mahura. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.18",
            "verseOrgIds": [
              "1CH.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Semida akazaara abaana aboojo bbana, Ahyani, Sekemu, Likihi n'Aniyamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oruzaaro rw'Efuraimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Runu nurwo oruzaaro rw'Efuraimu: Suseera mutabani wa Beredi, Beredi mutabani wa Tahasi, Tahasi mutabani w'Ereyada, Ereyada mutabani wa Tahasi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tahasi mutabani wa Zabadi, Zabadi mutabani wa Suseera, hamu n'Ezeri n'Ereyada abaisirwe abasaija aba Gaasi, abaazairwe omunsi egi, habwokuba, bakaija kunyaga ente zaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efuraimu isebo akabalirirra kumara ebiro bingi bagenzi be baija kumuhuumuza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.22",
            "verseOrgIds": [
              "1CH.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efuraimu akatemba ekitabu kya mukazi we, mukazi we yatwara enda, yazaara omwana omwojo Efuraimu yamuruka ibara Beriya",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:23",
              "type": "text"
            },
            {
              "text": "Beriya omu Ruhebburaayo limanyisa “ali omukabi”",
              "type": "text"
            }
          ]
        },
        {
          "text": ", habwokuba akabi kakaba kagweriire enju ye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibara lya muhara we, nuwe Seera, nuwe yayombekere Besi-horoni zombi, eya ha nsi n'ey'eruguru, na Uzeni-Seera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
            "verseOrgIds": [
              "1CH.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efuraimu akaba aine na mutabani we ondi nuwe Refa, Refa ise Resefu, Resefu akazaara Teera, Teera akazaara, Rahani ise Ladani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ladani mutabani w'Amihudi, Amihudi mutabani w'Erisaama, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.26",
            "verseOrgIds": [
              "1CH.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisaama mutabani wa Nuuni, Nuuni mutabani wa Yosuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.27",
            "verseOrgIds": [
              "1CH.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaba baina itaka omu rubuga Beseeri, n'omu mbuga zaayo kandi nuho baikaraga, Burugaizooba bwa Narani Bugwaizooba bwa Gezere n'embuga zaayo, Sekemu n'embuga zaarwo, Aaya n'embuga zaayo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.28",
            "verseOrgIds": [
              "1CH.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okugendera kimu n'emitaano ey'Abamanaase, Bbesi-seyani n'embuga zaayo, Tenaki n'embuga zaayo, Migido n'embuga zaayo, Doru n'embuga zaayo. Omu biikaro ebi, batabani ba Yosefu mutabani wa Isirairi, numwo baikaraga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.29",
            "verseOrgIds": [
              "1CH.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oruzaaro rw'Asera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.29",
            "verseOrgIds": [
              "1CH.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Runu nurwo oruzaaro rw'Asera: Imuna, Isuva, Isuvi, Bberiya, kandi munyaanyabo, nuwe Seera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
              "1CH.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Bberiya: Heberi na Malikyeri, ise Bbiruzaisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
            "verseOrgIds": [
              "1CH.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hebberi nuwe yazaire Yafuleeti, Someri, Hosamu, na munyaanyabo Suwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
            "verseOrgIds": [
              "1CH.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Yafuleeti. Pasaki, Bbimuhaali n'Asuvaasi. Abo nubo batabani ba Yafuleeti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.33",
            "verseOrgIds": [
              "1CH.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Semeri owanyina: Rohuga, Yehubba, n'Aramu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.34",
            "verseOrgIds": [
              "1CH.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Heremu owanayina: Zoofa, Imuna, Seresi n'Amali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
            "verseOrgIds": [
              "1CH.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Zoofa: Suwa, Harunefeeri, Suwali, Bbeeri, Imura, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
              "1CH.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bbezeeri, Hoodi, Sama, Silusa, Isuraani na Beera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.37",
            "verseOrgIds": [
              "1CH.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Yeseri: Yefuna, Pisupa, n'Araa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.38",
            "verseOrgIds": [
              "1CH.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Uula: Aara, Hanyeri na Riziya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.39",
            "verseOrgIds": [
              "1CH.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boona, nubo baijukuru b'Aseri. Bakaba bali bakuru b'ebitabu, abaagumiibwe, basaija abarwani endanganwa, abeebembezi abamanyirwe. Omuhendo gwabu ogwabazirwe, obuzaale bwabo nkooku bukaba nibukuratana, ab'okugenda ha bulemu, bakahika emitwaro ebiri n'akakaaga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.40",
            "verseOrgIds": [
              "1CH.7.40"
            ]
          }
        }
      ]
    }
