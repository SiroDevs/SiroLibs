          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma yatuuza akuzire muno, ahangaire, atungire, kandi naahebwa ekitiinisa; Solomooni mutabani we, yateera engoma omukiikaro kye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
            "verseOrgIds": [
              "1CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu omukama Daudi ebi yakozire okuruga ha ky'okubanza okuhika ha ky'okumalirra, bikahandiikwa omu kitabu eky'Obusinge bwa Samwiri omurangi, n'omu ky'Obusinge bwa Nasani omurangi, n'omu ky'Obusinge bwa Gaadi omurangi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
              "1CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
