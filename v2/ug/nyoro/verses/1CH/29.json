        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebisembo ebyahairwe habwokwombeka Enju ya MUKAMA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.5"
              },
              "items": [
                {
                  "text": "1 Byok 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi omukama nubwo yagambiire ekitebe kyona ati, “Mutabani wange Solomooni, Ruhanga wenka ou akomere, muto kandi taina eki amanyire, kandi omulimo mukooto; habwokuba ekikaali tikiri ky'omuntu, baitu kya MUKAMA Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkakora kyona eki nasoboire, natunga ebintu eby'Enju ya Ruhanga wange, ezaabbu ey'okukoramu ebintu eby'ezaabbu, efeeza ey'okukoramu ebintu eby'efeeza, omulinga ogw'okukoramu ebintu eby'omulinga, ekyoma eky'okukoramu ebintu eby'ekyoma, n'emiti ey'okukoramu ebintu eby'emiti, oteho enkuyanja ey'amabaale ag'omuhendo, n'amabaale ag'okuhunda, ebyoma, amabaale ag'erangi, amabaale ag'omuhendo aga buli mulingo, n'amabaale ag'okwombekesa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.2",
            "verseOrgIds": [
              "1CH.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekindi, okwongera hali ebintu ebi byona, ebinaleesire habw'Enju egi erukwera, ngira ezaabbu n'efeza ebyange nyabwange, habw'okugonza muno Enju ya Ruhanga wange, egi nayo ngihaireyo: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.3",
            "verseOrgIds": [
              "1CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "etalanta enkumi isatu ez'ezaabbu eyarugire Offiri, n'etalanta kasanju e'zefeeza enungi ey'okusiiga ebisiika by'Enju, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.4",
            "verseOrgIds": [
              "1CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ey'okukoza emirimo ey'abafundi abanyakukora eby'engaro, ezaabbu ey'ebintu eby'ezaabbu, efeeza ey'ebintu eby'efeeza. Hati n'oha ondi ow'araaha habw'okwegondeza, akeehongera MUKAMA?”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakuru b'amaju ga baisenkurubo, nubwo baahaireyo ebihongwa byabo eby'okwegondeza, abeebembezi b'enganda, engabwa ez'abantu enkumi n'ez'ebikumi, n'abanyoro abarolerraga emirimo y'omukama oku baakozire, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.6",
            "verseOrgIds": [
              "1CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habw'omulimo gw'Enju ya Ruhanga, etalanta enkumi itaano ez'ezaabbu, n'etalanta omutwaro gumu, omutwaro gumu naka sanju ez'efeeza, ezirukukira ha bisatu ez'omulinga, n'etalanta emitwaro ikumi ez'ebyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena ow'akaba aina amabaale g'omuhendo, akagata omu lyahurro ely'Enju ya MUKAMA eryaroleererwaga Yehiyeri Omugeresooni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.8",
            "verseOrgIds": [
              "1CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu nukwo kusemererwa muno, habwokuba abo bakaha n'engonzi, habwokuba bakaba bahongiire MUKAMA, n'omutima gwona; Daudi omukama na uwe nukwo kusemererwa muno.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi naahaisaniza MUKAMA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nukwo kuhaisaniza MUKAMA omu maiso g'ekitebe kyona naagamba ati: “Ohaisanizibwe ebiro n'ebiro iwe MUKAMA Ruhanga wa isiitwe Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.10",
            "verseOrgIds": [
              "1CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.13"
              },
              "items": [
                {
                  "text": "Mat 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai MUKAMA, obukuru, obusobozi, okunyumizibwa, obusinguzi n'ekitiinisa, byawe; habwokuba byona ebinyakuli omwiguru n'omunsi byawe; Ai MUKAMA, obukama bwawe, niiwe anyakunyumizibwa, kandi omukuru ow'ebi byona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.11",
            "verseOrgIds": [
              "1CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuguuda n'ekitiinisa, biruga hali iwe, kandi byona niiwe obirema. Omumukono gwawe, nuho hali obusobozi n'amaani; niwe osobora kukuza n'okuha byona amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.12",
            "verseOrgIds": [
              "1CH.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati nu Ruhanga waitu, nitukusiima, kandi nituhaisaniza ibara lyawe ery'ekitiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baitu nyowe, ninyowe oha, kandi abantu bange, nubo baha nukwo tusobole kukuha tuti, n'omutima ogw'engonzi? Ngira ebintu byona biruga hali iwe, kandi ebyawe byonyini, nibyo tukuhaire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.14",
            "verseOrgIds": [
              "1CH.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba omumaiso gawe, tuli banyamahanga, kandi tuli bagoonyi, baisenkuruitwe boona nkooku bakaba bali; omunsi ebiro byaitu, bisisana nk'ekiituuru, tibiikaraho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.15",
            "verseOrgIds": [
              "1CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai MUKAMA Ruhanga waitu, enkumbutiti y'ebintu binu byona ebituleesire kukwombekera enju habw'ibara lyawe erirukwera, bikaruga omu ngaro zaawe, kandi byona byawe nyabwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.16",
            "verseOrgIds": [
              "1CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga wange, mmanyire nkooku oyekebiija emitima kandi nkooku ogonza amananu, abintu binu byona mbireesire ntahambiriziibwe nyina omutima ogw'amananu, kandi hati, mboine abantu bawe abanyakuli hanu hati, abarukukuhongera beegondiize kandi baijwire omuhimbo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.17",
            "verseOrgIds": [
              "1CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai MUKAMA Ruhanga wa baisenkuruitwe Abburahamu, Isaaka na Yakobbo, encwamu n'ebiteekerezo nk'ebi, obiikaze omu mitima y'abantu bawe obusinge bwona, kandi otereekereze emitima yabu, eyemarre hali iwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.18",
            "verseOrgIds": [
              "1CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohe mutabani wange Solomooni kukwata ebiragiro byawe, ebigambo n'amateeka gawe n'omutima gwona, ahikirize ebi byona, kandi ayombeke ekikaali eki nteekaniriize ebintu binu.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nubwo yagambiire ekitebe kyona ati “Muhaisanize MUKAMA Ruhanga wanyu.” Ekitebe kyona kyahaisaniiza MUKAMA Ruhanga wa baisenkurubo, bainama baamuramya, kandi baaramya Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baahongera MUKAMA ebyonzira, kandi ha kiro ekyakurasireho, baamuhongera ebihongwa eby'okwokya, ente enimi rukumi, empaya z'entaama rukumi, ebyana by'entaama rukumi, hamu n'ebihongwa eby'ebyokunywa, n'ebyonzira ebitabarwa ebyahongerwe habwa Isirairi yoona; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha kiro eki, baalya kandi banywa omumaiso ga MUKAMA, baina omuhimbo ogutagambwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okufunza Eby'obusinge bwa Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi mutabani wa Yese, nukwo yalemere Isirairi yoona ati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.26",
            "verseOrgIds": [
              "1CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
