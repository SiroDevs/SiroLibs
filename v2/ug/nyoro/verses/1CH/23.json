              },
              "items": [
                {
                  "text": "1 Bakam 1:1-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi obu yagurusire yamara ebiro bingi muno, omutabani Solomooni nuwe yata ha ngoma aleme Isirairi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        }
