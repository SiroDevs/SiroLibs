              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo habw'okutaba mwesigwa, nukwo yafiire ati; atabe mwesigwa hali MUKAMA, nukwo kutakwata biragiro bye, kandi yayekaguzaahoga omuntu arukubandwa emizimu, naaserra ow'okumwebembera, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiyaserra MUKAMA nuwe amwebembere. MUKAMA nukwo kumwita, obukama yabuha Daudi mutabani wa Yese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
