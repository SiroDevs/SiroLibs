{
  "id": "1CH.8",
  "number": "8",
  "bookId": "1CH",
  "reference": "1 Byok 8",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "1CH 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oruzaaro rwa Benyamiini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bbenyamiini nuwe yazaire Bbeera, nugwo omuzigaijo gwe, omusubiro nuwe Asubeeri, owa kasatu Ahara, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.1",
            "verseOrgIds": [
              "1CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nooha wa kana, kandi Raafa nuwe owa kataano. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.2",
            "verseOrgIds": [
              "1CH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bbeera, akazaara abaana aboojo, nubo banu: Adari, Geera, Abihudi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.3",
            "verseOrgIds": [
              "1CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisuha, Namaani, Ahowa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.4",
            "verseOrgIds": [
              "1CH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geera, Sefunaani na Huramu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.5",
            "verseOrgIds": [
              "1CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nubo batabani b'Ehudi (nubo bakaba bali bakuru b'amaju ga baisebo ag'abasi ba Gebba, kandi bakazaahisibwa, baatwarwa Manahaasi): ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.6",
            "verseOrgIds": [
              "1CH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namaani, Ahija na Geera, nuwe Higulaamu, ise Uza n'Ahihudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.7",
            "verseOrgIds": [
              "1CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saharahimu akabinga bakazi be babiri Husimu na Bbaara. Obu haahingwireho akasumi, obwakaba akyali omunsi eya Mowabbu, yaswera Hodesi ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.8",
            "verseOrgIds": [
              "1CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "yazaara abaana aboojo musanju, ganu nugo amabara gaabo: Yobbabbu, Zibbiya, Mesa, Marukaamu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.9",
            "verseOrgIds": [
              "1CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehuzi, Sakiya na Miruma. Abo nubo abaana be aboojo, abakaba bali bakuru b'amaju ga baisebo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.10",
            "verseOrgIds": [
              "1CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Husimu, na uwe akamuzaaraho abaana aboojo, ganu nugo amabara gaabo: Abitubbu n'Eripaali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.11",
            "verseOrgIds": [
              "1CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani b'Eripaali: Ebberi, Misamu, Semedi, abaayombekere Ono, Loodi, n'embuga zaazo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.12",
            "verseOrgIds": [
              "1CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bberiya na Seema; (nubo bakaba bali bakuru b'amaju ga baisebo ag'abasi b'Ayarooni, abaabingire abasi ba Gaasi); ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.13",
            "verseOrgIds": [
              "1CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oteho Ahiyo, Sasaki na Yeremoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.14",
            "verseOrgIds": [
              "1CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zebbadiya, Aradi, Ederi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.15",
            "verseOrgIds": [
              "1CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikairi, Isupa na Yooha, bakaba bali batabani ba Bberiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.16",
            "verseOrgIds": [
              "1CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zebbadiya, Mesulaamu, Hizuki, Heberi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.17",
            "verseOrgIds": [
              "1CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimerayi, Izuliya na Yobbabbu, bakaba bali batabani b'Eripaali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.18",
            "verseOrgIds": [
              "1CH.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahimu, Zikuli, Zabbudi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.19",
            "verseOrgIds": [
              "1CH.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriyenayi, Zilasayi, Eriyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.20",
            "verseOrgIds": [
              "1CH.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaaya, Bberaaya, na Ssimuraasi, bakaba bali batabani ba Simeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.21",
            "verseOrgIds": [
              "1CH.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isupaani, Ebberi, Eriyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.22",
            "verseOrgIds": [
              "1CH.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abudoni, Zikuli, Hanani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.23",
            "verseOrgIds": [
              "1CH.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hananiya, Eramu, Ansosiya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.24",
            "verseOrgIds": [
              "1CH.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifodeya na Penweri, bakaba bali batabani ba Sasaki. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.25",
            "verseOrgIds": [
              "1CH.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanuserayi, Sehariya, Asaliya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.26",
            "verseOrgIds": [
              "1CH.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalesiya, Eliya na Zikura, bakaba bali batabani ba Yerohaamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.27",
            "verseOrgIds": [
              "1CH.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bakaba bali bakuru b'amaju ga baisebo, bantu b'ekitiinisa, obuzaale bwabu nkooku bwagendaga nibukuratana.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
            "verseOrgIds": [
              "1CH.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aba Bbenyamiini abakaba bali Gibbyoni na Yerusaalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
            "verseOrgIds": [
              "1CH.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyeri ise Gibbyoni, yaikaraga Gibbyoni, ibara lya mukazi we, nuwe Maaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.29",
            "verseOrgIds": [
              "1CH.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuzigaijo gwe, nuwe Abudoni, hakurataho Zuuli, Kiisi, Bbaali, Nadabbu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.30",
            "verseOrgIds": [
              "1CH.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedora, Ahiyo, Zekeri ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.31",
            "verseOrgIds": [
              "1CH.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mikuloosi, (ogu nuwe yazaire Simeya). Abo na bo, baikaraga Yerusaalemu baroleriire ab'oruganda rwabu, bali hamu n'ab'oruganda rwabu abandi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
              "1CH.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekitabu ky'Omukama Saulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
              "1CH.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neeri akazaara Kiisi, Kiisi yazaara Saulo, Saulo yazaara Yonasaani, Malikisuwa, Abinadabu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:33",
              "type": "text"
            },
            {
              "text": "Esibbaali: Omu Samwiri 2:8 na handi omu Samwiri ayetwa Isibonesi",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'Esibaali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonasaani akazaara Meribbaali; kandi Meribbaali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:34",
              "type": "text"
            },
            {
              "text": "Meribbaali: Omu 2 Sam. 4:4 na handi omu 2 Sam ayetwa Mefibosesi",
              "type": "text"
            }
          ]
        },
        {
          "text": " yazaara Miika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani ba Miika: Pisoni, Mereki, Taleya n'Ahazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi akazaara Yehoyada; Yehoyada yazaara Alemeesi, Azimavesi na Zimuli; Zimuli yazaara Moza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
            "verseOrgIds": [
              "1CH.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moza akazaara Bbineya, Bbineya mutabani wa Raafa, Raafa mutabani w'Eryasa, Eryasa mutabani w'Azeeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
              "1CH.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azeeri akazaara abaana aboojo mukaaga, ganu nugo amabara gaabo: Azulikaamu, Bokeru, Isimairi, Seyariya, Obadiya na Hanani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo batabani b'Eseki owanyina: Omuzigaijo gwe, nuwe Ulaamu, omusubiro Yewusi, kandi owa kasatu Erifereti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Uraamu, bakaba bali basaija abakaba bali barwani b'amaani, baarwanisaaga obuta, bazaire abaana baingi aboojo, kandi baina n'abaijukuru, boona hamu kikumi mu ataano. Abo boona bakaba bali b'oruganda rwa Benyamiini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
      ]
