{
  "id": "1CH.19",
  "number": "19",
  "bookId": "1CH",
  "reference": "1 Byok 19",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
