                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo MUKAMA yayema omwiguru yaseesira Sodomu na Gomora obuganga n'omurro; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "yahwerekereza embuga ezi, ekyeya kyona, abantu abaikaraga omu mbuga ezi, na buli kintu kyona ekikaba kimezire ha itaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "WIS.10.7"
              },
              "items": [
                {
                  "text": "Ama 10:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.32"
              },
              "items": [
                {
                  "text": "Luk 17:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu muka Looti akaba amukuratiire, yarora enyuma yafooka nyomyo y'ekisura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abburahamu akazinduka nyenkya kara, yagenda yahika ha kiikaro eki akaba atangatanganiireho MUKAMA, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "yanaga amaiso Sodomu na Gomora n'ensi yoona ey'ekyeya, yarora omwika omunsi egi nigucuuka nk'omwika gw'ekikoomi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi nibyo byabaireho, Ruhanga obu yahwerekeriize embuga ez'omukyeya, yaijuka eki yaraganiize Abburahamu, yaiha Looti omu kabi ak'okuhwerekerra, obu yahwerekeriize embuga Looti ezi yaikaramuga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Looti yaruga Zohara, yaikara omunsi ey'ensozi hamu nabahara be ababiri, habwokuba akatiina kwikara Zohara, nukwo kwikara omu bwingira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.30",
            "verseOrgIds": [
              "GEN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhara we omuzigaijo yagambira muto we ati: “Isiitwe akuzire, kandi omunsi enu busamu musaija ow'okutuswera nk'engeso y'ensi oku eri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.31",
            "verseOrgIds": [
              "GEN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati tuhe Isiitwe amaarwa anywe atamiire, tubyame na uwe, nukwo tulinde oruzaaro rwaitu niturwihirra hali isiitwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.32",
            "verseOrgIds": [
              "GEN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, kiro eki, nukwo kutamiza isebo, omuzigaijo yagenda yabyama na uwe; Looti atamanye muhara we ha yabyamiire rundi ha yaimukiire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.33",
            "verseOrgIds": [
              "GEN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro ekyakurasireho, omwisiki omukuru yagambira muto we ati: “Ekiro mbyamirege na isiitwe, na kiro kinu, twongere tumutamiize, na iwe ogende obyame na uwe, tulinde oruzaaro rwaitu niturwihirra hali isiitwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.34",
            "verseOrgIds": [
              "GEN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki, kiro eki nakyo baatamiiza isebo; omwisiki omuto yagenda yabyama na uwe, ise atamanye muhara we ha yabyamiire rundi ha yaimukiire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.35",
            "verseOrgIds": [
              "GEN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahara ba Looti nukwo batwaire enda, ezi baatwekerwe isebo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.36",
            "verseOrgIds": [
              "GEN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwisiki omuzigaijo yazaara omwana omwojo, yamuruka ibara Mowabbu, nuwe ise aba Mowabbu na hati hoona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.37",
            "verseOrgIds": [
              "GEN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwisiki omuto na uwe yazaara omwana omwojo, yamuruka ibara Benammi, nuwe ise Abamooni na hati hoona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.38",
            "verseOrgIds": [
              "GEN.19.38"
            ]
          }
        }
      ]
    }
