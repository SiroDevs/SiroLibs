        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.24",
            "verseOrgIds": [
              "GEN.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abburahamu obu yahyemiire Abimereki habw'iziba ery'amaizi, abaheereza b'Abimereki eri bakaba banyagire, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.25",
            "verseOrgIds": [
              "GEN.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimereki yagamba ati: “Timmanyire anyakukozire eki atangambiire, eki tinkakihurraaga, hati bunu bunu, nubwo nabanza kukihuurra.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.26",
            "verseOrgIds": [
              "GEN.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abburahamu nukwo kukwata entaama n'enimi, yabiha Abimereki, abantu abo ababiri, baakora endagaano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.27",
            "verseOrgIds": [
              "GEN.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abburahamu yasoroora omu igana lye, ebuguma ez'entaama musanju. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.28",
            "verseOrgIds": [
              "GEN.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimereki yakaguza Abburahamu ati: “Ebuguma ez'entaama musanju zinu ezi osoraire, nizimanyisa ki?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.29",
            "verseOrgIds": [
              "GEN.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abburahamu yagarukamu ati: “Ebuguma zinu omusanju, ozitwale, oziihe omu ngaro zange, nukwo obe kaiso arukugumya nkooku ali ninyowe nalimire iziba linu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.30",
            "verseOrgIds": [
              "GEN.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiikaro eki, nukwo kwetwa Bbeeri-seba habwokuba hanu, bombi nuho baarahiriire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo baakozire bati endagaano, bali Bbeeri-seba. Hanyuma, Abimereki na Fikoli, mukuru w'ihe rye, baimukya, baagenda omunsi ey'Abafirisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.32",
            "verseOrgIds": [
              "GEN.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abburahamu yabyara omuti omunsi Bbeeri-seba kandi yayamirra MUKAMA Ruhanga atahwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.33",
            "verseOrgIds": [
              "GEN.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abburahamu akamara ebiro bingi omunsi y'Abafirisiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.34",
            "verseOrgIds": [
              "GEN.21.34"
            ]
          }
        }
      ]
    }
  ],
