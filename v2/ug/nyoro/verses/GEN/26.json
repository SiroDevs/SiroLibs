          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "eki kikabiihiza Isaaka na Rebbeka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
