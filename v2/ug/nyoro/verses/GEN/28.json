{
  "id": "GEN.28",
  "number": "28",
  "bookId": "GEN",
  "reference": "Kub 28",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
