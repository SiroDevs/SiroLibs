          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobbo yagarukamu ati: “Banza onguze",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
            "verseOrgIds": [
              "GEN.25.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:31",
              "type": "text"
            },
            {
              "text": "onguze:",
              "type": "text"
            },
            {
              "text": "ontunze",
              "type": "text"
            }
          ]
        },
        {
          "text": " obukuru bwawe.” Esau nukwo kugamba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
            "verseOrgIds": [
              "GEN.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
