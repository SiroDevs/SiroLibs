            "number": "30",
            "style": "v",
            "sid": "GEN 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasaba Yakobbo ati: “Mpaho ekiguude eki, ekirukutukura, ndyeho, enjara y'okunyita!” (nikyo baamurukiire ibara Edomu) ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
