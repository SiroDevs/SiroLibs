              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaka yagonzaaga Esau, habwokuba yalyaga enyama ey'ebisoro ebi yahiigaga, baitu Rebbeka uwe yagonzaaga Yakobbo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
