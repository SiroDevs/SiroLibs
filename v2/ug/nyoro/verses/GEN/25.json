              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiro kimu, Yakobbo obu akaba acumbire ekiguude, Esau yagaruka naaruga omu kisaka kuhiiga, enjara emuli kubi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
            "verseOrgIds": [
              "GEN.25.29"
            ]
          }
        },
        {
          "name": "verse",
