              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganu nugo mabara ag'abalemi ab'oruganda rwa Esau, nkooku ebitabu byabo bikaba biri omunsi ei baikaramuga: Timuna, Aluva, Yesesi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
