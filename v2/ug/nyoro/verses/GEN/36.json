          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenazi, Temani, Mibuzara, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 36:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magideri na Iramu; ganu nugo mabara g'abalemi aba Edomu (nuwe Esau ise aba Edomu) ebiikaro byabo nkooku bikaba biri omunsi ei baikairemu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.43",
