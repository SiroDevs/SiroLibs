            "number": "11",
            "style": "v",
            "sid": "DEU 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki kyonyini, Musa akateererra abantu naagamba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.11",
            "verseOrgIds": [
              "DEU.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.29"
              },
              "items": [
                {
                  "text": "Bir 11:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.33+JOS.8.34+JOS.8.35"
              },
              "items": [
                {
                  "text": "Yos 8:33-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obu muraamara kwambuka Yorudaani, abantu banu: Simyoni, Leevi, Yuda, Isakara, Yosefu na Benyamiini, beemerre harusozi Gerizimu, basabire abantu omugisa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi banu: Rubbeni, Gaadi, Aseri, Zebbuluuni, Daani na Nafutaali, beemerre harusozi Ebbali, bakyeene. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaleevi bagambire Abaisirairi n'iraka likooto bati:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        }
      ]
    },
