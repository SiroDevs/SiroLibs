            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Akyenwe omuntu ogu anyakubaija ekisisani, rundi okukyaagya omubintu, ekintu MUKAMA eki anuga, ekinyakukozirwe abantu, akakita harubaju nuho akiramize.’ Abantu boona bagarukiremu hamu bati: ‘Amina.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
