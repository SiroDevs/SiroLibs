                "loc": "1SA.8.5"
              },
              "items": [
                {
                  "text": "1 Sam 8:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obwolihika omunsi MUKAMA Ruhanga wawe eyarukwija kukuha, okagitunga okagiikaramu, okagamba oti: ‘Ka nyeteereho Omukama w'okundema nk'amahanga agandi goona aga mperiire nago nkooku gaakozire;’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyeteereho ogu, MUKAMA Ruhanga wawe owalikoma. Ogu ow'aliruga omu baanyoko, nuwe okome abe mukama ow'okulema; otalikisura okeekomera omunyaihanga atali wanyoko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.28"
              },
              "items": [
                {
                  "text": "1 Bakam 10:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
