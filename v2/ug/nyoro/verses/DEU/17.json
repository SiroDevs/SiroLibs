              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.28"
              },
              "items": [
                {
                  "text": "9:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonka omukama ogu, atalyekanyisiza embaraasi, rundi kuleetereza abantu kugaruka Misiri habw'okukanyisa embaraasi, habwokuba MUKAMA akamara ira kukugambira ati: ‘Oku otaligarukayo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
