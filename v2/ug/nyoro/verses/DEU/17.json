              "items": [
                {
                  "text": "9:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataliswera abakazi baingi, habwokuba eki, kirimucwa hali MUKAMA, kandi atalyekanyisiza efeeza n'ezaabbu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi obu aliikarra ha kitebe ky'obukama, ekopi ey'ebiragiro bya Ruhanga binu, agihandiike omukitabu, naihirra hali eya banyakatagara Abaleevi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aikalege na byo, abisomege obwomeezi bwe bwona, nukwo ayege kutiina MUKAMA Ruhanga we, n'okukwata ebigambo byona ebinyakuli omu biragiro binu, kandi abihikirize. ",
          "type": "text",
