            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otalitambira MUKAMA Ruhanga wawe ente rundi entaama enyakuyina akamogo, ekintu kyona ekinyakunyina akamogo, eki MUKAMA Ruhanga wawe takigonza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omumbuga zanyu MUKAMA Ruhanga wanyu ezi arukwija kubaha, omuli inywe kakuba hasangwamu omusaija rundi omukazi anyakukozire ekibi ekirukubiihiza MUKAMA Ruhanga wawe, akacwa endagaano ye, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.2",
            "verseOrgIds": [
              "DEU.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.20"
              },
              "items": [
                {
                  "text": "Kurug 22:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akagenda akaheereza embandwa akaziramya; akaramya izooba, okwezi, rundi ebintu ebindi ebinyakuli omumwanya gw'iguru ebi natangire, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.3",
            "verseOrgIds": [
              "DEU.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakakugambira ekigambo eki okakimanya kurungi; okikaguliirize muno, kandi kakuba kiba ky'amazima kwo bitali bisuba, ekintu ekibi nkeeki okukikozirwe omu Isirairi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.4",
            "verseOrgIds": [
              "DEU.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "omusaija rundi omukazi ogu anyakukozire ihano eri, omuleete ha malembo gawe, omwise amabaale. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.5",
            "verseOrgIds": [
              "DEU.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
