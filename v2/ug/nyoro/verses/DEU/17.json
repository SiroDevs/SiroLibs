                "loc": "HEB.10.28"
              },
              "items": [
                {
                  "text": "Baheb 10:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu harabahoga abakaiso babiri rundi basatu omuntu ogu arukwija kwitwa nubwo aitwege; omuntu tasemeriire kwitwa habw'okurumirizibwa kaiso omu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.6",
            "verseOrgIds": [
              "DEU.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "1Kor 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakaiso nubo babanze kumuteera amabale, nukwo hakurateho abantu abandi boona. Obwolikora oti, nubwo olicwekereza obubi bwona obunyakukurumu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obuharaabahoga omusango ogw'obwisi, rundi ogw'okurwanirra obusobozi otarukusobora kwetegereza, obu, oimukege ogende omukiikaro MUKAMA Ruhanga wawe ekyalikoma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.8",
            "verseOrgIds": [
              "DEU.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwolihikaho banyakatagara Abaleevi n'omucwi w'emisango ow'aliba aroho biro ebi, nubo oyekaguzeeho, bakwoleke encwa y'omusango ogu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.9",
            "verseOrgIds": [
              "DEU.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, ohikirize kyona eki balikugambira omukiikaro eki, MUKAMA eki alikoma. Oteho omutima okukora byona ebi balikuragira, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.10",
            "verseOrgIds": [
              "DEU.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyona eki olikora, ogendere ha biragiro ebi bakuragiire, na ha ncwa ei bakugambiire; otalirengaho okaruga ha ncwa ei bakwolekere, okeecwera nkooku orukwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.11",
            "verseOrgIds": [
              "DEU.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu kakuba alengaho kuteeza empaka nyakatagara arukukora omulimo omumaiso ga MUKAMA Ruhanga wawe, rundi akaiteeza omucwi w'emisango, omuntu ogu kimuhikiriire kwitwa; eki nikyo olikora, nukwo ocwekereze obubi omu Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.12",
            "verseOrgIds": [
              "DEU.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki abantu boona obu balikihurra, balitiina, tibaligaruka kukora kintu nkeeki.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
            "verseOrgIds": [
              "DEU.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebiragiro ebirukukwataho omukama",
          "type": "text"
        }
      ]
    },
