            "sid": "DEU 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu ebintu ebirukwera ebyoina, n'ebihongwa byawe eby'okuragaana, obitwalege omukiikaro MUKAMA ekyalikoma; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuho ohonge ebihongwa byawe eby'okwokya, enyama n'esagama, haitambiro lya MUKAMA Ruhanga wawe; esagama ey'ebyonzira byawe ogiseesege haitambiro lye, kyonka enyama ogirye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo binu byona ebindukukuragira, obiteho omutima, obwolikora ekirungi kandi ekihikiriire, MUKAMA eki asiima, nubwo oliba muhiirwa, n'abaana bawe babe bahiirwa, iwe otakyaroho, ebiro byona.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuteerererwa kutaramya ebisisani by'embandwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
