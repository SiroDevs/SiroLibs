          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Musa yazina ebigambo eby'ekizina eki yabimarayo, ekitebe kyona ekya Isirairi kihuliriize.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
