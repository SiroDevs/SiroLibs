              },
              "items": [
                {
                  "text": "Kubar 14:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.9"
              },
              "items": [
                {
                  "text": "Bir 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, mwetegereze MUKAMA Ruhanga wanyu, nkooku nuwe ali Ruhanga wenka, Ruhanga omwesigwa, omutacwa ndagaano, kandi ow'engonzi ezitayuga, anyakugonza muno abo abanyakumugonza, kandi abanyakukwata ebiragiro bye, okuhika ha bwijukuru obw'orukumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abo abanyakumunoba, abasasura empeera enyakubasemeriire, nibarora bati, nukwo kubahwerekereza; ogu anyakumunoba, talimwikazaaho, alimusasura empeera enyakumuhikiriire, naarora ati. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, muteho omutima okukwata ebiragiro, n'ebigambo ebi ndukubaragira kiro kinu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omugisa ogunyakuleetwa obuhulizi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
