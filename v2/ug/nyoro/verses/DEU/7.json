        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.19"
              },
              "items": [
                {
                  "text": "Ebik 13:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MUKAMA Ruhanga wanyu obu alibahikya omunsi ei murukwija kutaahamu mugirye, akabinga amahanga amaingi: Abahiiti, Abagirigaasi, Abamooli, Abakanaani, Abaperezi, Abahiivi n'Abayebusi, amahanga musanju agarukubakira amaani n'obusobozi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.1",
            "verseOrgIds": [
              "DEU.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akagabata omungaro mukagasingura, mubahwerekereze, mutalikora nabo ndagaano, kandi mutalibagirra embabazi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.2",
            "verseOrgIds": [
              "DEU.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaliswerrana nabo, kusweza bahara banyu batabani baabo, rundi kuswererra batabani banyu bahara baabo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.3",
            "verseOrgIds": [
              "DEU.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwokuba balitanga abaana banyu kunkuraatira, nibaheereza embandwa, ekirirugamu MUKAMA alibakwatirwa ekiniga abahwerekereze bwango. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.4",
            "verseOrgIds": [
              "DEU.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.3"
              },
              "items": [
                {
                  "text": "Bir 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu binu nibyo mubakole: Museese amatambiro gaabo, mutemateme enyomyo zaabo mucebacebe Asera embandwa yabo, ebisisani byabo ebinyakubaizirwe mubyokye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.5",
            "verseOrgIds": [
              "DEU.7.5"
            ]
          }
        }
      ]
    },
