              "items": [
                {
                  "text": "Ebik 10:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.11"
              },
              "items": [
                {
                  "text": "Bar 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.6"
              },
              "items": [
                {
                  "text": "Bag 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.9"
              },
              "items": [
                {
                  "text": "Bef 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba MUKAMA Ruhanga wanyu, kandi nuwe MUKAMA w'abakama, ow'ekitinisa, ow'obusobozi, kandi anyakutiinisa, atagira rubaju oru agwera, kandi atalya nguzi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.35.12+SIR.35.13+SIR.35.14+SIR.35.15"
              },
              "items": [
                {
                  "text": "Sir 35:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enfuuzi n'omufaakati, abacwera omubwinganiza, kandi agonza omunyaihanga, amuha ebyokulya n'ebyokujwara ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.18",
            "verseOrgIds": [
              "DEU.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "habweki mugonze omunyaihanga, habwokuba omunsi Misiri, na inywe mukaba muli banyamahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
            "verseOrgIds": [
              "DEU.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otiinege MUKAMA Ruhanga wawe, omuheereze, omugumireho, kandi orahirege ibara lye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu nuwe okugizeege, nuwe Ruhanga wawe ayakukoliire ebintu binu ebikuru kandi ebitiinisa ebiwayeroliire n'amaiso gawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.21",
            "verseOrgIds": [
              "DEU.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
