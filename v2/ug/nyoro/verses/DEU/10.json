                "loc": "1TI.6.15"
              },
              "items": [
                {
                  "text": "1Tim 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.14"
              },
              "items": [
                {
                  "text": "Kus 17:14",
