          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Genda otembe hamutwe gw'orusozi Pisiga, onage amaiso, orole Bugwaizooba ha bukiizi bw'emoso, ha bukiizi bw'obulyo na Burugaizooba, ogirole kurungi ogyetegereze; habwokuba, ekisaaru Yorudaani torukwija kukyambuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
        {
          "name": "verse",
