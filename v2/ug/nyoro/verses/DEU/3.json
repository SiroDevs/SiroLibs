          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu oragire Yoswa, omuteererre kandi omugumye; habwokuba nuwe arukwija kwebembera abantu abataahye omunsi ei oraarora.” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.28",
