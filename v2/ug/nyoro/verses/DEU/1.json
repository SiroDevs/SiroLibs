              "DEU.1.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.18"
              },
              "items": [
                {
                  "text": "Baheb 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akahurra ebi mwagambire, nukwo kukwatwa ekiniga yarahira naagamba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.34",
            "verseOrgIds": [
              "DEU.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Busaho muntu noomu ha bantu ab'ebiro binu ebibi ow'alirora ensi enungi ei narahiire kuha baisenkuru inywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.35",
            "verseOrgIds": [
              "DEU.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebbu mutabani wa Yefune wenka, nuwe aligirora, kandi ensi egi ei yarubasireho, ndigimuha hamu n'abaana be, habwokuba akahikiriza byona MUKAMA ebiyaragiire.” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.36",
            "verseOrgIds": [
              "DEU.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi na nyowe habwanyu, MUKAMA akambihirirwa nukwo kugamba ati: “Na iwe Musa, ensi egi toligihikamu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.37",
            "verseOrgIds": [
              "DEU.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa mutabani wa Nuuni anyakukwemeriire omumaiso, nuwe aligitaahamu; omwekambise, habwokuba nuwe alisoboza Abaisirairi okugweterwa ensi egi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.38",
            "verseOrgIds": [
              "DEU.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abaana banyu abato muno, aba mwagambire ngu balinyagwa, abatasobora kwahurana ekirungi n'ekibi, nubo baligitaaha, nubo ndigiha bagirye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.39",
            "verseOrgIds": [
              "DEU.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu inywe, mukubuutuke mugende omwirungu ha bukiizi obw'Enyanja Ey'ebitoogo.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo mwangarukiremu muti: “Tukasiisa hali MUKAMA, ka tugende turwane, MUKAMA Ruhanga waitu nkooku yaturagiire.” Buli omu omuli inywe akahagatira ebyokurwanisa bye naateekereza ati, nikirahuka kugenda omunsi ey'ensozi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yandagira ati: “Bagambire oti: ‘Mutagyayo kandi mutarwana, habwokuba tindi na inywe, abanyanzigwa banyu nibaija kubasingura.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.42",
            "verseOrgIds": [
              "DEU.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo nabagambiire, baitu mwayanga kuhurra; mwayanga MUKAMA eki yaragiire, mwayekuliiriza, mwagenda omunsi ey'ensozi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamooli abaikaraga omunsi egi ey'ensozi, nubwo baabaseesiire, baabairukya nk'enjoki okuzikora, baabairukya okuruga Seyira okubahikya Horuma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.44",
            "verseOrgIds": [
              "DEU.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu obu mwagarukire mwalirirra MUKAMA, atabahurre, kandi atabateho mutima.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emyaka Abaisirairi ei baamazire omwirungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki nikyo kyabaikaize Kadesi, ebiro bingi ebi byona, ebi mwamazireyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.46",
            "verseOrgIds": [
              "DEU.1.46"
            ]
          }
        }
