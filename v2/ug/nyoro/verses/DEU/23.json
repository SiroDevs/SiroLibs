                "loc": "DEU.15.7+DEU.15.8+DEU.15.9+DEU.15.10+DEU.15.11"
              },
              "items": [
                {
                  "text": "Bir 15:7-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otalihora mugenzi wawe nogendeerra kutungamu amagoba, ha sente, ha byokulya, n'ebyokujwara, ha buli kintu kyona ekinyakwohorwa, habw'okutungamu amagoba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyaihanga, ogu, omuholege akuhe amagoba, baitu Omwisirairi mugenzi wawe otalimuhora akuhe amagoba, obu nubwo MUKAMA Ruhanga wawe alikuha omugisa omu byona ebyolikora omunsi eyoli haihi kuhikamu ogirye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        }
      ]
    },
