    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abantu abatarukwikirizibwa kutaaha omukitebe kya MUKAMA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hatalibaho musaija n'omu omukonwa rundi ayacwirweho obusaija aikirizibwa kubalirwa omubantu ba MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatalibaho omwana ekitwekano alikirizibwa kubalirwa omu kitebe kya MUKAMA; okuhikira kimu ha bwijukuru obwa ikumi, hatalibaho noomu baijukuru be alibalirwa omu kitebe kya MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
