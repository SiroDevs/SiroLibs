          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obworaagendaga omumusiri gw'omutaahi ogw'emizabbibbu, olyege ebijuma oigute nkooku orukwenda, baitu otaligira ebyotwara omu kibindi rundi omu nsaho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obworaagendaga omu musiri gw'omuntu ogw'engano, olyege engano yoona eyosobora kunoga, baitu otalikisura okagitema n'enaijoro.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.25",
