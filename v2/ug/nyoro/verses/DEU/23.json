        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.29"
              },
              "items": [
                {
                  "text": "Lev 19:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omu bahara ba Isirairi, hatalibamu endaza, kandi noomu batabani be, hatalibamu omukuuhya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otalireeta omu Nju ya MUKAMA Ruhanga wawe, sente ezirugire omubwamalaaya, rundi empeera y'embwa nogenderra kuhikiriza eki araganiize MUKAMA, habwokuba ebi byona, MUKAMA Ruhanga wawe tabyenda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.18"
            ]
          }
        }
      ]
    },
