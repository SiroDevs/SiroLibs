          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obuyamazire kubagambira ebigambo ebi byona, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.45",
            "verseOrgIds": [
              "DEU.32.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 32:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "yayongera yagamba ati: ‘ebigambo byona ebi ndukubagambira kiro kya hati, mubite ha mutima, mubyegese abaana banyu, mwekambe okuhikiriza ebiragiro binu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.46",
            "verseOrgIds": [
              "DEU.32.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 32:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba, ekintu kinu kikuru muno, hali iwe nubwo bwomeezi bwawe bwonyini, kandi nikyo kirikuhangaaza omunsi eyorukwija kulya obuseeri bwa Yorudaani.’”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        }
      ]
    },
