              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Musa yaija hamu na Yoswa mutabani wa Nuuni yagamba ebigambo byona eby'ekizina eki, Abaisirairi boona bahuliriize.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwegesa kwa Musa okw'okumalirra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
