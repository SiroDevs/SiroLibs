              "type": "text"
            }
          ]
        },
        {
          "text": "“Mu baana ba MUKAMA Ruhanga wanyu, mutalyesarasara rundi kwemwa isoke habw'abantu abafiire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
