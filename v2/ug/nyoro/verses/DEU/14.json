          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30+LEV.27.31+LEV.27.32+LEV.27.33"
              },
              "items": [
                {
                  "text": "Lev 27:30-33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Kubar 18:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Buli mwaka oyahulege kimu kya ikumi ekya byona ebi oyereze, hanyuma ogende, omumaiso ga MUKAMA, kandi ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.22",
            "verseOrgIds": [
              "DEU.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukiikaro MUKAMA Ruhanga wawe eki yayegomboize kumuramiza, nuho oliirege kimu kya ikumi eky'ebyokulya byawe, ekyamagita gawe, eky'emizigaijo ey'igana ery'ente zawe, ery'entaama n'ery'emburabuzi, kandi nuho onywerege kimu kya ikumi eky'evini yawe, nukwo oyege kwikara nootiina MUKAMA Ruhanga wawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.23",
