          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu baamwo nukwo kubamenyamu abiihiirwe muno, kandi atanyina mbabazi, yabatwara omunsi endi ei barumu n'okuhika hati.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        }
