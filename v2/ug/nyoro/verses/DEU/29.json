        },
        {
          "text": "yaragaine nabo, baaheereza embandwa, baaziramya n'okuziramya, embandwa ezibakaba batamanyire, kandi ezaakaba abatangire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.26",
