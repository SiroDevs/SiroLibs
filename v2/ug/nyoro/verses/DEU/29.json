              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiniga kya MUKAMA, nukwo kwakiraho ensi enu, yagitaho emikyeeno yoona enyakuhandiikirwe omu kitabu kinu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.27"
            ]
          }
        },
