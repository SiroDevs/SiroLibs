        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagenda hamu na Yoramu mutabani w'Ahabbu, kurwanisa Hazaleeri omukama owa Siriya omu kiikaro Ramosi-Giryadi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMUKAMA Yoramu, akagaruka omu rubuga Yezereeri kutambirwa ebihuta, Abaisirairi ebi bakaba bamuhutaaliize Ramosi, naarwana na Hazeeri omukama wa Siriya. Ahaziya mutabani wa Yehoramu omukama wa Yuda, akagenda kumurora, habwokuba akaba ali murwaire.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
