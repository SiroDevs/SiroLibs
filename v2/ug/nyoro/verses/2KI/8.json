              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoramu akafa nka baisenkuru oku baafiire, yaziikwa nkooku baaziikirwe omu rubuga rwa Daudi; Ahaziya mutabani we yateera engoma omu kiikaro kye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Engoma y'Ahaziya owa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
