            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.2+2CH.4.3+2CH.4.4+2CH.4.5+2CH.4.6"
              },
              "items": [
                {
                  "text": "2 Byok 4:2-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Ahazi yalitamu ebikoba by'entebe, yateekuramu ebbeseni, yaiha amaizi omu nimi ez'omulinga ezikaba ziri hansi yalyo, yalita ha kyombeko eky'amabaale. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhanda ogukaba gulimirwe omu kikaali omunda, guswekeriirwe, nukwo gurabwemu ha Sabbato, n'omulyango ogw'aheeru omukama ogu arabamu, yabiiha omunju ya MUKAMA, habw'omukama w'Asiriya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebindi Ahazi ebi yakozire bikahandiikwa omu kitabu eky'obusinge obw'abakama ba Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.28"
              },
              "items": [
                {
                  "text": "Is 14:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi akafa nka baisenkuru oku baafiire, yaziikwa hamu nabo omu rubuga rwa Daudi; Hezekiya omutabani yateera engoma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
