            }
          ]
        },
        {
          "text": "Zedekiya ha yateeriire engoma, akaba ahikize emyaka amakumi abiri na gumu, akalemera emyaka ikumi na gumu omu rubuga Yerusaalemu. Ibara lya nyina muhara wa Yeremiya owa Libuna nuwe Hamutaali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.18",
            "verseOrgIds": [
              "2KI.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakora byona ebinyakubiihiza MUKAMA nka Yehoyakimu oku yakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.19",
