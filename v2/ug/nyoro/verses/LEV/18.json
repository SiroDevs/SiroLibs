            "number": "6",
            "style": "v",
            "sid": "LEV 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hatalibaho n'omu omuli inywe arukugendera omukazi ow'obuzaale bwe obwa haihi. Ninyowe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaligendera sso, rundi nyoko, kukora eki nooba oheemwire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.7",
            "verseOrgIds": [
              "LEV.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
