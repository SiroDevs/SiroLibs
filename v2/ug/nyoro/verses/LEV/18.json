          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.11"
              },
              "items": [
                {
                  "text": "Lev 20:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.30"
              },
              "items": [
                {
                  "text": "Bir 22:30",
