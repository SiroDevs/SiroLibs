              "items": [
                {
                  "text": "Bag 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo muraakwatiraga ebiragiro byange n'ebigambo byange, omuntu arukukora ati, alyomeera. Ninyowe MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.5",
            "verseOrgIds": [
              "LEV.18.5"
            ]
          }
        }
      ]
    },
    {
