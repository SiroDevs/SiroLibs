              "items": [
                {
                  "text": "Lev 20:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaligendera muka mwana wawe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.15",
            "verseOrgIds": [
              "LEV.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.21"
              },
              "items": [
                {
                  "text": "Lev 20:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'obwakubaire muramu wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.14"
              },
              "items": [
                {
                  "text": "Lev 20:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.23"
              },
              "items": [
                {
                  "text": "Bir 27:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaligendera n'omukazi okataho muhara we, noobwakuba kubyama na muhara w'omutabani rundi muhara wa muhara we, habwokuba bakazi b'obuzaale bwa haihi; kukora oti, kibi mali. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaligendera omwisiki muramu wawe, rundi kumuswera okamwongera hali mugenzi we, kunu mugenzi we akyayomiire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.18",
            "verseOrgIds": [
              "LEV.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.18"
              },
              "items": [
                {
                  "text": "Lev 20:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaligendera n'omukazi anyakuli omu kwezi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.19",
            "verseOrgIds": [
              "LEV.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.10"
              },
              "items": [
                {
                  "text": "Lev 20:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaliteerana n'omukazi w'omusaija ondi, akakusiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.20",
            "verseOrgIds": [
              "LEV.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.1+LEV.20.2+LEV.20.3+LEV.20.4+LEV.20.5"
              },
              "items": [
                {
                  "text": "Lev 20:1-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaliikiriza omwana wena ou ozaire kumuhongera embandwa, Moleki, habwokuba eki nikifurungura nyowe MUKAMA Ruhanga wawe, Ninyowe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.13"
              },
              "items": [
                {
                  "text": "Lev 20:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otaligendera omusaija nk'arukugendera omukazi, habwokuba eki kinugwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
              "LEV.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
