              "type": "text"
            }
          ]
        },
        {
          "text": "Otaligendera ekisoro kikakusiisa, noobwakuba omukazi kugendera ekisoro: eki tikiri kintu ky'obuhangwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
        }
      ]
