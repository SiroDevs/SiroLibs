            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Habweki, mwahuranege ebisoro ebitarukuzirwa n'ebirukuzirwa, ebinyonyi, ebitarukuzirwa n'ebirukuzirwa; mutalyesiisa mukalya ebisoro, ebinyonyi rundi ekintu ekindi kyona ekinyakuli omunsi ebi nabagambiire nti, ebintu binu by'omuziro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.25",
            "verseOrgIds": [
              "LEV.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwikalege muli bantu bange abarukwera baitu nyowe MUKAMA ndi arukweera, nkabaahurana ha mahanga, nukwo mube bange.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        }
      ]
    },
