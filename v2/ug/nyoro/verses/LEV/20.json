                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.18"
              },
              "items": [
                {
                  "text": "Bir 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omusaija kakuba asiihana na muk'omutaahi, bombi, omusaija n'omukazi baitwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.8"
              },
              "items": [
                {
                  "text": "Lev 18:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.30"
              },
              "items": [
                {
                  "text": "Bir 22:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.20"
              },
              "items": [
                {
                  "text": "27:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaija anyakusiihana na muka ise ogu aba ahemwire ise, uwe na muka ise baitwe, omusango guba gubasingire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.15"
              },
              "items": [
                {
                  "text": "Lev 18:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaija kakuba asiihana na mukamwana we bombi baitwe, habwokuba bakozire ekirukuzirwa, baba beesingisize omusango. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.22"
              },
              "items": [
                {
                  "text": "Lev 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba omusaija asiihana n'omusaija mutaahi we nkooku asiihana n'omukazi, bombi baba bakozire ekintu ekitakorwa; basemeriire baitwe, baba beesingisize omusango. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.17"
              },
              "items": [
                {
                  "text": "Lev 18:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.23"
              },
              "items": [
                {
                  "text": "Bir 27:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaija kakuba aswera omwisiki na nyina omwisiki, eki kintu kibi mali; ekitakorwa, abo boona, omusaija na bakazi be, babookye omu murro, nukwo muleke kugaruka kukora ekintu eki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.19"
              },
              "items": [
                {
                  "text": "Kurug 22:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.23"
              },
              "items": [
                {
                  "text": "Lev 18:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.21"
              },
              "items": [
                {
                  "text": "Bir 27:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba omusaija asiihana n'ekisoro, ogu aitwe, ekisoro eki nakyo, mukiite. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
              "LEV.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi kakuba ateerana n'ekisoro, omukazi mumwite hamu n'ekisoro; omukazi aitwe n'ekisoro kiitwe, ebihangwa ebi, biba byesingisize omusango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        }
      ]
    },
