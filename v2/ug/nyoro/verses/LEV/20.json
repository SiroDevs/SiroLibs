              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.14"
              },
              "items": [
                {
                  "text": "Kurug 20:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.20"
              },
              "items": [
                {
                  "text": "Lev 18:20",
