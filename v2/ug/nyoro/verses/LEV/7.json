        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinu nikyo kiragiro eky'ebihongwa eby'okwokeza MUKAMA: ebihongwa eby'ebyokulya, ebihongwa eby'okusaba kuganyirwa ekibi, eby'okwihwaho omusango, eby'okwezibwa na habw'okusaba obusinge, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebi nibyo MUKAMA yaragiire Musa ali ha rusozi Sinai, ha kiro eki yaragiriireho abantu ba Isirairi bamuleetere ebihongwa byabo obu bakaba bali mwirungu lya Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
