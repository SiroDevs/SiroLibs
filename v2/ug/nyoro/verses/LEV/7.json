              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.28",
            "verseOrgIds": [
              "LEV.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gambira abantu ba Isirairi oti: ‘Ogu anyakuha MUKAMA ekihongwa habw'okusaba obusinge, ekihongwa kye akyeretere wenka hali MUKAMA; ekicweka kyakyo akiheyo nk'ekisembo ekitali kya butoosa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
              "LEV.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekihongwa kye eky'okwokeza MUKAMA ha murro, akyereetere wenka hali MUKAMA; ebisajwa abireete hamu n'embanda, nukwo embanda imukaimukibwe, eki nikyo kihongwa eky'okwimukyaimukiza MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.30",
            "verseOrgIds": [
              "LEV.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebisajwa ebi, nyakatagara abyokeze ha itambiro, baitu embanda eriibwe Arooni n'abatabani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.31",
            "verseOrgIds": [
              "LEV.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekirumbu eky'obulyo, akihe nyakatagara, nugwo mugabo ogunyakurugire ha kihongwa kye habw'okusaba obusinge, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.32",
            "verseOrgIds": [
              "LEV.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu batabani ba Arooni, ogu anyakuhonga esagama, n'ebisajwa by'ebihongwa eby'okusaba obusinge, omugabo gwe guraabaga ekirumbu ky'obulyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.33",
            "verseOrgIds": [
              "LEV.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embanda ei baimukyaimukiza hamu n'ekirumbu eki bampongera, nkabiihaho abaana ba Isirairi, birugege ha bihongwa eby'okwokya, nabiha Arooni nyakatagara n'abatabani, gube mugabo gwabo ogw'oruteekerro ogu baraihaga ha bantu ba Isirairi.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu nugwo mugabo gwa Arooni n'abatabani, ogunyakuruga ha bihongwa eby'okwokeza MUKAMA, ogu baahairwe okuruga ha kiro eki baajwekiirweho omulimo ogw'obunyakatagara; okuruga ha kiro Arooni n'abatabani eki baaterirweho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akaragira abantu ba Isirairi, omugabo ogu baguhege Arooni n'abatabani, ha kiro eki baaseesirweho amagita; gwikale guli mugabo gwabo ogw'oruteekerro, ebiro byaabu byoona.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
