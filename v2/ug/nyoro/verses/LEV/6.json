              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli musaija wena nyakatagara nuwe arukwikirizibwa kukiryaho; kihongwa ekirukwera mali. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
