              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kakuba omuntu akora ekibi, akasobeza muno MUKAMA akabiihabiiha omutaahi, akamwihaho omukwato rundi omusimbo rundi akamutuntuza ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "rundi akomere ekintu ekikaba kibuzire akaterenganiza, akarahirra busa rundi akasiisa omu kimu ha bintu abantu ebi bakora, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuntu ogu obu amara kusiisa akacwa omusango, agarre eki yaibire rundi eki yanyagire, rundi omusimbo ogu baamuhaire, rundi ekintu eki yakomere, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4",
            "verseOrgIds": [
              "LEV.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "rundi ekintu kyona eki yakarahiiriire busa; ekintu eki akigarre kyona, kandi ayongereho omuhendo ogurukuhikya kimu kya kataano eky'omuhendo gwakyo akigarurre mukama wakyo ha kiro eki aheerayo ekihongwa kye eky'okumuganyiza ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aleetere nyakatagara entaama empaya etanyina kamogo agiihe omu igana, ei murukurora neehikya omuhendo ogw'ekihongwa eky'okuganyiza ekibi, ebe kihongwa eky'okuhongera MUKAMA ekirukumuganyiza ekibi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyakatagara amusabire hali MUKAMA, nukwo aganyirwe ekintu omuntu weena eki asobora kukora kikamuleetera omusango.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebiragiro ebindi ebirukukwata ha kuhonga ebihongwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagamba Musa ati; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.8",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ragira Arooni n'abatabani oti: ‘Kinu nikyo kiragiro ekirukukwata ha bihongwa eby'okwokya. Ekihongwa eky'okwokya kiraalege ha kyoto eky'itambiro okuhika nyenkya, kandi omurro gutalizima ha itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakatagara araajwaraga ekyokujwara kye ekya kitaani n'empale ye engufu eya kitaani atwale iju ery'ekihongwa omurro eki gusiiririize ha itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajuule ebyokujwara bye, ajwale ebindi, hanyuma atwale iju aheeru y'orukande aliseese harungi nambere liseeswa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omurro ogwa ha itambiro gwikalege nigwaka, gutaliraara; buli nyenkya, nyakatagara ayongeremuga enku, arambikehoga kurungi ekihongwa, ayokezeeho ebisajwa eby'ekihongwa ebiheebwayo habw'okusaba obusinge. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omurro ogwa ha itambiro gwikalege nigwaka obusumi bwona gutaliraara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuhonga ebyokulya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Kinu nikyo kiragiro eky'okuhonga ebyokulya. Batabani ba Arooni, baraabihongeraga MUKAMA omumaiso g'itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu, aihe orucumite rw'ensaano enyakuniinuukire kurungi ey'ekihongwa eky'ebyokulya, enyakutabwirwemu amagita n'emyamirro, agyokeze ha itambiro, ebe kiijukyo eky'ekihongwa eki, kibe kisorrokoko ekirukuboyera kurungi MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensaano enyakusigaireho, Arooni n'abatabani bagirye, bagirye etatumbisiibwe kandi bagiriirege Omukiikaro Ekirukwera, bagiriirege omu zigati ey'Eheema ey'okutangatanganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.16",
            "verseOrgIds": [
              "LEV.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etalicumbwa n'ekitumbisa. Omugabo ogu ngubahaire, gube gwabo ogunyakuruga ha kihongwa kyange eky'okwokya; omugabo ogu mugabo ogurukwera mali nk'ogunyakwihwa ha kihongwa eky'okuganyiza ekibi n'ekyokwihwaho omusango. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.17",
            "verseOrgIds": [
              "LEV.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana weena omwojo ow'oruganda rwa Arooni, nuwe wenka araalyaga ha mugabo ogu nkooku kyaragiirwe ebiro byoona ngu omugabo ogu guraarugaga ha bihongwa bya MUKAMA eby'okwokya ha murro; weena araagukwatahoga araayezibwaga.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kinu nikyo kihongwa, Arooni n'abatabani eki balihongera MUKAMA ha kiro eki baliseesirwaho amagita: kimu kya ikumi eky'ensaano erukuhikya lita asatu na mukaaga, kibege kihongwa ekya butoosa eky'ebyokulya, kimu kya kabiri kyayo, ehongwege nyenkya, na kimu kya kabiri ekindi, ehongwege omu kairirizi, etugwe kurungi, ecumbwe n'amagita. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogireete emazire kutaburwa kurungi, ecumbirwe omu bucwekacweka nk'ekihongwa eky'ebyokulya, okihonge kiboyere kurungi MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakatagara anyakurugire omu baana ba Arooni yaseeswaho amagita kugaruka omu kiikaro kya ise, nuwe araakihongeraga MUKAMA, nkooku kyaragiirwe kumara obusumi bwona, ekihongwa kyona kyokebwege. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekihongwa kyona eky'ebyokulya ekya nyakatagara, kyokebwege kyona, kitaliriibwa.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gambira Arooni n'abatabani oti: ‘Kinu nikyo kiragiro eky'ekihongwa eky'okuganyiza ekibi. Omu kiikaro ekinyakwitirwamu ekihongwa eky'okwokya, omumaiso ga MUKAMA, nuho haitirwege n'ekihongwa eky'okuganyiza ekibi; eki kihongwa ekirukwera mali. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakatagara arukukihonga kuganyiza ekibi, nuwe akirye, kandi akiriire Omukiikaro Ekirukwera, omu zigati ey'Eheema ey'okutangatanganiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekintu kyona ekinyakuhika ha nyama ey'ekihongwa eki, kyona kifooka ekirukwera, eky'okujwara eki, ekinyakutaraakiirwe esagama, okyogeze Omukiikaro Ekirukwera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
