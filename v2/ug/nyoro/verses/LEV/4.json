        },
        {
          "text": "abantu obu bamumanyisa ekibi eki yakozire, omuntu ogu aleete embuzi ebuguma etanyina kamogo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
