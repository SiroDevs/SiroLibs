              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate emikono ye ha mutwe gwayo, agiitire omu kiikaro nambere haitirwa ebihongwa eby'okwokya, ebe kihongwa kye eky'ekibi eki yakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
        },
        {
