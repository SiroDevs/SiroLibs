          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakatagara atwale ekicweka eky'esagama yayo, aibikemu orukumo, agisiige ha mahembe ag'itambiro ery'okwokezaaho ebihongwa, enyakusigaireho, agiseesire ekicweka ekya hansi eky'itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
