            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.7+NUM.29.8+NUM.29.9+NUM.29.10+NUM.29.11"
              },
              "items": [
                {
                  "text": "Kubar 29:7-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eki kiriba kiragiro kyanyu eky'ebiro byona, ekirukumanyisa ngu ha kiro ekya ikumi eky'okwezi kwa musanju, muraayefubiraga, timwakolege mulimo na gumu noobu araabaga muntu nzaarwa, rundi omunyaihanga arukwikara na inywe; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwokuba ha kiro eki, nikyo muraalehererwahoga musemezibwe, mwihweho ebibi byona; mube barungi omumaiso ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro eki, kiro kya Sabbato, hali inywe, kiro ky'okuhuumurra kimu; mwefubirege, eki kiragiro kyanyu eky'ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nyakatagara ayaseesirweho amagita, aganyakweza nukwo kukora omulimo ogw'obunyakatagara omu kiikaro kya ise, nuwe araatonganirraaga abantu, ajwaire engoye ezirukwera eza kitaani; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "araatonganirraaga Ekiikaro Ekirukwera, Eheema ey'okutangatanganiramu, itambiro, banyakatagara n'abantu boona ab'ekitebe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki kiraabaga kiragiro kyanyu eky'ebiro byona, ekirukumanyisa ngu abantu ba Isirairi baraatonganirirwaga omurundi gumu buli mwaka, habw'ebibi byabo byona. Musa yakora nkooku MUKAMA yamuragiire.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
