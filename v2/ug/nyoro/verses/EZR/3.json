            "number": "1",
            "style": "v",
            "sid": "EZR 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwezi okwa musanju obukwahikire, batabani ba Isirairi bali omumbuga z'owaabo, abantu bakesoroleza Yerusaalemu, baaba bantu bamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.1",
            "verseOrgIds": [
              "EZR.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1"
              },
              "items": [
                {
                  "text": "Kurug 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo haimukire Yeswa mutabani wa Yozadaki, hamu na banyakatagara bagenzi be, na Zerubbabbeeri mutabani wa Seralityeri hamu n'ab'oruganda rwe, baayombekera MUKAMA Ruhanga wa Isirairi itambiro ery'okuhongerahoga ebihongwa eby'okwokya, nkooku kyahandiikirwe omubiragiro bya Musa omuntu wa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.2",
            "verseOrgIds": [
              "EZR.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.1+NUM.28.2+NUM.28.3+NUM.28.4+NUM.28.5+NUM.28.6+NUM.28.7+NUM.28.8"
              },
              "items": [
                {
                  "text": "Kubar 28:1-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baata itambiro omu kiikaro kyalyo, habwokuba bakaba nibatiina abantu ab'ensi ezi, itambiro eri, niryo baahongerahoga MUKAMA ebihongwa eby'okwokya ebya nyenkya n'ebyakairirizi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.12+NUM.29.13+NUM.29.14+NUM.29.15+NUM.29.16+NUM.29.17+NUM.29.18+NUM.29.19+NUM.29.20+NUM.29.21+NUM.29.22+NUM.29.23+NUM.29.24+NUM.29.25+NUM.29.26+NUM.29.27+NUM.29.28+NUM.29.29+NUM.29.30+NUM.29.31+NUM.29.32+NUM.29.33+NUM.29.34+NUM.29.35+NUM.29.36+NUM.29.37+NUM.29.38"
              },
              "items": [
                {
                  "text": "Kubar 29:12-38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasemezaaga ekiro eky'obugenyi obw'enkaande nkooku kyahandiikirwe kandi baahongaga ebihongwa eby'okwokya ebya buli kiro, nibarorra ha muhendo, nibahondera ekiragiro, nkooku kikaba nikyetaagwa buli kiro, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.4",
            "verseOrgIds": [
              "EZR.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kubar 28:11—29:39.",
              "type": "text"
            }
          ]
        },
        {
          "text": "eki obukyahwaga, baahongaga ebihongwa eby'okwokya eby'oruteekerro, ebihongwa eby'okwokya ebyahongwaga okwezi kuli mboneko; na ha biro bya MUKAMA ebikuru ebindi, n'ebihongwa ebya buli muntu yahaga MUKAMA eby'okwegondeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga ha kiro eky'okubanza eky'okwezi okwa musanju, nubwo baatandikire kuhongera MUKAMA ebihongwa eby'okwokya. Baitu omusingi ogw'enju ya MUKAMA gukaba gutakatandikirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sente bakaiha aboombeki n'ababaizi, ebyokulya, ebyokunywa n'amagita, baabiha Abasidoni n'Abataya, basombe emiti emikogoto bagiihe Lebbanooni bagihikye ha nyanja na Yopa, Sirasi omukama wa Paasa akaba abaikiriize.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.7",
            "verseOrgIds": [
              "EZR.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enju ya MUKAMA neeyombekwa buhyaaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
