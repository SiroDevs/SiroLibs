              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TOB.14.5"
              },
              "items": [
                {
                  "text": "Tob 14:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'obwakubaire abaingi bakaba nibatokera haiguru habw'omuhimbo baitu baingi ha baanyakatagara n'Abaleevi n'abeebembezi ab'amaju ga baisenkurubo, abagurusi abakaba baboine omusingi ogw'enju egi nigutandikwa, bakatamu ekyoboobo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.12",
            "verseOrgIds": [
              "EZR.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu batasobole kwahukaniza iraka ly'okusemererwa ha iraka ery'abantu abarukurra, habwokuba bakaba nibatoka muno, kandi iraka lyabo likaba nirihulirwa hara.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.13",
            "verseOrgIds": [
              "EZR.3.13"
            ]
          }
