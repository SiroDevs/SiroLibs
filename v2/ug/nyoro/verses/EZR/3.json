              "items": [
                {
                  "text": "1 Byok 25:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboombeki obubaamazire kutandika omusingi ogw'Enju ya MUKAMA, banyakatagara bajwaire ebyokujwara byabo bairra omumaiso, baakwasire engwara, Abaleevi nabo hamu na batabani b'Asafu, bairra omumaiso bakwasire ebitaasa, bahaisanize MUKAMA nka Daudi omukama wa Isirairi oku yaragiire; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
