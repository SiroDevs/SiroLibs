              "type": "text"
            }
          ]
        },
        {
          "text": "bakazina nibagarukanganamu, nibahaisaniza, nibasiima MUKAMA bati: “Habwokuba murungi, habwokuba engonzi ze ezitagarukirra hali Isirairi, ziikaraho ebiro byona.” Abantu boona bakatokera haiguru, nibahaisaniza MUKAMA, nubwo omusingi ogw'Enju ye gwatandikirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 3:12"
          },
          "items": [
