            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopi y'ebbaruha y'omukama Atagizakiseesi obu yamazire kusomerwa Rrehumu, Simusayi omuhandiiki na bataahi baabu, batabandaale, bakagenda bwango baahikaho Abayudaaya abakaba bali Yerusaalemu, baabaaragiza amaani n'obusobozi balekere aho kwombeka orubuga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
