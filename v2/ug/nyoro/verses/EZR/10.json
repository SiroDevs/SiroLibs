          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seremiya, Nasani, Adaaya, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.39",
            "verseOrgIds": [
              "EZR.10.39"
            ]
