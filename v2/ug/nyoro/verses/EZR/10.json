          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu batabani ba Harimu: Eryeza, Isiya, Malikiya, Semaaya, Simyoni, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.31",
            "verseOrgIds": [
              "EZR.10.31"
            ]
          }
        },
