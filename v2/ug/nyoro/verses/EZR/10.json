          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaleeri, batabani ba Nebbo: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.41",
            "verseOrgIds": [
