            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu batabani ba Zaattu: Erihohenayi, Eriyasibbu, Mataniya, Yeremoosi, Zabadi na Aziza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.27",
            "verseOrgIds": [
              "EZR.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
