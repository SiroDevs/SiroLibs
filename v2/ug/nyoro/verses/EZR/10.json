          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu batabani ba Bbebbayi. Yehohanaani, Hananiya, Zabai, na Asulai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.28",
            "verseOrgIds": [
              "EZR.10.28"
            ]
          }
