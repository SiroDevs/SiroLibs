          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu batabani ba Hasumu: Metenayi, Matata, Zebbadi, Erifereti, Yeremayi, Manaase, na Simeyi batabani ba Bbani, Maadayi Amuramu, Huweri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.33",
