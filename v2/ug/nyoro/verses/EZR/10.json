            "style": "v",
            "sid": "EZR 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu batabani ba Bani: Mesulaamu, Maluki, Adaaya, Yasubbu, Seyali na Yeremoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.29",
            "verseOrgIds": [
              "EZR.10.29"
            ]
          }
