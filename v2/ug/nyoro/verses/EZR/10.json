              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaniya, Meremoosi, Eriyasibbu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.36",
            "verseOrgIds": [
              "EZR.10.36"
            ]
