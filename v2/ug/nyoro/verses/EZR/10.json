          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu batabani ba Pahasi-mowabbu: Adina, Kerara, Bbenaaya, Maaseya, Mataniya, Bbezaleeri, Binuyi, na Manaase. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.30",
            "verseOrgIds": [
