          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shallumu, Amariya na Yozefu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.42",
            "verseOrgIds": [
              "EZR.10.42"
            ]
