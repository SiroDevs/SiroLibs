          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makinadebbayi, Sasayi, Sarayi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.40",
            "verseOrgIds": [
              "EZR.10.40"
            ]
