          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benyamiini, Maluki, na Semaliya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.32",
            "verseOrgIds": [
              "EZR.10.32"
            ]
