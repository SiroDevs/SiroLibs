        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZR 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, ha kiro ekya ikumi na bibiri eby'okwezi okw'okubanza nubwo twarugire ha kisaaru Ahava tugende Yerusaalemu; Ruhanga waitu akatulinda, yatutabura abanyanzigwa, n'abantu abakaba beeserekere ha muhanda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.31",
            "verseOrgIds": [
              "EZR.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twaija Yeruzalemu, oku twamarayo ebiro bisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
              "EZR.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro ekya kana, efeeza n'ezaabbu, nubwo byalengerwe omunju ya Ruhanga, byakwasibwa Meremoosi nyakatagara mutabani wa Uliya, nyakatagara ogu, akaba ali hamu n'Eryeza mutabani wa Fenehaasi, abo bakaba bali hamu n'abaleevi, Yobaazadi mutabani wa Yeswa na Nowadiya mutabani wa Bbinuhi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu byona bikabarwa byalengwa, obulemeezi bwa buli kintu bwahandiikwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        }
      ]
