            }
          ]
        },
        {
          "text": "Ebi noobu muraaba mwabimanyire ira, baitu hati ningonza kubaijukya nkooku MUKAMA, ayajunire abantu be naabaiha omunsi Misiri, akongera yahwerekereza abo abataramwikiriize. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JUD 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bamalaika abataralinzire rukarra rw'obukuru bwabo bakaruga omu kiikaro kyabo, akabaikaza omu mwirima kasira, baboherwe omu njegere ezi batalirugamu okuhika ha kiro kikuru eky'okucwererwaho omusango; ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.6",
            "verseOrgIds": [
              "JUD.1.6"
            ]
          }
        },
        {
