          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mulingo nugwo gumu, abantu abo basiisa emibiri yabu, nibatwalirizibwa ebirooto byabo, bagaya obusobozi bwa Ruhanga kandi bajuma ab'ekitiinisa ab'omu iguru. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.8",
            "verseOrgIds": [
              "JUD.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
