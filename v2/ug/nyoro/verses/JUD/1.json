          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitiinisa, obukuru, obulemi n'obusobozi bibe hali Ogu arukusobora kubalinda mutagwa, akabahikya omu maiso g'ekitiinisa kye mutaina kamogo kandi mukyanganukire. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.24",
            "verseOrgIds": [
              "JUD.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JUD 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi byona biheebwe Ruhanga omu wenka anyakutujuna naaraba omu Yesu Kristo MUKAMA waitu ayabaireho ira lyona, anyakuroho hati, kandi ow'alibaho ebiro n'ebiro. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.25",
            "verseOrgIds": [
              "JUD.1.25"
            ]
          }
        }
