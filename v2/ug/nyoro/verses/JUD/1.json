                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noobwakubaire Mikairi, omukuru wa baamalaika, obu akaba naahakaniza Sitaani, akamuteeza empaka ha by'omubiri gwa Musa, atagonze kumucwera omusango naamugaya, baitu akamugambira ati: “Leka MUKAMA wenka nuwe akuhane.” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JUD 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu abantu banu bagaya kyona eki batarukwetegereza, kandi batwalirizibwa ebintu ebi bamanyire habw'obuhangwa bwabo nk'enyamaiswa ezitaina magezi, kandi nibyo bibahwerekereza. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
