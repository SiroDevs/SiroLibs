            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nk'ab'omu Sodomu na Gomora n'embuga ezindi ezaaherraineho oku baayetabwire omu busiihani n'omu rwanju orutali rw'obuhangwa, bakafubirwa omu murro ogutahwaho, babe kyokurorraho kyaitu.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
            "verseOrgIds": [
              "JUD.1.7"
