            }
          ]
        },
        {
          "text": "MUKAMA Ruhanga, nukwo yaanyolekere ati: Ebyokulya by'omukama obubikaba bimazire kugeswa, omu kasumi, ebirimwa eby'omurundi ogwa kabiri, obu bikaba nibikyayaruka, nkabona omuziinga gw'enzige, enkuru mali. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        }
