              "type": "text"
            }
          ]
        },
        {
          "text": "Amaziya nubwo yagambire Amosi ati: “Iwe murangi we, ruga aho ogende omunsi ya Yuda, nuho otunge omugaati, nuho orange, ab'oku, nubo baraakuha omukimba; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.12",
            "verseOrgIds": [
              "AMO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
