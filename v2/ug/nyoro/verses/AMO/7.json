          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu otagaruka okarangira Bbeseri hanu, habwokuba, kinu nikyo kiikaro ky'omukama ekirukwera, niryo iramizo ly'obukama.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.13",
            "verseOrgIds": [
              "AMO.7.13"
            ]
          }
        }
