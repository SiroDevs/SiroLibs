          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu rubuga oru ntarolemu Nju ya Ruhanga, habwokuba MUKAMA Ruhanga ow'obusobozi bwona n'Omwana gw'Entaama nubo Nju ya Ruhanga y'orubuga oru. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.22",
            "verseOrgIds": [
              "REV.21.22"
            ]
          }
        },
        {
          "name": "verse",
