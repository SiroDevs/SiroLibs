            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalembo gaarwo tigalikingwa nyamusana omurundi na gumu; kandi oku, obwire tibwairege. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
              "REV.21.25"
            ]
