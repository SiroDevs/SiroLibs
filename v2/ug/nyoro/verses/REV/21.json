                  "text": "Is 60:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahanga galigendera omu kyererezi kyarwo; kandi abakama b'ensi baliruleetamu ekitiinisa kyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.24",
            "verseOrgIds": [
              "REV.21.24"
            ]
          }
        },
