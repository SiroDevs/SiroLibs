            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi orubuga oru tirurukwetaaga izooba rundi okwezi eby'okurujwera, habwokuba ekitiinisa kya Ruhanga nikyo kyererezi kyarwo kandi Omwana gw'Entaama niyo taara yarwo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
            "verseOrgIds": [
              "REV.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "REV 21:24"
          },
          "items": [
