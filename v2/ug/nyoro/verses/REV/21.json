            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo narozire iguru erihyaka n'ensi empyaka. Habwokuba iguru ery'okubanza n'ensi ey'okubanza bikaba bihoireho, kandi enyanja ekaba etakyaroho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
