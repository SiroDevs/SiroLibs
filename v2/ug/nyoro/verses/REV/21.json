          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baliruleetamu ekitiinisa ky'amahanga n'itungo lyago. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.26",
            "verseOrgIds": [
