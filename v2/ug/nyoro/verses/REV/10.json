              "items": [
                {
                  "text": "Amos 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika ou naboine ayemeriire ha nyanja na ha bwerre, omukono gwe ogw'obulyo yagwimukya haiguru, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yarahira Ogu anyakwomeera ebiro byona, ayahangire iguru, ensi, anyanja, n'ebinyakubirumu byona, naagamba ngu, tihakyaroho kukeerereza okundi, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.6",
            "verseOrgIds": [
              "REV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu omu biro malaika owa musanju ebi aliterramu engwara, nubwo Ruhanga alihikiriza entegeka ye ey'ensita nkooku yagambiire abarangi abamuheereza.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        }
      ]
    },
