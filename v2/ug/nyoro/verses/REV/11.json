                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakaiso abo niyo emiti ey'oliva, n'ebikondo bibiri eby'etaara ebinyakuli omu maiso ga MUKAMA w'ensi yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.4",
            "verseOrgIds": [
              "REV.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba habaho weena arukubakora kubi, omurro gulibaruga omu kanwa, gumaleho abanyanzigwa baabo. Kakuba habaho weena arukubakora kubi, nawe nukwo ali w'okwitwa ati. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.5",
            "verseOrgIds": [
              "REV.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Bakam 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.17+EXO.7.18+EXO.7.19"
              },
              "items": [
                {
                  "text": "Kurug 7:17-19",
                  "type": "text"
