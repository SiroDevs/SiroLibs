            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma naheebwa oruti orw'okulengesa, orurukusisana orubango; haabaho ayandagiire ati: “Imuka, olenge Enju ya Ruhanga n'itambiro, kandi obale abo abaramizaamu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.1",
            "verseOrgIds": [
              "REV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.24"
              },
              "items": [
                {
                  "text": "Luk 21:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu otalenga ezigati ey'aheeru y'Enju egi; yo ogireke, habwokuba ehairwe Abanyamahanga kandi balirubaatirra orubuga orurukwera okumara ameezi makumi ana n'abiri. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.2",
            "verseOrgIds": [
              "REV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abakaiso bange ababiri ndibaha obusobozi obw'okuranga okumara ebiro rukumi rumu omu bikumi bibiri n'enkaaga, baliranga bajwaire ebiguniya.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        }
      ]
    },
