            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.8"
              },
              "items": [
                {
                  "text": "1 Sam 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baina obusobozi obw'okukinga iguru, nukwo enjura ereke kugwa omu biro ebi balimara nibaranga. Kandi baina obusobozi ha maizi okugahindura sagama, n'okuleeta omunsi buli muhito gwona ha bakagondiize hoona.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        }
      ]
    },
