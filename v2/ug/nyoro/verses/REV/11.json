          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhito ogwa kabiri guhoire, hati ogwa kasatu gumalize kwija.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
            "verseOrgIds": [
              "REV.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malaika owa musanju n'okwija kw'obukama bwa Kristo",
          "type": "text"
        }
      ]
    },
