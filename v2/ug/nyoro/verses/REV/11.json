              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu balikamara kuha obwakaiso bwabu, ekinyamaiswa ekinyakuruga omu kiina ekitaina h'okugarukira kiribarwanisa, kibasingule, kibaite; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.7",
            "verseOrgIds": [
              "REV.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.9"
              },
              "items": [
                {
                  "text": "Is 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi emitumbi yabu erigaraamirra omu ikuute ery'orubuga orukuru nambere MUKAMA wabo yabambiirwe ha musaraba, orubuga orusisanizibwa Sodomu na Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.8",
            "verseOrgIds": [
              "REV.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu aba buli mulingo, buli ruganda, buli ngambo, n'aba buli ihanga emitumbi yabo baligihanga amaiso okumara ebiro bisatu n'ekicweka, batarukwikiriza eziikwe omu kituuro. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.9",
            "verseOrgIds": [
              "REV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abo abaliba bali omunsi balibeebugira, balisemererwa kandi balitwekerangana ebisembo, habwokuba abarangi abo ababiri baabatuntuzaaga muno. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.10",
            "verseOrgIds": [
              "REV.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.10"
              },
              "items": [
                {
                  "text": "Ezek 37:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu obu haahingwireho ebiro bisatu n'ekicweka, orwoya orw'obwomeezi orwarugire hali Ruhanga rukabataahamu, baayemerra; n'abo boona abaababoine baatiina muno. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.11",
            "verseOrgIds": [
              "REV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.11"
              },
              "items": [
                {
                  "text": "2 Bakam 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo abakaiso abo ababiri baahuliire iraka likooto erirukuruga omwiguru nirigamba liti: “Mutembe, mwije hanu!” Baatemba omu iguru, bali omu kicu, abanyanzigwa baabo nibabarora. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.12",
            "verseOrgIds": [
              "REV.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.12"
              },
              "items": [
                {
                  "text": "Kus 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.18"
              },
              "items": [
                {
                  "text": "16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omu kasumi ako haabaho omusisa ogw'amaani, kimu kya ikumi eky'orubuga kyagwa; abantu kasanju baitwa omusisa, kandi abaasigaireho baatina muno, baakugiza Ruhanga ow'omwiguru.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.13",
            "verseOrgIds": [
              "REV.11.13"
            ]
          }
        }
      ]
    },
