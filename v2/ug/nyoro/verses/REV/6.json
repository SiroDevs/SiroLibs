              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana gw'Entaama obu yabambwire emanyiikirizo eya kabiri, nahurra ekihangwa ekyomeezi ekya kabiri nikigamba kiti: “Rugayo!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
