              "items": [
                {
                  "text": "6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haarugayo embaraasi endi rugaaju. Ow'akaba agitembere yaikirizibwa kwiha obusinge omunsi, nukwo abantu baitangane; kandi yaheebwa empirima enkooto.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
              "REV.6.4"
            ]
          }
        }
      ]
    },
