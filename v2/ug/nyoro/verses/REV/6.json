                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "enyunyuuzi eza haiguru zaaragalika hansi, nk'omuti omutini oku guragalikya ebijuma byagwo omu bwire bwa kasambura obu gutengesibwa ihunga; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
