          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo narozire Omwana gw'Entaama naabambura emanyiikirizo ey'okubanza ha manyikirizo musanju, kandi nahurra ekimu ha bihangwa ebbina ebyomeezi nikigamba n'iraka nk'ery'okuhinda kw'enkuba kiti: “Rugayo!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 6:2"
          },
          "items": [
