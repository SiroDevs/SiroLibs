              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana gw'Entaama obu yabambwire emanyiikirizo eya kasatu, nahurra ekihangwa ekyomeezi ekya kasatu nikigamba kiti: “Rugayo!” Narora embaraasi rwozi. Ow'akaba agitembere akwasire minzaani omu ngaro ze; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.5",
            "verseOrgIds": [
              "REV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nahurra ekirukusisana iraka niryema hagati y'ebihangwa bbina abyomeezi, nirigamba liti: “Endengo ey'engano erukwera ebe mpeera y'ekiro kimu; baitu amagita n'amarwa obikwate mpora!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        }
      ]
    },
    {
