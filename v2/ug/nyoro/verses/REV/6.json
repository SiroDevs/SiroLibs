                  "text": "2Esid 4:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo buli omu omuli bo yahairwe ekanzu erukwera, kandi baagambirwa kwongera kuhuumuraho akasumi, okuhika omuhendo ogw'abaheereza bagenzi baabo na bataahi baabo ab'okwitwa nka bo obu gulikahika.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.11",
            "verseOrgIds": [
              "REV.6.11"
            ]
          }
        }
