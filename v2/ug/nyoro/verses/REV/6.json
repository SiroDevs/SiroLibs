              "items": [
                {
                  "text": "Ezek 14:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narora embaraasi rubuubi. Ow'akaba agitembere, ibara lye nuwe Rufu, kandi Kuzimu emuhondiire; byaheebwa obusobozi ha kimu kya kana eky'ensi, okukiisa empirima, kiihe, ebidanda, n'enyamaiswa ez'omunsi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        }
      ]
    },
