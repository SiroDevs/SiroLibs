              },
              "items": [
                {
                  "text": "Mat 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwerinde, muleke kukora ebikorwa byanyu ebirungi omu maiso g'abantu ngu, babarole. Obu muraakora muti, Isiinywe ow'omwiguru talibaha mpeera.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.1",
            "verseOrgIds": [
              "MAT.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.1",
            "verseOrgIds": [
              "MAT.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Habweki obu oraagabiraga omuseege, leka kukirangaaniza nk'abagobya oku bakora omu masorrokaniro n'omu mihanda, nukwo abantu babanyumize. Mazimakwo nimbagambira nti: Abo bamazire ira kutunga empeera yabu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.2",
            "verseOrgIds": [
              "MAT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu obu oraagabiraga omuseege, omukono gwawe ogw'emoso guleke kumanya omukono gw'obulyo eki gurukukora. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.3",
            "verseOrgIds": [
              "MAT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okugaba kwawe kubege kw'ensita; kandi So anyakurora ensita alikuha empeera.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.4",
            "verseOrgIds": [
              "MAT.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naayegesa ha kusaba",
          "type": "text"
        }
      ]
    },
