            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutalyeyahurra itungo omunsi, erirukusiiswa enkugutu n'obumomi, kandi abasuma nambere barukucwa bakaiba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
            "verseOrgIds": [
              "MAT.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.29.11"
              },
              "items": [
                {
                  "text": "Sir 29:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu mweyahurrege itungo omwiguru, nambere litasobora kusiiswa enkugutu n'obumomi, kandi abasuma nambere batarukucwa bakaiba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.20",
            "verseOrgIds": [
              "MAT.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba itungo lyanyu nambere liri, oku nuho emitima yanyu eraikaraga.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.21",
            "verseOrgIds": [
              "MAT.6.21"
            ]
          }
        }
      ]
    },
    {
