              "items": [
                {
                  "text": "Luk 18:10-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obu muraabaga nimusaba Ruhanga, mulekege kuba nk'abagobya; habwokuba bbo bagonza kusaba beemeriire omu masorrokaniro n'omu ntangatangano z'emihanda, nukwo abantu babarole. Mazimakwo nimbagambira nti: Abo baamazire ira kutunga empeera yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.5",
            "verseOrgIds": [
              "MAT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu obu oraabaga noosaba, otaahege omu kisiika kyawe, oyekingiremu, nukwo osabe Sso atarukurorwa; kandi Uwe anyakurora ensita alikuha eky'osabire.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.6",
            "verseOrgIds": [
              "MAT.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
