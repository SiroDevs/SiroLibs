                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Yesu yatwarwa Mwoyo omu irungu okwohebwa Sitaani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.1",
            "verseOrgIds": [
              "MAT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu yamazire ebiro makumi ana nyamusana n'ekiro atarukulya kantu, enjara yamuruma. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho omwohi yamwizira yamwohya ati: “Obu oraaba oli Mwana wa Ruhanga, ragira amabaale ganu gafooke byokulya.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.3",
            "verseOrgIds": [
              "MAT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.3"
              },
              "items": [
                {
                  "text": "Bir 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yamugarukamu ati: “Kikahandiikwa kiti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naatandika omulimo gwe omu Galiraaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
