        "style": "s1"
      },
      "items": [
        {
          "text": "Okurangirra kwa Yohaana Omubatiza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebi, Yohaana Omubatiza akaija naarangirra omwirungu lya Buyudaaya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
              "MAT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.17"
              },
              "items": [
                {
                  "text": "Mat 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.15"
              },
              "items": [
                {
                  "text": "Mar 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "naagamba ati: “Mwegarukemu, habwokuba obukama bw'omwiguru buli haihi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.2",
            "verseOrgIds": [
              "MAT.3.2"
            ]
          }
        }
      ]
    },
