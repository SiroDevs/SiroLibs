                "loc": "LUK.9.35"
              },
              "items": [
                {
                  "text": "Luk 9:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'iraka lyaruga omwiguru nirigamba liti: “Ogu nuwe Mwana wange omugonzibwa ou nsiima muno.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
