        "style": "s1"
      },
      "items": [
        {
          "text": "Arukukira obukuru omu bukama bw'omu iguru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
