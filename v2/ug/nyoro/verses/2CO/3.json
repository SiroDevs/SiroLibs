        "style": "s1"
      },
      "items": [
        {
          "text": "Abaheereza b'Endagaano Empyaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
