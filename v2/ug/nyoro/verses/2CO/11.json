                {
                  "text": "Ebik 9:23-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu Damasiko omulemi omukuru ow'Omukama Areeta akataho abalinzi orubuga Damasiko nukwo ankwate. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu abaikiriza bakanta omu kisombero, bandabya omu idirisa, bansirimurra ha kisika ky'orubuga, naacwa omu mikono ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
