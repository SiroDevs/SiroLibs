                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.5"
              },
              "items": [
                {
                  "text": "Ebik 14:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emirundi nyingi omu ngendo zange nkagwa omu kabi k'ebisaaru, akabi k'abanyagi, akabi omu bantu ab'ihanga lyange, akabi omu Banyamahanga, akabi omu rubuga, akabi omu irungu, akabi omu nyanja, akabi omu bagenzi baitu ab'ebisuba; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu kutalibana n'omu kulemererwa, omu kuraara ha muro emirundi nyingi, omu njara n'iroho, omu kuburwa ebyokulya emirundi etali emu, n'omu mbeho ntaina eky'okwefubika. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noobu ndaaba ntagambire bindi, haroho n'ebirukundemeera buli kiro, kukira muno okutunturra ebitebe byona by'abaikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nooha aceka, nyowe ntacekere? Nooha ayesiitazibwa, nyowe ntabiihirwe?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        }
      ]
    },
