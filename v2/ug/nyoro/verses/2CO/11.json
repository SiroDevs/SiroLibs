          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu ndaaba ndi w'okwehaisa, kanyehaise habw'ebintu ebyoleka obuceke bwange; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
              "2CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga, kandi Ise MUKAMA Yesu, anyakuhaisanizibwa ebiro byona, naamanya nkooku ntarukubiiha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
            "verseOrgIds": [
              "2CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
