                  "text": "Ebik 14:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkateerwa emiigo kasatu, nateerwa amabaale omurundi gumu. Emeeri naagenderamuga ekacweka emirundi esatu: naagwa omu nyanja naasiibamu kandi naaraaramu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.25",
            "verseOrgIds": [
              "2CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CO 11:26"
          },
          "items": [
