              },
              "items": [
                {
                  "text": "Ezek 37:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enju ya Ruhanga ikirraniza eta n'ibandiro? Itwe tuli Nju ya Ruhanga omwomeezi; nkooku Ruhanga yagambire ati:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
