              "items": [
                {
                  "text": "Luk 14:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayeta ekitebe ky'abantu hamu n'abeegesebwa be, yabagambira ati: “Weena anyakugonza kumpondera, ayehwemu wenka, ahimbe omusaraba gwe, ampondere. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.39"
              },
              "items": [
                {
                  "text": "Mat 10:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.33"
              },
              "items": [
                {
                  "text": "Luk 17:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.25"
              },
              "items": [
                {
                  "text": "Yoh 12:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba weena anyakutaatira obwomeezi bwe, alibufeerwa; kandi weena anyakuhayo obwomeezi bwe habwange na habw'Amakuru Amarungi, alibujuna. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.35",
            "verseOrgIds": [
              "MRK.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omuntu nikimugasa ki okutunga ensi yoona, kandi akafeerwa obwomeezi bwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.36",
            "verseOrgIds": [
              "MRK.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kintu ki omuntu eki asobora kuhayo okucungura obwomeezi bwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.37",
            "verseOrgIds": [
              "MRK.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu weena arukunkwatirwa ensoni rundi akaikwatirwa ebigambo byange omu businge bunu obuhabire kandi obubi, Omwana w'omuntu nawe alimukwatirwa ensoni obu aliija aina ekitiinisa kya Ise, asendekeriziibwe abamalaika be abahikiriire.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.38",
            "verseOrgIds": [
              "MRK.8.38"
            ]
          }
        }
      ]
