                "loc": "LUK.12.11"
              },
              "items": [
                {
                  "text": "Luk 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inywe mwerinde, habwokuba balibahayo omu nkurato, balibaterra omu masorrokaniro; mulyemerra omumaiso g'abalemi n'ag'abakama habwange, mube bakaiso bange hali bo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.9",
            "verseOrgIds": [
              "MRK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakuru Amarungi gabanze garangirirwe omu mahanga goona. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.10",
            "verseOrgIds": [
              "MRK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu balibatwara, bakabahayo kutongana emisango, mutalitunturra ebi muligamba, baitu mugambe kyona eki muliheebwa omu kasumi ako; habwokuba tibali inywe abalyetonganirra, baitu mulitonganirirwa Mwoyo Ahikiriire. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.11",
            "verseOrgIds": [
              "MRK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu alihayo owanyina aitwe, na ise mwana alihayo omwana we, n'abaana baliimukirra abazaire baabo babaise; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.12",
            "verseOrgIds": [
              "MRK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.22"
              },
              "items": [
                {
                  "text": "Mat 10:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na inywe mulinobwa boona habwange. Baitu ogu aligumisiriza okuhika ha mpero, nuwe alijunwa.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.13",
            "verseOrgIds": [
              "MRK.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuhwerekerezibwa kwa Yerusaalemu",
          "type": "text"
        }
      ]
    },
