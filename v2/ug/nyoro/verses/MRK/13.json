                {
                  "text": "Yow 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'enyunyuuzi ez'omu iguru ziryeseesa hansi, n'amaani ag'omwiguru galitengesebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.25",
            "verseOrgIds": [
              "MRK.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
