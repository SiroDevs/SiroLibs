            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baitu emihito y'ebiro ebi obu erihwa, izooba lirisiikirizibwa omwirima, n'okwezi tikulijwa, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
