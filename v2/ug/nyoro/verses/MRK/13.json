              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.32",
            "verseOrgIds": [
              "MRK.13.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.36"
              },
              "items": [
                {
                  "text": "Mat 24:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baitu ekiro eki n'esaaha egi busaho n'omu abimanyire, noobu baakuba bamalaika ab'omwiguru, noobu yakuba Mwana wonyini, kwihaho Isenyowe wenka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.32",
            "verseOrgIds": [
              "MRK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwerinde, mwikale nimurora kandi musabe, habwokuba titumanyire akasumi ako nambere kalihikira. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.33",
            "verseOrgIds": [
              "MRK.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.36+LUK.12.37+LUK.12.38"
              },
              "items": [
                {
                  "text": "Luk 12:36-38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikisisana nk'omuntu arukugenda orugendo; obu aba naaruga omu ka asiga akwasize abaheereza be, buli omu omulimo ogu araakora; kandi aragira omukumirizi kwikara naalinda. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.34",
            "verseOrgIds": [
              "MRK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki, mwikale nimurora, habwokuba timumanyire kasumi nyineeka akaliiziramu: asobora kwija omu kairirizi rundi omu itumbi rundi enkoko niikooka, rundi omu rukyakya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.35",
            "verseOrgIds": [
              "MRK.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba aija aleke kubagwamu akasanga mugwijagiire. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.36",
            "verseOrgIds": [
              "MRK.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekindukubagambira, nikyo ngambira n'abandi boona nti: Mwikale nimurora.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.37",
            "verseOrgIds": [
              "MRK.13.37"
            ]
          }
        }
      ]
    }
