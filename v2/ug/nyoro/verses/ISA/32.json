{
  "id": "ISA.32",
  "number": "32",
  "bookId": "ISA",
  "reference": "Is 32",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
