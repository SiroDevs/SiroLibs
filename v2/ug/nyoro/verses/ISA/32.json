      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukama omurungi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dora, halibaho omukama alirema naahondera obulyo, kandi ababiito abanyoro balirema nibakuraatira obwinganiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.1",
            "verseOrgIds": [
              "ISA.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli omu alisisana nk'ekiikaro eky'okweserekamu, alisisana nk'akabira ak'okweserekamu arugire omu ihunga, alisisana nk'ebyambu by'amaizi omu kiikaro ekyomere, alisisana nk'ekiituuru eky'omwandara omukooto omunsi etaina rwezo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu, abo abarukurora tibaliigara amaiso kandi abo abarukuhurra balihurra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.3",
            "verseOrgIds": [
              "ISA.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abanyakukwata bugubugu balyega kucwa ekihikire, ebiteta balibaza bwango kandi nibatereekereza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omudoma taligaruka kwetwa muntu w'ekitiinisa, kandi encwangya teriheebwa kitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.5",
            "verseOrgIds": [
              "ISA.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba omudoma abaza eby'obudoma, kandi aikara naacika kukora ebibi; kukora ebintu ebitarumu kwikiriza Ruhanga, kubaza eby'ebisuba hali MUKAMA, abarukurumwa enjara, abaleke n'enjara yabo, ab'iroho abaime amaizi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikorwa by'omuntu encwangya, biba bibi; ateekereza kukora ebibi okuhwerekereza abanaku n'abahangirra, omuseege noobu aba naabaza ebihikire. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omuntu omurungi, abaza ebintu ebirungi, kandi ebintu ebirungi nibyo agumiraho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakazi inywe abeetwara bakeegarra, muhurre eki ndukugamba; baisiki inywe abarukwemanyaho, mutege amatu muhurre ebi ndukubaza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omu biro ebirukuhondera omwaka gumu, mulituntuzibwa inywe abakazi abeeremi; baitu amagesa galibura ebijuma tibiritaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutukumire, inywe abakazi abalekiirwe, mwekange inywe abeeremi; mujuule engoye zanyu zoona, musigale busa, mweteege eguniya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweteere ebifuba habw'obusaalizi, habwokuba emisiri ey'orwezo n'ebijuma eby'emizabbibbu bihwerekeriire, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi itaka ly'abantu bange limezirweho amahwa n'akakwatango; mulirirre amaju goona agakaba garumu abantu bali omukusemererwa okutagambwa, mulirirre orubuga orukaba rurumu okwegonza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba ekikaali nikiija kufurukwamu, orubuga orunyakwikarwamu abantu abaingi, nirwija kusigara kwonka; akasozi n'omunaara ogunyakulindirwamu, biriba maingira ag'ebiro byona, biriba kiikaro entulege eki ziraayenjerramuga, biriba iriisizo nambere amagana garaaliiraga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.14",
            "verseOrgIds": [
              "ISA.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.14",
            "verseOrgIds": [
              "ISA.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu MUKAMA aligaruka atutwekere Mwoyo we. Irungu lirifooka ly'orwezo, emisiri eyerwemu ebyokulya bingi, kandi omusiri ogu ogwezirwemu ebyokulya ebingi, baligweta kibira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.15",
            "verseOrgIds": [
              "ISA.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwinganiza, nubwo buliitaaha bwikale omw'irungu, n'okuhikira omu musiri ogurukwana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.16",
            "verseOrgIds": [
              "ISA.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuhikirra kulirugwamu obusinge, kuteekana n'obwesige ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.17",
            "verseOrgIds": [
              "ISA.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bange baliikara omunsi ey'obusinge omu biikaro ebirumu okugwagwana, ebitarumu toko kandi ebirukuhuumuza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.18",
            "verseOrgIds": [
              "ISA.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibira kyona kirigwa kihweho, n'orubuga rulihwerekerra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.19",
            "verseOrgIds": [
              "ISA.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muli bahiirwa inywe abanyakusiga haihi n'amaizi gonka, abanyakuleka ente n'endogoyi ikalya bugana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.20",
            "verseOrgIds": [
              "ISA.32.20"
            ]
          }
        }
      ]
    }
  ],
