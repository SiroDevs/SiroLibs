          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkooku ebisunga byokebwa akasasaazi k'omurro, n'abantu ab'obusobozi nukwo balihwerekerezibwa bati ebikorwa byabo ebibi, busaho muntu alibajunira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.31",
