            "number": "21",
            "style": "v",
            "sid": "ISA 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubuga orukaba ruli rwesigwa, murole nkooku rwafookere rusiihani! Oru, orukaba rurumu obwinganiza n'oburungi, hati nurwo rurukuraaza abaisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.21",
            "verseOrgIds": [
              "ISA.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efeeza yawe efookere byenga, eviini yawe efurungwirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.22",
            "verseOrgIds": [
              "ISA.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyoro baawe beemere kandi bateeraine n'abasuma. Boona nibenda enguzi kandi nibaitanira kuheebwa ebisembo. Tibarukurwanirra nfuuzi kandi tibarukuhurra bafaakati.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.23",
            "verseOrgIds": [
              "ISA.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
