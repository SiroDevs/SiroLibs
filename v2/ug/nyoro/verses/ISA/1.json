          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba, mulisisana omuhomozi oguhotokere ebikoora, mulisisana nk'omusiri ogutaitirirwa maizi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.30",
            "verseOrgIds": [
              "ISA.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
