          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulikwatwa ensoni habw'emiti emihomozi mwagonzaaga muno muti; kandi muliswara habw'emisiri ei mwayegomboize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.29",
            "verseOrgIds": [
              "ISA.1.29"
            ]
          }
        },
        {
          "name": "verse",
