        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siyoni rulicungurwa n'obwinganiza, kandi n'abo abarurumu abalyehana, balijunwa oburungi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.27",
            "verseOrgIds": [
              "ISA.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu abeemi n'enkozi z'ebibi balihwerekerezibwa hamu kandi n'abo abafuruka MUKAMA balihwerekerezibwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.28",
            "verseOrgIds": [
              "ISA.1.28"
            ]
          }
        }
      ]
    },
