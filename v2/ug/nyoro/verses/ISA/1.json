              "ISA.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki MUKAMA, MUKAMA ow'amahe, Ogu ow'obusobozi owa Isirairi naagamba ati: “Ndibiihirirwa abanyanzigwa bange, kandi ndihoora enzigu abazigu bange. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.24",
            "verseOrgIds": [
              "ISA.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyija kukukwataho, ninyija kukusemeza nk'ekyoma oku kisemezibwa omurro, nukwo nkwihemu obubi bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.25",
            "verseOrgIds": [
              "ISA.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikugarurra abacwi b'emisango n'abahi b'amagezi, abarukusisana nk'abokaba oinabo okubanza. Hanyuma, nubwo olyetwa orubuga orurungi, orubuga orwesigwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.26",
            "verseOrgIds": [
              "ISA.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.26",
            "verseOrgIds": [
              "ISA.1.26"
            ]
