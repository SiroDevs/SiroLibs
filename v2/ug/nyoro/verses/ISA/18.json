              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.2.12"
              },
              "items": [
                {
                  "text": "Zef 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai bambi, nsi iwe erukuhulirwamu amapapa agarukuhuuma, ey'obuseeri bw'ebisaaru by'Esopiya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwe anyakutuma engabwa noozirabya ha kisaaru Nairo, omu maato ag'ebifunjo! Inywe abakwenda abarukwanguha mugende omu ihanga ery'abantu abaraihire kandi abaina omubiri omurungi, abantu abarukutiinwa aba haihi n'aba hara, ihanga ery'amaani kandi erinyakusingura, erinyakwina ensi erukubaganizibwamu ebisaaru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe inywena abantu ab'ensi yoona, inywe abanyakwikara omunsi, ebendera obu eriimukibwa ha mitwe y'ensozi, mufundule amaiso! Obu mulihurra engwara yagamba, mutege amatu! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba MUKAMA akangambira ati: “Ndyema omwiguru, ndole eby'omunsi, mporampora nk'orume oku rugwa omu bwire bw'ekiro oburukutagata obw'akasumi k'igesa, ninzooka kurungi nk'omusana oku gujwa omu bwire bw'ihangwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba orwakyo obu rulimara kuragalika, igesa litakahikire, kandi ebijuma bitakengere, omunyanzigwa alihwerekereza bwango Abasuudani nkooku omuhyo gwiha amataagi ha muzabbibbu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emitumbi ey'abaserikale baabo, eriikara aho omu burangasa, esomwe amanyonyi, ekaturwe n'enyamaiswa ez'omu kisaka. Amanyonyi galigyehiira omu kasumi k'ekyanda, kandi enyamaiswa omu irumbi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi ako, abantu abaraihire kandi abaina emibiri erukuterra, abantu abayakutiinwa aba haihi n'aba hara, ihanga ery'amaani kandi erinyakusingura, erinyakwina ensi enyakubaganiziibwemu ebisaaru, nubwo lirirabuka ebisembo MUKAMA ow'amahe, babitwale ha rusozi Siyoni, ekiikaro MUKAMA Ow'obusobozi bwona eki aramizibwamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    }
  ],
