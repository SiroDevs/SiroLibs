          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA, Ow'obusobozi bwona, naija kubateera hansi nk'amataagi agatemerwe ha muti. Abakirra kimu okwekuliiriza n'abakirra kimu ekitiinisa nibaija kubundaazibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.33",
            "verseOrgIds": [
              "ISA.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ISA 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alibatema n'endemu nk'emiti ey'omu kibira hagati, bagwe nk'emiti emirungi muno eya Lebbanooni oku egwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.34",
            "verseOrgIds": [
              "ISA.10.34"
            ]
          }
        }
