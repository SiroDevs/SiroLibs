            "number": "4",
            "style": "v",
            "sid": "ISA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.4",
            "verseOrgIds": [
              "ISA.10.4"
            ]
          }
        },
        {
