            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Hezekiya yagarukiremu Isaaya ati: “Ekigambo kya MUKAMA eki ongambiire kirungi.” Habwokuba akateekereza ati: “Omu kasumi kange, halibaho okuteekaana n'okugwagwana.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
