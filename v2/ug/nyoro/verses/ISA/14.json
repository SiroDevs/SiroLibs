              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emizigaijo ey'abanaku eriiguta, kandi abaseege balitunga obusiinge; baitu abaijukuru bawe ndibaisa enjara, kandi abantu bawe boona abaasigaireho ndibaita.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.30",
            "verseOrgIds": [
              "ISA.14.30"
            ]
