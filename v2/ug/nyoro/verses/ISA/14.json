            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA ow'amahe arahiire ati: “Eki nategekere nikyo kiribaho, kandi eki nahanwire, nikyo kirikorwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.24",
            "verseOrgIds": [
              "ISA.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndihwerekereza Abasiriya omunsi yange eya Isirairi, abarubaatiririrre ha nsozi zange. Abantu ndibajuna Abasiriya, mbaiheho emitumba ei bakaba bali b'okwetweka.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.25",
            "verseOrgIds": [
              "ISA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egi niyo entegeka yange, ei nategekiire ensi yoona; kandi ogu nugwo mukono gwange ogu ngoroire kugifubira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.26",
            "verseOrgIds": [
              "ISA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA ow'amahe eki yategekere, n'oha asobora kukidibya? Agoroire omukono gwe, n'oha asobora kugugarra enyuma?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.27",
            "verseOrgIds": [
              "ISA.14.27"
            ]
          }
        }
      ]
