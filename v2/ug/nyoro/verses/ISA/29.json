            "number": "23",
            "style": "v",
            "sid": "ISA 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba obw'araaroraga abaana be abanahangire bali omuli bo baraakugizaaga Arukwera muno, Ogu owa Yakobbo. Nukwo batiine Ruhanga owa Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
