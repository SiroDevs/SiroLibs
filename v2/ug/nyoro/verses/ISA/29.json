          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abadoma nubwo balibanza kwetegereza kandi abo abaikara nibatontoroma nubwo balyegesibwa.”",
          "type": "text",
          "attrs": {
