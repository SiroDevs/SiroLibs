                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alekizanda, omuheesi w'emiringa, akankora kubi muno; MUKAMA alimusasura habw'ebi yakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na iwe omwerinde, habwokuba enyegesa yaitu akagihakaniriza kimu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
          }
        }
      ]
    },
    {
