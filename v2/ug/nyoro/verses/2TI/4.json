              "type": "text"
            }
          ]
        },
        {
          "text": "Luka wenka nuwe nsigaire nawe. Yeta Maliko, oije nawe; habwokuba nangasira muno omu gw'obuheereza. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
            "verseOrgIds": [
              "2TI.4.11"
            ]
