                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.8+ACT.14.9+ACT.14.10+ACT.14.11+ACT.14.12+ACT.14.13+ACT.14.14+ACT.14.15+ACT.14.16+ACT.14.17+ACT.14.18+ACT.14.19+ACT.14.20"
              },
              "items": [
                {
                  "text": "Ebik 14:8-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuhiiganizibwa kwange n'okubonesibwa kwange. Noomanya ebyangweriire omu Antyokiya, Ikoniyo, na Lisitura; okuhiiganizibwa kwona oku naagumiisiriize! Baitu ebi byona MUKAMA akabinjuna. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.11",
            "verseOrgIds": [
              "2TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazimakwo boona abarukwenda kukuza obwomeezi baahairwe Ruhanga nibakuraatira Kristo Yesu, bali b'okuhiiganizibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.12",
            "verseOrgIds": [
              "2TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi ako abantu enkozi z'ebibi kandi engobya balyeyongera kuba babi, nibabiiha abandi kandi nabo nibabiihwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.13",
            "verseOrgIds": [
              "2TI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu iwe ogumire hali ebi wayegere kandi ebi waikiririize kimu, noomanya ayabikwegeseze. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.14",
            "verseOrgIds": [
              "2TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga omu buto, Ebihandiiko Ebirukwera bikakumanyisa ebisobora kukuhabura bikakuhikya ha kujunwa okuleetwa okwikiriza Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.15",
            "verseOrgIds": [
              "2TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebihandiiko Ebirukwera byona bihandiikisibwa Ruhanga, kandi bigasa omu kwegesa eby'amazima, omu kuhana abahabire, okuhabura, n'okutendeka abantu omu buhikiriire, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.16",
            "verseOrgIds": [
              "2TI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nukwo omuntu wa Ruhanga azooke nkooku ayegesebwa kwo, aina byona ebirukwetaagwa okukora omulimo gwona omurungi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.17",
            "verseOrgIds": [
              "2TI.3.17"
            ]
          }
        }
      ]
    }
