{
  "id": "1SA.6",
  "number": "6",
  "bookId": "1SA",
  "reference": "1 Sam 6",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "1SA 6"
      },
      "items": [
