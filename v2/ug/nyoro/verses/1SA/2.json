              "1SA.2.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.46.13"
              },
              "items": [
                {
                  "text": "Sir 46:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.52"
              },
              "items": [
                {
                  "text": "Luk 2:52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwojo oli Samwiri, yagenda naayeyongera kukura omu maani, omukugonzibwa MUKAMA n'abantu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri akaizirwa omuntu wa Ruhanga yamugambira ngu: “MUKAMA naagamba ati: ‘Swenkuru Arooni hamu neeka ye obu bakaba bali bairu ba Faraaho omukama wa Misiri, nkamweyoleka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.1+EXO.28.2+EXO.28.3+EXO.28.4"
              },
              "items": [
                {
                  "text": "Kurug 28:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.35"
              },
              "items": [
                {
                  "text": "Lev 7:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu nganda zoona eza Isirairi, nuwe nkomere abe nyakatagara wange, nuwe atembege ha itambiro lyange kwokya obubbani, kujwara efodi",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:28",
              "type": "text"
            },
            {
              "text": "efodi",
              "type": "text"
            },
            {
              "text": "kyabaga kijwaro kyabanyakatagara",
              "type": "text"
            }
          ]
        },
        {
          "text": " omumaiso gange; enju ye nkagiha obusobozi obw'okutwaraga ebyonzira ebinyakwokebwa ha itambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwaki mwikara nimururukira ebyonzira n'ebihongwa byange ebinaragiire, okankiza abaana bawe, nukwo kubaikiriza kulya ebirukukirra kimu obwingi, abantu bange Abaisirairi ebibampongera?’ ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, MUKAMA Ruhanga owa Isirairi naagamba ati: ‘Nkanihiza nti enju yawe neeya swenkuru, nizo ziramperezaaga nizikora omulimo gw'obunyakatagara ebiro byona’; baitu hati naagamba ati: ‘Eki kitalibaho! Habwokuba abanyakuntamu ekitiinisa, na nyowe mbatamu ekitiinisa, kandi abanyakungaya mbagaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.30",
            "verseOrgIds": [
              "1SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati nu omanye, akasumi kali haihi, nyite abasaija abato boona ab'ekika kyawe n'ab'oruganda rwawe, omu kika kyawe, nukwo habulemu omuntu noomu alikura akagurusa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oliizirwa emihito, okwatwe ihali noorora emigisa ei ndiba nimpa abantu kubamu omuntu ow'alikura akagurusa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.32",
            "verseOrgIds": [
              "1SA.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu omu hali inywe ou ntaliiha ha itambiro lyange, ogu aliganyirwa, aikalege narra, amaziga gamwite amaiso, kandi omutima gwikalege nigumusarra; abantu abandi boona abalyeyongera omunju yawe, abantu abandi balibaisa empirima. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.33",
            "verseOrgIds": [
              "1SA.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.11"
              },
              "items": [
                {
                  "text": "1 Sam 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekirigwera batabani bawe ababiri Hofuni na Finehaasi, eki nikyo olimanyiraho. Boombi balifeera ha kiro kimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.34",
            "verseOrgIds": [
              "1SA.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndyekomera nyakatagara omwesigwa, ogu nuwe araakoraga kyona ekindukutegeka n'ekindukugonza; ndimwombekera enju enyakugumire, nuwe araayebeemberaga omuseeswaho magita wange ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.35",
            "verseOrgIds": [
              "1SA.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ondi weena ow'omunju yawe alisigaraho, araijaga kumusabiriza akasente rundi akagaati. Nkwesengeriize, onte omukiikaro kimu ha biikaro by'abanyakatagara, na nyowe nukwo nsobole kulyahoga akagaati.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.36",
            "verseOrgIds": [
              "1SA.2.36"
            ]
          }
        }
      ]
