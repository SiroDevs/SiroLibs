              "items": [
                {
                  "text": "18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubo abaisire MUKAMA Yesu n'abarangi, nubo baatubingire, baabiihiza Ruhanga kandi baahakaniza abantu boona. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatutanga kwegesa Abanyamahanga ebigambo ebisobora kubaleetera okujunwa, nukwo Abayudaaya kuhikiriza bati ebikorwa byabo ebibi. Baitu ekifubiro kya Ruhanga kirinzirwe kyabahikaho.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo naagonza muno kugaruka kubabungira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagenzi bange, obu tukaba twakabarugaho akacu kake twahukaniize emibiri etali myoyo, tukeekamba muno, twina ekihika kingi eky'okugaruka kubarora; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.17",
            "verseOrgIds": [
              "1TH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwokuba tukagonza kwija owaanyu. Nyowe Paulo nkalengaho emirundi nyingi, baitu Sitaani akantanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.18",
            "verseOrgIds": [
              "1TH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu nu, MUKAMA waitu Yesu obu aliija, okunihira kwaitu, okusemererwa kwaitu, n'ekondo yaitu ebirukutusiimisa omumaiso ge nibyo biha? Ti niinywe? ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.19",
            "verseOrgIds": [
              "1TH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba niinywe kitiinisa kyaitu n'okusemererwa kwaitu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.20",
            "verseOrgIds": [
              "1TH.2.20"
            ]
          }
        }
      ]
    }
