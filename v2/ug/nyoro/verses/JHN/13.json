          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.34"
              },
              "items": [
                {
                  "text": "Yoh 7:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baana bange, nkyali na inywe akacu kake. Nimwija kunserra; baitu nkooku naagambiire Abayudaaya, na inywe nukwo ndukubagambira nti: ‘Nambere ndukugenda, timulisobora kwijayo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.33",
            "verseOrgIds": [
              "JHN.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 13:34"
          },
          "items": [
