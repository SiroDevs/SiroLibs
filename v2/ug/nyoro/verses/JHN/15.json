{
  "id": "JHN.15",
  "number": "15",
  "bookId": "JHN",
  "reference": "Yoh 15",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
