              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.7"
              },
              "items": [
                {
                  "text": "Tha 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.3"
              },
              "items": [
                {
                  "text": "Tha 26:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13"
              },
              "items": [
                {
                  "text": "Tha 28:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mi maru Yehova Mungu peri, mi woro dwande, mi moko i kume de; kum en e kwo peri, man kabor mi nindo peri; kara ibed i ng’om ma Yehova kwong’o ni kwaru, ni Ibrahim, man ni Isak, man ni Yakobo, ya ebimio igi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.20",
            "verseOrgIds": [
              "DEU.30.20"
            ]
          }
        }
      ]
    }
  ],
