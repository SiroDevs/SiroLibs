              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek junwang’u ng’atu moko bekwalu utumin moko mi nyithindho mir Israel, man etimo kude calu ng’eca, kadi eloke; a jakwo maeno bilund tho: kab dubo woko kumeni kud i kindi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        }
      ]
    },
