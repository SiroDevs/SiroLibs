          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinde m’iteng’o yendulam peri, kud idok wi jange kendo; ebibedo ni umondo, man ni kic, man ni dhaku ma cware tho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.20",
            "verseOrgIds": [
              "DEU.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
