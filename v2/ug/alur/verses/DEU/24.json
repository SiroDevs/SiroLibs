        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Law 13:1-14:54\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bed ku weng’i kum tho mi joi, kara iketh cwinyi kud amora, man itim calku lembe ceke ma julam ku Julawi biponjowu ko: calu ang’olo igi, wuketh cwinywu kum timo kumeca. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.10"
              },
              "items": [
                {
                  "text": "Wel 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Poi kum gin ma Yehova Mungu peri timo kum Miriem dhu yo, kinde ma wuai kud i Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
      ]
    },
