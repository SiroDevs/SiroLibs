                }
              ]
            }
          ]
        },
        {
          "text": "Kinde m’ikayu mwoka peri i podho peri, man wii wil kum kumna i podhone, kud idok igame kendo: ebibedo ni umondo, man ni kic, man ni dhaku ma cware tho; kara Yehova Mungu peri mi mugisa iri kum tic ceke mi cingi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.19",
            "verseOrgIds": [
              "DEU.24.19"
            ]
          }
        },
