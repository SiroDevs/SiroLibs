            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kud isend jamiru ma mi sukulia ma jacan man jacanpiny, tek ebedo kind utumeru, kadi kind umondo peri ma gini i ng’om peri yo i dhugang’ peri: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi sukulia ire i nindone, kadok ceng’ de kud umwony i wie (kum en e jacan, man eketho cwinye i kume); emaru ywak i wii ba Yehova, man ebed ni dubo iri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
    },
