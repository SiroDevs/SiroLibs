            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.26"
              },
              "items": [
                {
                  "text": "Ai 22:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tek imio banja moko ni wedu, kud imond i ot pare nigamu mukwatu pare. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
            "verseOrgIds": [
              "DEU.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cung ku woko, e ng’atu m’imio banja ire biwodho mukwatu woko i beng’i. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.11",
            "verseOrgIds": [
              "DEU.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek en e ng’atu ma jacan, kud inind ku mukwatu pare; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.12",
            "verseOrgIds": [
              "DEU.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "dwok mukwatu pare kinde ma ceng’ upodho andha, kara enind i kendi pare, man emi mugisa iri: man ebibedo iri ni bedopwe i wang’ Yehova Mungu peri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.13",
            "verseOrgIds": [
              "DEU.24.13"
            ]
          }
        }
      ]
    },
