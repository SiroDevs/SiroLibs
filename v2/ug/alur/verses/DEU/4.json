                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento Yehova gamuwu, man ewodhowu woko kud i uka mi nyunyu, kud i Misiri, kara wubed ire ni dhanu mir aba, calu i ceng’ ma tin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.20",
            "verseOrgIds": [
              "DEU.4.20"
            ]
          }
        },
