                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.15"
              },
              "items": [
                {
                  "text": "27:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kara kud wunyothru giwu, man wutim giracwia m’angika iwu calu ayi gin moko, ayi mi co kadi mi mon, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.16",
            "verseOrgIds": [
              "DEU.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.23"
              },
              "items": [
                {
                  "text": "Rum 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ayi mi yedi moko ma ni wi ng’om, ayi mi winyo moko ma ju bombe ma ringo kor polo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.17",
            "verseOrgIds": [
              "DEU.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayi gin moko ma lak i ng’om, ayi rec moko ma ni i pi the ng’om; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.18",
            "verseOrgIds": [
              "DEU.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "man kara kud itwor weng’i i polo, man kinde m’ineno ceng’ ku dwi man cero, en e udul ceke m’i polo, iyweiri cen man irwo igi, itim: igi de, ma Yehova Mungu peri poko mi kodhidhanu ceke ma the polo ngung’. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.19",
            "verseOrgIds": [
              "DEU.4.19"
            ]
          }
        },
        {
