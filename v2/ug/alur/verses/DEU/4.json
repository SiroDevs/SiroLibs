            }
          ]
        },
        {
          "text": "Ka kumeno wubed ku weng’wu i kumwu giwu; kum wuneno ayi moko ki ngo i ceng’ ma Yehova yero iwu i Horeb kud i die mac; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.15",
            "verseOrgIds": [
              "DEU.4.15"
            ]
          }
        },
        {
