                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.7+DEU.15.8+DEU.15.9+DEU.15.10+DEU.15.11"
              },
              "items": [
                {
                  "text": "Poi 15:7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kud imi banja mi kuloka ni umeru; kuloka mi sente, kuloka mi cemo, kuloka mi gin moko ma jumio ni banja mi kuloka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icopo mio banja mi kuloka ni jawirok; ento kud imi banja mi kuloka ni umeru, kara Yehova Mungu peri mi mugisa iri i gin ceke m’iketho cingi i kume, i ng’om ka m’icidho i ie kara imwonye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        }
      ]
    },
