                "loc": "TIT.2.14"
              },
              "items": [
                {
                  "text": "Tit 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum in i dhanu ma leng’ ni Yehova Mungu peri: Yehova Mungu peri goyo wii kara ibed dhanu ni piny pare gire, ma sagu kodhidhanu ceke ma gini i wang’ ng’om. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ketho mer pare i kumwu ngo, kadi egoyo wiwu de ngo, kum wel mu sagu dhanu ceke; kum wu nok ma sagu kodhidhanu ceke: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.7",
            "verseOrgIds": [
              "DEU.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento kum Yehova maruwu, man kum eyenyo etim kwong’ m’ekwong’o ni kwaruwu, Yehova wodhowu woko ku cing’ ma tek, man ewaruwu kud i ot mi ng’eca, kud i cing’ Farao m’ubimo mi Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.8",
            "verseOrgIds": [
              "DEU.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.5"
              },
              "items": [
                {
                  "text": "Ai 20:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
