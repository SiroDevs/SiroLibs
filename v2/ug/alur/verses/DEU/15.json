            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek ebedo ku mulima moko, calu ma tek e jarabala, kadi abinga, en e mulima ma rac ceke, kud ilame ni Yehova Mungu peri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Came yor i dhugang’ peri: ju ma leng’ ungo ku ju ma leng’ de gibicame calacel, calu kasuku, man calu ruda. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.22",
            "verseOrgIds": [
              "DEU.15.22"
            ]
          }
        },
        {
