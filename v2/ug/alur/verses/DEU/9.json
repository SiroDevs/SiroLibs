            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.26"
              },
              "items": [
                {
                  "text": "Poi 1:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.16"
              },
              "items": [
                {
                  "text": "Ebr 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man kinde ma Yehova orowu kud i Kadec-barnea, ewacu kumae, Wuidh malu man wumwony ng’om m’amio iwu; wulund wujai kum lembang’ola pa Yehova Mungu mu, e wuyie ngo, kadi dwande de wuwinjo ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wujai ni Yehova ugambre i nindo m’amaku ng’eyowu i ie.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
