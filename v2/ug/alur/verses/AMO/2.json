                {
                  "text": "Poi 3:8-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento anyotho Jaamori i wang’gi, ma kaborne calu kabor mi musonge, man e tek calu bongu; ento anyotho nyinge ku malu, man ulage ku piny. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.9",
            "verseOrgIds": [
              "AMO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ke awodhowu kud i ng’om Misiri, man apeyowu rundi pier ang’wen i langa, kara wumwony ng’om pa Jaamori. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.10",
            "verseOrgIds": [
              "AMO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.1+NUM.6.2+NUM.6.3+NUM.6.4+NUM.6.5+NUM.6.6+NUM.6.7+NUM.6.8"
              },
              "items": [
                {
                  "text": "Wel 6:1-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ating’o wotwu ni jubila, man kind awobi mu ni Junaziri. Ebedo kumeno ngo, E nyithindho mir Israeli? Yehova wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.11",
            "verseOrgIds": [
              "AMO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento wumio pigulok ni Junaziri gimadhi, man wung’olo ni jubila, wuwacu kumae, Kud wueu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.12",
            "verseOrgIds": [
              "AMO.2.12"
            ]
          }
        }
      ]
    },
