              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wacu kumae: Mi gondri adek mi Yuda, eyo mir ang’wen, abiloko masendine cen ungo; kum gikwero cik pa Yehova, man gigwoko cik pare ngo, ndra migi ketho gikier, ma calu kwarugi wotho i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento abioro mac wi Yuda, man ebiwang’u udi mi ker mi Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        }
      ]
    },
