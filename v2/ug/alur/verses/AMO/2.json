          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen, abedo adia i thewu calu magali ma pong’ ku kumna bedo adia. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.13",
            "verseOrgIds": [
              "AMO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ringo ng’wec birwinyo ni jung’wec; man jatego bidwoko tego pare tek ungo; kadok jatego de bibodhre gire ngo; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.14",
            "verseOrgIds": [
              "AMO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadok ng’atu ma kilo atum de bicungo ngo; man ng’atu ma jang’wec ma ku tielo de bibodhre gire ngo; kadok ng’atu ma wotho ku riuni de bibodhre gire ngo; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.15",
            "verseOrgIds": [
              "AMO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ng’atu ma cwinye tek i kind jutego biringo muneru i ceng’ maeca, Yehova wacu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.16",
            "verseOrgIds": [
              "AMO.2.16"
            ]
          }
        }
