                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I rundi mir adege mi camuker pa Yehoiakim m’ubimo mi Yuda, Nebukadnezar m’ubimo mi Babeli bino Yerusalem, man etieke kud ali. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.17"
              },
              "items": [
                {
                  "text": "2 Ub 20:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
