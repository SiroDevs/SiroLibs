                "loc": "REV.1.14"
              },
              "items": [
                {
                  "text": "Nyu 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aneno maram juketho ko komker, man ng’atu m’uti mi ceng’ ujany: kendi pare tar calu pei, man yukwie calu yuk rombe ma leng’; komker pare lebmac m’uliel, ukobrene mac m’uliel. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.9",
            "verseOrgIds": [
              "DAN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.11"
              },
              "items": [
                {
                  "text": "Nyu 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.12"
              },
              "items": [
                {
                  "text": "Nyu 20:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulo mi mac ukadhu uai i wang’e: rubanga mi rubanga gitimo ire, man rubanga apar bang’ rubanga apar gicungo i wang’e: e juketho pokolembe, man juyabu kitabu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.10",
            "verseOrgIds": [
              "DAN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aneno i nindo maeca um dwal mi lembe ma dit ma tunge yero; aneno maram junego ko yedine, man maram junyotho ko kume de, man maram jumie ya juwang’e ku mac. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.11",
            "verseOrgIds": [
              "DAN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man pi dong’ yedi m’udong’, bimobim migi jukabu woko: ento nindo mi bedo migi jumedo mi oro man nindo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        }
      ]
    },
