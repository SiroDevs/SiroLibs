                "loc": "REV.12.14"
              },
              "items": [
                {
                  "text": "Nyu 12:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5"
              },
              "items": [
