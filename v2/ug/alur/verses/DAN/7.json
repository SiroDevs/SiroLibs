                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Nyu 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.14"
              },
              "items": [
                {
                  "text": "14:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aneno i ginmawokiwang’ mi diewor, man, nen, ng’atu acel ubino kind afuru m’i polo calu wod dhanu, man ebino cil ba ng’atu m’uti mi ceng’, man gikele ceng’ni i wang’e. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.13",
            "verseOrgIds": [
              "DAN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.15"
              },
              "items": [
                {
                  "text": "Nyu 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man jumio ire bimobim, ku dwong’, man ker, kara kodhidhanu ceke, man thek ceke, ku dhok ceke gitim ire: bimobim pare en e bimobim mi nja, ma bikadhu woko ngo, man ker pare en e ker ma jubinyotho ngo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.14",
            "verseOrgIds": [
              "DAN.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.14",
            "verseOrgIds": [
              "DAN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "An a Daniel, can unega i tipona i kuma, man ginmawokiwang’ mi wia ng’abu cwinya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.15",
            "verseOrgIds": [
              "DAN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acoro ceng’ni ng’atu acel m’i kind ju m’ucungo ceng’ni, man apenje pi lemandha mi maeni ceke. Ka kumeno eyero ira, man eketho ang’eyo thelembe mi ginduni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.16",
            "verseOrgIds": [
              "DAN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewacu kumae, Yedi ma dongo maeni, ma gin ang’wen, gin ubimo ang’wen, ma biai kud i ng’om. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.17",
            "verseOrgIds": [
              "DAN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.5"
              },
              "items": [
                {
                  "text": "Nyu 22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento jumaleng’ pa Ng’atu ma Malu Ngbir bijolo ker, man gibibedo wi ker nja, cil mi rondo ku rondo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alund ayenyo ang’ei lemandha pi yedi mir ang’wende, ma en e tung’ ku wadi ceke, jang’oi ndiri apila, ma lake nyunyu kwa, man wi lwete mola kwa; ma camu, ma turo nziki nziki, man ma nyono donge ku tiende; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.19",
            "verseOrgIds": [
              "DAN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "man pi tunge apar ma ni i wie, man tunge mange m’uidho malu, ma adek de podho i wang’e, cil tunge maeno m’ubedo ku wang’e, ku dhoge m’uyero gin ma dit, ma nenne dit ma sagu juwagi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.20",
            "verseOrgIds": [
              "DAN.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.7"
              },
              "items": [
                {
                  "text": "Nyu 13:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aneno, e tung maeno timo ali ku jumaleng’, man esagugi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.21",
            "verseOrgIds": [
              "DAN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
