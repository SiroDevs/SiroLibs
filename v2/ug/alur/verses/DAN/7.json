              },
              "items": [
                {
                  "text": "Nyu 20:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "maram ng’atu m’uti mi ceng’ uwok ko, e lembapoka mire ni jumaleng’ pa Ng’atu ma Malu Ngbir, man nindo wok ma jumaleng’ ucamu ie ker.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
            "verseOrgIds": [
              "DAN.7.22"
            ]
          }
        }
