          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31+EXO.25.32+EXO.25.33+EXO.25.34+EXO.25.35+EXO.25.36+EXO.25.37+EXO.25.38+EXO.25.39+EXO.25.40"
              },
              "items": [
                {
                  "text": "Ai 25:31-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man thethala, abic i ng’ete ma yor acwic, man abic yor acam, i wang’ kayerlembe, mi mola ma kwar ma leng’; man thiuboko, ku thala, ku makasi, mi mola ma kwar; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "man kikombe, ku makasi, man tabu, ku lapau, man jamb mac, mi mola ma kwar ma leng’; man utwindi mi dhugola, mi ot ma yor i ie, ma en e ka ma leng’ m’usagu, man mi dhugola mi ot, ma en e hekalu, mi mola ma kwar.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.50",
            "verseOrgIds": [
              "1KI.7.50"
            ]
          }
        }
