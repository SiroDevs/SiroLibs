            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Suleman utimo agulu ceke ma ni i ot pa Yehova: ku pemblam mi mola ma kwar, man mesa mi mola ma kwar, ma kwen m’anyutha ni i wie; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
