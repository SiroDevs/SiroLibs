                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Can i wigi! kum gikwanyu yo pa Kain, man gikonjri vur i kier pa Balam kara ginwang’ sukulia, e girwinyo i piem pa Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.11",
            "verseOrgIds": [
              "JUD.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JUD 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joni gi kidi m’upandre i cemo mi mer mu kinde ma wucamu wukugi, gi jukwac ma kakri gigi ma lworo mbe kugi; gin afuru ma pi mbe i igi, ma yamu cidho kudo; gi yen mi oro ma nyinge mbe, m’utho wang’ ario, ma jufudho woko kud ulage; ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.12",
            "verseOrgIds": [
              "JUD.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JUD 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "gi mukura m’i nam ma dhongo, ma gibedhuro lewic migi gigi; gi cero m’ubewire rr, ma mudho ma col bii kandre igi mi rondo ku rondo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.13",
            "verseOrgIds": [
              "JUD.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JUD 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.5.18"
              },
              "items": [
                {
                  "text": "Tha 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.5.21+GEN.5.22+GEN.5.23+GEN.5.24"
              },
              "items": [
                {
                  "text": "21-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man Enok bende, ma ng’atu mir abirone yo ng’ei Adamu, eewo ni joni, ewacu kumae, Nen, Rwoth ubino ku jupare ma leng’ rubanga apar, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.14",
            "verseOrgIds": [
              "JUD.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JUD 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipoko lembe wi ceke, man nipoko lembe wi ju ma ayi Mungu mbe kugi ceke kum tic migi ceke ma ayi Mungu mbe i kume, ma gitimo ma ayi Mungu mbe ko, man pi gin ma tek ceke ma judubo ma ayi Mungu mbe i kumgi giyero pire. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.15",
            "verseOrgIds": [
              "JUD.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JUD 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joni gi jung’ur, gi jupir, ma gilubo tok awanya migi ma rac (ma dhoggi yero lembe ma dit ma yenyo) ma dhanu bedo tung’ tung’ i wang’gi ni kum kuloka.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.16",
            "verseOrgIds": [
              "JUD.1.16"
            ]
          }
        }
      ]
    },
