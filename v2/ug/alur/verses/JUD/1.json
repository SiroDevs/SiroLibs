              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento wun, jumer, wupoi pi lembe ma yang’ alar ayero ni kum jukwenda pa Rwoth mwa ma Yesu Kristu; ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.17",
