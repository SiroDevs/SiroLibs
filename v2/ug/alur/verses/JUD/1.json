        },
        {
          "text": "Ento Mikael ma en e malaika ma jadit, kinde ma gi-ii giku wonabau epiemo pi kum Musa, cwinye tek ungo m’ekelo ko lembapoka mi cac i wie, ento ewacu kumae, Dong’ Rwoth ujuki. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JUD 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endre joni gicayu gin ma tek ging’eyo ngo: man gin ma ging’eyo ma ku kum ginyothri i ginde, calu yedi ma rieko mbe kugi. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
