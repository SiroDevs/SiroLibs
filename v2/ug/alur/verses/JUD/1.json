        },
        {
          "text": "Yuda, jamiru pa Yesu Kristu, m’umin Yakobo ni ju ma julwong’ogi, ma gi jumer i Mungu ma Wego, ma jugwoko de pi Yesu Kristu: ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JUD 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisa man kwiocwiny ku mer umedre iwu.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        }
      ]
    },
    {
