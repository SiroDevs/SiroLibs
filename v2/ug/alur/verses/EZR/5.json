                "loc": "ZEC.1.1"
              },
              "items": [
                {
                  "text": "Zek 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nie jubila, Hagai ma jabila, man Zekaria ma wod Ido, giewo ni Juyahudi ma gini i Yuda ku Yerusalem; i nying’ Mungu mir Israel giewo igi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.12"
              },
              "items": [
                {
                  "text": "Hag 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.6+ZEC.4.7+ZEC.4.8+ZEC.4.9"
              },
              "items": [
                {
                  "text": "Zek 4:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zerubabel ma wod Cealtiel, man Yecuwa ma wod Yozadak, ulund uai man gimaku gomo ot pa Mungu ma ni i Yerusalem man jubila pa Mungu gini karacelo kugi, ma gibekonyogi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindo maeca Tatenai, ma jabim ma loka Kulo, ebino i bang’gi, ku Cethar-bozenai, man juwagi, man giwacu igi kumae, Ng’a mio iwu ng’ol ya wugom ot maeni, wudar gang’kidi maeni de? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.3",
            "verseOrgIds": [
              "EZR.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walund wayero igi calu maeni, ya nying’ dhanu m’ubetimo ot maeni gi ng’a gi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.4",
            "verseOrgIds": [
              "EZR.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento wang’ Mungu migi ni wi judong’ Juyahudi, e giketho giweko ngo, cil ma lembene tundo ko ba Dario, e ka lembadwoka bidwogo ku waraga pire.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadi waraga ma Tatenai, ma jabim ma loka Kulo, man Cethar-bozenai, ku juwagi ma Juafarsaki, ma gini loka Kulo, gioro ba Dario m’ubimo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.6",
            "verseOrgIds": [
              "EZR.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "gioro waraga ire, ma jugoro ie kumae: Ni Dario m’ubimo, kwiocwiny ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.7",
            "verseOrgIds": [
              "EZR.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dong’ ubimo ng’ei, nia wamondo i ng’etker ma Yuda, ba ot pa Mungu ma dit, m’ugombre ku kidi ma dit, man juketho yen i kum kor ode; e tic maeni cidho kud amora man ebedo miero i cing’gi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.8",
            "verseOrgIds": [
              "EZR.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walund wapenjo judongo maeno, e wawacu igi kumae, Ng’a mio iwu ng’ol ya wugom ot maeni man wudar gang’ maeni? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.9",
            "verseOrgIds": [
              "EZR.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapenjogi ku nying’gi bende, kara waketh ing’ei, kara wagor nying’ dhanu ma judongo migi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.10",
            "verseOrgIds": [
              "EZR.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidwoko lembe iwa kumeni, giwacu kumae, Wan wa jutic pa Mungu m’i polo ku ng’om, man wabegomo ot ma yang’ jugomo con, rundine kadhu dupa m’ubimo ma dit mir Israel ugomo man edare. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.11",
            "verseOrgIds": [
              "EZR.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.8+2KI.25.9+2KI.25.10+2KI.25.11+2KI.25.12"
              },
              "items": [
                {
                  "text": "2 Ub 25:8-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20"
              },
              "items": [
                {
                  "text": "2 Kei 36:17-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.12+JER.52.13+JER.52.14+JER.52.15"
              },
              "items": [
                {
                  "text": "Yer 52:12-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento ma cen ka kwaruwa nyayu ng’ecwiny i Mungu m’i polo cil ni kwinyo, emiogi i cing’ Nebukadnezar m’ubimo mi Babeli, ma Jakaldayo, m’unyotho ot maeni, man etero dhanune i Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.12",
            "verseOrgIds": [
              "EZR.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.2+EZR.1.3+EZR.1.4+EZR.1.5+EZR.1.6+EZR.1.7+EZR.1.8+EZR.1.9+EZR.1.10+EZR.1.11"
              },
              "items": [
                {
                  "text": "Ezr 1:2-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento i rundi ma kwong’a pa Kuro m’ubimo mi Babeli, Kuro m’ubimo timo cik ya jugom ot pa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.13",
            "verseOrgIds": [
              "EZR.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man agulu mi mola ma kwar ku mi mola ma tar bende mi ot pa Mungu, ma Nebukadnezar uwodho kud i hekalu ma ni i Yerusalem, man ekelo i helaku mi Babeli, agulu nica Kuro m’ubimo wodho kud i hekalu mi Babeli, man jukethogi i cing’ ng’atu acel ma nyinge Cecbazar, m’eketho ni jabim; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.14",
            "verseOrgIds": [
              "EZR.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ewacu ire kumae, Gam agulu maeni, cidhi, kethgi i hekalu ma ni i Yerusalem, man wek ot pa Mungu gombre kakare. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.15",
            "verseOrgIds": [
              "EZR.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cecbazar nino lund ubino, e eguro the ot pa Mungu ma ni i Yerusalem: man ugambre i nindo maeca cil ku kawono egombre, man fodi ethum ungo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.16",
            "verseOrgIds": [
              "EZR.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno kawono, tek ebedo ber ni ubimo, dong’ juyeny i ot mi kakanpiny p’ubimo, ma ni keca i Babeli, tek ebedo kumeno, nia Kuro m’ubimo utimo cik ya jugom ot pa Mungu i Yerusalem; man wek ubimo or lembe ma ie yenyo i bang’wa pi lembe maeni.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.17",
            "verseOrgIds": [
              "EZR.5.17"
            ]
          }
        }
      ]
    }
  ],
