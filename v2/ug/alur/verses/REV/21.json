              "items": [
                {
                  "text": "Isa 60:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man thek biwotho i derne: man ju m’ubimo m’i ng’om bikelo dwong’ migi i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.24",
            "verseOrgIds": [
              "REV.21.24"
            ]
          }
        },
