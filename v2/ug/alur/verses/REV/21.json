                "loc": "ISA.60.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man adhurane can ceng’ umbe i kume, kadok mi dwi de, nia urieny i wie: kum dwong’ pa Mungu care, man thalane en e Nyathi Rombo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
            "verseOrgIds": [
              "REV.21.23"
            ]
          }
        },
        {
