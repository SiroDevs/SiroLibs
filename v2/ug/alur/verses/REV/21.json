                }
              ]
            }
          ]
        },
        {
          "text": "Man dhugolane bibedo acika ki ngo ku dieceng’ (kum diewor bibedo umbe keca): ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
