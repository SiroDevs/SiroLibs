          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ni malaika mi kanisa ma ni i Pergamo kieu kumae:",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
