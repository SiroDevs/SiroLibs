              },
              "items": [
                {
                  "text": "22:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ni malaika mi kanisa ma ni i Smurna kieu kumae:",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        }
