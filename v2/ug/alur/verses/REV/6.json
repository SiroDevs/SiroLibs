              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ju ma gin ubimo m’i ng’om, ku juker, ku jego ma dongo, ku julonyo, man jutego, ku ng’eca man paker kubang’gi nzu gipondo gigi i odcana man i kidi mi gudi; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
