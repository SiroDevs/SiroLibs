        },
        {
          "text": "Man aneno kan ealu ayi mir abusiende, e digidi ma dit uyengre; man ceng’ udoko col calu gonia mi yuk diel ma mujuga, man dwi ceke doko calu rimo; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
