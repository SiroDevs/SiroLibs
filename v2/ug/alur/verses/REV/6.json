                "loc": "REV.16.20"
              },
              "items": [
                {
                  "text": "Nyu 16:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man polo kabre woko calu waraga m’ubedo adola; man gudi ku cula kubang’gi nzu ukabre ku kakagi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
