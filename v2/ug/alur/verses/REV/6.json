                  "text": "Isa 34:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man cero mi polo podho wi ng’om, calu yen mir ulam oyo nyinge ma fokucek ungo ku yamu ma dit m’uyengre. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
