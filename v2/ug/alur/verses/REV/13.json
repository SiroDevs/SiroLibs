                "loc": "REV.17.3"
              },
              "items": [
                {
                  "text": "Nyu 17:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.7+REV.17.8+REV.17.9+REV.17.10+REV.17.11+REV.17.12"
              },
              "items": [
                {
                  "text": "7-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ecungo wi kwio ma dhu nam. Man aneno yedi ai i nam, ma tunge apar wie ke abiro, man jamkermiwic apar ni wi tunge, man nying’ mir acidi ni i wie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.1",
            "verseOrgIds": [
              "REV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.4+DAN.7.5+DAN.7.6"
              },
              "items": [
                {
                  "text": "Dan 7:4-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man yedine m’aneno ayine pamir ayi ng’u, man tiende pa tiend wai, dhoge ke pami dhu umvor: man ng’ec umio tego pare ire, ku komker pare, ku ng’ol ma dit. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.2",
            "verseOrgIds": [
              "REV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aneno wie acel calu juthume ni tho; man rem mi tho pare kei: man i ng’om ngung’ uwang’ lii kum yedine; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.3",
            "verseOrgIds": [
              "REV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "man girwo ni ng’ec, kum emio ng’ol pare ni yedi; man girwo ni yedine, giwacu kumae, Ng’a ma calu yedi maeni? man ng’a ma copo kiedo lwiny kude? ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.4",
            "verseOrgIds": [
              "REV.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.8"
              },
              "items": [
                {
                  "text": "Dan 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "11:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man jumio ire dhok ma yero gin ma dit ku lembacidi; jumio ng’ol de ire m’etim ko tic pare dwi pier ang’wen wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.5",
            "verseOrgIds": [
              "REV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man eng’amu dhoge mi lembacidi kum Mungu, m’ecid ko nyinge, ku hema pare, cil ju m’ubedo i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.6",
            "verseOrgIds": [
              "REV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.21"
              },
              "items": [
                {
                  "text": "Dan 7:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man jumio ire ya etim lwiny ku jumaleng’, eloi kogi de: man jumio ire ng’ol wi suru kubang’gi kubang’gi ku dhanu man dhok man thek. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.7",
            "verseOrgIds": [
              "REV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Zab 69:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man dhanu ceke m’ubedo wi ng’om birwo ire, ma nying’gi kugore ngo i kitabu mi kwo pa Nyathi Rombo ma juthumo ugambre i thek ma ng’om uthekre ko. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’atu ma tek ithe nuti, dong’ ewinji. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.9",
            "verseOrgIds": [
              "REV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "Yer 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.43.11"
              },
              "items": [
                {
                  "text": "43:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tek ng’atu moko en e jathebkol, e ecidho i kol: tek ng’atu moko binego ku palamularu, en de jubikonege be ku palamularu. Twiocwiny ku yioyic mi jumaleng’ ni keni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
            "verseOrgIds": [
              "REV.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
            "verseOrgIds": [
              "REV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aneno yedi mange ai i ng’om uidho malu; tunge ario calu pa nyathi rombo, man eweco calu ng’ec. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.11",
            "verseOrgIds": [
              "REV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimo ku ng’ol ceke pa yedi ma kwong’ane i wang’ yedine. Man eketho ng’om ku ju m’ubedo i ie de girwo ni yedi ma kwong’ane, ma rem mi tho pare kei. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.12",
            "verseOrgIds": [
              "REV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimo giranyutha ma dit, kara eketh cil mac uai i polo ulor i ng’om i wang’ dhanu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.13",
            "verseOrgIds": [
              "REV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebombo ju m’ubedo wi ng’om ni kum giranyutha ma jumio ire etim i wang’ yedi; m’ewacu ko ni ju m’ubedo wi ng’om, ya gitim ayi yedi m’ubedo ku rem ma jutong’e ko ku palamularu man ebedo kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.14",
            "verseOrgIds": [
              "REV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man jumio ire y a eyui lietho ire, cil ni ayi yedine, kara ayi yedine weci, kara dhanu ceke de ma girwo ngo ni ayi yedine juneggi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.15",
            "verseOrgIds": [
              "REV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man eketho ceke, ma thindho ku ma dongo, man julonyo ku jucan, man paker ku jumiru, ya juthei kiedo i cing’gi ma yor acwic, kadi i ternyimgi; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.16",
            "verseOrgIds": [
              "REV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "man kara ng’atu moko bed umbe ma copo ng’iewo gin moko ire kadi ma loko gin moko, ndhu ng’atu ma kiedo ni i kume, en e nying’ yedine kadi wel mi nyinge. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.17",
            "verseOrgIds": [
              "REV.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni rieko. Ng’atu ma won ng’eyong’ec, dong’ ekwan wel yedine; kum en e wel ng’atu moko: man wel pare en e dak abusiel ku pier abusiel wi abusiel.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.18",
            "verseOrgIds": [
              "REV.13.18"
            ]
          }
        }
      ]
    }
  ],
