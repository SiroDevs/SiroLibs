                "loc": "ISA.29.11"
              },
              "items": [
                {
                  "text": "Isa 29:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man aneno kitabu, ma jugoro ie ku yor i ng’eye de, m’emwondre ki kud ayi abiro, i cing’ ng’atu m’ujany wi komker ca ma yor acwic. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aneno malaika ma tek m’ubeyero ku dwal ma dit kumae, Ng’a m’uromo m’eyabu ko kitabu, m’ealu ko ayine de? ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.2",
            "verseOrgIds": [
              "REV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ng’atu moko mbe i polo, kadi wi ng’om de, kadi the ng’om, ma copo yabu kitabune, kadi wie anena de. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.3",
            "verseOrgIds": [
              "REV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aywak dit, kum junwang’u ng’atu moko ngo m’uromo yabu kitabune, kadi wie anena de: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.4",
            "verseOrgIds": [
              "REV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.9"
              },
              "items": [
                {
                  "text": "Tha 49:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.1"
              },
              "items": [
                {
                  "text": "Isa 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
