                "loc": "ISA.11.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man ng’atu acel ma kind judongo wacu ira kumae, Kud iywaki: nen, Umvor ma en e mi suru pa Yuda, Ulag Daudi, eloyo m’eyabu ko kitabune kud ayine abiro de. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.7"
              },
              "items": [
                {
                  "text": "Isa 53:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.10"
              },
              "items": [
                {
                  "text": "Zek 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man aneno Nyathi Rombo i kind komker man i kind yedi ma kwo ang’wen, man i kind judongo, ecungo, calu ma tek juthume, ma tunge abiro, wang’e de abiro ma gi Tipo abiro pa Mungu, ma juoro i ng’om yu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebino, eting’e kud i cing’ ma yor acwic pa ng’atu m’ujany wi komker ca. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.141.2"
              },
              "items": [
                {
                  "text": "Zab 141:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man kan edaru ting’o kitabune, e yedi ma kwo ang’wen ku judongo pier ario wi ang’wende gipodho piny wang’ Nyathi Rombo, ma adungu ni kubang’gi nzu, ku tabu mi mola ma kwar ma gin ma ng’wice ng’ar upong’ i ie, ma en e rwo mi jumaleng’. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.8",
            "verseOrgIds": [
              "REV.5.8"
            ]
          }
        },
        {
