              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ewacu kumae, Kud wutim ng’om rac, kadok nam, kadi yedhi, ma fodi wakuketho ayi temyim jumiru pa Mungu mwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man awinjo wel ju ma juketho ayi i kumgine, rubanga dak acel ku pier ang’wen wi ang’wen, ma juketho ayi i kumgi kud i suru mi nyithi Israel kubang’gi nzu:",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        }
      ]
