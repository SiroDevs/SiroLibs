              "type": "text"
            }
          ]
        },
        {
          "text": "Maeno ma nuti ugambre ku kwong’a, maeno ma wawinjo, maeno ma waneno ku wang’wa, maeno ma waneno tel, ma cingwa de mulo, pi Lembe mi kwo ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
        {
