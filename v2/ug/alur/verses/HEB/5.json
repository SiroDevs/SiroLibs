              "attrs": {
                "loc": "LUK.22.39+LUK.22.40+LUK.22.41+LUK.22.42+LUK.22.43+LUK.22.44+LUK.22.45+LUK.22.46"
              },
              "items": [
                {
                  "text": "Lk 22:39-46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "En ma i ceng’ maeni mi kume, nwang’u ewodho rwo ni Mungu ku kwayukwac ma ku ywak ma tek ku piwang’ ni ng’atu ma copo lare ni tho, m’ewinjre de ni kum lworo pare ma ayi Mungu ni i kume, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadok en e Wod, ento egamu ng’eyo woro ni kum gin m’esendre kudo; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.8",
            "verseOrgIds": [
              "HEB.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "en ma judaru dwoke ndhu cu, edoko jathekboth ma rondo ku rondo ni ju ma giwore ceke; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9",
            "verseOrgIds": [
              "HEB.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "m’elwongre ku Mungu ni jalam ma dit calu wagi pa Melkizedek.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        }
      ]
    },
