              "items": [
                {
                  "text": "5:22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum wubino ngo ba got ma jucopo mulo, man m’uwang’ ku mac, man ni piny ma col bii, ku mudho, man wavuvu, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku dwand agwara, ku dwal mi lembe; ma ju ma giwinjo dwal maeno gikwayu ya ku juyer lembe moko mange igi; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.19",
            "verseOrgIds": [
              "HEB.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 12:20"
          },
          "items": [
