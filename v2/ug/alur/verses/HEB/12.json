              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.12"
              },
              "items": [
                {
                  "text": "Ai 19:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kum winjo lembe ma jung’olo kumae cire igi ngo, Tek cil yedi mulo got, jubicanye ku kidi; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.19"
              },
              "items": [
                {
                  "text": "Poi 9:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man giranena maeno bedo ni lworo apila kumeno, ketho Musa wacu kumae, Lworo benega apila kuma bemiel de: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
            "verseOrgIds": [
              "HEB.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "endre wun wubino ba got Sayuni, ni adhura de pa Mungu ma kwo, Yerusalem m’i polo, man ni udul malaika ma kwandre ngo, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
              "HEB.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ba cokri ma yu ku kanisa mi kayu ma jugoro i polo, man ni Mungu ma Japok mi jo ceke, man ni tipo mi weg bedopwe ma judwoko cu ma ndhu, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.23",
            "verseOrgIds": [
              "HEB.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.10"
              },
              "items": [
                {
                  "text": "Tha 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man ni Yesu ma jarib mi lembariba ma nyen, man ni rimo ma akira ma yero ber ma sagu pa Habil. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.24",
            "verseOrgIds": [
              "HEB.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.22"
              },
              "items": [
                {
                  "text": "Ai 20:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wunen nia kud wukwer ng’atu m’ubeyero. Kum tek giboth ungo ka gikwero ng’atu m’utwong’ogi i ng’om, e wan ma walokra ku ba ng’atu m’utwong’owa kud i polo wabiboth ungo ma sagu dit: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.6"
              },
              "items": [
                {
                  "text": "Hag 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma dwalne yengo ng’om i nindo maeca: ento kawono eng’olo ewacu kumae, Ento wang’ acel kendo abiyengo ng’om kende ngo, ento polo bende. ",
          "type": "text",
          "attrs": {
