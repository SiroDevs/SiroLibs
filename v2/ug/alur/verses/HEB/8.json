        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.12",
            "verseOrgIds": [
              "HEB.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
