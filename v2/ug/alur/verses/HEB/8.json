          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum ewacu kumae, Lembariba ma nyen, eketho ma kwong’a ti. Ento maeno ma kare bekadhu man m’ubeti e ceng’ni kadhu woko.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.13",
            "verseOrgIds": [
              "HEB.8.13"
            ]
          }
        }
