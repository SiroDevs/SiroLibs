                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Law 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum lembe nini, Kud igier gier, Kud ineg nek, Kud ikwal kwo, Kud iketh cwinyi hai kum piny, man tek lembang’ola moko mange nuti, ecokre i lembe maeni, e eni, Ibimaru wedu calu imeri giri. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mer timo rac ungo kum wadi: ka kumeno mer en e timbre kakare mi cik.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
