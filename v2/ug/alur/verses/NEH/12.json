          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "pa Abija, Zikri; pa Miniamin, pa Moadia, Piltai; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.17",
            "verseOrgIds": [
              "NEH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "pa Bilga, Camua; pa Cemaya, Yehonathan; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.18",
            "verseOrgIds": [
              "NEH.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
