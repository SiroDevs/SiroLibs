            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "pa Ido, Zekaria; pa Ginethon, Meculam; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.16",
            "verseOrgIds": [
              "NEH.12.16"
            ]
          }
        },
