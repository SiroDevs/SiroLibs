          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "pa Harim, Adna; pa Merayoth, Helkai; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.15",
            "verseOrgIds": [
              "NEH.12.15"
            ]
          }
        },
        {
