          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man i ceng’ pa Yoiakim julam nuti, ma gi wi udi pa weggi: pa Seraya, Meraya; pa Yeremia, Hanania; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12",
            "verseOrgIds": [
              "NEH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "pa Ezra, Meculam, pa Amaria, Yehohanan; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.13",
            "verseOrgIds": [
              "NEH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "pa Maluki, Yonathan; pa Cebania, Yusuf; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.14",
            "verseOrgIds": [
              "NEH.12.14"
            ]
          }
        },
        {
