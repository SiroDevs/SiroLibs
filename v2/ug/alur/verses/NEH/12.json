            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie maeni gi julam ku Julawi m’uidho malu karacelo ku Zerubabel ma wod Cealtiel, ku Yecuwa: Seraya, man Yeremia, man Ezra, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
            "verseOrgIds": [
              "NEH.12.1"
            ]
          }
        },
        {
