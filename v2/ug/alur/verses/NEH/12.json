          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "man pa Yoiarib, Matenai; pa Yedaya, Uzi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.19",
            "verseOrgIds": [
              "NEH.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "pa Salai, Kalai; pa Amok, Eber; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.20",
            "verseOrgIds": [
              "NEH.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
