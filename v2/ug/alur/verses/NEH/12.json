                "loc": "1CH.26.12"
              },
              "items": [
                {
                  "text": "1 Kei 26:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E gikuro kur pa Mungu migi, man kur mi dwokrileng’, man juwer ku jukur dhugola gitimo kumeca, calku lembang’ola pa Daudi, man pa Suleman ma wode. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum i nindo pa Daudi kud Asaf ma con jadit mi juwer nuti, man wer mi pak ku mi foyofoc ni Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Israel ceke i nindo pa Zerubabel, man i nindo pa Nehemia, gimio makapiny mi juwer man mi jukur dhugola, calu cande nuti mi ceng’ ku ceng’; e gidwoko maeno leng’ ma mi Julawi; man Julawi gidwoko maeno leng’ ma mi wot Harun.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
