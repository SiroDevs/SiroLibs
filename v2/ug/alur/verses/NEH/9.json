                "loc": "EXO.32.1+EXO.32.2+EXO.32.3+EXO.32.4"
              },
              "items": [
                {
                  "text": "Ai 32:1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eyo, ka gitimo igi nyathi dhiang’ m’atwaga, e giwacu kumae, Maeni mungu peri m’uwodhi kud i Misiri, man gitimo gin dupa ma nyayu ng’ecwiny; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.18",
