            "caller": "#"
          },
          "items": [
            {
              "text": "Ai 19:18-23:33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iloro piny bende wi got Sinai, man iweco kugi kud i polo, e imio igi lembapoka ma pwe man cik mandha, ku ng’ol ma ber man lembang’ola, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.13",
            "verseOrgIds": [
              "NEH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
