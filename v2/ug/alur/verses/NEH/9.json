                {
                  "text": "Ai 34:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Wel 14:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "e gikwero woro, kadok musana peri m’itimo i kindgi de giparu pire ngo, ento giciko ng’utgi, man i jai migi giketho jego kara gidok i ng’eca migi. Ento in i Mungu m’ibedo ayika mi weko dubo, m’i won, bero ku kisa, yo ni ng’ecwiny, man mer mi beroni dit, e ikunogi ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.17",
            "verseOrgIds": [
              "NEH.9.17"
            ]
          }
        },
