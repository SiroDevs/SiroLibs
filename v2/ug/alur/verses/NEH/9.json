                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento gin ku wegwa gitimo ku kuhaya, e giciko ng’utgi, man giwinjo lembang’ola peri ngo, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.16",
