                "loc": "JOS.3.14+JOS.3.15+JOS.3.16+JOS.3.17"
              },
              "items": [
                {
                  "text": "Yoc 3:14-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inyayu nyithindho migi bende calu cero m’i polo, man ikelogi i ng’om m’iwacu pire ni kwarugi, nia gibimondo i ie nimwonye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.23",
            "verseOrgIds": [
