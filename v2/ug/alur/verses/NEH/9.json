                "loc": "GEN.15.18+GEN.15.19+GEN.15.20+GEN.15.21"
              },
              "items": [
                {
                  "text": "Tha 15:18-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "e inwang’u adundene mandha i weng’i, man itimo lembariba kude ya imi ng’om pa Jakanani, ku Jahiti, man Jaamori, ku Japerizi, man Jayebusi, ku Jagirgaci, ya imie ni kodhi pare, e itimo lembe peri kakare; kum in i pwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.8",
            "verseOrgIds": [
              "NEH.9.8"
            ]
          }
        }
      ]
