              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.4",
            "verseOrgIds": [
              "NEH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Julawi, en e Yecuwa, man Kadmiel, ku Bani, man Hacabneya, ku Kerebia, man Hodia, ku Cebania, man Pethahia, gilund giwacu kumae, Wucungi man wumi mugisa ni Yehova Mungu mu m’ugambre nja cil nja; e mugisa bed kum nyingi mi dwong’, m’edodre malu wi mugisa ku pak ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
            "verseOrgIds": [
              "NEH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "In i Yehova, in i kendi; itimo polo, polo m’i polo, kud udul migi ceke, ng’om de ku gin ceke ma ni i wie, ku nam man gin ceke ma ni i igi, e igwokogi ceke; man udul m’i polo berwo iri. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.6",
            "verseOrgIds": [
              "NEH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
