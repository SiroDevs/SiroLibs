            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Ai 7:8-12:32",
              "type": "text"
            }
          ]
        },
        {
          "text": "man inyutho giranyutha ku musana kum Farao, man kum jutic pare ceke, man kum dhanu ceke ma ni i ng’om pare; kum ing’eyo nia gitimo ku kuhaya i kumgi, e inwang’u iri nying’, calu ebedo tin. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.10",
            "verseOrgIds": [
              "NEH.9.10"
            ]
          }
        },
