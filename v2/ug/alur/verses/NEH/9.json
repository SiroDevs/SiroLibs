          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "man iketho ging’eyo sabatu peri ma leng’, man ing’i olo igi lembang’ola, ku ng’ol, man cik, ku cing’ Musa ma jatic peri, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.14",
            "verseOrgIds": [
              "NEH.9.14"
