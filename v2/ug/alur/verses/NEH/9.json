                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ke itelo wigi ku dieceng’ ku mbegi mir afuru; man ku mbegi mi mac ku diewor, kara umi igi der i yo ma maku giwoth i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.12",
            "verseOrgIds": [
              "NEH.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
