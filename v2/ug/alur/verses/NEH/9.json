              "items": [
                {
                  "text": "Tha 17:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "In i Yehova Mungu, m’igoyo wi Abram, m’iwodhe de woko kud i Ur mi Jukaldayo, m’icaku ire nying’ Ibrahim de, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.7",
            "verseOrgIds": [
              "NEH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
