              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ineno masendi pa kwaruwa i Misiri, e iwinjo ywak migi dhu Nam Makwar, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.9",
            "verseOrgIds": [
              "NEH.9.9"
