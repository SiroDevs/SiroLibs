                "loc": "2SA.12.24"
              },
              "items": [
                {
                  "text": "2 Sam 12:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.1+1KI.11.2+1KI.11.3+1KI.11.4+1KI.11.5+1KI.11.6+1KI.11.7+1KI.11.8"
              },
              "items": [
                {
                  "text": "1 Ub 11:1-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suleman m’ubimo mir Israel udubo kum gin maeni ngo? ento kind thek dupa ubimo moko mbe ma calu en, man Mungu pare mare, e Mungu kethe ni ubimo wi Israel ceke: ento cil en mon ma juwirok giketho edubo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.26",
            "verseOrgIds": [
              "NEH.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabiwinjo iwu kara wutim dubo maeni ceke ma dit, ma wudub ko ni Mungu mwa kugamu mon ma nyiwiroki?",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
            "verseOrgIds": [
              "NEH.13.27"
            ]
          }
        }
      ]
