                  "text": "Poi 7:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I ceng’ maeca bende aneno Juyahudi m’ugamu mon mir Acdod, ku mir Amon, man mi Moab: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "man nyithindho migi ng’et wec migi en e ku dhu Acdod, man gicopo weco ku dhu Juyahudi ngo, ento calku dhu dhanu kubang’gi kubang’gi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.24",
            "verseOrgIds": [
              "NEH.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "E wadhau kugi, man akwong’ogi, e agoyo jumoko m’i kindgi, man adoyo yukwigi, e aketho gikwong’o ku Mungu, awacu kumae, Wubimio nyigwu ni wotgi ngo, kadi wubigamu migi ni wotwu de ngo, kadi piwu giwu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.25",
            "verseOrgIds": [
              "NEH.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
