                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nen, abioro iwu Elia ma jabila ma fodi ceng’ ma dit mi ndiri pa Yehova fok’uwok ungo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebiloko adunde mi wego ba nyithindho, man adunde nyithindho ba weggi; kara kud abin agoi ng’om ku kwong’.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
            "verseOrgIds": [
              "MAL.4.6"
            ]
