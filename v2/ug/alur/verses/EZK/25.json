                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwoth Yehova wacu kumae: Kum Moab ku Seir giwacu kumae, Nen, ot mi Yuda e calu mi thek ceke; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.8",
            "verseOrgIds": [
              "EZK.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka kumeno, nen, abiyabu ng’et Moab ku bang’ adhura, ku bang’ adhura pare ma ni wi kieu pare, en e dwong’ mi ng’om, Beth-yecimoth, ku Bal-meyon, man Kiriathaim, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.9",
            "verseOrgIds": [
              "EZK.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "abiyabu ni nyithindho ma yo nyangu, kara gicidh kum nyithindho mir Amon; man abimiogi ni piny, kara ku jupoi pi nyithindho mir Amon kendo kind thek: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.10",
            "verseOrgIds": [
              "EZK.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "man abitimo lembapoka wi Moab; e gibing’eyo nia an a Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.11",
            "verseOrgIds": [
              "EZK.25.11"
            ]
          }
        }
      ]
