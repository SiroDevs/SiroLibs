              "items": [
                {
                  "text": "1 Ub 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.36"
              },
              "items": [
                {
                  "text": "Mt 9:36",
                  "type": "text"
                }
