            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.24"
              },
              "items": [
                {
                  "text": "Eze 34:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man jatic para ma Daudi bibedo ubimo i wigi; man kagi ceke gibibedo ku jakwac acel: gibiwotho i lembapoka para bende, man gibiworo cik para, gibitimogi de. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.24",
            "verseOrgIds": [
              "EZK.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gibibedo i ng’om m’amio ni Yakobo ma jatic para, ka ma kwaruwu bedo i ie; e gibibedo i ie, gin, ku nyithindho migi, man nyithindho mi nyithindho migi, mi nja: man Daudi ma jatic para bibedo jaditmawijo migi mi nja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.25",
            "verseOrgIds": [
              "EZK.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mange ke abitimo lembariba mi kwiocwiny kugi: ebibedo lembariba mi nja kugi; man abikethogi, abimedogi de, man abiketho kamaleng’ para i kindgi mi nja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.26",
            "verseOrgIds": [
              "EZK.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
