              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mecek, man Tubal ginuti, kud udul migi ceke; liendgi ni ng’etgi gbur; kagi ceke ma yaa mbe i kumgi, ma junego ku palamularu; kum ginyayu ndiri migi i ng’om mi ju ma kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gibivuto ku jurukara ngo m’upodho ma yaa mbe i kumgi, m’uloro piny ba liel ku jamtho migi mir ali, man m’uketho palamularu migi the wigi, man kier migi ni wi cogo migi; kum gi ndiri ni jurukara i ng’om mi ju ma kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ibitur i kind weg yaa ngo, man ibivuto karacelo ku ju ma junego ku palamularu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edom nuti, ju m’ubimo pare ku judongomawijo pare ceke, ma kum tego migi ceke juketho karacelo ku ju ma junego ku palamularu: gibivuto karacelo ku weg yaa ngo, man karacelo ku ju m’uloro piny i vur. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judongomawijo ma yor ariwa ma malu gi nuti, kagi ceke, ku Jusidoni ceke, m’uloro piny giku ju ma junego; kum ndiri ma ginyayu ku tego migi juketho lewic i wigi; man givuto ma gi weg yaa ngo ku ju ma junego ku palamularu, man giyeyo lewic migi karacelo ku ju m’uloro piny i vur. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao binenogi, man ebijukre kum udul pare ceke, en e Farao ku njuru asikari pare ceke, ma junego ku palamularu, Rwoth Yehova wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum aketho ndiri pare i ng’om mi ju ma kwo; man jubikethe i kind weg yaa ngo, karacelo ku ju ma junego ku palamularu, en e Farao kud udul pare ceke, Rwoth Yehova wacu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.32",
            "verseOrgIds": [
              "EZK.32.32"
            ]
          }
        }
      ]
    }
