                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Nyu 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.4"
