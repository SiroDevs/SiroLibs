                  "text": "Nyu 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man nen, dwong’ pa Mungu mir Israel uai yo nyangu: man badwande calu badwal mi pi dupa; man ng’om urieny ku dwong’ pare. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.2",
            "verseOrgIds": [
              "EZK.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en e calu nen mi ginmawokiwang’ m’aneno, en e calku ginmawokiwang’ m’aneno kinde m’abino ninyotho adhura; man ginmawokiwang’ne gi calu ginmawokiwang’ m’aneno dhu kulo Kebar; man apodho arieba wang’a. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.3",
            "verseOrgIds": [
              "EZK.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E dwong’ pa Yehova bino i ot i yo mi dhugang’ ma neno yo nyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Tipo ting’a malu, man etera i lelagang’ ma yor i ie; man, nen, dwong’ pa Yehova pong’o ot.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.5",
            "verseOrgIds": [
              "EZK.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
