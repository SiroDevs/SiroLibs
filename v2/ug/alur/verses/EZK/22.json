              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "E lembe pa Yehova bino i bang’a m’uwacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.23",
            "verseOrgIds": [
