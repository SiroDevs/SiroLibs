              "items": [
                {
                  "text": "Poi 23:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gigamu jamblembe mi cwiro rimo ii; igamu kuloka ku nyai, man igamu kuloka ba wedu ma kisa mbe, man wii wil pira, Rwoth Yehova wacu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.12",
            "verseOrgIds": [
              "EZK.22.12"
            ]
          }
        }
