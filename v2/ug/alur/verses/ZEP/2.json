        },
        {
          "text": "Wucokru karacelo, eyo, wucokru karacelo, E thek ma lewic umbe kude; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
