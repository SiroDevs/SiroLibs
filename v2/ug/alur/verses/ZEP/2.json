            {
              "text": "Nah 1:1-3:19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebirieyo cinge kum yor ariwa ma malu, man ebinyotho Ascur, ebidwoko Nineve de ni uvuru, m’etal de calu langa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.13",
