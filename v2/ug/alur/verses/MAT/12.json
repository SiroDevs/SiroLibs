              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.1+1KI.10.2+1KI.10.3+1KI.10.4+1KI.10.5+1KI.10.6+1KI.10.7+1KI.10.8+1KI.10.9+1KI.10.10"
              },
              "items": [
                {
                  "text": "1 Ub 10:1-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.1+2CH.9.2+2CH.9.3+2CH.9.4+2CH.9.5+2CH.9.6+2CH.9.7+2CH.9.8+2CH.9.9+2CH.9.10+2CH.9.11+2CH.9.12"
              },
              "items": [
                {
                  "text": "2 Kei 9:1-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ubimo ma dhaku ma yor ariwa ma yo piny bicungo i pokolembe karacelo ku dhanum’utuk maeni, man ebipoko lembe i wie rac: kum eai i tung’ ng’om kara ewinj rieko pa Suleman; man nen, ng’atu ma sagu Suleman ni keni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.42",
            "verseOrgIds": [
              "MAT.12.42"
            ]
          }
        }
      ]
