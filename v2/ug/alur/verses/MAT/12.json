              "type": "tag",
              "attrs": {
                "loc": "MRK.8.12"
              },
              "items": [
                {
                  "text": "Mk 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento edwoko lembe ewacu igi kumae, Dhanum’utuk ma gi rac ma gi weg gier de gibeyenyo giranyutha; giranyutha moko de mbe ma bimire igi, ndhu giranyutha pa Yona ma jabila: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.39",
            "verseOrgIds": [
              "MAT.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 12:40"
          },
          "items": [
