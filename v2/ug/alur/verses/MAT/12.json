          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.3.5"
              },
              "items": [
                {
                  "text": "Yon 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dhanu mi Nineve bicungo i pokolembe karacelo ku dhanum’utuk maeni, e gibipoko lembe i wie rac; kum joca loko cwinygi kum lembayera pa Yona; man nen, ng’atu ma sagu Yona ni keni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.41",
            "verseOrgIds": [
              "MAT.12.41"
            ]
          }
        },
        {
          "name": "verse",
