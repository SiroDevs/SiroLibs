                  "text": "Yon 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kum calu Yona bedo ceng’ adek ku diewor de i cino rec ma dit; e Wod dhanu de bibedo kumeno ceng’ adek ku dieworne de i adunde ng’om. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.40",
            "verseOrgIds": [
              "MAT.12.40"
            ]
          }
        },
        {
          "name": "verse",
