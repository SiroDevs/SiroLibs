                "loc": "LUK.22.24"
              },
              "items": [
                {
                  "text": "Lk 22:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I saa nica julub gibino ba Yesu, giwacu kumae, Ka kumeno ng’a ma dwong’ ma sagu i ker m’i polo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man elwong’o nyathin ma nyanok i bang’e ekethe de i kindgi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.15"
              },
              "items": [
                {
                  "text": "Mk 10:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.17"
              },
              "items": [
                {
                  "text": "Lk 18:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ewacu de kumae, Andha awacu iwu kumae, Tek wulokru ngo, wudoko calu nyithindho ma thindho de ngo, wubimondo i ker m’i polo ki ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno ng’atu ma tek bijwigre gire va nyathin ma nyanok maeni, ng’atuni e ma dwong’ ma sagu i ker m’i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.4",
            "verseOrgIds": [
              "MAT.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ng’atu ma tek bijolo nyathin ma nok acel ma kumeni i nyinga meca ejolo an.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.5",
            "verseOrgIds": [
              "MAT.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.5",
            "verseOrgIds": [
              "MAT.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ng’atu ma tek biketho acel m’i kind nyithindho ma thindho maeni m’uyia ukier, en e kuloka ire tek jung’abu pom i ng’ute, ka juthung’e ko the nam.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.6",
            "verseOrgIds": [
              "MAT.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.6",
            "verseOrgIds": [
              "MAT.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can wi ng’om kum gin ma ketho jukier! kum ebedo kumeno nia gin ma ketho jukier ukoubin be; ento can wi ng’atu maeno ma gin ma ketho jukier uwok ni kume! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.7",
            "verseOrgIds": [
              "MAT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.30"
              },
              "items": [
                {
                  "text": "Mt 5:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man tek cingi kadi tiendi ketho ikieri, thume woko, baye kud i kumi: e ber iri ya imond i kwo kud abala mi bot kadi mi tielo, sagu ma tek ibedo ku cingi ario kadi tielo ario ma jubibolo i mac ma rondo ku rondo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.8",
            "verseOrgIds": [
              "MAT.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.29"
              },
              "items": [
                {
                  "text": "Mt 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tek weng’i de ketho ikier, kabe woko, baye cen kud i kumi: en e ber iri ya imond i kwo ku weng’i acel, sagu ma tek ibedo ku weng’i ario ma jubibayu i gehena mi mac.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.9",
            "verseOrgIds": [
              "MAT.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
