              "MAT.18.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.10"
              },
              "items": [
                {
                  "text": "Lk 19:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen nia kud wucai acel m’i kind ju ma thindho maeni: kum awacu iwu, ya malaika migi m’i polo gineno wang’ Vwa m’i polo thiri thiri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.10",
            "verseOrgIds": [
              "MAT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum Wod dhanu bino nilaru ju m’urwinyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.11",
            "verseOrgIds": [
              "MAT.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuwacu nyo ang’o? tek ng’atu moko bedo ku rombe dak acel, acel m’i kindgi de kiewo, eweko pier abung’wen wi abung’wen ungo, ecidho de wi got, man eyenyo maeno m’ukiewo ngo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.12",
            "verseOrgIds": [
              "MAT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek ebedo kumeno nia enwang’e awacu iwu andha, mutoro nege i kume ma sagu mi pier abung’wen wi abung’wen m’ukiewo ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.13",
            "verseOrgIds": [
              "MAT.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumeno en e yeny ma Wegwu ma ni i polo yenyo ngo, nia acel m’i kind ju ma thindho maeni urwiny.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.14",
            "verseOrgIds": [
              "MAT.18.14"
            ]
          }
        }
      ]
    },
