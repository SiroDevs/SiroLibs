            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.19"
              },
              "items": [
                {
                  "text": "Mt 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.23"
              },
              "items": [
                {
                  "text": "Yoh 20:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Andha awacu iwu, Gin ceke ma tek wubitwio i ng’om bibedo atwia i polo; gin ceke ke ma tek wubigonyo i ng’om jubigonyo i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
            "verseOrgIds": [
              "MAT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo awacu iwu, nia tek juario m’i ng’om cwinygi ripo pi gin moko ma gikwayu, Vwa m’i polo biketho etimbre igi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum ka ma juario kadi adek gicokri ie karacelo i nyinga, anuti i kindgi kakeca.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.20",
            "verseOrgIds": [
              "MAT.18.20"
            ]
          }
        }
      ]
    },
