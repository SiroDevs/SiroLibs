                "loc": "LUK.17.3"
              },
              "items": [
                {
                  "text": "Lk 17:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek umeru dubo iri, cidh, inyuth ire dubo pare i kindwu wukude kendwu: tek ewinjoi, nwang’u wuripo kindwu wukud umeru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "Poi 19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento tek ewinjoi ngo, gam ng’atu acel kadi ario mange wuci kugi, kara lembe ceke cung i jumulembe ario kadi adek. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek ekwero winjogi, yere ni kanisa: tek ekwero winjo kanisa bende, wek ebed iri calu Thekdhanumange ku won ajok bende.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.17",
            "verseOrgIds": [
              "MAT.18.17"
            ]
          }
        }
      ]
    },
