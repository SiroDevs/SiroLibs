                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento ndhu ndhu yo ng’ei masendi mi ceng’ maeno ceng’ bidoko col, dwi de birieny ungo, cero de bioi kud i polo, tego mi polo de biyengre; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.29",
            "verseOrgIds": [
              "MAT.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Dan 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.10+ZEC.12.11+ZEC.12.12+ZEC.12.13+ZEC.12.14"
              },
              "items": [
                {
                  "text": "Zek 12:10-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Nyu 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "e giranyutha pa Wod dhanu bilund wok i polo: e can bilund nego suru ceke m’i ng’om, man gibineno Wod dhanu bebino wi afuru m’i polo ku tego ku dwong’ ma dit de. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.30",
            "verseOrgIds": [
              "MAT.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebioro malaika pare ku dwand agwara ma dit, e gibicoko ju ma jugoyo nying’gi karacelo kud i the yamu ang’wen, kud i tung polo kun ku kun de.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.31",
            "verseOrgIds": [
              "MAT.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.31",
            "verseOrgIds": [
              "MAT.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie wuponj ng’eyo lembabola ni kum ulam: kinde ma jange doko yom, elodho ithe de, wung’eyo ya cwir ni ceng’ni; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.32",
            "verseOrgIds": [
              "MAT.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "cil wun bende kumeno, ka wuneno gin maeno ceke, wung’ei ya eni ceng’ni, cil dhugola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.33",
            "verseOrgIds": [
              "MAT.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andha ayero iwu kumae, Dhanum’utuk maeni bikadhu woko ngo, ma fodi gin maeni ceke kutimbre kakare ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.34",
            "verseOrgIds": [
              "MAT.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo ku ng’om bikadhu woko, ento lembe para bikadhu woko ngo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ceng’ nino ku saane de ng’atu moko mbe m’ung’eyo pire, cil ku malaika m’i polo de, kadok Wod, ento Wego kende. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.36",
            "verseOrgIds": [
              "MAT.24.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.5+GEN.6.6+GEN.6.7+GEN.6.8"
              },
              "items": [
                {
                  "text": "Tha 6:5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ke calu yang’ ceng’ pa Noa bedo, e bino pa Wod dhanu de bibedo kumeca. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.37",
            "verseOrgIds": [
              "MAT.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum calu i ceng’ maeca ma fodi pi ma dit m’uumo ng’om kuwok ungo gibecamu gibemadhd de, gibegambri gibemio de ya jugam, cil i ceng’ ma Noa mondo ko i avur, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.38",
            "verseOrgIds": [
              "MAT.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.6+GEN.7.7+GEN.7.8+GEN.7.9+GEN.7.10+GEN.7.11+GEN.7.12+GEN.7.13+GEN.7.14+GEN.7.15+GEN.7.16+GEN.7.17+GEN.7.18+GEN.7.19+GEN.7.20+GEN.7.21+GEN.7.22+GEN.7.23+GEN.7.24"
              },
              "items": [
                {
                  "text": "Tha 7:6-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "e ging’eyo ngo maram pi ma dit m’uumo ng’om uwok ko, man eterogi ceke woko, e bino pa Wod dhanu bibedo kumeca. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.39",
            "verseOrgIds": [
              "MAT.24.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nindo maeno dhanu ario bibedo i podho; acel ugambre, acel ke dong’: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.40",
            "verseOrgIds": [
              "MAT.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "mon ario de birego rego wi pom: acel ugambre, acel ke dong’. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.41",
            "verseOrgIds": [
              "MAT.24.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno wuki: kum wung’eyo ngo ceng’ ma Rwoth mu bino i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.42",
            "verseOrgIds": [
              "MAT.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.39"
              },
              "items": [
                {
                  "text": "Lk 12:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.40"
              },
              "items": [
                {
                  "text": "40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento wung’ei maeni, nia dok won ot ung’eyo ka kur ma jakwo bino i ie, kuno di ekuro, kuno di eyio ngo ya jutur ot pare. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.43",
            "verseOrgIds": [
              "MAT.24.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno wun bende wubed ayika; kum Wod dhanu bino i saa ma wuwacu nyo ngo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.44",
            "verseOrgIds": [
              "MAT.24.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.44",
            "verseOrgIds": [
              "MAT.24.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno ng’a ma jamiru mandha ma riek de, ma rwoth pare kethe wi juode, ya emi igi cemo migi i nindone? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.45",
            "verseOrgIds": [
              "MAT.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugisa ni jamiru maeno, ma rwoth pare kan ebino binwang’u ebetimo kumeca. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.46",
            "verseOrgIds": [
              "MAT.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andha awacu iwu, ya ebikethe wi gin ceke m’ebedo ko. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.47",
            "verseOrgIds": [
              "MAT.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento tek jamiru ma rac maeno biwacu i adundene kumae, Rwoth para galu: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.48",
            "verseOrgIds": [
              "MAT.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ebi maku fodo jutic wadi, man ebicamu ku madhu de karacelo ku ju ma mer: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.49",
            "verseOrgIds": [
              "MAT.24.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "e rwoth pa jamiru maeno bibino i ceng’ m’ewacu nyo ngo, i saa de m’eng’eyo ngo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.50",
            "verseOrgIds": [
              "MAT.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
