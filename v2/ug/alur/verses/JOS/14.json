              },
              "items": [
                {
                  "text": "34:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ku gagi mir aba migi, calu Yehova ng’olo ku dhu Musa, ni suru abung’wen, man ni ng’et suru. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
