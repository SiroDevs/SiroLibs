              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man maeni gin aba ma nyithindho mir Israel umaku i ng’om Kanan, ma Eleazar ma jalam, ku Yocuwa ma wod Nun, man wi udi pa wego mi suru mi nyithindho mir Israel, gipoko igi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
