              "type": "text"
            }
          ]
        },
        {
          "text": "Yocuwa lund uguro pemblam ni Yehova, Mungu mir Israel, i got Ebal, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
