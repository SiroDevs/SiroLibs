          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubimo mi Yarmuth, acel; ubimo mi Lakic, acel; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.11",
            "verseOrgIds": [
              "JOS.12.11"
