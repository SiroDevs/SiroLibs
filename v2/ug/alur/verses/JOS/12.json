          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubimo mi Dor i ng’om m’utingre mi Dor, acel; ubimo mi Goim i Gilgal, acel; ",
          "type": "text",
          "attrs": {
