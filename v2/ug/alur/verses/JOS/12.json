          "text": "ubimo mi Kedec, acel; ubimo mi Yokneam i Karmel, acel; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.22",
            "verseOrgIds": [
              "JOS.12.22"
            ]
          }
        },
