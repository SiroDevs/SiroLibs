        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man maeni gi ju m’ubimo mi ng’om ma Yocuwa ku nyithindho mir Israel gigoyogi loka Yordan yo reto, ugambre kum Bal-gad i poga mi Lebanon cil kum got Halak, m’ucidho malu kum Seir (man Yocuwa mie ni suru mir Israel ni piny calku pok migi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "i ng’om gudi, man i ng’om poga, man i Araba, kud i ng’om m’alora, man i yamba, man i yor ariwa ma piny; en e Jahiti, ku Jaamori, man Jakanani, ku Japerizi, man Jahivi, ku Jayebusi): ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
              "JOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubimo mi Yeriko, acel; ubimo mir Ai, ma i ng’et Beth-el, acel; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.9",
            "verseOrgIds": [
              "JOS.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubimo mi Yerusalem, acel; ubimo mi Hebron, acel; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.10",
            "verseOrgIds": [
              "JOS.12.10"
            ]
          }
        },
