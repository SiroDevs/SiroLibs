              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Musa mio aba ni ng’et suru pa Manase: man en e pi ng’et suru mi nyithindho pa Manase calku wat migi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
