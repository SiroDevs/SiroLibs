                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man cogo pa Yusuf, ma nyithindho mir Israel gikelo malu kud i Misiri, giyiko i Cekem, i ng’et ng’om ma Yakobo ng’iewo ba wot Hamor ma won Cekem ku ng’et mola ma tar dak acel: e gidoko ni aba ni nyithindho pa Yusuf. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
