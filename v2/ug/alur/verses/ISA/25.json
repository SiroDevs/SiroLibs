              "items": [
                {
                  "text": "Nyu 7:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.4"
              },
              "items": [
                {
                  "text": "21:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emwonyo tho mi nja; e Rwoth Yehova biyweyo piwang’ kud i wang’ ceke; man ebikabu cac mi dhanu pare woko kud i ng’om ngung’: kum Yehova yero maeni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
