              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 53:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ebedo ber ni Yehova ya enyai rem i kume; enyayu can i kume: kinde m’ibidwoko ng’eyong’ec pare ni lam mi dubo, ebineno kodhi pare, ebimedo nindo pare, man gin ma nyayu mutoro i Yehova bibedo miero i cinge. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.10",
            "verseOrgIds": [
              "ISA.53.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 53:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebineno sendri mi ng’eyong’ec pare, e cwinye bikwio: ni kum ng’eyong’ec pare gire jatic para ma pwe bigonyo lembe ma wi dhanu dupa; man ebiyeyo kier migi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.11",
            "verseOrgIds": [
              "ISA.53.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 53:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.28"
              },
              "items": [
                {
                  "text": "Mk 15:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.37"
              },
              "items": [
                {
                  "text": "Lk 22:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka kumeno abipoko ire makapiny karacelo ku ju ma dwong’, man ebipoko ayeki karacelo ku jurukara; kum ekonjo ng’eyong’ec pare ni tho, man jukwane karacelo ku weg gondri: ento eyeyo dubo mi dhanu dupa, man ekwayu kwac pi weg gondri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.12",
            "verseOrgIds": [
              "ISA.53.12"
            ]
          }
        }
