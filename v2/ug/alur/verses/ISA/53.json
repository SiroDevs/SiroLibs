                "loc": "ACT.8.32"
              },
              "items": [
                {
                  "text": "Tic 8:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jusende, ento kinde ma jusende ealu dhoge ngo; calu nyathi rombo ma jupeyo mi nek, man calu rombe ma i wang’ junyar yuke bedo ling’, e ealu dhoge ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 53:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jukabe cen ni kum masendi ku pokolembe; man pi dhanum’utuk pare, ng’a m’i kindgi m’uparu nia jukabe woko kud i ng’om mi ju ma kwo pi gondri mi dhanu para ma maku goc upodh i kumgi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 53:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.22"
              },
              "items": [
                {
                  "text": "1 Pet 2:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E gitimo liel pare karacelo ku judubo, man karacelo ku jalonyo i tho pare; kadok etimo rop moko ngo, kadok abombi moko de mbe i dhoge.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
