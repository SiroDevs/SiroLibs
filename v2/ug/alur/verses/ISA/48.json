              "items": [
                {
                  "text": "Nyu 18:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuai kud i Babeli, wuring Jukaldayo; wuyer maeni ku dwal mi wer, wuwac maeni, wuyere cil kum kajik mi ng’om: wuwac kumae, Yehova waru jatic pare ma Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.20",
            "verseOrgIds": [
              "ISA.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "E rieu negogi ngo kinde m’etelo wigi kud i ng’omngele; eketho pi thwogre kud i cana igi; eng’enyo cana bende, e pi thwogre woko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.21",
            "verseOrgIds": [
              "ISA.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.21"
              },
              "items": [
                {
                  "text": "Isa 57:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova wacu kumae, Kwiocwiny umbe ni judubo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.22",
            "verseOrgIds": [
              "ISA.48.22"
            ]
          }
        }
