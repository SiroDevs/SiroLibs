                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.33"
              },
              "items": [
                {
                  "text": "Rum 9:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.11"
              },
              "items": [
                {
                  "text": "10:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.6"
              },
              "items": [
                {
                  "text": "1 Pet 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ka kumeno Rwoth Yehova wacu kumae, Nen, aketho kidi i Sayuni ni thepiny, kidi ma juponjo, kidi ma wi gui ma pire tek mi thepiny ma tek: ng’atu m’uyio bibedo vur vur ungo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.16",
            "verseOrgIds": [
              "ISA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abiketho pokolembe ni thol, man bedopwe ni jamtir; man pei biyweyo kapondo mi ndra cen, e pi bimwonyo kapondo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.17",
            "verseOrgIds": [
              "ISA.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "E lembariba mu ma ku tho jubithiro, man lembariba mu ma ku liel bicungo ngo; kinde ma goc m’ucore bikadhu, e jubilund nyonowu piny kude. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.18",
            "verseOrgIds": [
              "ISA.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ba nindo ceke m’ekadhu i ie, ebigamuwu; kum ku ba rupiny ku ba rupiny ebikadhu, ku dieceng’ man ku diewor: man ebibedo gin moko ngo ndhu ndiri mi winjo rwonglembe ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.19",
            "verseOrgIds": [
              "ISA.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kavuto e cek ma sagu ma dhanu copo rieire gire i wie, man girauma diny ma sagu m’ecopo umbre kudo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.20",
            "verseOrgIds": [
              "ISA.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.20"
              },
              "items": [
                {
                  "text": "2 Sam 5:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.14.11"
              },
              "items": [
                {
                  "text": "1 Kei 14:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.10+JOS.10.11+JOS.10.12"
              },
              "items": [
                {
                  "text": "Yoc 10:10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum Yehova biai malu calu wi got Perazim, kwinyo binege calu i poga mi Gibeon; kara etim tic pare, tic pare ma tung’, man kara eketh tic pare timbre kakare, tic pare ma tung’. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.21",
            "verseOrgIds": [
              "ISA.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno kawono kud wubed jucac, jumaru dwoko twic mu tek; kum awinjo lembang’ola mi nyoth m’uai ba Rwoth, Yehova mir udul, wi ng’om ngung’.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.22",
            "verseOrgIds": [
              "ISA.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.22",
            "verseOrgIds": [
              "ISA.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wucik ithwu, man wuwinj dwanda; wucik ithwu, man wuwinj wec para. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.23",
            "verseOrgIds": [
              "ISA.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’atu m’ufuro fur mi kodhi efuro fur thiri thiri? eyabu man eloko ng’om pare thiri thiri? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.24",
            "verseOrgIds": [
              "ISA.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinde m’eyiko wang’e, ecoyo atingli, man eketho landi, man eketho nganu i wang’ng’om, man nganu ma tung’ i kaka ma juketho, ku nganu ma boco de i kieune? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.25",
            "verseOrgIds": [
              "ISA.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum Mungu pare ponje atira, man etwinye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.26",
            "verseOrgIds": [
              "ISA.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum jufodo atingli ku jamfodo ma bith ungo, kadok ukobre mi magali de juloko wi landi ngo; ento atingli jufodo kud uluth, man landi ke ku dul. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.27",
            "verseOrgIds": [
              "ISA.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cam mi kwen jurego; kum ebibefode nja ngo: man kadok ukobre mi magali pare ku riuni pare gikethe, erege ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.28",
            "verseOrgIds": [
              "ISA.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni bende ai ku ba Yehova mir udul, m’ewang’u ijo i lembapora, man m’e ber hai i rieko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.29",
            "verseOrgIds": [
              "ISA.28.29"
            ]
          }
        }
      ]
    }
