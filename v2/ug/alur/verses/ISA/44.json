                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.8"
              },
              "items": [
                {
                  "text": "2:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.13"
              },
              "items": [
                {
                  "text": "22:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova, m’Ubimo mir Israel, man Jawar pare, Yehova mir udul, uwacu kumae: An a ma kwong’a, man kajik; man Mungu moko mbe m’umeda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.6",
            "verseOrgIds": [
              "ISA.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ng’a, ma calu an, ma bilwong’o, man biyere de, man bikethe kakare pira, ugambre m’aketho dhanu ma coni? man gin ma bibino, man ma bitimbre, wek giyer. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.7",
            "verseOrgIds": [
              "ISA.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lworo kud unegwu, bebe de kud utimwu: ayero iri ugambre con ungo, man anyuthe? man wun wu jumulembe para. Mungu moko nuti m’umeda? eyo, Cana moko mbe; ang’eyo moko ngo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ju ma timo ayi gin m’acwia m’ang’ika kagi ceke gi gin ma ie nanu; e gin ma nyayu mutoro i igi kulokane bibedo mbe; man jumulembe migi ma dhe neno ngo, kadi ng’eyo ngo: kara lewic uneggi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.9",
            "verseOrgIds": [
              "ISA.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’a m’utimo mungu, kadi m’utwagu ayi gin m’acwia ma kulokane mbe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.10",
            "verseOrgIds": [
              "ISA.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen, jubinyayu lewic wi juwagi ceke; man jutic, gi mi dhanu: wek jucokgi ceke karacelo, wek gicungi; lworo binegogi, jubinyayu lewic i wigi karacelo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jathiedh thiedho lei, man etimo ku cukmac, eng’ine ku nyondro de, man etime ku bote ma tek: eyo, kec unege, man tego pare jik; emadhu pi ngo, e evoc. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.12",
            "verseOrgIds": [
              "ISA.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabodho mi bau rieyo thol; ekiewe ku kalamu; eng’ine ku jamng’in, man epore ku jampor, man eng’ine calu ayi dhanu, calku bero dhanu, mi bedo i ot. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.13",
            "verseOrgIds": [
              "ISA.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng’olo ire musonge, man egamu sipre ma ithe thindho ku bongu, man edwoko yen acel tek i kind yen mi luli ire gire: epidho sipre, e koth lodhe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.14",
            "verseOrgIds": [
              "ISA.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebilund bedo ni dhanu mi wang’u; man egamu kume moko, e emure gire; eyo, ecwinye, man etedo ko kwen: eyo, etimo mungu, man erwo ire; etime ni ayi gin m’acwia m’ang’ika, man epodho piny ire. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.15",
            "verseOrgIds": [
              "ISA.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewang’u ng’ete i mac; ecamu ring’o ku ng’ete; evulo ring’o m’avula, e cwinye kwio; eyo, emure gire, e ewacu kumae, Aha, kuma mor, aneno mac. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.16",
            "verseOrgIds": [
              "ISA.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man donge m’udong’ etimo ni mungu, en e ayi gin m’acwia pare m’ang’ika; epodho piny ire e erwo, man egoyo lam ire, ewacu de kumae, Bodha; kum in i mungu para.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.17",
            "verseOrgIds": [
              "ISA.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.17",
            "verseOrgIds": [
              "ISA.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ging’eyo ngo, kadok lembe de gipido ngo: kum emio wang’gi, kara ku ginen; kud adundegi de, kara ku ging’ei. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.18",
            "verseOrgIds": [
              "ISA.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ng’atu moko mbe m’upoi, kadi ng’eyothelembe de mbe ma giwac ko kumae, A wang’u ng’ete i mac; eyo, atedo kwen de wi cukmaje; avulo ring’o man acame: man abitimo donge m’udong’ ni ginmajudagu? abipodho piny ni dund yeni? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.19",
            "verseOrgIds": [
              "ISA.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ecamu vuru; adunde ma jubombo loke cen; e ecopo bodho ng’eyong’ec pare ngo, kadi wacu kumae, Ndra ni i cinga ma yor acwic ungo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.20",
            "verseOrgIds": [
              "ISA.44.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.20",
            "verseOrgIds": [
              "ISA.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wupoi kum gin maeni, E Yakobo, kud Israel; kum in i jatic para: acwii; in i jatic para: E Israel, wia biwil piri ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.21",
            "verseOrgIds": [
              "ISA.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araco gondri peri woko, calu afuru ma ndhu, man dubo peri, calu afuru: dwog i bang’a; kum aweri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.22",
            "verseOrgIds": [
              "ISA.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuwer, E polo, kum Yehova timo maeni; wukoki, wu ng’et ng’om ma yo piny; wu moj wer, wu gudi, E luli, man yen kubang’e kubang’e ma ni i ie: kum Yehova waru Yakobo, man ebinwang’u dwong’ ire gire ni kum Israel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova, ma Jawarni, man ng’atu m’ung’ini kud i ic, ewacu kumae: An a Yehova, m’atimo gin ceke; m’arieyo polo a kenda; m’amoyo ng’om kpe (ng’a ma ni kuda?); ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.20"
              },
              "items": [
                {
                  "text": "1 Kor 1:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
