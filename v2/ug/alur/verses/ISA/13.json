            {
              "text": "Yer 50:1-51:64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewolembe ma pi Babeli, ma Isaya ma wod Amoz uneno.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.1",
            "verseOrgIds": [
              "ISA.13.1"
            ]
          }
        }
