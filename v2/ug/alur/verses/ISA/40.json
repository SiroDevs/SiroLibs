                "loc": "1PE.1.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dwand ng’atu moko m’uwacu kumae, Lwong’. E ng’atu acel uwacu kumae, Alwong’ ang’o? Lwong’ kumae, Weg kum ceke en e lum, man berone ceke calu thiuboko m’i thim. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.6",
            "verseOrgIds": [
              "ISA.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lum ner, man thiuboko kite rwinyo, kum yuyo pa Yehova kudho wie; andha dhanu en e lum. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.7",
            "verseOrgIds": [
              "ISA.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lum ner, thiuboko kite rwinyo; ento lembe pa Mungu mwa bicungo mi nja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.8",
            "verseOrgIds": [
              "ISA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
