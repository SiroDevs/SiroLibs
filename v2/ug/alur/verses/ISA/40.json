              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukwi cwiny, wukwi cwiny dhanu para, Mungu mu wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.1",
            "verseOrgIds": [
              "ISA.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuyer lemjuk ni Yerusalem; wulwong’ i bang’e, nia ali pare thum, nia juweko kier pare, nia ejolo pi dubo pare wang’ ario kud i cing’ Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.2",
            "verseOrgIds": [
              "ISA.40.2"
            ]
          }
        }
      ]
    },
