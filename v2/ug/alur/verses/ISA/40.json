                "loc": "1PE.1.24"
              },
              "items": [
                {
                  "text": "1 Pet 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
