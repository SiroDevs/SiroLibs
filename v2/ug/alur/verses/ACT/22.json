              "type": "text"
            }
          ]
        },
        {
          "text": "Jego ma dit uloko lembe kumae, Anwang’u paker maeni ku piny ma dit. Man Paolo wacu kumae, Ento an junyola anyola Jarumi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
          }
        },
