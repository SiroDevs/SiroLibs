                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento Paolo ie wacu ya e ber ungo gici kugi en m’ewekogi Pamfulia, gicidho gikugi ngo i tic. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.38",
            "verseOrgIds": [
              "ACT.15.38"
            ]
