              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ceng’ moko kadhu Paolo wacu ni Barnaba kumae, Dong’ wadok kendo walieu umego ku bang’ adhura ceke ma wayero ie lembe pa Rwoth, wanen maram gibedo ko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.36",
            "verseOrgIds": [
              "ACT.15.36"
            ]
          }
