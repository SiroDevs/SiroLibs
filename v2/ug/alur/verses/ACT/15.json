          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Paolo giku Barnaba re gidong’ migi Antiokia, ma gibeponjo gibeyero lembe pa Rwoth, giku juwagi mange bende dupa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
          }
        }
      ]
