          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Barnaba yenyo ya gici giku Yohanagi bende, ma julwong’e Marko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.37",
            "verseOrgIds": [
              "ACT.15.37"
