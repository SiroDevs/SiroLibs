          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento Paolo dong’ ufoyo pare Sila, e ma giwotho gikude, kan umego daru thierogi ni bero pa Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
