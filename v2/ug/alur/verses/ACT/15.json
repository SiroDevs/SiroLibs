              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "E giloko dhoggi ngle, ketho gipokri, e Barnaba dong’ ugamu Marko, e ma gidong’ gicidho gikude Kupro ku yo mi pi: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
          }
        },
        {
