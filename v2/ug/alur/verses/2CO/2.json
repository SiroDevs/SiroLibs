              "2CO.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.1"
              },
              "items": [
                {
                  "text": "Tic 20:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie kinde m’abino Troa pi lembanyong’a pa Kristu ma juboth ko, man kinde ma dhugola yabre ira i Rwoth, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "cwinya kwio ngo, kum anwang’u Tito m’umira ngo: ento kan aweko gi, acidho i Makedoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento foyofoc ni Mungu, m’etelo wiwa thiri thiri i sag ma jusagu ko ni kum Kristu, man eketho mido mi ng’eyong’ec pare nyuthre i kaka ceke ni kumwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.14",
            "verseOrgIds": [
              "2CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum wan wa mido ma ng’ar pa Kristu ni Mungu, i ju ma giboth, man i ju ma girwinyo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.15",
            "verseOrgIds": [
              "2CO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni acel mido m’uai ba tho tundo de ba tho; ni mange ke mido m’uai i kwo tundo de i kwo. Ng’a ke m’uromo ni gin maeni? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.16",
            "verseOrgIds": [
              "2CO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum wan wa calu dupa ngo, ma gibenyotho lem pa Mungu: ento wayero mwa i Kristu, endre calu ma abombi mbe i cwinywa, ento calu pa Mungu i wang’ Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.17",
            "verseOrgIds": [
              "2CO.2.17"
            ]
          }
        }
      ]
    }
