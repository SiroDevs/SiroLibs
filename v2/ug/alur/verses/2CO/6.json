            }
          ]
        },
        {
          "text": "Dhogwa bedo ang’ama iwu, E Jukorinto, adundewa doko dit. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
            "verseOrgIds": [
              "2CO.6.11"
            ]
