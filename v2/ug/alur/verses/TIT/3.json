        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ju ma gini i bang’a ceke gimothi. Moth ju m’umaru wa i yioyic ceke.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
              "TIT.3.15"
            ]
          }
        }
