              "2KI.16.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.1"
              },
              "items": [
                {
                  "text": "Isa 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rezin m’ubimo mi Cami ku Peka ma wod Remalia m’ubimo mir Israel gilund giidho malu ba Yerusalem i lwiny: e gitieko Ahaz kud ali, ento gicopo sage ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nindo maeca Rezin m’ubimo mi Cami ugamu Elath kendo ni Cami, man eriemo Juyahudi kud i Elath; e Jucami gibino i Elath, man gibedo keca, cil i ceng’ ma tin.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno Ahaz uoro jukwenda ba Tiglat-pileser m’ubimo mir Ascur, ewacu kumae, An a jatic peri man wodi: idh malu, man ibodha kud i cing ubimo mi Cami, man kud i cing ubimo mir Israel, m’ujai ira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Ahaz ugamu mola ma tar ku mola ma kwar ma junwang’u i ot pa Yehova, man i kakanpiny mi ot p’ubimo, man eore ni giramia ni ubimo mir Ascur. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ubimo mir Ascur uwinjo dwande; e ubimo mir Ascur uidho malu kum Dameski, e emake, man eyaku dhanune ni ng’eca i Kir, man enego Rezin.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ubimo ma Ahaz ucidho i Dameski kara eromb ku Tiglat-pileser m’ubimo mir Ascur, man eneno pemblam ma ni i Dameski; e Ahaz m’ubimo oro ayi mi pemblam bang’ Urija ma jalam, ku rambe de, calku bodhone ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Urija ma jalam uguro pemblam: calku gin ceke ma Ahaz m’ubimo oro kud i Dameski, Urija ma jalam utime kumeca ni dwogo p’ubimo ma Ahaz kud i Dameski. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.11",
            "verseOrgIds": [
              "2KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde m’ubimo dwogo kud i Dameski, ubimo neno pemblamne: e ubimo coro ceng’ni ba pemblam, man ethiero i wie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "E elamu lam m’awang’a pare, ku lam mi mogo pare, man ekonjo lam m’amadha pare, man ekiro rimo mi lam mi kwiocwiny pare, wi pemblamne. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1"
              },
              "items": [
                {
                  "text": "Ai 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.1"
              },
              "items": [
                {
                  "text": "2 Kei 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E pemblam mi mola, ma ni i wang’ Yehova, ekelo kud i wang’ot, kud i kind pemblam pare ku ot pa Yehova, man ekethe yor ariwa ma malu i ng’et pemblam pare. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Ahaz m’ubimo ng’olo ni Urija ma jalam, ewacu kumae, Wang’ lam m’awang’a mi kugweno wi pemblam ma dit, ku lam mi mogo mir uthieno, ku lam m’awang’a p’ubimo, ku lam mi mogo pare, ku lam m’awang’a mi dhanu ceke m’i ng’om, man lam mi mogo migi, ku lam m’amadha migi; man ikir rimo ceke mi lam m’awang’a i wie, ku rimo ceke mi lam: ento lam mi mola bibedo ira m’apenjo kudo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.15",
            "verseOrgIds": [
              "2KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urija ma jalam utimo kumeca, calku gin ceke m’ubimo ma Ahaz ung’olo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
              "2KI.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
